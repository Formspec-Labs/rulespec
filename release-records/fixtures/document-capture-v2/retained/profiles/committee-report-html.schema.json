{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rulespec:rs1-review-profile:committee-report-html",
  "title": "DocumentCapture profile: committee-report-html v1",
  "description": "A GovInfo committee-report HTML body: one preformatted run split into blank-line blocks. A block is a ruled column-aligned table, a centred-capitals or record-vote heading, or a paragraph, page marker, banner or rule. Block structure is markup-derived, not the publisher's, and every rule that placed a block names itself in the node's decision.",
  "x-parent": {
    "$id": "https://rulespec.org/schemas/releases/document-capture-v2.schema.json",
    "sha256": "97681a29ffbbc53366e9f705a2c07291a664b7555d0d3d391d0f1e87dbf0e025"
  },
  "allOf": [
    {
      "$ref": "https://rulespec.org/schemas/releases/document-capture-v2.schema.json"
    },
    {
      "properties": {
        "profile": {
          "properties": {
            "name": {
              "const": "committee-report-html"
            },
            "version": {
              "const": "2-rs1-review"
            },
            "ext": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "blockRule",
                "packageId"
              ],
              "properties": {
                "packageId": {
                  "type": "string"
                },
                "blockRule": {
                  "const": "blank-line"
                }
              }
            }
          }
        },
        "nodes": {
          "items": {
            "allOf": [
              {
                "if": {
                  "properties": {
                    "kind": {
                      "type": "string",
                      "pattern": "^committee-report-html:"
                    }
                  },
                  "required": [
                    "kind"
                  ]
                },
                "then": {
                  "properties": {
                    "kind": {
                      "enum": [
                        "committee-report-html:banner",
                        "committee-report-html:heading",
                        "committee-report-html:preformatted",
                        "committee-report-html:rule"
                      ]
                    }
                  }
                }
              },
              {
                "properties": {
                  "kind": {
                    "not": {
                      "pattern": "^(?!committee-report-html:)[a-z][a-z0-9-]*:"
                    }
                  }
                }
              },
              {
                "properties": {
                  "ext": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {}
                  }
                }
              }
            ]
          }
        }
      }
    }
  ],
  "x-provenance": [
    "acquisition",
    "rendition-reason",
    "coordinates",
    "decisions",
    "rule-bindings",
    "govinfo",
    "mods"
  ]
}

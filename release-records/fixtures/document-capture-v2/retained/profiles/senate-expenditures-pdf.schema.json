{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rulespec:rs1-review-profile:senate-expenditures-pdf",
  "title": "DocumentCapture profile: senate-expenditures-pdf v1",
  "description": "Selected Senate expenditure PDF pages: extracted lines and ruled table observations. Exact cell text is retained separately from reconciled stream spans; unresolved cells carry an issue. No payment-line split, header inference, or merged-cell inference.",
  "x-parent": {
    "$id": "https://rulespec.org/schemas/releases/document-capture-v2.schema.json",
    "sha256": "97681a29ffbbc53366e9f705a2c07291a664b7555d0d3d391d0f1e87dbf0e025"
  },
  "allOf": [
    {
      "$ref": "https://rulespec.org/schemas/releases/document-capture-v2.schema.json"
    },
    {
      "properties": {
        "profile": {
          "properties": {
            "name": {
              "const": "senate-expenditures-pdf"
            },
            "version": {
              "const": "2-rs1-review"
            },
            "ext": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "packageId",
                "fileName",
                "pagesRead",
                "pageCount",
                "lineConverterSha256"
              ],
              "properties": {
                "packageId": {
                  "type": "string"
                },
                "fileName": {
                  "type": "string"
                },
                "pagesRead": {
                  "type": "array",
                  "items": {
                    "type": "integer"
                  }
                },
                "pageCount": {
                  "type": "integer"
                },
                "lineConverterSha256": {
                  "type": "string"
                }
              }
            }
          }
        },
        "nodes": {
          "items": {
            "allOf": [
              {
                "if": {
                  "properties": {
                    "kind": {
                      "type": "string",
                      "pattern": "^senate-expenditures-pdf:"
                    }
                  },
                  "required": [
                    "kind"
                  ]
                },
                "then": {
                  "properties": {
                    "kind": {
                      "enum": []
                    }
                  }
                }
              },
              {
                "properties": {
                  "kind": {
                    "not": {
                      "pattern": "^(?!senate-expenditures-pdf:)[a-z][a-z0-9-]*:"
                    }
                  }
                }
              },
              {
                "properties": {
                  "ext": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "tableOrdinal": {
                        "type": "integer"
                      },
                      "rowCount": {
                        "type": "integer"
                      },
                      "columnCount": {
                        "type": "integer"
                      },
                      "observedText": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "description": "Verbatim TableObservation cell text, including text absent from the line stream. Null means a box without text; absent cells have no node."
                      },
                      "pageTextSha256": {
                        "type": "string",
                        "description": "Digest of PageResult.text before line assembly; joins the Senate ruled-row identity, never a capture-stream offset."
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      }
    }
  ],
  "x-provenance": [
    "acquisition",
    "rendition-reason",
    "coordinates",
    "decisions",
    "rule-bindings",
    "govinfo",
    "mods",
    "pdf-intermediate",
    "page-dimensions"
  ]
}

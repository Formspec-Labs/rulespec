{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rulespec:rs1-review-profile:federal-register-xml",
  "title": "DocumentCapture profile: federal-register-xml v1",
  "description": "A Federal Register document XML (RULE, PRORULE, NOTICE, PRESDOCU). Preamble blocks are sections with a HED heading; GPOTABLE rows and cells carry cell geometry; FTNT is a footnote; PRTPAGE is a page number.",
  "x-parent": {
    "$id": "https://rulespec.org/schemas/releases/document-capture-v2.schema.json",
    "sha256": "97681a29ffbbc53366e9f705a2c07291a664b7555d0d3d391d0f1e87dbf0e025"
  },
  "allOf": [
    {
      "$ref": "https://rulespec.org/schemas/releases/document-capture-v2.schema.json"
    },
    {
      "properties": {
        "profile": {
          "properties": {
            "name": {
              "const": "federal-register-xml"
            },
            "version": {
              "const": "2-rs1-review"
            },
            "ext": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "agencies",
                "citation",
                "documentJsonSha256",
                "documentNumber",
                "endPage",
                "publicationDate",
                "startPage",
                "type",
                "docketIds",
                "regulationIdNumbers",
                "dates",
                "documentJsonPath"
              ],
              "properties": {
                "documentNumber": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                },
                "publicationDate": {
                  "type": "string"
                },
                "citation": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "startPage": {
                  "type": "integer"
                },
                "endPage": {
                  "type": "integer"
                },
                "agencies": {
                  "type": "array",
                  "items": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "documentJsonSha256": {
                  "type": "string"
                },
                "docketIds": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "regulationIdNumbers": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "dates": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "documentJsonPath": {
                  "type": "string"
                }
              }
            }
          }
        },
        "nodes": {
          "items": {
            "allOf": [
              {
                "if": {
                  "properties": {
                    "kind": {
                      "type": "string",
                      "pattern": "^federal-register-xml:"
                    }
                  },
                  "required": [
                    "kind"
                  ]
                },
                "then": {
                  "properties": {
                    "kind": {
                      "enum": [
                        "federal-register-xml:listOfSubjects",
                        "federal-register-xml:regText"
                      ]
                    }
                  }
                }
              },
              {
                "properties": {
                  "kind": {
                    "not": {
                      "pattern": "^(?!federal-register-xml:)[a-z][a-z0-9-]*:"
                    }
                  }
                }
              },
              {
                "properties": {
                  "ext": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "headLevel": {
                        "type": "string"
                      },
                      "indent": {
                        "type": "string"
                      },
                      "cols": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "cdef": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      }
    }
  ],
  "x-provenance": [
    "acquisition",
    "rendition-reason",
    "coordinates",
    "decisions",
    "rule-bindings"
  ]
}

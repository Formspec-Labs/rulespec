{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rulespec.org/jsonschema/artifact.json",
  "title": "artifact",
  "$defs": {
    "ArtifactIdentifierScheme": {
      "type": "string",
      "enum": [
        "rkaf:eli",
        "rkaf:eli-dl",
        "rkaf:eli-i",
        "rkaf:uslm",
        "rkaf:aknt-eId",
        "rkaf:doi",
        "rkaf:isbn",
        "rkaf:issn",
        "rkaf:cid",
        "rkaf:hash-sha256",
        "rkaf:urn-persistent",
        "rkaf:formspec-need",
        "rkaf:partner-defined"
      ]
    },
    "Artifact": {
      "type": "object",
      "properties": {
        "@type": {
          "const": "rkaf:Artifact"
        },
        "rkaf:hasArtifactIdentifier": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
              },
              "minItems": 1
            }
          ]
        },
        "rkaf:artifactIdentifierScheme": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactIdentifierScheme"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ArtifactIdentifierScheme"
              },
              "minItems": 1
            }
          ]
        },
        "foaf:primaryTopic": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
        },
        "dcterms:format": {
          "type": "string",
          "pattern": "^[A-Za-z0-9!#$&^_.+-]+/[A-Za-z0-9!#$&^_.+-]+(?:\\s*;.*)?$"
        },
        "dcterms:hasFormat": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
              },
              "minItems": 1
            }
          ]
        },
        "dcterms:isFormatOf": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
              },
              "minItems": 1
            }
          ]
        },
        "dcterms:isVersionOf": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
              },
              "minItems": 1
            }
          ]
        },
        "prov:wasRevisionOf": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
              },
              "minItems": 1
            }
          ]
        },
        "rkaf:hasContentDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "rkaf:hasAccessScope": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
        },
        "rkaf:hasRetentionPolicy": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
        },
        "rkaf:versionLineageEvidence": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
              },
              "minItems": 1
            }
          ]
        }
      },
      "required": [
        "@type",
        "rkaf:hasArtifactIdentifier",
        "rkaf:artifactIdentifierScheme"
      ],
      "allOf": [
        {
          "if": {
            "required": [
              "dcterms:isVersionOf"
            ]
          },
          "then": {
            "properties": {
              "rkaf:versionLineageEvidence": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
                    },
                    "minItems": 1
                  }
                ]
              }
            },
            "required": [
              "rkaf:versionLineageEvidence"
            ]
          }
        },
        {
          "if": {
            "required": [
              "prov:wasRevisionOf"
            ]
          },
          "then": {
            "properties": {
              "rkaf:versionLineageEvidence": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
                    },
                    "minItems": 1
                  }
                ]
              }
            },
            "required": [
              "rkaf:versionLineageEvidence"
            ]
          }
        },
        {
          "if": {
            "required": [
              "rkaf:versionLineageEvidence"
            ]
          },
          "then": {
            "properties": {
              "rkaf:hasContentDigest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            },
            "required": [
              "rkaf:hasContentDigest"
            ]
          }
        }
      ]
    }
  }
}
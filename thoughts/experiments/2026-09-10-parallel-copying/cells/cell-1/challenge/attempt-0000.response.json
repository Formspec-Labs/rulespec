            "text": "{\n  \"judgments\": [\n    {\n      \"proposal_id\": \"P0000\",\n      \"source_refs\": [\"F000\", \"F025:F026\"],\n      \"rationale\": \"Paragraph (a) expressly prefaces the railroad crossing stop requirement with 'Except as provided in paragraph (b) of this section'. Paragraph (b)(1) specifies that a stop need not be made at a streetcar crossing or industrial switching tracks within a business district. Designating C0009 as an exception qualifying C0000 is directly supported by the text.\",\n      \"verdict\": \"supported\"\n    },\n    {\n      \"proposal_id\": \"P0001\",\n      \"source_refs\": [\"F000\", \"F025\", \"F027\"],\n      \"rationale\": \"Paragraph (a) establishes the stopping duty subject to paragraph (b), and paragraph (b)(2) relieves the driver of the obligation to stop when a police officer or crossing flagman directs traffic to proceed. Setting relation to exception qualifying C0000 accurately models this statutory structure.\",\n      \"verdict\": \"supported\"\n    },\n    {\n      \"proposal_id\": \"P0002\",\n      \"source_refs\": [\"F000\", \"F025\", \"F028\"],\n      \"rationale\": \"Paragraph (b)(3) exempts drivers from stopping at grade crossings controlled by a functioning highway traffic signal transmitting a green indication permitting transit without stopping under local law, serving as an express exception to the paragraph (a) stop mandate in C0000.\",\n      \"verdict\": \"supported\"\n    },\n    {\n      \"proposal_id\": \"P0003\",\n      \"source_refs\": [\"F000\", \"F025\", \"F029\"],\n      \"rationale\": \"Paragraph (b)(4) relieves drivers of the paragraph (a) duty to stop at marked abandoned railroad grade crossings. Setting C0012 to qualify C0000 as an exception is fully supported by the text.\",\n      \"verdict\": \"supported\"\n    },\n    {\n      \"proposal_id\": \"P0004\",\n      \"source_refs\": [\"F000\", \"F025\", \"F030\"],\n      \"rationale\": \"Paragraph (b)(5) provides that a stop need not be made at an industrial or spur line grade crossing marked with an 'Exempt' sign. This directly qualifies the baseline stopping duty in paragraph (a) (C0000) as an exception.\",\n      \"verdict\": \"supported\"\n    }\n  ]\n}",

            "text": "{\n  \"judgments\": [\n    {\n      \"proposal_id\": \"P0000\",\n      \"source_refs\": [\"F000\", \"F001\"],\n      \"rationale\": \"Clause (i) grants permission to submit requests electronically, while clause (ii) establishes a substantive content requirement for those electronic requests. The edit correctly combines both into the summary without implying forfeiture of permission or importing the agency's unrelated reporting duties from clause (iii), making the reading independently complete and faithful.\",\n      \"verdict\": \"supported\"\n    },\n    {\n      \"proposal_id\": \"P0001\",\n      \"source_refs\": [\"F000\", \"F001\"],\n      \"rationale\": \"Populating optional component fields such as action and object does not resolve the missing governing content requirement from clause (ii). Because the edit fails to make the reading independently complete, it is unsupported.\",\n      \"verdict\": \"unsupported\"\n    },\n    {\n      \"proposal_id\": \"P0002\",\n      \"source_refs\": [\"F000\", \"F001\"],\n      \"rationale\": \"The unchanged draft omits the governing content requirement set forth in clause (ii) for electronic requests under clause (i), so it is not independently complete.\",\n      \"verdict\": \"unsupported\"\n    },\n    {\n      \"proposal_id\": \"P0003\",\n      \"source_refs\": [\"F003\", \"F004\"],\n      \"rationale\": \"The unchanged reading for clause (i) already preserves the actor, permission modality, action, object, and timing condition ('during opening hours'). The agency's annual statistics requirement in clause (ii) is a separate actor's reporting duty that must not be imported. Because the reading is already complete and faithful, no change is required.\",\n      \"verdict\": \"supported\"\n    },\n    {\n      \"proposal_id\": \"P0004\",\n      \"source_refs\": [\"F003\", \"F004\"],\n      \"rationale\": \"The draft reading is already independently complete. Modifying the record merely to populate optional component fields (action, object, and scope) is an unnecessary edit.\",\n      \"verdict\": \"unsupported\"\n    },\n    {\n      \"proposal_id\": \"P0005\",\n      \"source_refs\": [\"F000\", \"F001\", \"F002\"],\n      \"rationale\": \"This edit improperly imports an unrelated agency reporting obligation from clause (iii) and mistakenly attributes the duty to publish statistics to applicants.\",\n      \"verdict\": \"unsupported\"\n    }\n  ]\n}",

            "text": "{\n  \"proposals\": [\n    {\n      \"rationale\": \"C0002 references clause (i) for its governing condition. Incorporating the operative scope from clause (i) provides a self-contained default reading that when an attorney general determines it is not feasible to provide notice before filing an action under this subsection, notice and a copy of the complaint must be provided to the Commission at the same time as filing.\",\n      \"operation\": \"edit\",\n      \"target\": \"C0002\",\n      \"qualifies\": [],\n      \"quote\": \"In an action described in clause (i), the attorney general of a State shall provide notice and a copy of the complaint to the Commission at the same time as the attorney general files the action.\",\n      \"fields\": {\n        \"concepts\": [],\n        \"claimants\": [],\n        \"typed_values\": [],\n        \"effective_periods\": [],\n        \"defined_terms\": [],\n        \"term_refs\": [],\n        \"kind\": \"requirement\",\n        \"scope_quotes\": [\n          \"In an action described in clause (i), the attorney general of a State shall provide notice and a copy of the complaint to the Commission at the same time as the attorney general files the action.\",\n          \"Subparagraph (A) shall not apply with respect to the filing of an action by an attorney general of a State under this subsection, if the attorney general determines that it is not feasible to provide the notice described in that subparagraph before the filing of the action.\"\n        ],\n        \"scope_text\": \"In an action by an attorney general of a State under this subsection, if the attorney general determines that it is not feasible to provide the notice described in that subparagraph before the filing of the action\",\n        \"context_quotes\": [],\n        \"modality_quote\": \"shall\",\n        \"modality\": \"must\",\n        \"alternative_quotes\": [],\n        \"choice_quote\": \"\",\n        \"choice_text\": \"\",\n        \"logic_text\": \"In an action described in clause (i), the attorney general of a State shall provide notice and a copy of the complaint to the Commission at the same time as the attorney general files the action.\",\n        \"actor_quote\": \"the attorney general of a State\",\n        \"actor\": \"the attorney general of a State\",\n        \"action_quote\": \"provide\",\n        \"action\": \"provide\",\n        \"object_quote\": \"notice and a copy of the complaint\",\n        \"object\": \"notice and a copy of the complaint\",\n        \"jurisdiction_quote\": \"\",\n        \"jurisdiction\": \"\",\n        \"relation\": \"none\",\n        \"references\": [\n          \"clause (i)\"\n        ],\n        \"summary\": \"In an action by an attorney general of a State under this subsection where the attorney general determines that it is not feasible to provide the notice described in subparagraph (A) before filing the action, the attorney general of a State shall provide notice and a copy of the complaint to the Commission at the same time as the attorney general files the action.\"\n      }\n    }\n  ],\n  \"observations\": [\n    {\n      \"quote\": \"(A) In general Before filing an action under paragraph (1), the attorney general of the State involved shall provide to the Commission—\\n\\n(i) written notice of that action; and\\n\\n(ii) a copy of the complaint for that action.\",\n      \"rationale\": \"C0000 already provides a complete and faithful representation of subparagraph (A), and referenced paragraph (1) is outside the supplied source text and cannot be resolved here.\",\n      \"disposition\": \"already_represented\"\n    },\n    {\n      \"quote\": \"Subparagraph (A) shall not apply with respect to the filing of an action by an attorney general of a State under this subsection, if the attorney general determines that it is not feasible to provide the notice described in that subparagraph before the filing of the action.\",\n      \"rationale\": \"C0001 is already independently complete in setting forth the exemption from subparagraph (A) when the attorney general determines prior notice is not feasible.\",\n      \"disposition\": \"already_represented\"\n    }\n  ]\n}",

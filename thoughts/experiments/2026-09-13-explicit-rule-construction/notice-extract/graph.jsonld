      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:375767ee6f9b826eef0dec4ab68a9414efc107a699a4b0f50d885d0b4279615f\",\"urn:rulespec:document-understanding:assertion:1521981a8288b8070c80f0dbf555bf5cc4ee7f3bcb57c7c74d053220eaa91b26\",\"urn:rulespec:document-understanding:assertion:ed61d87d3ba311f3e954d71f5ddc93e7fb85d0637f6ba2062d6f3d15cc3b4728\",\"urn:rulespec:document-understanding:assertion:6d81eb750bd1029ce92fc587da252f67060ba51c8a57edc2e2cb39372aaca179\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":542,\"evidence\":[{\"end\":542,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A0c61a50e5689400a9508156758910cf258b73866d6dbe1c0e05fe60a6431f452:268:542:sha256-8a080febaa88583509f3a18c581aab5ac5711d8711bcc8c64256acf22631ef64\",\"quote\":\"Subparagraph (A) shall not apply with respect to the filing of an action by an attorney general of a State under this subsection, if the attorney general determines that it is not feasible to provide the notice described in that subparagraph before the filing of the action.\",\"start\":268},{\"end\":300,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A0c61a50e5689400a9508156758910cf258b73866d6dbe1c0e05fe60a6431f452:285:300:sha256-7001dc18e4250cacd3b4c31ed3fe0df3af0a721931a03c64cc5478da04eb29bd\",\"quote\":\"shall not apply\",\"start\":285},{\"end\":542,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A0c61a50e5689400a9508156758910cf258b73866d6dbe1c0e05fe60a6431f452:268:542:sha256-8a080febaa88583509f3a18c581aab5ac5711d8711bcc8c64256acf22631ef64\",\"quote\":\"Subparagraph (A) shall not apply with respect to the filing of an action by an attorney general of a State under this subsection, if the attorney general determines that it is not feasible to provide the notice described in that subparagraph before the filing of the action.\",\"start\":268}],\"id\":\"urn:rulespec:document-understanding:revision:5cf7b36875f2aac4e384c331667158a8de02dd3e3adb50c6f5d1c085e3a39370\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"exemption\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:6d81eb750bd1029ce92fc587da252f67060ba51c8a57edc2e2cb39372aaca179\",\"modality\":\"not_required\",\"modality_quote\":\"shall not apply\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:d6d7d48a492e84aedcee0ec143f996d2abb50eb709ba3001f72c9e26b806a78e\",\"origin\":\"aiSuggested\",\"quote\":\"Subparagraph (A) shall not apply with respect to the filing of an action by an attorney general of a State under this subsection, if the attorney general determines that it is not feasible to provide the notice described in that subparagraph before the filing of the action.\",\"references\":[\"Subparagraph (A)\",\"this subsection\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:afef99488dd5b86fc30d1cdd6f4f1ec52fa5f672bea4b565358df36c271e653c\",\"scope_quotes\":[\"Subparagraph (A) shall not apply with respect to the filing of an action by an attorney general of a State under this subsection, if the attorney general determines that it is not feasible to provide the notice described in that subparagraph before the filing of the action.\"],\"scope_text\":\"if the attorney general determines that it is not feasible to provide the notice described in that subparagraph before the filing of the action\",\"section_id\":\"section-1\",\"start\":268,\"summary\":\"Subparagraph (A) shall not apply with respect to the filing of an action by an attorney general of a State under this subsection, if the attorney general determines that it is not feasible to provide the notice described in that subparagraph before the filing of the action.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

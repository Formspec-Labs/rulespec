@experiment(explicitopen)
package documentunderstanding

import core "rulespec.invalid/core:rkaf"

// Select Core's numeric, uncalibrated model-inference case. Metadata is added
// deterministically after capture rather than repeatedly generated by the model.
#NumericConfidence: core.#ConfidenceRecord & {
    "rkaf:confidenceMethod": "rkaf:model-inference"
    "rkaf:calibrationStatus": "rkaf:uncalibrated"
    // Supply a nonempty list shape so native CUE can evaluate Core's MinItems.
    "rkaf:confidenceBasis": [string, ...string]
    "rkaf:score": number
}

#SelfConfidence: {
    // Probability that this individual statement preserves its complete source
    // meaning and all governing conditions needed for independent use. This is
    // not confidence that every rule in the document was extracted. Missing
    // qualifiers, alternatives, required details or unresolved dependencies
    // reduce confidence even when the passage is clear and the quote is exact.
    score!: #NumericConfidence["rkaf:score"]
    // Brief externally checkable grounds or specific uncertainty for this score.
    // Describe source ambiguity or a dependency; do not give private reasoning
    // or a step-by-step account. One short basis is usually sufficient.
    basis!: #NumericConfidence["rkaf:confidenceBasis"]
}

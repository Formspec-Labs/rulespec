{
  "type": "object",
  "properties": {
    "judgments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "proposal_id": {
            "type": "string",
            "minLength": 1
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "Select a supplied focus (F000) or context (C000) passage, or a contiguous\ninclusive range such as F003:F009. These locate exact source text; they do\nnot prove that the text supports the proposed meaning. Never invent IDs.",
              "title": "Source passage reference"
            }
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "verdict": {
            "type": "string",
            "enum": [
              "supported",
              "unsupported",
              "unknown"
            ]
          }
        },
        "required": [
          "proposal_id",
          "source_refs",
          "rationale",
          "verdict"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "judgments"
  ],
  "additionalProperties": false
}

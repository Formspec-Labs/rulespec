            "text": "{\n  \"judgments\": [\n    {\n      \"proposal_id\": \"P0001\",\n      \"source_refs\": [\n        \"F003\"\n      ],\n      \"rationale\": \"The proposed summary claims that the employer must permit use 'immediately after the request, even if the use of the compensatory time unduly disrupts the operations of the public agency.' This directly contradicts the source text, which specifies that the employee shall be permitted to use the time 'within a reasonable period after making the request if the use of the compensatory time does not unduly disrupt the operations of the public agency.'\",\n      \"verdict\": \"unsupported\"\n    },\n    {\n      \"proposal_id\": \"P0002\",\n      \"source_refs\": [\n        \"F000:F003\"\n      ],\n      \"rationale\": \"Empty optional action/object fields are valid when the default statement already expresses that meaning. Filling action and action_quote alone without rectifying an actual defect in the existing claim is not a needed correction.\",\n      \"verdict\": \"unsupported\"\n    },\n    {\n      \"proposal_id\": \"P0003\",\n      \"source_refs\": [\n        \"F000:F003\"\n      ],\n      \"rationale\": \"Filling optional action fields where the meaning is already expressed is not a needed correction, and substituting 'is required to permit' for 'must permit' in the summary is a mere paraphrase duplicate.\",\n      \"verdict\": \"unsupported\"\n    }\n  ]\n}",

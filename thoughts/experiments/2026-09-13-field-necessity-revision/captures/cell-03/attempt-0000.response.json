            "text": "{\n  \"judgments\": [\n    {\n      \"proposal_id\": \"P0001\",\n      \"source_refs\": [\n        \"F000\",\n        \"F002:F004\"\n      ],\n      \"rationale\": \"The proposal modifies the summary to restrict inspections of records relating to a traced firearm involved in a criminal investigation to 'not more than once during any 12-month period'. Under item (ii)(II) (F004), inspection of such records may occur 'at any time', which is a disjunctive alternative to the 12-month limitation set out in item (ii)(I) (F003). Conflating the two conditions contradicts the statutory text.\",\n      \"verdict\": \"unsupported\"\n    },\n    {\n      \"proposal_id\": \"P0002\",\n      \"source_refs\": [\n        \"F000\",\n        \"F002\",\n        \"F004\"\n      ],\n      \"rationale\": \"The proposal populates the optional action and action_quote fields with 'inspect or examine', which merely copies meaning already fully and accurately expressed in the summary without adding missing legal requirements or fixing any defect.\",\n      \"verdict\": \"unsupported\"\n    },\n    {\n      \"proposal_id\": \"P0003\",\n      \"source_refs\": [\n        \"F000\",\n        \"F002\",\n        \"F004\"\n      ],\n      \"rationale\": \"The proposal populates optional action fields and rephrases 'may' as 'is permitted to' in the summary. This is an unnecessary edit that duplicates meaning already present in the existing claim without adding missing conditions, alternatives, or resolving any defect.\",\n      \"verdict\": \"unsupported\"\n    }\n  ]\n}",

      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:a6d9bb6468738d995c5863a7467a4b5b7d5871d08bd3a99955e99f7a374b4a56\",\"urn:rulespec:document-understanding:assertion:72e6ed4155d8fdf990f905e499975b55495bbd3f5627efcf5b4eea24bdbf7ae7\",\"urn:rulespec:document-understanding:assertion:eea5a6f83eb1bb3385770b1af0a0c159b40012af41912dea58a2112ba32d6fbe\",\"urn:rulespec:document-understanding:assertion:f0b351a3d4d31b4db5c18bf32da7a9edba4f01c78bf0ffe6531f984fdc38f89d\",\"urn:rulespec:document-understanding:assertion:43898efe98e9217ecfa22a5ba4a1f7beb1115f131d3b315a2e637e462ad598c3\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[{\"aliases\":[],\"id\":\"urn:rulespec:document-understanding:term:416541910199abb487aff28471963ca787bbd39ed3577591fed2393cce9982ba\",\"label\":\"driving\",\"quote\":\"(b) Definitions. For the purpose of this section only, driving means operating a commercial motor vehicle on a highway, including while temporarily stationary because of traffic, a traffic control device, or other momentary delays. Driving does not include operating a commercial motor vehicle when the driver has moved the vehicle to the side of, or off, a highway and has halted in a location where the vehicle can safely remain stationary.\",\"source_quotes\":[\"(b) Definitions. For the purpose of this section only, driving means operating a commercial motor vehicle on a highway, including while temporarily stationary because of traffic, a traffic control device, or other momentary delays. Driving does not include operating a commercial motor vehicle when the driver has moved the vehicle to the side of, or off, a highway and has halted in a location where the vehicle can safely remain stationary.\"]}],\"effective_periods\":[],\"end\":681,\"evidence\":[{\"end\":681,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aeea6f9af573d2466bff9ef98dc0c66b64635c38ad20fe69d1f931ba3cf658c47:239:681:sha256-75749108efbfb4009ce66146e0d1a8fc38f01ea94e9019cf53889e3da46107eb\",\"quote\":\"(b) Definitions. For the purpose of this section only, driving means operating a commercial motor vehicle on a highway, including while temporarily stationary because of traffic, a traffic control device, or other momentary delays. Driving does not include operating a commercial motor vehicle when the driver has moved the vehicle to the side of, or off, a highway and has halted in a location where the vehicle can safely remain stationary.\",\"start\":239},{\"end\":681,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aeea6f9af573d2466bff9ef98dc0c66b64635c38ad20fe69d1f931ba3cf658c47:239:681:sha256-75749108efbfb4009ce66146e0d1a8fc38f01ea94e9019cf53889e3da46107eb\",\"quote\":\"(b) Definitions. For the purpose of this section only, driving means operating a commercial motor vehicle on a highway, including while temporarily stationary because of traffic, a traffic control device, or other momentary delays. Driving does not include operating a commercial motor vehicle when the driver has moved the vehicle to the side of, or off, a highway and has halted in a location where the vehicle can safely remain stationary.\",\"start\":239},{\"end\":681,\"field\":\"defined_terms:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aeea6f9af573d2466bff9ef98dc0c66b64635c38ad20fe69d1f931ba3cf658c47:239:681:sha256-75749108efbfb4009ce66146e0d1a8fc38f01ea94e9019cf53889e3da46107eb\",\"quote\":\"(b) Definitions. For the purpose of this section only, driving means operating a commercial motor vehicle on a highway, including while temporarily stationary because of traffic, a traffic control device, or other momentary delays. Driving does not include operating a commercial motor vehicle when the driver has moved the vehicle to the side of, or off, a highway and has halted in a location where the vehicle can safely remain stationary.\",\"start\":239},{\"end\":681,\"field\":\"defined_terms:0:source:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aeea6f9af573d2466bff9ef98dc0c66b64635c38ad20fe69d1f931ba3cf658c47:239:681:sha256-75749108efbfb4009ce66146e0d1a8fc38f01ea94e9019cf53889e3da46107eb\",\"quote\":\"(b) Definitions. For the purpose of this section only, driving means operating a commercial motor vehicle on a highway, including while temporarily stationary because of traffic, a traffic control device, or other momentary delays. Driving does not include operating a commercial motor vehicle when the driver has moved the vehicle to the side of, or off, a highway and has halted in a location where the vehicle can safely remain stationary.\",\"start\":239}],\"id\":\"urn:rulespec:document-understanding:revision:b2c910ffa65bf1322c1c7ef7105a501e8c23a4b277fbc4ab4a71816b5e7e9796\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"definition\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:f0b351a3d4d31b4db5c18bf32da7a9edba4f01c78bf0ffe6531f984fdc38f89d\",\"modality\":\"not_stated\",\"modality_quote\":\"\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:964701cb9d096e119b5fb91afd30986f72f6db14bff542236b8518e0c6796f42\",\"origin\":\"aiSuggested\",\"quote\":\"(b) Definitions. For the purpose of this section only, driving means operating a commercial motor vehicle on a highway, including while temporarily stationary because of traffic, a traffic control device, or other momentary delays. Driving does not include operating a commercial motor vehicle when the driver has moved the vehicle to the side of, or off, a highway and has halted in a location where the vehicle can safely remain stationary.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:43c66f9c7d6d0ed3b6491f50ffad8b9b010850de23872e3162269cc5cae82497\",\"scope_quotes\":[\"(b) Definitions. For the purpose of this section only, driving means operating a commercial motor vehicle on a highway, including while temporarily stationary because of traffic, a traffic control device, or other momentary delays. Driving does not include operating a commercial motor vehicle when the driver has moved the vehicle to the side of, or off, a highway and has halted in a location where the vehicle can safely remain stationary.\"],\"scope_text\":\"For the purpose of this section only\",\"section_id\":\"section-1\",\"start\":239,\"summary\":\"For the purpose of this section only, driving means operating a commercial motor vehicle on a highway, including while temporarily stationary because of traffic, a traffic control device, or other momentary delays, but does not include operating a commercial motor vehicle when the driver has moved the vehicle to the side of, or off, a highway and has halted in a location where the vehicle can safely remain stationary.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

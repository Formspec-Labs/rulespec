      "dcterms:description": "{\"action\":\"\",\"actor\":\"A member of the IEP Team\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:36097a475a61f5672ba4f4fbd018e2411559edf69089a4b99d2ec0e142c28359\",\"urn:rulespec:document-understanding:assertion:750b3c58db8eea9eb8674e68fc6fd785e7b0f9b17502e22001e51febc74b4e7b\",\"urn:rulespec:document-understanding:assertion:45307d1a7f57e216f1ba1e19716ff5094992537398b565f2bc64c4fa30e4f113\",\"urn:rulespec:document-understanding:assertion:3bd0d5d55217ef10583203121438f74b64988b76b8ef41f2458b944366c873bc\",\"urn:rulespec:document-understanding:assertion:1dbe0dd28c2c423892c09cc713d85ce32a5916724df95e54b5a6449612ff1189\",\"urn:rulespec:document-understanding:assertion:a6fd598ba580dd2723810c1c40029254e0823ceaa88481ad15de0b404cf83e3d\",\"urn:rulespec:document-understanding:assertion:9201950770e9fec8fdbe4df16617ed78950efda4d111ea5383eaa7b85a996e5f\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":5946,\"evidence\":[{\"end\":5946,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Adf83a189da3bcf757923be2b59f664531586049d05e4de102f73c6e815be2602:5604:5946:sha256-0dc6c38e9c660bd9444211df221b83a721c85d16c07cbb195caa8b9f68a53378\",\"quote\":\"A member of the IEP Team shall not be required to attend an IEP meeting, in whole or in part, if the parent of a child with a disability and the local educational agency agree that the attendance of such member is not necessary because the member’s area of the curriculum or related services is not being modified or discussed in the meeting.\",\"start\":5604},{\"end\":5628,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Adf83a189da3bcf757923be2b59f664531586049d05e4de102f73c6e815be2602:5604:5628:sha256-19747a74c3669a80ed9893
      "rkaf:assertsValue": {
        "@value": "{\"actor\":\"A member of the IEP Team\",\"kind\":\"permission\",\"modality\":\"may\",\"scope_text\":\"when the meeting involves a modification to or discussion of the member’s area of the curriculum or related services, if the parent and the local educational agency consent to the excusal, and the member submits, in writing to the parent and the IEP Team, input into the development of the IEP prior to the meeting\",\"summary\":\"A member of the IEP Team may be excused from attending an IEP meeting, in whole or in part, when the meeting involves a modification to or discussion of the member’s area of the curriculum or related services, if the parent and the local educational agency consent to the excusal, and the member submits, in writing to the parent and the IEP Team, input into the development of the IEP prior to the meeting.\",\"term_refs\":[\"urn:rulespec:document-understanding:term:ff87d5b603a406f9d3058b501b37bb1a52c0667c1083431a6e113c977873df99\",\"urn:rulespec:document-understanding:term:f73e079be18b17866a9f1e238515cea80d281ec123b9a876f6fcc6aa8806c2d0\"]}",

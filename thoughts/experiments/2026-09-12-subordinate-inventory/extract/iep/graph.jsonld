      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"A member of the IEP Team\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:a2e7c96b095ee2e3b9f2ee761f0b34f4928c7533f487bac1b1e76cb5bc678087\",\"urn:rulespec:document-understanding:assertion:df020ff417d89391faf624c79e50d5a84f84dfdcb3e701818e8052219302b12e\",\"urn:rulespec:document-understanding:assertion:acade4d7be69c84d26dcb7ea2bf7306582211dca739388f700eaa0304d30fc16\",\"urn:rulespec:document-understanding:assertion:37d4ce8a852c95004331d9c780050673ad6c29e33e9ff3f359f25d76bab15e2c\",\"urn:rulespec:document-understanding:assertion:ef193d4a9627ecaa4898b3fae26aed8f1e91ad5404c6aea23f1d34b31c9c387b\",\"urn:rulespec:document-understanding:assertion:a23ed6cc9930fa41735b52559f3cd578066f5cd52dfc54646cf70e1b065504b9\",\"urn:rulespec:document-understanding:assertion:ff83579688462d83d3459433ab86e77d4f196ace94237b79ca837e99af239edf\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":6381,\"evidence\":[{\"end\":5961,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Adf83a189da3bcf757923be2b59f664531586049d05e4de102f73c6e815be2602:5949:5961:sha256-4e9cd596664ada9a5511b0268819d845b5979e1d93bda42db56079c479d85862\",\"quote\":\"(ii) Excusal\",\"start\":5949},{\"end\":6175,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Adf83a189da3bcf757923be2b59f664531586049d05e4de102f73c6e815be2602:5962:6175:sha256-d5e0187a89d6636f0dfcb65efe58c4e3e2f7d6553147acdc63b8cffb2ef8717e\",\"quote\":\"A member of the IEP Team may be excused from attending an IEP meeting, in whole or in part, when the meeting involves a modification to or discussion of the member’s area of the curriculum or related services, if—\",\"start\":5962},{\"end\":6381,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Adf83a189da3bcf757923be2b59f664531586049d05e4de102f73c6e815be2602:6177:6381:sha256-8cbbfe074eb25eb6e333f900de70c200224fcf4faa3b04849f4fb45c83bd91f9\",\"quote\":\"(I) the parent and the local educational agency consent to the excusal; and\\n\\n(II) the member submits, in writing to the parent and the IEP Team, input into the development of the IEP prior to the meeting.\",\"start\":6177},{\"end\":5986,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Adf83a189da3bcf757923be2b59f664531586049d05e4de102f73c6e815be2602:5962:5986:sha256-19747a74c3669a80ed9893f3ce38ca9384d5daff85828333fd14cc45d353ee18\",\"quote\":\"A member of the IEP Team\",\"start\":5962},{\"end\":5990,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Adf83a189da3bcf757923be2b59f664531586049d05e4de102f73c6e815be2602:5987:5990:sha256-ee4d988c65de860fabbfbcd27f73d50bbebe3fba37fe419284f4811389c30bdc\",\"quote\":\"may\",\"start\":5987},{\"end\":5961,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Adf83a189da3bcf757923be2b59f664531586049d05e4de102f73c6e815be2602:5949:5961:sha256-4e9cd596664ada9a5511b0268819d845b5979e1d93bda42db56079c479d85862\",\"quote\":\"(ii) Excusal\",\"start\":5949},{\"end\":6175,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Adf83a189da3bcf757923be2b59f664531586049d05e4de102f73c6e815be2602:5962:6175:sha256-d5e0187a89d6636f0dfcb65efe58c4e3e2f7d6553147acdc63b8cffb2ef8717e\",\"quote\":\"A member of the IEP Team may be excused from attending an IEP meeting, in whole or in part, when the meeting involves a modification to or discussion of the member’s area of the curriculum or related services, if—\",\"start\":5962},{\"end\":6381,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Adf83a189da3bcf757923be2b59f664531586049d05e4de102f73c6e815be2602:6177:6381:sha256-8cbbfe074eb25eb6e333f900de70c200224fcf4faa3b04849f4fb45c83bd91f9\",\"quote\":\"(I) the parent and the local educational agency consent to the excusal; and\\n\\n(II) the member submits, in writing to the parent and the IEP Team, input into the development of the IEP prior to the meeting.\",\"start\":6177}],\"id\":\"urn:rulespec:document-understanding:revision:3b6e0e699752bb47f417c3141cf394911b4b3d5708b9d19cd396ca275b2808bc\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"permission\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:ef193d4a9627ecaa4898b3fae26aed8f1e91ad5404c6aea23f1d34b31c9c387b\",\"modality\":\"may\",\"modality_quote\":\"may\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:b4191256cb7ac5761c6a662ee9c5e1789add3a04715f959e677c906c36380559\",\"origin\":\"aiSuggested\",\"quote\":\"(ii) Excusal A member of the IEP Team may be excused from attending an IEP meeting, in whole or in part, when the meeting involves a modification to or discussion of the member’s area of the curriculum or related services, if—\\n\\n(I) the parent and the local educational agency consent to the excusal; and\\n\\n(II) the member submits, in writing to the parent and the IEP Team, input into the development of the IEP prior to the meeting.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:bd2e8ebe0408a76eba2d246606608cf222ae8dfac6656643e370333c8030a424\",\"scope_quotes\":[\"(ii) Excusal A member of the IEP Team may be excused from attending an IEP meeting, in whole or in part, when the meeting involves a modification to or discussion of the member’s area of the curriculum or related services, if—\\n\\n(I) the parent and the local educational agency consent to the excusal; and\\n\\n(II) the member submits, in writing to the parent and the IEP Team, input into the development of the IEP prior to the meeting.\"],\"scope_text\":\"when the meeting involves a modification to or discussion of the member’s area of the curriculum or related services, if the parent and the local educational agency consent to the excusal, and the member submits, in writing to the parent and the IEP Team, input into the development of the IEP prior to the meeting\",\"section_id\":\"section-1\",\"start\":5949,\"summary\":\"A member of the IEP Team may be excused from attending an IEP meeting, in whole or in part, when the meeting involves a modification to or discussion of the member’s area of the curriculum or related services, if the parent and the local educational agency consent to the excusal, and the member submits, in writing to the parent and the IEP Team, input into the development of the IEP prior to the meeting.\",\"target_ids\":[],\"term_refs\":[\"urn:rulespec:document-understanding:term:ff87d5b603a406f9d3058b501b37bb1a52c0667c1083431a6e113c977873df99\",\"urn:rulespec:document-understanding:term:f73e079be18b17866a9f1e238515cea80d281ec123b9a876f6fcc6aa8806c2d0\"],\"typed_values\":[]}",

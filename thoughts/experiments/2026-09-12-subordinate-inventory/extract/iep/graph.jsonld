    {
      "@id": "urn:rulespec:document-understanding:revision:96f5b7a40d48510dff36f0a9b1b65a78efb63b6346eb4fa9912150905be8ff4d",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:96f5b7a40d48510dff36f0a9b1b65a78efb63b6346eb4fa9912150905be8ff4d",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:ca3db64b1789b50353cec613b5c385887a29a3da4346164273fbc86c52f10a3d",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:07d4bb21f622c7f5276f9014b02eef5459a5020165cd404c03156a540e8f5ffe\",\"urn:rulespec:document-understanding:assertion:f946ff3e631c45cc3077094a42f56dfab08c8d32ab2f99d7ae78814c479d2648\",\"urn:rulespec:document-understanding:assertion:e4065ca1a334a165a437ca2aae7df9a35f2934a6c3a39cac1d87099419af7370\",\"urn:rulespec:document-understanding:assertion:5eea40b03b36661d9795cb995ed50932c218657ca9f4e1e3757808acc625b9d7\",\"urn:rulespec:document-understanding:assertion:5321a64d1bbab34128ad8f3e0efab8c73cc87b3c56630f95e1b6f3756980a9b2\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[{\"aliases\":[\"IEP\"],\"id\":\"urn:rulespec:document-understanding:term:ff87d5b603a406f9d3058b501b37bb1a52c0667c1083431a6e113c977873df99\",\"label\":\"individualized education program\",\"quote\":\"(i) In general The term “individualized education program” or “IEP” means a written statement for each child with a disability that is developed, reviewed, and revised in accordance with this section and that includes—\\n\\n(I) a statement of the child’s present levels of academic achievement and functional performance, including—\\n\\n(aa) how the child’s disability affects the child’s involvement and progress in the general education curriculum;\\n\\n(bb) for preschool children, as appropriate, how the disability affects the child’s participation in appropriate activities; and\\n\\n(cc) for children with disabilities who take alternate assessments aligned to alternate achievement standards, a description of benchmarks or short-term objectives;\\n\\n\\n(II) a statement of measurable annual goals, including academic and functional goals, designed to—\\n\\n(aa) meet the child’s needs that result from the child’s disability to enable the child to be involved in and make progress in the general education curriculum; and\\n\\n(bb) meet each of the child’s other educational needs that result from the child’s disability;\\n\\n\\n(III) a description of how the child’s progress toward meeting the annual goals described in subclause (II) will be measured and when periodic reports on the progress the child is making toward meeting the annual goals (such as through the use of quarterly or other periodic reports, concurrent with the issuance of report cards) will be provided;\\n\\n(IV) a statement of the special education and related services and supplementary aids and services, based on peer-reviewed research to the extent practicable, to be provided to the child, or on behalf of the child, and a statement of the program modifications or supports for school personnel that will be provided for the child—\\n\\n(aa) to advance appropriately toward attaining the annual goals;\\n\\n(bb) to be involved in and make progress in the general education curriculum in accordance with subclause (I) and to participate in extracurricular and other nonacademic activities; and\\n\\n(cc) to be educated and participate with other children with disabilities and nondisabled children in the activities described in this subparagraph;\\n\\n\\n(V) an explanation of the extent, if any, to which the child will not participate with nondisabled children in the regular class and in the activities described in subclause (IV)(cc);\\n\\n(VI)\\n\\n(aa) a statement of any individual appropriate accommodations that are necessary to measure the academic achievement and functional performance of the child on State and districtwide assessments consistent with section 1412(a)(16)(A) of this title; and\\n\\n(bb) if the IEP Team determines that the child shall take an alternate assessment on a particular State or districtwide assessment of student achievement, a statement of why—\\n\\n(AA) the child cannot participate in the regular assessment; and\\n\\n(BB) the particular alternate assessment selected is appropriate for the child;\\n\\n\\n\\n(VII) the projected date for the beginning of the services and modifications described in subclause (IV), and the anticipated frequency, location, and duration of those services and modifications; and\\n\\n(VIII) beginning not later than the first IEP to be in effect when the child is 16, and updated annually thereafter—\\n\\n(aa) appropriate measurable postsecondary goals based upon age appropriate transition assessments related to training, education, employment, and, where appropriate, independent living skills;\\n\\n(bb) the transition services (including courses of study) needed to assist the child in reaching those goals; and\\n\\n(cc) beginning not later than 1 year before the child reaches the age of majority under State law, a statement that the child has been informed of the child’s rights under this chapter, if any, that will transfer to the child on reaching the age of majority under section 1415(m) of this title.\",\"source_quotes\":[\"(A) Individualized education program\",\"(i) In general The term “individualized education program” or “IEP” means a written statement for each child with a disability that is developed, reviewed, and revised in accordance with this section and that includes—\"]}],\"effective_periods\":[],\"end\":3954,\"evidence\":[{\"end\":86,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Adf83a189da3bcf757923be2b59f664531586049d05e4de102f73c6e815be2602:72:86:sha256-5b7a5118168f01eb0c113c4a86fb8eaaf3152b12972bcf36b8bf52bf0f5a8c4f\",\"quote\":\"(i) In general\",\"start\":72},{\"end\":290,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Adf83a189da3bcf757923be2b59f664531586049d05e4de102f73c6e815be2602:87:290:sha256-397b7c8f04f0d9335161d6050807b633a0d95287022c742fa7516e2762be23da\",\"quote\":\"The term “individualized education program” or “IEP” means a written statement for each child with a disability that is developed, reviewed, and revised in accordance with this section and that includes—\",\"start\":87},{\"end\":400,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Adf83a189da3bcf757923be2b59f664531586049d05e4de102f73c6e815be2602:292:400:sha256-d8268eeb3e438ee7d13866f6dd2737ba76f2bae745115e75bd5c8ea3b4348197\",\"quote\":\"(I) a statement of the child’s present levels of academic achievement and functional performance, including—\",\"start\":292},{\"end\":912,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Adf83a189da3bcf757923be2b59f664531586049d05e4de102f73c6e815be2602:402:912:sha256-b3816d809c99d3b40df4f79337601b0d9bf169386cbf3f80d7b915239ccdacb6\",\"quote\":\"(aa) how the child’s disability affects the child’s involvement and progress in the general education curriculum;\\n\\n(bb) for preschool children, as appropriate, how the disability affects the child’s participation in appropriate activities; and\\n\\n(cc) for children with disabilities who take alternate assessments aligned to alternate achievement standards, a description of benchmarks or short-term objectives;\\n\\n\\n(II) a statement of measurable annual goals, including academic and functional goals, designed to—\",\"start\":402},{\"end\":1855,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Adf83a189da3bcf757923be2b59f664531586049d05e4de102f73c6e815be2602:914:1855:sha256-d9af7729cd004e01a8e0c4b0cf0d9ec8b7407534e21b1e43f81246828ca4957c\",\"quote\":\"(aa) meet the child’s needs that result from the child’s disability to enable the child to be involved in and make progress in the general education curriculum; and\\n\\n(bb) meet each of the child’s other educational needs that result from the child’s disability;\\n\\n\\n(III) a description of how the child’s progress toward meeting the annual goals described in subclause (II) will be measured and when periodic reports on the progress the child is making toward meeting the annual goals (such as through the use of quarterly or other periodic reports, concurrent with the issuance of report cards) will be provided;\\n\\n(IV) a statement of the special education and related services and supplementary aids and services, based on peer-reviewed research to the extent practicable, to be provided to the child, or on behalf of the child, and a statement of the program modifications or supports for school personnel that will be provided for the child—\",\"start\":914},{\"end\":2450,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Adf83a189da3bcf757923be2b59f664531586049d05e4de102f73c6e815be2602:1857:2450:sha256-332a21d992b8bc73589950ddcb8db40871c362af41dfe011d2cafcbf87f5efc5\",\"quote\":\"(aa) to advance appropriately toward attaining the annual goals;\\n\\n(bb) to be involved in and make progress in the general education curriculum in accordance with subclause (I) and to participate in extracurricular and other nonacademic activities; and\\n\\n(cc) to be educated and participate with other children with disabilities and nondisabled children in the activities described in this subparagraph;\\n\\n\\n(V) an explanation of the extent, if any, to which the child will not participate with nondisabled children in the regular class and in the activities described in subclause (IV)(cc);\\n\\n(VI)\",\"start\":1857},{\"end\":2880,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Adf83a189da3bcf757923be2b59f664531586049d05e4de102f73c6e815be2602:2452:2880:sha256-8410bd31d33ba2b8988a02a767e38387b97050c20c4edf9a2868949487cd28e0\",\"quote\":\"(aa) a statement of any individual appropriate accommodations that are necessary to measure the academic achievement and functional performance of the child on State and districtwide assessments consistent with section 1412(a)(16)(A) of this title; and\\n\\n(bb) if the IEP Team determines that the child shall take an alternate assessment on a particular State or districtwide assessment of student achievement, a statement of why—\",\"start\":2452},{\"end\":3349,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Adf83a189da3bcf757923be2b59f664531586049d05e4de102f73c6e815be2602:2882:3349:sha256-42daa51946ac531781fc350508e1f255d194b372394a841d50b3dee366daead9\",\"quote\":\"(AA) the child cannot participate in the regular assessment; and\\n\\n(BB) the particular alternate assessment selected is appropriate for the child;\\n\\n\\n\\n(VII) the projected date for the beginning of the services and modifications described in subclause (IV), and the anticipated frequency, location, and duration of those services and modifications; and\\n\\n(VIII) beginning not later than the first IEP to be in effect when the child is 16, and updated annually thereafter—\",\"start\":2882},{\"end\":3954,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Adf83a189da3bcf757923be2b59f664531586049d05e4de102f73c6e815be2602:3351:3954:sha256-dd3769a16f16c6c8aeda8eab0c92cec715ba5872142aabd7ed3dd863a5a0debf\",\"quote\":\"(aa) appropriate measurable postsecondary goals based upon age appropriate transition assessments related to training, education, employment, and, where appropriate, independent living skills;\\n\\n(bb) the transition services (including courses of study) needed to assist the child in reaching those goals; and\\n\\n(cc) beginning not later than 1 year before the child reaches the age of majority under State law, a statement that the child has been informed of the child’s rights under this chapter, if any, that will transfer to the child on reaching the age of majority under section 1415(m) of this title.\",\"start\":3351},{\"end\":86,\"field\":\"defined_terms:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Adf83a189da3bcf757923be2b59f664531586049d05e4de102f73c6e815be2602:72:86:sha256-5b7a5118168f01eb0c113c4a86fb8eaaf3152b12972bcf36b8bf52bf0f5a8c4f\",\"quote\":\"(i) In general\",\"start\":72},{\"end\":290,\"field\":\"defined_terms:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Adf83a189da3bcf757923be2b59f664531586049d05e4de102f73c6e815be2602:87:290:sha256-397b7c8f04f0d9335161d6050807b633a0d95287022c742fa7516e2762be23da\",\"quote\":\"The term “individualized education program” or “IEP” means a written statement for each child with a disability that is developed, reviewed, and revised in accordance with this section and that includes—\",\"start\":87},{\"end\":400,\"field\":\"defined_terms:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Adf83a189da3bcf757923be2b59f664531586049d05e4de102f73c6e815be2602:292:400:sha256-d8268eeb3e438ee7d13866f6dd2737ba76f2bae745115e75bd5c8ea3b4348197\",\"quote\":\"(I) a statement of the child’s present levels of academic achievement and functional performance, including—\",\"start\":292},{\"end\":912,\"field\":\"defined_terms:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Adf83a189da3bcf757923be2b59f664531586049d05e4de102f73c6e815be2602:402:912:sha256-b3816d809c99d3b40df4f79337601b0d9bf169386cbf3f80d7b915239ccdacb6\",\"quote\":\"(aa) how the child’s disability affects the child’s involvement and progress in the general education curriculum;\\n\\n(bb) for preschool children, as appropriate, how the disability affects the child’s participation in appropriate activities; and\\n\\n(cc) for children with disabilities who take alternate assessments aligned to alternate achievement standards, a description of benchmarks or short-term objectives;\\n\\n\\n(II) a statement of measurable annual goals, including academic and functional goals, designed to—\",\"start\":402},{\"end\":1855,\"field\":\"defined_terms:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Adf83a189da3bcf757923be2b59f664531586049d05e4de102f73c6e815be2602:914:1855:sha256-d9af7729cd004e01a8e0c4b0cf0d9ec8b7407534e21b1e43f81246828ca4957c\",\"quote\":\"(aa) meet the child’s needs that result from the child’s disability to enable the child to be involved in and make progress in the general education curriculum; and\\n\\n(bb) meet each of the child’s other educational needs that result from the child’s disability;\\n\\n\\n(III) a description of how the child’s progress toward meeting the annual goals described in subclause (II) will be measured and when periodic reports on the progress the child is making toward meeting the annual goals (such as through the use of quarterly or other periodic reports, concurrent with the issuance of report cards) will be provided;\\n\\n(IV) a statement of the special education and related services and supplementary aids and services, based on peer-reviewed research to the extent practicable, to be provided to the child, or on behalf of the child, and a statement of the program modifications or supports for school personnel that will be provided for the child—\",\"start\":914},{\"end\":2450,\"field\":\"defined_terms:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Adf83a189da3bcf757923be2b59f664531586049d05e4de102f73c6e815be2602:1857:2450:sha256-332a21d992b8bc73589950ddcb8db40871c362af41dfe011d2cafcbf87f5efc5\",\"quote\":\"(aa) to advance appropriately toward attaining the annual goals;\\n\\n(bb) to be involved in and make progress in the general education curriculum in accordance with subclause (I) and to participate in extracurricular and other nonacademic activities; and\\n\\n(cc) to be educated and participate with other children with disabilities and nondisabled children in the activities described in this subparagraph;\\n\\n\\n(V) an explanation of the extent, if any, to which the child will not participate with nondisabled children in the regular class and in the activities described in subclause (IV)(cc);\\n\\n(VI)\",\"start\":1857},{\"end\":2880,\"field\":\"defined_terms:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Adf83a189da3bcf757923be2b59f664531586049d05e4de102f73c6e815be2602:2452:2880:sha256-8410bd31d33ba2b8988a02a767e38387b97050c20c4edf9a2868949487cd28e0\",\"quote\":\"(aa) a statement of any individual appropriate accommodations that are necessary to measure the academic achievement and functional performance of the child on State and districtwide assessments consistent with section 1412(a)(16)(A) of this title; and\\n\\n(bb) if the IEP Team determines that the child shall take an alternate assessment on a particular State or districtwide assessment of student achievement, a statement of why—\",\"start\":2452},{\"end\":3349,\"field\":\"defined_terms:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Adf83a189da3bcf757923be2b59f664531586049d05e4de102f73c6e815be2602:2882:3349:sha256-42daa51946ac531781fc350508e1f255d194b372394a841d50b3dee366daead9\",\"quote\":\"(AA) the child cannot participate in the regular assessment; and\\n\\n(BB) the particular alternate assessment selected is appropriate for the child;\\n\\n\\n\\n(VII) the projected date for the beginning of the services and modifications described in subclause (IV), and the anticipated frequency, location, and duration of those services and modifications; and\\n\\n(VIII) beginning not later than the first IEP to be in effect when the child is 16, and updated annually thereafter—\",\"start\":2882},{\"end\":3954,\"field\":\"defined_terms:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Adf83a189da3bcf757923be2b59f664531586049d05e4de102f73c6e815be2602:3351:3954:sha256-dd3769a16f16c6c8aeda8eab0c92cec715ba5872142aabd7ed3dd863a5a0debf\",\"quote\":\"(aa) appropriate measurable postsecondary goals based upon age appropriate transition assessments related to training, education, employment, and, where appropriate, independent living skills;\\n\\n(bb) the transition services (including courses of study) needed to assist the child in reaching those goals; and\\n\\n(cc) beginning not later than 1 year before the child reaches the age of majority under State law, a statement that the child has been informed of the child’s rights under this chapter, if any, that will transfer to the child on reaching the age of majority under section 1415(m) of this title.\",\"start\":3351},{\"end\":70,\"field\":\"defined_terms:0:source:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Adf83a189da3bcf757923be2b59f664531586049d05e4de102f73c6e815be2602:34:70:sha256-8fa27e38d7640bc53f97cd8add1beb4f9413493de4b9e90723dbf03c717dda83\",\"quote\":\"(A) Individualized education program\",\"start\":34},{\"end\":86,\"field\":\"defined_terms:0:source:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Adf83a189da3bcf757923be2b59f664531586049d05e4de102f73c6e815be2602:72:86:sha256-5b7a5118168f01eb0c113c4a86fb8eaaf3152b12972bcf36b8bf52bf0f5a8c4f\",\"quote\":\"(i) In general\",\"start\":72},{\"end\":290,\"field\":\"defined_terms:0:source:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Adf83a189da3bcf757923be2b59f664531586049d05e4de102f73c6e815be2602:87:290:sha256-397b7c8f04f0d9335161d6050807b633a0d95287022c742fa7516e2762be23da\",\"quote\":\"The term “individualized education program” or “IEP” means a written statement for each child with a disability that is developed, reviewed, and revised in accordance with this section and that includes—\",\"start\":87}],\"id\":\"urn:rulespec:document-understanding:revision:96f5b7a40d48510dff36f0a9b1b65a78efb63b6346eb4fa9912150905be8ff4d\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"definition\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:e4065ca1a334a165a437ca2aae7df9a35f2934a6c3a39cac1d87099419af7370\",\"modality\":\"not_stated\",\"modality_quote\":\"\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:b6e277dde878037c5da3271a2d7984708385f20d2c89b5472172f8e93676ffc6\",\"origin\":\"aiSuggested\",\"quote\":\"(i) In general The term “individualized education program” or “IEP” means a written statement for each child with a disability that is developed, reviewed, and revised in accordance with this section and that includes—\\n\\n(I) a statement of the child’s present levels of academic achievement and functional performance, including—\\n\\n(aa) how the child’s disability affects the child’s involvement and progress in the general education curriculum;\\n\\n(bb) for preschool children, as appropriate, how the disability affects the child’s participation in appropriate activities; and\\n\\n(cc) for children with disabilities who take alternate assessments aligned to alternate achievement standards, a description of benchmarks or short-term objectives;\\n\\n\\n(II) a statement of measurable annual goals, including academic and functional goals, designed to—\\n\\n(aa) meet the child’s needs that result from the child’s disability to enable the child to be involved in and make progress in the general education curriculum; and\\n\\n(bb) meet each of the child’s other educational needs that result from the child’s disability;\\n\\n\\n(III) a description of how the child’s progress toward meeting the annual goals described in subclause (II) will be measured and when periodic reports on the progress the child is making toward meeting the annual goals (such as through the use of quarterly or other periodic reports, concurrent with the issuance of report cards) will be provided;\\n\\n(IV) a statement of the special education and related services and supplementary aids and services, based on peer-reviewed research to the extent practicable, to be provided to the child, or on behalf of the child, and a statement of the program modifications or supports for school personnel that will be provided for the child—\\n\\n(aa) to advance appropriately toward attaining the annual goals;\\n\\n(bb) to be involved in and make progress in the general education curriculum in accordance with subclause (I) and to participate in extracurricular and other nonacademic activities; and\\n\\n(cc) to be educated and participate with other children with disabilities and nondisabled children in the activities described in this subparagraph;\\n\\n\\n(V) an explanation of the extent, if any, to which the child will not participate with nondisabled children in the regular class and in the activities described in subclause (IV)(cc);\\n\\n(VI)\\n\\n(aa) a statement of any individual appropriate accommodations that are necessary to measure the academic achievement and functional performance of the child on State and districtwide assessments consistent with section 1412(a)(16)(A) of this title; and\\n\\n(bb) if the IEP Team determines that the child shall take an alternate assessment on a particular State or districtwide assessment of student achievement, a statement of why—\\n\\n(AA) the child cannot participate in the regular assessment; and\\n\\n(BB) the particular alternate assessment selected is appropriate for the child;\\n\\n\\n\\n(VII) the projected date for the beginning of the services and modifications described in subclause (IV), and the anticipated frequency, location, and duration of those services and modifications; and\\n\\n(VIII) beginning not later than the first IEP to be in effect when the child is 16, and updated annually thereafter—\\n\\n(aa) appropriate measurable postsecondary goals based upon age appropriate transition assessments related to training, education, employment, and, where appropriate, independent living skills;\\n\\n(bb) the transition services (including courses of study) needed to assist the child in reaching those goals; and\\n\\n(cc) beginning not later than 1 year before the child reaches the age of majority under State law, a statement that the child has been informed of the child’s rights under this chapter, if any, that will transfer to the child on reaching the age of majority under section 1415(m) of this title.\",\"references\":[\"1412(a)(16)(A)\",\"1415(m)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:e72f11db3362a542e0fa7d4e42dbf9472c1560ea795d233029d84d9daa8fa82e\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":72,\"summary\":\"In this chapter, the term “individualized education program” or “IEP” means a written statement for each child with a disability that is developed, reviewed, and revised in accordance with this section and that includes: (I) a statement of the child’s present levels of academic achievement and functional performance, including how the disability affects involvement and progress in the general education curriculum, for preschool children (as appropriate) how it affects participation in appropriate activities, and for children with disabilities taking alternate assessments aligned to alternate achievement standards, benchmarks or short-term objectives; (II) measurable annual goals (including academic and functional goals) designed to meet needs resulting from the disability to enable involvement and progress in the general education curriculum and meet each other educational need resulting from the disability; (III) a description of how progress toward meeting annual goals will be measured and when periodic progress reports (such as quarterly or other periodic reports, concurrent with report cards) will be provided; (IV) a statement of special education, related services, and supplementary aids and services (based on peer-reviewed research to the extent practicable), and program modifications or supports for school personnel, to advance appropriately toward annual goals, be involved and make progress in the general education curriculum, participate in extracurricular and nonacademic activities, and be educated and participate with other children with disabilities and nondisabled children; (V) an explanation of the extent, if any, to which the child will not participate with nondisabled children in regular class and such activities; (VI) a statement of individual appropriate accommodations necessary to measure academic achievement and functional performance on State and districtwide assessments consistent with section 1412(a)(16)(A), and if the IEP Team determines the child shall take an alternate assessment on a particular State or districtwide assessment of student achievement, a statement of why the child cannot participate in the regular assessment and why the alternate assessment selected is appropriate; (VII) the projected start date for services and modifications, and their anticipated frequency, location, and duration; and (VIII) beginning not later than the first IEP in effect when the child is 16 (updated annually), appropriate measurable postsecondary goals based on age-appropriate transition assessments and transition services needed to assist in reaching them, plus (beginning not later than 1 year before reaching the age of majority under State law) a statement that the child has been informed of rights under this chapter, if any, transferring on reaching majority under section 1415(m).\",\"target_ids\":[],\"term_refs\":[\"urn:rulespec:document-understanding:term:f73e079be18b17866a9f1e238515cea80d281ec123b9a876f6fcc6aa8806c2d0\"],\"typed_values\":[]}",

      "@id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Adf83a189da3bcf757923be2b59f664531586049d05e4de102f73c6e815be2602:292:400:sha256-d8268eeb3e438ee7d13866f6dd2737ba76f2bae745115e75bd5c8ea3b4348197",
      "@type": "rkaf:SourceFragment",
      "oa:hasSource": "urn:rulespec:document-understanding:document:df83a189da3bcf757923be2b59f664531586049d05e4de102f73c6e815be2602",
      "rkaf:fragmentIdentityScheme": "rkaf:carrier-local-fragment",

      "@id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Adf83a189da3bcf757923be2b59f664531586049d05e4de102f73c6e815be2602:4448:4827:sha256-8908debdb2e982a4ec15a0d2d204073f12dbacbb8e52b3e425a1ab59eccd0f44",
      "@type": "rkaf:SourceFragment",
      "oa:hasSource": "urn:rulespec:document-understanding:document:df83a189da3bcf757923be2b59f664531586049d05e4de102f73c6e815be2602",
      "rkaf:fragmentIdentityScheme": "rkaf:carrier-local-fragment",
      "rkaf:sourceArtifactDigest": "sha256:df83a189da3bcf757923be2b59f664531586049d05e4de102f73c6e815be2602",
      "rkaf:fragmentContentDigest": "sha256:8908debdb2e982a4ec15a0d2d204073f12dbacbb8e52b3e425a1ab59eccd0f44",
      "rkaf:selectorKind": [
        "oa:TextQuoteSelector",
        "oa:TextPositionSelector"
      ],
      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "(i) the parents of a child with a disability;\n\n(ii) not less than 1 regular education teacher of such child (if the child is, or may be, participating in the regular education environment);\n\n(iii) not less than 1 special education teacher, or where appropriate, not less than 1 special education provider of such child;\n\n(iv) a representative of the local educational agency who—"
        },
        {
          "@type": "oa:TextPositionSelector",
          "oa:start": 4448,
          "oa:end": 4827,
          "rkaf:coordinateSystem": "rkaf:unicode-codepoint"
        }
      ]
    },
    {
      "@id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Adf83a189da3bcf757923be2b59f664531586049d05e4de102f73c6e815be2602:4829:5546:sha256-7835ece79cca5bcfdeb2e17865f944fd6e8bc05db89c351ae76fae27dd13f4e8",
      "@type": "rkaf:SourceFragment",
      "oa:hasSource": "urn:rulespec:document-understanding:document:df83a189da3bcf757923be2b59f664531586049d05e4de102f73c6e815be2602",
      "rkaf:fragmentIdentityScheme": "rkaf:carrier-local-fragment",
      "rkaf:sourceArtifactDigest": "sha256:df83a189da3bcf757923be2b59f664531586049d05e4de102f73c6e815be2602",
      "rkaf:fragmentContentDigest": "sha256:7835ece79cca5bcfdeb2e17865f944fd6e8bc05db89c351ae76fae27dd13f4e8",
      "rkaf:selectorKind": [
        "oa:TextQuoteSelector",
        "oa:TextPositionSelector"
      ],
      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "(I) is qualified to provide, or supervise the provision of, specially designed instruction to meet the unique needs of children with disabilities;\n\n(II) is knowledgeable about the general education curriculum; and\n\n(III) is knowledgeable about the availability of resources of the local educational agency;\n\n\n(v) an individual who can interpret the instructional implications of evaluation results, who may be a member of the team described in clauses (ii) through (vi);\n\n(vi) at the discretion of the parent or the agency, other individuals who have knowledge or special expertise regarding the child, including related services personnel as appropriate; and\n\n(vii) whenever appropriate, the child with a disability."
        },
        {
          "@type": "oa:TextPositionSelector",
          "oa:start": 4829,
          "oa:end": 5546,
          "rkaf:coordinateSystem": "rkaf:unicode-codepoint"
        }
      ]
    },
    {
      "@id": "urn:rulespec:document-understanding:assertion:2bbdd6382b8293f56c6aa9502484c3d29d9407b43871f364310acdcdfd325799",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:014cdddc42854982574e786f2feba8f3087efe1c6799bb780311a2675fbdd23f",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:8ba03b64d85a2c146028877a83baf9b1d379ef57c127210d4cc231aff24ae630",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:c5507d5135b3889703392adea38bc256c8874555dc6f24cef7d0f80401d8b496",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:states-definition",
      "rkaf:assertsValue": {
        "@value": "In this chapter, the term “individualized education program team” or “IEP Team” means a group of individuals composed of: (i) the parents of a child with a disability; (ii) not less than 1 regular education teacher of such child (if the child is, or may be, participating in the regular education environment); (iii) not less than 1 special education teacher, or where appropriate, not less than 1 special education provider of such child; (iv) a representative of the local educational agency who is qualified to provide, or supervise the provision of, specially designed instruction to meet the unique needs of children with disabilities, is knowledgeable about the general education curriculum, and is knowledgeable about the availability of resources of the local educational agency; (v) an individual who can interpret the instructional implications of evaluation results, who may be a member of the team described in clauses (ii) through (vi); (vi) at the discretion of the parent or the agency, other individuals who have knowledge or special expertise regarding the child, including related services personnel as appropriate; and (vii) whenever appropriate, the child with a disability.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

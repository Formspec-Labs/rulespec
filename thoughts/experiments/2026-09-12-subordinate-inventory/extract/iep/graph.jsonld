    {
      "@id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Adf83a189da3bcf757923be2b59f664531586049d05e4de102f73c6e815be2602:5604:5946:sha256-0dc6c38e9c660bd9444211df221b83a721c85d16c07cbb195caa8b9f68a53378",

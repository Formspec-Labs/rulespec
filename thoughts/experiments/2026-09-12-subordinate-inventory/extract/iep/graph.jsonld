      "rkaf:fragmentIdentityScheme": "rkaf:carrier-local-fragment",
      "rkaf:sourceArtifactDigest": "sha256:df83a189da3bcf757923be2b59f664531586049d05e4de102f73c6e815be2602",
      "rkaf:fragmentContentDigest": "sha256:0dc6c38e9c660bd9444211df221b83a721c85d16c07cbb195caa8b9f68a53378",
      "rkaf:selectorKind": [
        "oa:TextQuoteSelector",
        "oa:TextPositionSelector"
      ],
      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "A member of the IEP Team shall not be required to attend an IEP meeting, in whole or in part, if the parent of a child with a disability and the local educational agency agree that the attendance of such member is not necessary because the member’s area of the curriculum or related services is not being modified or discussed in the meeting."
        },
        {
          "@type": "oa:TextPositionSelector",
          "oa:start": 5604,
          "oa:end": 5946,
          "rkaf:coordinateSystem": "rkaf:unicode-codepoint"
        }

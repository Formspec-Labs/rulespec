      "dcterms:description": "{\"action\":\"\",\"actor\":\"the IEP Team\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:396bc7432f71d4a2036f925f7596a280e210276d8a9111f6f2734137e787ab6d\",\"urn:rulespec:document-understanding:assertion:e2d979a195a337a13144b3a393c68cef9aaa7d9950406fb56e85a97f13e6a9ff\",\"urn:rulespec:document-understanding:assertion:6fdcd140915d86a81d95aa012005763acc6a983ed13b81aa8ee0cc56c7d66775\",\"urn:rulespec:document-understanding:assertion:0626a2ab7fb35b2e40543ef0fc35283230e74d3fec64bf8d115a281dd7d6abd2\",\"urn:rulespec:document-understanding:assertion:50679d8ec0b6721ca43f9c8a03552839fdab5bc571264aac87ce4a00eb4032b2\",\"urn:rulespec:document-understanding:assertion:b3fd3269de38a9fc1403ab76dfe465b8162e2a346c9479d1af9a75d430198c01\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":4296,\"evidence\":[{\"end\":3983,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Adf83a189da3bcf757923be2b59f664531586049d05e4de102f73c6e815be2602:3958:3983:sha256-f495c0b3e3cc9c62d969a02376f2814ffbf0a8e4d9f5c5a7f36aa7557256152a\",\"quote\":\"(ii) Rule of construction\",\"start\":3958},{\"end\":4038,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Adf83a189da3bcf757923be2b59f664531586049d05e4de102f73c6e815be2602:3984:4038:sha256-0dfb33e4e5ce77d0b60e7c2de8c727a9c1379bbe150a97f41e81b686c875f463\",\"quote\":\"Nothing in this section shall be construed to require—\",\"start\":3984},{\"end\":4296,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Adf83a189da3bcf757923be2b59f664531586049d05e4de102f73c6e815be2602:4040:4296:sha256-b84c1ee1eb0d2bb7ac51dafdabe918c4b99c0f419285e6b5fffa3a86ded17b1a\",\"quote\":\"(I) that additional information be included in a child’s IEP beyond what is explicitly required in this section; and\\n\\n(II) the IEP Team to include information under 1 component of a child’s IEP that is already contained under another component of such IEP.\",\"start\":4040},{\"end\":4175,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Adf83a189da3bcf757923be2b59f664531586049d05e4de102f73c6e815be2602:4163:4175:sha256-f1c7862319213d6e2d1682600e85927208b5bcadafce6703f680d16bbf039442\",\"quote\":\"the IEP Team\",\"start\":4163},{\"end\":4037,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Adf83a189da3bcf757923be2b59f664531586049d05e4de102f73c6e815be2602:3984:4037:sha256-102812425beaaca7c37a631ce7c664c137cd15c0aeecfaead7bdfb10af002659\",\"quote\":\"Nothing in this section shall be construed to require\",\"start\":3984}],\"id\":\"urn:rulespec:document-understanding:revision:9bb366f682500165cc713a88f7be894b83e5ea8f968d9025370b45288b08040d\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"exemption\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:0626a2ab7fb35b2e40543ef0fc35283230e74d3fec64bf8d115a281dd7d6abd2\",\"modality\":\"not_required\",\"modality_quote\":\"Nothing in this section shall be construed to require\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:9453772826a67cb8d1c2c811bb186082296502d6a57dafb6183aa7eb6ad4ba71\",\"origin\":\"aiSuggested\",\"quote\":\"(ii) Rule of construction Nothing in this section shall be construed to require—\\n\\n(I) that additional information be included in a child’s IEP beyond what is explicitly required in this section; and\\n\\n(II) the IEP Team to include information under 1 component of a child’s IEP that is already contained under another component of such IEP.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:f998e4f50c734f35e60580e478f11b4afec4de238b809ed069a329b5cc23a5b7\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":3958,\"summary\":\"Nothing in this section shall be construed to require the IEP Team to include information under 1 component of a child’s IEP that is already contained under another component of such IEP.\",\"target_ids\":[],\"term_refs\":[\"urn:rulespec:document-understanding:term:ff87d5b603a406f9d3058b501b37bb1a52c0667c1083431a6e113c977873df99\",\"urn:rulespec:document-understanding:term:f73e079be18b17866a9f1e238515cea80d281ec123b9a876f6fcc6aa8806c2d0\"],\"typed_values\":[]}",

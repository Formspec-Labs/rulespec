    {
      "@id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Adf83a189da3bcf757923be2b59f664531586049d05e4de102f73c6e815be2602:402:912:sha256-b3816d809c99d3b40df4f79337601b0d9bf169386cbf3f80d7b915239ccdacb6",
      "@type": "rkaf:SourceFragment",
      "oa:hasSource": "urn:rulespec:document-understanding:document:df83a189da3bcf757923be2b59f664531586049d05e4de102f73c6e815be2602",
      "rkaf:fragmentIdentityScheme": "rkaf:carrier-local-fragment",
      "rkaf:sourceArtifactDigest": "sha256:df83a189da3bcf757923be2b59f664531586049d05e4de102f73c6e815be2602",
      "rkaf:fragmentContentDigest": "sha256:b3816d809c99d3b40df4f79337601b0d9bf169386cbf3f80d7b915239ccdacb6",
      "rkaf:selectorKind": [
        "oa:TextQuoteSelector",
        "oa:TextPositionSelector"
      ],
      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "(aa) how the child’s disability affects the child’s involvement and progress in the general education curriculum;\n\n(bb) for preschool children, as appropriate, how the disability affects the child’s participation in appropriate activities; and\n\n(cc) for children with disabilities who take alternate assessments aligned to alternate achievement standards, a description of benchmarks or short-term objectives;\n\n\n(II) a statement of measurable annual goals, including academic and functional goals, designed to—"
        },
        {
          "@type": "oa:TextPositionSelector",
          "oa:start": 402,
          "oa:end": 912,
          "rkaf:coordinateSystem": "rkaf:unicode-codepoint"
        }
      ]
    },
    {
      "@id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Adf83a189da3bcf757923be2b59f664531586049d05e4de102f73c6e815be2602:914:1855:sha256-d9af7729cd004e01a8e0c4b0cf0d9ec8b7407534e21b1e43f81246828ca4957c",
      "@type": "rkaf:SourceFragment",
      "oa:hasSource": "urn:rulespec:document-understanding:document:df83a189da3bcf757923be2b59f664531586049d05e4de102f73c6e815be2602",
      "rkaf:fragmentIdentityScheme": "rkaf:carrier-local-fragment",
      "rkaf:sourceArtifactDigest": "sha256:df83a189da3bcf757923be2b59f664531586049d05e4de102f73c6e815be2602",
      "rkaf:fragmentContentDigest": "sha256:d9af7729cd004e01a8e0c4b0cf0d9ec8b7407534e21b1e43f81246828ca4957c",
      "rkaf:selectorKind": [
        "oa:TextQuoteSelector",
        "oa:TextPositionSelector"
      ],
      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "(aa) meet the child’s needs that result from the child’s disability to enable the child to be involved in and make progress in the general education curriculum; and\n\n(bb) meet each of the child’s other educational needs that result from the child’s disability;\n\n\n(III) a description of how the child’s progress toward meeting the annual goals described in subclause (II) will be measured and when periodic reports on the progress the child is making toward meeting the annual goals (such as through the use of quarterly or other periodic reports, concurrent with the issuance of report cards) will be provided;\n\n(IV) a statement of the special education and related services and supplementary aids and services, based on peer-reviewed research to the extent practicable, to be provided to the child, or on behalf of the child, and a statement of the program modifications or supports for school personnel that will be provided for the child—"
        },
        {
          "@type": "oa:TextPositionSelector",
          "oa:start": 914,
          "oa:end": 1855,
          "rkaf:coordinateSystem": "rkaf:unicode-codepoint"
        }
      ]
    },
    {
      "@id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Adf83a189da3bcf757923be2b59f664531586049d05e4de102f73c6e815be2602:1857:2450:sha256-332a21d992b8bc73589950ddcb8db40871c362af41dfe011d2cafcbf87f5efc5",
      "@type": "rkaf:SourceFragment",
      "oa:hasSource": "urn:rulespec:document-understanding:document:df83a189da3bcf757923be2b59f664531586049d05e4de102f73c6e815be2602",
      "rkaf:fragmentIdentityScheme": "rkaf:carrier-local-fragment",
      "rkaf:sourceArtifactDigest": "sha256:df83a189da3bcf757923be2b59f664531586049d05e4de102f73c6e815be2602",
      "rkaf:fragmentContentDigest": "sha256:332a21d992b8bc73589950ddcb8db40871c362af41dfe011d2cafcbf87f5efc5",
      "rkaf:selectorKind": [
        "oa:TextQuoteSelector",
        "oa:TextPositionSelector"
      ],
      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "(aa) to advance appropriately toward attaining the annual goals;\n\n(bb) to be involved in and make progress in the general education curriculum in accordance with subclause (I) and to participate in extracurricular and other nonacademic activities; and\n\n(cc) to be educated and participate with other children with disabilities and nondisabled children in the activities described in this subparagraph;\n\n\n(V) an explanation of the extent, if any, to which the child will not participate with nondisabled children in the regular class and in the activities described in subclause (IV)(cc);\n\n(VI)"
        },
        {
          "@type": "oa:TextPositionSelector",
          "oa:start": 1857,
          "oa:end": 2450,
          "rkaf:coordinateSystem": "rkaf:unicode-codepoint"
        }
      ]
    },
    {
      "@id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Adf83a189da3bcf757923be2b59f664531586049d05e4de102f73c6e815be2602:2452:2880:sha256-8410bd31d33ba2b8988a02a767e38387b97050c20c4edf9a2868949487cd28e0",
      "@type": "rkaf:SourceFragment",
      "oa:hasSource": "urn:rulespec:document-understanding:document:df83a189da3bcf757923be2b59f664531586049d05e4de102f73c6e815be2602",
      "rkaf:fragmentIdentityScheme": "rkaf:carrier-local-fragment",
      "rkaf:sourceArtifactDigest": "sha256:df83a189da3bcf757923be2b59f664531586049d05e4de102f73c6e815be2602",
      "rkaf:fragmentContentDigest": "sha256:8410bd31d33ba2b8988a02a767e38387b97050c20c4edf9a2868949487cd28e0",
      "rkaf:selectorKind": [
        "oa:TextQuoteSelector",
        "oa:TextPositionSelector"
      ],
      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "(aa) a statement of any individual appropriate accommodations that are necessary to measure the academic achievement and functional performance of the child on State and districtwide assessments consistent with section 1412(a)(16)(A) of this title; and\n\n(bb) if the IEP Team determines that the child shall take an alternate assessment on a particular State or districtwide assessment of student achievement, a statement of why—"
        },
        {
          "@type": "oa:TextPositionSelector",
          "oa:start": 2452,
          "oa:end": 2880,
          "rkaf:coordinateSystem": "rkaf:unicode-codepoint"
        }
      ]
    },
    {
      "@id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Adf83a189da3bcf757923be2b59f664531586049d05e4de102f73c6e815be2602:2882:3349:sha256-42daa51946ac531781fc350508e1f255d194b372394a841d50b3dee366daead9",
      "@type": "rkaf:SourceFragment",
      "oa:hasSource": "urn:rulespec:document-understanding:document:df83a189da3bcf757923be2b59f664531586049d05e4de102f73c6e815be2602",
      "rkaf:fragmentIdentityScheme": "rkaf:carrier-local-fragment",
      "rkaf:sourceArtifactDigest": "sha256:df83a189da3bcf757923be2b59f664531586049d05e4de102f73c6e815be2602",
      "rkaf:fragmentContentDigest": "sha256:42daa51946ac531781fc350508e1f255d194b372394a841d50b3dee366daead9",
      "rkaf:selectorKind": [
        "oa:TextQuoteSelector",
        "oa:TextPositionSelector"
      ],
      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "(AA) the child cannot participate in the regular assessment; and\n\n(BB) the particular alternate assessment selected is appropriate for the child;\n\n\n\n(VII) the projected date for the beginning of the services and modifications described in subclause (IV), and the anticipated frequency, location, and duration of those services and modifications; and\n\n(VIII) beginning not later than the first IEP to be in effect when the child is 16, and updated annually thereafter—"
        },
        {
          "@type": "oa:TextPositionSelector",
          "oa:start": 2882,
          "oa:end": 3349,
          "rkaf:coordinateSystem": "rkaf:unicode-codepoint"
        }
      ]
    },
    {
      "@id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Adf83a189da3bcf757923be2b59f664531586049d05e4de102f73c6e815be2602:3351:3954:sha256-dd3769a16f16c6c8aeda8eab0c92cec715ba5872142aabd7ed3dd863a5a0debf",
      "@type": "rkaf:SourceFragment",
      "oa:hasSource": "urn:rulespec:document-understanding:document:df83a189da3bcf757923be2b59f664531586049d05e4de102f73c6e815be2602",
      "rkaf:fragmentIdentityScheme": "rkaf:carrier-local-fragment",
      "rkaf:sourceArtifactDigest": "sha256:df83a189da3bcf757923be2b59f664531586049d05e4de102f73c6e815be2602",
      "rkaf:fragmentContentDigest": "sha256:dd3769a16f16c6c8aeda8eab0c92cec715ba5872142aabd7ed3dd863a5a0debf",
      "rkaf:selectorKind": [
        "oa:TextQuoteSelector",
        "oa:TextPositionSelector"
      ],
      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "(aa) appropriate measurable postsecondary goals based upon age appropriate transition assessments related to training, education, employment, and, where appropriate, independent living skills;\n\n(bb) the transition services (including courses of study) needed to assist the child in reaching those goals; and\n\n(cc) beginning not later than 1 year before the child reaches the age of majority under State law, a statement that the child has been informed of the child’s rights under this chapter, if any, that will transfer to the child on reaching the age of majority under section 1415(m) of this title."
        },
        {
          "@type": "oa:TextPositionSelector",
          "oa:start": 3351,
          "oa:end": 3954,
          "rkaf:coordinateSystem": "rkaf:unicode-codepoint"
        }
      ]
    },
    {
      "@id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Adf83a189da3bcf757923be2b59f664531586049d05e4de102f73c6e815be2602:34:70:sha256-8fa27e38d7640bc53f97cd8add1beb4f9413493de4b9e90723dbf03c717dda83",
      "@type": "rkaf:SourceFragment",
      "oa:hasSource": "urn:rulespec:document-understanding:document:df83a189da3bcf757923be2b59f664531586049d05e4de102f73c6e815be2602",
      "rkaf:fragmentIdentityScheme": "rkaf:carrier-local-fragment",
      "rkaf:sourceArtifactDigest": "sha256:df83a189da3bcf757923be2b59f664531586049d05e4de102f73c6e815be2602",
      "rkaf:fragmentContentDigest": "sha256:8fa27e38d7640bc53f97cd8add1beb4f9413493de4b9e90723dbf03c717dda83",
      "rkaf:selectorKind": [
        "oa:TextQuoteSelector",
        "oa:TextPositionSelector"
      ],
      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "(A) Individualized education program"
        },
        {
          "@type": "oa:TextPositionSelector",
          "oa:start": 34,
          "oa:end": 70,
          "rkaf:coordinateSystem": "rkaf:unicode-codepoint"
        }
      ]
    },
    {
      "@id": "urn:rulespec:document-understanding:assertion:07d4bb21f622c7f5276f9014b02eef5459a5020165cd404c03156a540e8f5ffe",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:014cdddc42854982574e786f2feba8f3087efe1c6799bb780311a2675fbdd23f",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:8ba03b64d85a2c146028877a83baf9b1d379ef57c127210d4cc231aff24ae630",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:e72f11db3362a542e0fa7d4e42dbf9472c1560ea795d233029d84d9daa8fa82e",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:states-definition",
      "rkaf:assertsValue": {
        "@value": "In this chapter, the term “individualized education program” or “IEP” means a written statement for each child with a disability that is developed, reviewed, and revised in accordance with this section and that includes: (I) a statement of the child’s present levels of academic achievement and functional performance, including how the disability affects involvement and progress in the general education curriculum, for preschool children (as appropriate) how it affects participation in appropriate activities, and for children with disabilities taking alternate assessments aligned to alternate achievement standards, benchmarks or short-term objectives; (II) measurable annual goals (including academic and functional goals) designed to meet needs resulting from the disability to enable involvement and progress in the general education curriculum and meet each other educational need resulting from the disability; (III) a description of how progress toward meeting annual goals will be measured and when periodic progress reports (such as quarterly or other periodic reports, concurrent with report cards) will be provided; (IV) a statement of special education, related services, and supplementary aids and services (based on peer-reviewed research to the extent practicable), and program modifications or supports for school personnel, to advance appropriately toward annual goals, be involved and make progress in the general education curriculum, participate in extracurricular and nonacademic activities, and be educated and participate with other children with disabilities and nondisabled children; (V) an explanation of the extent, if any, to which the child will not participate with nondisabled children in regular class and such activities; (VI) a statement of individual appropriate accommodations necessary to measure academic achievement and functional performance on State and districtwide assessments consistent with section 1412(a)(16)(A), and if the IEP Team determines the child shall take an alternate assessment on a particular State or districtwide assessment of student achievement, a statement of why the child cannot participate in the regular assessment and why the alternate assessment selected is appropriate; (VII) the projected start date for services and modifications, and their anticipated frequency, location, and duration; and (VIII) beginning not later than the first IEP in effect when the child is 16 (updated annually), appropriate measurable postsecondary goals based on age-appropriate transition assessments and transition services needed to assist in reaching them, plus (beginning not later than 1 year before reaching the age of majority under State law) a statement that the child has been informed of rights under this chapter, if any, transferring on reaching majority under section 1415(m).",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

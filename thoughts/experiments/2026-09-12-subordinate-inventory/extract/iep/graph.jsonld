        "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Adf83a189da3bcf757923be2b59f664531586049d05e4de102f73c6e815be2602:1857:2450:sha256-332a21d992b8bc73589950ddcb8db40871c362af41dfe011d2cafcbf87f5efc5",
        "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Adf83a189da3bcf757923be2b59f664531586049d05e4de102f73c6e815be2602:2452:2880:sha256-8410bd31d33ba2b8988a02a767e38387b97050c20c4edf9a2868949487cd28e0",
        "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Adf83a189da3bcf757923be2b59f664531586049d05e4de102f73c6e815be2602:2882:3349:sha256-42daa51946ac531781fc350508e1f255d194b372394a841d50b3dee366daead9",
        "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Adf83a189da3bcf757923be2b59f664531586049d05e4de102f73c6e815be2602:3351:3954:sha256-dd3769a16f16c6c8aeda8eab0c92cec715ba5872142aabd7ed3dd863a5a0debf"

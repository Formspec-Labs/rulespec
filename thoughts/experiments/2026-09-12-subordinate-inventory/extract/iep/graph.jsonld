      ],
      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "(I) a statement of the child’s present levels of academic achievement and functional performance, including—"
        },
        {
          "@type": "oa:TextPositionSelector",
          "oa:start": 292,
          "oa:end": 400,
          "rkaf:coordinateSystem": "rkaf:unicode-codepoint"

      "dcterms:description": "{\"action\":\"\",\"actor\":\"each local educational agency\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:0ff1b3f92c201318e1895c695057a5a992d0beadaa5a577c6ccb8f524c8d59c0\",\"urn:rulespec:document-understanding:assertion:c8ea1fe154bf8e2dd0687f094bd6b636681ad748f58d48c1426a367a3a9fbcf6\",\"urn:rulespec:document-understanding:assertion:ac5f54c0a3aa2e150af62358c629d069c7cc3f65e1cdeecb0534e2246ccb7f12\",\"urn:rulespec:document-understanding:assertion:735b593dba543d21a0fe90bac09b8ef98c89b3ea6ae64fbb6f09047641ff4c2c\",\"urn:rulespec:document-understanding:assertion:eb5d21a3515385fa5f9fd0fdb4550a55d2a0e2836d7cb5c4f59741afc312513a\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":4466,\"evidence\":[{\"end\":4057,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A74edfab4787d01c91a7e68f8c21dec680718e02a075cc4b70c618b24684f5cc2:3925:4057:sha256-bb9db6297fe9a3d72a8ea65aad3710f24f4f0788abcbf7c3aae08ec88a7dfdea\",\"quote\":\"(12) if determined appropriate by the local educational agency, how such agency will support programs that coordinate and integrate—\",\"start\":3925},{\"end\":4466,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A74edfab4787d01c91a7e68f8c21dec680718e02a075cc4b70c618b24684f5cc2:4059:4466:sha256-aedda6b306e063c97d3627213275b7115b822f95c7d358883c4a8bb79e7fef25\",\"quote\":\"(A) academic and career and technical education content through coordinated instructional strategies, that may incorporate experiential learning opportunities and promote skills attainment important to in-demand occupations or industries in the State; and\\n\\n(B) work-based learning opportunities that provide students in-depth interaction with industry professionals and, if appropriate, academic credit; and\",\"start\":4059},{\"end\":265,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A74edfab4787d01c91a7e68f8c21dec680718e02a075cc4b70c618b24684f5cc2:236:265:sha256-586121ec74d8b7905a8ac661f5e66fa77c2c4fdf4dfab15d8b1625eb7f33b95b\",\"quote\":\"each local educational agency\",\"start\":236},{\"end\":276,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A74edfab4787d01c91a7e68f8c21dec680718e02a075cc4b70c618b24684f5cc2:271:276:sha256-56ee5b508706bf2de91712d85d6d1e11ddbff01949142ed6e8c22e3b1bed1c71\",\"quote\":\"shall\",\"start\":271},{\"end\":19,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A74edfab4787d01c91a7e68f8c21dec680718e02a075cc4b70c618b24684f5cc2:0:19:sha256-db5e7b375c78edee6b27af25a6e676f0fa44147dc731f0e504191990c7945a0a\",\"quote\":\"(b) Plan provisions\",\"start\":0},{\"end\":286,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A74edfab4787d01c91a7e68f8c21dec680718e02a075cc4b70c618b24684f5cc2:20:286:sha256-b874c9a0ee7a720ddf238afa6647d12a5bfe7b3048652271e6adee490088ee19\",\"quote\":\"To ensure that all children receive a high-quality education, and to close the achievement gap between children meeting the challenging State academic standards and those children who are not meeting such standards, each local educational agency plan shall describe—\",\"start\":20},{\"end\":4057,\"field\":\"scope_text:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A74edfab4787d01c91a7e68f8c21dec680718e02a075cc4b70c618b24684f5cc2:3925:4057:sha256-bb9db6297fe9a3d72a8ea65aad3710f24f4f0788abcbf7c3aae08ec88a7dfdea\",\"quote\":\"(12) if determined appropriate by the local educational agency, how such agency will support programs that coordinate and integrate—\",\"start\":3925}],\"id\":\"urn:rulespec:document-understanding:revision:6cb37989c59fda810e38b3e701d650bb7652a7cc4e1dd70f23dabc104cac2bd4\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:eb5d21a3515385fa5f9fd0fdb4550a55d2a0e2836d7cb5c4f59741afc312513a\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:f79d422eed29afe3a3b1587da3c73e5e9963d18db95316572bef59cdd0cb9c71\",\"origin\":\"aiSuggested\",\"quote\":\"(12) if determined appropriate by the local educational agency, how such agency will support programs that coordinate and integrate—\\n\\n(A) academic and career and technical education content through coordinated instructional strategies, that may incorporate experiential learning opportunities and promote skills attainment important to in-demand occupations or industries in the State; and\\n\\n(B) work-based learning opportunities that provide students in-depth interaction with industry professionals and, if appropriate, academic credit; and\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:cfa08aec1c706b70f25ae5be918b3693bc909a7281cb9881cbc0aa1f8e983f90\",\"scope_quotes\":[\"(b) Plan provisions To ensure that all children receive a high-quality education, and to close the achievement gap between children meeting the challenging State academic standards and those children who are not meeting such standards, each local educational agency plan shall describe—\",\"(12) if determined appropriate by the local educational agency, how such agency will support programs that coordinate and integrate—\"],\"scope_text\":\"To ensure that all children receive a high-quality education, and to close the achievement gap between children meeting the challenging State academic standards and those children who are not meeting such standards, if determined appropriate by the local educational agency\",\"section_id\":\"section-1\",\"start\":3925,\"summary\":\"To ensure that all children receive a high-quality education, and to close the achievement gap between children meeting the challenging State academic standards and those children who are not meeting such standards, if determined appropriate by the local educational agency, each local educational agency plan shall describe how such agency will support programs that coordinate and integrate: (A) academic and career and technical education content through coordinated instructional strategies, that may incorporate experiential learning opportunities and promote skills attainment important to in-demand occupations or industries in the State; and (B) work-based learning opportunities that provide students in-depth interaction with industry professionals and, if appropriate, academic credit.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:d22642514692d2ad6d7c7893f3844371e7733a81723c41b238b906b4c1010bf6",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:5c4bb53c7e249454e6343d6b3abf799da957f6e1752e690d99ca4906109e740f",

      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"each local educational agency\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:19626d5eaa93ff85e6227844003401b20d0df5445c8a0ade791dea01eb80da15\",\"urn:rulespec:document-understanding:assertion:851b9a7163b2ae598fdc652c7f8499cbb51170baaf45a304efd5159b48554bed\",\"urn:rulespec:document-understanding:assertion:3efd1ea421b6403f1186be4bb706e1586ee8598d645e0e04f5c21d5b39f851dc\",\"urn:rulespec:document-understanding:assertion:e713cb319fe6252e5bf788dd9765c02633a903904a0a670df1f4f5f8afe93019\",\"urn:rulespec:document-understanding:assertion:1404f548710bfa15f34970b3d2c0ddf814aa0f5847f888731aa892cc8f947027\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":945,\"evidence\":[{\"end\":19,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A74edfab4787d01c91a7e68f8c21dec680718e02a075cc4b70c618b24684f5cc2:0:19:sha256-db5e7b375c78edee6b27af25a6e676f0fa44147dc731f0e504191990c7945a0a\",\"quote\":\"(b) Plan provisions\",\"start\":0},{\"end\":286,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A74edfab4787d01c91a7e68f8c21dec680718e02a075cc4b70c618b24684f5cc2:20:286:sha256-b874c9a0ee7a720ddf238afa6647d12a5bfe7b3048652271e6adee490088ee19\",\"quote\":\"To ensure that all children receive a high-quality education, and to close the achievement gap between children meeting the challenging State academic standards and those children who are not meeting such standards, each local educational agency plan shall describe—\",\"start\":20},{\"end\":412,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A74edfab4787d01c91a7e68f8c21dec680718e02a075cc4b70c618b24684f5cc2:288:412:sha256-1d1c3a1fbba24cf5a9e6a630720197e2a39dacf06a0ad687adb752c2ef732602\",\"quote\":\"(1) how the local educational agency will monitor students’ progress in meeting the challenging State academic standards by—\",\"start\":288},{\"end\":945,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A74edfab4787d01c91a7e68f8c21dec680718e02a075cc4b70c618b24684f5cc2:414:945:sha256-15df885433b31d1bcac8c0ba748dfa08261068e175406d4937cf17241bc75e8e\",\"quote\":\"(A) developing and implementing a well-rounded program of instruction to meet the academic needs of all students;\\n\\n(B) identifying students who may be at risk for academic failure;\\n\\n(C) providing additional educational assistance to individual students the local educational agency or school determines need help in meeting the challenging State academic standards; and\\n\\n(D) identifying and implementing instructional and other strategies intended to strengthen academic programs and improve school conditions for student learning;\",\"start\":414},{\"end\":265,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A74edfab4787d01c91a7e68f8c21dec680718e02a075cc4b70c618b24684f5cc2:236:265:sha256-586121ec74d8b7905a8ac661f5e66fa77c2c4fdf4dfab15d8b1625eb7f33b95b\",\"quote\":\"each local educational agency\",\"start\":236},{\"end\":276,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A74edfab4787d01c91a7e68f8c21dec680718e02a075cc4b70c618b24684f5cc2:271:276:sha256-56ee5b508706bf2de91712d85d6d1e11ddbff01949142ed6e8c22e3b1bed1c71\",\"quote\":\"shall\",\"start\":271},{\"end\":19,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A74edfab4787d01c91a7e68f8c21dec680718e02a075cc4b70c618b24684f5cc2:0:19:sha256-db5e7b375c78edee6b27af25a6e676f0fa44147dc731f0e504191990c7945a0a\",\"quote\":\"(b) Plan provisions\",\"start\":0},{\"end\":286,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A74edfab4787d01c91a7e68f8c21dec680718e02a075cc4b70c618b24684f5cc2:20:286:sha256-b874c9a0ee7a720ddf238afa6647d12a5bfe7b3048652271e6adee490088ee19\",\"quote\":\"To ensure that all children receive a high-quality education, and to close the achievement gap between children meeting the challenging State academic standards and those children who are not meeting such standards, each local educational agency plan shall describe—\",\"start\":20}],\"id\":\"urn:rulespec:document-understanding:revision:0ebdaae7d06263969731f5cf9a9ecbdf1cbc0ed715728a36e696ffa35bdc28a9\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:1404f548710bfa15f34970b3d2c0ddf814aa0f5847f888731aa892cc8f947027\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:5df987790ad046b73e5081304b93baed5242048ce4c2571d001ce4c1515989c1\",\"origin\":\"aiSuggested\",\"quote\":\"(b) Plan provisions To ensure that all children receive a high-quality education, and to close the achievement gap between children meeting the challenging State academic standards and those children who are not meeting such standards, each local educational agency plan shall describe—\\n\\n(1) how the local educational agency will monitor students’ progress in meeting the challenging State academic standards by—\\n\\n(A) developing and implementing a well-rounded program of instruction to meet the academic needs of all students;\\n\\n(B) identifying students who may be at risk for academic failure;\\n\\n(C) providing additional educational assistance to individual students the local educational agency or school determines need help in meeting the challenging State academic standards; and\\n\\n(D) identifying and implementing instructional and other strategies intended to strengthen academic programs and improve school conditions for student learning;\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:454517a7454f13271beb9e951802ccd896e94d206b2988a7d9c851f2dd3b38d5\",\"scope_quotes\":[\"(b) Plan provisions To ensure that all children receive a high-quality education, and to close the achievement gap between children meeting the challenging State academic standards and those children who are not meeting such standards, each local educational agency plan shall describe—\"],\"scope_text\":\"To ensure that all children receive a high-quality education, and to close the achievement gap between children meeting the challenging State academic standards and those children who are not meeting such standards\",\"section_id\":\"section-1\",\"start\":0,\"summary\":\"To ensure that all children receive a high-quality education, and to close the achievement gap between children meeting the challenging State academic standards and those children who are not meeting such standards, each local educational agency plan shall describe how the local educational agency will monitor students' progress in meeting the challenging State academic standards by: (A) developing and implementing a well-rounded program of instruction to meet the academic needs of all students; (B) identifying students who may be at risk for academic failure; (C) providing additional educational assistance to individual students the local educational agency or school determines need help in meeting the challenging State academic standards; and (D) identifying and implementing instructional and other strategies intended to strengthen academic programs and improve school conditions for student learning.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

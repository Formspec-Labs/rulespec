      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"each local educational agency\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:32f3cea374710cac31985b2a196d2140cd77ace91b6ad714793f124d6be5587e\",\"urn:rulespec:document-understanding:assertion:c6da2b8cc68e67b3a6937769841f68cf1116f9f6697aa2fe0c6bde959e69c474\",\"urn:rulespec:document-understanding:assertion:03d34d119b50d88fcbfe24bc6ef626a3698989e4c91de2098638021fc81a25cf\",\"urn:rulespec:document-understanding:assertion:d638034957237601226f76d3c776d446c064e60a8148a3853cf615263f1e6dc1\",\"urn:rulespec:document-understanding:assertion:0bd44f7a3d6e9be0be73a9871019fc60c31d3779589ed959376ccd0666fed6ce\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":4971,\"evidence\":[{\"end\":4718,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A74edfab4787d01c91a7e68f8c21dec680718e02a075cc4b70c618b24684f5cc2:4469:4718:sha256-08162597d6b793ac92b46504e9d52ebddc29a6e13d84676c3ffaa75a960ad40b\",\"quote\":\"(13) any other information on how the local educational agency proposes to use funds to meet the purposes of this part, and that the local educational agency determines appropriate to provide, which may include how the local educational agency will—\",\"start\":4469},{\"end\":4971,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A74edfab4787d01c91a7e68f8c21dec680718e02a075cc4b70c618b24684f5cc2:4720:4971:sha256-2538a101710c3101eb2269d4bb028ac18b41fc4217fba560dea9098424298176\",\"quote\":\"(A) assist schools in identifying and serving gifted and talented students; and\\n\\n(B) assist schools in developing effective school library programs to provide students an opportunity to develop digital literacy skills and improve academic achievement.\",\"start\":4720},{\"end\":265,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A74edfab4787d01c91a7e68f8c21dec680718e02a075cc4b70c618b24684f5cc2:236:265:sha256-586121ec74d8b7905a8ac661f5e66fa77c2c4fdf4dfab15d8b1625eb7f33b95b\",\"quote\":\"each local educational agency\",\"start\":236},{\"end\":276,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A74edfab4787d01c91a7e68f8c21dec680718e02a075cc4b70c618b24684f5cc2:271:276:sha256-56ee5b508706bf2de91712d85d6d1e11ddbff01949142ed6e8c22e3b1bed1c71\",\"quote\":\"shall\",\"start\":271},{\"end\":19,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A74edfab4787d01c91a7e68f8c21dec680718e02a075cc4b70c618b24684f5cc2:0:19:sha256-db5e7b375c78edee6b27af25a6e676f0fa44147dc731f0e504191990c7945a0a\",\"quote\":\"(b) Plan provisions\",\"start\":0},{\"end\":286,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A74edfab4787d01c91a7e68f8c21dec680718e02a075cc4b70c618b24684f5cc2:20:286:sha256-b874c9a0ee7a720ddf238afa6647d12a5bfe7b3048652271e6adee490088ee19\",\"quote\":\"To ensure that all children receive a high-quality education, and to close the achievement gap between children meeting the challenging State academic standards and those children who are not meeting such standards, each local educational agency plan shall describe—\",\"start\":20}],\"id\":\"urn:rulespec:document-understanding:revision:9699335291cd147e7f85f21c66d3d83b3dc2322abfe2450695b286e99fee2c8e\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:0bd44f7a3d6e9be0be73a9871019fc60c31d3779589ed959376ccd0666fed6ce\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:4136cab20a9879456952d87ab1583bdd628a0de171be061ce704fed12914f63d\",\"origin\":\"aiSuggested\",\"quote\":\"(13) any other information on how the local educational agency proposes to use funds to meet the purposes of this part, and that the local educational agency determines appropriate to provide, which may include how the local educational agency will—\\n\\n(A) assist schools in identifying and serving gifted and talented students; and\\n\\n(B) assist schools in developing effective school library programs to provide students an opportunity to develop digital literacy skills and improve academic achievement.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:d784061d21b2df775ec34d0380d6b58b508ffbc92529f88446c1e707fff73065\",\"scope_quotes\":[\"(b) Plan provisions To ensure that all children receive a high-quality education, and to close the achievement gap between children meeting the challenging State academic standards and those children who are not meeting such standards, each local educational agency plan shall describe—\"],\"scope_text\":\"To ensure that all children receive a high-quality education, and to close the achievement gap between children meeting the challenging State academic standards and those children who are not meeting such standards\",\"section_id\":\"section-1\",\"start\":4469,\"summary\":\"To ensure that all children receive a high-quality education, and to close the achievement gap between children meeting the challenging State academic standards and those children who are not meeting such standards, each local educational agency plan shall describe any other information on how the local educational agency proposes to use funds to meet the purposes of this part, and that the local educational agency determines appropriate to provide, which may include how the local educational agency will: (A) assist schools in identifying and serving gifted and talented students; and (B) assist schools in developing effective school library programs to provide students an opportunity to develop digital literacy skills and improve academic achievement.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

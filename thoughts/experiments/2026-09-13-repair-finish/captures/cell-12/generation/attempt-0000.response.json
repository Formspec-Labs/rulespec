            "text": "{\n  \"proposals\": [\n    {\n      \"rationale\": \"Incorporate the governing conditions from available referenced clause (ii) into C0001's summary and scope so the reading is independently usable, and populate the action and object components supported by the source quote.\",\n      \"operation\": \"edit\",\n      \"target\": \"C0001\",\n      \"qualifies\": [],\n      \"quote\": \"In the case of a single-employer plan described in clause (ii), the plan sponsor may elect to maintain a funding standard carryover balance, until such balance is reduced to zero.\",\n      \"fields\": {\n        \"concepts\": [],\n        \"claimants\": [],\n        \"typed_values\": [],\n        \"effective_periods\": [],\n        \"defined_terms\": [],\n        \"term_refs\": [],\n        \"kind\": \"permission\",\n        \"scope_quotes\": [\n          \"In the case of a single-employer plan described in clause (ii)\",\n          \"until such balance is reduced to zero.\",\n          \"was in effect for a plan year beginning in 2007, and\",\n          \"had a positive balance in the funding standard account under section 1082(b) of this title as in effect for such plan year and determined as of the end of such plan year.\"\n        ],\n        \"scope_text\": \"In the case of a single-employer plan described in clause (ii) (a plan that was in effect for a plan year beginning in 2007, and had a positive balance in the funding standard account under section 1082(b) of this title as in effect for such plan year and determined as of the end of such plan year), until such balance is reduced to zero\",\n        \"context_quotes\": [],\n        \"modality_quote\": \"may\",\n        \"modality\": \"may\",\n        \"alternative_quotes\": [],\n        \"choice_quote\": \"\",\n        \"choice_text\": \"\",\n        \"logic_text\": \"\",\n        \"actor_quote\": \"the plan sponsor\",\n        \"actor\": \"the plan sponsor\",\n        \"action_quote\": \"elect to maintain\",\n        \"action\": \"elect to maintain\",\n        \"object_quote\": \"a funding standard carryover balance\",\n        \"object\": \"a funding standard carryover balance\",\n        \"jurisdiction_quote\": \"\",\n        \"jurisdiction\": \"\",\n        \"relation\": \"none\",\n        \"references\": [\n          \"clause (ii)\",\n          \"section 1082(b)\"\n        ],\n        \"summary\": \"In the case of a single-employer plan described in clause (ii) (a plan that was in effect for a plan year beginning in 2007 and had a positive balance in the funding standard account under section 1082(b) of this title as in effect for such plan year and determined as of the end of such plan year), the plan sponsor may elect to maintain a funding standard carryover balance, until such balance is reduced to zero.\"\n      }\n    }\n  ],\n  \"observations\": [\n    {\n      \"quote\": \"section 1082(b) of this title as in effect for such plan year and determined as of the end of such plan year.\",\n      \"rationale\": \"Section 1082(b) is an external statutory reference whose operative text and balance determination rules are not provided within the supplied source.\",\n      \"disposition\": \"unresolved\"\n    }\n  ]\n}",

            "text": "{\n  \"proposals\": [\n    {\n      \"rationale\": \"Make C0001 an independently usable reading by incorporating the governing definition of a plan described in clause (ii) from the supplied source, populating the action and object components, and noting the cross-reference to section 1082(b).\",\n      \"operation\": \"edit\",\n      \"target\": \"C0001\",\n      \"qualifies\": [],\n      \"quote\": \"In the case of a single-employer plan described in clause (ii), the plan sponsor may elect to maintain a funding standard carryover balance, until such balance is reduced to zero.\",\n      \"fields\": {\n        \"concepts\": [],\n        \"claimants\": [],\n        \"typed_values\": [],\n        \"effective_periods\": [],\n        \"defined_terms\": [],\n        \"term_refs\": [],\n        \"kind\": \"permission\",\n        \"scope_quotes\": [\n          \"In the case of a single-employer plan described in clause (ii),\",\n          \"A plan is described in this clause if the plan—\\n\\n(I) was in effect for a plan year beginning in 2007, and\\n\\n(II) had a positive balance in the funding standard account under section 1082(b) of this title as in effect for such plan year and determined as of the end of such plan year.\"\n        ],\n        \"scope_text\": \"In the case of a single-employer plan described in clause (ii) (a plan that was in effect for a plan year beginning in 2007 and had a positive balance in the funding standard account under section 1082(b) of this title as in effect for such plan year and determined as of the end of such plan year)\",\n        \"context_quotes\": [],\n        \"modality_quote\": \"may\",\n        \"modality\": \"may\",\n        \"alternative_quotes\": [],\n        \"choice_quote\": \"\",\n        \"choice_text\": \"\",\n        \"logic_text\": \"\",\n        \"actor_quote\": \"the plan sponsor\",\n        \"actor\": \"the plan sponsor\",\n        \"action_quote\": \"elect to maintain\",\n        \"action\": \"elect to maintain\",\n        \"object_quote\": \"a funding standard carryover balance, until such balance is reduced to zero\",\n        \"object\": \"a funding standard carryover balance, until such balance is reduced to zero\",\n        \"jurisdiction_quote\": \"\",\n        \"jurisdiction\": \"\",\n        \"relation\": \"none\",\n        \"references\": [\n          \"clause (ii)\",\n          \"section 1082(b)\"\n        ],\n        \"summary\": \"In the case of a single-employer plan described in clause (ii)—meaning a plan that was in effect for a plan year beginning in 2007 and had a positive balance in the funding standard account under section 1082(b) of this title (the content of which is unsupplied) as in effect for such plan year and determined as of the end of such plan year—the plan sponsor may elect to maintain a funding standard carryover balance, until such balance is reduced to zero.\"\n      }\n    }\n  ],\n  \"observations\": [\n    {\n      \"quote\": \"section 1082(b) of this title as in effect for such plan year\",\n      \"rationale\": \"Section 1082(b) is referenced to define the positive balance requirement for the funding standard account, but its content is not supplied in the source.\",\n      \"disposition\": \"unresolved\"\n    }\n  ]\n}",

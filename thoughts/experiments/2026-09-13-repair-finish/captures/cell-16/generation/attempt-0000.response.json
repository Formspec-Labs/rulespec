            "text": "{\n  \"proposals\": [\n    {\n      \"rationale\": \"Incorporate the governing conditions from referenced clause (ii), which are supplied in the text, into the scope and summary of C0001 so that the permission is independently understandable, and populate the action, object, and scope quotes accurately.\",\n      \"operation\": \"edit\",\n      \"target\": \"C0001\",\n      \"qualifies\": [],\n      \"quote\": \"In the case of a single-employer plan described in clause (ii), the plan sponsor may elect to maintain a funding standard carryover balance, until such balance is reduced to zero.\",\n      \"fields\": {\n        \"concepts\": [\n          {\n            \"label\": \"Funding standard carryover balance\",\n            \"definition\": \"A balance that the plan sponsor of an eligible single-employer plan maintaining a funding standard account in 2007 may elect to maintain until it is reduced to zero.\",\n            \"quote\": \"the plan sponsor may elect to maintain a funding standard carryover balance, until such balance is reduced to zero.\",\n            \"role\": \"rkaf:assignmentPrimary\"\n          }\n        ],\n        \"claimants\": [],\n        \"typed_values\": [],\n        \"effective_periods\": [],\n        \"defined_terms\": [],\n        \"term_refs\": [],\n        \"kind\": \"permission\",\n        \"scope_quotes\": [\n          \"In the case of a single-employer plan described in clause (ii)\",\n          \"A plan is described in this clause if the plan—\\n\\n(I) was in effect for a plan year beginning in 2007, and\\n\\n(II) had a positive balance in the funding standard account under section 1082(b) of this title as in effect for such plan year and determined as of the end of such plan year.\"\n        ],\n        \"scope_text\": \"In the case of a single-employer plan described in clause (ii) (a plan that was in effect for a plan year beginning in 2007, and had a positive balance in the funding standard account under section 1082(b) of this title as in effect for such plan year and determined as of the end of such plan year).\",\n        \"context_quotes\": [],\n        \"modality_quote\": \"may\",\n        \"modality\": \"may\",\n        \"alternative_quotes\": [],\n        \"choice_quote\": \"\",\n        \"choice_text\": \"\",\n        \"logic_text\": \"until such balance is reduced to zero\",\n        \"actor_quote\": \"the plan sponsor\",\n        \"actor\": \"the plan sponsor\",\n        \"action_quote\": \"elect to maintain\",\n        \"action\": \"elect to maintain\",\n        \"object_quote\": \"a funding standard carryover balance, until such balance is reduced to zero\",\n        \"object\": \"a funding standard carryover balance, until such balance is reduced to zero\",\n        \"jurisdiction_quote\": \"\",\n        \"jurisdiction\": \"\",\n        \"relation\": \"none\",\n        \"references\": [\n          \"clause (ii)\",\n          \"section 1082(b)\"\n        ],\n        \"summary\": \"In the case of a single-employer plan described in clause (ii) (that is, a plan that was in effect for a plan year beginning in 2007 and had a positive balance in the funding standard account under section 1082(b) of this title as in effect for such plan year and determined as of the end of such plan year), the plan sponsor may elect to maintain a funding standard carryover balance, until such balance is reduced to zero.\"\n      }\n    }\n  ],\n  \"observations\": [\n    {\n      \"quote\": \"section 1082(b) of this title as in effect for such plan year and determined as of the end of such plan year\",\n      \"rationale\": \"Section 1082(b) is an external statutory reference whose text and substantive requirements are not provided in the supplied source.\",\n      \"disposition\": \"unresolved\"\n    }\n  ]\n}",

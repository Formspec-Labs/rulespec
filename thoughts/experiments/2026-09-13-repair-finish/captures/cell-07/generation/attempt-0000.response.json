            "text": "{\n  \"proposals\": [\n    {\n      \"rationale\": \"Correct the actor to the Secretary, resolving the issue where the actor was incorrectly listed as the plan participant despite being quoted as the Secretary, and supply exact supporting quotes for action and object.\",\n      \"operation\": \"edit\",\n      \"target\": \"C0021\",\n      \"fields\": {\n        \"concepts\": [],\n        \"claimants\": [],\n        \"typed_values\": [\n          {\n            \"name\": \"issuance deadline\",\n            \"quote\": \"Not later than 1 year after December 20, 2019\",\n            \"value\": \"P1Y\",\n            \"datatype\": \"xsd:duration\",\n            \"comparator\": \"Not later than\",\n            \"unit\": \"year\",\n            \"anchor\": \"December 20, 2019\"\n          }\n        ],\n        \"effective_periods\": [],\n        \"defined_terms\": [],\n        \"term_refs\": [\n          \"urn:rulespec:document-understanding:term:e4efe53072124c231a7b7ca464c2dbb958115cf98cff1cb5e7f4aab70b5a81b1\"\n        ],\n        \"kind\": \"requirement\",\n        \"scope_quotes\": [],\n        \"scope_text\": \"\",\n        \"context_quotes\": [],\n        \"modality_quote\": \"shall\",\n        \"modality\": \"must\",\n        \"alternative_quotes\": [],\n        \"choice_quote\": \"\",\n        \"choice_text\": \"\",\n        \"logic_text\": \"\",\n        \"actor_quote\": \"the Secretary\",\n        \"actor\": \"the Secretary\",\n        \"action_quote\": \"issue\",\n        \"action\": \"issue\",\n        \"object_quote\": \"a model lifetime income disclosure\",\n        \"object\": \"a model lifetime income disclosure\",\n        \"jurisdiction_quote\": \"\",\n        \"jurisdiction\": \"\",\n        \"relation\": \"none\",\n        \"references\": [\n          \"clause (i)(III)\"\n        ],\n        \"summary\": \"Not later than 1 year after December 20, 2019, the Secretary shall issue a model lifetime income disclosure, written in a manner so as to be understood by the average plan participant, which explains that the lifetime income stream equivalent is only provided as an illustration; explains that the actual payments under the lifetime income stream described in clause (i)(III) which may be purchased with the total benefits accrued will depend on numerous factors and may vary substantially from the lifetime income stream equivalent in the disclosures; explains the assumptions upon which the lifetime income stream equivalent was determined; and provides such other similar explanations as the Secretary considers appropriate.\"\n      }\n    }\n  ],\n  \"observations\": []\n}",

      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "(ii) make a determination with respect to any appeal within twenty days (excepting Saturdays, Sundays, and legal public holidays) after the receipt of such appeal. If on appeal the denial of the request for records is in whole or in part upheld, the agency shall notify the person making such request of the provisions for judicial review of that determination under paragraph (4) of this subsection."
        },
        {
          "@type": "oa:TextPositionSelector",
          "oa:start": 901,
          "oa:end": 1301,
          "rkaf:coordinateSystem": "rkaf:unicode-codepoint"
        }

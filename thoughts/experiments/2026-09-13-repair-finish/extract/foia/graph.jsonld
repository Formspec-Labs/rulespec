      "dcterms:description": "{\"action\":\"\",\"actor\":\"the agency\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:edd39ea2537ec695d66a680965d5a2e265f2bcab7bf726c2e46282017163e56c\",\"urn:rulespec:document-understanding:assertion:fe0f008b01b6ed295cc9b330753f93a4b53f276ff8fe830cc8a768e7eafb9c8a\",\"urn:rulespec:document-understanding:assertion:a6c63c0510c99ec0316972ffb79b54a059a1fad8f27a31ee1e747a7e46a8f3c8\",\"urn:rulespec:document-understanding:assertion:74359b8892dac76c93e5bcce168d19cebe7fbfef43f9e7509c9a072fe5745c07\",\"urn:rulespec:document-understanding:assertion:7bdec095d9d2b31378a8ea38020371bb7b7665f157c82de9487dffafa1455afe\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":1301,\"evidence\":[{\"end\":1301,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aad122195ebf9a14b38cd813fe18c3567eacf8a86a3073ba83b70b4c9078938bb:901:1301:sha256-f10492a3c89755c23183e0f654e062e66467278b5afc5ad4c47f5cee8fdf33bb\",\"quote\":\"(ii) make a determination with respect to any appeal within twenty days (excepting Saturdays, Sundays, and legal public holidays) after the receipt of such appeal. If on appeal the denial of the request for records is in whole or in part upheld, the agency shall notify the person making such request of the provisions for judicial review of that determination under paragraph (4) of this subsection.\",\"start\":901},{\"end\":1157,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aad122195ebf9a14b38cd813fe18c3567eacf8a86a3073ba83b70b4c9078938bb:1147:1157:sha256-307a752d92c11cbf54d16dc296a543e18512a196c2b1e8b2c4ff0a468a7e8e20\",\"quote\":\"the agency\",\"start\":1147},{\"end\":1163,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aad122195ebf9a14b38cd813fe18c3567eacf8a86a3073ba83b70b4c9078938bb:1158:1163:sha256-56ee5b508706bf2de91712d85d6d1e11ddbff01949142ed6e8c22e3b1bed1c71\",\"quote\":\"shall\",\"start\":1158},{\"end\":1301,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aad122195ebf9a14b38cd813fe18c3567eacf8a86a3073ba83b70b4c9078938bb:901:1301:sha256-f10492a3c89755c23183e0f654e062e66467278b5afc5ad4c47f5cee8fdf33bb\",\"quote\":\"(ii) make a determination with respect to any appeal within twenty days (excepting Saturdays, Sundays, and legal public holidays) after the receipt of such appeal. If on appeal the denial of the request for records is in whole or in part upheld, the agency shall notify the person making such request of the provisions for judicial review of that determination under paragraph (4) of this subsection.\",\"start\":901}],\"id\":\"urn:rulespec:document-understanding:revision:d73cdcd5204e4af14443c9da797c9ca5cceb5bb3f3b809af40f762195b462cad\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:7bdec095d9d2b31378a8ea38020371bb7b7665f157c82de9487dffafa1455afe\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:69f72ad3d0a6fa8c5161f9736d8aa2f7147d2f238b879ac25b902840c84cfa46\",\"origin\":\"aiSuggested\",\"quote\":\"(ii) make a determination with respect to any appeal within twenty days (excepting Saturdays, Sundays, and legal public holidays) after the receipt of such appeal. If on appeal the denial of the request for records is in whole or in part upheld, the agency shall notify the person making such request of the provisions for judicial review of that determination under paragraph (4) of this subsection.\",\"references\":[\"paragraph (4) of this subsection\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:448da9352a4553da063b6838ea60dca432dac2a7805d2380a72deef45db9a1b4\",\"scope_quotes\":[\"(ii) make a determination with respect to any appeal within twenty days (excepting Saturdays, Sundays, and legal public holidays) after the receipt of such appeal. If on appeal the denial of the request for records is in whole or in part upheld, the agency shall notify the person making such request of the provisions for judicial review of that determination under paragraph (4) of this subsection.\"],\"scope_text\":\"If on appeal the denial of the request for records is in whole or in part upheld\",\"section_id\":\"section-1\",\"start\":901,\"summary\":\"If on appeal the denial of the request for records is in whole or in part upheld, the agency shall notify the person making such request of the provisions for judicial review of that determination under paragraph (4) of subsection 552(a).\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

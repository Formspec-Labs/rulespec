      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:states-prohibition",
      "rkaf:assertsValue": {
        "@value": "The 20-day period shall not be tolled by the agency except: (I) the agency may make one request to the requester for information and toll the 20-day period while it is awaiting such information that it has reasonably requested from the requester under section 552; or (II) if necessary to clarify with the requester issues regarding fee assessment.",

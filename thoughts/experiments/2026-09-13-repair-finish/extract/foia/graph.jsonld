      "dcterms:description": "{\"action\":\"\",\"actor\":\"Each agency\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:23281097456b83081df1839f579a268d9b17b6dc194e4e9dbd497921c6bedb82\",\"urn:rulespec:document-understanding:assertion:ffff4019a27c36e60d32a356e8b924c7e0778a9137cbe6be9f2434a4fd2d5524\",\"urn:rulespec:document-understanding:assertion:23f248ba77ca18481090c37128df6339a6db676c357e88408653f56a7d8b82e9\",\"urn:rulespec:document-understanding:assertion:90258c71a93bdc28ac21dbc91de799e37063cc8692a777a8a8ddf49d843d3ecc\",\"urn:rulespec:document-understanding:assertion:ca70f559939f645d569845dc63f3da578d866e8ec32892252908277104df13da\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":897,\"evidence\":[{\"end\":532,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aad122195ebf9a14b38cd813fe18c3567eacf8a86a3073ba83b70b4c9078938bb:486:532:sha256-ef9dd49a24fdf399a59c74fe1ca095232f1de23e064f4d95166e624216f2adc6\",\"quote\":\"(III) in the case of an adverse determination—\",\"start\":486},{\"end\":897,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aad122195ebf9a14b38cd813fe18c3567eacf8a86a3073ba83b70b4c9078938bb:534:897:sha256-0260aa927a4c6466b7494aea3ad888585156af44046f34746bbccdc997140a16\",\"quote\":\"(aa) the right of such person to appeal to the head of the agency, within a period determined by the head of the agency that is not less than 90 days after the date of such adverse determination; and\\n\\n(bb) the right of such person to seek dispute resolution services from the FOIA Public Liaison of the agency or the Office of Government Information Services; and\",\"start\":534},{\"end\":15,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aad122195ebf9a14b38cd813fe18c3567eacf8a86a3073ba83b70b4c9078938bb:4:15:sha256-632c96efd8bbc3292b8878709479e1599259627685fb32518354430e993f8afc\",\"quote\":\"Each agency\",\"start\":4},{\"end\":110,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aad122195ebf9a14b38cd813fe18c3567eacf8a86a3073ba83b70b4c9078938bb:0:110:sha256-750157711052c7bbe5f2dd79cecbbfe51960b93e7e8e51e171d66af84bf9bd80\",\"quote\":\"(A) Each agency, upon any request for records made under paragraph (1), (2), or (3) of this subsection, shall—\",\"start\":0},{\"end\":532,\"field\":\"scope_text:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aad122195ebf9a14b38cd813fe18c3567eacf8a86a3073ba83b70b4c9078938bb:486:532:sha256-ef9dd49a24fdf399a59c74fe1ca095232f1de23e064f4d95166e624216f2adc6\",\"quote\":\"(III) in the case of an adverse determination—\",\"start\":486}],\"id\":\"urn:rulespec:document-understanding:revision:f6d2db626b83a6dc96bf5ade54a7e32f51a673c1a7f8457d978e1f8c88225702\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:ca70f559939f645d569845dc63f3da578d866e8ec32892252908277104df13da\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:c2a8c56b4b6330cf56cd073316b95a898dca90b43ca875aec08928a644629112\",\"origin\":\"aiSuggested\",\"quote\":\"(III) in the case of an adverse determination—\\n\\n(aa) the right of such person to appeal to the head of the agency, within a period determined by the head of the agency that is not less than 90 days after the date of such adverse determination; and\\n\\n(bb) the right of such person to seek dispute resolution services from the FOIA Public Liaison of the agency or the Office of Government Information Services; and\",\"references\":[\"paragraph (1), (2), or (3) of this subsection\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:d7a775166f71ab572fbadd29f01a652c037d9e423c56e2228fd6baccb47c0e23\",\"scope_quotes\":[\"(A) Each agency, upon any request for records made under paragraph (1), (2), or (3) of this subsection, shall—\",\"(III) in the case of an adverse determination—\"],\"scope_text\":\"Upon any request for records made under paragraph (1), (2), or (3) of this subsection, in the case of an adverse determination\",\"section_id\":\"section-1\",\"start\":486,\"summary\":\"Upon any request for records made under paragraph (1), (2), or (3) of subsection 552(a), in the case of an adverse determination, the agency shall immediately notify the person making the request of the right of such person to appeal to the head of the agency, within a period determined by the head of the agency that is not less than 90 days after the date of such adverse determination, and the right of such person to seek dispute resolution services from the FOIA Public Liaison of the agency or the Office of Government Information Services.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:c5ec45679f912fe80576b51c3f7244d719c1f7212d0271512cb98d309b3e6611\",\"urn:rulespec:document-understanding:assertion:d2493d3731a03ae17b347958ab5ac3705a3346681272d2cde838243ddaece99d\",\"urn:rulespec:document-understanding:assertion:04d04559dc56a94c165a6b44cedaa35902106bdabdb9ec12d0c7e0ea65ec74cd\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":1722,\"evidence\":[{\"end\":1722,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aad122195ebf9a14b38cd813fe18c3567eacf8a86a3073ba83b70b4c9078938bb:1304:1722:sha256-51092550b79c2fe96c298c7bf2d56171024f9030333092cf3179d9f71b91de5c\",\"quote\":\"The 20-day period under clause (i) shall commence on the date on which the request is first received by the appropriate component of the agency, but in any event not later than ten days after the request is first received by any component of the agency that is designated in the agency’s regulations under this section to receive requests under this section. The 20-day period shall not be tolled by the agency except—\",\"start\":1304}],\"id\":\"urn:rulespec:document-understanding:revision:9ef93198b2f484d2f7f477ffd247543b8330e230f33c72b958a28be661e7140e\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:04d04559dc56a94c165a6b44cedaa35902106bdabdb9ec12d0c7e0ea65ec74cd\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:aa8fc62a4071c0f0476dc2752cf53d3793755b3601158df05a975244c31ba227\",\"origin\":\"aiSuggested\",\"quote\":\"The 20-day period under clause (i) shall commence on the date on which the request is first received by the appropriate component of the agency, but in any event not later than ten days after the request is first received by any component of the agency that is designated in the agency’s regulations under this section to receive requests under this section. The 20-day period shall not be tolled by the agency except—\",\"references\":[\"clause (i)\",\"this section\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:1ea51359b8d6ca74a17ea0439b39283d166c87ad5b00d0829da31915267ca877\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":1304,\"summary\":\"The 20-day period under clause (i) shall commence on the date on which the request is first received by the appropriate component of the agency, but in any event not later than ten days after the request is first received by any component of the agency that is designated in the agency’s regulations under section 552 to receive requests under section 552.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"Each agency\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:44e031f1752fd4a07fd9fb6d0ed5d15b6ea1d08cfd05f787739c8307cec0ac8d\",\"urn:rulespec:document-understanding:assertion:e12654e424c3db223a555c3b5919bcb9e81091f88dd23c123844e33bfa3653d8\",\"urn:rulespec:document-understanding:assertion:02d8183ccd6c30ae49b25d400c040f6719b664e2c13360f431b19cbd4418b2ab\",\"urn:rulespec:document-understanding:assertion:b8d4558bbbb055df3cfb903e9e8589b3439c4aed65294a9e6e3e8c7c3d165b05\",\"urn:rulespec:document-understanding:assertion:202b4917050ec6e5b3674ec788a75142c1377f003d5f23b51d1c288d60f23b3d\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":1301,\"evidence\":[{\"end\":1301,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aad122195ebf9a14b38cd813fe18c3567eacf8a86a3073ba83b70b4c9078938bb:901:1301:sha256-f10492a3c89755c23183e0f654e062e66467278b5afc5ad4c47f5cee8fdf33bb\",\"quote\":\"(ii) make a determination with respect to any appeal within twenty days (excepting Saturdays, Sundays, and legal public holidays) after the receipt of such appeal. If on appeal the denial of the request for records is in whole or in part upheld, the agency shall notify the person making such request of the provisions for judicial review of that determination under paragraph (4) of this subsection.\",\"start\":901},{\"end\":15,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aad122195ebf9a14b38cd813fe18c3567eacf8a86a3073ba83b70b4c9078938bb:4:15:sha256-632c96efd8bbc3292b8878709479e1599259627685fb32518354430e993f8afc\",\"quote\":\"Each agency\",\"start\":4},{\"end\":1163,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aad122195ebf9a14b38cd813fe18c3567eacf8a86a3073ba83b70b4c9078938bb:1158:1163:sha256-56ee5b508706bf2de91712d85d6d1e11ddbff01949142ed6e8c22e3b1bed1c71\",\"quote\":\"shall\",\"start\":1158},{\"end\":110,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aad122195ebf9a14b38cd813fe18c3567eacf8a86a3073ba83b70b4c9078938bb:0:110:sha256-750157711052c7bbe5f2dd79cecbbfe51960b93e7e8e51e171d66af84bf9bd80\",\"quote\":\"(A) Each agency, upon any request for records made under paragraph (1), (2), or (3) of this subsection, shall—\",\"start\":0}],\"id\":\"urn:rulespec:document-understanding:revision:ee9c6f22d43224c8ad9385ff088b2ff678282fd24a053279e53c62c4cb4848e9\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:202b4917050ec6e5b3674ec788a75142c1377f003d5f23b51d1c288d60f23b3d\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:33fa66acfdde549b309a31f013bd52d1a34bc4c6767b67dfa8ac18e9bbf4c118\",\"origin\":\"aiSuggested\",\"quote\":\"(ii) make a determination with respect to any appeal within twenty days (excepting Saturdays, Sundays, and legal public holidays) after the receipt of such appeal. If on appeal the denial of the request for records is in whole or in part upheld, the agency shall notify the person making such request of the provisions for judicial review of that determination under paragraph (4) of this subsection.\",\"references\":[\"paragraph (1), (2), or (3) of this subsection\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:a213f2d6ca1079c43bb191a40877bf6a586ec32a1983dc07218c3056d2ab9ad6\",\"scope_quotes\":[\"(A) Each agency, upon any request for records made under paragraph (1), (2), or (3) of this subsection, shall—\"],\"scope_text\":\"Upon any request for records made under paragraph (1), (2), or (3) of this subsection\",\"section_id\":\"section-1\",\"start\":901,\"summary\":\"Each agency, upon any request for records made under paragraph (1), (2), or (3) of subsection 552(a), shall make a determination with respect to any appeal within twenty days (excepting Saturdays, Sundays, and legal public holidays) after receipt of such appeal.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

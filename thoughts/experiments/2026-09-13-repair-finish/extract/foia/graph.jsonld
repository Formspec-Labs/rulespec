    {
      "@id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aad122195ebf9a14b38cd813fe18c3567eacf8a86a3073ba83b70b4c9078938bb:1304:1723:sha256-a0c687c0108faa3b63c9a961ba6453055f0f53ad778ad2f2f1f68c31f3e78121",
      "@type": "rkaf:SourceFragment",
      "oa:hasSource": "urn:rulespec:document-understanding:document:ad122195ebf9a14b38cd813fe18c3567eacf8a86a3073ba83b70b4c9078938bb",
      "rkaf:fragmentIdentityScheme": "rkaf:carrier-local-fragment",
      "rkaf:sourceArtifactDigest": "sha256:ad122195ebf9a14b38cd813fe18c3567eacf8a86a3073ba83b70b4c9078938bb",
      "rkaf:fragmentContentDigest": "sha256:a0c687c0108faa3b63c9a961ba6453055f0f53ad778ad2f2f1f68c31f3e78121",
      "rkaf:selectorKind": [
        "oa:TextQuoteSelector",
        "oa:TextPositionSelector"
      ],
      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "The 20-day period under clause (i) shall commence on the date on which the request is first received by the appropriate component of the agency, but in any event not later than ten days after the request is first received by any component of the agency that is designated in the agency’s regulations under this section to receive requests under this section. The 20-day period shall not be tolled by the agency except—\n"
        },
        {
          "@type": "oa:TextPositionSelector",
          "oa:start": 1304,
          "oa:end": 1723,
          "rkaf:coordinateSystem": "rkaf:unicode-codepoint"
        }
      ]
    },
    {
      "@id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aad122195ebf9a14b38cd813fe18c3567eacf8a86a3073ba83b70b4c9078938bb:1724:2166:sha256-84334671b6166b1e580200811b7137e0b20a8a407035b00f3117daed22a9ae69",
      "@type": "rkaf:SourceFragment",
      "oa:hasSource": "urn:rulespec:document-understanding:document:ad122195ebf9a14b38cd813fe18c3567eacf8a86a3073ba83b70b4c9078938bb",
      "rkaf:fragmentIdentityScheme": "rkaf:carrier-local-fragment",
      "rkaf:sourceArtifactDigest": "sha256:ad122195ebf9a14b38cd813fe18c3567eacf8a86a3073ba83b70b4c9078938bb",
      "rkaf:fragmentContentDigest": "sha256:84334671b6166b1e580200811b7137e0b20a8a407035b00f3117daed22a9ae69",
      "rkaf:selectorKind": [
        "oa:TextQuoteSelector",
        "oa:TextPositionSelector"
      ],
      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "(I) that the agency may make one request to the requester for information and toll the 20-day period while it is awaiting such information that it has reasonably requested from the requester under this section; or\n\n(II) if necessary to clarify with the requester issues regarding fee assessment. In either case, the agency’s receipt of the requester’s response to the agency’s request for information or clarification ends the tolling period."
        },
        {
          "@type": "oa:TextPositionSelector",
          "oa:start": 1724,
          "oa:end": 2166,
          "rkaf:coordinateSystem": "rkaf:unicode-codepoint"
        }
      ]
    },
    {
      "@id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aad122195ebf9a14b38cd813fe18c3567eacf8a86a3073ba83b70b4c9078938bb:1681:1690:sha256-28a543410ef33838c223aa24fd725afc191e2cefa8bed95abc857ae6ff33f86e",

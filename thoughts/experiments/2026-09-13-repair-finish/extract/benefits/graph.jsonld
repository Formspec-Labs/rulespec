      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:13cc7c3265b2f50c44f47ee7745cee269359199bfa1b482b7b8c5b5aa314f2ee\",\"urn:rulespec:document-understanding:assertion:e16060f77b0721c81b69cc083d7a2955c000cf5d44310fd13da569170efa841a\",\"urn:rulespec:document-understanding:assertion:2bd510f098af9908495e73ea9bb6170f2964e416f41ca72c6822f707e2213fff\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":2074,\"evidence\":[{\"end\":1469,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A9ede50be3469932d071153987e9d2b399c510cf2e3db7e8c7c8f05bf5e359184:1455:1469:sha256-ca9693d7a03c9f0992c78cc6587bb92ef32954c0803056e0a7056d093f04556c\",\"quote\":\"(A) In general\",\"start\":1455},{\"end\":1518,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A9ede50be3469932d071153987e9d2b399c510cf2e3db7e8c7c8f05bf5e359184:1470:1518:sha256-d937ae4828626df1115f25a6549c7da69d6e3ba21661d411cde54e50c2c7447c\",\"quote\":\"A pension benefit statement under paragraph (1)—\",\"start\":1470},{\"end\":1589,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A9ede50be3469932d071153987e9d2b399c510cf2e3db7e8c7c8f05bf5e359184:1520:1589:sha256-637c7a726d63858e9b15a2829e2aab19c3b9edb506eb1375984c80e63a86da45\",\"quote\":\"(i) shall indicate, on the basis of the latest available information—\",\"start\":1520},{\"end\":2074,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A9ede50be3469932d071153987e9d2b399c510cf2e3db7e8c7c8f05bf5e359184:1591:2074:sha256-9dbef6d89ed6a781730d52142d670914a031ff44f5fd141bae037002a0044ea0\",\"quote\":\"(I) the total benefits accrued, and\\n\\n(II) the nonforfeitable pension benefits, if any, which have accrued, or the earliest date on which benefits will become nonforfeitable,\\n\\n\\n(ii) shall include an explanation of any permitted disparity under section 401(l) of title 26 or any floor-offset arrangement that may be applied in determining any accrued benefits described in clause (i),\\n\\n(iii) shall be written in a manner calculated to be understood by the average plan participant, and\",\"start\":1591}],\"id\":\"urn:rulespec:document-understanding:revision:82fc0e25a90ce81dd24fc46feae75d0c8e5ec5cadfa9a2c4bec7ccdcd58466e6\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:2bd510f098af9908495e73ea9bb6170f2964e416f41ca72c6822f707e2213fff\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:f98315f9020c073d3723a5d5e13a7c519e9708307003e97e206bcb010c797e2d\",\"origin\":\"aiSuggested\",\"quote\":\"(A) In general A pension benefit statement under paragraph (1)—\\n\\n(i) shall indicate, on the basis of the latest available information—\\n\\n(I) the total benefits accrued, and\\n\\n(II) the nonforfeitable pension benefits, if any, which have accrued, or the earliest date on which benefits will become nonforfeitable,\\n\\n\\n(ii) shall include an explanation of any permitted disparity under section 401(l) of title 26 or any floor-offset arrangement that may be applied in determining any accrued benefits described in clause (i),\\n\\n(iii) shall be written in a manner calculated to be understood by the average plan participant, and\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:50f0069e5ad3c630e48da3a2bcb21af435ba969bcc2b201cecbd86ff5fe65262\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":1455,\"summary\":\"A pension benefit statement under paragraph (1) shall be written in a manner calculated to be understood by the average plan participant.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:c5a61d2410f31a8fcdd584ed59143868a7e62872043bf40a025de56e2ea577a0\",\"urn:rulespec:document-understanding:assertion:4f7c99d63cd92218ee5611f58e5bd65ae019ff3c0e651eb59c3ad171977a9d4c\",\"urn:rulespec:document-understanding:assertion:ca4d38f47cb1cb0527531326ab8de4b185f417b0d3604e72890a0fd95c6c4b8f\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":8716,\"evidence\":[{\"end\":8716,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A9ede50be3469932d071153987e9d2b399c510cf2e3db7e8c7c8f05bf5e359184:8238:8716:sha256-cd539531e673564b640f81c8d82623ed7d1412cd85faa0172576ed82bbb2f409\",\"quote\":\"In the case of a defined benefit plan, the requirements of paragraph (1)(B)(i) shall be treated as met with respect to a participant if at least once each year the administrator provides to the participant notice of the availability of the pension benefit statement and the ways in which the participant may obtain such statement. Such notice may be delivered in written, electronic, or other appropriate form to the extent such form is reasonably accessible to the participant.\",\"start\":8238}],\"id\":\"urn:rulespec:document-understanding:revision:fc02201394b06fb751d9b310d569ef6e2ec41a9bf8da5ef0ee2f80654c5d075b\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"permission\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:ca4d38f47cb1cb0527531326ab8de4b185f417b0d3604e72890a0fd95c6c4b8f\",\"modality\":\"may\",\"modality_quote\":\"may\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:9d3a03238095a3cb4ef05a8450c80366d753af03be2487b9ed033ce7a4491c67\",\"origin\":\"aiSuggested\",\"quote\":\"In the case of a defined benefit plan, the requirements of paragraph (1)(B)(i) shall be treated as met with respect to a participant if at least once each year the administrator provides to the participant notice of the availability of the pension benefit statement and the ways in which the participant may obtain such statement. Such notice may be delivered in written, electronic, or other appropriate form to the extent such form is reasonably accessible to the participant.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:3d92e7e6a9f637f8b204f6882945d282605a9e8934bec852ae0a7464402827f3\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":8238,\"summary\":\"In the case of a defined benefit plan providing notice under paragraph (3)(A), such notice may be delivered in written, electronic, or other appropriate form to the extent such form is reasonably accessible to the participant.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:7663c7bbd8c3cbf7e375d6611538f8da14f5294e34a7b7bd38aae2fb1c266284\",\"urn:rulespec:document-understanding:assertion:78571ffcc98340ec69145d9bded674911c64cd068500a7634848c36f1a366f4b\",\"urn:rulespec:document-understanding:assertion:f01b0d5c4667a2d7e9ac7b460c80f528973f14b6f8130ef8b8c566accdca58fa\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":5592,\"evidence\":[{\"end\":5592,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A9ede50be3469932d071153987e9d2b399c510cf2e3db7e8c7c8f05bf5e359184:5127:5592:sha256-5f56684e9b0d1b9064abd9f02678398ecbbb4c5060fe8afbd1c5ac7f236e30a3\",\"quote\":\"The lifetime income streams described in this subclause are a qualified joint and survivor annuity (as defined in section 1055(d) of this title), based on assumptions specified in rules prescribed by the Secretary, including the assumption that the participant or beneficiary has a spouse of equal age, and a single life annuity. Such lifetime income streams may have a term certain or other features to the extent permitted under rules prescribed by the Secretary.\",\"start\":5127},{\"end\":5489,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A9ede50be3469932d071153987e9d2b399c510cf2e3db7e8c7c8f05bf5e359184:5486:5489:sha256-ee4d988c65de860fabbfbcd27f73d50bbebe3fba37fe419284f4811389c30bdc\",\"quote\":\"may\",\"start\":5486}],\"id\":\"urn:rulespec:document-understanding:revision:e8603c18eb15f53926481e6042c71444c89794b9108312d70ea084f52271667c\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"permission\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:f01b0d5c4667a2d7e9ac7b460c80f528973f14b6f8130ef8b8c566accdca58fa\",\"modality\":\"may\",\"modality_quote\":\"may\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:4e78b3e53f8f575efa3424d0c95ba268035650704273e864174f8da6b92e0840\",\"origin\":\"aiSuggested\",\"quote\":\"The lifetime income streams described in this subclause are a qualified joint and survivor annuity (as defined in section 1055(d) of this title), based on assumptions specified in rules prescribed by the Secretary, including the assumption that the participant or beneficiary has a spouse of equal age, and a single life annuity. Such lifetime income streams may have a term certain or other features to the extent permitted under rules prescribed by the Secretary.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:e07218fda78b256f97b372f8b8724f9f3217d30085b8f3c8c9e3648a2ce499e4\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":5127,\"summary\":\"Lifetime income streams described in subclause (III) may have a term certain or other features to the extent permitted under rules prescribed by the Secretary.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

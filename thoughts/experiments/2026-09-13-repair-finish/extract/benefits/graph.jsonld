      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:6aaacdcd6aa22d0270a10fc1a4e6919bdfdde253120cc18cc0eea74a6a2ce627",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:bafa26658625c21e08deaf3e46b9e0862600701ff9f0eb34db5ce26d4d0e852d\",\"urn:rulespec:document-understanding:assertion:c45f271670abdb25e864a01f76de0c4f03464705ddcc935a352bd33f0ca2a815\",\"urn:rulespec:document-understanding:assertion:7eb90babaf2be7fa679f20f95b68cae3393214bd64b5368e95a23f3b4220806a\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":2231,\"evidence\":[{\"end\":1469,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A9ede50be3469932d071153987e9d2b399c510cf2e3db7e8c7c8f05bf5e359184:1455:1469:sha256-ca9693d7a03c9f0992c78cc6587bb92ef32954c0803056e0a7056d093f04556c\",\"quote\":\"(A) In general\",\"start\":1455},{\"end\":1518,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A9ede50be3469932d071153987e9d2b399c510cf2e3db7e8c7c8f05bf5e359184:1470:1518:sha256-d937ae4828626df1115f25a6549c7da69d6e3ba21661d411cde54e50c2c7447c\",\"quote\":\"A pension benefit statement under paragraph (1)—\",\"start\":1470},{\"end\":1589,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A9ede50be3469932d071153987e9d2b399c510cf2e3db7e8c7c8f05bf5e359184:1520:1589:sha256-637c7a726d63858e9b15a2829e2aab19c3b9edb506eb1375984c80e63a86da45\",\"quote\":\"(i) shall indicate, on the basis of the latest available information—\",\"start\":1520},{\"end\":2231,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A9ede50be3469932d071153987e9d2b399c510cf2e3db7e8c7c8f05bf5e359184:1591:2231:sha256-6a35a2aa71849ec2b0f11635bb44807aa7660a24daa4cb820b75cc4c1503ca9e\",\"quote\":\"(I) the total benefits accrued, and\\n\\n(II) the nonforfeitable pension benefits, if any, which have accrued, or the earliest date on which benefits will become nonforfeitable,\\n\\n\\n(ii) shall include an explanation of any permitted disparity under section 401(l) of title 26 or any floor-offset arrangement that may be applied in determining any accrued benefits described in clause (i),\\n\\n(iii) shall be written in a manner calculated to be understood by the average plan participant, and\\n\\n(iv) may be delivered in written, electronic, or other appropriate form to the extent such form is reasonably accessible to the participant or beneficiary.\",\"start\":1591}],\"id\":\"urn:rulespec:document-understanding:revision:6eb9731d513779b12027a0538e2e73066f625748172ee996eb634f730009675a\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"permission\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:7eb90babaf2be7fa679f20f95b68cae3393214bd64b5368e95a23f3b4220806a\",\"modality\":\"may\",\"modality_quote\":\"may\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:735ba4d6ac158131a301389ea9a2effef2b221e69c9a67450b71cccf5501cd63\",\"origin\":\"aiSuggested\",\"quote\":\"(A) In general A pension benefit statement under paragraph (1)—\\n\\n(i) shall indicate, on the basis of the latest available information—\\n\\n(I) the total benefits accrued, and\\n\\n(II) the nonforfeitable pension benefits, if any, which have accrued, or the earliest date on which benefits will become nonforfeitable,\\n\\n\\n(ii) shall include an explanation of any permitted disparity under section 401(l) of title 26 or any floor-offset arrangement that may be applied in determining any accrued benefits described in clause (i),\\n\\n(iii) shall be written in a manner calculated to be understood by the average plan participant, and\\n\\n(iv) may be delivered in written, electronic, or other appropriate form to the extent such form is reasonably accessible to the participant or beneficiary.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:680c6da815d283394caf0f52578b21a4d22a74ba16cac4bf13cef684d64c32da\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":1455,\"summary\":\"A pension benefit statement under paragraph (1) may be delivered in written, electronic, or other appropriate form to the extent such form is reasonably accessible to the participant or beneficiary.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

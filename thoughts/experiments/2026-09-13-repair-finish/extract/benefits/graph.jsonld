      "dcterms:description": "{\"action\":\"\",\"actor\":\"the Secretary\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:36a4cd5d614b3c977a5aa5252232276293c7b15de5157522f1abb5c284cec7b1\",\"urn:rulespec:document-understanding:assertion:1ed7ee7e7fbdbc624d10622da95c4eedd4764d90287c8fa8b274cec939fc7c02\",\"urn:rulespec:document-understanding:assertion:504a15af313493d618c7a782985a0d88ef2bf1e6c94596efb6eafc7af122610f\",\"urn:rulespec:document-understanding:assertion:f772453015e06323bae8d308b0d73bd1f12d09ab00fd382fa3a90cef910e7fcd\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":7316,\"evidence\":[{\"end\":7316,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A9ede50be3469932d071153987e9d2b399c510cf2e3db7e8c7c8f05bf5e359184:6723:7316:sha256-2ef036e247bbfd776c820ca4ffd2028f5024efe3af61ebc733addbb2535b80c9\",\"quote\":\"In prescribing assumptions under subclause (I), the Secretary may prescribe a single set of specific assumptions (in which case the Secretary may issue tables or factors which facilitate such conversions), or ranges of permissible assumptions. To the extent that an accrued benefit is or may be invested in a lifetime income stream described in clause (i)(III), the assumptions prescribed under subclause (I) shall, to the extent appropriate, permit administrators of individual account plans to use the amounts payable under such lifetime income stream as a lifetime income stream equivalent.\",\"start\":6723}],\"id\":\"urn:rulespec:document-understanding:revision:a4ce0960db71692cf84890a6efe210e1bb9146ea7d86d5bb93285f172672535e\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"authority\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:f772453015e06323bae8d308b0d73bd1f12d09ab00fd382fa3a90cef910e7fcd\",\"modality\":\"may\",\"modality_quote\":\"may\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:68bade47d8f4a6da80463b4a99433ae4c843a3b440fb21655deb4a8e1dbec714\",\"origin\":\"aiSuggested\",\"quote\":\"In prescribing assumptions under subclause (I), the Secretary may prescribe a single set of specific assumptions (in which case the Secretary may issue tables or factors which facilitate such conversions), or ranges of permissible assumptions. To the extent that an accrued benefit is or may be invested in a lifetime income stream described in clause (i)(III), the assumptions prescribed under subclause (I) shall, to the extent appropriate, permit administrators of individual account plans to use the amounts payable under such lifetime income stream as a lifetime income stream equivalent.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:2ddd7917e2fdf8f5b2a483104939a7b0e3a813d96f52f8ace498ee393ffc5db0\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":6723,\"summary\":\"In prescribing assumptions under subclause (I), the Secretary may prescribe a single set of specific assumptions (in which case the Secretary may issue tables or factors which facilitate such conversions), or ranges of permissible assumptions.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

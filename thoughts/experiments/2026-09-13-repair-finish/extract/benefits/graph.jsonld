      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"The administrator of an individual account plan (other than a one-participant retirement plan described in section 1021(i)(8)(B) of this title)\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:4de63ee6f6c83c3d35006ef1afc26cdca08a282cc96ff587ff722bcbe919a024\",\"urn:rulespec:document-understanding:assertion:c9c9e7d4ccb97b243a4e71296fc8b82980d96ce2c1ee3b5ac941c74354453451\",\"urn:rulespec:document-understanding:assertion:102a0963677720658d3fcb519266ab3489f01e12493dfa94ebe7f929c162677b\",\"urn:rulespec:document-understanding:assertion:84399d94baf0538a0db6f61c868bf62300907b1be22e148273f10f398a87b6fb\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":740,\"evidence\":[{\"end\":101,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A9ede50be3469932d071153987e9d2b399c510cf2e3db7e8c7c8f05bf5e359184:74:101:sha256-1d86425b10643ba26bff07073c64d82cd5b80714cd6ca40c8ffaab0c93fddcd8\",\"quote\":\"(A) Individual account plan\",\"start\":74},{\"end\":288,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A9ede50be3469932d071153987e9d2b399c510cf2e3db7e8c7c8f05bf5e359184:102:288:sha256-91eebc936d2421990c86fe96a58487279ed4f74eb31a345778e0b4c50bcf8141\",\"quote\":\"The administrator of an individual account plan (other than a one-participant retirement plan described in section 1021(i)(8)(B) of this title) shall furnish a pension benefit statement—\",\"start\":102},{\"end\":740,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A9ede50be3469932d071153987e9d2b399c510cf2e3db7e8c7c8f05bf5e359184:290:740:sha256-1d8159a414eb18a64b9d4d4ad68893d57a2b8061dfdc6e47c90911057bc27c4d\",\"quote\":\"(i) at least once each calendar quarter to a participant or beneficiary who has the right to direct the investment of assets in his or her account under the plan,\\n\\n(ii) at least once each calendar year to a participant or beneficiary who has his or her own account under the plan but does not have the right to direct the investment of assets in that account, and\\n\\n(iii) upon written request to a plan beneficiary not described in clause (i) or (ii).\",\"start\":290},{\"end\":245,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A9ede50be3469932d071153987e9d2b399c510cf2e3db7e8c7c8f05bf5e359184:102:245:sha256-77aa98ae2f60d724e2cafa6146d88c149690841268ab526fe2219ab08a903de7\",\"quote\":\"The administrator of an individual account plan (other than a one-participant retirement plan described in section 1021(i)(8)(B) of this title)\",\"start\":102},{\"end\":251,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A9ede50be3469932d071153987e9d2b399c510cf2e3db7e8c7c8f05bf5e359184:246:251:sha256-56ee5b508706bf2de91712d85d6d1e11ddbff01949142ed6e8c22e3b1bed1c71\",\"quote\":\"shall\",\"start\":246}],\"id\":\"urn:rulespec:document-understanding:revision:0cb25d2c55b31eaeddfa308cc4f3ada0c7481f0c2da1a19fe310acae742a1d2b\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:84399d94baf0538a0db6f61c868bf62300907b1be22e148273f10f398a87b6fb\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:9a960ca884fc212e64bf9dbcec9e5fdb64518f3afe246e15185560c42bd0d92f\",\"origin\":\"aiSuggested\",\"quote\":\"(A) Individual account plan The administrator of an individual account plan (other than a one-participant retirement plan described in section 1021(i)(8)(B) of this title) shall furnish a pension benefit statement—\\n\\n(i) at least once each calendar quarter to a participant or beneficiary who has the right to direct the investment of assets in his or her account under the plan,\\n\\n(ii) at least once each calendar year to a participant or beneficiary who has his or her own account under the plan but does not have the right to direct the investment of assets in that account, and\\n\\n(iii) upon written request to a plan beneficiary not described in clause (i) or (ii).\",\"references\":[\"section 1021(i)(8)(B) of this title\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:fa365d2c5d4bead992a1571b953536697dd1202b222c3f22ca2b1bdf85d73840\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":74,\"summary\":\"The administrator of an individual account plan (other than a one-participant retirement plan described in section 1021(i)(8)(B) of this title) shall furnish a pension benefit statement upon written request to a plan beneficiary not described in clause (i) or (ii) of paragraph (1)(A).\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:da9d670c5701669ef376e9039f01b605d01d1a9f7c317f8fd308e625997d6e04\",\"urn:rulespec:document-understanding:assertion:d09c300c651c84f42aa1e229ab08f50ba1734cb9c3997385af9e1169c5cd4781\",\"urn:rulespec:document-understanding:assertion:7ff7ef7ba5c93a2c1d31bfe0d6969052eaa7550d5cdca8bdae403f402859a9dc\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":3005,\"evidence\":[{\"end\":2260,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A9ede50be3469932d071153987e9d2b399c510cf2e3db7e8c7c8f05bf5e359184:2234:2260:sha256-c9114cd95eb86732e4387ff726d211b0f83bfc21d7f2031ed210dc84ce266fcd\",\"quote\":\"(B) Additional information\",\"start\":2234},{\"end\":2393,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A9ede50be3469932d071153987e9d2b399c510cf2e3db7e8c7c8f05bf5e359184:2261:2393:sha256-6aaa0a7d1d50471d2133f1d9535304b883275e7d4261e51d50f3a421a8c1afa3\",\"quote\":\"In the case of an individual account plan, any pension benefit statement under clause (i) or (ii) of paragraph (1)(A) shall include—\",\"start\":2261},{\"end\":2863,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A9ede50be3469932d071153987e9d2b399c510cf2e3db7e8c7c8f05bf5e359184:2395:2863:sha256-37fe89ec400eeca06d2c6474f9de39959baaa8fd605daa3ae73d22dce6cb8529\",\"quote\":\"(i) the value of each investment to which assets in the individual account have been allocated, determined as of the most recent valuation date under the plan, including the value of any assets held in the form of employer securities, without regard to whether such securities were contributed by the plan sponsor or acquired at the direction of the plan or of the participant or beneficiary,\\n\\n(ii) in the case of a pension benefit statement under paragraph (1)(A)(i)—\",\"start\":2395},{\"end\":3005,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A9ede50be3469932d071153987e9d2b399c510cf2e3db7e8c7c8f05bf5e359184:2865:3005:sha256-fb698b7166bc496a2201041fa3dd7f850614c1829f026dfa406a25aced401801\",\"quote\":\"(I) an explanation of any limitations or restrictions on any right of the participant or beneficiary under the plan to direct an investment,\",\"start\":2865},{\"end\":2384,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A9ede50be3469932d071153987e9d2b399c510cf2e3db7e8c7c8f05bf5e359184:2379:2384:sha256-56ee5b508706bf2de91712d85d6d1e11ddbff01949142ed6e8c22e3b1bed1c71\",\"quote\":\"shall\",\"start\":2379}],\"id\":\"urn:rulespec:document-understanding:revision:4f34805b00d304fc7359b3af39428596c253c16ed52a837296b4d71567c892ed\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:7ff7ef7ba5c93a2c1d31bfe0d6969052eaa7550d5cdca8bdae403f402859a9dc\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:3a318ff33331fa5d18cbb6416c349a73645b4d937b00306efa978da3f219bc96\",\"origin\":\"aiSuggested\",\"quote\":\"(B) Additional information In the case of an individual account plan, any pension benefit statement under clause (i) or (ii) of paragraph (1)(A) shall include—\\n\\n(i) the value of each investment to which assets in the individual account have been allocated, determined as of the most recent valuation date under the plan, including the value of any assets held in the form of employer securities, without regard to whether such securities were contributed by the plan sponsor or acquired at the direction of the plan or of the participant or beneficiary,\\n\\n(ii) in the case of a pension benefit statement under paragraph (1)(A)(i)—\\n\\n(I) an explanation of any limitations or restrictions on any right of the participant or beneficiary under the plan to direct an investment,\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:564c234f9a6678db849b96d426d1674eeeb9c792349156fb8d3f20d6007523fa\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":2234,\"summary\":\"In the case of an individual account plan, a pension benefit statement under paragraph (1)(A)(i) shall include an explanation of any limitations or restrictions on any right of the participant or beneficiary under the plan to direct an investment.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

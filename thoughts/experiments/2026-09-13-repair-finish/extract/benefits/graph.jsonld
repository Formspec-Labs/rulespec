      "@id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A9ede50be3469932d071153987e9d2b399c510cf2e3db7e8c7c8f05bf5e359184:1591:2231:sha256-6a35a2aa71849ec2b0f11635bb44807aa7660a24daa4cb820b75cc4c1503ca9e",

      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:states-requirement",
      "rkaf:assertsValue": {
        "@value": "In the case of an individual account plan, any pension benefit statement under clause (i) or (ii) of paragraph (1)(A) shall include the value of each investment to which assets in the individual account have been allocated, determined as of the most recent valuation date under the plan, including the value of any assets held in the form of employer securities, without regard to whether such securities were contributed by the plan sponsor or acquired at the direction of the plan or of the participant or beneficiary.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

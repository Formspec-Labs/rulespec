      "dcterms:description": "{\"action\":\"\",\"actor\":\"the Secretary\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:ee782cbdf6e24dc94225d8d72484dba6bf3ed81b035d84c1e6b010aedc6021ac\",\"urn:rulespec:document-understanding:assertion:4f730b388fb332a1889026962cc050495c54caf985a80d08f53e42a362cc6054\",\"urn:rulespec:document-understanding:assertion:cda198213303943dedd063118a140673077327123c3b9ba6f8aef6f18f4c8814\",\"urn:rulespec:document-understanding:assertion:d2c8cdd14e2d770d21f1105e7ecbd2634bdd9df62539d639a42b9e598a403528\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":6718,\"evidence\":[{\"end\":6400,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A9ede50be3469932d071153987e9d2b399c510cf2e3db7e8c7c8f05bf5e359184:6373:6400:sha256-7f16aa6d6c704e12293a7258075b85ada8b306f94c7586e4c049e481a6818cc6\",\"quote\":\"(iii) Assumptions and rules\",\"start\":6373},{\"end\":6468,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A9ede50be3469932d071153987e9d2b399c510cf2e3db7e8c7c8f05bf5e359184:6401:6468:sha256-b787fc4ca5e14978447a11eb9026cf6b6b83be32aee16a28d012294fa28b38d3\",\"quote\":\"Not later than 1 year after December 20, 2019, the Secretary shall—\",\"start\":6401},{\"end\":6718,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A9ede50be3469932d071153987e9d2b399c510cf2e3db7e8c7c8f05bf5e359184:6470:6718:sha256-0ce245f7f6a3b52ceb12c395d3be1a9f977fe0581d53b5ae3bfca454a69784d6\",\"quote\":\"(I) prescribe assumptions which administrators of individual account plans may use in converting total accrued benefits into lifetime income stream equivalents for purposes of this subparagraph; and\\n\\n(II) issue interim final rules under clause (i).\",\"start\":6470},{\"end\":6461,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A9ede50be3469932d071153987e9d2b399c510cf2e3db7e8c7c8f05bf5e359184:6448:6461:sha256-67afe9d5c4310238267da793c265a616f9e90d554f2458a8065b7bb971d853b5\",\"quote\":\"the Secretary\",\"start\":6448},{\"end\":6467,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A9ede50be3469932d071153987e9d2b399c510cf2e3db7e8c7c8f05bf5e359184:6462:6467:sha256-56ee5b508706bf2de91712d85d6d1e11ddbff01949142ed6e8c22e3b1bed1c71\",\"quote\":\"shall\",\"start\":6462}],\"id\":\"urn:rulespec:document-understanding:revision:694101a8da3d9997869f8e968e31d7d777a5403ef55d840f231c93809ec17084\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:d2c8cdd14e2d770d21f1105e7ecbd2634bdd9df62539d639a42b9e598a403528\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:8f6a2d8862cd88e4767fd65a382b3607b58268022189e7f58f0eef606440aaa4\",\"origin\":\"aiSuggested\",\"quote\":\"(iii) Assumptions and rules Not later than 1 year after December 20, 2019, the Secretary shall—\\n\\n(I) prescribe assumptions which administrators of individual account plans may use in converting total accrued benefits into lifetime income stream equivalents for purposes of this subparagraph; and\\n\\n(II) issue interim final rules under clause (i).\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:3651b136db0c7dc53c3646d6737c7cab44df36db51dbf988871462429ed4ee11\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":6373,\"summary\":\"Not later than 1 year after December 20, 2019, the Secretary shall issue interim final rules under clause (i).\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

    {
      "@id": "urn:rulespec:document-understanding:revision:3603806a2c13f922b383d16a02b729c4e9e86142e5c3549b25550afb1df4d0eb",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:3603806a2c13f922b383d16a02b729c4e9e86142e5c3549b25550afb1df4d0eb",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:80d391074275e9541341f31d0c95591c639e629df537b17aeed05592281f5c7d",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"the plan\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:3daf442c5ea5848a68b00c30925320b9a1e1305babdd2aed5b90085af30de33d\",\"urn:rulespec:document-understanding:assertion:012fccee75252bf86699cbc26140222c44d48070eec5a23f19831822c43339dc\",\"urn:rulespec:document-understanding:assertion:b89087f12b7a569974d00b83e996aefa5725d7690ae2c20ef51494d29e707c4a\",\"urn:rulespec:document-understanding:assertion:26e26b5c4c1263719b1b822ce2390055c7965411ebdbd6e6a4c9c2d71502070a\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":4393,\"evidence\":[{\"end\":3981,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A9ede50be3469932d071153987e9d2b399c510cf2e3db7e8c7c8f05bf5e359184:3959:3981:sha256-04f445f7d17297e750f16a4fb5c174905c3012612b6559b352108c594a7feea5\",\"quote\":\"(C) Alternative notice\",\"start\":3959},{\"end\":4119,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A9ede50be3469932d071153987e9d2b399c510cf2e3db7e8c7c8f05bf5e359184:3982:4119:sha256-e251d8354c0dd6c01b7c2456f07748fe508d1f732b81758f830e64daf3e4e5fe\",\"quote\":\"The requirements of subparagraph (A)(i)(II) are met if, at least annually and in accordance with requirements of the Secretary, the plan—\",\"start\":3982},{\"end\":4393,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A9ede50be3469932d071153987e9d2b399c510cf2e3db7e8c7c8f05bf5e359184:4121:4393:sha256-47649a6073cd45ef1b39a32a7e2d1f38784123af917908be1acbbcbadeb32cb7\",\"quote\":\"(i) updates the information described in such paragraph which is provided in the pension benefit statement, or\\n\\n(ii) provides in a separate statement such information as is necessary to enable a participant or beneficiary to determine their nonforfeitable vested benefits.\",\"start\":4121},{\"end\":4118,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A9ede50be3469932d071153987e9d2b399c510cf2e3db7e8c7c8f05bf5e359184:4110:4118:sha256-aab8f06fecd1c041e9a3d5a86114f9e522b546918db8503a045fe4a423b3642a\",\"quote\":\"the plan\",\"start\":4110}],\"id\":\"urn:rulespec:document-understanding:revision:3603806a2c13f922b383d16a02b729c4e9e86142e5c3549b25550afb1df4d0eb\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"statement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:26e26b5c4c1263719b1b822ce2390055c7965411ebdbd6e6a4c9c2d71502070a\",\"modality\":\"not_stated\",\"modality_quote\":\"\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:fb85cfaec0fc2751c4fa2427c9510026867b0059cf8431a54f036fef59440775\",\"origin\":\"aiSuggested\",\"quote\":\"(C) Alternative notice The requirements of subparagraph (A)(i)(II) are met if, at least annually and in accordance with requirements of the Secretary, the plan—\\n\\n(i) updates the information described in such paragraph which is provided in the pension benefit statement, or\\n\\n(ii) provides in a separate statement such information as is necessary to enable a participant or beneficiary to determine their nonforfeitable vested benefits.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:a2b56fd0ae68349761623743438728efbd02e02d3f230e5566dd313a1343d582\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":3959,\"summary\":\"The requirements of subparagraph (A)(i)(II) are met if, at least annually and in accordance with requirements of the Secretary, the plan updates the information described in such paragraph which is provided in the pension benefit statement, or provides in a separate statement such information as is necessary to enable a participant or beneficiary to determine their nonforfeitable vested benefits.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

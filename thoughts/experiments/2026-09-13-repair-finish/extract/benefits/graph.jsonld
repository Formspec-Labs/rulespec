      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:24d98e169451e0a2c5577464c46f60a421a1a868b2d3da9ced82e4e45b88dae9",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:e99310a9bb5558d56c05b9841fc5ed1b4ee0d93d15eb8ed2c43039970ac83bcb",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:fda264179cfd7cd5143739f91ba54b3eb2261ce53bd7c0fbdd020e40fb28d6f9",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:states-requirement",
      "rkaf:assertsValue": {
        "@value": "Not later than 1 year after December 20, 2019, the Secretary shall issue a model lifetime income disclosure, written in a manner so as to be understood by the average plan participant, which explains that the lifetime income stream equivalent is only provided as an illustration; explains that the actual payments under the lifetime income stream described in clause (i)(III) which may be purchased with the total benefits accrued will depend on numerous factors and may vary substantially from the lifetime income stream equivalent in the disclosures; explains the assumptions upon which the lifetime income stream equivalent was determined; and provides such other similar explanations as the Secretary considers appropriate.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

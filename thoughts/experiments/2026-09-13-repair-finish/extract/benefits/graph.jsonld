    {
      "@id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A9ede50be3469932d071153987e9d2b399c510cf2e3db7e8c7c8f05bf5e359184:2865:3623:sha256-d9a0b6101efd444984ef7fc9057d901083d9e4236b110bf40c9dfe30d080ca5a",
      "@type": "rkaf:SourceFragment",
      "oa:hasSource": "urn:rulespec:document-understanding:document:9ede50be3469932d071153987e9d2b399c510cf2e3db7e8c7c8f05bf5e359184",
      "rkaf:fragmentIdentityScheme": "rkaf:carrier-local-fragment",
      "rkaf:sourceArtifactDigest": "sha256:9ede50be3469932d071153987e9d2b399c510cf2e3db7e8c7c8f05bf5e359184",
      "rkaf:fragmentContentDigest": "sha256:d9a0b6101efd444984ef7fc9057d901083d9e4236b110bf40c9dfe30d080ca5a",
      "rkaf:selectorKind": [
        "oa:TextQuoteSelector",
        "oa:TextPositionSelector"
      ],
      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "(I) an explanation of any limitations or restrictions on any right of the participant or beneficiary under the plan to direct an investment,\n\n(II) an explanation, written in a manner calculated to be understood by the average plan participant, of the importance, for the long-term retirement security of participants and beneficiaries, of a well-balanced and diversified investment portfolio, including a statement of the risk that holding more than 20 percent of a portfolio in the security of one entity (such as employer securities) may not be adequately diversified, and\n\n(III) a notice directing the participant or beneficiary to the Internet website of the Department of Labor for sources of information on individual investing and diversification, and"
        },
        {
          "@type": "oa:TextPositionSelector",
          "oa:start": 2865,
          "oa:end": 3623,
          "rkaf:coordinateSystem": "rkaf:unicode-codepoint"
        }
      ]
    },

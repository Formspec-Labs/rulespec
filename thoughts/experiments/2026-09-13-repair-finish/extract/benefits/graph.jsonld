    {
      "@id": "urn:rulespec:document-understanding:revision:53d34d6ca47d2785831d441b885b18ca944ffde9f75a09c5954e9eb1583c920c",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:53d34d6ca47d2785831d441b885b18ca944ffde9f75a09c5954e9eb1583c920c",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:8b57a8381c538523171f1fd5bfc8dd90b94892a733d93989f36bdbd4fae35583",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:a5b1368768acd067b37ede6a87c3a49a4320b6da923bb85faf97bba53a91a46a\",\"urn:rulespec:document-understanding:assertion:f82d8dd3edac7c74499adf37449a93e7b105407735ed88cd51a2ece7aae1aa85\",\"urn:rulespec:document-understanding:assertion:bb3446ac0850f8c5dca8392ee83963b41da06843c57dc33710cec9b7ea891f94\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":3696,\"evidence\":[{\"end\":2260,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A9ede50be3469932d071153987e9d2b399c510cf2e3db7e8c7c8f05bf5e359184:2234:2260:sha256-c9114cd95eb86732e4387ff726d211b0f83bfc21d7f2031ed210dc84ce266fcd\",\"quote\":\"(B) Additional information\",\"start\":2234},{\"end\":2393,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A9ede50be3469932d071153987e9d2b399c510cf2e3db7e8c7c8f05bf5e359184:2261:2393:sha256-6aaa0a7d1d50471d2133f1d9535304b883275e7d4261e51d50f3a421a8c1afa3\",\"quote\":\"In the case of an individual account plan, any pension benefit statement under clause (i) or (ii) of paragraph (1)(A) shall include—\",\"start\":2261},{\"end\":2863,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A9ede50be3469932d071153987e9d2b399c510cf2e3db7e8c7c8f05bf5e359184:2395:2863:sha256-37fe89ec400eeca06d2c6474f9de39959baaa8fd605daa3ae73d22dce6cb8529\",\"quote\":\"(i) the value of each investment to which assets in the individual account have been allocated, determined as of the most recent valuation date under the plan, including the value of any assets held in the form of employer securities, without regard to whether such securities were contributed by the plan sponsor or acquired at the direction of the plan or of the participant or beneficiary,\\n\\n(ii) in the case of a pension benefit statement under paragraph (1)(A)(i)—\",\"start\":2395},{\"end\":3696,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A9ede50be3469932d071153987e9d2b399c510cf2e3db7e8c7c8f05bf5e359184:2865:3696:sha256-0a427696d0179f48c323b57c838f1ef9a6546952f8bc8a01ea06a45a3d8d8136\",\"quote\":\"(I) an explanation of any limitations or restrictions on any right of the participant or beneficiary under the plan to direct an investment,\\n\\n(II) an explanation, written in a manner calculated to be understood by the average plan participant, of the importance, for the long-term retirement security of participants and beneficiaries, of a well-balanced and diversified investment portfolio, including a statement of the risk that holding more than 20 percent of a portfolio in the security of one entity (such as employer securities) may not be adequately diversified, and\\n\\n(III) a notice directing the participant or beneficiary to the Internet website of the Department of Labor for sources of information on individual investing and diversification, and\\n\\n\\n(iii) the lifetime income disclosure described in subparagraph (D)(i).\",\"start\":2865},{\"end\":2384,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A9ede50be3469932d071153987e9d2b399c510cf2e3db7e8c7c8f05bf5e359184:2379:2384:sha256-56ee5b508706bf2de91712d85d6d1e11ddbff01949142ed6e8c22e3b1bed1c71\",\"quote\":\"shall\",\"start\":2379}],\"id\":\"urn:rulespec:document-understanding:revision:53d34d6ca47d2785831d441b885b18ca944ffde9f75a09c5954e9eb1583c920c\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:bb3446ac0850f8c5dca8392ee83963b41da06843c57dc33710cec9b7ea891f94\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:d1923a0157702dadf8e3a83dc6c314c21c3b92f233c13b4b540db1b6afb438c0\",\"origin\":\"aiSuggested\",\"quote\":\"(B) Additional information In the case of an individual account plan, any pension benefit statement under clause (i) or (ii) of paragraph (1)(A) shall include—\\n\\n(i) the value of each investment to which assets in the individual account have been allocated, determined as of the most recent valuation date under the plan, including the value of any assets held in the form of employer securities, without regard to whether such securities were contributed by the plan sponsor or acquired at the direction of the plan or of the participant or beneficiary,\\n\\n(ii) in the case of a pension benefit statement under paragraph (1)(A)(i)—\\n\\n(I) an explanation of any limitations or restrictions on any right of the participant or beneficiary under the plan to direct an investment,\\n\\n(II) an explanation, written in a manner calculated to be understood by the average plan participant, of the importance, for the long-term retirement security of participants and beneficiaries, of a well-balanced and diversified investment portfolio, including a statement of the risk that holding more than 20 percent of a portfolio in the security of one entity (such as employer securities) may not be adequately diversified, and\\n\\n(III) a notice directing the participant or beneficiary to the Internet website of the Department of Labor for sources of information on individual investing and diversification, and\\n\\n\\n(iii) the lifetime income disclosure described in subparagraph (D)(i).\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:573dbbf46737732d4687cc71b0c1dae8d3f232c9f682f5615b5c9a19ad591815\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":2234,\"summary\":\"In the case of an individual account plan, any pension benefit statement under clause (i) or (ii) of paragraph (1)(A) shall include the lifetime income disclosure described in subparagraph (D)(i).\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",
      "dcterms:references": [

      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"The administrator of a defined benefit plan (other than a one-participant retirement plan described in section 1021(i)(8)(B) of this title)\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:242ce1b27132e7f0183e2e830e8e9712e52879092ac7ae058e33f85f035cee4d\",\"urn:rulespec:document-understanding:assertion:71b39e4185ec7255fc79f7ab99a66691dcce5cbe7dd77023d34bfe5183f07042\",\"urn:rulespec:document-understanding:assertion:50f4893dcc9822f162ad4f59a27f4333c4b48f05cf41eed96baf5cf1a585ac91\",\"urn:rulespec:document-understanding:assertion:2cd32a8d9e89b8e3a5c5d8a2733e4d6802babcc278f9d66be4bd44792d4b3836\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":1220,\"evidence\":[{\"end\":767,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A9ede50be3469932d071153987e9d2b399c510cf2e3db7e8c7c8f05bf5e359184:743:767:sha256-e4a3f91e22991eb6a3259cd47b90dc262886ecdfa617fb01ece72b9515481e70\",\"quote\":\"(B) Defined benefit plan\",\"start\":743},{\"end\":950,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A9ede50be3469932d071153987e9d2b399c510cf2e3db7e8c7c8f05bf5e359184:768:950:sha256-355d56ce04ebfebd2283cde95504d8a746ce6c4a1415778e5362d7f10f665fd2\",\"quote\":\"The administrator of a defined benefit plan (other than a one-participant retirement plan described in section 1021(i)(8)(B) of this title) shall furnish a pension benefit statement—\",\"start\":768},{\"end\":1220,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A9ede50be3469932d071153987e9d2b399c510cf2e3db7e8c7c8f05bf5e359184:952:1220:sha256-07ce7f860a38f3d63647cfe87b07873b5d3c6480ef26263e4b3b84619940631f\",\"quote\":\"(i) at least once every 3 years to each participant with a nonforfeitable accrued benefit and who is employed by the employer maintaining the plan at the time the statement is to be furnished, and\\n\\n(ii) to a participant or beneficiary of the plan upon written request.\",\"start\":952},{\"end\":907,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A9ede50be3469932d071153987e9d2b399c510cf2e3db7e8c7c8f05bf5e359184:768:907:sha256-885ab78ae6fae78b73e914ca9819556d0655069a9ef8cb9ed13ba14e86c4a99a\",\"quote\":\"The administrator of a defined benefit plan (other than a one-participant retirement plan described in section 1021(i)(8)(B) of this title)\",\"start\":768},{\"end\":913,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A9ede50be3469932d071153987e9d2b399c510cf2e3db7e8c7c8f05bf5e359184:908:913:sha256-56ee5b508706bf2de91712d85d6d1e11ddbff01949142ed6e8c22e3b1bed1c71\",\"quote\":\"shall\",\"start\":908}],\"id\":\"urn:rulespec:document-understanding:revision:0f2085a4feb70600ec80f3364b20394291bbc865b9902f17b1442462c2cbcb8c\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:2cd32a8d9e89b8e3a5c5d8a2733e4d6802babcc278f9d66be4bd44792d4b3836\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:bd38df1338356d69299cfff17ddfddadd6bcf87064c50be9f782b5e5ce064b6a\",\"origin\":\"aiSuggested\",\"quote\":\"(B) Defined benefit plan The administrator of a defined benefit plan (other than a one-participant retirement plan described in section 1021(i)(8)(B) of this title) shall furnish a pension benefit statement—\\n\\n(i) at least once every 3 years to each participant with a nonforfeitable accrued benefit and who is employed by the employer maintaining the plan at the time the statement is to be furnished, and\\n\\n(ii) to a participant or beneficiary of the plan upon written request.\",\"references\":[\"section 1021(i)(8)(B) of this title\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:501b479c0cf3715e2a4d330c644ac4ad78e337a8ca3c5136095b4c19bf0f7010\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":743,\"summary\":\"The administrator of a defined benefit plan (other than a one-participant retirement plan described in section 1021(i)(8)(B) of this title) shall furnish a pension benefit statement to a participant or beneficiary of the plan upon written request.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

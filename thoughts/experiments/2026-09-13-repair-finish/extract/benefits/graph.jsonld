      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:635639a04a6a62d6d66f6b890d029cd1917eb097c42e5eeb1f8a6de987ccae11",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:99c0eefb61865b93d3c84f36e648bf9457148a01c14c10241be5d9dee9d2c946",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"the Secretary\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:868edce325fda84357fbad4ddbfbdd17a95d3ff9c31df12f3cfee2f924cb3306\",\"urn:rulespec:document-understanding:assertion:ec465cde8062fed51486c34c28bc29f0613c0ddb951722162d783b8d7273e3bf\",\"urn:rulespec:document-understanding:assertion:162463c28ad3c06efba78d529ea0e010a3391d4e28a5ec6a1ff222255bada56a\",\"urn:rulespec:document-understanding:assertion:c5a0d4ba99664aed001d9baacf2bb21abafbdcd46087c436cf9947642ae73395\",\"urn:rulespec:document-understanding:assertion:48d5027dc49fecfa3407817d9387f239542e6a2b478b5213bc46cbf7167bcc6a\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":6370,\"evidence\":[{\"end\":5617,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A9ede50be3469932d071153987e9d2b399c510cf2e3db7e8c7c8f05bf5e359184:5596:5617:sha256-bea0baddc937955870f64efbd1daaf8408c8cd2cceeaeab6532416b1f9bcd3e3\",\"quote\":\"(ii) Model disclosure\",\"start\":5596},{\"end\":5809,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A9ede50be3469932d071153987e9d2b399c510cf2e3db7e8c7c8f05bf5e359184:5618:5809:sha256-db202aeaac281c674a159dfe5b1ba0f617357a6e661f3c1092b2a7cfaae52baa\",\"quote\":\"Not later than 1 year after December 20, 2019, the Secretary shall issue a model lifetime income disclosure, written in a manner so as to be understood by the average plan participant, which—\",\"start\":5618},{\"end\":6370,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A9ede50be3469932d071153987e9d2b399c510cf2e3db7e8c7c8f05bf5e359184:5811:6370:sha256-a911fc58e61a4ebdee99a7e59b6460ab8ce619cb1dbb8634cf7517c57e8f62d1\",\"quote\":\"(I) explains that the lifetime income stream equivalent is only provided as an illustration;\\n\\n(II) explains that the actual payments under the lifetime income stream described in clause (i)(III) which may be purchased with the total benefits accrued will depend on numerous factors and may vary substantially from the lifetime income stream equivalent in the disclosures;\\n\\n(III) explains the assumptions upon which the lifetime income stream equivalent was determined; and\\n\\n(IV) provides such other similar explanations as the Secretary considers appropriate.\",\"start\":5811},{\"end\":5684,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A9ede50be3469932d071153987e9d2b399c510cf2e3db7e8c7c8f05bf5e359184:5679:5684:sha256-56ee5b508706bf2de91712d85d6d1e11ddbff01949142ed6e8c22e3b1bed1c71\",\"quote\":\"shall\",\"start\":5679}],\"id\":\"urn:rulespec:document-understanding:revision:635639a04a6a62d6d66f6b890d029cd1917eb097c42e5eeb1f8a6de987ccae11\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:c5a0d4ba99664aed001d9baacf2bb21abafbdcd46087c436cf9947642ae73395\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:e4549bdf4615437274d1da42bff9f137146f5e7bb799b99900b6544e82b74f20\",\"origin\":\"aiSuggested\",\"quote\":\"(ii) Model disclosure Not later than 1 year after December 20, 2019, the Secretary shall issue a model lifetime income disclosure, written in a manner so as to be understood by the average plan participant, which—\\n\\n(I) explains that the lifetime income stream equivalent is only provided as an illustration;\\n\\n(II) explains that the actual payments under the lifetime income stream described in clause (i)(III) which may be purchased with the total benefits accrued will depend on numerous factors and may vary substantially from the lifetime income stream equivalent in the disclosures;\\n\\n(III) explains the assumptions upon which the lifetime income stream equivalent was determined; and\\n\\n(IV) provides such other similar explanations as the Secretary considers appropriate.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:fda264179cfd7cd5143739f91ba54b3eb2261ce53bd7c0fbdd020e40fb28d6f9\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":5596,\"summary\":\"Not later than 1 year after December 20, 2019, the Secretary shall issue a model lifetime income disclosure, written in a manner so as to be understood by the average plan participant, which explains that the lifetime income stream equivalent is only provided as an illustration; explains that the actual payments under the lifetime income stream described in clause (i)(III) which may be purchased with the total benefits accrued will depend on numerous factors and may vary substantially from the lifetime income stream equivalent in the disclosures; explains the assumptions upon which the lifetime income stream equivalent was determined; and provides such other similar explanations as the Secretary considers appropriate.\",\"target_ids\":[],\"term_refs\":[\"urn:rulespec:document-understanding:term:e4efe53072124c231a7b7ca464c2dbb958115cf98cff1cb5e7f4aab70b5a81b1\"],\"typed_values\":[]}",

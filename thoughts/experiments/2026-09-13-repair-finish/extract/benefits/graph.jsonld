      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"the administrator\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:b2219e3889e6ef74020900939990c2300bc600b8d5df1dc36f06e4fa6a9b4dc9\",\"urn:rulespec:document-understanding:assertion:c37fea14523e7e053c41e7f1ca50e768fa51036dcaea5147f8a5b5d5d4068adf\",\"urn:rulespec:document-understanding:assertion:146e1f9c223c4aa57739f8112ac2feec9a9dc87856aff274f0e13145023daf31\",\"urn:rulespec:document-understanding:assertion:1c0105d4df419d06552aed83b67ed1c0c45b19a4ad48d377045ee06be747b6a7\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":8716,\"evidence\":[{\"end\":8716,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A9ede50be3469932d071153987e9d2b399c510cf2e3db7e8c7c8f05bf5e359184:8238:8716:sha256-cd539531e673564b640f81c8d82623ed7d1412cd85faa0172576ed82bbb2f409\",\"quote\":\"In the case of a defined benefit plan, the requirements of paragraph (1)(B)(i) shall be treated as met with respect to a participant if at least once each year the administrator provides to the participant notice of the availability of the pension benefit statement and the ways in which the participant may obtain such statement. Such notice may be delivered in written, electronic, or other appropriate form to the extent such form is reasonably accessible to the participant.\",\"start\":8238},{\"end\":8415,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A9ede50be3469932d071153987e9d2b399c510cf2e3db7e8c7c8f05bf5e359184:8398:8415:sha256-3633d78aa7189e068b91d56f057b35f3e372812fe5d41e3fcbe23ec5b5014c9b\",\"quote\":\"the administrator\",\"start\":8398}],\"id\":\"urn:rulespec:document-understanding:revision:286b5032f8c37addeeca92a52e6d75b495e683c34814ee80d052241365c08191\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"statement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:1c0105d4df419d06552aed83b67ed1c0c45b19a4ad48d377045ee06be747b6a7\",\"modality\":\"not_stated\",\"modality_quote\":\"\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:04ac4f5ced2ed3936f06a6d903efbf34116e4ac5d27d22219ac8d31ebee656e1\",\"origin\":\"aiSuggested\",\"quote\":\"In the case of a defined benefit plan, the requirements of paragraph (1)(B)(i) shall be treated as met with respect to a participant if at least once each year the administrator provides to the participant notice of the availability of the pension benefit statement and the ways in which the participant may obtain such statement. Such notice may be delivered in written, electronic, or other appropriate form to the extent such form is reasonably accessible to the participant.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:764eb1aac37d22b404c5a7e7cb2fb9383f1ab1b5889f0f88636c8f413726b1a3\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":8238,\"summary\":\"In the case of a defined benefit plan, the requirements of paragraph (1)(B)(i) shall be treated as met with respect to a participant if at least once each year the administrator provides to the participant notice of the availability of the pension benefit statement and the ways in which the participant may obtain such statement.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

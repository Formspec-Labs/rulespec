      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:d58480a1843679e95b565e192ecc7f3940d816604d1359268fd9c4a39b614438\",\"urn:rulespec:document-understanding:assertion:47de7a810f34405b759175941bccd2d567ef7a862142ea2d99bdd56c38430f52\",\"urn:rulespec:document-understanding:assertion:2e50a8f8f0819e32b6410a4f4abd81727a6e169af68c64b43533f7eb3aea52a2\",\"urn:rulespec:document-understanding:assertion:d089ae771b8f7e1a7246643d0dee4e44263b7398bd3b808f300d466dbc410b82\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":7316,\"evidence\":[{\"end\":7316,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A9ede50be3469932d071153987e9d2b399c510cf2e3db7e8c7c8f05bf5e359184:6723:7316:sha256-2ef036e247bbfd776c820ca4ffd2028f5024efe3af61ebc733addbb2535b80c9\",\"quote\":\"In prescribing assumptions under subclause (I), the Secretary may prescribe a single set of specific assumptions (in which case the Secretary may issue tables or factors which facilitate such conversions), or ranges of permissible assumptions. To the extent that an accrued benefit is or may be invested in a lifetime income stream described in clause (i)(III), the assumptions prescribed under subclause (I) shall, to the extent appropriate, permit administrators of individual account plans to use the amounts payable under such lifetime income stream as a lifetime income stream equivalent.\",\"start\":6723},{\"end\":7137,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A9ede50be3469932d071153987e9d2b399c510cf2e3db7e8c7c8f05bf5e359184:7132:7137:sha256-56ee5b508706bf2de91712d85d6d1e11ddbff01949142ed6e8c22e3b1bed1c71\",\"quote\":\"shall\",\"start\":7132}],\"id\":\"urn:rulespec:document-understanding:revision:0370b028dad4fc514c44034f7f8b3339177dff4de2cb102ee0db532ed35447bf\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:2e50a8f8f0819e32b6410a4f4abd81727a6e169af68c64b43533f7eb3aea52a2\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:ef21f24a2177edad75ac7a1317683a6e16ffd1898c160bbf35da242040e9371c\",\"origin\":\"aiSuggested\",\"quote\":\"In prescribing assumptions under subclause (I), the Secretary may prescribe a single set of specific assumptions (in which case the Secretary may issue tables or factors which facilitate such conversions), or ranges of permissible assumptions. To the extent that an accrued benefit is or may be invested in a lifetime income stream described in clause (i)(III), the assumptions prescribed under subclause (I) shall, to the extent appropriate, permit administrators of individual account plans to use the amounts payable under such lifetime income stream as a lifetime income stream equivalent.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:496e8d8af8be2118d7b35417f597164d2b463e38ef0976c0ec4cd389bae48f08\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":6723,\"summary\":\"To the extent that an accrued benefit is or may be invested in a lifetime income stream described in clause (i)(III), the assumptions prescribed under subclause (I) shall, to the extent appropriate, permit administrators of individual account plans to use the amounts payable under such lifetime income stream as a lifetime income stream equivalent.\",\"target_ids\":[],\"term_refs\":[\"urn:rulespec:document-understanding:term:e4efe53072124c231a7b7ca464c2dbb958115cf98cff1cb5e7f4aab70b5a81b1\"],\"typed_values\":[]}",

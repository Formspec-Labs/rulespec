    {
      "@id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A9ede50be3469932d071153987e9d2b399c510cf2e3db7e8c7c8f05bf5e359184:6723:7316:sha256-2ef036e247bbfd776c820ca4ffd2028f5024efe3af61ebc733addbb2535b80c9",

      "@id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A9ede50be3469932d071153987e9d2b399c510cf2e3db7e8c7c8f05bf5e359184:2865:3696:sha256-0a427696d0179f48c323b57c838f1ef9a6546952f8bc8a01ea06a45a3d8d8136",
      "@type": "rkaf:SourceFragment",
      "oa:hasSource": "urn:rulespec:document-understanding:document:9ede50be3469932d071153987e9d2b399c510cf2e3db7e8c7c8f05bf5e359184",
      "rkaf:fragmentIdentityScheme": "rkaf:carrier-local-fragment",

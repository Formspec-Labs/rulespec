      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:e5ce0dc9cdada13dddbe1a5c9da84467a2ec6c3f5d3376d1020c58482f95bcee\",\"urn:rulespec:document-understanding:assertion:f0a2d6d4e04ef073dc5dd13bbe595349c02894153b67436d1181f4a46c947813\",\"urn:rulespec:document-understanding:assertion:3d051829f5b45f11a0d754a8ac867985fa31705187a9a89371904d139d182699\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":3623,\"evidence\":[{\"end\":2260,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A9ede50be3469932d071153987e9d2b399c510cf2e3db7e8c7c8f05bf5e359184:2234:2260:sha256-c9114cd95eb86732e4387ff726d211b0f83bfc21d7f2031ed210dc84ce266fcd\",\"quote\":\"(B) Additional information\",\"start\":2234},{\"end\":2393,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A9ede50be3469932d071153987e9d2b399c510cf2e3db7e8c7c8f05bf5e359184:2261:2393:sha256-6aaa0a7d1d50471d2133f1d9535304b883275e7d4261e51d50f3a421a8c1afa3\",\"quote\":\"In the case of an individual account plan, any pension benefit statement under clause (i) or (ii) of paragraph (1)(A) shall include—\",\"start\":2261},{\"end\":2863,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A9ede50be3469932d071153987e9d2b399c510cf2e3db7e8c7c8f05bf5e359184:2395:2863:sha256-37fe89ec400eeca06d2c6474f9de39959baaa8fd605daa3ae73d22dce6cb8529\",\"quote\":\"(i) the value of each investment to which assets in the individual account have been allocated, determined as of the most recent valuation date under the plan, including the value of any assets held in the form of employer securities, without regard to whether such securities were contributed by the plan sponsor or acquired at the direction of the plan or of the participant or beneficiary,\\n\\n(ii) in the case of a pension benefit statement under paragraph (1)(A)(i)—\",\"start\":2395},{\"end\":3623,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A9ede50be3469932d071153987e9d2b399c510cf2e3db7e8c7c8f05bf5e359184:2865:3623:sha256-d9a0b6101efd444984ef7fc9057d901083d9e4236b110bf40c9dfe30d080ca5a\",\"quote\":\"(I) an explanation of any limitations or restrictions on any right of the participant or beneficiary under the plan to direct an investment,\\n\\n(II) an explanation, written in a manner calculated to be understood by the average plan participant, of the importance, for the long-term retirement security of participants and beneficiaries, of a well-balanced and diversified investment portfolio, including a statement of the risk that holding more than 20 percent of a portfolio in the security of one entity (such as employer securities) may not be adequately diversified, and\\n\\n(III) a notice directing the participant or beneficiary to the Internet website of the Department of Labor for sources of information on individual investing and diversification, and\",\"start\":2865},{\"end\":2384,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A9ede50be3469932d071153987e9d2b399c510cf2e3db7e8c7c8f05bf5e359184:2379:2384:sha256-56ee5b508706bf2de91712d85d6d1e11ddbff01949142ed6e8c22e3b1bed1c71\",\"quote\":\"shall\",\"start\":2379}],\"id\":\"urn:rulespec:document-understanding:revision:3423fa850f713c0aeab6ac6bc4d14b715e12795629c95bcef500ca0669cc929a\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:3d051829f5b45f11a0d754a8ac867985fa31705187a9a89371904d139d182699\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:0a37367e5b54bc30e479b89f8616751e93b17e5e3bd868f5097a1f803a4291ee\",\"origin\":\"aiSuggested\",\"quote\":\"(B) Additional information In the case of an individual account plan, any pension benefit statement under clause (i) or (ii) of paragraph (1)(A) shall include—\\n\\n(i) the value of each investment to which assets in the individual account have been allocated, determined as of the most recent valuation date under the plan, including the value of any assets held in the form of employer securities, without regard to whether such securities were contributed by the plan sponsor or acquired at the direction of the plan or of the participant or beneficiary,\\n\\n(ii) in the case of a pension benefit statement under paragraph (1)(A)(i)—\\n\\n(I) an explanation of any limitations or restrictions on any right of the participant or beneficiary under the plan to direct an investment,\\n\\n(II) an explanation, written in a manner calculated to be understood by the average plan participant, of the importance, for the long-term retirement security of participants and beneficiaries, of a well-balanced and diversified investment portfolio, including a statement of the risk that holding more than 20 percent of a portfolio in the security of one entity (such as employer securities) may not be adequately diversified, and\\n\\n(III) a notice directing the participant or beneficiary to the Internet website of the Department of Labor for sources of information on individual investing and diversification, and\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:6f51bd2c6df1de24507fc2140a0e7f3216381fa23844a8d4c3b1b78cf89fe6c2\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":2234,\"summary\":\"In the case of an individual account plan, a pension benefit statement under paragraph (1)(A)(i) shall include a notice directing the participant or beneficiary to the Internet website of the Department of Labor for sources of information on individual investing and diversification.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

      "dcterms:description": "{\"action\":\"\",\"actor\":\"covered entity\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:a83a19ab8db60c55fe75d27187b19239af5fb3b34cdc62e8f7145c2d9aaf1aa6\",\"urn:rulespec:document-understanding:assertion:129ba8d3e9d0f97be92a218e340843920a9b471dfaeed424bf20182465e25207\",\"urn:rulespec:document-understanding:assertion:41e4512152cb8fc606c6144d84d8013fcd3859d1f9514f80819cea0a8fd40139\",\"urn:rulespec:document-understanding:assertion:7c7445bd247610061396a562ee9ec4070b27bc7c0ecba8caaaa09b75124e9884\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":623,\"evidence\":[{\"end\":623,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ae0a849ced4fec0fafda8c2c02caa4c9e643b468e169d9af809eb0e87700e0a78:336:623:sha256-a40cdadc4e83b11b7d6a18598a8f603228a09fac0973fbd3c452fb98b48f0845\",\"quote\":\"(B) denying employment opportunities to a job applicant or employee who is an otherwise qualified individual with a disability, if such denial is based on the need of such covered entity to make reasonable accommodation to the physical or mental impairments of the employee or applicant;\",\"start\":336},{\"end\":522,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ae0a849ced4fec0fafda8c2c02caa4c9e643b468e169d9af809eb0e87700e0a78:508:522:sha256-31eb3c8ffdf61a7b6012b92fe3bd352d6fb9f006761dc242f79592bbf8fab31b\",\"quote\":\"covered entity\",\"start\":508}],\"id\":\"urn:rulespec:document-understanding:revision:78258dcabf96d15f1400ecdc76dcabaab368fd1bf2ee2a2332595194b71437dd\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"prohibition\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:7c7445bd247610061396a562ee9ec4070b27bc7c0ecba8caaaa09b75124e9884\",\"modality\":\"must_not\",\"modality_quote\":\"\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:104eb6de38597db2009269ecc04ed18586d00834dd84e779807fa35fac58839f\",\"origin\":\"aiSuggested\",\"quote\":\"(B) denying employment opportunities to a job applicant or employee who is an otherwise qualified individual with a disability, if such denial is based on the need of such covered entity to make reasonable accommodation to the physical or mental impairments of the employee or applicant;\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:0b3ac8c1420d1cec81f683a5a6048cbbbc3fe19a6374f6ec22991d7d893f1128\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":336,\"summary\":\"A covered entity must not deny employment opportunities to a job applicant or employee who is an otherwise qualified individual with a disability, if such denial is based on the need of the covered entity to make reasonable accommodation to the physical or mental impairments of the employee or applicant.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

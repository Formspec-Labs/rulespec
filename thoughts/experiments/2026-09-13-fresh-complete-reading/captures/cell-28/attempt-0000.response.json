            "text": "{\n  \"judgments\": [\n    {\n      \"proposal_id\": \"P0001\",\n      \"source_refs\": [\"F003\"],\n      \"rationale\": \"The proposed summary claims the employer must permit use 'immediately after the request, even if the use of the compensatory time unduly disrupts the operations of the public agency.' This directly contradicts the source, which specifies permission is required 'within a reasonable period after making the request if the use of the compensatory time does not unduly disrupt the operations of the public agency.'\",\n      \"verdict\": \"unsupported\"\n    },\n    {\n      \"proposal_id\": \"P0002\",\n      \"source_refs\": [\"F000:F003\"],\n      \"rationale\": \"The proposed change accurately populates the missing action ('permit use of compensatory time') and corresponding action quote ('shall be permitted by the employee’s employer to use such time') directly from the source text, correctly capturing the duty owed by the employer while preserving all existing scopes, conditions, and modalities.\",\n      \"verdict\": \"supported\"\n    }\n  ]\n}",

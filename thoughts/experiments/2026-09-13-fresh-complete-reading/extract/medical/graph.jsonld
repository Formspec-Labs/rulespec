      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:474ae3ed0b48a62ab357902399ceb68d643926fe25b73b4e43a0436387ec5008\",\"urn:rulespec:document-understanding:assertion:14f844a053b34a6fc6c7e0fe2b52b560778421c3daebb06c6acf57fdf46d6405\",\"urn:rulespec:document-understanding:assertion:e81b61320fb5c6d47f5bfa34d2830c27c32aadd4e983806309186f2096c30663\",\"urn:rulespec:document-understanding:assertion:5bfa7a44ef27c586136af66b5032ad8cbe17005d75802bc38ac0c3a07c2f4988\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":894,\"evidence\":[{\"end\":894,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A79b30028ceea03c92b6b4dcdaef82c165c9a67eace293da9bac49b1f5939728e:767:894:sha256-e24569e5bde1990f0dce0bec4e9bce2f479e1fe4314884fbdebdaf8e3a3bce88\",\"quote\":\"(ii) first aid and safety personnel may be informed, when appropriate, if the disability might require emergency treatment; and\",\"start\":767},{\"end\":806,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A79b30028ceea03c92b6b4dcdaef82c165c9a67eace293da9bac49b1f5939728e:803:806:sha256-ee4d988c65de860fabbfbcd27f73d50bbebe3fba37fe419284f4811389c30bdc\",\"quote\":\"may\",\"start\":803},{\"end\":35,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A79b30028ceea03c92b6b4dcdaef82c165c9a67eace293da9bac49b1f5939728e:0:35:sha256-7f5a34ab6c39c8e4ff7c85378a5741a2936eddeb2365b9181a5915bb16cfc450\",\"quote\":\"(3) Employment entrance examination\",\"start\":0},{\"end\":303,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A79b30028ceea03c92b6b4dcdaef82c165c9a67eace293da9bac49b1f5939728e:36:303:sha256-bc288f73a98ee8f2abef7644b57dbe65835ca17973fa3d2157edf87e2516289e\",\"quote\":\"A covered entity may require a medical examination after an offer of employment has been made to a job applicant and prior to the commencement of the employment duties of such applicant, and may condition an offer of employment on the results of such examination, if—\",\"start\":36},{\"end\":618,\"field\":\"scope_text:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A79b30028ceea03c92b6b4dcdaef82c165c9a67eace293da9bac49b1f5939728e:396:618:sha256-45df258053f7bf0a5ed5e4484073a2d1d040488b45f77bdf31e8a1ea30a929e9\",\"quote\":\"(B) information obtained regarding the medical condition or history of the applicant is collected and maintained on separate forms and in separate medical files and is treated as a confidential medical record, except that—\",\"start\":396}],\"id\":\"urn:rulespec:document-understanding:revision:4a6e7ba470fface2cca1c1340a6ed5ac8d08c6ebde0d116b8077ad4bb62e512c\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"permission\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:5bfa7a44ef27c586136af66b5032ad8cbe17005d75802bc38ac0c3a07c2f4988\",\"modality\":\"may\",\"modality_quote\":\"may\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:b9465daa38ba58d9c4960c4c0f292d47857d6ad2712505ecb0e1e97df2ef0813\",\"origin\":\"aiSuggested\",\"quote\":\"(ii) first aid and safety personnel may be informed, when appropriate, if the disability might require emergency treatment; and\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:fab6f9d2ccd3526bbe68266f968ecd84486b9c0e4b0f152d035a72579a91f4f9\",\"scope_quotes\":[\"(3) Employment entrance examination A covered entity may require a medical examination after an offer of employment has been made to a job applicant and prior to the commencement of the employment duties of such applicant, and may condition an offer of employment on the results of such examination, if—\",\"(B) information obtained regarding the medical condition or history of the applicant is collected and maintained on separate forms and in separate medical files and is treated as a confidential medical record, except that—\"],\"scope_text\":\"Regarding information obtained regarding the medical condition or history of the applicant collected and maintained on separate forms and in separate medical files and treated as a confidential medical record under an employment entrance examination, when appropriate, if the disability might require emergency treatment.\",\"section_id\":\"section-1\",\"start\":767,\"summary\":\"As an exception to the requirement that information obtained regarding the medical condition or history of an applicant from an employment entrance examination be treated as a confidential medical record, first aid and safety personnel may be informed, when appropriate, if the disability might require emergency treatment.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

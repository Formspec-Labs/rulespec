      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:525562d50fb70c8e0378becd6138f542dfade86242d344e961e6f3d1dccd9215\",\"urn:rulespec:document-understanding:assertion:65326921842b91eddefbe0eed40f7f8921a22607f8d7948e7bb6c8988b268f04\",\"urn:rulespec:document-understanding:assertion:ad0d8cf2eb8b9ae06b5c3dd9e6fa3b94085a314cd182f4504849d60b459ad504\",\"urn:rulespec:document-understanding:assertion:4fe6179180c2d8348d4899f1c5e2f9f405250710c49ff9753439ff99d01b5e3f\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":1020,\"evidence\":[{\"end\":1020,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A79b30028ceea03c92b6b4dcdaef82c165c9a67eace293da9bac49b1f5939728e:896:1020:sha256-3443ba23e6bcdd7f1368bb2b735290a9a2760c2fd70cb3ff170c3b63bfb031fc\",\"quote\":\"(iii) government officials investigating compliance with this chapter shall be provided relevant information on request; and\",\"start\":896},{\"end\":971,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A79b30028ceea03c92b6b4dcdaef82c165c9a67eace293da9bac49b1f5939728e:966:971:sha256-56ee5b508706bf2de91712d85d6d1e11ddbff01949142ed6e8c22e3b1bed1c71\",\"quote\":\"shall\",\"start\":966},{\"end\":35,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A79b30028ceea03c92b6b4dcdaef82c165c9a67eace293da9bac49b1f5939728e:0:35:sha256-7f5a34ab6c39c8e4ff7c85378a5741a2936eddeb2365b9181a5915bb16cfc450\",\"quote\":\"(3) Employment entrance examination\",\"start\":0},{\"end\":303,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A79b30028ceea03c92b6b4dcdaef82c165c9a67eace293da9bac49b1f5939728e:36:303:sha256-bc288f73a98ee8f2abef7644b57dbe65835ca17973fa3d2157edf87e2516289e\",\"quote\":\"A covered entity may require a medical examination after an offer of employment has been made to a job applicant and prior to the commencement of the employment duties of such applicant, and may condition an offer of employment on the results of such examination, if—\",\"start\":36},{\"end\":618,\"field\":\"scope_text:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A79b30028ceea03c92b6b4dcdaef82c165c9a67eace293da9bac49b1f5939728e:396:618:sha256-45df258053f7bf0a5ed5e4484073a2d1d040488b45f77bdf31e8a1ea30a929e9\",\"quote\":\"(B) information obtained regarding the medical condition or history of the applicant is collected and maintained on separate forms and in separate medical files and is treated as a confidential medical record, except that—\",\"start\":396}],\"id\":\"urn:rulespec:document-understanding:revision:dab1b3ac3713e3b57305ea167846bce2f0c53cbefd2669f6cbb0841ae09b4c7b\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:4fe6179180c2d8348d4899f1c5e2f9f405250710c49ff9753439ff99d01b5e3f\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:c19e7009226b221a4b2b211f690948121089b486d34cf660abc6b2016e441220\",\"origin\":\"aiSuggested\",\"quote\":\"(iii) government officials investigating compliance with this chapter shall be provided relevant information on request; and\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:fc759c535321e425040556456bf6041b00f68d4179f8452edf190f1f21b60a32\",\"scope_quotes\":[\"(3) Employment entrance examination A covered entity may require a medical examination after an offer of employment has been made to a job applicant and prior to the commencement of the employment duties of such applicant, and may condition an offer of employment on the results of such examination, if—\",\"(B) information obtained regarding the medical condition or history of the applicant is collected and maintained on separate forms and in separate medical files and is treated as a confidential medical record, except that—\"],\"scope_text\":\"Regarding information obtained regarding the medical condition or history of an applicant from an employment entrance examination, on request by government officials investigating compliance with this chapter.\",\"section_id\":\"section-1\",\"start\":896,\"summary\":\"In connection with employment entrance examination medical records, government officials investigating compliance with this chapter shall be provided relevant information on request.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:a81a5e9e653ce222b6b3453ffc6ed497eb92389ed2ac7d5c9d585e246a9bad1d\",\"urn:rulespec:document-understanding:assertion:a80421c994637ccadb2724ee6b4944d789bf4c553e18c62cb4a2c5b4f582d9a3\",\"urn:rulespec:document-understanding:assertion:07c5b7fcd16ad981db2285306fddadbd4819cb772d758eb30dad4bb6191305a0\",\"urn:rulespec:document-understanding:assertion:bd92ea65476180eb31d16d627f666ec66b8fa0688ce068437c8cfc7061c8c1f5\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":765,\"evidence\":[{\"end\":765,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A79b30028ceea03c92b6b4dcdaef82c165c9a67eace293da9bac49b1f5939728e:620:765:sha256-41e5d9bab6a2eda6c343a238bdb3cd21e0a0c7ca80e1d4709973f7c462e8813f\",\"quote\":\"(i) supervisors and managers may be informed regarding necessary restrictions on the work or duties of the employee and necessary accommodations;\",\"start\":620},{\"end\":652,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A79b30028ceea03c92b6b4dcdaef82c165c9a67eace293da9bac49b1f5939728e:649:652:sha256-ee4d988c65de860fabbfbcd27f73d50bbebe3fba37fe419284f4811389c30bdc\",\"quote\":\"may\",\"start\":649},{\"end\":35,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A79b30028ceea03c92b6b4dcdaef82c165c9a67eace293da9bac49b1f5939728e:0:35:sha256-7f5a34ab6c39c8e4ff7c85378a5741a2936eddeb2365b9181a5915bb16cfc450\",\"quote\":\"(3) Employment entrance examination\",\"start\":0},{\"end\":303,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A79b30028ceea03c92b6b4dcdaef82c165c9a67eace293da9bac49b1f5939728e:36:303:sha256-bc288f73a98ee8f2abef7644b57dbe65835ca17973fa3d2157edf87e2516289e\",\"quote\":\"A covered entity may require a medical examination after an offer of employment has been made to a job applicant and prior to the commencement of the employment duties of such applicant, and may condition an offer of employment on the results of such examination, if—\",\"start\":36},{\"end\":618,\"field\":\"scope_text:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A79b30028ceea03c92b6b4dcdaef82c165c9a67eace293da9bac49b1f5939728e:396:618:sha256-45df258053f7bf0a5ed5e4484073a2d1d040488b45f77bdf31e8a1ea30a929e9\",\"quote\":\"(B) information obtained regarding the medical condition or history of the applicant is collected and maintained on separate forms and in separate medical files and is treated as a confidential medical record, except that—\",\"start\":396}],\"id\":\"urn:rulespec:document-understanding:revision:dfedd961171d5814718259c809e7d5fb4da670ba7a4ed097c87ff7238cb613b1\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"permission\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:bd92ea65476180eb31d16d627f666ec66b8fa0688ce068437c8cfc7061c8c1f5\",\"modality\":\"may\",\"modality_quote\":\"may\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:3a1c103f503b038e3def78081114bf15c040b0881e7de7e8728079ee4eeab7ad\",\"origin\":\"aiSuggested\",\"quote\":\"(i) supervisors and managers may be informed regarding necessary restrictions on the work or duties of the employee and necessary accommodations;\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:950a4ea3232de3b1b7cfe5cb6f627f37a8045e670b456bbc91531e1ecf1ed702\",\"scope_quotes\":[\"(3) Employment entrance examination A covered entity may require a medical examination after an offer of employment has been made to a job applicant and prior to the commencement of the employment duties of such applicant, and may condition an offer of employment on the results of such examination, if—\",\"(B) information obtained regarding the medical condition or history of the applicant is collected and maintained on separate forms and in separate medical files and is treated as a confidential medical record, except that—\"],\"scope_text\":\"Regarding information obtained regarding the medical condition or history of the applicant collected and maintained on separate forms and in separate medical files and treated as a confidential medical record under an employment entrance examination.\",\"section_id\":\"section-1\",\"start\":620,\"summary\":\"As an exception to the requirement that information obtained regarding the medical condition or history of an applicant from an employment entrance examination be treated as a confidential medical record, supervisors and managers may be informed regarding necessary restrictions on the work or duties of the employee and necessary accommodations.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

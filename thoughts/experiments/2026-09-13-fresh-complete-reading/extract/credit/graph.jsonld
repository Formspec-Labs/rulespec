      "dcterms:description": "{\"action\":\"\",\"actor\":\"the Bureau\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:1f43ffe6d38b2e7062c73ecc1f8c0390489507616213ad094c0d681158dfc73c\",\"urn:rulespec:document-understanding:assertion:6f7ea2d6092af89ec8ed2a78d4c48174f16e3eb0bcdd2e097cc3774af180ecd9\",\"urn:rulespec:document-understanding:assertion:67fb172d2596a30a60c03837c520286946101ae63f9a32402b1fd8ce340892b0\",\"urn:rulespec:document-understanding:assertion:935b07df0e586dde1d70fac1a657c3a2a5a438cabd6b814500921e866eaaf0ff\",\"urn:rulespec:document-understanding:assertion:35a2df2a6555eaff53236dfcb79d86f1012843a76b1ad9a5753b757d0e33582e\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":1768,\"evidence\":[{\"end\":1228,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A395113d85f7dcb5ba26b32524872c0fe7ffcf7a39ab1a26fb122e2c612cfcd0d:1209:1228:sha256-d65fffab8784a97183b4f51b7d854133d939055d9c7b65df71288f2185b30dcb\",\"quote\":\"(ii) Considerations\",\"start\":1209},{\"end\":1300,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A395113d85f7dcb5ba26b32524872c0fe7ffcf7a39ab1a26fb122e2c612cfcd0d:1229:1300:sha256-e2872d0b4f55ec90d4cb99665deac3d3f7780e8a0f524d2c0592b38e1ed20973\",\"quote\":\"In prescribing regulations under clause (i), the Bureau shall consider—\",\"start\":1229},{\"end\":1768,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A395113d85f7dcb5ba26b32524872c0fe7ffcf7a39ab1a26fb122e2c612cfcd0d:1302:1768:sha256-99aaed732668505a865ad9116dfb8951151a77fd65888474feb9f162e57e253a\",\"quote\":\"(I) the significant demands that may be placed on consumer reporting agencies in providing such consumer reports;\\n\\n(II) appropriate means to ensure that consumer reporting agencies can satisfactorily meet those demands, including the efficacy of a system of staggering the availability to consumers of such consumer reports; and\\n\\n(III) the ease by which consumers should be able to contact consumer reporting agencies with respect to access to such consumer reports.\",\"start\":1302},{\"end\":1284,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A395113d85f7dcb5ba26b32524872c0fe7ffcf7a39ab1a26fb122e2c612cfcd0d:1274:1284:sha256-dd26af8eba72b2c41b0600f1af764ff94264aa78edde52a3bba10430409dc095\",\"quote\":\"the Bureau\",\"start\":1274},{\"end\":1290,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A395113d85f7dcb5ba26b32524872c0fe7ffcf7a39ab1a26fb122e2c612cfcd0d:1285:1290:sha256-56ee5b508706bf2de91712d85d6d1e11ddbff01949142ed6e8c22e3b1bed1c71\",\"quote\":\"shall\",\"start\":1285},{\"end\":1228,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A395113d85f7dcb5ba26b32524872c0fe7ffcf7a39ab1a26fb122e2c612cfcd0d:1209:1228:sha256-d65fffab8784a97183b4f51b7d854133d939055d9c7b65df71288f2185b30dcb\",\"quote\":\"(ii) Considerations\",\"start\":1209},{\"end\":1300,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A395113d85f7dcb5ba26b32524872c0fe7ffcf7a39ab1a26fb122e2c612cfcd0d:1229:1300:sha256-e2872d0b4f55ec90d4cb99665deac3d3f7780e8a0f524d2c0592b38e1ed20973\",\"quote\":\"In prescribing regulations under clause (i), the Bureau shall consider—\",\"start\":1229}],\"id\":\"urn:rulespec:document-understanding:revision:f7030f7e0c5841e62e7fd1e1f77fd0806b396f14a4f2e0f4bf16f6588e83bdee\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:35a2df2a6555eaff53236dfcb79d86f1012843a76b1ad9a5753b757d0e33582e\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:b8cc518bda787639e6e16d215a34cefe8474aed9bdbe3a407c1cda1af2609e9e\",\"origin\":\"aiSuggested\",\"quote\":\"(ii) Considerations In prescribing regulations under clause (i), the Bureau shall consider—\\n\\n(I) the significant demands that may be placed on consumer reporting agencies in providing such consumer reports;\\n\\n(II) appropriate means to ensure that consumer reporting agencies can satisfactorily meet those demands, including the efficacy of a system of staggering the availability to consumers of such consumer reports; and\\n\\n(III) the ease by which consumers should be able to contact consumer reporting agencies with respect to access to such consumer reports.\",\"references\":[\"clause (i)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:dc1586009a5604e632d86a081ec6572eee28079627d0ba36254d44606d4821f3\",\"scope_quotes\":[\"(ii) Considerations In prescribing regulations under clause (i), the Bureau shall consider—\"],\"scope_text\":\"In prescribing regulations under clause (i)\",\"section_id\":\"section-1\",\"start\":1209,\"summary\":\"In prescribing regulations under clause (i), the Bureau shall consider: (I) the significant demands that may be placed on consumer reporting agencies in providing such consumer reports; (II) appropriate means to ensure that consumer reporting agencies can satisfactorily meet those demands, including the efficacy of a system of staggering the availability to consumers of such consumer reports; and (III) the ease by which consumers should be able to contact consumer reporting agencies with respect to access to such consumer reports.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

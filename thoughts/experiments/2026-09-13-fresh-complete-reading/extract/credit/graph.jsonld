      "rkaf:assertsValue": {
        "@value": "{\"actor\":\"the Bureau\",\"kind\":\"requirement\",\"modality\":\"must\",\"scope_text\":\"In prescribing regulations under clause (i)\",\"summary\":\"In prescribing regulations under clause (i), the Bureau shall consider: (I) the significant demands that may be placed on consumer reporting agencies in providing such consumer reports; (II) appropriate means to ensure that consumer reporting agencies can satisfactorily meet those demands, including the efficacy of a system of staggering the availability to consumers of such consumer reports; and (III) the ease by which consumers should be able to contact consumer reporting agencies with respect to access to such consumer reports.\"}",
        "@type": "xsd:string"
      },

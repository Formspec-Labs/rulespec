      "dcterms:description": "{\"action\":\"\",\"actor\":\"the Bureau\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:7f0f21f1c26254fc1e56bca6329df83fd4a897d306cc8adae2b41ea667761eaa\",\"urn:rulespec:document-understanding:assertion:512e6ab295e96113db774ef22602b68f5671ed1f1293ccbba89167e4002a642d\",\"urn:rulespec:document-understanding:assertion:f3eff38703619835a218937fc0b4d8cd1ce18de8080974087ad7138cc4efc63c\",\"urn:rulespec:document-understanding:assertion:9be53daa6c2f7f27dd058cfe7e34da2c14cc255cc7af5c6dc60ee65163ef117c\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":2588,\"evidence\":[{\"end\":1973,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A395113d85f7dcb5ba26b32524872c0fe7ffcf7a39ab1a26fb122e2c612cfcd0d:1934:1973:sha256-866066b9936d3b76109253c94890f97795c1de295bee07fe5046e6e7e1746be2\",\"quote\":\"(iv) Consideration of ability to comply\",\"start\":1934},{\"end\":2242,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A395113d85f7dcb5ba26b32524872c0fe7ffcf7a39ab1a26fb122e2c612cfcd0d:1974:2242:sha256-2353f681689ccaa76ca7600f35b9fcaa43358e975d62d8452274bb181cef2042\",\"quote\":\"The regulations of the Bureau under this subparagraph shall establish an effective date by which each nationwide specialty consumer reporting agency (as defined in section 1681a(w) 1 of this title) shall be required to comply with subsection (a), which effective date—\",\"start\":1974},{\"end\":2588,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A395113d85f7dcb5ba26b32524872c0fe7ffcf7a39ab1a26fb122e2c612cfcd0d:2244:2588:sha256-1c726b5bfe2a61ea9ea9d9f00e6af2486cfb4f9733901cce8c002ad9c18d632f\",\"quote\":\"(I) shall be established after consideration of the ability of each nationwide specialty consumer reporting agency to comply with subsection (a); and\\n\\n(II) shall be not later than 6 months after the date on which such regulations are issued in final form (or such additional period not to exceed 3 months, as the Bureau determines appropriate).\",\"start\":2244}],\"id\":\"urn:rulespec:document-understanding:revision:9f481ef1a6f77b1346e7644902ca0c16dee265b602ebc6fda760ee15b29ba681\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:9be53daa6c2f7f27dd058cfe7e34da2c14cc255cc7af5c6dc60ee65163ef117c\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:5b6f6e184d02034ca50d56a4f47472ae25dd627ef1535ec17856b5cbc342e6cb\",\"origin\":\"aiSuggested\",\"quote\":\"(iv) Consideration of ability to comply The regulations of the Bureau under this subparagraph shall establish an effective date by which each nationwide specialty consumer reporting agency (as defined in section 1681a(w) 1 of this title) shall be required to comply with subsection (a), which effective date—\\n\\n(I) shall be established after consideration of the ability of each nationwide specialty consumer reporting agency to comply with subsection (a); and\\n\\n(II) shall be not later than 6 months after the date on which such regulations are issued in final form (or such additional period not to exceed 3 months, as the Bureau determines appropriate).\",\"references\":[\"section 1681a(w)\",\"subsection (a)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:10799231c9840eae3ce05460ae385deb6e339b15b9f2420cd7e713bb6b26caae\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":1934,\"summary\":\"The regulations of the Bureau under this subparagraph shall establish an effective date by which each nationwide specialty consumer reporting agency (as defined in section 1681a(w) of this title) shall be required to comply with subsection (a), which effective date shall be established after consideration of the ability of each nationwide specialty consumer reporting agency to comply with subsection (a), and shall be not later than 6 months after the date on which such regulations are issued in final form (or such additional period not to exceed 3 months, as the Bureau determines appropriate).\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"The Commission\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:63f26129d54c901c1495488276ddf2d5844def961d5180dfe0432435c1d65765\",\"urn:rulespec:document-understanding:assertion:61322889059aaefe693c120bb607e040d3a114862d9faa66c19f1d12d63e8aba\",\"urn:rulespec:document-understanding:assertion:d12af525508daba721ede2b5b8223a458b713a00b6ba4d17326618076690bd86\",\"urn:rulespec:document-understanding:assertion:9671cc001dee083a1601fd7e20ee0f8f921820a868177bccc08963fdb9cb0178\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":1206,\"evidence\":[{\"end\":793,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A395113d85f7dcb5ba26b32524872c0fe7ffcf7a39ab1a26fb122e2c612cfcd0d:777:793:sha256-412481e3010a4111de07d786fe05c39d1c149f87847bb9a40c0aa59d3de4cab7\",\"quote\":\"The Commission 2\",\"start\":777},{\"end\":841,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A395113d85f7dcb5ba26b32524872c0fe7ffcf7a39ab1a26fb122e2c612cfcd0d:795:841:sha256-4f8766e97e5fcc67f402234ac3513f77d2f728a2ae8a4abde8a5158f2d3cdc53\",\"quote\":\"2 So in original. Probably should be “Bureau”.\",\"start\":795},{\"end\":1206,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A395113d85f7dcb5ba26b32524872c0fe7ffcf7a39ab1a26fb122e2c612cfcd0d:843:1206:sha256-d4a78aca843929ae6edb39b4bab83eecd4e6ebaacc16a20a601a129aae2c0766\",\"quote\":\" shall prescribe regulations applicable to each consumer reporting agency described in section 1681a(w) 1 of this title to require the establishment of a streamlined process for consumers to request consumer reports under subparagraph (A), which shall include, at a minimum, the establishment by each such agency of a toll-free telephone number for such requests.\",\"start\":843},{\"end\":791,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A395113d85f7dcb5ba26b32524872c0fe7ffcf7a39ab1a26fb122e2c612cfcd0d:777:791:sha256-c31717b8ac6a47dd98c168167fec5076fd9bf46af8c0a63ebb1881fdd63b9d3a\",\"quote\":\"The Commission\",\"start\":777}],\"id\":\"urn:rulespec:document-understanding:revision:f37f23559d0090a1fe35d4942cc08b116c4e695767e9694e9713550c806299cc\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:9671cc001dee083a1601fd7e20ee0f8f921820a868177bccc08963fdb9cb0178\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:7aa4c2563f9f2a6bfea9900c556c2097f7e39dd46c85975e693f86df42beb7f8\",\"origin\":\"aiSuggested\",\"quote\":\"The Commission 2\\n\\n2 So in original. Probably should be “Bureau”.\\n\\n shall prescribe regulations applicable to each consumer reporting agency described in section 1681a(w) 1 of this title to require the establishment of a streamlined process for consumers to request consumer reports under subparagraph (A), which shall include, at a minimum, the establishment by each such agency of a toll-free telephone number for such requests.\",\"references\":[\"section 1681a(w)\",\"subparagraph (A)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:89bbabf680bfc35c383c798abf7bc920912511850740ca9d8fb468bd2980ad99\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":777,\"summary\":\"The Commission shall prescribe regulations applicable to each consumer reporting agency described in section 1681a(w) of this title to require the establishment of a streamlined process for consumers to request consumer reports under subparagraph (A), which shall include, at a minimum, the establishment by each such agency of a toll-free telephone number for such requests.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

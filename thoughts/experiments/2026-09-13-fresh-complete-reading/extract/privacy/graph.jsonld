      ],
      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "(4) in any disclosure, containing information about which the individual has filed a statement of disagreement, occurring after the filing of the statement under paragraph (3) of this subsection, clearly note any portion of the record which is disputed and provide copies of the statement and, if the agency deems it appropriate, copies of a concise statement of the reasons of the agency for not making the amendments requested, to persons or other agencies to whom the disputed record has been disclosed; and"
        },
        {
          "@type": "oa:TextPositionSelector",
          "oa:start": 2147,
          "oa:end": 2657,
          "rkaf:coordinateSystem": "rkaf:unicode-codepoint"
        }

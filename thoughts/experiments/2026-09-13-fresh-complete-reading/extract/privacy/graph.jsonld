      "dcterms:description": "{\"action\":\"\",\"actor\":\"Each agency that maintains a system of rec­ords\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:122d861c318dccf755caa700456355326b6ed61a96994338f39690f1dc6c893f\",\"urn:rulespec:document-understanding:assertion:8844fd8218c68b4dd06695a8a0c4fbecb4fc24e746ce0bde7c66276abbd97132\",\"urn:rulespec:document-understanding:assertion:a7148b5ddc811f9e40634a8de621f9a908d1d66ea2ac5f2321fd20efa7de6f32\",\"urn:rulespec:document-understanding:assertion:28dc24ccbf439f521bf11163ffd2b142a6be44bc227f9ca72376f5b0ddc83ee8\",\"urn:rulespec:document-understanding:assertion:913b2ed2791dab23dbb6f901186434390e8b355c0c76c20427e37a1c8e4b1b07\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":573,\"evidence\":[{\"end\":573,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ad4abf44590787c42436feaddb79749e29d10fc3d1ce979a6e33711f8bae64c3a:80:573:sha256-6badc1ade31284dc26f306db1e2c95d0990702aa28cd68d8a2eb8cad12b703b9\",\"quote\":\"(1) upon request by any individual to gain access to his record or to any information pertaining to him which is contained in the system, permit him and upon his request, a person of his own choosing to accompany him, to review the record and have a copy made of all or any portion thereof in a form comprehensible to him, except that the agency may require the individual to furnish a written statement authorizing discussion of that individual’s record in the accompanying person’s presence;\",\"start\":80},{\"end\":71,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ad4abf44590787c42436feaddb79749e29d10fc3d1ce979a6e33711f8bae64c3a:24:71:sha256-3e64e82e80cb053bce05493b1594948057e6e563c0f294d70a93f7ce452bf700\",\"quote\":\"Each agency that maintains a system of rec­ords\",\"start\":24},{\"end\":23,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ad4abf44590787c42436feaddb79749e29d10fc3d1ce979a6e33711f8bae64c3a:0:23:sha256-f1c254da239bf0323adf0a1a661152495a2eb850c73528193941a6302cbf4509\",\"quote\":\"(d) Access to Records.—\",\"start\":0},{\"end\":78,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ad4abf44590787c42436feaddb79749e29d10fc3d1ce979a6e33711f8bae64c3a:24:78:sha256-dfb351abac6e12a6cbc20601321ed7ca4768a11300834885ce8b1b7679bf9ce6\",\"quote\":\"Each agency that maintains a system of rec­ords shall—\",\"start\":24},{\"end\":573,\"field\":\"scope_text:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ad4abf44590787c42436feaddb79749e29d10fc3d1ce979a6e33711f8bae64c3a:80:573:sha256-6badc1ade31284dc26f306db1e2c95d0990702aa28cd68d8a2eb8cad12b703b9\",\"quote\":\"(1) upon request by any individual to gain access to his record or to any information pertaining to him which is contained in the system, permit him and upon his request, a person of his own choosing to accompany him, to review the record and have a copy made of all or any portion thereof in a form comprehensible to him, except that the agency may require the individual to furnish a written statement authorizing discussion of that individual’s record in the accompanying person’s presence;\",\"start\":80}],\"id\":\"urn:rulespec:document-understanding:revision:5a39da273e3aa67628a80e4be26476f8bfd5352458bdc1cd5e03c842856b7ad4\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:913b2ed2791dab23dbb6f901186434390e8b355c0c76c20427e37a1c8e4b1b07\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:4c8296185f46417a7b92a83f9b00bbd4307a7ac6b4bcb59eeb53e0af232b586c\",\"origin\":\"aiSuggested\",\"quote\":\"(1) upon request by any individual to gain access to his record or to any information pertaining to him which is contained in the system, permit him and upon his request, a person of his own choosing to accompany him, to review the record and have a copy made of all or any portion thereof in a form comprehensible to him, except that the agency may require the individual to furnish a written statement authorizing discussion of that individual’s record in the accompanying person’s presence;\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:ae32aa70097fb27776c2b35023a9b9618280b59a326d449ca5445ca2f9b71599\",\"scope_quotes\":[\"(d) Access to Records.— Each agency that maintains a system of rec­ords shall—\",\"(1) upon request by any individual to gain access to his record or to any information pertaining to him which is contained in the system, permit him and upon his request, a person of his own choosing to accompany him, to review the record and have a copy made of all or any portion thereof in a form comprehensible to him, except that the agency may require the individual to furnish a written statement authorizing discussion of that individual’s record in the accompanying person’s presence;\"],\"scope_text\":\"upon request by any individual to gain access to his record or to any information pertaining to him which is contained in the system\",\"section_id\":\"section-1\",\"start\":80,\"summary\":\"Each agency that maintains a system of records must, upon request by any individual to gain access to his record or to any information pertaining to him contained in the system, permit him and upon his request, a person of his own choosing to accompany him, to review the record and have a copy made of all or any portion thereof in a form comprehensible to him, except that the agency may require the individual to furnish a written statement authorizing discussion of that individual's record in the accompanying person's presence.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

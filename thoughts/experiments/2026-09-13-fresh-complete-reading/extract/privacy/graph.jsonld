    {
      "@id": "urn:rulespec:document-understanding:revision:5ce3d8212cf7b8af032123af18ebe540df64253b2da583185c3695b3e55adffe",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:5ce3d8212cf7b8af032123af18ebe540df64253b2da583185c3695b3e55adffe",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:5d7d260282a80f2f944c5d975c2ca4befd6617843bef29d8ac0ed45e84e0c113",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"the agency\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:1e9abedb0516464bb728f67f92aa9bb4fcb935a74078b333abf03b62659a92d0\",\"urn:rulespec:document-understanding:assertion:caf07406b59436427d6d5e3c87b3fcab98191371cfbd6bef021030db71fa992d\",\"urn:rulespec:document-understanding:assertion:f139a62f54cb3901cff5c0ce63fab92f759733d8d045c0599f6b3082a73b0fc1\",\"urn:rulespec:document-understanding:assertion:c088c8279f4b0117740f7e17af44c065a8c08dbf03042ef69e88fd5859fdf295\",\"urn:rulespec:document-understanding:assertion:8751ca6d18fb57f3a2c043ec957643aa36a4ad807b15d861c70bd3716f921e84\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":573,\"evidence\":[{\"end\":573,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ad4abf44590787c42436feaddb79749e29d10fc3d1ce979a6e33711f8bae64c3a:80:573:sha256-6badc1ade31284dc26f306db1e2c95d0990702aa28cd68d8a2eb8cad12b703b9\",\"quote\":\"(1) upon request by any individual to gain access to his record or to any information pertaining to him which is contained in the system, permit him and upon his request, a person of his own choosing to accompany him, to review the record and have a copy made of all or any portion thereof in a form comprehensible to him, except that the agency may require the individual to furnish a written statement authorizing discussion of that individual’s record in the accompanying person’s presence;\",\"start\":80},{\"end\":425,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ad4abf44590787c42436feaddb79749e29d10fc3d1ce979a6e33711f8bae64c3a:415:425:sha256-307a752d92c11cbf54d16dc296a543e18512a196c2b1e8b2c4ff0a468a7e8e20\",\"quote\":\"the agency\",\"start\":415},{\"end\":429,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ad4abf44590787c42436feaddb79749e29d10fc3d1ce979a6e33711f8bae64c3a:426:429:sha256-ee4d988c65de860fabbfbcd27f73d50bbebe3fba37fe419284f4811389c30bdc\",\"quote\":\"may\",\"start\":426},{\"end\":23,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ad4abf44590787c42436feaddb79749e29d10fc3d1ce979a6e33711f8bae64c3a:0:23:sha256-f1c254da239bf0323adf0a1a661152495a2eb850c73528193941a6302cbf4509\",\"quote\":\"(d) Access to Records.—\",\"start\":0},{\"end\":78,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ad4abf44590787c42436feaddb79749e29d10fc3d1ce979a6e33711f8bae64c3a:24:78:sha256-dfb351abac6e12a6cbc20601321ed7ca4768a11300834885ce8b1b7679bf9ce6\",\"quote\":\"Each agency that maintains a system of rec­ords shall—\",\"start\":24},{\"end\":573,\"field\":\"scope_text:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ad4abf44590787c42436feaddb79749e29d10fc3d1ce979a6e33711f8bae64c3a:80:573:sha256-6badc1ade31284dc26f306db1e2c95d0990702aa28cd68d8a2eb8cad12b703b9\",\"quote\":\"(1) upon request by any individual to gain access to his record or to any information pertaining to him which is contained in the system, permit him and upon his request, a person of his own choosing to accompany him, to review the record and have a copy made of all or any portion thereof in a form comprehensible to him, except that the agency may require the individual to furnish a written statement authorizing discussion of that individual’s record in the accompanying person’s presence;\",\"start\":80}],\"id\":\"urn:rulespec:document-understanding:revision:5ce3d8212cf7b8af032123af18ebe540df64253b2da583185c3695b3e55adffe\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"permission\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:8751ca6d18fb57f3a2c043ec957643aa36a4ad807b15d861c70bd3716f921e84\",\"modality\":\"may\",\"modality_quote\":\"may\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:a359feabac3e3f03c14c85eb6664b1c0b0864bead14f7729fb458b70f005960c\",\"origin\":\"aiSuggested\",\"quote\":\"(1) upon request by any individual to gain access to his record or to any information pertaining to him which is contained in the system, permit him and upon his request, a person of his own choosing to accompany him, to review the record and have a copy made of all or any portion thereof in a form comprehensible to him, except that the agency may require the individual to furnish a written statement authorizing discussion of that individual’s record in the accompanying person’s presence;\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:463646e2747e71d48624a6e9c6b51f375ac64809ea442583c4ff5b12a43ccaa0\",\"scope_quotes\":[\"(d) Access to Records.— Each agency that maintains a system of rec­ords shall—\",\"(1) upon request by any individual to gain access to his record or to any information pertaining to him which is contained in the system, permit him and upon his request, a person of his own choosing to accompany him, to review the record and have a copy made of all or any portion thereof in a form comprehensible to him, except that the agency may require the individual to furnish a written statement authorizing discussion of that individual’s record in the accompanying person’s presence;\"],\"scope_text\":\"upon request by any individual to gain access to his record or to any information pertaining to him contained in the system, when permitting a person of his own choosing to accompany him\",\"section_id\":\"section-1\",\"start\":80,\"summary\":\"An agency maintaining a system of records may require an individual who requests to be accompanied by a person of his own choosing when reviewing his record to furnish a written statement authorizing discussion of that individual's record in the accompanying person's presence.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

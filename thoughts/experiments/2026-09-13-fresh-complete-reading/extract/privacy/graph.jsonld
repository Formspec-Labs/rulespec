    {
      "@id": "urn:rulespec:document-understanding:revision:e5e9cbefd0f4f5f52ac3e5ba40abdc7cf077707f5720aac8d8b3a2ebefc22cc6",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:e5e9cbefd0f4f5f52ac3e5ba40abdc7cf077707f5720aac8d8b3a2ebefc22cc6",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:86d55166d8a13d0f2230c5a57df8f29b3a8682170b7d14599f13a97652170601",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"Each agency that maintains a system of rec­ords\",\"alternative_quotes\":[\"(i) make any correction of any portion thereof which the individual believes is not accurate, relevant, timely, or complete; or\",\"(ii) inform the individual of its refusal to amend the record in accordance with his request, the reason for the refusal, the procedures established by the agency for the individual to request a review of that refusal by the head of the agency or an officer designated by the head of the agency, and the name and business address of that official;\"],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:5be5cbc35ec8d8a1daf32ca1056fcb631b9daab729182d43fc5860b1bc5367c7\",\"urn:rulespec:document-understanding:assertion:16720796c42a734cb8809e7fb3b1c9ac7349af83e92c01423622e4680c9ac065\",\"urn:rulespec:document-understanding:assertion:47a96b4febe7c54d0d93644cfdd69a005abcd2f8964e1cebceeecbe0daf85307\",\"urn:rulespec:document-understanding:assertion:f2f34f549577d954b13fe3f964c246aec3e6b2deafd7334fb5a0db45aeee5c6f\",\"urn:rulespec:document-understanding:assertion:de21477c0e9381f35d2957c15084cfe91ba23636462ce49574ef82b52f70d4c9\",\"urn:rulespec:document-understanding:assertion:0f6684ee88eb3d6ccd78149c2d4e93fd5a83d248607d15f7df64c2efc78836bf\",\"urn:rulespec:document-understanding:assertion:fa91bbb40a194edc6dffa26ddb8efcddf503090c87f0aacba7720237aefcf680\",\"urn:rulespec:document-understanding:assertion:27bd3262611f82be2a1000f0dce41aea2c74ad7d13fc2073cca2b53da5d9e3a4\"],\"choice_quote\":\"(B) promptly, either—\\n\\n(i) make any correction of any portion thereof which the individual believes is not accurate, relevant, timely, or complete; or\\n\\n(ii) inform the individual of its refusal to amend the record in accordance with his request, the reason for the refusal, the procedures established by the agency for the individual to request a review of that refusal by the head of the agency or an officer designated by the head of the agency, and the name and business address of that official;\",\"choice_text\":\"The agency must promptly execute one of two alternatives: either (1) make the requested correction of any portion the individual believes is not accurate, relevant, timely, or complete; or (2) inform the individual of its refusal to amend the record, the reason, established review procedures before the agency head or designated officer, and the official's name and business address.\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":1327,\"evidence\":[{\"end\":849,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ad4abf44590787c42436feaddb79749e29d10fc3d1ce979a6e33711f8bae64c3a:828:849:sha256-2e612b87ba7f2a1ea6a636957e8877fa79243b772e1b7e0382673a81afe25642\",\"quote\":\"(B) promptly, either—\",\"start\":828},{\"end\":1327,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ad4abf44590787c42436feaddb79749e29d10fc3d1ce979a6e33711f8bae64c3a:851:1327:sha256-b560586435fd1b58b6714c7f3b22626c26641b07bb725f2cb3d4ffbb413bdee7\",\"quote\":\"(i) make any correction of any portion thereof which the individual believes is not accurate, relevant, timely, or complete; or\\n\\n(ii) inform the individual of its refusal to amend the record in accordance with his request, the reason for the refusal, the procedures established by the agency for the individual to request a review of that refusal by the head of the agency or an officer designated by the head of the agency, and the name and business address of that official;\",\"start\":851},{\"end\":71,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ad4abf44590787c42436feaddb79749e29d10fc3d1ce979a6e33711f8bae64c3a:24:71:sha256-3e64e82e80cb053bce05493b1594948057e6e563c0f294d70a93f7ce452bf700\",\"quote\":\"Each agency that maintains a system of rec­ords\",\"start\":24},{\"end\":849,\"field\":\"choice_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ad4abf44590787c42436feaddb79749e29d10fc3d1ce979a6e33711f8bae64c3a:828:849:sha256-2e612b87ba7f2a1ea6a636957e8877fa79243b772e1b7e0382673a81afe25642\",\"quote\":\"(B) promptly, either—\",\"start\":828},{\"end\":1327,\"field\":\"choice_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ad4abf44590787c42436feaddb79749e29d10fc3d1ce979a6e33711f8bae64c3a:851:1327:sha256-b560586435fd1b58b6714c7f3b22626c26641b07bb725f2cb3d4ffbb413bdee7\",\"quote\":\"(i) make any correction of any portion thereof which the individual believes is not accurate, relevant, timely, or complete; or\\n\\n(ii) inform the individual of its refusal to amend the record in accordance with his request, the reason for the refusal, the procedures established by the agency for the individual to request a review of that refusal by the head of the agency or an officer designated by the head of the agency, and the name and business address of that official;\",\"start\":851},{\"end\":23,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ad4abf44590787c42436feaddb79749e29d10fc3d1ce979a6e33711f8bae64c3a:0:23:sha256-f1c254da239bf0323adf0a1a661152495a2eb850c73528193941a6302cbf4509\",\"quote\":\"(d) Access to Records.—\",\"start\":0},{\"end\":78,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ad4abf44590787c42436feaddb79749e29d10fc3d1ce979a6e33711f8bae64c3a:24:78:sha256-dfb351abac6e12a6cbc20601321ed7ca4768a11300834885ce8b1b7679bf9ce6\",\"quote\":\"Each agency that maintains a system of rec­ords shall—\",\"start\":24},{\"end\":656,\"field\":\"scope_text:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ad4abf44590787c42436feaddb79749e29d10fc3d1ce979a6e33711f8bae64c3a:575:656:sha256-7a54a78449bcf8f7b5d822e703be70922ac4916ce01d12a5fe1c506ef889ab4c\",\"quote\":\"(2) permit the individual to request amendment of a record pertaining to him and—\",\"start\":575},{\"end\":978,\"field\":\"alternative:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ad4abf44590787c42436feaddb79749e29d10fc3d1ce979a6e33711f8bae64c3a:851:978:sha256-13e9fe96165d68813f488502cfda2ddc9c2b2ff9b70c1e9da2362f2f2b89ce28\",\"quote\":\"(i) make any correction of any portion thereof which the individual believes is not accurate, relevant, timely, or complete; or\",\"start\":851},{\"end\":1327,\"field\":\"alternative:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ad4abf44590787c42436feaddb79749e29d10fc3d1ce979a6e33711f8bae64c3a:980:1327:sha256-9559aebde6710c63de5cb3c99d19c8ef1bf264bbd5b077ffe7fe45b03a55c8fd\",\"quote\":\"(ii) inform the individual of its refusal to amend the record in accordance with his request, the reason for the refusal, the procedures established by the agency for the individual to request a review of that refusal by the head of the agency or an officer designated by the head of the agency, and the name and business address of that official;\",\"start\":980}],\"id\":\"urn:rulespec:document-understanding:revision:e5e9cbefd0f4f5f52ac3e5ba40abdc7cf077707f5720aac8d8b3a2ebefc22cc6\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:27bd3262611f82be2a1000f0dce41aea2c74ad7d13fc2073cca2b53da5d9e3a4\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:c8ad0e1368158df9c16ccd97aecaada4133e6431bd0b02427ce18b533f1cb968\",\"origin\":\"aiSuggested\",\"quote\":\"(B) promptly, either—\\n\\n(i) make any correction of any portion thereof which the individual believes is not accurate, relevant, timely, or complete; or\\n\\n(ii) inform the individual of its refusal to amend the record in accordance with his request, the reason for the refusal, the procedures established by the agency for the individual to request a review of that refusal by the head of the agency or an officer designated by the head of the agency, and the name and business address of that official;\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:5ca2d05ac3db1d377d67cd38de20039b676429ab486483ad0e180f57be78ac3b\",\"scope_quotes\":[\"(d) Access to Records.— Each agency that maintains a system of rec­ords shall—\",\"(2) permit the individual to request amendment of a record pertaining to him and—\"],\"scope_text\":\"upon an individual's request to amend a record pertaining to him\",\"section_id\":\"section-1\",\"start\":828,\"summary\":\"Each agency that maintains a system of records must, upon an individual's request to amend a record pertaining to him, promptly either: (i) make any correction of any portion thereof which the individual believes is not accurate, relevant, timely, or complete; or (ii) inform the individual of its refusal to amend the record in accordance with his request, the reason for the refusal, the procedures established by the agency for the individual to request a review of that refusal by the head of the agency or an officer designated by the head of the agency, and the name and business address of that official.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",
      "dcterms:references": [

      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"Each agency that maintains a system of rec­ords\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:254673f0595eaa87d380483d0dc227c0dd220690df46a90e4069ba7e75651d1e\",\"urn:rulespec:document-understanding:assertion:70d621549793d6fa657402776efc78156bc4a4f32bdaa5fc3bc6bc7b5f3f8884\",\"urn:rulespec:document-understanding:assertion:016b5a81cfd1b9a74e573a8b304c6330b5ae345c546d3431134465f626ad4a25\",\"urn:rulespec:document-understanding:assertion:263989d6d1bbd22493030338eeed58da0721297b62834bd0d1f7fc506380a050\",\"urn:rulespec:document-understanding:assertion:192f320701da09ec1b64ca4b21519f93054804ce23bcde58e237b42e535ca0d1\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":2145,\"evidence\":[{\"end\":2145,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ad4abf44590787c42436feaddb79749e29d10fc3d1ce979a6e33711f8bae64c3a:1331:2145:sha256-c82522e35f9eff4d5ea64864ceb1b23790ff92301101037e5cd079a3d51128b5\",\"quote\":\"(3) permit the individual who disagrees with the refusal of the agency to amend his record to request a review of such refusal, and not later than 30 days (excluding Saturdays, Sundays, and legal public holidays) from the date on which the individual requests such review, complete such review and make a final determination unless, for good cause shown, the head of the agency extends such 30-day period; and if, after his review, the reviewing official also refuses to amend the record in accordance with the request, permit the individual to file with the agency a concise statement setting forth the reasons for his disagreement with the refusal of the agency, and notify the individual of the provisions for judicial review of the reviewing official’s determination under subsection (g)(1)(A) of this section;\",\"start\":1331},{\"end\":71,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ad4abf44590787c42436feaddb79749e29d10fc3d1ce979a6e33711f8bae64c3a:24:71:sha256-3e64e82e80cb053bce05493b1594948057e6e563c0f294d70a93f7ce452bf700\",\"quote\":\"Each agency that maintains a system of rec­ords\",\"start\":24},{\"end\":23,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ad4abf44590787c42436feaddb79749e29d10fc3d1ce979a6e33711f8bae64c3a:0:23:sha256-f1c254da239bf0323adf0a1a661152495a2eb850c73528193941a6302cbf4509\",\"quote\":\"(d) Access to Records.—\",\"start\":0},{\"end\":78,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ad4abf44590787c42436feaddb79749e29d10fc3d1ce979a6e33711f8bae64c3a:24:78:sha256-dfb351abac6e12a6cbc20601321ed7ca4768a11300834885ce8b1b7679bf9ce6\",\"quote\":\"Each agency that maintains a system of rec­ords shall—\",\"start\":24},{\"end\":2145,\"field\":\"scope_text:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ad4abf44590787c42436feaddb79749e29d10fc3d1ce979a6e33711f8bae64c3a:1331:2145:sha256-c82522e35f9eff4d5ea64864ceb1b23790ff92301101037e5cd079a3d51128b5\",\"quote\":\"(3) permit the individual who disagrees with the refusal of the agency to amend his record to request a review of such refusal, and not later than 30 days (excluding Saturdays, Sundays, and legal public holidays) from the date on which the individual requests such review, complete such review and make a final determination unless, for good cause shown, the head of the agency extends such 30-day period; and if, after his review, the reviewing official also refuses to amend the record in accordance with the request, permit the individual to file with the agency a concise statement setting forth the reasons for his disagreement with the refusal of the agency, and notify the individual of the provisions for judicial review of the reviewing official’s determination under subsection (g)(1)(A) of this section;\",\"start\":1331}],\"id\":\"urn:rulespec:document-understanding:revision:120688aac66e4622d9f34102ca7024751d8f67f9d0e2edb0ba67d41f43dc355e\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:192f320701da09ec1b64ca4b21519f93054804ce23bcde58e237b42e535ca0d1\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:47719e4d14487901204955fd89deb9d64da37ac2122dce54d9e60210e8df56a5\",\"origin\":\"aiSuggested\",\"quote\":\"(3) permit the individual who disagrees with the refusal of the agency to amend his record to request a review of such refusal, and not later than 30 days (excluding Saturdays, Sundays, and legal public holidays) from the date on which the individual requests such review, complete such review and make a final determination unless, for good cause shown, the head of the agency extends such 30-day period; and if, after his review, the reviewing official also refuses to amend the record in accordance with the request, permit the individual to file with the agency a concise statement setting forth the reasons for his disagreement with the refusal of the agency, and notify the individual of the provisions for judicial review of the reviewing official’s determination under subsection (g)(1)(A) of this section;\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:9548fb56f7a957fad319b895af4837d551232558eb8decabf1cbcd727535d0b2\",\"scope_quotes\":[\"(d) Access to Records.— Each agency that maintains a system of rec­ords shall—\",\"(3) permit the individual who disagrees with the refusal of the agency to amend his record to request a review of such refusal, and not later than 30 days (excluding Saturdays, Sundays, and legal public holidays) from the date on which the individual requests such review, complete such review and make a final determination unless, for good cause shown, the head of the agency extends such 30-day period; and if, after his review, the reviewing official also refuses to amend the record in accordance with the request, permit the individual to file with the agency a concise statement setting forth the reasons for his disagreement with the refusal of the agency, and notify the individual of the provisions for judicial review of the reviewing official’s determination under subsection (g)(1)(A) of this section;\"],\"scope_text\":\"when an individual disagrees with the refusal of the agency to amend his record and requests a review of such refusal\",\"section_id\":\"section-1\",\"start\":1331,\"summary\":\"Each agency that maintains a system of records must permit an individual who disagrees with the refusal of the agency to amend his record to request a review of such refusal, and not later than 30 days (excluding Saturdays, Sundays, and legal public holidays) from the date on which the individual requests such review, complete such review and make a final determination unless, for good cause shown, the head of the agency extends such 30-day period.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

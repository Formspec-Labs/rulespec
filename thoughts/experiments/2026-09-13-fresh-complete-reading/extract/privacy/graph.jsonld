      "@id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ad4abf44590787c42436feaddb79749e29d10fc3d1ce979a6e33711f8bae64c3a:2147:2657:sha256-dd0b2a2f817f72935db89aa1b365b7e3b073bfbe318926aa3c7653f5caa38948",
      "@type": "rkaf:SourceFragment",
      "oa:hasSource": "urn:rulespec:document-understanding:document:d4abf44590787c42436feaddb79749e29d10fc3d1ce979a6e33711f8bae64c3a",

      "rkaf:assertsValue": {
        "@value": "{\"actor\":\"Each agency that maintains a system of rec­ords\",\"kind\":\"requirement\",\"modality\":\"must\",\"scope_text\":\"if, after his review, the reviewing official also refuses to amend the record in accordance with the request\",\"summary\":\"If, after review of a refusal to amend a record, the reviewing official also refuses to amend the record in accordance with the request, the agency must permit the individual to file with the agency a concise statement setting forth the reasons for his disagreement with the refusal of the agency, and notify the individual of the provisions for judicial review of the reviewing official's determination under subsection (g)(1)(A) of this section.\"}",
        "@type": "xsd:string"
      },

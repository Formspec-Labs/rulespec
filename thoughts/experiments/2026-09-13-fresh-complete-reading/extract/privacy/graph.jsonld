      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"Each agency that maintains a system of rec­ords\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:a1db74c178f201dda282cfed43b5032fe7e44bfd365906f0c5f76ae997391a58\",\"urn:rulespec:document-understanding:assertion:286ea39ca41d7bb3da447cf4ac0047d7e39b5af5f096ed5687c40331b3611222\",\"urn:rulespec:document-understanding:assertion:4e3a7295c4401998a1945329e6bda5470f285e68df4c18c945412b84d714123f\",\"urn:rulespec:document-understanding:assertion:551a1f25274e20267a7141a5266879f4f9a3d751525a449cff6d96ded1c823a1\",\"urn:rulespec:document-understanding:assertion:e0b66efdf3ed657abb3db6f155c26e6354e3651f7004d36795da2b0196abc676\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":2145,\"evidence\":[{\"end\":2145,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ad4abf44590787c42436feaddb79749e29d10fc3d1ce979a6e33711f8bae64c3a:1331:2145:sha256-c82522e35f9eff4d5ea64864ceb1b23790ff92301101037e5cd079a3d51128b5\",\"quote\":\"(3) permit the individual who disagrees with the refusal of the agency to amend his record to request a review of such refusal, and not later than 30 days (excluding Saturdays, Sundays, and legal public holidays) from the date on which the individual requests such review, complete such review and make a final determination unless, for good cause shown, the head of the agency extends such 30-day period; and if, after his review, the reviewing official also refuses to amend the record in accordance with the request, permit the individual to file with the agency a concise statement setting forth the reasons for his disagreement with the refusal of the agency, and notify the individual of the provisions for judicial review of the reviewing official’s determination under subsection (g)(1)(A) of this section;\",\"start\":1331},{\"end\":71,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ad4abf44590787c42436feaddb79749e29d10fc3d1ce979a6e33711f8bae64c3a:24:71:sha256-3e64e82e80cb053bce05493b1594948057e6e563c0f294d70a93f7ce452bf700\",\"quote\":\"Each agency that maintains a system of rec­ords\",\"start\":24},{\"end\":23,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ad4abf44590787c42436feaddb79749e29d10fc3d1ce979a6e33711f8bae64c3a:0:23:sha256-f1c254da239bf0323adf0a1a661152495a2eb850c73528193941a6302cbf4509\",\"quote\":\"(d) Access to Records.—\",\"start\":0},{\"end\":78,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ad4abf44590787c42436feaddb79749e29d10fc3d1ce979a6e33711f8bae64c3a:24:78:sha256-dfb351abac6e12a6cbc20601321ed7ca4768a11300834885ce8b1b7679bf9ce6\",\"quote\":\"Each agency that maintains a system of rec­ords shall—\",\"start\":24},{\"end\":2145,\"field\":\"scope_text:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ad4abf44590787c42436feaddb79749e29d10fc3d1ce979a6e33711f8bae64c3a:1331:2145:sha256-c82522e35f9eff4d5ea64864ceb1b23790ff92301101037e5cd079a3d51128b5\",\"quote\":\"(3) permit the individual who disagrees with the refusal of the agency to amend his record to request a review of such refusal, and not later than 30 days (excluding Saturdays, Sundays, and legal public holidays) from the date on which the individual requests such review, complete such review and make a final determination unless, for good cause shown, the head of the agency extends such 30-day period; and if, after his review, the reviewing official also refuses to amend the record in accordance with the request, permit the individual to file with the agency a concise statement setting forth the reasons for his disagreement with the refusal of the agency, and notify the individual of the provisions for judicial review of the reviewing official’s determination under subsection (g)(1)(A) of this section;\",\"start\":1331}],\"id\":\"urn:rulespec:document-understanding:revision:9f1853c682b1f04d0567781bc6e740d4d5e8903c0a97df2c9c8ab88deb538639\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:e0b66efdf3ed657abb3db6f155c26e6354e3651f7004d36795da2b0196abc676\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:78cc50ded008891603afd29da418d21751870d4bf4b920649c216fbdb62062b9\",\"origin\":\"aiSuggested\",\"quote\":\"(3) permit the individual who disagrees with the refusal of the agency to amend his record to request a review of such refusal, and not later than 30 days (excluding Saturdays, Sundays, and legal public holidays) from the date on which the individual requests such review, complete such review and make a final determination unless, for good cause shown, the head of the agency extends such 30-day period; and if, after his review, the reviewing official also refuses to amend the record in accordance with the request, permit the individual to file with the agency a concise statement setting forth the reasons for his disagreement with the refusal of the agency, and notify the individual of the provisions for judicial review of the reviewing official’s determination under subsection (g)(1)(A) of this section;\",\"references\":[\"subsection (g)(1)(A)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:f8415dd161f22984891c603db2a6e2dc0a0a1d54f7cc71bc038a956d52ab3082\",\"scope_quotes\":[\"(d) Access to Records.— Each agency that maintains a system of rec­ords shall—\",\"(3) permit the individual who disagrees with the refusal of the agency to amend his record to request a review of such refusal, and not later than 30 days (excluding Saturdays, Sundays, and legal public holidays) from the date on which the individual requests such review, complete such review and make a final determination unless, for good cause shown, the head of the agency extends such 30-day period; and if, after his review, the reviewing official also refuses to amend the record in accordance with the request, permit the individual to file with the agency a concise statement setting forth the reasons for his disagreement with the refusal of the agency, and notify the individual of the provisions for judicial review of the reviewing official’s determination under subsection (g)(1)(A) of this section;\"],\"scope_text\":\"if, after his review, the reviewing official also refuses to amend the record in accordance with the request\",\"section_id\":\"section-1\",\"start\":1331,\"summary\":\"If, after review of a refusal to amend a record, the reviewing official also refuses to amend the record in accordance with the request, the agency must permit the individual to file with the agency a concise statement setting forth the reasons for his disagreement with the refusal of the agency, and notify the individual of the provisions for judicial review of the reviewing official's determination under subsection (g)(1)(A) of this section.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

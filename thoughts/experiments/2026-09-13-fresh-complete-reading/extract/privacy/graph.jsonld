      "dcterms:description": "{\"action\":\"\",\"actor\":\"Each agency that maintains a system of rec­ords\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:adf9d1f5c350c266887ce60475ce6082ca98acb450fa38d60df9ae2204a2ca22\",\"urn:rulespec:document-understanding:assertion:d397e46e9ba6cfe00bc28f65678fe84cf51b1c1f23b843851061c91b230f3d32\",\"urn:rulespec:document-understanding:assertion:425e8b6617610d09ce2eee7cfc9d80435a041af8118656653b8e91e007cc67f7\",\"urn:rulespec:document-understanding:assertion:a4f88cefbb98676ba6357dc47d8b11b1572b8e3cfe12bcb9bb6c97e8ba128775\",\"urn:rulespec:document-understanding:assertion:0e123d2d738308246d07d70a7a9c6deb0e02e03afe37d7da4cb9ae09675fa5ed\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":2657,\"evidence\":[{\"end\":2657,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ad4abf44590787c42436feaddb79749e29d10fc3d1ce979a6e33711f8bae64c3a:2147:2657:sha256-dd0b2a2f817f72935db89aa1b365b7e3b073bfbe318926aa3c7653f5caa38948\",\"quote\":\"(4) in any disclosure, containing information about which the individual has filed a statement of disagreement, occurring after the filing of the statement under paragraph (3) of this subsection, clearly note any portion of the record which is disputed and provide copies of the statement and, if the agency deems it appropriate, copies of a concise statement of the reasons of the agency for not making the amendments requested, to persons or other agencies to whom the disputed record has been disclosed; and\",\"start\":2147},{\"end\":71,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ad4abf44590787c42436feaddb79749e29d10fc3d1ce979a6e33711f8bae64c3a:24:71:sha256-3e64e82e80cb053bce05493b1594948057e6e563c0f294d70a93f7ce452bf700\",\"quote\":\"Each agency that maintains a system of rec­ords\",\"start\":24},{\"end\":23,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ad4abf44590787c42436feaddb79749e29d10fc3d1ce979a6e33711f8bae64c3a:0:23:sha256-f1c254da239bf0323adf0a1a661152495a2eb850c73528193941a6302cbf4509\",\"quote\":\"(d) Access to Records.—\",\"start\":0},{\"end\":78,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ad4abf44590787c42436feaddb79749e29d10fc3d1ce979a6e33711f8bae64c3a:24:78:sha256-dfb351abac6e12a6cbc20601321ed7ca4768a11300834885ce8b1b7679bf9ce6\",\"quote\":\"Each agency that maintains a system of rec­ords shall—\",\"start\":24},{\"end\":2657,\"field\":\"scope_text:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ad4abf44590787c42436feaddb79749e29d10fc3d1ce979a6e33711f8bae64c3a:2147:2657:sha256-dd0b2a2f817f72935db89aa1b365b7e3b073bfbe318926aa3c7653f5caa38948\",\"quote\":\"(4) in any disclosure, containing information about which the individual has filed a statement of disagreement, occurring after the filing of the statement under paragraph (3) of this subsection, clearly note any portion of the record which is disputed and provide copies of the statement and, if the agency deems it appropriate, copies of a concise statement of the reasons of the agency for not making the amendments requested, to persons or other agencies to whom the disputed record has been disclosed; and\",\"start\":2147}],\"id\":\"urn:rulespec:document-understanding:revision:b16c997fdf815d7a6e23bb9d9be8ba4a6040229d518c89bcaeeb9e0437554f43\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:0e123d2d738308246d07d70a7a9c6deb0e02e03afe37d7da4cb9ae09675fa5ed\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:3b22ff2477040d1beca5764e6e01abb491cf04e3ee1bc4454caecea55d385045\",\"origin\":\"aiSuggested\",\"quote\":\"(4) in any disclosure, containing information about which the individual has filed a statement of disagreement, occurring after the filing of the statement under paragraph (3) of this subsection, clearly note any portion of the record which is disputed and provide copies of the statement and, if the agency deems it appropriate, copies of a concise statement of the reasons of the agency for not making the amendments requested, to persons or other agencies to whom the disputed record has been disclosed; and\",\"references\":[\"paragraph (3)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:d421225593a2e05245b6aa2761deddbd01ccf987aeea0d714001ab721a3403e0\",\"scope_quotes\":[\"(d) Access to Records.— Each agency that maintains a system of rec­ords shall—\",\"(4) in any disclosure, containing information about which the individual has filed a statement of disagreement, occurring after the filing of the statement under paragraph (3) of this subsection, clearly note any portion of the record which is disputed and provide copies of the statement and, if the agency deems it appropriate, copies of a concise statement of the reasons of the agency for not making the amendments requested, to persons or other agencies to whom the disputed record has been disclosed; and\"],\"scope_text\":\"in any disclosure, containing information about which the individual has filed a statement of disagreement, occurring after the filing of the statement under paragraph (3) of this subsection\",\"section_id\":\"section-1\",\"start\":2147,\"summary\":\"Each agency that maintains a system of records must, in any disclosure containing information about which the individual has filed a statement of disagreement occurring after the filing of the statement under paragraph (3), clearly note any portion of the record which is disputed and provide copies of the statement and, if the agency deems it appropriate, copies of a concise statement of the reasons of the agency for not making the amendments requested, to persons or other agencies to whom the disputed record has been disclosed.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

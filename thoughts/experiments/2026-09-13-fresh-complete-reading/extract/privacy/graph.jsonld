      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:choice_text",
      "rkaf:assertsValue": {
        "@value": "The agency must promptly execute one of two alternatives: either (1) make the requested correction of any portion the individual believes is not accurate, relevant, timely, or complete; or (2) inform the individual of its refusal to amend the record, the reason, established review procedures before the agency head or designated officer, and the official's name and business address.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

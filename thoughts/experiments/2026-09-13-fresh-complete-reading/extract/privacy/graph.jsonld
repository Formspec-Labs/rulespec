    {
      "@id": "urn:rulespec:document-understanding:assertion:27bd3262611f82be2a1000f0dce41aea2c74ad7d13fc2073cca2b53da5d9e3a4",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:f7a64cfc2abf8478fca22d572a2d7324cdce12d1935fbf1dab2fe42634495ae2",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:b4e48a9f148cb3ab278621337ed3d243e128ca6e8d78a3381c5f1e9258f676ae",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:5ca2d05ac3db1d377d67cd38de20039b676429ab486483ad0e180f57be78ac3b",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"actor\":\"Each agency that maintains a system of rec­ords\",\"alternative_quotes\":[\"(i) make any correction of any portion thereof which the individual believes is not accurate, relevant, timely, or complete; or\",\"(ii) inform the individual of its refusal to amend the record in accordance with his request, the reason for the refusal, the procedures established by the agency for the individual to request a review of that refusal by the head of the agency or an officer designated by the head of the agency, and the name and business address of that official;\"],\"choice_text\":\"The agency must promptly execute one of two alternatives: either (1) make the requested correction of any portion the individual believes is not accurate, relevant, timely, or complete; or (2) inform the individual of its refusal to amend the record, the reason, established review procedures before the agency head or designated officer, and the official's name and business address.\",\"kind\":\"requirement\",\"modality\":\"must\",\"scope_text\":\"upon an individual's request to amend a record pertaining to him\",\"summary\":\"Each agency that maintains a system of records must, upon an individual's request to amend a record pertaining to him, promptly either: (i) make any correction of any portion thereof which the individual believes is not accurate, relevant, timely, or complete; or (ii) inform the individual of its refusal to amend the record in accordance with his request, the reason for the refusal, the procedures established by the agency for the individual to request a review of that refusal by the head of the agency or an officer designated by the head of the agency, and the name and business address of that official.\"}",
        "@type": "xsd:string"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed",
      "rkaf:hasApplicability": "urn:rulespec:document-understanding:scope:8339b1b6643ebdc0692aa27e9f89fe22d6e46cdf32eb182d66f34423d0515098"
    },

      "rkaf:assertsValue": {
        "@value": "{\"actor\":\"Each agency that maintains a system of rec­ords\",\"kind\":\"requirement\",\"modality\":\"must\",\"scope_text\":\"when an individual disagrees with the refusal of the agency to amend his record and requests a review of such refusal\",\"summary\":\"Each agency that maintains a system of records must permit an individual who disagrees with the refusal of the agency to amend his record to request a review of such refusal, and not later than 30 days (excluding Saturdays, Sundays, and legal public holidays) from the date on which the individual requests such review, complete such review and make a final determination unless, for good cause shown, the head of the agency extends such 30-day period.\"}",
        "@type": "xsd:string"
      },

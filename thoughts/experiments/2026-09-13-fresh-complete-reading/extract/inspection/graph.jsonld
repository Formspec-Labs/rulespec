    {
      "@id": "urn:rulespec:document-understanding:revision:f6918c22efc89399576aa46f1f187bf604179a6ae1523982ddd8ccdb51eab57a",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:f6918c22efc89399576aa46f1f187bf604179a6ae1523982ddd8ccdb51eab57a",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:7de181946419389ba8343669888496f94e10d432f8da24a73b386451511fdc0a",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"The Attorney General\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:1a07dce1b634dd90be78945b4e6f315a94e5819141a9a4b7a119b6ec65bfcf96\",\"urn:rulespec:document-understanding:assertion:f783e362cf0772abab6f94bb897f1d6e7d07df2339f8e7320a73d951618c0eb0\",\"urn:rulespec:document-understanding:assertion:7c027d3ed484cc1f77414897ae0dbbb45b8ebd59f13c8f1f90f604d5e6b00687\",\"urn:rulespec:document-understanding:assertion:f505b93f8cef9a0643ce0f0ec73e313a379c000bfc877c4663a950266c9a099f\",\"urn:rulespec:document-understanding:assertion:f1a3e1f28f10874a87628b1d97f641d29a7f8f4dac34281b2bac31a18a23872c\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":593,\"evidence\":[{\"end\":181,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ae6b820aba04977e5820d09fdf563016a1e32f2e8b28f53340ae2cbd0727c2800:0:181:sha256-c9b3fc565b0c6dfe18e1d0be0e3d0e225597abf7784370757c5bb95a70c98834\",\"quote\":\"(B) The Attorney General may inspect or examine the inventory and records of a licensed importer, licensed manufacturer, or licensed dealer without such reasonable cause or warrant—\",\"start\":0},{\"end\":402,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ae6b820aba04977e5820d09fdf563016a1e32f2e8b28f53340ae2cbd0727c2800:183:402:sha256-6e672a5d5aed10d5534653532695d4af0093c424e3040a790657e43aa65eed5e\",\"quote\":\"(i) in the course of a reasonable inquiry during the course of a criminal investigation of a person or persons other than the licensee;\\n\\n(ii) for ensuring compliance with the record keeping requirements of this chapter—\",\"start\":183},{\"end\":593,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ae6b820aba04977e5820d09fdf563016a1e32f2e8b28f53340ae2cbd0727c2800:404:593:sha256-439c5ee17447c1680e2169f47695b6c23e0af87c85462ab69dc61f0646b5750f\",\"quote\":\"(I) not more than once during any 12-month period; or\\n\\n(II) at any time with respect to records relating to a firearm involved in a criminal investigation that is traced to the licensee; or\",\"start\":404},{\"end\":24,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ae6b820aba04977e5820d09fdf563016a1e32f2e8b28f53340ae2cbd0727c2800:4:24:sha256-63e516340625fd032a14cff583aff196050cb1aafad4b631042fadebe8b77727\",\"quote\":\"The Attorney General\",\"start\":4},{\"end\":28,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ae6b820aba04977e5820d09fdf563016a1e32f2e8b28f53340ae2cbd0727c2800:25:28:sha256-ee4d988c65de860fabbfbcd27f73d50bbebe3fba37fe419284f4811389c30bdc\",\"quote\":\"may\",\"start\":25},{\"end\":402,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ae6b820aba04977e5820d09fdf563016a1e32f2e8b28f53340ae2cbd0727c2800:320:402:sha256-9e919fca3cccb6b71d8c68bf15ac7ea0c9c93fdb39db4e22db606a92b7b6df46\",\"quote\":\"(ii) for ensuring compliance with the record keeping requirements of this chapter—\",\"start\":320},{\"end\":593,\"field\":\"scope_text:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ae6b820aba04977e5820d09fdf563016a1e32f2e8b28f53340ae2cbd0727c2800:459:593:sha256-33c783aff61b1704680717b5f407a1df4b1026408dd5d1bdc3720f2432cbca8d\",\"quote\":\"(II) at any time with respect to records relating to a firearm involved in a criminal investigation that is traced to the licensee; or\",\"start\":459}],\"id\":\"urn:rulespec:document-understanding:revision:f6918c22efc89399576aa46f1f187bf604179a6ae1523982ddd8ccdb51eab57a\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"authority\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:f1a3e1f28f10874a87628b1d97f641d29a7f8f4dac34281b2bac31a18a23872c\",\"modality\":\"may\",\"modality_quote\":\"may\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:4ea1ac5dc1fb3a182bacbf56482d8df3f6d12ca7f9ed682e5650d2ed10b54594\",\"origin\":\"aiSuggested\",\"quote\":\"(B) The Attorney General may inspect or examine the inventory and records of a licensed importer, licensed manufacturer, or licensed dealer without such reasonable cause or warrant—\\n\\n(i) in the course of a reasonable inquiry during the course of a criminal investigation of a person or persons other than the licensee;\\n\\n(ii) for ensuring compliance with the record keeping requirements of this chapter—\\n\\n(I) not more than once during any 12-month period; or\\n\\n(II) at any time with respect to records relating to a firearm involved in a criminal investigation that is traced to the licensee; or\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:319919cce7d73d74ae14ee6b7ebe904b601e621754295c18f053484f6d97e9d7\",\"scope_quotes\":[\"(ii) for ensuring compliance with the record keeping requirements of this chapter—\",\"(II) at any time with respect to records relating to a firearm involved in a criminal investigation that is traced to the licensee; or\"],\"scope_text\":\"for ensuring compliance with the record keeping requirements of this chapter at any time with respect to records relating to a firearm involved in a criminal investigation that is traced to the licensee\",\"section_id\":\"section-1\",\"start\":0,\"summary\":\"The Attorney General may inspect or examine the inventory and records of a licensed importer, licensed manufacturer, or licensed dealer without reasonable cause or warrant for ensuring compliance with the record keeping requirements of this chapter at any time with respect to records relating to a firearm involved in a criminal investigation that is traced to the licensee.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

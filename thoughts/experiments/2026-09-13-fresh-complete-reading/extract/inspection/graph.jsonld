      "dcterms:description": "{\"action\":\"\",\"actor\":\"The Attorney General\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:149c350771a28ab1abf178bd0b324d116adeba3865b70f2fe9d85a6cf5cd73be\",\"urn:rulespec:document-understanding:assertion:639849b7145851b364a369f2d494b3cd1cb5461dac28e006a40a6fa96146fc94\",\"urn:rulespec:document-understanding:assertion:584f6f5e70ec7b1c4798d8fcd62c41f231d50fd37b3f9b0df15f4292cfbd773d\",\"urn:rulespec:document-understanding:assertion:cfe366569d27cd0ee77ec6bbb79bf1b86313ca4ec451401344d76f23a54c1971\",\"urn:rulespec:document-understanding:assertion:09f4afe5b7f1e2237e44f58dfe1555c0f9c4eefc18847e9fff1d1599d192f9ca\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":457,\"evidence\":[{\"end\":181,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ae6b820aba04977e5820d09fdf563016a1e32f2e8b28f53340ae2cbd0727c2800:0:181:sha256-c9b3fc565b0c6dfe18e1d0be0e3d0e225597abf7784370757c5bb95a70c98834\",\"quote\":\"(B) The Attorney General may inspect or examine the inventory and records of a licensed importer, licensed manufacturer, or licensed dealer without such reasonable cause or warrant—\",\"start\":0},{\"end\":402,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ae6b820aba04977e5820d09fdf563016a1e32f2e8b28f53340ae2cbd0727c2800:183:402:sha256-6e672a5d5aed10d5534653532695d4af0093c424e3040a790657e43aa65eed5e\",\"quote\":\"(i) in the course of a reasonable inquiry during the course of a criminal investigation of a person or persons other than the licensee;\\n\\n(ii) for ensuring compliance with the record keeping requirements of this chapter—\",\"start\":183},{\"end\":457,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ae6b820aba04977e5820d09fdf563016a1e32f2e8b28f53340ae2cbd0727c2800:404:457:sha256-5d7c616a0f13baca7177732172665f0e25a5488badde04b58c28c1103057c2bc\",\"quote\":\"(I) not more than once during any 12-month period; or\",\"start\":404},{\"end\":24,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ae6b820aba04977e5820d09fdf563016a1e32f2e8b28f53340ae2cbd0727c2800:4:24:sha256-63e516340625fd032a14cff583aff196050cb1aafad4b631042fadebe8b77727\",\"quote\":\"The Attorney General\",\"start\":4},{\"end\":28,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ae6b820aba04977e5820d09fdf563016a1e32f2e8b28f53340ae2cbd0727c2800:25:28:sha256-ee4d988c65de860fabbfbcd27f73d50bbebe3fba37fe419284f4811389c30bdc\",\"quote\":\"may\",\"start\":25},{\"end\":402,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ae6b820aba04977e5820d09fdf563016a1e32f2e8b28f53340ae2cbd0727c2800:320:402:sha256-9e919fca3cccb6b71d8c68bf15ac7ea0c9c93fdb39db4e22db606a92b7b6df46\",\"quote\":\"(ii) for ensuring compliance with the record keeping requirements of this chapter—\",\"start\":320},{\"end\":457,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ae6b820aba04977e5820d09fdf563016a1e32f2e8b28f53340ae2cbd0727c2800:404:457:sha256-5d7c616a0f13baca7177732172665f0e25a5488badde04b58c28c1103057c2bc\",\"quote\":\"(I) not more than once during any 12-month period; or\",\"start\":404}],\"id\":\"urn:rulespec:document-understanding:revision:8f4e458447a9ad4955cd82391f7aa548a985990370acd1b33b007f2be3c9ef92\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"authority\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:09f4afe5b7f1e2237e44f58dfe1555c0f9c4eefc18847e9fff1d1599d192f9ca\",\"modality\":\"may\",\"modality_quote\":\"may\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:44423ac9254ec8b6a2524d67bf81e23a98971ee20f5881c0c52460864b9d151e\",\"origin\":\"aiSuggested\",\"quote\":\"(B) The Attorney General may inspect or examine the inventory and records of a licensed importer, licensed manufacturer, or licensed dealer without such reasonable cause or warrant—\\n\\n(i) in the course of a reasonable inquiry during the course of a criminal investigation of a person or persons other than the licensee;\\n\\n(ii) for ensuring compliance with the record keeping requirements of this chapter—\\n\\n(I) not more than once during any 12-month period; or\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:bea98b8e1b21e1e3d87ffb020cf86cf4512d4288b1ae1b2fb8103cdedc689c4a\",\"scope_quotes\":[\"(ii) for ensuring compliance with the record keeping requirements of this chapter—\\n\\n(I) not more than once during any 12-month period; or\"],\"scope_text\":\"for ensuring compliance with the record keeping requirements of this chapter, not more than once during any 12-month period\",\"section_id\":\"section-1\",\"start\":0,\"summary\":\"The Attorney General may inspect or examine the inventory and records of a licensed importer, licensed manufacturer, or licensed dealer without reasonable cause or warrant for ensuring compliance with the record keeping requirements of this chapter, not more than once during any 12-month period.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

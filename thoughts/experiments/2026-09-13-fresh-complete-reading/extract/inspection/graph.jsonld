    {
      "@id": "urn:rulespec:document-understanding:revision:080887fe9e93dccd2f1d0284e9f50367e430ff1698194db00fea3f1b9d95c1b2",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:080887fe9e93dccd2f1d0284e9f50367e430ff1698194db00fea3f1b9d95c1b2",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:32a4b701ce5c7c0e21a52410400d288884a53ecb471db28d2fd07d6c7b94f0a2",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"The Attorney General\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:45a15af7f5de0f04df63e2a734a9dc109f00d9ace8c7154053e6b50e00c94e33\",\"urn:rulespec:document-understanding:assertion:e4a060e55cdfa07d6bc840e2260eccb28ea1179828ff106aaf4ed0b137db565b\",\"urn:rulespec:document-understanding:assertion:eb7309357e0fc53264fe4051d1d8e4feab471c45f0d1ac4d7e7fa971080a18e8\",\"urn:rulespec:document-understanding:assertion:d8ad623ec261a519f3a502d61d227f0dd404bf8e7a95d80d3f93652b06de6c42\",\"urn:rulespec:document-understanding:assertion:83300cd02d3237ca6a4479dcf91e86489846077e727e58937c6d6de082e76e2d\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":773,\"evidence\":[{\"end\":181,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ae6b820aba04977e5820d09fdf563016a1e32f2e8b28f53340ae2cbd0727c2800:0:181:sha256-c9b3fc565b0c6dfe18e1d0be0e3d0e225597abf7784370757c5bb95a70c98834\",\"quote\":\"(B) The Attorney General may inspect or examine the inventory and records of a licensed importer, licensed manufacturer, or licensed dealer without such reasonable cause or warrant—\",\"start\":0},{\"end\":402,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ae6b820aba04977e5820d09fdf563016a1e32f2e8b28f53340ae2cbd0727c2800:183:402:sha256-6e672a5d5aed10d5534653532695d4af0093c424e3040a790657e43aa65eed5e\",\"quote\":\"(i) in the course of a reasonable inquiry during the course of a criminal investigation of a person or persons other than the licensee;\\n\\n(ii) for ensuring compliance with the record keeping requirements of this chapter—\",\"start\":183},{\"end\":773,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ae6b820aba04977e5820d09fdf563016a1e32f2e8b28f53340ae2cbd0727c2800:404:773:sha256-a5f9031621494bf72e4409bc6bee7766dc46f496927bfe6d6653785139af964b\",\"quote\":\"(I) not more than once during any 12-month period; or\\n\\n(II) at any time with respect to records relating to a firearm involved in a criminal investigation that is traced to the licensee; or\\n\\n\\n(iii) when such inspection or examination may be required for determining the disposition of one or more particular firearms in the course of a bona fide criminal investigation.\",\"start\":404},{\"end\":24,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ae6b820aba04977e5820d09fdf563016a1e32f2e8b28f53340ae2cbd0727c2800:4:24:sha256-63e516340625fd032a14cff583aff196050cb1aafad4b631042fadebe8b77727\",\"quote\":\"The Attorney General\",\"start\":4},{\"end\":773,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ae6b820aba04977e5820d09fdf563016a1e32f2e8b28f53340ae2cbd0727c2800:596:773:sha256-221f640e9ba13d4de3274fc733d9e6e5800d6f4c8e54693e0d991f5c8538d6e6\",\"quote\":\"(iii) when such inspection or examination may be required for determining the disposition of one or more particular firearms in the course of a bona fide criminal investigation.\",\"start\":596}],\"id\":\"urn:rulespec:document-understanding:revision:080887fe9e93dccd2f1d0284e9f50367e430ff1698194db00fea3f1b9d95c1b2\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"authority\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:83300cd02d3237ca6a4479dcf91e86489846077e727e58937c6d6de082e76e2d\",\"modality\":\"may\",\"modality_quote\":\"may\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:af38c84b3bd540abbee1f53d1d94b6810db4d0f03b4d0576876d686e59643146\",\"origin\":\"aiSuggested\",\"quote\":\"(B) The Attorney General may inspect or examine the inventory and records of a licensed importer, licensed manufacturer, or licensed dealer without such reasonable cause or warrant—\\n\\n(i) in the course of a reasonable inquiry during the course of a criminal investigation of a person or persons other than the licensee;\\n\\n(ii) for ensuring compliance with the record keeping requirements of this chapter—\\n\\n(I) not more than once during any 12-month period; or\\n\\n(II) at any time with respect to records relating to a firearm involved in a criminal investigation that is traced to the licensee; or\\n\\n\\n(iii) when such inspection or examination may be required for determining the disposition of one or more particular firearms in the course of a bona fide criminal investigation.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:e2c846e5468149c742ce587ba4d1d025dd7acac099dcce95cee146ae2a6680ef\",\"scope_quotes\":[\"(iii) when such inspection or examination may be required for determining the disposition of one or more particular firearms in the course of a bona fide criminal investigation.\"],\"scope_text\":\"when such inspection or examination may be required for determining the disposition of one or more particular firearms in the course of a bona fide criminal investigation\",\"section_id\":\"section-1\",\"start\":0,\"summary\":\"The Attorney General may inspect or examine the inventory and records of a licensed importer, licensed manufacturer, or licensed dealer without reasonable cause or warrant when such inspection or examination may be required for determining the disposition of one or more particular firearms in the course of a bona fide criminal investigation.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

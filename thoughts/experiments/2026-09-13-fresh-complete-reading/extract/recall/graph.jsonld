      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "(1) If a manufacturer decides to repair a defective or noncomplying motor vehicle or replacement equipment and the repair is not done adequately within a reasonable time, the manufacturer shall—"
        },

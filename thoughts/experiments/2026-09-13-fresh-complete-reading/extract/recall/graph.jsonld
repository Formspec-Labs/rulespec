      "rkaf:fragmentIdentityScheme": "rkaf:carrier-local-fragment",
      "rkaf:sourceArtifactDigest": "sha256:4b85c5b59d5f81980669767b1427ec1d6dd983fab0455624a7be2d2bdd6a40b8",
      "rkaf:fragmentContentDigest": "sha256:4bbc9035752d3a2e9ed2f79fc63281ed8ccba43dfc4ed908622054472afb9841",

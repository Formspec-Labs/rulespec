      "rkaf:assertsValue": {
        "@value": "If a manufacturer decides to repair a defective or noncomplying motor vehicle or replacement equipment and the repair is not done adequately within a reasonable time, the manufacturer shall replace the vehicle or equipment without charge with an identical or reasonably equivalent vehicle or equipment, or, for a vehicle, refund the purchase price, less a reasonable allowance for depreciation.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

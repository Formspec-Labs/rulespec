    {
      "@id": "urn:rulespec:document-understanding:scope:7bfee4ec982a782d5cd0735284cff8543ffeaaea62b10c0ffc6c147a5b5fcdf6",
      "@type": "rkaf:ApplicabilityScope",
      "rkaf:appliesInJurisdiction": [],
      "rkaf:applicabilityCondition": "If the Secretary determines that a manufacturer’s remedy program is not likely to be capable of completion within a reasonable time, and if the Secretary finds that there is a risk of serious injury or death if the remedy program is not accelerated and that acceleration can be reasonably achieved by expanding the sources of replacement parts, expanding the number of authorized repair facilities, or both"
    },
    {
      "@id": "urn:rulespec:document-understanding:assertion:8a1c0d3bf8635a597f27afe705f0663763d4f88cba830a5584f4f1d34b2124f2",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:1051065f79d31a8456d7aca1f81b58bbe69c418e72b5fa6cdc52a185e3d1fd5e",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:17b66ae0af0f6c956f7ea6593e123739794217604f6ec538c3e330690202d882",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:bd046aa486eeff35971ef3108f47d479f3bbb36218dcf9c9bc23493d78800491",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:states-authority",
      "rkaf:assertsValue": {
        "@value": "If the Secretary determines that a manufacturer’s remedy program is not likely to be capable of completion within a reasonable time, the Secretary may require the manufacturer to accelerate the remedy program if the Secretary finds that there is a risk of serious injury or death if the remedy program is not accelerated, and that acceleration of the remedy program can be reasonably achieved by expanding the sources of replacement parts, expanding the number of authorized repair facilities, or both.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

      "dcterms:description": "{\"action\":\"\",\"actor\":\"Secretary\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:8a1c0d3bf8635a597f27afe705f0663763d4f88cba830a5584f4f1d34b2124f2\",\"urn:rulespec:document-understanding:assertion:a1569cfddf87bb31483992ad7196e41d3c7b17efcc5c19430a68605d2ec9abff\",\"urn:rulespec:document-understanding:assertion:b2147008851bd907b0da894a6ecd1f71fad753a7de754f168454d47fac138573\",\"urn:rulespec:document-understanding:assertion:b771821d9a6731acfa82c3225907976a2ceb46ded2431d94fd6063099f1e981c\",\"urn:rulespec:document-understanding:assertion:20d2ab2562296ffa3d3da8abf2c28e97b794060a7d5147e7f42660224af3385f\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":1532,\"evidence\":[{\"end\":1251,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4b85c5b59d5f81980669767b1427ec1d6dd983fab0455624a7be2d2bdd6a40b8:1015:1251:sha256-97e1722f60b1068c2ddcac9a3bd8bbe939d535d3fe045e9c1f063e9e0fb2be69\",\"quote\":\"(3) If the Secretary determines that a manufacturer’s remedy program is not likely to be capable of completion within a reasonable time, the Secretary may require the manufacturer to accelerate the remedy program if the Secretary finds—\",\"start\":1015},{\"end\":1532,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4b85c5b59d5f81980669767b1427ec1d6dd983fab0455624a7be2d2bdd6a40b8:1253:1532:sha256-d8a17df2e9c85ee97e6adbcabe903d7dfd28e132723af543febc8fb0601d9d96\",\"quote\":\"(A) that there is a risk of serious injury or death if the remedy program is not accelerated; and\\n\\n(B) that acceleration of the remedy program can be reasonably achieved by expanding the sources of replacement parts, expanding the number of authorized repair facilities, or both.\",\"start\":1253},{\"end\":1169,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4b85c5b59d5f81980669767b1427ec1d6dd983fab0455624a7be2d2bdd6a40b8:1166:1169:sha256-ee4d988c65de860fabbfbcd27f73d50bbebe3fba37fe419284f4811389c30bdc\",\"quote\":\"may\",\"start\":1166},{\"end\":1251,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4b85c5b59d5f81980669767b1427ec1d6dd983fab0455624a7be2d2bdd6a40b8:1015:1251:sha256-97e1722f60b1068c2ddcac9a3bd8bbe939d535d3fe045e9c1f063e9e0fb2be69\",\"quote\":\"(3) If the Secretary determines that a manufacturer’s remedy program is not likely to be capable of completion within a reasonable time, the Secretary may require the manufacturer to accelerate the remedy program if the Secretary finds—\",\"start\":1015},{\"end\":1532,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4b85c5b59d5f81980669767b1427ec1d6dd983fab0455624a7be2d2bdd6a40b8:1253:1532:sha256-d8a17df2e9c85ee97e6adbcabe903d7dfd28e132723af543febc8fb0601d9d96\",\"quote\":\"(A) that there is a risk of serious injury or death if the remedy program is not accelerated; and\\n\\n(B) that acceleration of the remedy program can be reasonably achieved by expanding the sources of replacement parts, expanding the number of authorized repair facilities, or both.\",\"start\":1253}],\"id\":\"urn:rulespec:document-understanding:revision:50b876340d86bd1bf6393b975dc1109616fdff5758325b08ea277b18c5df1ffe\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"authority\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:20d2ab2562296ffa3d3da8abf2c28e97b794060a7d5147e7f42660224af3385f\",\"modality\":\"may\",\"modality_quote\":\"may\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:1ab5eac5d6d7aaf7bb83692a76b698737edda40bac63ae301d93a8cda73cab4a\",\"origin\":\"aiSuggested\",\"quote\":\"(3) If the Secretary determines that a manufacturer’s remedy program is not likely to be capable of completion within a reasonable time, the Secretary may require the manufacturer to accelerate the remedy program if the Secretary finds—\\n\\n(A) that there is a risk of serious injury or death if the remedy program is not accelerated; and\\n\\n(B) that acceleration of the remedy program can be reasonably achieved by expanding the sources of replacement parts, expanding the number of authorized repair facilities, or both.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:bd046aa486eeff35971ef3108f47d479f3bbb36218dcf9c9bc23493d78800491\",\"scope_quotes\":[\"(3) If the Secretary determines that a manufacturer’s remedy program is not likely to be capable of completion within a reasonable time, the Secretary may require the manufacturer to accelerate the remedy program if the Secretary finds—\\n\\n(A) that there is a risk of serious injury or death if the remedy program is not accelerated; and\\n\\n(B) that acceleration of the remedy program can be reasonably achieved by expanding the sources of replacement parts, expanding the number of authorized repair facilities, or both.\"],\"scope_text\":\"If the Secretary determines that a manufacturer’s remedy program is not likely to be capable of completion within a reasonable time, and if the Secretary finds that there is a risk of serious injury or death if the remedy program is not accelerated and that acceleration can be reasonably achieved by expanding the sources of replacement parts, expanding the number of authorized repair facilities, or both\",\"section_id\":\"section-1\",\"start\":1015,\"summary\":\"If the Secretary determines that a manufacturer’s remedy program is not likely to be capable of completion within a reasonable time, the Secretary may require the manufacturer to accelerate the remedy program if the Secretary finds that there is a risk of serious injury or death if the remedy program is not accelerated, and that acceleration of the remedy program can be reasonably achieved by expanding the sources of replacement parts, expanding the number of authorized repair facilities, or both.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "(A) replace the vehicle or equipment without charge with an identical or reasonably equivalent vehicle or equipment; or\n\n(B) for a vehicle, refund the purchase price, less a reasonable allowance for depreciation."
        },
        {
          "@type": "oa:TextPositionSelector",

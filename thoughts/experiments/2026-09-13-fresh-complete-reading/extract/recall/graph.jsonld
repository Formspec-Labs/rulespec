      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "(A) that there is a risk of serious injury or death if the remedy program is not accelerated; and\n\n(B) that acceleration of the remedy program can be reasonably achieved by expanding the sources of replacement parts, expanding the number of authorized repair facilities, or both."
        },
        {
          "@type": "oa:TextPositionSelector",
          "oa:start": 1253,
          "oa:end": 1532,
          "rkaf:coordinateSystem": "rkaf:unicode-codepoint"

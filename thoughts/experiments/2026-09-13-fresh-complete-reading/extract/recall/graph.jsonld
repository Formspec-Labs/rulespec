      "dcterms:description": "{\"action\":\"\",\"actor\":\"manufacturer\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:8832fd44f21f7f887936c5d3fb7ef5d0ab0a4d02dbef293efeabb31d9796e3ac\",\"urn:rulespec:document-understanding:assertion:98e56dfc65abc4f3f6f8937f18d02987b9f86c19131ff1a0fe60716d8fe008a3\",\"urn:rulespec:document-understanding:assertion:da0a79f19935ddbdc3786dd3ff86a3c534878e15b4cce5b88cd41b456b99ce77\",\"urn:rulespec:document-understanding:assertion:f8735e1bca88bd13abf2ed5de96c7c18417f42691aab72681546222841dcf54f\",\"urn:rulespec:document-understanding:assertion:13d02416ae3e4442cddce202753e9253d614c41c72763be7e7e485e873e3c72c\",\"urn:rulespec:document-understanding:assertion:202dc72e1a5753791408557f37996e06e49b0f504653fc29eb3d566467b11ec4\"],\"choice_quote\":\"(A) replace the vehicle or equipment without charge with an identical or reasonably equivalent vehicle or equipment; or\\n\\n(B) for a vehicle, refund the purchase price, less a reasonable allowance for depreciation.\",\"choice_text\":\"The manufacturer must either: (A) replace the vehicle or equipment without charge with an identical or reasonably equivalent vehicle or equipment; or (B) for a vehicle, refund the purchase price, less a reasonable allowance for depreciation.\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":435,\"evidence\":[{\"end\":221,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4b85c5b59d5f81980669767b1427ec1d6dd983fab0455624a7be2d2bdd6a40b8:27:221:sha256-a2bd7f88ea1b4431d280a6643287db9c8ace1a5b8ff1701ec3a686e14a85d33d\",\"quote\":\"(1) If a manufacturer decides to repair a defective or noncomplying motor vehicle or replacement equipment and the repair is not done adequately within a reasonable time, the manufacturer shall—\",\"start\":27},{\"end\":435,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4b85c5b59d5f81980669767b1427ec1d6dd983fab0455624a7be2d2bdd6a40b8:223:435:sha256-4bbc9035752d3a2e9ed2f79fc63281ed8ccba43dfc4ed908622054472afb9841\",\"quote\":\"(A) replace the vehicle or equipment without charge with an identical or reasonably equivalent vehicle or equipment; or\\n\\n(B) for a vehicle, refund the purchase price, less a reasonable allowance for depreciation.\",\"start\":223},{\"end\":214,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4b85c5b59d5f81980669767b1427ec1d6dd983fab0455624a7be2d2bdd6a40b8:198:214:sha256-dcbc1bb86e0e5470a84e3699cfba9aca7dbf5af0e7c46f4d3055c41773db5fcb\",\"quote\":\"the manufacturer\",\"start\":198},{\"end\":220,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4b85c5b59d5f81980669767b1427ec1d6dd983fab0455624a7be2d2bdd6a40b8:215:220:sha256-56ee5b508706bf2de91712d85d6d1e11ddbff01949142ed6e8c22e3b1bed1c71\",\"quote\":\"shall\",\"start\":215},{\"end\":435,\"field\":\"choice_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4b85c5b59d5f81980669767b1427ec1d6dd983fab0455624a7be2d2bdd6a40b8:223:435:sha256-4bbc9035752d3a2e9ed2f79fc63281ed8ccba43dfc4ed908622054472afb9841\",\"quote\":\"(A) replace the vehicle or equipment without charge with an identical or reasonably equivalent vehicle or equipment; or\\n\\n(B) for a vehicle, refund the purchase price, less a reasonable allowance for depreciation.\",\"start\":223},{\"end\":221,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4b85c5b59d5f81980669767b1427ec1d6dd983fab0455624a7be2d2bdd6a40b8:27:221:sha256-a2bd7f88ea1b4431d280a6643287db9c8ace1a5b8ff1701ec3a686e14a85d33d\",\"quote\":\"(1) If a manufacturer decides to repair a defective or noncomplying motor vehicle or replacement equipment and the repair is not done adequately within a reasonable time, the manufacturer shall—\",\"start\":27}],\"id\":\"urn:rulespec:document-understanding:revision:17582f7bc532ead7254ecadad897800e5fc037a39e9084775db0e54a8f39a7be\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:202dc72e1a5753791408557f37996e06e49b0f504653fc29eb3d566467b11ec4\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:b39f65285376aad3da1582e7ce12a195822764d483fcfe74ae6065ca73495eee\",\"origin\":\"aiSuggested\",\"quote\":\"(1) If a manufacturer decides to repair a defective or noncomplying motor vehicle or replacement equipment and the repair is not done adequately within a reasonable time, the manufacturer shall—\\n\\n(A) replace the vehicle or equipment without charge with an identical or reasonably equivalent vehicle or equipment; or\\n\\n(B) for a vehicle, refund the purchase price, less a reasonable allowance for depreciation.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:b22c5cc0d3ec614345dfcd212624c9a4f86140b0e2f80997631bf849a34f526e\",\"scope_quotes\":[\"(1) If a manufacturer decides to repair a defective or noncomplying motor vehicle or replacement equipment and the repair is not done adequately within a reasonable time, the manufacturer shall—\"],\"scope_text\":\"If a manufacturer decides to repair a defective or noncomplying motor vehicle or replacement equipment and the repair is not done adequately within a reasonable time\",\"section_id\":\"section-1\",\"start\":27,\"summary\":\"If a manufacturer decides to repair a defective or noncomplying motor vehicle or replacement equipment and the repair is not done adequately within a reasonable time, the manufacturer shall replace the vehicle or equipment without charge with an identical or reasonably equivalent vehicle or equipment, or, for a vehicle, refund the purchase price, less a reasonable allowance for depreciation.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

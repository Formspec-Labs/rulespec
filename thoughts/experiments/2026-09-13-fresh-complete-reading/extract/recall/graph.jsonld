    {
      "@id": "urn:rulespec:document-understanding:revision:ae6dd95be8ad8095eeee7efef276149474e3c7073172bdf7b71191eebd6f5ea7",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:ae6dd95be8ad8095eeee7efef276149474e3c7073172bdf7b71191eebd6f5ea7",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:c9ec7d01db0cd85aacb073fb5b45d1cb064d9b2422355cea372f9882b135e817",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:1b441d99431f4587aa8dbf950ac5785cec2707d6c06104e3ee5354744fd08a69\",\"urn:rulespec:document-understanding:assertion:50c43e30e5cb6633ff78c2f945390b74ec09dbb4ccadf84fbb7f3345bf58278d\",\"urn:rulespec:document-understanding:assertion:c6ee296010402fecd3eebcce6725d313a6dcefdad34ef43bcf82cd4652aa164b\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":1013,\"evidence\":[{\"end\":1013,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4b85c5b59d5f81980669767b1427ec1d6dd983fab0455624a7be2d2bdd6a40b8:438:1013:sha256-32d9d2a7b85312a8eed219924c4564ae5b73f8e352c523b5fd80c2315192aeee\",\"quote\":\"(2) Failure to repair a motor vehicle or replacement equipment adequately not later than 60 days after its presentation is prima facie evidence of failure to repair within a reasonable time. However, the Secretary may extend, by order, the 60-day period if good cause for an extension is shown and the reason is published in the Federal Register before the period ends. Presentation of a vehicle or equipment for repair before the date specified by a manufacturer in a notice under section 30119(a)(5) or 30121(c)(2) of this title is not a presentation under this subsection.\",\"start\":438}],\"id\":\"urn:rulespec:document-understanding:revision:ae6dd95be8ad8095eeee7efef276149474e3c7073172bdf7b71191eebd6f5ea7\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"statement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:c6ee296010402fecd3eebcce6725d313a6dcefdad34ef43bcf82cd4652aa164b\",\"modality\":\"not_stated\",\"modality_quote\":\"\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:dfea18d3382e54fb35046afccd1b101b876b9d8775c1ac6f7b5d219c5b0ce9fb\",\"origin\":\"aiSuggested\",\"quote\":\"(2) Failure to repair a motor vehicle or replacement equipment adequately not later than 60 days after its presentation is prima facie evidence of failure to repair within a reasonable time. However, the Secretary may extend, by order, the 60-day period if good cause for an extension is shown and the reason is published in the Federal Register before the period ends. Presentation of a vehicle or equipment for repair before the date specified by a manufacturer in a notice under section 30119(a)(5) or 30121(c)(2) of this title is not a presentation under this subsection.\",\"references\":[\"section 30119(a)(5)\",\"section 30121(c)(2)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:2c4bf66fc0c6fc32924457dc87bc7731a141f20c1a81efc986dfb8ff9e40655e\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":438,\"summary\":\"Presentation of a vehicle or equipment for repair before the date specified by a manufacturer in a notice under section 30119(a)(5) or 30121(c)(2) of this title is not a presentation under subsection (c).\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",
      "dcterms:references": [

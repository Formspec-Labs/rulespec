    {
      "@id": "urn:rulespec:document-understanding:revision:4d75c373c53567525619aeda9688154aac4852cf3e4c58151d5bb4e21864f619",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:4d75c373c53567525619aeda9688154aac4852cf3e4c58151d5bb4e21864f619",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:e49ff416a8f2344ffac902e70d6128f2cb45f83b460015dbde59ab2a6e05319d",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"Secretary\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:7dcf27e0359cea8eaca08eef26e666c3c6abcd9344c752ba2a7d1843afca93c0\",\"urn:rulespec:document-understanding:assertion:7bce6b587d631e25d23b7b7d386416a018665dca47b74b868eaa64d8da7d8e2e\",\"urn:rulespec:document-understanding:assertion:c186ce836bc484af866f108edd26006bcd53f2f866f1de5c6bb652105c8bab27\",\"urn:rulespec:document-understanding:assertion:d9be9fcb0fb0e4148ae7eb9e0163756141fc891561f68055c68a28c702870b87\",\"urn:rulespec:document-understanding:assertion:29793dd4389d6f022438435c18c3a4d19070e9f785060568af6a1b22cc6eb584\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":1013,\"evidence\":[{\"end\":1013,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4b85c5b59d5f81980669767b1427ec1d6dd983fab0455624a7be2d2bdd6a40b8:438:1013:sha256-32d9d2a7b85312a8eed219924c4564ae5b73f8e352c523b5fd80c2315192aeee\",\"quote\":\"(2) Failure to repair a motor vehicle or replacement equipment adequately not later than 60 days after its presentation is prima facie evidence of failure to repair within a reasonable time. However, the Secretary may extend, by order, the 60-day period if good cause for an extension is shown and the reason is published in the Federal Register before the period ends. Presentation of a vehicle or equipment for repair before the date specified by a manufacturer in a notice under section 30119(a)(5) or 30121(c)(2) of this title is not a presentation under this subsection.\",\"start\":438},{\"end\":651,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4b85c5b59d5f81980669767b1427ec1d6dd983fab0455624a7be2d2bdd6a40b8:638:651:sha256-67afe9d5c4310238267da793c265a616f9e90d554f2458a8065b7bb971d853b5\",\"quote\":\"the Secretary\",\"start\":638},{\"end\":655,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4b85c5b59d5f81980669767b1427ec1d6dd983fab0455624a7be2d2bdd6a40b8:652:655:sha256-ee4d988c65de860fabbfbcd27f73d50bbebe3fba37fe419284f4811389c30bdc\",\"quote\":\"may\",\"start\":652},{\"end\":1013,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4b85c5b59d5f81980669767b1427ec1d6dd983fab0455624a7be2d2bdd6a40b8:438:1013:sha256-32d9d2a7b85312a8eed219924c4564ae5b73f8e352c523b5fd80c2315192aeee\",\"quote\":\"(2) Failure to repair a motor vehicle or replacement equipment adequately not later than 60 days after its presentation is prima facie evidence of failure to repair within a reasonable time. However, the Secretary may extend, by order, the 60-day period if good cause for an extension is shown and the reason is published in the Federal Register before the period ends. Presentation of a vehicle or equipment for repair before the date specified by a manufacturer in a notice under section 30119(a)(5) or 30121(c)(2) of this title is not a presentation under this subsection.\",\"start\":438}],\"id\":\"urn:rulespec:document-understanding:revision:4d75c373c53567525619aeda9688154aac4852cf3e4c58151d5bb4e21864f619\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"authority\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:29793dd4389d6f022438435c18c3a4d19070e9f785060568af6a1b22cc6eb584\",\"modality\":\"may\",\"modality_quote\":\"may\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:e7c7627118247a51db7f1978558ad038bf383813760d5202fcaaa3bc18cc19cd\",\"origin\":\"aiSuggested\",\"quote\":\"(2) Failure to repair a motor vehicle or replacement equipment adequately not later than 60 days after its presentation is prima facie evidence of failure to repair within a reasonable time. However, the Secretary may extend, by order, the 60-day period if good cause for an extension is shown and the reason is published in the Federal Register before the period ends. Presentation of a vehicle or equipment for repair before the date specified by a manufacturer in a notice under section 30119(a)(5) or 30121(c)(2) of this title is not a presentation under this subsection.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:2bde7d4d4ab415a0b1d40efb14a9041452cbeae9d5793286fc864f25e2dbc972\",\"scope_quotes\":[\"(2) Failure to repair a motor vehicle or replacement equipment adequately not later than 60 days after its presentation is prima facie evidence of failure to repair within a reasonable time. However, the Secretary may extend, by order, the 60-day period if good cause for an extension is shown and the reason is published in the Federal Register before the period ends. Presentation of a vehicle or equipment for repair before the date specified by a manufacturer in a notice under section 30119(a)(5) or 30121(c)(2) of this title is not a presentation under this subsection.\"],\"scope_text\":\"if good cause for an extension is shown and the reason is published in the Federal Register before the period ends\",\"section_id\":\"section-1\",\"start\":438,\"summary\":\"The Secretary may extend, by order, the 60-day period if good cause for an extension is shown and the reason is published in the Federal Register before the period ends.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

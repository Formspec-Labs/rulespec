      "dcterms:description": "{\"action\":\"\",\"actor\":\"the employee’s employer\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:74a07f10d6199cd882dd4a703efd6609d27592a3b36e39f1c8e4016a0d20d411\",\"urn:rulespec:document-understanding:assertion:5d02eef50da19d607f8fddbb02a8fa5e5b595e1cb1b112e6d06ead7880a4091c\",\"urn:rulespec:document-understanding:assertion:100662fb36f8550fa7b1245fbee33fd030be03214e516a0c9ebcbf0e8dac3a77\",\"urn:rulespec:document-understanding:assertion:33801688c43e903667f60ba6513c7f8b1869b251a44d05e722c43fa328c3a685\",\"urn:rulespec:document-understanding:assertion:946dda56ffee213165d12e5d663efde0bd9021de2b5011d83546886d9262861f\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":490,\"evidence\":[{\"end\":490,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A6bd6138b710dc7572c4a4828f38c5b4bcb300d1378b6874092f7db0317e6136f:279:490:sha256-2b0377cabcc95e4ef669d8782179f25e7a1829dbb2a98b65fcc67ebec978f4fc\",\"quote\":\"shall be permitted by the employee’s employer to use such time within a reasonable period after making the request if the use of the compensatory time does not unduly disrupt the operations of the public agency.\",\"start\":279},{\"end\":324,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A6bd6138b710dc7572c4a4828f38c5b4bcb300d1378b6874092f7db0317e6136f:301:324:sha256-294fa9c28e4f2c6771b5908f36a33898bc8132ee1aad3ed0045b00b19e5bc7e4\",\"quote\":\"the employee’s employer\",\"start\":301},{\"end\":284,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A6bd6138b710dc7572c4a4828f38c5b4bcb300d1378b6874092f7db0317e6136f:279:284:sha256-56ee5b508706bf2de91712d85d6d1e11ddbff01949142ed6e8c22e3b1bed1c71\",\"quote\":\"shall\",\"start\":279},{\"end\":124,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A6bd6138b710dc7572c4a4828f38c5b4bcb300d1378b6874092f7db0317e6136f:0:124:sha256-5141d08d2b577a0e941978588648d04ccc92cc951006316e12462c09a5ed9b8e\",\"quote\":\"(5) An employee of a public agency which is a State, political subdivision of a State, or an interstate governmental agency—\",\"start\":0},{\"end\":276,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A6bd6138b710dc7572c4a4828f38c5b4bcb300d1378b6874092f7db0317e6136f:126:276:sha256-8b5ad85970a84678862ceace2b7263cda4795bd6113e618253d38961cc4a707a\",\"quote\":\"(A) who has accrued compensatory time off authorized to be provided under paragraph (1), and\\n\\n(B) who has requested the use of such compensatory time,\",\"start\":126},{\"end\":490,\"field\":\"scope_text:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A6bd6138b710dc7572c4a4828f38c5b4bcb300d1378b6874092f7db0317e6136f:279:490:sha256-2b0377cabcc95e4ef669d8782179f25e7a1829dbb2a98b65fcc67ebec978f4fc\",\"quote\":\"shall be permitted by the employee’s employer to use such time within a reasonable period after making the request if the use of the compensatory time does not unduly disrupt the operations of the public agency.\",\"start\":279}],\"id\":\"urn:rulespec:document-understanding:revision:73ad4079760439882e10722fd2cbc21affd8a3a38ecd34f0641f1f50a6e31984\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:946dda56ffee213165d12e5d663efde0bd9021de2b5011d83546886d9262861f\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:4ba2f669e5fc6181513f5116ac5210e14c3caf9e4a09720c10e03022fc7de51b\",\"origin\":\"aiSuggested\",\"quote\":\"shall be permitted by the employee’s employer to use such time within a reasonable period after making the request if the use of the compensatory time does not unduly disrupt the operations of the public agency.\",\"references\":[\"paragraph (1)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:92eac4532f96349701c8227c63b77ff9dfcc23b6e2dae95bd684d2b63d05caef\",\"scope_quotes\":[\"(5) An employee of a public agency which is a State, political subdivision of a State, or an interstate governmental agency—\\n\\n(A) who has accrued compensatory time off authorized to be provided under paragraph (1), and\\n\\n(B) who has requested the use of such compensatory time,\",\"shall be permitted by the employee’s employer to use such time within a reasonable period after making the request if the use of the compensatory time does not unduly disrupt the operations of the public agency.\"],\"scope_text\":\"Applies to an employee of a public agency which is a State, political subdivision of a State, or an interstate governmental agency, who has accrued compensatory time off authorized to be provided under paragraph (1), who has requested the use of such compensatory time, and where the use does not unduly disrupt the operations of the public agency.\",\"section_id\":\"section-1\",\"start\":279,\"summary\":\"An employer must permit an employee of a public agency (which is a State, political subdivision of a State, or an interstate governmental agency) who has accrued compensatory time off authorized under paragraph (1) and who has requested the use of such compensatory time to use such time within a reasonable period after making the request, if the use of the compensatory time does not unduly disrupt the operations of the public agency.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

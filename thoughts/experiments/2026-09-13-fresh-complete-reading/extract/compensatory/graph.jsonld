    {
      "@id": "urn:rulespec:document-understanding:scope:ad7dd9a34351f027e9b6cc57f7735ac9741db10c33c2b46fab691e2cd254ba6b",
      "@type": "rkaf:ApplicabilityScope",
      "rkaf:appliesInJurisdiction": [],
      "rkaf:applicabilityCondition": "Applies to an employee of a public agency which is a State, political subdivision of a State, or an interstate governmental agency, who has accrued compensatory time off authorized to be provided under paragraph (1), who has requested the use of such compensatory time, and where the use does not unduly disrupt the operations of the public agency."
    },
    {
      "@id": "urn:rulespec:document-understanding:assertion:74a07f10d6199cd882dd4a703efd6609d27592a3b36e39f1c8e4016a0d20d411",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:0268975e51da5d07254b02332d695c99e5ed04db4c3ff62feae40134e424ab14",

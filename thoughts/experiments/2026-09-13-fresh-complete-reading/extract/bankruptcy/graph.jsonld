    {
      "@id": "urn:rulespec:document-understanding:assertion:c2e84b40744f994c127e8f8b9d7729d0634e016186e09dba6b0286c82106ebdb",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:035bef96c24e3df2435ddc2588e7903f30ae1ebb8998b1ec09408ba863310f21",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:1c562f84207bbc2282baef7ea78afb187c5901def931772758acc2923b70c757",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:90ea47ab520eb1cc453705e96aa64fdcb803ece7768399c38e84a8324c800b6e",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"actor\":\"the court\",\"kind\":\"permission\",\"modality\":\"may\",\"scope_text\":\"Notwithstanding any other provision of this subsection, on the motion of the trustee filed before the expiration of the applicable period of time specified in paragraph (1), (2), or (3), and after notice and a hearing, if the court finds that the debtor attempted in good faith to file all the information required by subsection (a)(1)(B)(iv) and that the best interests of creditors would be served by administration of the case.\",\"summary\":\"Notwithstanding any other provision of subsection (i), on the motion of the trustee filed before the expiration of the applicable period of time specified in paragraph (1), (2), or (3), and after notice and a hearing, the court may decline to dismiss the case if the court finds that the debtor attempted in good faith to file all the information required by subsection (a)(1)(B)(iv) and that the best interests of creditors would be served by administration of the case.\"}",
        "@type": "xsd:string"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed",
      "rkaf:hasApplicability": "urn:rulespec:document-understanding:scope:dfa21467203c68ee6a20f5e0e1c4a07aa315e2237f7a0573ec42c500b30d2571"
    },

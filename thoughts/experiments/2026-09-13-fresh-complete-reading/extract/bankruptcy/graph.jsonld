    {
      "@id": "urn:rulespec:document-understanding:assertion:b5f88b1abc2ab0f065ff5365b9653fe5a599fd7a148eb138be0ee7796e4379db",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:035bef96c24e3df2435ddc2588e7903f30ae1ebb8998b1ec09408ba863310f21",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:1c562f84207bbc2282baef7ea78afb187c5901def931772758acc2923b70c757",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:90ea47ab520eb1cc453705e96aa64fdcb803ece7768399c38e84a8324c800b6e",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:scope_text",
      "rkaf:assertsValue": {
        "@value": "Notwithstanding any other provision of this subsection, on the motion of the trustee filed before the expiration of the applicable period of time specified in paragraph (1), (2), or (3), and after notice and a hearing, if the court finds that the debtor attempted in good faith to file all the information required by subsection (a)(1)(B)(iv) and that the best interests of creditors would be served by administration of the case.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

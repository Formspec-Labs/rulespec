      "rkaf:assertsValue": {
        "@value": "{\"actor\":\"the court\",\"kind\":\"permission\",\"modality\":\"may\",\"scope_text\":\"Subject to paragraph (4) and upon request of the debtor made within 45 days after the date of the filing of the petition described in paragraph (1), if the court finds justification for extending the period for the filing.\",\"summary\":\"Subject to paragraph (4) and upon request of the debtor made within 45 days after the date of the filing of the petition described in paragraph (1), the court may allow the debtor an additional period of not to exceed 45 days to file the information required under subsection (a)(1) if the court finds justification for extending the period for the filing.\"}",
        "@type": "xsd:string"
      },

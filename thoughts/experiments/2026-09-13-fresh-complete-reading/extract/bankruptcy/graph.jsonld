      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"the court\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:70af19f927656d651b0f5f58631399817c3042ce2d73344431b4289a141b5773\",\"urn:rulespec:document-understanding:assertion:d072f65fe60479a70187346b6528af0a37ff077429d357d1d67b605c2eff450a\",\"urn:rulespec:document-understanding:assertion:8ce872dfa3b94b39c3e8a42090ed361d7e10098ffbca37eb8570176433d7189d\",\"urn:rulespec:document-understanding:assertion:b5f88b1abc2ab0f065ff5365b9653fe5a599fd7a148eb138be0ee7796e4379db\",\"urn:rulespec:document-understanding:assertion:c2e84b40744f994c127e8f8b9d7729d0634e016186e09dba6b0286c82106ebdb\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":1497,\"evidence\":[{\"end\":1497,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A7eb23bd601806cc355748c423df338f55b40122a42185ada4f011e3ebeec4ea0:1021:1497:sha256-87da2f74bf309117ff5174786247d7f029047bb2dd3c60fd027cfea0dd29652e\",\"quote\":\"(4) Notwithstanding any other provision of this subsection, on the motion of the trustee filed before the expiration of the applicable period of time specified in paragraph (1), (2), or (3), and after notice and a hearing, the court may decline to dismiss the case if the court finds that the debtor attempted in good faith to file all the information required by subsection (a)(1)(B)(iv) and that the best interests of creditors would be served by administration of the case.\",\"start\":1021},{\"end\":1257,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A7eb23bd601806cc355748c423df338f55b40122a42185ada4f011e3ebeec4ea0:1254:1257:sha256-ee4d988c65de860fabbfbcd27f73d50bbebe3fba37fe419284f4811389c30bdc\",\"quote\":\"may\",\"start\":1254},{\"end\":1497,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A7eb23bd601806cc355748c423df338f55b40122a42185ada4f011e3ebeec4ea0:1021:1497:sha256-87da2f74bf309117ff5174786247d7f029047bb2dd3c60fd027cfea0dd29652e\",\"quote\":\"(4) Notwithstanding any other provision of this subsection, on the motion of the trustee filed before the expiration of the applicable period of time specified in paragraph (1), (2), or (3), and after notice and a hearing, the court may decline to dismiss the case if the court finds that the debtor attempted in good faith to file all the information required by subsection (a)(1)(B)(iv) and that the best interests of creditors would be served by administration of the case.\",\"start\":1021}],\"id\":\"urn:rulespec:document-understanding:revision:53f2260af34f51b18cee019e977f5091ec7f6f25c49f85fce571003b94443f25\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"permission\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:c2e84b40744f994c127e8f8b9d7729d0634e016186e09dba6b0286c82106ebdb\",\"modality\":\"may\",\"modality_quote\":\"may\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:c844f8f66c82e60e3cc543a9dc28c2a7501ca40f92a9591f10e46c21f7a2654c\",\"origin\":\"aiSuggested\",\"quote\":\"(4) Notwithstanding any other provision of this subsection, on the motion of the trustee filed before the expiration of the applicable period of time specified in paragraph (1), (2), or (3), and after notice and a hearing, the court may decline to dismiss the case if the court finds that the debtor attempted in good faith to file all the information required by subsection (a)(1)(B)(iv) and that the best interests of creditors would be served by administration of the case.\",\"references\":[\"paragraph (1), (2), or (3)\",\"subsection (a)(1)(B)(iv)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:90ea47ab520eb1cc453705e96aa64fdcb803ece7768399c38e84a8324c800b6e\",\"scope_quotes\":[\"(4) Notwithstanding any other provision of this subsection, on the motion of the trustee filed before the expiration of the applicable period of time specified in paragraph (1), (2), or (3), and after notice and a hearing, the court may decline to dismiss the case if the court finds that the debtor attempted in good faith to file all the information required by subsection (a)(1)(B)(iv) and that the best interests of creditors would be served by administration of the case.\"],\"scope_text\":\"Notwithstanding any other provision of this subsection, on the motion of the trustee filed before the expiration of the applicable period of time specified in paragraph (1), (2), or (3), and after notice and a hearing, if the court finds that the debtor attempted in good faith to file all the information required by subsection (a)(1)(B)(iv) and that the best interests of creditors would be served by administration of the case.\",\"section_id\":\"section-1\",\"start\":1021,\"summary\":\"Notwithstanding any other provision of subsection (i), on the motion of the trustee filed before the expiration of the applicable period of time specified in paragraph (1), (2), or (3), and after notice and a hearing, the court may decline to dismiss the case if the court finds that the debtor attempted in good faith to file all the information required by subsection (a)(1)(B)(iv) and that the best interests of creditors would be served by administration of the case.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

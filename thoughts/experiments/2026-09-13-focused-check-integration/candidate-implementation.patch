+def test_check_command_selects_exact_statement(monkeypatch, tmp_path, capsys):
+    path = workspace(tmp_path)
+    claim_id = ReviewStore(path).snapshot()['accepted'][0]['id']
+    env, requests = provider(monkeypatch, tmp_path, [judgment()])
+    assert cli.main(['check', str(path), '--claim', claim_id, '--env-file', str(env),
+        '--output', str(tmp_path / 'check')]) == 0
+    result = json.loads(capsys.readouterr().out)
+    assert result['applied_actions'] == 0 and result['unassessed_claim_ids'] == []
+    assert len(requests) == 1

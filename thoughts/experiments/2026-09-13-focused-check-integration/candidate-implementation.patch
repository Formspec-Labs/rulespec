+"""Focused assessments reuse evidence/history without changing rule meaning."""
+from copy import deepcopy
+import json
+
+import pytest
+
+from rulespec_extrapolator import cli, extraction as e, refinement as r
+from rulespec_extrapolator.core import CANDIDATE_SCHEMA, compile_candidates
+from rulespec_extrapolator.documents import prepare_document
+from rulespec_extrapolator.review_store import ReviewStore
+from test_audit import provider
+from test_refinement import workspace
+
+
+def judgment(verdict='supported'):
+    return {'judgments': [{'proposal_id': 'N0000', 'source_refs': ['F000'],
+        'rationale': 'Assessment of this selected reading.', 'verdict': verdict}]}
+
+
+def packet_for(book):
+    window, = e.plan_windows(book['document'])
+    return r._packet(book, {'labels': {'expected_units': []}}, window)
+
+
+@pytest.mark.parametrize('verdict', ['supported', 'unsupported', 'unknown'])
+def test_check_records_evidence_without_edits_or_approval_changes(monkeypatch, tmp_path, verdict):
+    path = workspace(tmp_path)
+    store = ReviewStore(path)
+    claim_id = store.snapshot()['accepted'][0]['id']
+    before = store.apply({'action': 'approve', 'actor': 'reviewer', 'actor_kind': 'humanUser',
+        'expected_revision': 0, 'targets': [claim_id], 'rationale': 'Prior review.'})
+    env, requests = provider(monkeypatch, tmp_path, [judgment(verdict)])
+    result = r.refine_run(path, tmp_path / 'check', check_claims=[claim_id], env_file=env)
+    assert result['run']['status'] == 'complete', result['issues']
+    assert result['changes'] == [] and result['run']['applied_actions'] == 0
+    assert result['run']['unassessed_claim_ids'] == []
+    assert len(requests) == 1
+    assert requests[0]['config']['thinking_config'] == {'thinking_level': 'medium'}
+    assert requests[0]['config']['max_output_tokens'] == 32768
+    assert not {'temperature', 'top_p', 'top_k', 'candidate_count'} & requests[0]['config'].keys()
+    assert requests[0]['contents'].startswith(r.READING_CHECK)
+    after = store.snapshot()
+    for k in CANDIDATE_SCHEMA['properties']:
+        assert after['accepted'][0][k] == before['accepted'][0][k]
+    assert after['accepted'][0]['review_status'] == 'approved'
+    assert after['history'][:-1] == before['history']
+    assert after['history'][-1]['action'] == 'observe'
+    row, = [i for i in after['accepted'][0]['issues'] if i['code'] == 'reading_assessment']
+    assert row['code'] == 'reading_assessment' and row['verdict'] == verdict
+    assert row['claim_id'] == claim_id and row['status'] == 'assessed'
+    assert row['judgment']['source_spans'][0]['quote'] in before['document']['text']
+    assert row['provenance']['request_sha256']
+    assert row['reviewed_snapshot_sha256'] == r.content_digest(before)
+    assert not (tmp_path / 'check/initial-audit').exists()
+    assert not (tmp_path / 'check/final-audit').exists()
+    monkeypatch.setattr(e, '_create_model', lambda *args: pytest.fail('Replay called provider'))
+    assert r.replay_refinement(tmp_path / 'check', tmp_path / 'replay')['provider_calls'] == 0
+
+
+@pytest.mark.parametrize('response', [
+    {'judgments': []}, RuntimeError('provider unavailable'),
+    {'judgments': [judgment()['judgments'][0], judgment()['judgments'][0]]},
+    {'judgments': [dict(judgment()['judgments'][0], source_refs=['F999'])]},
+])
+def test_absent_or_invalid_judgment_is_unassessed_and_replays(monkeypatch, tmp_path, response):
+    path = workspace(tmp_path)
+    claim_id = ReviewStore(path).snapshot()['accepted'][0]['id']
+    env, requests = provider(monkeypatch, tmp_path, [response])
+    result = r.refine_run(path, tmp_path / 'check', check_claims=[claim_id], env_file=env)
+    assert result['run']['status'] == 'partial'
+    assert result['run']['unassessed_claim_ids'] == [claim_id]
+    row, = [i for i in result['rulebook']['accepted'][0]['issues'] if i['code'] == 'reading_assessment']
+    assert row['status'] == 'unassessed' and row['verdict'] == 'unjudged'
+    assert len(requests) == 1 and result['changes'] == []
+    assert r.replay_refinement(tmp_path / 'check', tmp_path / 'replay')['provider_calls'] == 0
+
+
+@pytest.mark.parametrize('selection', [[], ['absent'], ['repeat', 'repeat'], ['x'] * 9])
+def test_invalid_current_selection_fails_before_output_or_model(monkeypatch, tmp_path, selection):
+    path = workspace(tmp_path)
+    monkeypatch.setattr(e, '_create_model', lambda *args: pytest.fail('Invalid selection called provider'))
+    with pytest.raises(ValueError, match='distinct current claim IDs'):
+        r.refine_run(path, tmp_path / 'check', check_claims=selection)
+    assert not (tmp_path / 'check').exists()
+

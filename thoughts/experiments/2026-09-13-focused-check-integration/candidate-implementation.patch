+def test_explicit_selection_is_not_lost_at_context_claim_limit():
+    text = '\n\n'.join(f'Person {i} must carry a badge.' for i in range(65))
+    doc = prepare_document(text)
+    book = compile_candidates(doc, [{'kind': 'requirement', 'actor': '', 'quote': line, 'summary': line}
+        for line in text.split('\n\n')], {})
+    selected = book['accepted'][-1]['id']
+    packet = r._packet(book, {'labels': {'expected_units': []}}, {'start': 0, 'end': len(text)}, [selected])
+    assert len(packet['claims']) == r.MAX_CLAIMS
+    assert packet['claims']['C0064']['id'] == selected
+

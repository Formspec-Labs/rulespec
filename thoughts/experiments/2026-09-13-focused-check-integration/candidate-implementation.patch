+def test_no_change_fields_are_copied_and_cannot_be_applied(tmp_path):
+    book = ReviewStore(workspace(tmp_path)).snapshot()
+    packet = packet_for(book)
+    original = deepcopy(packet)
+    candidate, = r._reading_candidates(packet, ['C0000'], book['document'])
+    for k in CANDIDATE_SCHEMA['properties']:
+        assert candidate['fields'][k] == book['accepted'][0][k]
+    assert candidate['fields']['action'] == ''
+    with pytest.raises(ValueError, match='Only add/edit'):
+        r._action(candidate, book, 'test')
+    candidate['fields']['summary'] = 'Should not mutate the original.'
+    assert packet == original
+    for aliases in ([], ['C9999'], ['C0000', 'C0000']):
+        with pytest.raises(ValueError):
+            r._reading_candidates(packet, aliases, book['document'])
+
+
+def test_competing_edit_and_no_change_remain_separate(tmp_path):
+    book = ReviewStore(workspace(tmp_path)).snapshot()
+    packet = packet_for(book)
+    candidate, = r._reading_candidates(packet, ['C0000'], book['document'])
+    edit = deepcopy(candidate)
+    edit['id'] = 'P0000'
+    edit['proposal']['operation'] = 'edit'
+    edit['fields']['summary'] = 'Changed statement for checking.'
+    rows = r._reading_candidates(packet, ['C0000'], book['document'], [edit])
+    assert [p['id'] for p in rows] == ['P0000', 'N0000']
+    assert rows[1]['fields']['summary'] == book['accepted'][0]['summary']
+    prompt = r._challenge_prompt(packet, rows, book['document'], selected_aliases=['C0000'])
+    assert 'Do not combine candidates.' in prompt
+    edit['id'] = 'N0000'
+    with pytest.raises(ValueError, match='distinct'):
+        r._reading_candidates(packet, ['C0000'], book['document'], [edit])
+
+
+def test_inherited_parent_offsets_cannot_masquerade_as_exact_companion(tmp_path):
+    book = ReviewStore(workspace(tmp_path)).snapshot()
+    packet = packet_for(book)
+    packet['claims']['C0000']['quote'] = 'must carry a badge.'
+    with pytest.raises(ValueError, match='inconsistent main evidence'):
+        r._reading_candidates(packet, ['C0000'], book['document'])
+

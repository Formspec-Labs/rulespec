+def test_assessment_does_not_clear_component_evidence_warning(monkeypatch, tmp_path):
+    text = 'Visitors must carry a badge and must present it.'
+    doc = prepare_document(text)
+    book = compile_candidates(doc, [{'kind': 'requirement', 'actor': '', 'quote': text, 'summary': text,
+        'modality': 'must', 'modality_quote': 'must'}], {})
+    claim = book['accepted'][0]
+    issue = next(i for i in claim['issues'] if i['code'] == 'component_evidence_unresolved')
+    path = tmp_path / 'workspace'
+    for name, value in [('document.json', doc), ('rulebook.json', book), ('run.json', {})]:
+        e._save(path / name, value)
+    response = judgment()
+    response['judgments'][0]['rationale'] = 'The evidence warning is fixed.'
+    env, _ = provider(monkeypatch, tmp_path, [response])
+    result = r.refine_run(path, tmp_path / 'check', check_claims=[claim['id']], env_file=env)
+    assert issue in result['rulebook']['accepted'][0]['issues']
+    assert result['rulebook']['accepted'][0]['evidence'] == claim['evidence']
+
+
+def test_changed_snapshot_keeps_assessment_historical_without_claim_attachment(tmp_path):
+    store = ReviewStore(workspace(tmp_path))
+    before = store.snapshot()
+    claim_id = before['accepted'][0]['id']
+    after = store.apply({'action': 'edit', 'actor': 'reviewer', 'actor_kind': 'humanUser',
+        'expected_revision': 0, 'targets': [claim_id], 'rationale': 'Clarify wording.',
+        'replacements': [{'summary': 'Every visitor must carry a badge.'}]})
+    row = {'code': 'reading_assessment', 'reviewed_claim_id': claim_id,
+        'proposed_target_ids': [], 'reviewed_snapshot_sha256': r.content_digest(before),
+        'status': 'assessed', 'verdict': 'supported'}
+    action = r._observation_action([row], after, 'test')
+    assert action['targets'] == []
+    assert action['observations'][0]['status'] == 'stale'
+    assert 'claim_id' not in action['observations'][0]
+

+def test_replay_rejects_changed_selected_candidate_with_rehashed_manifest(monkeypatch, tmp_path):
+    path = workspace(tmp_path)
+    claim_id = ReviewStore(path).snapshot()['accepted'][0]['id']
+    env, _ = provider(monkeypatch, tmp_path, [judgment()])
+    output = tmp_path / 'check'
+    r.refine_run(path, output, check_claims=[claim_id], env_file=env)
+    file = output / 'check/window-0000/result.json'
+    record = e._load(file)
+    record['candidates'][0]['fields']['summary'] = 'A tampered reading.'
+    e._save(file, record)
+    e._write_manifest(output)
+    with pytest.raises(e.ReplayDriftError, match='Selected reading candidates differ'):
+        r.replay_refinement(output, tmp_path / 'replay')
+

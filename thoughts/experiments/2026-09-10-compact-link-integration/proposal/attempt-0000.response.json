            "text": "{\n  \"proposals\": [\n    {\n      \"rationale\": \"Paragraph (b)(1) creates an explicit exemption specifying that a stop need not be made at a streetcar crossing or industrial switching tracks within a business district, qualifying the baseline stopping requirement in paragraph (a) (C0000).\",\n      \"operation\": \"link\",\n      \"target\": \"C0009\",\n      \"qualifies\": [\"C0000\"]\n    },\n    {\n      \"rationale\": \"Paragraph (b)(2) creates an explicit exemption specifying that a stop need not be made at a railroad grade crossing when a police officer or crossing flagman directs traffic to proceed, qualifying the baseline stopping requirement in paragraph (a) (C0000).\",\n      \"operation\": \"link\",\n      \"target\": \"C0010\",\n      \"qualifies\": [\"C0000\"]\n    },\n    {\n      \"rationale\": \"Paragraph (b)(3) creates an explicit exemption specifying that a stop need not be made at a railroad grade crossing controlled by a functioning highway traffic signal transmitting a green indication permitting transit without stopping under local law, qualifying the baseline stopping requirement in paragraph (a) (C0000).\",\n      \"operation\": \"link\",\n      \"target\": \"C0011\",\n      \"qualifies\": [\"C0000\"]\n    },\n    {\n      \"rationale\": \"Paragraph (b)(4) creates an explicit exemption specifying that a stop need not be made at an abandoned railroad grade crossing marked with an abandonment sign, qualifying the baseline stopping requirement in paragraph (a) (C0000).\",\n      \"operation\": \"link\",\n      \"target\": \"C0012\",\n      \"qualifies\": [\"C0000\"]\n    },\n    {\n      \"rationale\": \"Paragraph (b)(5) creates an explicit exemption specifying that a stop need not be made at an industrial or spur line railroad grade crossing marked with an 'Exempt' sign, qualifying the baseline stopping requirement in paragraph (a) (C0000).\",\n      \"operation\": \"link\",\n      \"target\": \"C0013\",\n      \"qualifies\": [\"C0000\"]\n    }\n  ],\n  \"observations\": []\n}",

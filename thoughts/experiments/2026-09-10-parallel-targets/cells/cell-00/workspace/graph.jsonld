      "dcterms:description": "{\"action\":\"\",\"actor\":\"person\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:f1ceee3b1d34cf01e39019415200248ba756410f49798f84828af64d1e70e8bd\",\"urn:rulespec:document-understanding:assertion:000bb1ca20e2c302b11a9448712d043f9d60e5b4be9352958af48d3188e5608c\",\"urn:rulespec:document-understanding:assertion:1b67c65b04fd3fc9a0b860588ec7db7ca3093dd6ff2435beb688025dc3e72de5\",\"urn:rulespec:document-understanding:assertion:8e2cd176d86bcf19016c0bfaca2b5eb08f8c6778d20b5e20e29f87a9dacfc7de\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":3339,\"evidence\":[{\"end\":3339,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ad979bf4ad5cf2ad4ac16dfe4c9e0b4b6154459ef742ab907779b85452d0f6d9d:2973:3339:sha256-5efe9339d43363269055b547df8beaa854847e58399b32067ddccbf2a4d6ad75\",\"quote\":\"(b) No person may maintain, service, repair, or dispose of an appliance containing a class I or class II refrigerant or a non-exempt substitute refrigerant without:\\n\\n(1) Observing the applicable practices in §§ 82.155, 82.156, and 82.157; and\\n\\n(2) Using recovery and/or recycling equipment that is certified for that type of refrigerant and appliance under § 82.158.\",\"start\":2973},{\"end\":2986,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ad979bf4ad5cf2ad4ac16dfe4c9e0b4b6154459ef742ab907779b85452d0f6d9d:2980:2986:sha256-38a81e87e79631e602bf5fbd307ce2fcd382b1670c585ea09032aac778a80531\",\"quote\":\"person\",\"start\":2980},{\"end\":2990,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ad979bf4ad5cf2ad4ac16dfe4c9e0b4b6154459ef742ab907779b85452d0f6d9d:2977:2990:sha256-c7746375888ab16b0edcda245c37affad88166aea8ee75f6d9ebf4fa63c86b65\",\"quote\":\"No person may\",\"start\":2977}],\"id\":\"urn:rulespec:document-understanding:revision:4c7d239793438c7667b968440ed6cdd79086399c005f7337707de84c0486d3c6\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"prohibition\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:8e2cd176d86bcf19016c0bfaca2b5eb08f8c6778d20b5e20e29f87a9dacfc7de\",\"modality\":\"must_not\",\"modality_quote\":\"No person may\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:1904e37b508af3931b039771c5647d5ee088b80adccb62c6151495665c0a56a3\",\"origin\":\"aiSuggested\",\"quote\":\"(b) No person may maintain, service, repair, or dispose of an appliance containing a class I or class II refrigerant or a non-exempt substitute refrigerant without:\\n\\n(1) Observing the applicable practices in §§ 82.155, 82.156, and 82.157; and\\n\\n(2) Using recovery and/or recycling equipment that is certified for that type of refrigerant and appliance under § 82.158.\",\"references\":[\"§§ 82.155\",\"82.156\",\"82.157\",\"§ 82.158\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:9f2c15a9cb37059e430fa7d151290d875b961635ce6c5908c4c833301f580042\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":2973,\"summary\":\"No person may maintain, service, repair, or dispose of an appliance containing a class I or class II refrigerant or a non-exempt substitute refrigerant without both: (1) observing the applicable practices in §§ 82.155, 82.156, and 82.157; and (2) using recovery and/or recycling equipment that is certified for that type of refrigerant and appliance under § 82.158.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

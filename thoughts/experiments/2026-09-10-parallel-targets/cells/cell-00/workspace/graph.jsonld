      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:states-exemption",
      "rkaf:assertsValue": {
        "@value": "De minimis releases associated with good faith attempts to recycle or recover refrigerants are not subject to the venting prohibition, where (except for exempt substitutes) refrigerant releases are de minimis only if they occur when: (i) the applicable practices in §§ 82.155 and 82.156 are observed, the applicable practices in § 82.157 are observed for appliances that contain any class I or class II refrigerant or blend containing a class I or class II refrigerant, recovery and/or recycling machines that meet the requirements in § 82.158 are used whenever refrigerant is removed from an appliance, the technician certification provisions in § 82.161 are observed, and the reclamation requirements in § 82.164 are observed; or (ii) the requirements in subpart B of this part are observed.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

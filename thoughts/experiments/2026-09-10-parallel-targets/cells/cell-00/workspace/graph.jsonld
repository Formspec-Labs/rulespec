        "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ad979bf4ad5cf2ad4ac16dfe4c9e0b4b6154459ef742ab907779b85452d0f6d9d:2230:2727:sha256-f1cc619f3d71def1fe81bcb6f0295fd9eee77720c2c5bc0e22e8bb9c6c5621a4",

    {
      "@id": "urn:rulespec:document-understanding:revision:18adf4c4d41fabdf152f967156c32f2ecd3c2219958216f24da3b15c552b6bd9",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:18adf4c4d41fabdf152f967156c32f2ecd3c2219958216f24da3b15c552b6bd9",

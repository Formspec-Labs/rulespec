      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "(b) No person may maintain, service, repair, or dispose of an appliance containing a class I or class II refrigerant or a non-exempt substitute refrigerant without:\n\n(1) Observing the applicable practices in §§ 82.155, 82.156, and 82.157; and\n\n(2) Using recovery and/or recycling equipment that is certified for that type of refrigerant and appliance under § 82.158."
        },

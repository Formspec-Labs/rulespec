      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:649d4960fb45295b4c794b77019705a0d87dcfcaacaa303200dff482f374fb8d\",\"urn:rulespec:document-understanding:assertion:1fd93844027e4aca9989e9eff276376da4c93413a327a3da7f6573befc36f4a6\",\"urn:rulespec:document-understanding:assertion:987f08ffb0d6415fcdf4bcd68ebe1bee1d35fd0a608559bf97c32479c6e2aa99\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":470,\"evidence\":[{\"end\":470,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ad979bf4ad5cf2ad4ac16dfe4c9e0b4b6154459ef742ab907779b85452d0f6d9d:51:470:sha256-0a3be6d50f0d1d688aaf0b29185916d0310d5a730cdd1bb81c697952249d7f90\",\"quote\":\"(1) No person maintaining, servicing, repairing, or \\n            \\n            disposing of an appliance or industrial process refrigeration may knowingly vent or otherwise release into the environment any refrigerant from such appliances. Notwithstanding any other provision of this subpart, the following substitutes in the following end-uses are exempt from this prohibition and from the requirements of this subpart:\",\"start\":51}],\"id\":\"urn:rulespec:document-understanding:revision:7f4385d11e36c29bd8d6139c94ce4a2df01ef6143c2398b4a3cb24f852ab75ff\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"prohibition\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:987f08ffb0d6415fcdf4bcd68ebe1bee1d35fd0a608559bf97c32479c6e2aa99\",\"modality\":\"must_not\",\"modality_quote\":\"\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:b213d95b180f0303e8c4aab5cda1642b121bd2b999dc36f83ace86878e37cf89\",\"origin\":\"aiSuggested\",\"quote\":\"(1) No person maintaining, servicing, repairing, or \\n            \\n            disposing of an appliance or industrial process refrigeration may knowingly vent or otherwise release into the environment any refrigerant from such appliances. Notwithstanding any other provision of this subpart, the following substitutes in the following end-uses are exempt from this prohibition and from the requirements of this subpart:\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:4c1c0122dbf7b1b65fed778b29052068a3763a1a1adc76cc72c7dba01c16120e\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":51,\"summary\":\"No person maintaining, servicing, repairing, or disposing of an appliance or industrial process refrigeration may knowingly vent or otherwise release into the environment any refrigerant from such appliances, subject to the exemption for specific substitutes in specific end-uses.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",
      "dcterms:references": [
        {
          "@id": "urn:rulespec:document-understanding:assertion:649d4960fb45295b4c794b77019705a0d87dcfcaacaa303200dff482f374fb8d"
        },

    {
      "@id": "urn:rulespec:document-understanding:revision:6a65faa536f1c1553bc4d316cbf3aeba4b28d1f8ae26eb350d9ac821aedef11e",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:6a65faa536f1c1553bc4d316cbf3aeba4b28d1f8ae26eb350d9ac821aedef11e",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:a66824060cfa5af1c38090939ab7d90ecc62a3d7444267588578ae36a8449399",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:cb7016d8d9b0c78253b314be0bc161d0373047383d6f0c6933f43e13e9dd5ec7\",\"urn:rulespec:document-understanding:assertion:4575d96dcdee49e2f6f4fb6417d73cbe39f482a5cf0200981f7de4bfefaa1f3a\",\"urn:rulespec:document-understanding:assertion:0f2bf189967bd6564a1f2d1b2a6e9807b62e6182c218083557a3c6b2048e332a\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":1951,\"evidence\":[{\"end\":1951,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ad979bf4ad5cf2ad4ac16dfe4c9e0b4b6154459ef742ab907779b85452d0f6d9d:129:1951:sha256-b05180f2ce5f77ef31ff005b84b1e520666b53696488ac75a04920c48e8fa551\",\"quote\":\"disposing of an appliance or industrial process refrigeration may knowingly vent or otherwise release into the environment any refrigerant from such appliances. Notwithstanding any other provision of this subpart, the following substitutes in the following end-uses are exempt from this prohibition and from the requirements of this subpart:\\n\\n(i) Carbon dioxide in any application;\\n\\n(ii) Nitrogen in any application;\\n\\n(iii) Water in any application;\\n\\n(iv) Ammonia in commercial or industrial process refrigeration or in absorption units;\\n\\n(v) Chlorine in industrial process refrigeration (processing of chlorine and chlorine compounds);\\n\\n(vi) Hydrocarbons in industrial process refrigeration (processing of hydrocarbons);\\n\\n(vii) Ethane (R-170) in very low temperature refrigeration equipment and equipment for non-mechanical heat transfer;\\n\\n(viii) Propane (R-290) in retail food refrigerators and freezers—stand-alone units; household refrigerators, freezers, and combination refrigerators and freezers; self-contained room air conditioners for residential and light commercial air-conditioning and heat pumps; vending machines; self-contained commercial ice machines, very low temperature refrigeration equipment, and water coolers; and effective July 15, 2024, retail food refrigeration—refrigerated food processing and dispensing equipment;\\n\\n(ix) Isobutane (R-600a) in retail food refrigerators and freezers (stand-alone units only); household refrigerators, freezers, and combination refrigerators and freezers; and vending machines;\\n\\n(x) R-441A in retail food refrigerators and freezers (stand-alone units only); household refrigerators, freezers, and combination refrigerators and freezers; self-contained room air conditioners for residential and light commercial air-conditioning; heat pumps; and vending machines.\",\"start\":129},{\"end\":405,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ad979bf4ad5cf2ad4ac16dfe4c9e0b4b6154459ef742ab907779b85452d0f6d9d:395:405:sha256-682117d1e0c4a4539a2ac30d9bbcc34716b620cbfd4c1ffa72e66c751a5c0817\",\"quote\":\"are exempt\",\"start\":395}],\"id\":\"urn:rulespec:document-understanding:revision:6a65faa536f1c1553bc4d316cbf3aeba4b28d1f8ae26eb350d9ac821aedef11e\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"exemption\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:0f2bf189967bd6564a1f2d1b2a6e9807b62e6182c218083557a3c6b2048e332a\",\"modality\":\"not_required\",\"modality_quote\":\"are exempt\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:8bb78868d9c6e8c61aa84ec0941c42ec06a2004f556d7950794c53027b9d035f\",\"origin\":\"aiSuggested\",\"quote\":\"disposing of an appliance or industrial process refrigeration may knowingly vent or otherwise release into the environment any refrigerant from such appliances. Notwithstanding any other provision of this subpart, the following substitutes in the following end-uses are exempt from this prohibition and from the requirements of this subpart:\\n\\n(i) Carbon dioxide in any application;\\n\\n(ii) Nitrogen in any application;\\n\\n(iii) Water in any application;\\n\\n(iv) Ammonia in commercial or industrial process refrigeration or in absorption units;\\n\\n(v) Chlorine in industrial process refrigeration (processing of chlorine and chlorine compounds);\\n\\n(vi) Hydrocarbons in industrial process refrigeration (processing of hydrocarbons);\\n\\n(vii) Ethane (R-170) in very low temperature refrigeration equipment and equipment for non-mechanical heat transfer;\\n\\n(viii) Propane (R-290) in retail food refrigerators and freezers—stand-alone units; household refrigerators, freezers, and combination refrigerators and freezers; self-contained room air conditioners for residential and light commercial air-conditioning and heat pumps; vending machines; self-contained commercial ice machines, very low temperature refrigeration equipment, and water coolers; and effective July 15, 2024, retail food refrigeration—refrigerated food processing and dispensing equipment;\\n\\n(ix) Isobutane (R-600a) in retail food refrigerators and freezers (stand-alone units only); household refrigerators, freezers, and combination refrigerators and freezers; and vending machines;\\n\\n(x) R-441A in retail food refrigerators and freezers (stand-alone units only); household refrigerators, freezers, and combination refrigerators and freezers; self-contained room air conditioners for residential and light commercial air-conditioning; heat pumps; and vending machines.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:3803fe5998047aa8d4dd86525f40824c136971240bf8e9185ec1e94449276f8a\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":129,\"summary\":\"Notwithstanding any other provision of this subpart, the following substitutes in the following end-uses are exempt from the venting prohibition and from the requirements of this subpart: (i) Carbon dioxide in any application; (ii) Nitrogen in any application; (iii) Water in any application; (iv) Ammonia in commercial or industrial process refrigeration or in absorption units; (v) Chlorine in industrial process refrigeration (processing of chlorine and chlorine compounds); (vi) Hydrocarbons in industrial process refrigeration (processing of hydrocarbons); (vii) Ethane (R-170) in very low temperature refrigeration equipment and equipment for non-mechanical heat transfer; (viii) Propane (R-290) in retail food refrigerators and freezers—stand-alone units; household refrigerators, freezers, and combination refrigerators and freezers; self-contained room air conditioners for residential and light commercial air-conditioning and heat pumps; vending machines; self-contained commercial ice machines, very low temperature refrigeration equipment, and water coolers; and effective July 15, 2024, retail food refrigeration—refrigerated food processing and dispensing equipment; (ix) Isobutane (R-600a) in retail food refrigerators and freezers (stand-alone units only); household refrigerators, freezers, and combination refrigerators and freezers; and vending machines; and (x) R-441A in retail food refrigerators and freezers (stand-alone units only); household refrigerators, freezers, and combination refrigerators and freezers; self-contained room air conditioners for residential and light commercial air-conditioning; heat pumps; and vending machines.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

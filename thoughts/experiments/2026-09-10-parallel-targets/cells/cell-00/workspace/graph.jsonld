    {
      "@id": "urn:rulespec:document-understanding:assertion:26739c4b943079edf673ed2638a819857da4ddcdf9e0ab082a6fb0601af0c99f",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:6162b032b577c54a14977733ade865c1211aa15e2e08de4f3e67c6c7c77160c6",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:4fd0c74103ac638afd8dc3468fc98d3fbd1cb0d44c1bff543756ef9d0e0868ed",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:6bcae120bd58df02df40860d4609004a64298beb1c9c6f3120a2f3faa0f1305a",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"alternative_quotes\":[\"(i) The applicable practices in §§ 82.155 and 82.156 are observed, the applicable practices in § 82.157 are observed for appliances that contain any class I or class II refrigerant or blend containing a class I or class II refrigerant, recovery and/or recycling machines that meet the requirements in § 82.158 are used whenever refrigerant is removed from an appliance, the technician certification provisions in § 82.161 are observed, and the reclamation requirements in § 82.164 are observed; or\",\"(ii) The requirements in subpart B of this part are observed.\"],\"choice_text\":\"Releases qualify as de minimis only if either condition (i) is satisfied (all specified practices in §§ 82.155, 82.156, and if applicable 82.157, machine requirements under § 82.158, technician certification under § 82.161, and reclamation requirements under § 82.164 are observed) OR condition (ii) is satisfied (requirements in subpart B of this part are observed).\",\"kind\":\"exemption\",\"modality\":\"not_required\",\"summary\":\"De minimis releases associated with good faith attempts to recycle or recover refrigerants are not subject to the venting prohibition, where (except for exempt substitutes) refrigerant releases are de minimis only if they occur when: (i) the applicable practices in §§ 82.155 and 82.156 are observed, the applicable practices in § 82.157 are observed for appliances that contain any class I or class II refrigerant or blend containing a class I or class II refrigerant, recovery and/or recycling machines that meet the requirements in § 82.158 are used whenever refrigerant is removed from an appliance, the technician certification provisions in § 82.161 are observed, and the reclamation requirements in § 82.164 are observed; or (ii) the requirements in subpart B of this part are observed.\"}",
        "@type": "xsd:string"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },
    {
      "@id": "urn:rulespec:document-understanding:binding:f7186e05486ea2bffd4557a2607495473b7de5c40c85a9f271ce6d48569592b6",

        {
          "@id": "urn:rulespec:document-understanding:assertion:0f2bf189967bd6564a1f2d1b2a6e9807b62e6182c218083557a3c6b2048e332a"
        }
      ]
    },
    {
      "@id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ad979bf4ad5cf2ad4ac16dfe4c9e0b4b6154459ef742ab907779b85452d0f6d9d:1953:2790:sha256-ce8ea1f0f34f59e066d5ecef1c6700b77637a270ea5bef7842bb5ae4ca73bdae",
      "@type": "rkaf:SourceFragment",
      "oa:hasSource": "urn:rulespec:document-understanding:document:d979bf4ad5cf2ad4ac16dfe4c9e0b4b6154459ef742ab907779b85452d0f6d9d",
      "rkaf:fragmentIdentityScheme": "rkaf:carrier-local-fragment",
      "rkaf:sourceArtifactDigest": "sha256:d979bf4ad5cf2ad4ac16dfe4c9e0b4b6154459ef742ab907779b85452d0f6d9d",
      "rkaf:fragmentContentDigest": "sha256:ce8ea1f0f34f59e066d5ecef1c6700b77637a270ea5bef7842bb5ae4ca73bdae",
      "rkaf:selectorKind": [
        "oa:TextQuoteSelector",
        "oa:TextPositionSelector"
      ],
      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "(2) \n            De minimis\n             releases associated with good faith attempts to recycle or recover refrigerants are not subject to this prohibition. Except for exempt substitutes, refrigerant releases are \n            de minimis\n             only if they occur when:\n\n(i) The applicable practices in §§ 82.155 and 82.156 are observed, the applicable practices in § 82.157 are observed for appliances that contain any class I or class II refrigerant or blend containing a class I or class II refrigerant, recovery and/or recycling machines that meet the requirements in § 82.158 are used whenever refrigerant is removed from an appliance, the technician certification provisions in § 82.161 are observed, and the reclamation requirements in § 82.164 are observed; or\n\n(ii) The requirements in subpart B of this part are observed."
        },
        {
          "@type": "oa:TextPositionSelector",
          "oa:start": 1953,
          "oa:end": 2790,
          "rkaf:coordinateSystem": "rkaf:unicode-codepoint"
        }
      ]
    },

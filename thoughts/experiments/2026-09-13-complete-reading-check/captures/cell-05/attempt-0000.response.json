            "text": "{\n  \"judgments\": [\n    {\n      \"proposal_id\": \"P0005\",\n      \"source_refs\": [\"F000:F002\"],\n      \"rationale\": \"Clause (iii) imposes a reporting duty on the agency, not applicants. Adding a requirement that applicants must publish annual statistics improperly transfers another actor's duty and imports an unrelated reporting requirement.\",\n      \"verdict\": \"unsupported\"\n    },\n    {\n      \"proposal_id\": \"P0002\",\n      \"source_refs\": [\"F000:F001\"],\n      \"rationale\": \"Clause (i) grants permission to submit requests electronically, while clause (ii) establishes a content requirement for electronic requests under clause (i). The summary must state both the permission and the separate content requirement, so leaving the draft reading unchanged leaves it incomplete.\",\n      \"verdict\": \"unsupported\"\n    },\n    {\n      \"proposal_id\": \"P0003\",\n      \"source_refs\": [\"F003:F004\"],\n      \"rationale\": \"The draft reading already captures the actor, permission, action, object, and timing condition ('during opening hours'). Clause (ii) is a separate reporting obligation for the agency that should not be imported, making the unchanged reading independently complete.\",\n      \"verdict\": \"supported\"\n    },\n    {\n      \"proposal_id\": \"P0004\",\n      \"source_refs\": [\"F003:F004\"],\n      \"rationale\": \"The draft reading is already complete and faithful. Populating optional component fields such as action, object, and scope without resolving any missing governing meaning does not constitute a needed correction.\",\n      \"verdict\": \"unsupported\"\n    },\n    {\n      \"proposal_id\": \"P0000\",\n      \"source_refs\": [\"F000:F001\"],\n      \"rationale\": \"The edit accurately integrates the separate content requirement from clause (ii) into the electronic submission permission without inventing loss of permission for noncompliance or importing the agency's reporting duty from clause (iii).\",\n      \"verdict\": \"supported\"\n    },\n    {\n      \"proposal_id\": \"P0001\",\n      \"source_refs\": [\"F000:F001\"],\n      \"rationale\": \"Populating optional action and object components alone does not incorporate the governing content requirement from clause (ii) into the reading, leaving it incomplete.\",\n      \"verdict\": \"unsupported\"\n    }\n  ]\n}",

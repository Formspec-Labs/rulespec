  "material": {
    "statement": "Before filing an action under paragraph (1), the attorney general of the State involved must provide to the Commission written notice of that action and a copy of the complaint for that action, unless an exemption applies.",
    "sources": {
      "S0": {
        "source_id": "urn:rulespec:document-understanding:xml:67ec86bfeba62b525c5a8c25866393656515520b00ec13a0a6a3bd2d8db71c82",
        "document": {

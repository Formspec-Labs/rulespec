      "source": "urn:rulespec:document-understanding:document:43f75aaf4a19870db19d481dd6883f99ef4c606c7cb4914012a118a12fbce149",
      "text": "(b) Hazardous waste shall not be placed in an unwashed container that previously held an incompatible waste or material (see appendix to rule 3745-66-99 of the Administrative Code for examples), unless paragraph (B) of rule 3745-65-17 of the Administrative Code is complied with.\n\n",
      "claim_ids": [],
      "evidence_refs": [
        {
          "id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A43f75aaf4a19870db19d481dd6883f99ef4c606c7cb4914012a118a12fbce149:2321:2602:sha256-04507660ce61fa49064452f06dbfa48a6e33dd13583f3ec43388bc970bacf6fc",

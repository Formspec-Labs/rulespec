      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:bf658be5ac279dadcb9f41c70079d61756318a1b50f697a3a1c7b9da83824d5c\",\"urn:rulespec:document-understanding:assertion:f46e931845af3b3edc8332a2a901436775760caeca71924d4db4a4f3e469e2b7\",\"urn:rulespec:document-understanding:assertion:a702e84fce692cbb7ca17d6f835779c969b25eaef4a538d0fe20cc590195d231\",\"urn:rulespec:document-understanding:assertion:f7e51be3bb50019d1d42a19b18f6f28c813070b897f4aa975ac21e31aecdeb87\",\"urn:rulespec:document-understanding:assertion:0c4bc63fda0b4ead848e5996abf6879bd5a79944eb7c80311cd690b5a19d2814\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[{\"aliases\":[],\"id\":\"urn:rulespec:document-understanding:term:439ac6c78277042f21626d5a2b780e789d2dc444f69020a0e5e8e5b326ae1ee8\",\"label\":\"poverty line\",\"quote\":\"The term “poverty line” means the official poverty line defined by the Office of Management and Budget based on the most recent data available from the Bureau of the Census. The Secretary shall revise annually (or at any shorter interval the Secretary determines to be feasible and desirable) the poverty line, which shall be used as a criterion of eligibility in the community services block grant program established under this chapter. The required revision shall be accomplished by multiplying the official poverty line by the percentage change in the Consumer Price Index for All Urban Consumers during the annual or other interval immediately preceding the time at which the revision is made. Whenever a State determines that it serves the objectives of the block grant program established under this chapter, the State may revise the poverty line to not to exceed 125 percent of the official poverty line otherwise applicable under this paragraph.\",\"source_quotes\":[\"The term “poverty line” means the official poverty line defined by the Office of Management and Budget based on the most recent data available from the Bureau of the Census. The Secretary shall revise annually (or at any shorter interval the Secretary determines to be feasible and desirable) the poverty line, which shall be used as a criterion of eligibility in the community services block grant program established under this chapter. The required revision shall be accomplished by multiplying the official poverty line by the percentage change in the Consumer Price Index for All Urban Consumers during the annual or other interval immediately preceding the time at which the revision is made. Whenever a State determines that it serves the objectives of the block grant program established under this chapter, the State may revise the poverty line to not to exceed 125 percent of the official poverty line otherwise applicable under this paragraph.\"]}],\"effective_periods\":[],\"end\":16172,\"evidence\":[{\"end\":16172,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:15218:16172:sha256-1603cf9f43b064a37fb684b67c0b13a2cd9a6ea24370dcbf44b41db1b03cbdd8\",\"quote\":\"The term “poverty line” means the official poverty line defined by the Office of Management and Budget based on the most recent data available from the Bureau of the Census. The Secretary shall revise annually (or at any shorter interval the Secretary determines to be feasible and desirable) the poverty line, which shall be used as a criterion of eligibility in the community services block grant program established under this chapter. The required revision shall be accomplished by multiplying the official poverty line by the percentage change in the Consumer Price Index for All Urban Consumers during the annual or other interval immediately preceding the time at which the revision is made. Whenever a State determines that it serves the objectives of the block grant program established under this chapter, the State may revise the poverty line to not to exceed 125 percent of the official poverty line otherwise applicable under this paragraph.\",\"start\":15218},{\"end\":14490,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:14474:14490:sha256-6ef26080ba5b156360ab82a0af83047ddb9f669fc217c8e473039fb3c28c162d\",\"quote\":\"In this chapter:\",\"start\":14474},{\"end\":16172,\"field\":\"defined_terms:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:15218:16172:sha256-1603cf9f43b064a37fb684b67c0b13a2cd9a6ea24370dcbf44b41db1b03cbdd8\",\"quote\":\"The term “poverty line” means the official poverty line defined by the Office of Management and Budget based on the most recent data available from the Bureau of the Census. The Secretary shall revise annually (or at any shorter interval the Secretary determines to be feasible and desirable) the poverty line, which shall be used as a criterion of eligibility in the community services block grant program established under this chapter. The required revision shall be accomplished by multiplying the official poverty line by the percentage change in the Consumer Price Index for All Urban Consumers during the annual or other interval immediately preceding the time at which the revision is made. Whenever a State determines that it serves the objectives of the block grant program established under this chapter, the State may revise the poverty line to not to exceed 125 percent of the official poverty line otherwise applicable under this paragraph.\",\"start\":15218},{\"end\":16172,\"field\":\"defined_terms:0:source:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:15218:16172:sha256-1603cf9f43b064a37fb684b67c0b13a2cd9a6ea24370dcbf44b41db1b03cbdd8\",\"quote\":\"The term “poverty line” means the official poverty line defined by the Office of Management and Budget based on the most recent data available from the Bureau of the Census. The Secretary shall revise annually (or at any shorter interval the Secretary determines to be feasible and desirable) the poverty line, which shall be used as a criterion of eligibility in the community services block grant program established under this chapter. The required revision shall be accomplished by multiplying the official poverty line by the percentage change in the Consumer Price Index for All Urban Consumers during the annual or other interval immediately preceding the time at which the revision is made. Whenever a State determines that it serves the objectives of the block grant program established under this chapter, the State may revise the poverty line to not to exceed 125 percent of the official poverty line otherwise applicable under this paragraph.\",\"start\":15218}],\"id\":\"urn:rulespec:document-understanding:revision:1bd766b933526795be47fb4fe3fc3ecf5985e0b556697fd1b76de22cc88d274d\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"definition\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:f7e51be3bb50019d1d42a19b18f6f28c813070b897f4aa975ac21e31aecdeb87\",\"modality\":\"not_stated\",\"modality_quote\":\"\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:a36605af7be4454a9aa8cca44b1e8e57ad082c2c1532dac411d8970521090013\",\"origin\":\"aiSuggested\",\"quote\":\"The term “poverty line” means the official poverty line defined by the Office of Management and Budget based on the most recent data available from the Bureau of the Census. The Secretary shall revise annually (or at any shorter interval the Secretary determines to be feasible and desirable) the poverty line, which shall be used as a criterion of eligibility in the community services block grant program established under this chapter. The required revision shall be accomplished by multiplying the official poverty line by the percentage change in the Consumer Price Index for All Urban Consumers during the annual or other interval immediately preceding the time at which the revision is made. Whenever a State determines that it serves the objectives of the block grant program established under this chapter, the State may revise the poverty line to not to exceed 125 percent of the official poverty line otherwise applicable under this paragraph.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:d748599fdc1acd80c3205595406c884e025ba4765198bf6d01dd38ca36d6492a\",\"scope_quotes\":[\"In this chapter:\"],\"scope_text\":\"In this chapter\",\"section_id\":\"urn:rulespec:document-understanding:section:9a5224c808327e88c75f83b7cee8be31a7428e0086505e2dd784698ca11dd1d8\",\"start\":15218,\"summary\":\"In this chapter, the term \\\"poverty line\\\" means the official poverty line defined by the Office of Management and Budget based on the most recent data available from the Bureau of the Census.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

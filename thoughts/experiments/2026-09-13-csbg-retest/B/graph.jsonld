      "rkaf:hasContentDigest": "sha256:f7963969eaf83ede81ccec8bf2e29f364f91ed75dc483c0a4f8b3a6ccc001b89",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"Neither the Federal Government nor a State or local government receiving funds under this chapter\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:5a4d5a94898007832b688c4c678e614e03d5b363a3d0e1416e5db207c4fa9294\",\"urn:rulespec:document-understanding:assertion:c1e9ff89f238ffac1fc73c722bc5e4da01815b1d2628d9088947e4667f136358\",\"urn:rulespec:document-understanding:assertion:692e673d7107001fb422278db5da2130f3a2c20f819d32d0e3a33dce9c0c51f1\",\"urn:rulespec:document-understanding:assertion:b7e5fd3596f3f885754866cc4f1a51576f61fe040f462ad563740881e4747b3a\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":88263,\"evidence\":[{\"end\":88263,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:87573:88263:sha256-7f698273643ebaac09dd116e5fd1cab7db7c4e700d5aca2c7489efe5e05abd4a\",\"quote\":\"For any program carried out by the Federal Government, or by a State or local government under this chapter, the government shall consider, on the same basis as other nongovernmental organizations, religious organizations to provide the assistance under the program, so long as the program is implemented in a manner consistent with the Establishment Clause of the first amendment to the Constitution. Neither the Federal Government nor a State or local government receiving funds under this chapter shall discriminate against an organization that provides assistance under, or applies to provide assistance under, this chapter, on the basis that the organization has a religious character.\",\"start\":87573},{\"end\":88072,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:87975:88072:sha256-c6da95d4b790010f8fb0698bb5ed69c8d7689d99b8c8a90bae9e12162ac9700c\",\"quote\":\"Neither the Federal Government nor a State or local government receiving funds under this chapter\",\"start\":87975},{\"end\":88091,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:87975:88091:sha256-1790b51c477158bba6310268b8ee8788187f9b562701f21077a77edd37c609c2\",\"quote\":\"Neither the Federal Government nor a State or local government receiving funds under this chapter shall discriminate\",\"start\":87975}],\"id\":\"urn:rulespec:document-understanding:revision:ead00c591ef2ff9a6d7dfb798553028adf3cd89f196f746b53c08a3d3caa6560\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"prohibition\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:b7e5fd3596f3f885754866cc4f1a51576f61fe040f462ad563740881e4747b3a\",\"modality\":\"must_not\",\"modality_quote\":\"Neither the Federal Government nor a State or local government receiving funds under this chapter shall discriminate\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:1caff18198a5e74adec54eeb128a25d1a56c1f140914c370a1fc03f02a67e2fc\",\"origin\":\"aiSuggested\",\"quote\":\"For any program carried out by the Federal Government, or by a State or local government under this chapter, the government shall consider, on the same basis as other nongovernmental organizations, religious organizations to provide the assistance under the program, so long as the program is implemented in a manner consistent with the Establishment Clause of the first amendment to the Constitution. Neither the Federal Government nor a State or local government receiving funds under this chapter shall discriminate against an organization that provides assistance under, or applies to provide assistance under, this chapter, on the basis that the organization has a religious character.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:5755798d287db5332d8435f7dc9314a63bcd4bc44db40e74fb79af5fe4c37736\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"urn:rulespec:document-understanding:section:cfe00c4667f8a705b619c6842c9a05b4aaa1e3ace7adcf5723b0c39c5a6aa621\",\"start\":87573,\"summary\":\"Neither the Federal Government nor a State or local government receiving funds under this chapter shall discriminate against an organization that provides assistance under, or applies to provide assistance under, this chapter, on the basis that the organization has a religious character.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

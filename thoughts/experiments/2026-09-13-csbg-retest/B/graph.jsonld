      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"the Secretary\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:503a42bd1e709f229d8ba7da4322e72b8cd6a29e0dea2f24cd5392a869f24980\",\"urn:rulespec:document-understanding:assertion:5dd97424fc0cac41b7714b12f1049733742683ba973cc82dc79d9af262f569b7\",\"urn:rulespec:document-understanding:assertion:3c575c6f4c208498939ac20ef0e7168e060ead5a4b678957433f81634ed21188\",\"urn:rulespec:document-understanding:assertion:9e3e0567e57e84c09fb64e3d3822ec812bc6ec1939405fa04b546da329f6ded6\",\"urn:rulespec:document-understanding:assertion:1ed76ff1f4b414bbade40ad8b6549ac42a0c10a285a3fcaca3590e6f77dcdf24\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":104430,\"evidence\":[{\"end\":104430,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:104105:104430:sha256-61ebaec3a7919bb5250a9559211394d7f7aafbda7d39f8cb3757049da272d832\",\"quote\":\"The Secretary is authorized to make a grant to an eligible service provider to administer national or regional programs to provide instructional activities for low-income youth. In making such a grant, the Secretary shall give priority to eligible service providers that have a demonstrated ability to operate such a program.\",\"start\":104105},{\"end\":104320,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:104307:104320:sha256-67afe9d5c4310238267da793c265a616f9e90d554f2458a8065b7bb971d853b5\",\"quote\":\"the Secretary\",\"start\":104307},{\"end\":104326,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95b
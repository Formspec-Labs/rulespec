      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:states-requirement",
      "rkaf:assertsValue": {
        "@value": "Beginning with fiscal year 2000, the State's application and plan submitted to be eligible for a grant or allotment under section 9905 or 9906 of this title must contain an assurance that the State will secure from each eligible entity in the State, as a condition to receipt of funding by the entity through a community services block grant under this chapter for a program, a community action plan (which shall be submitted to the Secretary, at the request of the Secretary, with the State plan) that includes a community-needs assessment for the community served, which may be coordinated with community-needs assessments conducted for other programs.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

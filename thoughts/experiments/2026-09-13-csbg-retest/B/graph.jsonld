      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:8edabceda3484ea06c439bf33d9572c086da8e3210c43b1ab9f56efb5dfe533c\",\"urn:rulespec:document-understanding:assertion:42e7a7548e712c98a8c22ac0dbb2f9c87194aee245f466b8c615068702cefa4c\",\"urn:rulespec:document-understanding:assertion:cb1116ff086bc9ff744d52b33a43cb7a3b87cee4873295c80e98049ebca9e989\",\"urn:rulespec:document-understanding:assertion:6f0e2b18ecfca5bfcf27b5018221cee5320ab70589199bf88ed091c85ca7bd95\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":70543,\"evidence\":[{\"end\":70543,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:70027:70543:sha256-91e604693d4c823d306166a3982ca7c6f673309ef90fea1a5da82f8a9f83ed3a\",\"quote\":\"A determination to terminate the designation or reduce the funding of an eligible entity is reviewable by the Secretary. The Secretary shall, upon request, review such a determination. The review shall be completed not later than 90 days after the Secretary receives from the State all necessary documentation relating to the determination to terminate the designation or reduce the funding. If the review is not completed within 90 days, the determination of the State shall become final at the end of the 90th day.\",\"start\":70027},{\"end\":70543,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:70027:70543:sha256-91e604693d4c823d306166a3982ca7c6f673309ef90fea1a5da82f8a9f83ed3a\",\"quote\":\"A determination to terminate the designation or reduce the funding of an eligible entity is reviewable by the Secretary. The Secretary shall, upon request, review such a determination. The review shall be completed not later than 90 days after the Secretary receives from the State all necessary documentation relating to the determination to terminate the designation or reduce the funding. If the review is not completed within 90 days, the determination of the State shall become final at the end of the 90th day.\",\"start\":70027}],\"id\":\"urn:rulespec:document-understanding:revision:196bfd0a20d577cc81d45f2d66957f1da79a2abba1e9822efc5f9493158b40d0\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"statement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:6f0e2b18ecfca5bfcf27b5018221cee5320ab70589199bf88ed091c85ca7bd95\",\"modality\":\"not_stated\",\"modality_quote\":\"\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:0c210cf03ab2c9edb924b9fc8e9a06b644912c4d1346486f4d66cfe6febdbb00\",\"origin\":\"aiSuggested\",\"quote\":\"A determination to terminate the designation or reduce the funding of an eligible entity is reviewable by the Secretary. The Secretary shall, upon request, review such a determination. The review shall be completed not later than 90 days after the Secretary receives from the State all necessary documentation relating to the determination to terminate the designation or reduce the funding. If the review is not completed within 90 days, the determination of the State shall become final at the end of the 90th day.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:a1c7be7dce3ba17531dcd7261b9edd3501ef5c829570a8641ef5fa98739715d3\",\"scope_quotes\":[\"A determination to terminate the designation or reduce the funding of an eligible entity is reviewable by the Secretary. The Secretary shall, upon request, review such a determination. The review shall be completed not later than 90 days after the Secretary receives from the State all necessary documentation relating to the determination to terminate the designation or reduce the funding. If the review is not completed within 90 days, the determination of the State shall become final at the end of the 90th day.\"],\"scope_text\":\"If the review is not completed within 90 days\",\"section_id\":\"urn:rulespec:document-understanding:section:237b538fca368735fd9d07469584e65428d74fd94b694e39006074ead5c84559\",\"start\":70027,\"summary\":\"If the review by the Secretary is not completed within 90 days after receiving from the State all necessary documentation, the determination of the State shall become final at the end of the 90th day.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",
      "dcterms:references": [

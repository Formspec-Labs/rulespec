      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:aca21e3d3d269207555112c9ca5814592d85807480b3aebae9fe124c87389f29\",\"urn:rulespec:document-understanding:assertion:de85ea70b1d8dac1033442ec9ecac55a191bb2bff1abdecd17c1087514b343b5\",\"urn:rulespec:document-understanding:assertion:1ef7fa9056eb099e7c7584d9ea4f18bbd6b08dcd38d4dc740308f51b28fb8e85\",\"urn:rulespec:document-understanding:assertion:9c85fd20731c367fa15f72101471f03e3c3c3f7e8f2d3916e8100d6e556df135\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":67833,\"evidence\":[{\"end\":67833,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:66787:67833:sha256-6029fefdb7fae5c5b046e858a6ecbf3e689c9da8af5615d345e4ffce339968de\",\"quote\":\"The Secretary shall conduct in several States in each fiscal year evaluations (including investigations) of the use of funds received by the States under this chapter in order to evaluate compliance with the provisions of this chapter, and especially with respect to compliance with section 9908(b) of this title. The Secretary shall submit, to each State evaluated, a report containing the results of such evaluations, and recommendations of improvements designed to enhance the benefit and impact of the activities carried out with such funds for people in need. On receiving the report, the State shall submit to the Secretary a plan of action in response to the recommendations contained in the report. The results of the evaluations shall be submitted annually to the Chairperson of the Committee on Education and the Workforce of the House of Representatives and the Chairperson of the Committee on Labor and Human Resources of the Senate as part of the report submitted by the Secretary in accordance with section 9917(b)(2) of this title.\",\"start\":66787},{\"end\":67833,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:66787:67833:sha256-6029fefdb7fae5c5b046e858a6ecbf3e689c9da8af5615d345e4ffce339968de\",\"quote\":\"The Secretary shall conduct in several States in each fiscal year evaluations (including investigations) of the use of funds received by the States under this chapter in order to evaluate compliance with the provisions of this chapter, and especially with respect to compliance with section 9908(b) of this title. The Secretary shall submit, to each State evaluated, a report containing the results of such evaluations, and recommendations of improvements designed to enhance the benefit and impact of the activities carried out with such funds for people in need. On receiving the report, the State shall submit to the Secretary a plan of action in response to the recommendations contained in the report. The results of the evaluations shall be submitted annually to the Chairperson of the Committee on Education and the Workforce of the House of Representatives and the Chairperson of the Committee on Labor and Human Resources of the Senate as part of the report submitted by the Secretary in accordance with section 9917(b)(2) of this title.\",\"start\":66787}],\"id\":\"urn:rulespec:document-understanding:revision:cf98f20eeea6f04285369a827977823f66e33fa5ef64583a13d44fc21ae03bd5\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:9c85fd20731c367fa15f72101471f03e3c3c3f7e8f2d3916e8100d6e556df135\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:06b3fb98543293874fe818cc4de0e68996e5cd4a7ca5a9fec566d37f092f5968\",\"origin\":\"aiSuggested\",\"quote\":\"The Secretary shall conduct in several States in each fiscal year evaluations (including investigations) of the use of funds received by the States under this chapter in order to evaluate compliance with the provisions of this chapter, and especially with respect to compliance with section 9908(b) of this title. The Secretary shall submit, to each State evaluated, a report containing the results of such evaluations, and recommendations of improvements designed to enhance the benefit and impact of the activities carried out with such funds for people in need. On receiving the report, the State shall submit to the Secretary a plan of action in response to the recommendations contained in the report. The results of the evaluations shall be submitted annually to the Chairperson of the Committee on Education and the Workforce of the House of Representatives and the Chairperson of the Committee on Labor and Human Resources of the Senate as part of the report submitted by the Secretary in accordance with section 9917(b)(2) of this title.\",\"references\":[\"section 9917(b)(2) of this title\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:30342505db564fb29f9680ac6e1302e0672c9c70fe05055f8ec9492dd47669ff\",\"scope_quotes\":[\"The Secretary shall conduct in several States in each fiscal year evaluations (including investigations) of the use of funds received by the States under this chapter in order to evaluate compliance with the provisions of this chapter, and especially with respect to compliance with section 9908(b) of this title. The Secretary shall submit, to each State evaluated, a report containing the results of such evaluations, and recommendations of improvements designed to enhance the benefit and impact of the activities carried out with such funds for people in need. On receiving the report, the State shall submit to the Secretary a plan of action in response to the recommendations contained in the report. The results of the evaluations shall be submitted annually to the Chairperson of the Committee on Education and the Workforce of the House of Representatives and the Chairperson of the Committee on Labor and Human Resources of the Senate as part of the report submitted by the Secretary in accordance with section 9917(b)(2) of this title.\"],\"scope_text\":\"annually as part of the report submitted by the Secretary in accordance with section 9917(b)(2) of this title\",\"section_id\":\"urn:rulespec:document-understanding:section:c0349af1123d989776fe253553df69642696cd32996dd791c280bdbf3d513641\",\"start\":66787,\"summary\":\"The results of the evaluations shall be submitted annually to the Chairperson of the Committee on Education and the Workforce of the House of Representatives and the Chairperson of the Committee on Labor and Human Resources of the Senate as part of the report submitted by the Secretary in accordance with section 9917(b)(2) of this title.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

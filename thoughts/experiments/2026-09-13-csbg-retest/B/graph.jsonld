    {
      "@id": "urn:rulespec:document-understanding:revision:0e0e221e7bdecffa5de69ef263cd8b908c56bcd18048ee6a3d594f82e2192bec",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:0e0e221e7bdecffa5de69ef263cd8b908c56bcd18048ee6a3d594f82e2192bec",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:b9302f1871f774538f987a5b9a69dca30d21234f49ef80cb463a7aabfc860f2e",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"the Secretary\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:6b9ebe11fe588549c6c2833a49b4a89ba3bbd579ceec059a7ffec0c43e63fdbc\",\"urn:rulespec:document-understanding:assertion:2ba45829986d6511b5f9ac1715faef3d3b404f17e17df041d43a265e56e5d181\",\"urn:rulespec:document-understanding:assertion:bac05aad736454266cafef3fe5e4085ea9195f8aac8f483f5d62f723c7acd5da\",\"urn:rulespec:document-understanding:assertion:79067f41630cdc2e174ca32daa7e35ef05111d56e48508886c239972b3d09077\",\"urn:rulespec:document-understanding:assertion:b4001a1c6282f93afc312669f9e0d43f29dc4e12884b84b926fa5a5ebacbe54c\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":70543,\"evidence\":[{\"end\":70543,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:70027:70543:sha256-91e604693d4c823d306166a3982ca7c6f673309ef90fea1a5da82f8a9f83ed3a\",\"quote\":\"A determination to terminate the designation or reduce the funding of an eligible entity is reviewable by the Secretary. The Secretary shall, upon request, review such a determination. The review shall be completed not later than 90 days after the Secretary receives from the State all necessary documentation relating to the determination to terminate the designation or reduce the funding. If the review is not completed within 90 days, the determination of the State shall become final at the end of the 90th day.\",\"start\":70027},{\"end\":70161,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:70148:70161:sha256-d6dd2bb6d3c44b4545cc3f97cb6f8a38842ecd30d2c58ec3e1c53a8c1a0ac77c\",\"quote\":\"The Secretary\",\"start\":70148},{\"end\":70543,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:70027:70543:sha256-91e604693d4c823d306166a3982ca7c6f673309ef90fea1a5da82f8a9f83ed3a\",\"quote\":\"A determination to terminate the designation or reduce the funding of an eligible entity is reviewable by the Secretary. The Secretary shall, upon request, review such a determination. The review shall be completed not later than 90 days after the Secretary receives from the State all necessary documentation relating to the determination to terminate the designation or reduce the funding. If the review is not completed within 90 days, the determination of the State shall become final at the end of the 90th day.\",\"start\":70027}],\"id\":\"urn:rulespec:document-understanding:revision:0e0e221e7bdecffa5de69ef263cd8b908c56bcd18048ee6a3d594f82e2192bec\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:b4001a1c6282f93afc312669f9e0d43f29dc4e12884b84b926fa5a5ebacbe54c\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:238e2b1c99895743e46fcf09820536d0ca248dc15f5cc9f731baf9e01343efb5\",\"origin\":\"aiSuggested\",\"quote\":\"A determination to terminate the designation or reduce the funding of an eligible entity is reviewable by the Secretary. The Secretary shall, upon request, review such a determination. The review shall be completed not later than 90 days after the Secretary receives from the State all necessary documentation relating to the determination to terminate the designation or reduce the funding. If the review is not completed within 90 days, the determination of the State shall become final at the end of the 90th day.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:d4bfa7b2f98f895fa079a01101dc285d56c843cd4944402c0b76e1686821d7f3\",\"scope_quotes\":[\"A determination to terminate the designation or reduce the funding of an eligible entity is reviewable by the Secretary. The Secretary shall, upon request, review such a determination. The review shall be completed not later than 90 days after the Secretary receives from the State all necessary documentation relating to the determination to terminate the designation or reduce the funding. If the review is not completed within 90 days, the determination of the State shall become final at the end of the 90th day.\"],\"scope_text\":\"upon request\",\"section_id\":\"urn:rulespec:document-understanding:section:237b538fca368735fd9d07469584e65428d74fd94b694e39006074ead5c84559\",\"start\":70027,\"summary\":\"The Secretary shall, upon request, review a determination to terminate the designation or reduce the funding of an eligible entity.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

    {
      "@id": "urn:rulespec:document-understanding:revision:6b5435f48f029b99a0ad79b56fb1c1631cfd8e3d42f323954d74e737760485ab",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:6b5435f48f029b99a0ad79b56fb1c1631cfd8e3d42f323954d74e737760485ab",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:1b57f33af1d763627c664cf200b99861ac984e597c373bf6f27feb7b0e67295d",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"A religious organization that provides assistance under a program described in subsection (a)\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:526aae08130e0a46681fce1fa674ba405e199132596f29fad9c8891b3b3f7ebe\",\"urn:rulespec:document-understanding:assertion:e8c6208a9ccb4ddf4ffeafa03f58df9a35fde817f5ada811e849ebb2fa5e165b\",\"urn:rulespec:document-understanding:assertion:db4fd13d9d9e4d6b2a98355f33348b49cce9cb5680d71524acad0bca7ec9995e\",\"urn:rulespec:document-understanding:assertion:dbba6fb7444601b4bdcd3057032873ca61e92fa71110a2b562aa7031c695a545\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[\"For any program carried out by the Federal Government, or by a State or local government under this chapter, the government shall consider, on the same basis as other nongovernmental organizations, religious organizations to provide the assistance under the program, so long as the program is implemented in a manner consistent with the Establishment Clause of the first amendment to the Constitution. Neither the Federal Government nor a State or local government receiving funds under this chapter shall discriminate against an organization that provides assistance under, or applies to provide assistance under, this chapter, on the basis that the organization has a religious character.\"],\"defined_terms\":[],\"effective_periods\":[],\"end\":88551,\"evidence\":[{\"end\":88551,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:88324:88551:sha256-996f13124d38d2d8ee59ebdbc94b190d7ffd88a632d745fbdf54e04607d573cc\",\"quote\":\"A religious organization that provides assistance under a program described in subsection (a) shall retain its religious character and control over the definition, development, practice, and expression of its religious beliefs.\",\"start\":88324},{\"end\":88417,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:88324:88417:sha256-0235d397da3ced16686647fb7b74865404f8377d321f5289fbfd623d47e0b6e8\",\"quote\":\"A religious organization that provides assistance under a program described in subsection (a)\",\"start\":88324},{\"end\":88423,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:88418:88423:sha256-56ee5b508706bf2de91712d85d6d1e11ddbff01949142ed6e8c22e3b1bed1c71\",\"quote\":\"shall\",\"start\":88418},{\"end\":88263,\"field\":\"context:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:87573:88263:sha256-7f698273643ebaac09dd116e5fd1cab7db7c4e700d5aca2c7489efe5e05abd4a\",\"quote\":\"For any program carried out by the Federal Government, or by a State or local government under this chapter, the government shall consider, on the same basis as other nongovernmental organizations, religious organizations to provide the assistance under the program, so long as the program is implemented in a manner consistent with the Establishment Clause of the first amendment to the Constitution. Neither the Federal Government nor a State or local government receiving funds under this chapter shall discriminate against an organization that provides assistance under, or applies to provide assistance under, this chapter, on the basis that the organization has a religious character.\",\"start\":87573}],\"id\":\"urn:rulespec:document-understanding:revision:6b5435f48f029b99a0ad79b56fb1c1631cfd8e3d42f323954d74e737760485ab\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:dbba6fb7444601b4bdcd3057032873ca61e92fa71110a2b562aa7031c695a545\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:210bdef3d7ed902c026aa7cab6497c7ea5700aaf010d9a1cef894cbc3b61cd47\",\"origin\":\"aiSuggested\",\"quote\":\"A religious organization that provides assistance under a program described in subsection (a) shall retain its religious character and control over the definition, development, practice, and expression of its religious beliefs.\",\"references\":[\"subsection (a)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:5458c6684ef21a2f10b537aef6c33d6eeb75cb80d19ce81d71375cb3c59a268b\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"urn:rulespec:document-understanding:section:cfe00c4667f8a705b619c6842c9a05b4aaa1e3ace7adcf5723b0c39c5a6aa621\",\"start\":88324,\"summary\":\"A religious organization that provides assistance under a program carried out by the Federal Government, or by a State or local government under this chapter, shall retain its religious character and control over the definition, development, practice, and expression of its religious beliefs.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

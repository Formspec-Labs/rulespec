    {
      "@id": "urn:rulespec:document-understanding:revision:ecb276dc4537952b2e6f3b66d550536be49a676d4ea48d40a314b6a62df7e245",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:ecb276dc4537952b2e6f3b66d550536be49a676d4ea48d40a314b6a62df7e245",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:e4848a563cd6d401d53439f1f918df1cddb856ee52ed4f169a731a0064c9e1ae",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:f0594b786d2beb66fcade39c33929d29dc65aad22e91cdbe3389671df6e1769e\",\"urn:rulespec:document-understanding:assertion:261a6b8c9fcd1b313f4df2f99d6c6068f32ccdc3269c88b9ed3fcf81814ec5a0\",\"urn:rulespec:document-understanding:assertion:f3c62dd5e6444f4c1aace024f7b34f921c8ac2fa96ec8d0e7e107f490b8dc420\",\"urn:rulespec:document-understanding:assertion:ab27d1a3fd18d06ab99f80c486df529b58df7a528a6dc78effe45c324f42eb4c\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[\"Nothing in this chapter shall be construed to prohibit a State from testing participants in programs, activities, or services carried out or provided under this chapter for controlled substances. A State that conducts such testing shall inform the participants who test positive for any of such substances about the availability of treatment or rehabilitation services and refer such participants for appropriate treatment or rehabilitation services.\",\"(2) Administrative expenses\"],\"defined_terms\":[],\"effective_periods\":[],\"end\":86775,\"evidence\":[{\"end\":86775,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:86563:86775:sha256-bdaec3bfeddf8052fa66cc504598b4d3828644e5f9f31550167e92a4bcf9b95a\",\"quote\":\"Any funds provided under this chapter expended for such testing shall be considered to be expended for administrative expenses and shall be subject to the limitation specified in section 9907(b)(2) of this title.\",\"start\":86563},{\"end\":86775,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:86563:86775:sha256-bdaec3bfeddf8052fa66cc504598b4d3828644e5f9f31550167e92a4bcf9b95a\",\"quote\":\"Any funds provided under this chapter expended for such testing shall be considered to be expended for administrative expenses and shall be subject to the limitation specified in section 9907(b)(2) of this title.\",\"start\":86563},{\"end\":86531,\"field\":\"context:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:86081:86531:sha256-1f0392c74c19d0a1caef9fdd65626f1f73405d082df638e9645c4ae0deafbcd2\",\"quote\":\"Nothing in this chapter shall be construed to prohibit a State from testing participants in programs, activities, or services carried out or provided under this chapter for controlled substances. A State that conducts such testing shall inform the participants who test positive for any of such substances about the availability of treatment or rehabilitation services and refer such participants for appropriate treatment or rehabilitation services.\",\"start\":86081},{\"end\":86561,\"field\":\"context:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:86534:86561:sha256-0802d8dae6918423612b21dca0b844f4fbde4b228c3a870013541aa3f330c1a8\",\"quote\":\"(2) Administrative expenses\",\"start\":86534}],\"id\":\"urn:rulespec:document-understanding:revision:ecb276dc4537952b2e6f3b66d550536be49a676d4ea48d40a314b6a62df7e245\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:ab27d1a3fd18d06ab99f80c486df529b58df7a528a6dc78effe45c324f42eb4c\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:d819fc294713c782249065d8b6fad6ab3fdbd6302c1308e6b482eb080da1d42d\",\"origin\":\"aiSuggested\",\"quote\":\"Any funds provided under this chapter expended for such testing shall be considered to be expended for administrative expenses and shall be subject to the limitation specified in section 9907(b)(2) of this title.\",\"references\":[\"section 9907(b)(2) of this title\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:08b316f849b4b93369abcd251f99f72a7acb7c48c9da7a3dc8f92a64b4d9659c\",\"scope_quotes\":[\"Any funds provided under this chapter expended for such testing shall be considered to be expended for administrative expenses and shall be subject to the limitation specified in section 9907(b)(2) of this title.\"],\"scope_text\":\"Any funds provided under this chapter expended for such testing\",\"section_id\":\"urn:rulespec:document-understanding:section:214ad60901a587753e79aabc24ace858a542d5405e31b466690ba730688916c0\",\"start\":86563,\"summary\":\"Any funds provided under this chapter expended for drug testing of participants for controlled substances shall be considered to be expended for administrative expenses and shall be subject to the limitation specified in section 9907(b)(2) of this title.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

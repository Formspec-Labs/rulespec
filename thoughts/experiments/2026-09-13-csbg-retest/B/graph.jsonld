      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "Sec. 2. Providing Emergency Learning Scholarships for Students. The Secretary of Health and Human Services shall take steps, consistent with law, to allow funds available through the Community Services Block Grant program to be used by grantees and eligible entities to provide emergency learning scholarships to disadvantaged families for use by any child without access to in-person learning. These scholarships may be used for:"
        },

    {
      "@id": "urn:rulespec:document-understanding:binding:971fa93de330455ab77fff17731c72e860737ff708fd5510b5e0bd4b52938f57",
      "@type": "rkaf:EvidenceBinding",
      "rkaf:bindsAssertion": "urn:rulespec:document-understanding:assertion:5d701fb10367527ee7eada1d0f3285018e529a04a4fb899837f5b01a800ea98e",

    },
    {
      "@id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:41609:42812:sha256-6591031bbb4e8ba726d31e21c1136c2f46a23831754026b17cf1a006f5c87b7f",
      "@type": "rkaf:SourceFragment",
      "oa:hasSource": "urn:rulespec:document-understanding:document:26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023",
      "rkaf:fragmentIdentityScheme": "rkaf:carrier-local-fragment",
      "rkaf:sourceArtifactDigest": "sha256:26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023",
      "rkaf:fragmentContentDigest": "sha256:6591031bbb4e8ba726d31e21c1136c2f46a23831754026b17cf1a006f5c87b7f",
      "rkaf:selectorKind": [
        "oa:TextQuoteSelector",
        "oa:TextPositionSelector"
      ],
      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "(A) a description of the service delivery system, for services provided or coordinated with funds made available through grants made under section 9907(a) of this title, targeted to low-income individuals and families in communities within the State;\n\n(B) a description of how linkages will be developed to fill identified gaps in the services, through the provision of information, referrals, case management, and followup consultations;\n\n(C) a description of how funds made available through grants made under section 9907(a) of this title will be coordinated with other public and private resources; and\n\n(D) a description of how the local entity will use the funds to support innovative community and neighborhood-based initiatives related to the purposes of this chapter, which may include fatherhood initiatives and other initiatives with the goal of strengthening families and encouraging effective parenting;\n\n\n(4) an assurance that eligible entities in the State will provide, on an emergency basis, for the provision of such supplies and services, nutritious foods, and related services, as may be necessary to counteract conditions of starvation and malnutrition among low-income individuals;"
        },
        {
          "@type": "oa:TextPositionSelector",
          "oa:start": 41609,
          "oa:end": 42812,
          "rkaf:coordinateSystem": "rkaf:unicode-codepoint"
        }
      ]

      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "The chief executive officer of a State desiring to receive a grant or allotment under section 9905 or 9906 of this title shall designate, in an application submitted to the Secretary under subsection (b), an appropriate State agency that complies with the requirements of paragraph (2) to act as a lead agency for purposes of carrying out State activities under this chapter."
        },
        {
          "@type": "oa:TextPositionSelector",
          "oa:start": 36561,
          "oa:end": 36936,

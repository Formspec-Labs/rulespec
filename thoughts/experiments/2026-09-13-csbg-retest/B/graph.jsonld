    {
      "@id": "urn:rulespec:document-understanding:term:db0630346dbc6ad6aceaf71ca29be044acdfe59f9f79cc3a706af426c49ee8c6",
      "@type": "rkaf:LocalConcept",
      "skos:prefLabel": {
        "en": "eligible entity"
      },
      "skos:definition": {
        "en": "In this chapter, the term \"eligible entity\" means an entity that is an eligible entity described in paragraph (1) (as in effect on the day before October 27, 1998) as of the day before October 27, 1998, or is designated by the process described in section 9909 of this title (including an organization serving migrant or seasonal farmworkers that is so described or designated), and that has a tripartite board or other mechanism described in subsection (a) or (b), as appropriate, of section 9910 of this title."
      },
      "skos:inScheme": "urn:rulespec:document-understanding:defined-term-scheme:26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023",

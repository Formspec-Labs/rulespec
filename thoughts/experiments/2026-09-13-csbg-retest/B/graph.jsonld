          "@id": "urn:rulespec:document-understanding:assertion:3c482318b8fcec05948ace7440224adf162e961ae48263fe455842af4e916fa1"
        },
        {
          "@id": "urn:rulespec:document-understanding:assertion:44efb0ca8de2e7651e0937f6a1c28fe5bcb05bb4041c9bb79f965814aa07ca58"
        },
        {
          "@id": "urn:rulespec:document-understanding:assertion:fc68b0f479fa37cc1d5716d340c700ee968c2f732ab8b097cc197e33af2e2fbd"
        },

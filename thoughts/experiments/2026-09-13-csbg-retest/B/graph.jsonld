    {
      "@id": "urn:rulespec:document-understanding:revision:6395ce0c0e16b8b7f8634a7c6cc508bf3bec6add2b338faed587b202c79f8d70",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:6395ce0c0e16b8b7f8634a7c6cc508bf3bec6add2b338faed587b202c79f8d70",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:286f365162c246f52662da6889d0cf3be6b839a21bb7e9653a012390f8b9f351",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:e9054f81a41ee745982a7c63e2df1e6a6907b42deb4822ae474dbafa6c1551b9\",\"urn:rulespec:document-understanding:assertion:6744bcd08a208b59333068b788b485469a2a9c8fcfb792855f8f1cf0a5e62ff8\",\"urn:rulespec:document-understanding:assertion:86e366c8b6eda0549f64be5506f017725196fe706c78491715253ca187ca8390\",\"urn:rulespec:document-understanding:assertion:31d9b553ed8af465794bfaa3bea62a93a76420da4ebf5743136648819652f766\",\"urn:rulespec:document-understanding:assertion:8efe3176e8c805f0df8ca0a7a42e1ff257705ec840a3e560befb7bc13844948e\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":113144,\"evidence\":[{\"end\":112427,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:111706:112427:sha256-faacd91b9e43b9b4bf2cfe238a1afcd06418b51a05c41d8467c42e6187cadd67\",\"quote\":\"(1) In order to stimulate the development of new approaches to provide for greater self-sufficiency of the poor, to test and evaluate such new approaches, to disseminate project results and evaluation findings so that such approaches can be replicated, and to strengthen the integration, coordination, and redirection of activities to promote maximum self-sufficiency among the poor, the Secretary may make grants from funds appropriated under subsection (e) to eligible entities for the development and implementation of new and innovative approaches to deal with particularly critical needs or problems of the poor which are common to a number of communities. Grants may be made only with respect to applications which—\",\"start\":111706},{\"end\":113144,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:112429:113144:sha256-b725608f49010a5eb25319d26ea55488767bea2dc5ad9ccf657bae834002618c\",\"quote\":\"(A) involve activities which can be incorporated into or be closely coordinated with eligible entities’ ongoing programs;\\n\\n(B) involve significant new combinations of resources or new and innovative approaches involving partnership agreements;\\n\\n(C) are structured in a way that will, within the limits of the type of assistance or activities contemplated, most fully and effectively promote the purposes of the Community Services Block Grant Act [42 U.S.C. 9901 et seq.]; and\\n\\n(D) contain an assurance that the applicant for such grants will obtain an independent, methodologically sound evaluation of the effectiveness of the activities carried out with such grant and will submit such evaluation to the Secretary.\",\"start\":112429},{\"end\":112407,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:112387:112407:sha256-915dd51283b6defbd0ad9b3b94f541bb8c5879aff3c8eefecfb7cf117b221f93\",\"quote\":\"only with respect to\",\"start\":112387},{\"end\":112427,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:111706:112427:sha256-faacd91b9e43b9b4bf2cfe238a1afcd06418b51a05c41d8467c42e6187cadd67\",\"quote\":\"(1) In order to stimulate the development of new approaches to provide for greater self-sufficiency of the poor, to test and evaluate such new approaches, to disseminate project results and evaluation findings so that such approaches can be replicated, and to strengthen the integration, coordination, and redirection of activities to promote maximum self-sufficiency among the poor, the Secretary may make grants from funds appropriated under subsection (e) to eligible entities for the development and implementation of new and innovative approaches to deal with particularly critical needs or problems of the poor which are common to a number of communities. Grants may be made only with respect to applications which—\",\"start\":111706}],\"id\":\"urn:rulespec:document-understanding:revision:6395ce0c0e16b8b7f8634a7c6cc508bf3bec6add2b338faed587b202c79f8d70\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:31d9b553ed8af465794bfaa3bea62a93a76420da4ebf5743136648819652f766\",\"modality\":\"must\",\"modality_quote\":\"only with respect to\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:4e5ce501874c03f59f77c8aa48198d15053b2fd63a6fd9c69d8287150f01dd30\",\"origin\":\"aiSuggested\",\"quote\":\"(1) In order to stimulate the development of new approaches to provide for greater self-sufficiency of the poor, to test and evaluate such new approaches, to disseminate project results and evaluation findings so that such approaches can be replicated, and to strengthen the integration, coordination, and redirection of activities to promote maximum self-sufficiency among the poor, the Secretary may make grants from funds appropriated under subsection (e) to eligible entities for the development and implementation of new and innovative approaches to deal with particularly critical needs or problems of the poor which are common to a number of communities. Grants may be made only with respect to applications which—\\n\\n(A) involve activities which can be incorporated into or be closely coordinated with eligible entities’ ongoing programs;\\n\\n(B) involve significant new combinations of resources or new and innovative approaches involving partnership agreements;\\n\\n(C) are structured in a way that will, within the limits of the type of assistance or activities contemplated, most fully and effectively promote the purposes of the Community Services Block Grant Act [42 U.S.C. 9901 et seq.]; and\\n\\n(D) contain an assurance that the applicant for such grants will obtain an independent, methodologically sound evaluation of the effectiveness of the activities carried out with such grant and will submit such evaluation to the Secretary.\",\"references\":[\"Community Services Block Grant Act [42 U.S.C. 9901 et seq.]\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:77c34d174a32f150ddb03293c89b8f3253bc45a11e832e0d1926ac416cd0ed82\",\"scope_quotes\":[\"(1) In order to stimulate the development of new approaches to provide for greater self-sufficiency of the poor, to test and evaluate such new approaches, to disseminate project results and evaluation findings so that such approaches can be replicated, and to strengthen the integration, coordination, and redirection of activities to promote maximum self-sufficiency among the poor, the Secretary may make grants from funds appropriated under subsection (e) to eligible entities for the development and implementation of new and innovative approaches to deal with particularly critical needs or problems of the poor which are common to a number of communities. Grants may be made only with respect to applications which—\"],\"scope_text\":\"With respect to applications for grants under subsection (a)\",\"section_id\":\"urn:rulespec:document-understanding:section:5fba676d6775544d7cae048a3634eb9fe091aa0a96f2f732b41f08ff944d6890\",\"start\":111706,\"summary\":\"Grants under 42 U.S.C. 9925(a) may be made only with respect to applications which involve activities that can be incorporated into or be closely coordinated with eligible entities' ongoing programs; involve significant new combinations of resources or new and innovative approaches involving partnership agreements; are structured in a way that will, within the limits of the type of assistance or activities contemplated, most fully and effectively promote the purposes of the Community Services Block Grant Act; and contain an assurance that the applicant for such grants will obtain an independent, methodologically sound evaluation of the effectiveness of the activities carried out with such grant and will submit such evaluation to the Secretary.\",\"target_ids\":[],\"term_refs\":[\"urn:rulespec:document-understanding:term:576e9257cb479321316fb378bb4b88ddb844dc1e33b39dc213b46732e75aa46c\"],\"typed_values\":[]}",

      "rkaf:assertsValue": {
        "@value": "{\"actor\":\"The eligible service provider\",\"alternative_quotes\":[\"(A) a community-based advisory committee is established, with representatives from local youth, family, and social service organizations, schools, entities providing park and recreation services, and other community-based organizations serving high-risk youth; or\",\"(B) an existing community-based advisory board, commission, or committee with similar membership is utilized to serve as the committee described in subparagraph (A); and\"],\"choice_text\":\"The eligible service provider must either ensure a community-based advisory committee is established with specified representatives, or ensure an existing community-based advisory board, commission, or committee with similar membership is utilized.\",\"kind\":\"requirement\",\"modality\":\"must\",\"scope_text\":\"in each community in which a program is funded under this section\",\"summary\":\"The eligible service provider shall, in each community in which a program is funded under this section, ensure that: (A) a community-based advisory committee is established, with representatives from local youth, family, and social service organizations, schools, entities providing park and recreation services, and other community-based organizations serving high-risk youth; or (B) an existing community-based advisory board, commission, or committee with similar membership is utilized to serve as the committee described in subparagraph (A).\"}",
        "@type": "xsd:string"
      },

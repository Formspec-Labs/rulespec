    {
      "@id": "urn:rulespec:document-understanding:binding:592a318aaf644d2c6a202f26f0b4d908b1caadbeea2319be6b120434444fa274",
      "@type": "rkaf:EvidenceBinding",
      "rkaf:bindsAssertion": "urn:rulespec:document-understanding:assertion:0f8a751636ea498e4f2a1d9717885319e08b94e21481a45030906a559625688c",
      "rkaf:evidenceRole": "rkaf:textualEvidence",
      "rkaf:evidentiaryFunction": "rkaf:definesScope",

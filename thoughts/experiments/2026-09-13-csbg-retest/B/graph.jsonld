    {
      "@id": "urn:rulespec:document-understanding:revision:1a5f8c8f1eec8b08dea548875d4385c9a1044917fe394fcf40dfd61dcf9eee8d",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:1a5f8c8f1eec8b08dea548875d4385c9a1044917fe394fcf40dfd61dcf9eee8d",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:fa693bfa6416e1af527b9d475cff4c5cdbb1d939c988c9a1d3c1f09d9923b2a6",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"The eligible service provider\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:f638099c7aa34d82cfc7cb229e5097aa1cf7e59914830d0829464c767f5515bf\",\"urn:rulespec:document-understanding:assertion:19c57fc1672b0e8955f999858a65f3c25c0a930993dbc7651f464aa40c160291\",\"urn:rulespec:document-understanding:assertion:6451c08003d0d7efec59421d6310f8bf5615e8f356a35bcdd8b692e8f945bc04\",\"urn:rulespec:document-understanding:assertion:24ed635516feb7bdf2b56cac8ef70349daf99790947700f704241e528ec1694b\",\"urn:rulespec:document-understanding:assertion:4eb083523bcdd25b4c098ef15fddb964cdd68bc30736beb878946a9eedfaf039\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":106568,\"evidence\":[{\"end\":105748,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:105712:105748:sha256-f9b9c116fcd48bea70cb53ac79681f2811f993db70466fbab9239943517e0b6b\",\"quote\":\"(c) Advisory committee; partnerships\",\"start\":105712},{\"end\":105852,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:105749:105852:sha256-cb157ba9c97c251f44ee82b13ad864ea761fede60323da0c6d4b616e702286b9\",\"quote\":\"The eligible service provider shall, in each community in which a program is funded under this section—\",\"start\":105749},{\"end\":105870,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:105854:105870:sha256-95f73eccbcb87b56eb2ca1d56081911438cb01df0446a25b8738612b20ffe77d\",\"quote\":\"(1) ensure that—\",\"start\":105854},{\"end\":106568,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:105872:106568:sha256-7f9f276b1a56b2ae571279366007ae4db582db918da838bded373d45e0b6cae1\",\"quote\":\"(A) a community-based advisory committee is established, with representatives from local youth, family, and social service organizations, schools, entities providing park and recreation services, and other community-based organizations serving high-risk youth; or\\n\\n(B) an existing community-based advisory board, commission, or committee with similar membership is utilized to serve as the committee described in subparagraph (A); and\\n\\n\\n(2) enter into formal partnerships with youth-serving organizations or other appropriate social service entities in order to link program participants with year-round services in their home communities that support and continue the objectives of this chapter.\",\"start\":105872},{\"end\":105778,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:105749:105778:sha256-33e0bdbc3c87c6a11104f895351b5ecced29a04349fb919e322e50f3fa95c673\",\"quote\":\"The eligible service provider\",\"start\":105749},{\"end\":105784,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:105779:105784:sha256-56ee5b508706bf2de91712d85d6d1e11ddbff01949142ed6e8c22e3b1bed1c71\",\"quote\":\"shall\",\"start\":105779},{\"end\":105748,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:105712:105748:sha256-f9b9c116fcd48bea70cb53ac79681f2811f993db70466fbab9239943517e0b6b\",\"quote\":\"(c) Advisory committee; partnerships\",\"start\":105712},{\"end\":105852,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:105749:105852:sha256-cb157ba9c97c251f44ee82b13ad864ea761fede60323da0c6d4b616e702286b9\",\"quote\":\"The eligible service provider shall, in each community in which a program is funded under this section—\",\"start\":105749}],\"id\":\"urn:rulespec:document-understanding:revision:1a5f8c8f1eec8b08dea548875d4385c9a1044917fe394fcf40dfd61dcf9eee8d\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:4eb083523bcdd25b4c098ef15fddb964cdd68bc30736beb878946a9eedfaf039\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:c76d78dc8c83a600e60c797c04e20e8495e48cb4da7a88b9f2d944e5c1903e80\",\"origin\":\"aiSuggested\",\"quote\":\"(c) Advisory committee; partnerships The eligible service provider shall, in each community in which a program is funded under this section—\\n\\n(1) ensure that—\\n\\n(A) a community-based advisory committee is established, with representatives from local youth, family, and social service organizations, schools, entities providing park and recreation services, and other community-based organizations serving high-risk youth; or\\n\\n(B) an existing community-based advisory board, commission, or committee with similar membership is utilized to serve as the committee described in subparagraph (A); and\\n\\n\\n(2) enter into formal partnerships with youth-serving organizations or other appropriate social service entities in order to link program participants with year-round services in their home communities that support and continue the objectives of this chapter.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:df0ca257ac61a47e5e65ad8dd9c121acca5d9fabdc3508bc359eca672b808f7d\",\"scope_quotes\":[\"(c) Advisory committee; partnerships The eligible service provider shall, in each community in which a program is funded under this section—\"],\"scope_text\":\"in each community in which a program is funded under this section\",\"section_id\":\"urn:rulespec:document-understanding:section:f3eea5347c895856895eee6edec328881bdec01acc0faf09e4d4dd77b2ba0a81\",\"start\":105712,\"summary\":\"The eligible service provider shall, in each community in which a program is funded under this section, enter into formal partnerships with youth-serving organizations or other appropriate social service entities in order to link program participants with year-round services in their home communities that support and continue the objectives of this chapter.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

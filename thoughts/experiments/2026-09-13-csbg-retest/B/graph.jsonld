    {
      "@id": "urn:rulespec:document-understanding:revision:ee51f51c039afb7a4efcf65441efeb2a2c74631e3cd4146f757d1e27936ca899",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:ee51f51c039afb7a4efcf65441efeb2a2c74631e3cd4146f757d1e27936ca899",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:2fbba35d574a87c26cddb80d70b58af081e36e1518e20c8cb8441bc273e9d677",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"a State\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:1b5c71688b3c29c733a2eb9dc3dea767f46fe53c5dae77129b9462095354710c\",\"urn:rulespec:document-understanding:assertion:c8aa216724c8a2bd4fed89ac8e384f8762a84595fe486b7eca8ee8036a97a90d\",\"urn:rulespec:document-understanding:assertion:84a1e3548ce0462355ff58f308f573af5d87c5b717d0b540266b326110c26612\",\"urn:rulespec:document-understanding:assertion:952fa3b52de42b8c5330f87c5c3e15f9c67ffe600b9edd73c5e6b3b9f5a8e330\",\"urn:rulespec:document-understanding:assertion:3c3273d750502cb49168d07a16fbaa0650824c62ff20c241352ff2933bd7107c\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":40249,\"evidence\":[{\"end\":37850,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:37820:37850:sha256-e4eb5b6a8a7b9dd983a231deb98e7f6f65d6bc1675e6e9cecd8040a5250bb93d\",\"quote\":\"(b) State application and plan\",\"start\":37820},{\"end\":38333,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:37851:38333:sha256-584aa26d7ceb291cf4946eb3097ae0e9eaf3d8132583bd5b99429b4a3becd4c1\",\"quote\":\"Beginning with fiscal year 2000, to be eligible to receive a grant or allotment under section 9905 or 9906 of this title, a State shall prepare and submit to the Secretary an application and State plan covering a period of not less than 1 fiscal year and not more than 2 fiscal years. The plan shall be submitted not later than 30 days prior to the beginning of the first fiscal year covered by the plan, and shall contain such information as the Secretary shall require, including—\",\"start\":37851},{\"end\":38422,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:38335:38422:sha256-5a41c84474aa24cf672e53c4180cfdb03a238bfb10007ceb06382c577663f517\",\"quote\":\"(1) an assurance that funds made available through the grant or allotment will be used—\",\"start\":38335},{\"end\":38847,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:38424:38847:sha256-fd8ab136c0f1e722fe1809a4cd0b30f6e080e93e8b687b5450eff8b410333828\",\"quote\":\"(A) to support activities that are designed to assist low-income families and individuals, including families and individuals receiving assistance under part A of title IV of the Social Security Act (42 U.S.C. 601 et seq.), homeless families and individuals, migrant or seasonal farmworkers, and elderly low-income individuals and families, and a description of how such activities will enable the families and individuals—\",\"start\":38424},{\"end\":39925,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:38849:39925:sha256-c90ec600eb31a131f3d2d90e00b2bbe2d695eaa9e23d055def8f37c462c930e3\",\"quote\":\"(i) to remove obstacles and solve problems that block the achievement of self-sufficiency (including self-sufficiency for families and individuals who are attempting to transition off a State program carried out under part A of title IV of the Social Security Act);\\n\\n(ii) to secure and retain meaningful employment;\\n\\n(iii) to attain an adequate education, with particular attention toward improving literacy skills of the low-income families in the communities involved, which may include carrying out family literacy initiatives;\\n\\n(iv) to make better use of available income;\\n\\n(v) to obtain and maintain adequate housing and a suitable living environment;\\n\\n(vi) to obtain emergency assistance through loans, grants, or other means to meet immediate and urgent family and individual needs; and\\n\\n(vii) to achieve greater participation in the affairs of the communities involved, including the development of public and private grassroots partnerships with local law enforcement agencies, local housing authorities, private foundations, and other public and private partners to—\",\"start\":38849},{\"end\":40249,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:39927:40249:sha256-052d8954611d998c7e065eceb23341406831dd554e7a60c58d38fb73166217b0\",\"quote\":\"(I) document best practices based on successful grassroots intervention in urban areas, to develop methodologies for widespread replication; and\\n\\n(II) strengthen and improve relationships with local law enforcement agencies, which may include participation in activities such as neighborhood or community policing efforts;\",\"start\":39927},{\"end\":37850,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:37820:37850:sha256-e4eb5b6a8a7b9dd983a231deb98e7f6f65d6bc1675e6e9cecd8040a5250bb93d\",\"quote\":\"(b) State application and plan\",\"start\":37820},{\"end\":38333,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:37851:38333:sha256-584aa26d7ceb291cf4946eb3097ae0e9eaf3d8132583bd5b99429b4a3becd4c1\",\"quote\":\"Beginning with fiscal year 2000, to be eligible to receive a grant or allotment under section 9905 or 9906 of this title, a State shall prepare and submit to the Secretary an application and State plan covering a period of not less than 1 fiscal year and not more than 2 fiscal years. The plan shall be submitted not later than 30 days prior to the beginning of the first fiscal year covered by the plan, and shall contain such information as the Secretary shall require, including—\",\"start\":37851}],\"id\":\"urn:rulespec:document-understanding:revision:ee51f51c039afb7a4efcf65441efeb2a2c74631e3cd4146f757d1e27936ca899\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:3c3273d750502cb49168d07a16fbaa0650824c62ff20c241352ff2933bd7107c\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:5d169edea19f011e10515c8b95479f0ec271a3bde55425527568344187521468\",\"origin\":\"aiSuggested\",\"quote\":\"(b) State application and plan Beginning with fiscal year 2000, to be eligible to receive a grant or allotment under section 9905 or 9906 of this title, a State shall prepare and submit to the Secretary an application and State plan covering a period of not less than 1 fiscal year and not more than 2 fiscal years. The plan shall be submitted not later than 30 days prior to the beginning of the first fiscal year covered by the plan, and shall contain such information as the Secretary shall require, including—\\n\\n(1) an assurance that funds made available through the grant or allotment will be used—\\n\\n(A) to support activities that are designed to assist low-income families and individuals, including families and individuals receiving assistance under part A of title IV of the Social Security Act (42 U.S.C. 601 et seq.), homeless families and individuals, migrant or seasonal farmworkers, and elderly low-income individuals and families, and a description of how such activities will enable the families and individuals—\\n\\n(i) to remove obstacles and solve problems that block the achievement of self-sufficiency (including self-sufficiency for families and individuals who are attempting to transition off a State program carried out under part A of title IV of the Social Security Act);\\n\\n(ii) to secure and retain meaningful employment;\\n\\n(iii) to attain an adequate education, with particular attention toward improving literacy skills of the low-income families in the communities involved, which may include carrying out family literacy initiatives;\\n\\n(iv) to make better use of available income;\\n\\n(v) to obtain and maintain adequate housing and a suitable living environment;\\n\\n(vi) to obtain emergency assistance through loans, grants, or other means to meet immediate and urgent family and individual needs; and\\n\\n(vii) to achieve greater participation in the affairs of the communities involved, including the development of public and private grassroots partnerships with local law enforcement agencies, local housing authorities, private foundations, and other public and private partners to—\\n\\n(I) document best practices based on successful grassroots intervention in urban areas, to develop methodologies for widespread replication; and\\n\\n(II) strengthen and improve relationships with local law enforcement agencies, which may include participation in activities such as neighborhood or community policing efforts;\",\"references\":[\"section 9905\",\"section 9906\",\"part A of title IV of the Social Security Act\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:050296464021f35b00d7c957dc3a4a88350b4e6cc44d5e1b6f4549a9bbe5e419\",\"scope_quotes\":[\"(b) State application and plan Beginning with fiscal year 2000, to be eligible to receive a grant or allotment under section 9905 or 9906 of this title, a State shall prepare and submit to the Secretary an application and State plan covering a period of not less than 1 fiscal year and not more than 2 fiscal years. The plan shall be submitted not later than 30 days prior to the beginning of the first fiscal year covered by the plan, and shall contain such information as the Secretary shall require, including—\"],\"scope_text\":\"Beginning with fiscal year 2000, to be eligible to receive a grant or allotment under section 9905 or 9906 of this title\",\"section_id\":\"urn:rulespec:document-understanding:section:0b55006ce2c906add8328d3986f73bcd1ded9a87a908d01ae85b5595b9018d1b\",\"start\":37820,\"summary\":\"Beginning with fiscal year 2000, the State's application and plan submitted to be eligible for a grant or allotment under section 9905 or 9906 of this title must contain an assurance that funds made available through the grant or allotment will be used to support activities designed to assist low-income families and individuals (including families and individuals receiving assistance under part A of title IV of the Social Security Act, homeless families and individuals, migrant or seasonal farmworkers, and elderly low-income individuals and families), and a description of how such activities will enable families and individuals: (i) to remove obstacles and solve problems blocking self-sufficiency (including for those transitioning off part A of title IV assistance); (ii) to secure and retain meaningful employment; (iii) to attain an adequate education, with particular attention toward improving literacy skills in the communities involved (which may include family literacy initiatives); (iv) to make better use of available income; (v) to obtain and maintain adequate housing and a suitable living environment; (vi) to obtain emergency assistance through loans, grants, or other means for immediate and urgent needs; and (vii) to achieve greater community participation, including grassroots partnerships with local law enforcement, housing authorities, private foundations, and other partners to document best practices for urban replication and strengthen relationships with local law enforcement (which may include neighborhood or community policing efforts).\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",
      "dcterms:references": [
        {
          "@id": "urn:rulespec:document-understanding:assertion:1b5c71688b3c29c733a2eb9dc3dea767f46fe53c5dae77129b9462095354710c"

      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:269f96b493fb2d39328c16ad167906aa1a53c83ffcbecab2ca320c7a25bfd05c\",\"urn:rulespec:document-understanding:assertion:abbbf3aba74ab2c6a8c29b47e0fd75711994aa4e0d3ecc02e28f532b09138a27\",\"urn:rulespec:document-understanding:assertion:9768a7c59c20ce735546bb0116c8c49c1e75ca569909e058dc199e2a8f0f54c1\",\"urn:rulespec:document-understanding:assertion:504b6fbd3b6aae45b202a2dd227168b1a1ea346c981c59cfab254b8c393c4ab5\",\"urn:rulespec:document-understanding:assertion:34192573eba39215cadebe6104c5f48aa0f1fd71faa9edaefe3dc09b37957e41\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[{\"aliases\":[],\"id\":\"urn:rulespec:document-understanding:term:e1c9494d510d730eddff67c6b10b797e58a4d05b5defafb759ea0e25f7d7c973\",\"label\":\"low-income individual eligible to participate in a project conducted under this section\",\"quote\":\"(3) A low-income individual eligible to participate in a project conducted under this section is any individual eligible to receive assistance under the program funded part 1\\n\\n1 So in original. Probably should be “under part”.\\n\\n A of title IV of the Social Security Act [42 U.S.C. 601 et seq.] of the State in which the individual resides and any other individual whose income level does not exceed 100 percent of the official poverty line as defined by the Office of Management and Budget and revised in accordance with section 9902(2) of this title.\",\"source_quotes\":[\"(3) A low-income individual eligible to participate in a project conducted under this section is any individual eligible to receive assistance under the program funded part 1\\n\\n1 So in original. Probably should be “under part”.\\n\\n A of title IV of the Social Security Act [42 U.S.C. 601 et seq.] of the State in which the individual resides and any other individual whose income level does not exceed 100 percent of the official poverty line as defined by the Office of Management and Budget and revised in accordance with section 9902(2) of this title.\"]}],\"effective_periods\":[],\"end\":129222,\"evidence\":[{\"end\":128845,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:128671:128845:sha256-499a90245667a6f0f8645a86f1ed32a8190d711cdc2292a6e5dd4f67ae6e20c6\",\"quote\":\"(3) A low-income individual eligible to participate in a project conducted under this section is any individual eligible to receive assistance under the program funded part 1\",\"start\":128671},{\"end\":128897,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:128847:128897:sha256-884f80fcce9e6ac3d3b413e2059e15134e572a30c7eeaed910cc465b284a1e42\",\"quote\":\"1 So in original. Probably should be “under part”.\",\"start\":128847},{\"end\":129222,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:128899:129222:sha256-0acd2d3647ffc169c796c02d72256bc2b4a67847a0e4a4353d860f1e9599b971\",\"quote\":\" A of title IV of the Social Security Act [42 U.S.C. 601 et seq.] of the State in which the individual resides and any other individual whose income level does not exceed 100 percent of the official poverty line as defined by the Office of Management and Budget and revised in accordance with section 9902(2) of this title.\",\"start\":128899},{\"end\":128845,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:128671:128845:sha256-499a90245667a6f0f8645a86f1ed3
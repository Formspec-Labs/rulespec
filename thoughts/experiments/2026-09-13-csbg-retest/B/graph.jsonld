    {
      "@id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:27936:28646:sha256-0ccc78999d8251cfc48e1f2d8bfd523cb624c053da648e5d37cde8b989f627d0",
      "@type": "rkaf:SourceFragment",
      "oa:hasSource": "urn:rulespec:document-understanding:document:26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023",
      "rkaf:fragmentIdentityScheme": "rkaf:carrier-local-fragment",
      "rkaf:sourceArtifactDigest": "sha256:26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023",
      "rkaf:fragmentContentDigest": "sha256:0ccc78999d8251cfc48e1f2d8bfd523cb624c053da648e5d37cde8b989f627d0",
      "rkaf:selectorKind": [
        "oa:TextQuoteSelector",
        "oa:TextPositionSelector"
      ],
      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "No State may spend more than the greater of $55,000, or 5 percent, of the grant received under section 9905 of this title or State allotment received under section 9906 of this title for administrative expenses, including monitoring activities. Funds to be spent for such expenses shall be taken from the portion of the grant under section 9905 of this title or State allotment that remains after the State makes grants to eligible entities under subsection (a). The cost of activities conducted under paragraph (1)(A) shall not be considered to be administrative expenses. The startup cost and cost of administrative activities conducted under subsection (c) shall be considered to be administrative expenses."
        },
        {
          "@type": "oa:TextPositionSelector",
          "oa:start": 27936,
          "oa:end": 28646,
          "rkaf:coordinateSystem": "rkaf:unicode-codepoint"
        }
      ]
    },

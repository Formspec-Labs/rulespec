      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"State\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:d3c8741622e28dca1c9b81c6cf66ae6e081a7585963ecbdd6abb320c051a01f7\",\"urn:rulespec:document-understanding:assertion:adcfb6a097f33835f9e98bac6aaa1e01961739fa1a2e47eb4f8ff05c95d73ff9\",\"urn:rulespec:document-understanding:assertion:32d4051e0fd690256e437d59d82dfd904c5238a021e45b0e7c00e1f18830c4a8\",\"urn:rulespec:document-understanding:assertion:b392a264cb229defa23f845d1304b3d80fca65bd6a14dfe0102b534814ea50d6\",\"urn:rulespec:document-understanding:assertion:4ee10b4393233be585ab4b21e7d2765998defee9095d5fa90add2dce4b4e0673\",\"urn:rulespec:document-understanding:assertion:dac999d405d23ce3850f51c2fa92dd5725061a5eda6d7903e379405e7151e7d0\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":27909,\"evidence\":[{\"end\":26276,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:26256:26276:sha256-48199a5a79ebce7b33fc8b9d76880c9b50a9385f015b3c974ffcbaf5772fe56c\",\"quote\":\"(1) Use of remainder\",\"start\":26256},{\"end\":26588,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:26277:26588:sha256-aa538aa00af95f7c408e6ce9d451df4b12e8ddce453f448fe3df053af7b707b4\",\"quote\":\"If a State uses less than 100 percent of the grant or allotment received under section 9905 or 9906 of this title to make grants under subsection (a), the State shall use the remainder of the grant or allotment under section 9905 or 9906 of this title (subject to paragraph (2)) for activities that may include—\",\"start\":26277},{\"end\":27909,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:26590:27909:sha256-8e49b3b1de77b5bc0e4764034d037439fddbb252a4d3e43126578fa30c03efb8\",\"quote\":\"(A) providing training and technical assistance to those entities in need of such training and assistance;\\n\\n(B) coordinating State-operated programs and services, and at the option of the State, locally-operated programs and services, targeted to low-income children and families with services provided by eligible entities and other organizations funded under this chapter, including detailing appropriate employees of State or local agencies to entities funded under this chapter, to ensure increased access to services provided by such State or local agencies;\\n\\n(C) supporting statewide coordination and communication among eligible entities;\\n\\n(D) analyzing the distribution of funds made available under this chapter within the State to determine if such funds have been targeted to the areas of greatest need;\\n\\n(E) supporting asset-building programs for low-income individuals, such as programs supporting individual development accounts;\\n\\n(F) supporting innovative programs and activities conducted by community action agencies or other neighborhood-based organizations to eliminate poverty, promote self-sufficiency, and promote community revitalization;\\n\\n(G) supporting State charity tax credits as described in subsection (c); and\\n\\n(H) supporting other activities, consistent with the purposes of this chapter.\",\"start\":26590},{\"end\":26443,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:26438:26443:sha256-56ee5b508706bf2de91712d85d6d1e11ddbff01949142ed6e8c22e3b1bed1c71\",\"quote\":\"shall\",\"start\":26438},{\"end\":26276,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:26256:26276:sha256-48199a5a79ebce7b33fc8b9d76880c9b50a9385f015b3c974ffcbaf5772fe56c\",\"quote\":\"(1) Use of remainder\",\"start\":26256},{\"end\":26588,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:26277:26588:sha256-aa538aa00af95f7c408e6ce9d451df4b12e8ddce453f448fe3df053af7b707b4\",\"quote\":\"If a State uses less than 100 percent of the grant or allotment received under section 9905 or 9906 of this title to make grants under subsection (a), the State shall use the remainder of the grant or allotment under section 9905 or 9906 of this title (subject to paragraph (2)) for activities that may include—\",\"start\":26277}],\"id\":\"urn:rulespec:document-understanding:revision:a07b1e83e57907c199fa5d6970abcdc7e8ff34ccad81a6d6f217bb7d55fb98f6\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:4ee10b4393233be585ab4b21e7d2765998defee9095d5fa90add2dce4b4e0673\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:6acba38c0c9fffa1ebefb257ca338c28fb0dba8370319c439e6e57622fde4a32\",\"origin\":\"aiSuggested\",\"quote\":\"(1) Use of remainder If a State uses less than 100 percent of the grant or allotment received under section 9905 or 9906 of this title to make grants under subsection (a), the State shall use the remainder of the grant or allotment under section 9905 or 9906 of this title (subject to paragraph (2)) for activities that may include—\\n\\n(A) providing training and technical assistance to those entities in need of such training and assistance;\\n\\n(B) coordinating State-operated programs and services, and at the option of the State, locally-operated programs and services, targeted to low-income children and families with services provided by eligible entities and other organizations funded under this chapter, including detailing appropriate employees of State or local agencies to entities funded under this chapter, to ensure increased access to services provided by such State or local agencies;\\n\\n(C) supporting statewide coordination and communication among eligible entities;\\n\\n(D) analyzing the distribution of funds made available under this chapter within the State to determine if such funds have been targeted to the areas of greatest need;\\n\\n(E) supporting asset-building programs for low-income individuals, such as programs supporting individual development accounts;\\n\\n(F) supporting innovative programs and activities conducted by community action agencies or other neighborhood-based organizations to eliminate poverty, promote self-sufficiency, and promote community revitalization;\\n\\n(G) supporting State charity tax credits as described in subsection (c); and\\n\\n(H) supporting other activities, consistent with the purposes of this chapter.\",\"references\":[\"section 9905\",\"9906\",\"subsection (a)\",\"paragraph (2)\",\"subsection (c)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:dfcb0a867a5a370c8ed8ef59ed0828387840825f4bf0b19685a5233a608035c1\",\"scope_quotes\":[\"(1) Use of remainder If a State uses less than 100 percent of the grant or allotment received under section 9905 or 9906 of this title to make grants under subsection (a), the State shall use the remainder of the grant or allotment under section 9905 or 9906 of this title (subject to paragraph (2)) for activities that may include—\"],\"scope_text\":\"If a State uses less than 100 percent of the grant or allotment received under section 9905 or 9906 of this title to make grants under subsection (a).\",\"section_id\":\"urn:rulespec:document-understanding:section:065d5bd1b1fd12e07012730aaa12714e330211d213042d09aad361bcfa67ebfa\",\"start\":26256,\"summary\":\"If a State uses less than 100 percent of the grant or allotment received under section 9905 or 9906 of this title to make grants under subsection (a), the State shall use the remainder of the grant or allotment under section 9905 or 9906 of this title (subject to paragraph (2)) for activities that may include providing training and technical assistance to entities in need; coordinating State-operated and, at the State's option, locally-operated programs targeted to low-income children and families with services provided by eligible entities and other funded organizations, including detailing appropriate employees; supporting statewide coordination and communication among eligible entities; analyzing fund distribution to determine targeting to areas of greatest need; supporting asset-building programs for low-income individuals such as individual development accounts; supporting innovative programs conducted by community action agencies or neighborhood-based organizations; supporting State charity tax credits as described in subsection (c); and supporting other activities consistent with the purposes of this chapter.\",\"target_ids\":[],\"term_refs\":[\"urn:rulespec:document-understanding:term:28aeae45433297cac74db47f9b0c3a69575405081d8e0aae4329cbf4510e8200\"],\"typed_values\":[]}",
      "dcterms:references": [

      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:655aa0d012c2285c92ca7f78846fe5830112e80132085fbd1e9291ba6aad61c3\",\"urn:rulespec:document-understanding:assertion:1ac9aa2c770e14f143e75466b1e62bf62c479360a99327cf79a97e15f8651be0\",\"urn:rulespec:document-understanding:assertion:75986b2f059fe59abab33dc10bdc24a9bb91dd78fe31c15b01e13b5c19a87a65\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[\"Except as provided in paragraph (2), any religious organization providing assistance under any program described in subsection (a) shall be subject to the same regulations as other nongovernmental organizations to account in accord with generally accepted accounting principles for the use of such funds provided under such program.\"],\"defined_terms\":[],\"effective_periods\":[],\"end\":90099,\"evidence\":[{\"end\":90099,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:89925:90099:sha256-f948f095949c96c104e09e36a19574c85694c68535fbffc5803b72ef57b1d52d\",\"quote\":\"Such organization shall segregate government funds provided under such program into a separate account. Only the government funds shall be subject to audit by the government.\",\"start\":89925},{\"end\":89903,\"field\":\"context:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:89571:89903:sha256-78ffadc5d148f304287c452ea7a013f121080ee1428ba6ba9d7238447f95be22\",\"quote\":\"Except as provided in paragraph (2), any religious organization providing assistance under any program described in subsection (a) shall be subject to the same regulations as other nongovernmental organizations to account in accord with generally accepted accounting principles for the use of such funds provided under such program.\",\"start\":89571}],\"id\":\"urn:rulespec:document-understanding:revision:f1ad8d8ead26c2c4ddad3b840eaab6de8a08481b6ee349db0a004b8c02b76f5f\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"statement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:75986b2f059fe59abab33dc10bdc24a9bb91dd78fe31c15b01e13b5c19a87a65\",\"modality\":\"not_stated\",\"modality_quote\":\"\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:68ef1b759e60f11748eaaed870d524059b6d2e6053a3908ce84a077b67acf750\",\"origin\":\"aiSuggested\",\"quote\":\"Such organization shall segregate government funds provided under such program into a separate account. Only the government funds shall be subject to audit by the government.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:ed708bbb32c5f8c73e7fe95d8f5d97625159df6b1f20dcfb161ef3b2771ded9a\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"urn:rulespec:document-understanding:section:cfe00c4667f8a705b619c6842c9a05b4aaa1e3ace7adcf5723b0c39c5a6aa621\",\"start\":89925,\"summary\":\"Where a religious organization segregates government funds provided under a program described in subsection (a) into a separate account, only the government funds shall be subject to audit by the government.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

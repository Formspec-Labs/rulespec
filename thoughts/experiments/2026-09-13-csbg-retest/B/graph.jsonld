    {
      "@id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:4011:4256:sha256-f485a858b2d7fd3556734066ce1c4dbdcedffd46d4d6c8ec4fe5f3ccda427b78",
      "@type": "rkaf:SourceFragment",
      "oa:hasSource": "urn:rulespec:document-understanding:document:26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023",
      "rkaf:fragmentIdentityScheme": "rkaf:carrier-local-fragment",
      "rkaf:sourceArtifactDigest": "sha256:26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023",
      "rkaf:fragmentContentDigest": "sha256:f485a858b2d7fd3556734066ce1c4dbdcedffd46d4d6c8ec4fe5f3ccda427b78",
      "rkaf:selectorKind": [
        "oa:TextQuoteSelector",
        "oa:TextPositionSelector"
      ],
      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "(i) private, religious, charitable, and neighborhood-based organizations; and\n\n(ii) individual citizens, and business, labor, and professional groups, who are able to influence the quantity and quality of opportunities and services for the poor."
        },
        {
          "@type": "oa:TextPositionSelector",
          "oa:start": 4011,
          "oa:end": 4256,
          "rkaf:coordinateSystem": "rkaf:unicode-codepoint"

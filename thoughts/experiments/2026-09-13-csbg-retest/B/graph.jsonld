    {
      "@id": "urn:rulespec:document-understanding:assertion:f27d839c3ad153d9b3ee8a8dd339090a2c33665ddb608e0c56a88192555174cb",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:4b80bc242bf4108132092097a8f5b641e6a56bd640c5f048e8bbcbf82862ca04",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:3d5314ddf0c5e8d85fc2ad1f82947fc8923794f629e4490f8a1e58bdaf444e17",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:ba69fcc89a438e88a1e02ef84d3b34a60aeabc3dfeb2ea2a5c4d457362839ed2",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"defined_terms\":[{\"id\":\"urn:rulespec:document-understanding:term:747600bd2c03881d63ab8b5ff0f3d94f873eddd15f8cb21eacfb74e45c18c18e\",\"label\":\"cause\",\"quote\":\"(c) Funding termination or reductions For purposes of making a determination in accordance with subsection (b)(8) with respect to—\\n\\n(1) a funding reduction, the term “cause” includes—\\n\\n(A) a statewide redistribution of funds provided through a community services block grant under this chapter to respond to—\\n\\n(i) the results of the most recently available census or other appropriate data;\\n\\n(ii) the designation of a new eligible entity; or\\n\\n(iii) severe economic dislocation; or\\n\\n\\n(B) the failure of an eligible entity to comply with the terms of an agreement or a State plan, or to meet a State requirement, as described in section 9915(a) of this title; and\\n\\n\\n(2) a termination, the term “cause” includes the failure of an eligible entity to comply with the terms of an agreement or a State plan, or to meet a State requirement, as described in section 9915(a) of this title.\",\"source_quotes\":[\"(c) Funding termination or reductions For purposes of making a determination in accordance with subsection (b)(8) with respect to—\",\"(2) a termination, the term “cause” includes the failure of an eligible entity to comply with the terms of an agreement or a State plan, or to meet a State requirement, as described in section 9915(a) of this title.\"]}],\"kind\":\"definition\",\"modality\":\"not_stated\",\"scope_text\":\"For purposes of making a determination in accordance with subsection (b)(8) with respect to a termination\",\"summary\":\"For purposes of making a determination in accordance with subsection (b)(8) with respect to a termination, the term “cause” includes the failure of an eligible entity to comply with the terms of an agreement or a State plan, or to meet a State requirement, as described in section 9915(a) of this title.\"}",
        "@type": "xsd:string"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed",
      "rkaf:hasApplicability": "urn:rulespec:document-understanding:scope:9fdbec7332d94c162f043ab0b33676e112cd425975a9fa5a57676d388b09d86b"
    },

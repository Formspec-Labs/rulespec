      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:alternative:1",
      "rkaf:assertsValue": {
        "@value": "(2) another mechanism specified by the State to assure decisionmaking and participation by low-income individuals in the development, planning, implementation, and evaluation of programs funded under this chapter.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

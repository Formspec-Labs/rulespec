      "dcterms:description": "{\"action\":\"\",\"actor\":\"an eligible service provider receiving a grant under this section\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:efe1004f607d61aac5946bfff216e246577a890d36955bc3399c551b22c03f22\",\"urn:rulespec:document-understanding:assertion:941cdd58b77e878e666fb917df69cd5f64514729b944760704fd215302f02400\",\"urn:rulespec:document-understanding:assertion:fffe067244aa5b27d7efb777c6d9e79b43ecd5cc9ada8ca88eaa8ef184e3a331\",\"urn:rulespec:document-understanding:assertion:4a0fd576ed6ea346872bb2ee5b1bafd0296c558d4224aab78518e19fb839acb4\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":105709,\"evidence\":[{\"end\":104457,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:104433:104457:sha256-2886f1f4a0c8e4f5a4454f331cac3db1eed61025bec2e6541cdbdec28a4034b4\",\"quote\":\"(b) Program requirements\",\"start\":104433},{\"end\":104671,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:104458:104671:sha256-21991c51070fcc83a7dc1bd9a7c5bcb7fd9ced1b409e6a78be4cc6c3806defe8\",\"quote\":\"Any instructional activity carried out by an eligible service provider receiving a grant under this section shall be carried out on the campus of an institution of higher education (as defined in section 1141(a) 1\",\"start\":104458},{\"end\":104709,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:104673:104709:sha256-82a1f00ab9f241bcc5b63b8eff430fdb902e17c51a01d85e25a2659602172a39\",\"quote\":\"1 See References in Text note below.\",\"start\":104673},{\"end\":104743,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:104711:104743:sha256-aa1c30e07bc082cd004a9cb25fb3bba87c687e1455e3e43bc4b421f667128a54\",\"quote\":\" of title 20) and shall include—\",\"start\":104711},{\"end\":105709,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:104745:105709:sha256-ea557281d104f66326760c92bfb6c90b0e77374c91d29a33e14f63d98b506554\",\"quote\":\"(1) access to the facilities and resources of such an institution;\\n\\n(2) an initial medical examination and follow-up referral or treatment, without charge, for youth during their participation in such activity;\\n\\n(3) at least one nutritious meal daily, without charge, for participating youth during each day of participation;\\n\\n(4) high quality instruction in a variety of sports (that shall include swimming and that may include dance and any other high quality recreational activity) provided by coaches and teachers from institutions of higher education and from elementary and secondary schools (as defined in section 7801 of title 20); and\\n\\n(5) enrichment instruction and information on matters relating to the well-being of youth, to include educational opportunities and information on study practices, education for the prevention of drug and alcohol abuse, and information on health and nutrition, career opportunities, and family and job responsibilities.\",\"start\":104745},{\"end\":104565,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:104500:104565:sha256-1341a9fd4aeb41dade5146db1d90e5dab4a92ad5a1342d7ff2eb94e25c883ff6\",\"quote\":\"an eligible service provider receiving a grant under this section\",\"start\":104500}],\"id\":\"urn:rulespec:document-understanding:revision:83e745ed61d057bea912c0045a212343c24358f8ad8a7a2306de819a98852c00\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:4a0fd576ed6ea346872bb2ee5b1bafd0296c558d4224aab78518e19fb839acb4\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:c66136d599ec037bc546452d85dbf49dc2f632a26d8aaf9c2ff512bb4cabc83a\",\"origin\":\"aiSuggested\",\"quote\":\"(b) Program requirements Any instructional activity carried out by an eligible service provider receiving a grant under this section shall be carried out on the campus of an institution of higher education (as defined in section 1141(a) 1\\n\\n1 See References in Text note below.\\n\\n of title 20) and shall include—\\n\\n(1) access to the facilities and resources of such an institution;\\n\\n(2) an initial medical examination and follow-up referral or treatment, without charge, for youth during their participation in such activity;\\n\\n(3) at least one nutritious meal daily, without charge, for participating youth during each day of participation;\\n\\n(4) high quality instruction in a variety of sports (that shall include swimming and that may include dance and any other high quality recreational activity) provided by coaches and teachers from institutions of higher education and from elementary and secondary schools (as defined in section 7801 of title 20); and\\n\\n(5) enrichment instruction and information on matters relating to the well-being of youth, to include educational opportunities and information on study practices, education for the prevention of drug and alcohol abuse, and information on health and nutrition, career opportunities, and family and job responsibilities.\",\"references\":[\"section 1141(a) of title 20\",\"section 7801 of title 20\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:cf3b3f46e7aeacaef468069b4cd006eddf508e4a316710c172959740c6445ccf\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"urn:rulespec:document-understanding:section:f3eea5347c895856895eee6edec328881bdec01acc0faf09e4d4dd77b2ba0a81\",\"start\":104433,\"summary\":\"Any instructional activity carried out by an eligible service provider receiving a grant under this section shall be carried out on the campus of an institution of higher education (as defined in section 1141(a) of title 20) and shall include: (1) access to the facilities and resources of such an institution; (2) an initial medical examination and follow-up referral or treatment, without charge, for youth during their participation in such activity; (3) at least one nutritious meal daily, without charge, for participating youth during each day of participation; (4) high quality instruction in a variety of sports (that shall include swimming and that may include dance and any other high quality recreational activity) provided by coaches and teachers from institutions of higher education and from elementary and secondary schools (as defined in section 7801 of title 20); and (5) enrichment instruction and information on matters relating to the well-being of youth, to include educational opportunities and information on study practices, education for the prevention of drug and alcohol abuse, and information on health and nutrition, career opportunities, and family and job responsibilities.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

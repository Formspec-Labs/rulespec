      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"the Secretary\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:e215c6e52e2a22205d0ea8f2329c81723429bead5ad91ed8493b0b4ee94ef953\",\"urn:rulespec:document-understanding:assertion:7c3b48227b76bb947a7ebcf73aeb411d0aac58ab9dfa3d10766166ca4a82e3c2\",\"urn:rulespec:document-understanding:assertion:8ff05d0f91e811a6d5e15749348c00df06d5662ae9a50a5b7d858a696b446945\",\"urn:rulespec:document-understanding:assertion:83a538db0f31c5f6d15580d02320a491c60847e9cf81b2a07f858291cc4348d3\",\"urn:rulespec:document-understanding:assertion:00338f4e078e3405c25f31ccc54188eb015e1c7fbba4b0401cad35cf3d066cf7\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":83788,\"evidence\":[{\"end\":83342,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:83319:83342:sha256-6c96d44781a8b80d349f834eaf7691d48a4edcc1ef9c2ed749a91bd73eee3288\",\"quote\":\"(2) Action of Secretary\",\"start\":83319},{\"end\":83788,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:83343:83788:sha256-486910efee42d9779dcd701f56767816dc86a1919c5a452ba9f06e49c73f638e\",\"quote\":\"Whenever the Secretary determines that a State that has received a payment under this chapter has failed to comply with paragraph (1) or an applicable regulation, the Secretary shall notify the chief executive officer of the State and shall request that the officer secure compliance. If within a reasonable period of time, not to exceed 60 days, the chief executive officer fails or refuses to secure compliance, the Secretary is authorized to—\",\"start\":83343},{\"end\":83342,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:83319:83342:sha256-6c96d44781a8b80d349f834eaf7691d48a4edcc1ef9c2ed749a91bd73eee3288\",\"quote\":\"(2) Action of Secretary\",\"start\":83319},{\"end\":83788,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:83343:83788:sha256-486910efee42d9779dcd701f56767816dc86a1919c5a452ba9f06e49c73f638e\",\"quote\":\"Whenever the Secretary determines that a State that has received a payment under this chapter has failed to comply with paragraph (1) or an applicable regulation, the Secretary shall notify the chief executive officer of the State and shall request that the officer secure compliance. If within a reasonable period of time, not to exceed 60 days, the chief executive officer fails or refuses to secure compliance, the Secretary is authorized to—\",\"start\":83343}],\"id\":\"urn:rulespec:document-understanding:revision:e21239095b8a09782b6bf3cf8d6c8ba24ad1531afa83a0ed0c6d2c0de640440f\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:00338f4e078e3405c25f31ccc54188eb015e1c7fbba4b0401cad35cf3d066cf7\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:1deb98ab5be106a0d80aa5a06220f0c71af8216c0901d34ed5d5560e9201eb17\",\"origin\":\"aiSuggested\",\"quote\":\"(2) Action of Secretary Whenever the Secretary determines that a State that has received a payment under this chapter has failed to comply with paragraph (1) or an applicable regulation, the Secretary shall notify the chief executive officer of the State and shall request that the officer secure compliance. If within a reasonable period of time, not to exceed 60 days, the chief executive officer fails or refuses to secure compliance, the Secretary is authorized to—\",\"references\":[\"paragraph (1)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:bf673ed206a1c6ca765e7b02df53db1dbe46751f45fa5d9ad6d3c9888c12c36c\",\"scope_quotes\":[\"(2) Action of Secretary Whenever the Secretary determines that a State that has received a payment under this chapter has failed to comply with paragraph (1) or an applicable regulation, the Secretary shall notify the chief executive officer of the State and shall request that the officer secure compliance. If within a reasonable period of time, not to exceed 60 days, the chief executive officer fails or refuses to secure compliance, the Secretary is authorized to—\"],\"scope_text\":\"Whenever the Secretary determines that a State that has received a payment under this chapter has failed to comply with paragraph (1) or an applicable regulation\",\"section_id\":\"urn:rulespec:document-understanding:section:c2d7d2b3c184cf50d82366ce65cb8d6112ac79f92281542f43e74ba5049712d4\",\"start\":83319,\"summary\":\"Whenever the Secretary determines that a State that has received a payment under this chapter has failed to comply with paragraph (1) or an applicable regulation, the Secretary shall notify the chief executive officer of the State and shall request that the officer secure compliance.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

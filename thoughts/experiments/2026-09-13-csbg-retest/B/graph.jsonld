    {
      "@id": "urn:rulespec:document-understanding:binding:8a67fa7ddb2dc83dee2628bc28b1189cf28ee4448dd0854da333c67733e4af82",
      "@type": "rkaf:EvidenceBinding",
      "rkaf:bindsAssertion": "urn:rulespec:document-understanding:assertion:a0e2330a3805eee5d90adff183bdd535dc7670a63cbb6823820b2a3f2dafada8",
      "rkaf:evidenceRole": "rkaf:textualEvidence",

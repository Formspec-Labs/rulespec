      "skos:prefLabel": {
        "en": "Indian tribe"
      },
      "skos:definition": {
        "en": "In this section, “Indian tribe” means a tribe, band, or other organized group recognized in the State in which the tribe, band, or group resides, or considered by the Secretary of the Interior, to be an Indian tribe or an Indian organization for any purpose."
      },

    {
      "@id": "urn:rulespec:document-understanding:assertion:ca25346c89d44cde650cf557706f02063c32ae493d32ddab998b297c476a131e",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:4b80bc242bf4108132092097a8f5b641e6a56bd640c5f048e8bbcbf82862ca04",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:3d5314ddf0c5e8d85fc2ad1f82947fc8923794f629e4490f8a1e58bdaf444e17",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:f2fe3bb46b5328ff6e7a4182e1882c764237096d784f5659cd167c8cafd13ec2",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:states-requirement",
      "rkaf:assertsValue": {
        "@value": "Beginning with fiscal year 2000, the State's application and plan submitted to be eligible for a grant or allotment under section 9905 or 9906 of this title must contain an assurance that funds made available through the grant or allotment will be used to address the needs of youth in low-income communities through youth development programs that support the primary role of the family, give priority to preventing youth problems and crime, promote community coordination and collaboration, and support the development and expansion of innovative community-based youth development programs demonstrating success in preventing or reducing youth crime, such as violence-free zone programs involving youth development and intervention models (e.g., youth mediation, mentoring, life skills training, job creation, and entrepreneurship programs) and after-school child care programs.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },
    {

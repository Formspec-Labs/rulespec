      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:809ebc2088d00a4f3d938e749eb4402a0d8588b67735e71198daa1f39c35a1b6\",\"urn:rulespec:document-understanding:assertion:e5b795a18028fb61be737942615b53d4e0a13e6fd317061efef0f611286e5436\",\"urn:rulespec:document-understanding:assertion:dcce30b3910c0be1725d22276b9586f7c6f2f53ab915d3bc8fd4c0033c378fc8\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[\"For any program carried out by the Federal Government, or by a State or local government under this chapter, the government shall consider, on the same basis as other nongovernmental organizations, religious organizations to provide the assistance under the program, so long as the program is implemented in a manner consistent with the Establishment Clause of the first amendment to the Constitution. Neither the Federal Government nor a State or local government receiving funds under this chapter shall discriminate against an organization that provides assistance under, or applies to provide assistance under, this chapter, on the basis that the organization has a religious character.\"],\"defined_terms\":[],\"effective_periods\":[],\"end\":89271,\"evidence\":[{\"end\":89271,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:89048:89271:sha256-0062853305e86d46eac15f3b29ad65a3feeea845a3122876e2e2f543a9c42567\",\"quote\":\"A religious organization’s exemption provided under section 2000e–1 of this title regarding employment practices shall not be affected by its participation in, or receipt of funds from, programs described in subsection (a).\",\"start\":89048},{\"end\":88263,\"field\":\"context:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:87573:88263:sha256-7f698273643ebaac09dd116e5fd1cab7db7c4e700d5aca2c7489efe5e05abd4a\",\"quote\":\"For any program carried out by the Federal Government, or by a State or local government under this chapter, the government shall consider, on the same basis as other nongovernmental organizations, religious organizations to provide the assistance under the program, so long as the program is implemented in a manner consistent with the Establishment Clause of the first amendment to the Constitution. Neither the Federal Government nor a State or local government receiving funds under this chapter shall discriminate against an organization that provides assistance under, or applies to provide assistance under, this chapter, on the basis that the organization has a religious character.\",\"start\":87573}],\"id\":\"urn:rulespec:document-understanding:revision:e423e5f6c6a3c9a90d89d03085759b17d009d4787cdc14d50880b6b2352bea72\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"statement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:dcce30b3910c0be1725d22276b9586f7c6f2f53ab915d3bc8fd4c0033c378fc8\",\"modality\":\"not_stated\",\"modality_quote\":\"\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:2c8b2ac8e4d5c092606fdb1b4ce4bd03286bf3f8acf4c3a1477f9c6547c10fe2\",\"origin\":\"aiSuggested\",\"quote\":\"A religious organization’s exemption provided under section 2000e–1 of this title regarding employment practices shall not be affected by its participation in, or receipt of funds from, programs described in subsection (a).\",\"references\":[\"section 2000e–1\",\"subsection (a)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:4f6a87ea132407e6fc86019f25c95a0da5570df1074af2dff96518d4756d58a4\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"urn:rulespec:document-understanding:section:cfe00c4
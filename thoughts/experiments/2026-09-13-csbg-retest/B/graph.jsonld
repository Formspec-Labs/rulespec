      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:3c583d23f3c5fc340c304d164ba3503977985cf0c96ada6ce1a195521275f47b\",\"urn:rulespec:document-understanding:assertion:7eaae62af2f7d5f98c138dad5c4d54f4d3f7455112c98d295bcabcc9ccf5f2bd\",\"urn:rulespec:document-understanding:assertion:ec8d5fb5edbf8bdd19fcac49a86ffd36f8cf8cb5bd044c2d2de9feaa9ea2683a\",\"urn:rulespec:document-understanding:assertion:6491cc21f1d913a5e02b05ff3d06855aac34321541163e5a0eec189050a2606c\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":75827,\"evidence\":[{\"end\":75827,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:75533:75827:sha256-2e69fa000850c1fb607a0932879419ef5bf6cea0d205803eaa81e03b58c97440\",\"quote\":\"The State may elect to have local agencies that are subcontractors of the eligible entities under this chapter participate in the performance measurement system. If the State makes that election, references in this section to eligible entities shall be considered to include the local agencies.\",\"start\":75533},{\"end\":75827,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:75533:75827:sha256-2e69fa000850c1fb607a0932879419ef5bf6cea0d205803eaa81e03b58c97440\",\"quote\":\"The State may elect to have local agencies that are subcontractors of the eligible entities under this chapter participate in the performance measurement system. If the State makes that election, references in this section to eligible entities shall be considered to include the local agencies.\",\"start\":75533}],\"id\":\"urn:rulespec:document-understanding:revision:c60b9f1ab6b99e2fb7b367f4aa01d66d64ab94f5b9abc4cd835e106cbe6b0ff1\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"statement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:6491cc21f1d913a5e02b05ff3d06855aac34321541163e5a0eec189050a2606c\",\"modality\":\"not_stated\",\"modality_quote\":\"\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:5531cd8d4a2263920f0d05c8d6ea1795b1cd95cc58c5cae1c55262c8e7e9a9d4\",\"origin\":\"aiSuggested\",\"quote\":\"The State may elect to have local agencies that are subcontractors of the eligible entities under this chapter participate in the performance measurement system. If the State makes that election, references in this section to eligible entities shall be considered to include the local agencies.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:4b95fb20eb98eaadeb9fbc93da2d310793fa2449ca4bd9b38f749d027748c1ee\",\"scope_quotes\":[\"The State may elect to have local agencies that are subcontractors of the eligible entities under this chapter participate in the performance measurement system. If the State makes that election, references in this section to eligible entities shall be considered to include the local agencies.\"],\"scope_text\":\"If the State makes that election\",\"section_id\":\"urn:rulespec:document-understanding:section:fa489a00ccb41098ac2b415167888ae0d85e530b88cc3c90eda7efe29c7dad7b\",\"start\":75533,\"summary\":\"If the State elects to have local agencies that are subcontractors of the eligible entities under 42 U.S.C. chapter 106 participate in the performance measurement system, references in 42 U.S.C. 9917 to eligible entities shall be considered to include the local agencies.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",
      "dcterms:references": [

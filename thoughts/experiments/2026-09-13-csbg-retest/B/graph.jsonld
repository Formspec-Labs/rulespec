    {
      "@id": "urn:rulespec:document-understanding:revision:ca3c53c9302baf0a115534b70aa2c1b8b39b4ef3c3950157389b34cfb681f9ae",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:ca3c53c9302baf0a115534b70aa2c1b8b39b4ef3c3950157389b34cfb681f9ae",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:9bbd284425ef03c726153ba6aedcf3b2ca6845c93f69f66887c3edf369d1554d",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"The Secretary\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:f46d44c0a58aceccbb56c014948d4cd62446e72ef09a723b031f37c215aaa77b\",\"urn:rulespec:document-understanding:assertion:6cb9a9425720f228212acc6d6ad65cd9bb7c3fa575af15717caa20975827e6df\",\"urn:rulespec:document-understanding:assertion:bc99c8ac0abcd2560e3da6b8955a93b2189660d14b415a66d38a2ad4d8ea81a3\",\"urn:rulespec:document-understanding:assertion:6628aeece044e15aeaf1cc52d271c090c32ae13bf68a02f723af45e232c05844\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[\"Committee on Labor and Human Resources of Senate changed to Committee on Health, Education, Labor, and Pensions of Senate by Senate Resolution No. 20, One Hundred Sixth Congress, Jan. 19, 1999.\"],\"defined_terms\":[],\"effective_periods\":[],\"end\":95327,\"evidence\":[{\"end\":95327,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:94928:95327:sha256-f370227fcd2a868a847a47bc4078935b6c97edc663debf196395c7ec861e8242\",\"quote\":\"The Secretary shall compile an annual report containing a summary of the evaluations required in subsection (b) and a listing of all activities assisted under this section. The Secretary shall annually submit the report to the Chairperson of the Committee on Education and the Workforce of the House of Representatives and the Chairperson of the Committee on Labor and Human Resources of the Senate.\",\"start\":94928}],\"id\":\"urn:rulespec:document-understanding:revision:ca3c53c9302baf0a115534b70aa2c1b8b39b4ef3c3950157389b34cfb681f9ae\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:6628aeece044e15aeaf1cc52d271c090c32ae13bf68a02f723af45e232c05844\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:a93cbabdc9b8359700df1c8487c1ff5a415be921c90b46ccb6125364579064e1\",\"origin\":\"aiSuggested\",\"quote\":\"The Secretary shall compile an annual report containing a summary of the evaluations required in subsection (b) and a listing of all activities assisted under this section. The Secretary shall annually submit the report to the Chairperson of the Committee on Education and the Workforce of the House of Representatives and the Chairperson of the Committee on Labor and Human Resources of the Senate.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:7b8bae960804a8c0d57957b257e0d80f1dd984c5df5e068b3b270715a0297fe9\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"urn:rulespec:document-understanding:section:6888d98c59cc2331f4c6a6a1e0052761ef3a8008658a9708c0cec6503ed121ed\",\"start\":94928,\"summary\":\"The Secretary shall annually submit the report containing a summary of evaluations and listing of activities to the Chairperson of the Committee on Education and the Workforce of the House of Representatives and the Chairperson of the Committee on Labor and Human Resources of the Senate.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

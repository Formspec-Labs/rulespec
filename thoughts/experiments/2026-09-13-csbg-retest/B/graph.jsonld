    {
      "@id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:99498:99854:sha256-05525e3ffd062825cf0fe131f1a9733052d7de215ee33318b315cab5eeacd05f",
      "@type": "rkaf:SourceFragment",
      "oa:hasSource": "urn:rulespec:document-understanding:document:26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023",
      "rkaf:fragmentIdentityScheme": "rkaf:carrier-local-fragment",
      "rkaf:sourceArtifactDigest": "sha256:26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023",
      "rkaf:fragmentContentDigest": "sha256:05525e3ffd062825cf0fe131f1a9733052d7de215ee33318b315cab5eeacd05f",
      "rkaf:selectorKind": [
        "oa:TextQuoteSelector",
        "oa:TextPositionSelector"
      ],
      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "From a portion equal to 60 percent of such amount (but not to exceed $3,600,000), the Secretary shall allot for grants to eligible agencies for statewide programs in each State the amount that bears the same ratio to such portion as the low-income and unemployed population of such State bears to the low-income and unemployed population of all the States."
        },
        {
          "@type": "oa:TextPositionSelector",
          "oa:start": 99498,
          "oa:end": 99854,
          "rkaf:coordinateSystem": "rkaf:unicode-codepoint"

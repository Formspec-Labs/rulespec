    {
      "@id": "urn:rulespec:document-understanding:revision:534dc5998cd9c562b71cc85825176f443e8b0d47e2977055673ee03c0c770270",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:534dc5998cd9c562b71cc85825176f443e8b0d47e2977055673ee03c0c770270",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:0fd9c43dbfba464de3b4f5bc12da2b55839480668a09fe982b1aa12dde8a8574",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"The Secretary\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:5f4123ab1c9ee9cec50bb11ec05388bb22dce2a759c91d6819c90993f368b5c7\",\"urn:rulespec:document-understanding:assertion:1bf85e003847fb91561cd1e2ac1e0a60ac94cdb7a210b5910a34deb037569a02\",\"urn:rulespec:document-understanding:assertion:d12b09ad669b82caaf053a8b2c5a62e448e4ac1a274e8cefa807a2bead6a9b47\",\"urn:rulespec:document-understanding:assertion:72f5666202e67c7b261c85fdbd06baa881be1f93ef4244643cb84b5a9ee2b330\",\"urn:rulespec:document-understanding:assertion:944c7ab5caa8af8b132b27d31e72ad4582d509be7ca11ad15703395e50f7a533\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":101153,\"evidence\":[{\"end\":100112,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:100076:100112:sha256-5c4fa0260cf3562af3e87741f8f065246b6ea8e7184ea1182d24116ee479c2c8\",\"quote\":\"(2) Greater available appropriations\",\"start\":100076},{\"end\":100235,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:100113:100235:sha256-0294a65becc188b40e74b654402e9866c3cf9bd7d94ea71f98cd9fecfbda59ab\",\"quote\":\"Any amounts appropriated for a fiscal year to carry out this section in excess of $6,000,000 shall be allotted as follows:\",\"start\":100113},{\"end\":100251,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:100237:100251:sha256-9c42fb46ddf93b999d39103000936dbcb7ffda46cd45642986088a12333f6098\",\"quote\":\"(A) Allotments\",\"start\":100237},{\"end\":100651,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:100253:100651:sha256-978f071079c0619102a2d1f6608a09bef41092feef21729f28471f6c220bb871\",\"quote\":\"The Secretary shall use 40 percent of such excess to allot for grants under subsection (a) to eligible agencies for statewide programs in each State an amount that bears the same ratio to 40 percent of such excess as the low-income and unemployed population of such State bears to the low-income and unemployed population of all the States.\\n\\n\\n(B) Competitive grants for local and statewide programs\",\"start\":100253},{\"end\":100865,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:100653:100865:sha256-ed81782d1eee5369e9393bd6d94ba14a8fd15dfb074e51d7b441863978841c4a\",\"quote\":\"The Secretary shall use 40 percent of such excess to make grants under subsection (a) on a competitive basis to eligible agencies for local and statewide programs.\\n\\n\\n(C) Competitive grants for nationwide programs\",\"start\":100653},{\"end\":101153,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:100867:101153:sha256-86b5769ffb068f6962d131f0ff6fed5ff5798dc28c35ffe851aeb6a8a23ad5f5\",\"quote\":\"The Secretary shall use the remaining 20 percent of such excess to make grants under subsection (a) on a competitive basis to eligible agencies for nationwide programs, including programs benefiting Indians, as defined in section 9911 of this title, and migrant or seasonal farmworkers.\",\"start\":100867},{\"end\":100112,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:100076:100112:sha256-5c4fa0260cf3562af3e87741f8f065246b6ea8e7184ea1182d24116ee479c2c8\",\"quote\":\"(2) Greater available appropriations\",\"start\":100076},{\"end\":100235,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:100113:100235:sha256-0294a65becc188b40e74b654402e9866c3cf9bd7d94ea71f98cd9fecfbda59ab\",\"quote\":\"Any amounts appropriated for a fiscal year to carry out this section in excess of $6,000,000 shall be allotted as follows:\",\"start\":100113}],\"id\":\"urn:rulespec:document-understanding:revision:534dc5998cd9c562b71cc85825176f443e8b0d47e2977055673ee03c0c770270\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:944c7ab5caa8af8b132b27d31e72ad4582d509be7ca11ad15703395e50f7a533\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:73adef99a1228070af8b1d942d6d89154db82d2a274fef81d36892dff0aaf335\",\"origin\":\"aiSuggested\",\"quote\":\"(2) Greater available appropriations Any amounts appropriated for a fiscal year to carry out this section in excess of $6,000,000 shall be allotted as follows:\\n\\n(A) Allotments\\n\\nThe Secretary shall use 40 percent of such excess to allot for grants under subsection (a) to eligible agencies for statewide programs in each State an amount that bears the same ratio to 40 percent of such excess as the low-income and unemployed population of such State bears to the low-income and unemployed population of all the States.\\n\\n\\n(B) Competitive grants for local and statewide programs\\n\\nThe Secretary shall use 40 percent of such excess to make grants under subsection (a) on a competitive basis to eligible agencies for local and statewide programs.\\n\\n\\n(C) Competitive grants for nationwide programs\\n\\nThe Secretary shall use the remaining 20 percent of such excess to make grants under subsection (a) on a competitive basis to eligible agencies for nationwide programs, including programs benefiting Indians, as defined in section 9911 of this title, and migrant or seasonal farmworkers.\",\"references\":[\"section 9911 of this title\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:8d76f46e78b85392cc9ec9168300267c57a862d3a7392fc95a98c4133129965c\",\"scope_quotes\":[\"(2) Greater available appropriations Any amounts appropriated for a fiscal year to carry out this section in excess of $6,000,000 shall be allotted as follows:\"],\"scope_text\":\"Any amounts appropriated for a fiscal year to carry out this section in excess of $6,000,000\",\"section_id\":\"urn:rulespec:document-understanding:section:cad1a9ce814f7bc8d23a6ff48e1865a684b16830bcf049a10118a7b6cab89b15\",\"start\":100076,\"summary\":\"When amounts appropriated for a fiscal year to carry out this section exceed $6,000,000, the Secretary shall use the remaining 20 percent of such excess to make grants under subsection (a) on a competitive basis to eligible agencies for nationwide programs, including programs benefiting Indians, as defined in section 9911 of this title, and migrant or seasonal farmworkers.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

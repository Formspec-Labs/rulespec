},{\"end\":14602,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:14559:14602:sha256-f02f192d85a43f5535bd894abf8ea6f011295f617ccb4c3ca4c6cc36343d8efd\",\"quote\":\"The term “eligible entity” means an entity—\",\"start\":14559},{\"end\":15066,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:14604:15066:sha256-98f708d1b919c746f774e2d32cec4deab1032fb8d9783753c6e136fb09c284bb\",\"quote\":\"(i) that is an eligible entity described in paragraph (1) (as in effect on the day before October 27, 1998) as of the day before October 27, 1998, or is designated by the process described in section 9909 of this title (including an organization serving migrant or seasonal farmworkers that is so described or designated); and\\n\\n(ii) that has a tripartite board or other mechanism described in subsection (a) or (b), as appropriate, of section 9910 of this title.\",\"start\":14604},{\"end\":14490,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:14474:14490:sha256-6ef26080ba5b156360ab82a0af83047ddb9f669fc217c8e473039fb3c28c162d\",\"quote\":\"In this chapter:\",\"start\":14474},{\"end\":14558,\"field\":\"defined_terms:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:14539:14558:sha256-de8d503a8d217c241ef3a7904d48881c6df66c6f594e26c9ca8b7b281ca97720\",\"quote\":\"(A) Eligible entity\",\"start\":14539},{\"end\":14602,\"field\":\"defined_terms:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:14559:14602:sha256-f02f192d85a43f5535bd894abf8ea6f011295f617ccb4c3ca4c6cc36343d8efd\",\"quote\":\"The term “eligible entity” means an entity—\",\"start\":14559},{\"end\":15066,\"field\":\"defined_terms:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:14604:15066:sha256-98f708d1b919c746f774e2d32cec4deab1032fb8d9783753c6e136fb09c284bb\",\"quote\":\"(i) that is an eligible entity described in paragraph (1) (as in effect on the day before October 27, 1998) as of the day before October 27, 1998, or is designated by the process described in section 9909 of this title (including an organization serving migrant or seasonal farmworkers that is so described or designated); and\\n\\n(ii) that has a tripartite board or other mechanism described in subsection (a) or (b), as appropriate, of section 9910 of this title.\",\"start\":14604},{\"end\":14558,\"field\":\"defined_terms:0:source:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:14539:14558:sha256-de8d503a8d217c241ef3a7904d48881c6df66c6f594e26c9ca8b7b281ca97720\",\"quote\":\"(A) Eligible entity\",\"start\":14539},{\"end\":14602,\"field\":\"defined_terms:0:source:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:14559:14602:sha256-f02f192d85a43f5535bd894abf8ea6f011295f617ccb4c3ca4c6cc36343d8efd\",\"quote\":\"The term “eligible entity” means an entity—\",\"start\":14559}],\"id\":\"urn:rulespec:document-understanding:revision:7a89aad4a6de34e081a4234d76d94f3f7c2ef914ffd4c4887193d80ceee96913\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"definition\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:aae43e4a44dba93aae4c7ca55a7a0b647ddd253f0ef6e6fc40ce2c510b29fb80\",\"modality\":\"not_stated\",\"modality_quote\":\"\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:f1a67dd77c817d07a03fbed8d584998a59214b1fc703e3584e2a87205ef01f46\",\"origin\":\"aiSuggested\",\"quote\":\"(A) Eligible entity The term “eligible entity” means an entity—\\n\\n(i) that is an eligible entity described in paragraph (1) (as in effect on the day before October 27, 1998) as of the day before October 27, 1998, or is designated by the process described in section 9909 of this title (including an organization serving migrant or seasonal farmworkers that is so described or designated); and\\n\\n(ii) that has a tripartite board or other mechanism described in subsection (a) or (b), as appropriate, of section 9910 of this title.\",\"references\":[\"section 9909\",\"section 9910\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:19b06073b8c6e94408977804c33a411af7cd629797460751e7400ab0abe424f4\",\"scope_quotes\":[\"In this chapter:\"],\"scope_text\":\"In this chapter\",\"section_id\":\"urn:rulespec:document-understanding:section:9a5224c808327e88c75f83b7cee8be31a7428e0086505e2dd784698ca11dd1d8\",\"start\":14539,\"summary\":\"In this chapter, the term \\\"eligible entity\\\" means an entity that is an eligible entity described in paragraph (1) (as in effect on the day before October 27, 1998) as of the day before October 27, 1998, or is designated by the process described in section 9909 of this title (including an organization serving migrant or seasonal farmworkers that is so described or designated), and that has a tripartite board or other mechanism described in subsection (a) or (b), as appropriate, of section 9910 of this title.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

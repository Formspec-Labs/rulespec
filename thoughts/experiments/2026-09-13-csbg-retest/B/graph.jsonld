      "rkaf:assertsValue": {
        "@value": "{\"actor\":\"Secretary\",\"kind\":\"prohibition\",\"modality\":\"must_not\",\"summary\":\"No application may be approved for assistance under 42 U.S.C. 9925 unless the Secretary is satisfied that the activities to be carried out under the application will be in addition to, and not in substitution for, activities previously carried on without Federal assistance, and funds or other resources devoted to programs designed to meet the needs of the poor within the community, area, or State will not be diminished in order to provide the matching contributions required under this section.\",\"term_refs\":[\"urn:rulespec:document-understanding:term:576e9257cb479321316fb378bb4b88ddb844dc1e33b39dc213b46732e75aa46c\"]}",

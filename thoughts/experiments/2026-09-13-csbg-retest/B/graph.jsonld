    {
      "@id": "urn:rulespec:document-understanding:revision:845c63bc077805191b8c98449562c991e34e9e5c58e3b99d117d754bba857931",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:845c63bc077805191b8c98449562c991e34e9e5c58e3b99d117d754bba857931",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:bfff37fc7178c81c8b3aa0c2d7f3c89b2db567b4fb2f1331b500af9741008f7b",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"The Secretary\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:487e0eb91393dda13ee2e706727c08c5cc179901851814fb0d0a1459956743d2\",\"urn:rulespec:document-understanding:assertion:3964561324339fc79f083698aab8f3270e480c490fe80964d5921fb76a1d14e6\",\"urn:rulespec:document-understanding:assertion:4f7ab900dd08e240e0fdd8d22e8e6bec09ce7aff87121bd03b5f5d200c15bdb7\",\"urn:rulespec:document-understanding:assertion:a3db2c29347c5811a89a0133bb884c5d79ec770e1e3c762dcf997a8f3d67af10\",\"urn:rulespec:document-understanding:assertion:e28c37a2dce5347084e06c71426fae24874755d3eafce637bf433f7ede5e919a\",\"urn:rulespec:document-understanding:assertion:c5e75c542afad75f95312e12382ff04287645517857d4deb6de80d13584df043\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":16172,\"evidence\":[{\"end\":16172,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:15218:16172:sha256-1603cf9f43b064a37fb684b67c0b13a2cd9a6ea24370dcbf44b41db1b03cbdd8\",\"quote\":\"The term “poverty line” means the official poverty line defined by the Office of Management and Budget based on the most recent data available from the Bureau of the Census. The Secretary shall revise annually (or at any shorter interval the Secretary determines to be feasible and desirable) the poverty line, which shall be used as a criterion of eligibility in the community services block grant program established under this chapter. The required revision shall be accomplished by multiplying the official poverty line by the percentage change in the Consumer Price Index for All Urban Consumers during the annual or other interval immediately preceding the time at which the revision is made. Whenever a State determines that it serves the objectives of the block grant program established under this chapter, the State may revise the poverty line to not to exceed 125 percent of the official poverty line otherwise applicable under this paragraph.\",\"start\":15218},{\"end\":15405,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:15392:15405:sha256-d6dd2bb6d3c44b4545cc3f97cb6f8a38842ecd30d2c58ec3e1c53a8c1a0ac77c\",\"quote\":\"The Secretary\",\"start\":15392}],\"id\":\"urn:rulespec:document-understanding:revision:845c63bc077805191b8c98449562c991e34e9e5c58e3b99d117d754bba857931\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:a3db2c29347c5811a89a0133bb884c5d79ec770e1e3c762dcf997a8f3d67af10\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:51e35a6275e531a5bec7fd968fb542dad1c9f5075f443cf26648de8a7a82ba14\",\"origin\":\"aiSuggested\",\"quote\":\"The term “poverty line” means the official poverty line defined by the Office of Management and Budget based on the most recent data available from the Bureau of the Census. The Secretary shall revise annually (or at any shorter interval the Secretary determines to be feasible and desirable) the poverty line, which shall be used as a criterion of eligibility in the community services block grant program established under this chapter. The required revision shall be accomplished by multiplying the official poverty line by the percentage change in the Consumer Price Index for All Urban Consumers during the annual or other interval immediately preceding the time at which the revision is made. Whenever a State determines that it serves the objectives of the block grant program established under this chapter, the State may revise the poverty line to not to exceed 125 percent of the official poverty line otherwise applicable under this paragraph.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:8b8c7c4c87576d0e20ade5cb48d51023c2d2ff8a5b400041eabf94a3c56bdb6c\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"urn:rulespec:document-understanding:section:9a5224c808327e88c75f83b7cee8be31a7428e0086505e2dd784698ca11dd1d8\",\"start\":15218,\"summary\":\"The Secretary shall revise annually (or at any shorter interval the Secretary determines to be feasible and desirable) the poverty line, which shall be used as a criterion of eligibility in the community services block grant program established under this chapter.\",\"target_ids\":[],\"term_refs\":[\"urn:rulespec:document-understanding:term:79175355c5f201f402a3909237bf9d6739f0b9eb0b5d7b9a843a0673319e4f24\",\"urn:rulespec:document-understanding:term:439ac6c78277042f21626d5a2b780e789d2dc444f69020a0e5e8e5b326ae1ee8\"],\"typed_values\":[]}",

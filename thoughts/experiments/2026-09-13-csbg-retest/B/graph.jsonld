      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"the government\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:37639af2c6a403402c5b79c2216da8d95614074d95da2cf72ca5a91c5a29411b\",\"urn:rulespec:document-understanding:assertion:526c8117fd6384da71b6e9c9bf892c5254a580e9b91b1347a346e24460dc3d11\",\"urn:rulespec:document-understanding:assertion:26aeca89e3db5bd8e4696252c1421444e3b398671792e54eeda3de1d2d461ca4\",\"urn:rulespec:document-understanding:assertion:cf493949d2835981495a100073ce89923caeb5405a554981bd38b69cd463a5f1\",\"urn:rulespec:document-understanding:assertion:7419497d0d54725301bee61b43f779388461f326764ba654575b4e12df9884c4\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":88263,\"evidence\":[{\"end\":88263,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:87573:88263:sha256-7f698273643ebaac09dd116e5fd1cab7db7c4e700d5aca2c7489efe5e05abd4a\",\"quote\":\"For any program carried out by the Federal Government, or by a State or local government under this chapter, the government shall consider, on the same basis as other nongovernmental organizations, religious organizations to provide the assistance under the program, so long as the program is implemented in a manner consistent with the Establishment Clause of the first amendment to the Constitution. Neither the Federal Government nor a State or local government receiving funds under this chapter shall discriminate against an organization that provides assistance under, or applies to provide assistance under, this chapter, on the basis that the organization has a religious character.\",\"start\":87573},{\"end\":87696,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:87682:87696:sha256-5702673eda3a1eb6d3bf20cebfeca880a7208a36fdef430de2f214ce83088b34\",\"quote\":\"the government\",\"start\":87682},{\"end\":88263,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:87573:88263:sha256-7f698273643ebaac09dd116e5fd1cab7db7c4e700d5aca2c7489efe5e05abd4a\",\"quote\":\"For any program carried out by the Federal Government, or by a State or local government under this chapter, the government shall consider, on the same basis as other nongovernmental organizations, religious organizations to provide the assistance under the program, so long as the program is implemented in a manner consistent with the Establishment Clause of the first amendment to the Constitution. Neither the Federal Government nor a State or local government receiving funds under this chapter shall discriminate against an organization that provides assistance under, or applies to provide assistance under, this chapter, on the basis that the organization has a religious character.\",\"start\":87573}],\"id\":\"urn:rulespec:document-understanding:revision:1a3826e9638ae1230535aae12312e3d986639eb174031b981c020ccc8d45e15d\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:7419497d0d54725301bee61b43f779388461f326764ba654575b4e12df9884c4\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:32caf194bb741e39c98bdde8486c7e5a3e2a0eb9196eff55aebad702afd958cd\",\"origin\":\"aiSuggested\",\"quote\":\"For any program carried out by the Federal Government, or by a State or local government under this chapter, the government shall consider, on the same basis as other nongovernmental organizations, religious organizations to provide the assistance under the program, so long as the program is implemented in a manner consistent with the Establishment Clause of the first amendment to the Constitution. Neither the Federal Government nor a State or local government receiving funds under this chapter shall discriminate against an organization that provides assistance under, or applies to provide assistance under, this chapter, on the basis that the organization has a religious character.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:7c6f6f09294cb1e358775b2e85706ec0c5ca69cf624a8cab8f1e777d73abcd38\",\"scope_quotes\":[\"For any program carried out by the Federal Government, or by a State or local government under this chapter, the government shall consider, on the same basis as other nongovernmental organizations, religious organizations to provide the assistance under the program, so long as the program is implemented in a manner consistent with the Establishment Clause of the first amendment to the Constitution. Neither the Federal Government nor a State or local government receiving funds under this chapter shall discriminate against an organization that provides assistance under, or applies to provide assistance under, this chapter, on the basis that the organization has a religious character.\"],\"scope_text\":\"For any program carried out by the Federal Government, or by a State or local government under this chapter, so long as the program is implemented in a manner consistent with the Establishment Clause of the first amendment to the Constitution\",\"section_id\":\"urn:rulespec:document-understanding:section:cfe00c4667f8a705b619c6842c9a05b4aaa1e3ace7adcf5723b0c39c5a6aa621\",\"start\":87573,\"summary\":\"For any program carried out by the Federal Government, or by a State or local government under this chapter, the government must consider, on the same basis as other nongovernmental organizations, religious organizations to provide the assistance under the program, so long as the program is implemented in a manner consistent with the Establishment Clause of the first amendment to the Constitution.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:a6957abd864b63afd34b4533d524a772446e2e53a6906fc86541102d035a4aef\",\"urn:rulespec:document-understanding:assertion:7c8e6917d1e339ca200eea48fab02dbb4eda0c284445f610873df839ac6d9cc6\",\"urn:rulespec:document-understanding:assertion:c975731189794a1c780f9b9b516afcef6145aad87f951fda17a9001665f253a9\",\"urn:rulespec:document-understanding:assertion:f27d839c3ad153d9b3ee8a8dd339090a2c33665ddb608e0c56a88192555174cb\",\"urn:rulespec:document-understanding:assertion:de32df163e44f5c3eee70d70295cf2f06c515d62aeabdeb2b9120fdee7088514\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[{\"aliases\":[],\"id\":\"urn:rulespec:document-understanding:term:747600bd2c03881d63ab8b5ff0f3d94f873eddd15f8cb21eacfb74e45c18c18e\",\"label\":\"cause\",\"quote\":\"(c) Funding termination or reductions For purposes of making a determination in accordance with subsection (b)(8) with respect to—\\n\\n(1) a funding reduction, the term “cause” includes—\\n\\n(A) a statewide redistribution of funds provided through a community services block grant under this chapter to respond to—\\n\\n(i) the results of the most recently available census or other appropriate data;\\n\\n(ii) the designation of a new eligible entity; or\\n\\n(iii) severe economic dislocation; or\\n\\n\\n(B) the failure of an eligible entity to comply with the terms of an agreement or a State plan, or to meet a State requirement, as described in section 9915(a) of this title; and\\n\\n\\n(2) a termination, the term “cause” includes the failure of an eligible entity to comply with the terms of an agreement or a State plan, or to meet a State requirement, as described in section 9915(a) of this title.\",\"source_quotes\":[\"(c) Funding termination or reductions For purposes of making a determination in accordance with subsection (b)(8) with respect to—\",\"(2) a termination, the term “cause” includes the failure of an eligible entity to comply with the terms of an agreement or a State plan, or to meet a State requirement, as described in section 9915(a) of this title.\"]}],\"effective_periods\":[],\"end\":47350,\"evidence\":[{\"end\":46508,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:46471:46508:sha256-d4f1bfddd0872a5183a6dbe2d364892802414a219f1484035e3935087ff59c1a\",\"quote\":\"(c) Funding termination or reductions\",\"start\":46471},{\"end\":46601,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:46509:46601:sha256-13a8d19add8f635f66ac3fe59c819acbf3bc3fbd052edca0c021af3b3e89cc78\",\"quote\":\"For purposes of making a determination in accordance with subsection (b)(8) with respect to—\",\"start\":46509},{\"end\":46654,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:46603:46654:sha256-c12577b5702dccfdc47e6d2666a875b63b5599537340d2278d0cff8a1cb2f846\",\"quote\":\"(1) a funding reduction, the term “cause” includes—\",\"start\":46603},{\"end\":46779,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:46656:46779:sha256-666f1bc31db8076ac930d96d12a392c08b0279bd05ce7c782415b07f67a4be46\",\"quote\":\"(A) a statewide redistribution of funds provided through a community services block grant under this chapter to respond to—\",\"start\":46656},{\"end\":47350,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:46781:47350:sha256-0a0fe1e148279f9dcec0f4f9ba16a3fd0744cb5afc950b47af4357b8bff298ec\",\"quote\":\"(i) the results of the most recently available census or other appropriate data;\\n\\n(ii) the designation of a new eligible entity; or\\n\\n(iii) severe economic dislocation; or\\n\\n\\n(B) the failure of an eligible entity to comply with the terms of an agreement or a State plan, or to meet a State requirement, as described in section 9915(a) of this title; and\\n\\n\\n(2) a termination, the term “cause” includes the failure of an eligible entity to comply with the terms of an agreement or a State plan, or to meet a State requirement, as described in section 9915(a) of this title.\",\"start\":46781},{\"end\":46508,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:46471:46508:sha256-d4f1bfddd0872a5183a6dbe2d364892802414a219f1484035e3935087ff59c1a\",\"quote\":\"(c) Funding termination or reductions\",\"start\":46471},{\"end\":46601,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:46509:46601:sha256-13a8d19add8f635f66ac3fe59c819acbf3bc3fbd052edca0c021af3b3e89cc78\",\"quote\":\"For purposes of making a determination in accordance with subsection (b)(8) with respect to—\",\"start\":46509},{\"end\":47350,\"field\":\"scope_text:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:47135:47350:sha256-08aec7e926755e7b16b9a614f0ab6ab82af8a6aae022d8f943f3785eacd1522a\",\"quote\":\"(2) a termination, the term “cause” includes the failure of an eligible entity to comply with the terms of an agreement or a State plan, or to meet a State requirement, as described in section 9915(a) of this title.\",\"start\":47135},{\"end\":46508,\"field\":\"defined_terms:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:46471:46508:sha256-d4f1bfddd0872a5183a6dbe2d364892802414a219f1484035e3935087ff59c1a\",\"quote\":\"(c) Funding termination or reductions\",\"start\":46471},{\"end\":46601,\"field\":\"defined_terms:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:46509:46601:sha256-13a8d19add8f635f66ac3fe59c819acbf3bc3fbd052edca0c021af3b3e89cc78\",\"quote\":\"For purposes of making a determination in accordance with subsection (b)(8) with respect to—\",\"start\":46509},{\"end\":46654,\"field\":\"defined_terms:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:46603:46654:sha256-c12577b5702dccfdc47e6d2666a875b63b5599537340d2278d0cff8a1cb2f846\",\"quote\":\"(1) a funding reduction, the term “cause” includes—\",\"start\":46603},{\"end\":46779,\"field\":\"defined_terms:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:46656:46779:sha256-666f1bc31db8076ac930d96d12a392c08b0279bd05ce7c782415b07f67a4be46\",\"quote\":\"(A) a statewide redistribution of funds provided through a community services block grant under this chapter to respond to—\",\"start\":46656},{\"end\":47350,\"field\":\"defined_terms:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:46781:47350:sha256-0a0fe1e148279f9dcec0f4f9ba16a3fd0744cb5afc950b47af4357b8bff298ec\",\"quote\":\"(i) the results of the most recently available census or other appropriate data;\\n\\n(ii) the designation of a new eligible entity; or\\n\\n(iii) severe economic dislocation; or\\n\\n\\n(B) the failure of an eligible entity to comply with the terms of an agreement or a State plan, or to meet a State requirement, as described in section 9915(a) of this title; and\\n\\n\\n(2) a termination, the term “cause” includes the failure of an eligible entity to comply with the terms of an agreement or a State plan, or to meet a State requirement, as described in section 9915(a) of this title.\",\"start\":46781},{\"end\":46508,\"field\":\"defined_terms:0:source:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:46471:46508:sha256-d4f1bfddd0872a5183a6dbe2d364892802414a219f1484035e3935087ff59c1a\",\"quote\":\"(c) Funding termination or reductions\",\"start\":46471},{\"end\":46601,\"field\":\"defined_terms:0:source:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:46509:46601:sha256-13a8d19add8f635f66ac3fe59c819acbf3bc3fbd052edca0c021af3b3e89cc78\",\"quote\":\"For purposes of making a determination in accordance with subsection (b)(8) with respect to—\",\"start\":46509},{\"end\":47350,\"field\":\"defined_terms:0:source:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:47135:47350:sha256-08aec7e926755e7b16b9a614f0ab6ab82af8a6aae022d8f943f3785eacd1522a\",\"quote\":\"(2) a termination, the term “cause” includes the failure of an eligible entity to comply with the terms of an agreement or a State plan, or to meet a State requirement, as described in section 9915(a) of this title.\",\"start\":47135}],\"id\":\"urn:rulespec:document-understanding:revision:0bc3baf17a06195a91c38ad99141079d8373b75749868af98ecd66390bca80af\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"definition\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:f27d839c3ad153d9b3ee8a8dd339090a2c33665ddb608e0c56a88192555174cb\",\"modality\":\"not_stated\",\"modality_quote\":\"\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:9b5e1a24dcf72001e15123887af833b56fbac169d5a6cd80c113311212a3e2ce\",\"origin\":\"aiSuggested\",\"quote\":\"(c) Funding termination or reductions For purposes of making a determination in accordance with subsection (b)(8) with respect to—\\n\\n(1) a funding reduction, the term “cause” includes—\\n\\n(A) a statewide redistribution of funds provided through a community services block grant under this chapter to respond to—\\n\\n(i) the results of the most recently available census or other appropriate data;\\n\\n(ii) the designation of a new eligible entity; or\\n\\n(iii) severe economic dislocation; or\\n\\n\\n(B) the failure of an eligible entity to comply with the terms of an agreement or a State plan, or to meet a State requirement, as described in section 9915(a) of this title; and\\n\\n\\n(2) a termination, the term “cause” includes the failure of an eligible entity to comply with the terms of an agreement or a State plan, or to meet a State requirement, as described in section 9915(a) of this title.\",\"references\":[\"subsection (b)(8)\",\"section 9915(a)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:ba69fcc89a438e88a1e02ef84d3b34a60aeabc3dfeb2ea2a5c4d457362839ed2\",\"scope_quotes\":[\"(c) Funding termination or reductions For purposes of making a determination in accordance with subsection (b)(8) with respect to—\",\"(2) a termination, the term “cause” includes the failure of an eligible entity to comply with the terms of an agreement or a State plan, or to meet a State requirement, as described in section 9915(a) of this title.\"],\"scope_text\":\"For purposes of making a determination in accordance with subsection (b)(8) with respect to a termination\",\"section_id\":\"urn:rulespec:document-understanding:section:0b55006ce2c906add8328d3986f73bcd1ded9a87a908d01ae85b5595b9018d1b\",\"start\":46471,\"summary\":\"For purposes of making a determination in accordance with subsection (b)(8) with respect to a termination, the term “cause” includes the failure of an eligible entity to comply with the terms of an agreement or a State plan, or to meet a State requirement, as described in section 9915(a) of this title.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

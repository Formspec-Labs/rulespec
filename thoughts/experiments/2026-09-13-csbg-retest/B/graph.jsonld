    {
      "@id": "urn:rulespec:document-understanding:revision:d5e0310d86cb355326c2888e21768b2d261c12627b1e487fb4e1e9033902c319",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:d5e0310d86cb355326c2888e21768b2d261c12627b1e487fb4e1e9033902c319",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:2b2b5eb1039b99aa6b1643266ae5c8cfd114a70cb32e9d7c669c9d6061675a0b",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:ad76d633a7a5f701d5e60e8991f2501413647f392b2b4c3986f0b5e3d66e7fa3\",\"urn:rulespec:document-understanding:assertion:29dd637f4c741e6454f7a6ec9aa05c2c0f70b240da32a1c989168ad5351becc8\",\"urn:rulespec:document-understanding:assertion:a8f58af5802d8f72e8a8be5b8d485ec051c6199c9104522fd3872e31d648623d\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":82267,\"evidence\":[{\"end\":81630,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:81614:81630:sha256-a622f0710fba02852f8020e3bab5097f93a8df3ebd966e1d4e667aac256dfecc\",\"quote\":\"(2) Prohibitions\",\"start\":81614},{\"end\":81893,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:81631:81893:sha256-813e4ae95546d0c46acd596a8ea69d3657e2b4d28605e8f3615bfb6bc7a80727\",\"quote\":\"Programs assisted under this chapter shall not be carried on in a manner involving the use of program funds, the provision of services, or the employment or assignment of personnel, in a manner supporting or resulting in the identification of such programs with—\",\"start\":81631},{\"end\":82267,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:81895:82267:sha256-ac310a0f05858678f77cf757e40115b85143f7667b3a63746bc28b0e4a3c1034\",\"quote\":\"(A) any partisan or nonpartisan political activity or any political activity associated with a candidate, or contending faction or group, in an election for public or party office;\\n\\n(B) any activity to provide voters or prospective voters with transportation to the polls or similar assistance in connection with any such election; or\\n\\n(C) any voter registration activity.\",\"start\":81895},{\"end\":81677,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:81668:81677:sha256-28a543410ef33838c223aa24fd725afc191e2cefa8bed95abc857ae6ff33f86e\",\"quote\":\"shall not\",\"start\":81668}],\"id\":\"urn:rulespec:document-understanding:revision:d5e0310d86cb355326c2888e21768b2d261c12627b1e487fb4e1e9033902c319\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"prohibition\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:a8f58af5802d8f72e8a8be5b8d485ec051c6199c9104522fd3872e31d648623d\",\"modality\":\"must_not\",\"modality_quote\":\"shall not\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:f310007964e644f492cf5958131d528461a2385be7d1e848a63ae6f2b2e79b2b\",\"origin\":\"aiSuggested\",\"quote\":\"(2) Prohibitions Programs assisted under this chapter shall not be carried on in a manner involving the use of program funds, the provision of services, or the employment or assignment of personnel, in a manner supporting or resulting in the identification of such programs with—\\n\\n(A) any partisan or nonpartisan political activity or any political activity associated with a candidate, or contending faction or group, in an election for public or party office;\\n\\n(B) any activity to provide voters or prospective voters with transportation to the polls or similar assistance in connection with any such election; or\\n\\n(C) any voter registration activity.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:f53d6433743e298a59702bd70c6eeecbba9e2d73aa2ea5a507cced781f9f731e\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"urn:rulespec:document-understanding:section:c2d7d2b3c184cf50d82366ce65cb8d6112ac79f92281542f43e74ba5049712d4\",\"start\":81614,\"summary\":\"Programs assisted under this chapter shall not be carried on in a manner involving the use of program funds, the provision of services, or the employment or assignment of personnel, in a manner supporting or resulting in the identification of such programs with: (A) any partisan or nonpartisan political activity or any political activity associated with a candidate, or contending faction or group, in an election for public or party office; (B) any activity to provide voters or prospective voters with transportation to the polls or similar assistance in connection with any such election; or (C) any voter registration activity.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

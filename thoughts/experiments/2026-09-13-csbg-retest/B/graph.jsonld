          "@id": "urn:rulespec:document-understanding:assertion:6287f3e008d5220d4e78f8ad828836fa3e198f873242b7d152de234e00fbf287"
        },
        {
          "@id": "urn:rulespec:document-understanding:assertion:3fa795fe27f772646bd621eddc2290a79f82870c2403c47bf2ee673051dca9cf"
        },
        {
          "@id": "urn:rulespec:document-understanding:assertion:4b6cc5b81855bb374d933d739195511e1b2d6e8c8cc344172e9fba4688100ff3"

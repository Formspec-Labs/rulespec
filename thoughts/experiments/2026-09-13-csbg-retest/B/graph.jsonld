    {
      "@id": "urn:rulespec:document-understanding:assertion:43d1b2ade10d28b90d4c66d7191c1032f8db7ecd909c1cf2080201dfbd10e3ce",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:4b80bc242bf4108132092097a8f5b641e6a56bd640c5f048e8bbcbf82862ca04",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:8726866cc700d9bc3ee584d6eff92ed615cc821db3d6dce36816f6dd257cd0cd",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:706f05f798933f34ff56d63f1108bf31af9efeb5743755928dc27795f577b77d",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"actor\":\"the Secretary\",\"kind\":\"requirement\",\"modality\":\"must\",\"scope_text\":\"At the end of each fiscal year beginning after September 30, 1999\",\"summary\":\"At the end of each fiscal year beginning after September 30, 1999, the Secretary must, directly or by grant or contract, prepare a report containing: (A) a summary of the planned use of funds by each State, and the eligible entities in the State, under the community services block grant program, as contained in each State plan submitted pursuant to section 9908 of title 42; (B) a description of how funds were actually spent by the State and eligible entities in the State, including a breakdown of funds spent on administrative costs and on the direct delivery of local services by eligible entities; (C) information on the number of entities eligible for funds under this chapter, the number of low-income persons served under this chapter, and such demographic data on the low-income populations served by eligible entities as is determined by the Secretary to be feasible; (D) a comparison of the planned uses of funds for each State and the actual uses of the funds; (E) a summary of each State's performance results, and the results for the eligible entities, as collected and submitted by the States in accordance with subsection (a)(2); and (F) any additional information that the Secretary considers to be appropriate to carry out this chapter, if the Secretary informs the States of the need for such additional information and allows a reasonable period of time for the States to collect and provide the information.\"}",
        "@type": "xsd:string"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed",
      "rkaf:hasApplicability": "urn:rulespec:document-understanding:scope:743550935c23a1371c6006209a88055c23e2610e2cd2bcac0870fd1db963ea66"
    },

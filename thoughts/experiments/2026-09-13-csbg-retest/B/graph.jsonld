    {
      "@id": "urn:rulespec:document-understanding:revision:248427429d18496e8b01138448332dffabf72e27ea7a04463d54fe7d93cf1db9",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:248427429d18496e8b01138448332dffabf72e27ea7a04463d54fe7d93cf1db9",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:ada5c09f4c721c705f9b36a7b6897432aa1bf4315bdffd1a6e18cfde20c1a52d",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"The State\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:21aeff6c2453948d5e33a42d72906397726f4549ec22ff2b735eca871f8953f0\",\"urn:rulespec:document-understanding:assertion:360fd8fc357f3a72060e0497502444eef8b26f454ca70e1e300653847a541908\",\"urn:rulespec:document-understanding:assertion:22dc9de1db7bd2c0ca077c1ed2d3a4bcbf3f3be0f7aed9d3fe3bdd2f31b6170e\",\"urn:rulespec:document-understanding:assertion:998d38bc7e9fd7f7ac554a3e6dcb77a4817334a5c3a377fbc015a6b33b0efdd9\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":76900,\"evidence\":[{\"end\":76900,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:75850:76900:sha256-a8c97f226194b31c7800e46ee385858e4e2bb2ea3d8bf2f47166ef843912e6be\",\"quote\":\"Each State shall annually prepare and submit to the Secretary a report on the measured performance of the State and the eligible entities in the State. Prior to the participation of the State in the performance measurement system, the State shall include in the report any information collected by the State relating to such performance. Each State shall also include in the report an accounting of the expenditure of funds received by the State through the community services block grant program, including an accounting of funds spent on administrative costs by the State and the eligible entities, and funds spent by eligible entities on the direct delivery of local services, and shall include information on the number of and characteristics of clients served under this chapter in the State, based on data collected from the eligible entities. The State shall also include in the report a summary describing the training and technical assistance offered by the State under section 9915(a)(3) of this title during the year covered by the report.\",\"start\":75850},{\"end\":76709,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:76700:76709:sha256-a6addfb0a71417c5f50b371fe24cb9aeefd162c1d2808c65fb7a63acc516db5d\",\"quote\":\"The State\",\"start\":76700}],\"id\":\"urn:rulespec:document-understanding:revision:248427429d18496e8b01138448332dffabf72e27ea7a04463d54fe7d93cf1db9\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:998d38bc7e9fd7f7ac554a3e6dcb77a4817334a5c3a377fbc015a6b33b0efdd9\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:43649068c97ae648232779b5a153efd188dbb3f9faf80881383306a76f478805\",\"origin\":\"aiSuggested\",\"quote\":\"Each State shall annually prepare and submit to the Secretary a report on the measured performance of the State and the eligible entities in the State. Prior to the participation of the State in the performance measurement system, the State shall include in the report any information collected by the State relating to such performance. Each State shall also include in the report an accounting of the expenditure of funds received by the State through the community services block grant program, including an accounting of funds spent on administrative costs by the State and the eligible entities, and funds spent by eligible entities on the direct delivery of local services, and shall include information on the number of and characteristics of clients served under this chapter in the State, based on data collected from the eligible entities. The State shall also include in the report a summary describing the training and technical assistance offered by the State under section 9915(a)(3) of this title during the year covered by the report.\",\"references\":[\"section 9915(a)(3) of this title\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:89f3eb02127c2088c5d2a88205938622ec08ae0842efff991ae8ceb66d47c379\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"urn:rulespec:document-understanding:section:fa489a00ccb41098ac2b415167888ae0d85e530b88cc3c90eda7efe29c7dad7b\",\"start\":75850,\"summary\":\"The State must also include in its annual report a summary describing the training and technical assistance offered by the State under 42 U.S.C. 9915(a)(3) during the year covered by the report.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

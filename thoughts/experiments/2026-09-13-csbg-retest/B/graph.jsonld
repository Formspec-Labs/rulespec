    {
      "@id": "urn:rulespec:document-understanding:revision:adffa6df679430670defcf55a5f583426103cc5ed35c82f12af91e29e8bda599",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:adffa6df679430670defcf55a5f583426103cc5ed35c82f12af91e29e8bda599",

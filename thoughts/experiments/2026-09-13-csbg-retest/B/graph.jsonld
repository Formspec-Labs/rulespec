      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"The Secretary\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:6b8d34329096c01e4dd096e6c270a8a03f941c6d9d5f79061bd9290ad79a7d32\",\"urn:rulespec:document-understanding:assertion:3b3f46da376101cedbcdfebe78bb6a00587e1a3cb40f17b053d09604fd05b840\",\"urn:rulespec:document-understanding:assertion:8dcf91ef295601d8beb386ca4e19f5c3eaf8324c95671c4ddba955fd7b1de0e5\",\"urn:rulespec:document-understanding:assertion:f951877d805773e4ae84815e526518793c7bcb666a7ff3dce9f419578caad065\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":93897,\"evidence\":[{\"end\":93300,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:93258:93300:sha256-1398adb1e1e28e54b345344fe06957f65d16318944a79f1957c714df6a25c8bb\",\"quote\":\"(3) Rural community development activities\",\"start\":93258},{\"end\":93445,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:93301:93445:sha256-24a677b98e3aa1d26dc7e720a4dcc62b4e840f357c1953f07db4bb2864044011\",\"quote\":\"The Secretary shall provide the assistance described in paragraph (1) for rural community development activities, which shall include providing—\",\"start\":93301},{\"end\":93897,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:93447:93897:sha256-a743772fa73f5b5e6bd98de433add2510d09f42c316b08318cf66464a7799782\",\"quote\":\"(A) grants to private, nonprofit corporations to enable the corporations to provide assistance concerning home repair to rural low-income families and concerning planning and developing low-income rural rental housing units; and\\n\\n(B) grants to multistate, regional, private, nonprofit organizations to enable the organizations to provide training and technical assistance to small, rural communities concerning meeting their community facility needs.\",\"start\":93447},{\"end\":93314,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:93301:93314:sha256-d6dd2bb6d3c44b4545cc3f97cb6f8a38842ecd30d2c58ec3e1c53a8c1a0ac77c\",\"quote\":\"The Secretary\",\"start\":93301}],\"id\":\"urn:rulespec:document-understanding:revision:a8eb4edddc99df3f5446e9128fea4ce88d4d5e1f196f6d1e4375ff1466d2b3af\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:f951877d805773e4ae84815e526518793c7bcb666a7ff3dce9f419578caad065\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:506b49510de4258a2b5a6525fbb2ce6c0e9a9da32320c901abe4d0158888cf8e\",\"origin\":\"aiSuggested\",\"quote\":\"(3) Rural community development activities The Secretary shall provide the assistance described in paragraph (1) for rural community development activities, which shall include providing—\\n\\n(A) grants to private, nonprofit corporations to enable the corporations to provide assistance concerning home repair to rural low-income families and concerning planning and developing low-income rural rental housing units; and\\n\\n(B) grants to multistate, regional, private, nonprofit organizations to enable the organizations to provide training and technical assistance to small, rural communities concerning meeting their community facility needs.\",\"references\":[\"paragraph (1)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:3dd5f75f76b0a100489234994d59ea99144283d696b5f1fcc5773ff69f3611ac\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"urn:rulespec:document-understanding:section:6888d98c59cc2331f4c6a6a1e0052761ef3a8008658a9708c0cec6503ed121ed\",\"start\":93258,\"summary\":\"The Secretary shall provide the assistance described in paragraph (1) for rural community development activities, which shall include providing grants to private, nonprofit corporations to enable the corporations to provide assistance concerning home repair to rural low-income families and concerning planning and developing low-income rural rental housing units, and grants to multistate, regional, private, nonprofit organizations to enable the organizations to provide training and technical assistance to small, rural communities concerning meeting their community facility needs.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

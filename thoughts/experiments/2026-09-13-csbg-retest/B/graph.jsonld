      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:4b80bc242bf4108132092097a8f5b641e6a56bd640c5f048e8bbcbf82862ca04",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:11bef7aa57c32d28c2b4f2f7c802a05c477966f9f18dba0ae2791f70aed66cf3",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:4f1f16e8fe2ddf614c37d7021e836ddbf60e4464604a153dee45fe0108c91faa",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:states-requirement",
      "rkaf:assertsValue": {
        "@value": "If the State determines, on the basis of a final decision in a review pursuant to section 9914 of this title, that an eligible entity fails to comply with the terms of an agreement, or the State plan, to provide services under this chapter or to meet appropriate standards, goals, and other requirements established by the State (including performance objectives), and if the State determines that training and technical assistance to help correct the deficiency are not appropriate, the State shall prepare and submit to the Secretary a report stating the reasons for the determination.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

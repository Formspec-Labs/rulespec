      "rkaf:assertsValue": {
        "@value": "{\"actor\":\"The Secretary\",\"kind\":\"requirement\",\"modality\":\"must\",\"summary\":\"The Secretary shall, from funds reserved under section 9903(b)(3) of this title, make grants, loans, or guarantees to States and public agencies and private, nonprofit organizations, or enter into contracts or jointly financed cooperative arrangements with States and public agencies and private, nonprofit organizations (and for-profit organizations, to the extent specified in paragraph (2)(E)) for each of the objectives described in paragraphs (2) through (4).\"}",
        "@type": "xsd:string"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

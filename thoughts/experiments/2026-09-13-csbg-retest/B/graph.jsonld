      "dcterms:description": "{\"action\":\"\",\"actor\":\"the chief executive officer\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:a02648c54118d2b10cda0ad0d046489b4a5df8f3eecd1459c5e9e33b1fc14e81\",\"urn:rulespec:document-understanding:assertion:62cad2bd766fb05162934e9a9b037a762601a929be1ca3f77cb920d9da90e493\",\"urn:rulespec:document-understanding:assertion:437ac163378cd9989af0c5fa5acee2a18241a8f4396e8acbce50386f13a81aa6\",\"urn:rulespec:document-understanding:assertion:7b3703e513bd2e4cd1d5bcdaf96df58c59aa54885ac97b0990aa8a0d2a4d54e5\",\"urn:rulespec:document-understanding:assertion:a63a5689b30cbb13b1ae4da56a7cecefaec998f9a216d99727e04079a9d8f440\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":53156,\"evidence\":[{\"end\":53156,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:52745:53156:sha256-e1706c26f78180af15def5eab3e88737527dae03f4a18f55387d1c424e1477d2\",\"quote\":\"In designating an eligible entity under subsection (a), the chief executive officer shall grant the designation to an organization of demonstrated effectiveness in meeting the goals and purposes of this chapter and may give priority, in granting the designation, to eligible entities that are providing related services in the unserved area, consistent with the needs identified by a community-needs assessment.\",\"start\":52745},{\"end\":52828,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:52801:52828:sha256-d44239874c9022ec9a79a4927817d7b4a7191564f32fab802aa5e97eb7824a2d\",\"quote\":\"the chief executive officer\",\"start\":52801},{\"end\":52834,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:52829:52834:sha256-56ee5b508706bf2de91712d85d6d1e11ddbff01949142ed6e8c22e3b1bed1c71\",\"quote\":\"shall\",\"start\":52829},{\"end\":53156,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:52745:53156:sha256-e1706c26f78180af15def5eab3e88737527dae03f4a18f55387d1c424e1477d2\",\"quote\":\"In designating an eligible entity under subsection (a), the chief executive officer shall grant the designation to an organization of demonstrated effectiveness in meeting the goals and purposes of this chapter and may give priority, in granting the designation, to eligible entities that are providing related services in the unserved area, consistent with the needs identified by a community-needs assessment.\",\"start\":52745}],\"id\":\"urn:rulespec:document-understanding:revision:e098d69addf0551b52cfd213f7a44f2492bfec116ea8d9b92a8366c73cbc7048\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:a63a5689b30cbb13b1ae4da56a7cecefaec998f9a216d99727e04079a9d8f440\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:8c55c2a99bf5bafa2660bc8b0e2c82207c22fcf65d434d99c2ffe352d09e6523\",\"origin\":\"aiSuggested\",\"quote\":\"In designating an eligible entity under subsection (a), the chief executive officer shall grant the designation to an organization of demonstrated effectiveness in meeting the goals and purposes of this chapter and may give priority, in granting the designation, to eligible entities that are providing related services in the unserved area, consistent with the needs identified by a community-needs assessmen
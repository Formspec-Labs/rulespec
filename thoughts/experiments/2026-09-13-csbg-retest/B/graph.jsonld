      "rkaf:hasContentDigest": "sha256:be7f11e487ca1d1b51188c4e81586ca3946ec95091ea7ddcf82e40bad7cbac60",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"A State that conducts such testing\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:a4cf377931d634686e35b73791a18873fb40f67d981821de06b6dc7da7f89be0\",\"urn:rulespec:document-understanding:assertion:11714d435564e668c3b38a4f8854184e65eb9704ba33cd5fc6e9ee86c1596ac3\",\"urn:rulespec:document-understanding:assertion:35e4d45880ca5ea9cb81a4f16939b11819b19ab0bc2930040ea6bb16375421f7\",\"urn:rulespec:document-understanding:assertion:bc9676945546ff67f73c6a11a46ba43a2190bdaa1c600357e2dc94c7ed061486\",\"urn:rulespec:document-understanding:assertion:cfd1947ed4132d50f4a28c7dba7dd43808b1541d7ff1f0ab92720386900c13c0\",\"urn:rulespec:document-understanding:assertion:9a9898c6fc65d86a8cc70f2faf516e56ddd7c795ec1672d3a4ac6ed83e35abfb\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[\"(a) Drug testing and rehabilitation\",\"(1) In general\"],\"defined_terms\":[],\"effective_periods\":[],\"end\":86531,\"evidence\":[{\"end\":86531,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:86081:86531:sha256-1f0392c74c19d0a1caef9fdd65626f1f73405d082df638e9645c4ae0deafbcd2\",\"quote\":\"Nothing in this chapter shall be construed to prohibit a State from testing participants in programs, activities, or services carried out or provided under this chapter for controlled substances. A State that conducts such testing shall inform the participants who test positive for any of such substances about the availability of treatment or rehabilitation services and refer such participants for appropriate treatment or rehabilitation services.\",\"start\":86081},{\"end\":86311,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:86277:86311:sha256-72682e1efa3f7833a6d669a4bab64ca2fd40827badf64141432cbb6b112d8852\",\"quote\":\"A State that conducts such testing\",\"start\":86277},{\"end\":86531,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:86081:86531:sha256-1f0392c74c19d0a1caef9fdd65626f1f73405d082df638e9645c4ae0deafbcd2\",\"quote\":\"Nothing in this chapter shall be construed to prohibit a State from testing participants in programs, activities, or services carried out or provided under this chapter for controlled substances. A State that conducts such testing shall inform the participants who test positive for any of such substances about the availability of treatment or rehabilitation services and refer such participants for appropriate treatment or rehabilitation services.\",\"start\":86081},{\"end\":86063,\"field\":\"context:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:86028:86063:sha256-6d76775d5350e3c5818491c7af74d45118efcf0ececcafb68aacb683a1184c2f\",\"quote\":\"(a) Drug testing and rehabilitation\",\"start\":86028}],\"id\":\"urn:rulespec:document-understanding:revision:f7f9954d02ef58dc01a2ba1921a45d267932b83a7ce1c5c264126a3f49c7fa29\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:cfd1947ed4132d50f4a28c7dba7dd43808b1541d7ff1f0ab92720386900c13c0\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:a7afac67bc14468b05612af5d9b7939c709eed5f2d34848f6f739aa66de8b718\",\"origin\":\"aiSuggested\",\"quote\":\"Nothing in this chapter shall be construed to prohibit a State from testing participants in programs, activities, or services carried out or provided under this chapter for controlled substances. A State that conducts such testing shall inform the participants who test positive for any of such substances about the availability of treatment or rehabilitation services and refer such participants for appropriate treatment or rehabilitation services.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:0c00aea6cd3416fb2679fce9ac24b7cfb885acc95148fa81dcf1b5c145d550bb\",\"scope_quotes\":[\"Nothing in this chapter shall be construed to prohibit a State from testing participants in programs, activities, or services carried out or provided under this chapter for controlled substances. A State that conducts such testing shall inform the participants who test positive for any of such substances about the availability of treatment or rehabilitation services and refer such participants for appropriate treatment or rehabilitation services.\"],\"scope_text\":\"A State that conducts testing of participants in programs, activities, or services carried out or provided under this chapter for controlled substances\",\"section_id\":\"urn:rulespec:document-understanding:section:214ad60901a587753e79aabc24ace858a542d5405e31b466690ba730688916c0\",\"start\":86081,\"summary\":\"A State that conducts drug testing of participants in programs, activities, or services carried out or provided under this chapter for controlled substances shall inform the participants who test positive for any of such substances about the availability of treatment or rehabilitation services and refer such participants for appropriate treatment or rehabilitation services.\",\"target_ids\":[],\"term_refs\":[\"urn:rulespec:document-understanding:term:6bbc300c908c37f17bd770ac79351e2f73a7907fd41fbd4359723f71c0c578f1\"],\"typed_values\":[]}",

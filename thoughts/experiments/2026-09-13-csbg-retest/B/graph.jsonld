      "@id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:34555:34695:sha256-857ef718394bbcbc477c416bdeb788f253e0645fe067a5d77b2fb85c20ab1160",
      "@type": "rkaf:SourceFragment",

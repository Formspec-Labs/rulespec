    {
      "@id": "urn:rulespec:document-understanding:revision:35e03764607c82672f4f8ebbbae3f63a2c953bcb2b53fc11c4bbca3865c20f20",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:35e03764607c82672f4f8ebbbae3f63a2c953bcb2b53fc11c4bbca3865c20f20",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:ef572694c36a641b6cbc2c936fdb351ce69f74ef5c12721bed7bae4c6dd7b104",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"the Secretary\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:eaab0365724f2366df290be27d973d3a48573337bcb77ca3cb83946cfd246c35\",\"urn:rulespec:document-understanding:assertion:9d0ca0708aca8b27c943944ebbf101a79d43e5013ab24ae397f805531d0b7673\",\"urn:rulespec:document-understanding:assertion:9c60c8edee6df523db8d14abfa429bb55fb9d97a0cde6ade837fae67cd5eab8f\",\"urn:rulespec:document-understanding:assertion:c0b296adaa5db28d35ca3b25e1f8eb897dee344b24fc2af8944a894cd2567b42\",\"urn:rulespec:document-understanding:assertion:ec1a3920710addb6cbc4d1175cdd68b27ad5aa7bc54e3473ccd1299ef1ab1ad6\",\"urn:rulespec:document-understanding:assertion:4ecbfa7d695ad7faebcaea8a4dbad2aebf0c41d4038c079beea345709f8af4f5\",\"urn:rulespec:document-understanding:assertion:04fb66a22d4ee362309f4315f7a152749d337894323d434fadbfca3bff4e7b88\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":59645,\"evidence\":[{\"end\":59052,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:59037:59052:sha256-99a455f2bc376242ecdd7d7e7b84122bdc7bafcc965610878f7ab795359830e7\",\"quote\":\"(a) Reservation\",\"start\":59037},{\"end\":59098,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:59053:59098:sha256-97c4a983cdbaf1fa6f20740d38976072f6e4b9e308cb34c59f3c5824aec1d170\",\"quote\":\"If, with respect to any State, the Secretary—\",\"start\":59053},{\"end\":59645,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:59100:59645:sha256-5694ee3d4d8344894755da128ae6d9aee99ca5674bbe68a656d7631613cd5121\",\"quote\":\"(1) receives a request from the governing body of an Indian tribe or tribal organization within the State that assistance under this chapter be made directly to such tribe or organization; and\\n\\n(2) determines that the members of such tribe or tribal organization would be better served by means of grants made directly to provide benefits under this chapter,\\n\\n\\nthe Secretary shall reserve from amounts that would otherwise be allotted to such State under section 9906 of this title for the fiscal year the amount determined under subsection (b).\",\"start\":59100},{\"end\":59480,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:59475:59480:sha256-56ee5b508706bf2de91712d85d6d1e11ddbff01949142ed6e8c22e3b1bed1c71\",\"quote\":\"shall\",\"start\":59475},{\"end\":59052,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:59037:59052:sha256-99a455f2bc376242ecdd7d7e7b84122bdc7bafcc965610878f7ab795359830e7\",\"quote\":\"(a) Reservation\",\"start\":59037},{\"end\":59098,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:59053:59098:sha256-97c4a983cdbaf1fa6f20740d38976072f6e4b9e308cb34c59f3c5824aec1d170\",\"quote\":\"If, with respect to any State, the Secretary—\",\"start\":59053},{\"end\":59458,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:59100:59458:sha256-8cb1ad39da86d02340642f0122adbe126f5259b3d36f1b25301ae7a3d563ad15\",\"quote\":\"(1) receives a request from the governing body of an Indian tribe or tribal organization within the State that assistance under this chapter be made directly to such tribe or organization; and\\n\\n(2) determines that the members of such tribe or tribal organization would be better served by means of grants made directly to provide benefits under this chapter,\",\"start\":59100}],\"id\":\"urn:rulespec:document-understanding:revision:35e03764607c82672f4f8ebbbae3f63a2c953bcb2b53fc11c4bbca3865c20f20\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:ec1a3920710addb6cbc4d1175cdd68b27ad5aa7bc54e3473ccd1299ef1ab1ad6\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:c99c5defc83af5a103f5eb45c0115e1b2a8e96f122e0a5f0bc7ca1442180225e\",\"origin\":\"aiSuggested\",\"quote\":\"(a) Reservation If, with respect to any State, the Secretary—\\n\\n(1) receives a request from the governing body of an Indian tribe or tribal organization within the State that assistance under this chapter be made directly to such tribe or organization; and\\n\\n(2) determines that the members of such tribe or tribal organization would be better served by means of grants made directly to provide benefits under this chapter,\\n\\n\\nthe Secretary shall reserve from amounts that would otherwise be allotted to such State under section 9906 of this title for the fiscal year the amount determined under subsection (b).\",\"references\":[\"section 9906 of this title\",\"subsection (b)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:34fae57e37cf1080c0197921f027b68c55293b72dc7bc85b3e835fcb4403b592\",\"scope_quotes\":[\"(a) Reservation If, with respect to any State, the Secretary—\\n\\n(1) receives a request from the governing body of an Indian tribe or tribal organization within the State that assistance under this chapter be made directly to such tribe or organization; and\\n\\n(2) determines that the members of such tribe or tribal organization would be better served by means of grants made directly to provide benefits under this chapter,\"],\"scope_text\":\"If, with respect to any State, the Secretary receives a request from the governing body of an Indian tribe or tribal organization within the State that assistance under this chapter be made directly to such tribe or organization, and determines that the members of such tribe or tribal organization would be better served by means of grants made directly to provide benefits under this chapter\",\"section_id\":\"urn:rulespec:document-understanding:section:3c750aa6689e2d574a3e823610c64c083d9c43e7cd5caf47f66392a719ccd88d\",\"start\":59037,\"summary\":\"If, with respect to any State, the Secretary receives a request from the governing body of an Indian tribe or tribal organization within the State that assistance under this chapter be made directly to such tribe or organization, and determines that the members of such tribe or tribal organization would be better served by means of grants made directly to provide benefits under this chapter, the Secretary shall reserve from amounts that would otherwise be allotted to such State under section 9906 of this title for the fiscal year the amount determined under subsection (b).\",\"target_ids\":[],\"term_refs\":[\"urn:rulespec:document-understanding:term:1bcd73b470ac4c8531230b5639216fb560393ba19b8e130d369cb6682ffbba55\",\"urn:rulespec:document-understanding:term:7544d7fbedc74d0001f964d7e2c1f7e24a7a00034aab42bbbf8b1cfb9d838f00\"],\"typed_values\":[]}",
      "dcterms:references": [

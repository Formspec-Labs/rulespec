      "rkaf:assertsValue": {
        "@value": "Beginning with fiscal year 2000, the State's application and plan submitted to be eligible for a grant or allotment under section 9905 or 9906 of this title must contain information describing how the State will carry out the assurances described in subsection (b).",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

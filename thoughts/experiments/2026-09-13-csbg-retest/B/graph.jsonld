      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"the Secretary\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:9459390b07cf48218939ad12cffcf37ba658f26fac37eece1e8423b8827645aa\",\"urn:rulespec:document-understanding:assertion:e0ae1d38ff86968eed8dc8f80931ea6c9e1b1e4e88fb95915f80de090f9046b3\",\"urn:rulespec:document-understanding:assertion:1dd2fc943052636268c2d20d9da1ff287ebf56f2b2efc26c856812705f09103e\",\"urn:rulespec:document-understanding:assertion:6a40c74d5757edd4d1df2e1d1ab0ef63b52a6affc41dba441d04796d083b6ca2\",\"urn:rulespec:document-understanding:assertion:96c410f34cdb2d9273b99c955e222195f78a289f6d556559c010e624578f7c09\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":100072,\"evidence\":[{\"end\":99296,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:99250:99296:sha256-6f4ce65cb40c1b27bb630d4326b30f18dd7cd25e04a1cfde46dc7930cb924b1f\",\"quote\":\"(1) Not to exceed $6,000,000 in appropriations\",\"start\":99250},{\"end\":99480,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:99297:99480:sha256-ab20de0207ce633bb3642097e52e1c6c730fc64096c1fa1eda9080fb52fa0795\",\"quote\":\"Of the amount appropriated for a fiscal year to carry out this section (but not to exceed $6,000,000), the Secretary shall distribute funds for grants under subsection (a) as follows:\",\"start\":99297},{\"end\":99496,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:99482:99496:sha256-9c42fb46ddf93b999d39103000936dbcb7ffda46cd45642986088a12333f6098\",\"quote\":\"(A) Allotments\",\"start\":99482},{\"end\":99879,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:99498:99879:sha256-b5fc89ca6cdae9c14da3b6d46c0d30204261d62f0289f979ad27cbc263b50272\",\"quote\":\"From a portion equal to 60 percent of such amount (but not to exceed $3,600,000), the Secretary shall allot for grants to eligible agencies for statewide programs in each State the amount that bears the same ratio to such portion as the low-income and unemployed population of such State bears to the low-income and unemployed population of all the States.\\n\\n\\n(B) Competitive grants\",\"start\":99498},{\"end\":100072,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:99881:100072:sha256-7176e5d5fae6df04e8f2fd44f6537deb4e05dd1811b4f3f0aa6b5d0a14e167a8\",\"quote\":\"From a portion equal to 40 percent of such amount (but not to exceed $2,400,000), the Secretary shall make grants on a competitive basis to eligible agencies for local and statewide programs.\",\"start\":99881},{\"end\":99296,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:99250:99296:sha256-6f4ce65cb40c1b27bb630d4326b30f18dd7cd25e04a1cfde46dc7930cb924b1f\",\"quote\":\"(1) Not to exceed $6,000,000 in appropriations\",\"start\":99250},{\"end\":99480,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:99297:99480:sha256-ab20de0207ce633bb3642097e52e1c6c730fc64096c1fa1eda9080fb52fa0795\",\"quote\":\"Of the amount appropriated for a fiscal year to carry out this section (but not to exceed $6,000,000), the Secretary shall distribute funds for grants under subsection (a) as follows:\",\"start\":99297}],\"id\":\"urn:rulespec:document-understanding:revision:98e5481ee92c6fe13f51671fbb803177ebfab3591a03e3866d89b1b75959265c\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:96c410f34cdb2d9273b99c955e222195f78a289f6d556559c010e624578f7c09\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:019038e14f499050c8fa4febacfe42fc337d757a66dfe87e0f73d5e076087001\",\"origin\":\"aiSuggested\",\"quote\":\"(1) Not to exceed $6,000,000 in appropriations Of the amount appropriated for a fiscal year to carry out this section (but not to exceed $6,000,000), the Secretary shall distribute funds for grants under subsection (a) as follows:\\n\\n(A) Allotments\\n\\nFrom a portion equal to 60 percent of such amount (but not to exceed $3,600,000), the Secretary shall allot for grants to eligible agencies for statewide programs in each State the amount that bears the same ratio to such portion as the low-income and unemployed population of such State bears to the low-income and unemployed population of all the States.\\n\\n\\n(B) Competitive grants\\n\\nFrom a portion equal to 40 percent of such amount (but not to exceed $2,400,000), the Secretary shall make grants on a competitive basis to eligible agencies for local and statewide programs.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:b6a18820c6dc386974a1ec202ab6a8a38a1c8712b5bba9094874ebc158bea74e\",\"scope_quotes\":[\"(1) Not to exceed $6,000,000 in appropriations Of the amount appropriated for a fiscal year to carry out this section (but not to exceed $6,000,000), the Secretary shall distribute funds for grants under subsection (a) as follows:\"],\"scope_text\":\"Of the amount appropriated for a fiscal year to carry out this section (but not to exceed $6,000,000)\",\"section_id\":\"urn:rulespec:document-understanding:section:cad1a9ce814f7bc8d23a6ff48e1865a684b16830bcf049a10118a7b6cab89b15\",\"start\":99250,\"summary\":\"Of the amount appropriated for a fiscal year to carry out this section (but not to exceed $6,000,000), the Secretary shall make grants on a competitive basis to eligible agencies for local and statewide programs from a portion equal to 40 percent of such amount (but not to exceed $2,400,000).\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

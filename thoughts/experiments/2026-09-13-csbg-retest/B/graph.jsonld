      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "Pub. L. 103–252, title II, § 201(a), May 18, 1994, 108 Stat. 651, provided that: “This title [enacting section 9910c of this title, amending this section and sections 9903, 9904, 9910, 9910a, 9910b, 9911, 9912, and 11464 of this title, and enacting provisions set out as a note under this section] may be cited as the ‘Community Services Block Grant Amendments of 1994’.”"
        },
        {
          "@type": "oa:TextPositionSelector",
          "oa:start": 5284,
          "oa:end": 5655,
          "rkaf:coordinateSystem": "rkaf:unicode-codepoint"
        }
      ]
    },

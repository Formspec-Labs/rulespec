    {
      "@id": "urn:rulespec:document-understanding:assertion:11d993115793e0eb37837bb700adea0d5074b27c838c03c33e8f98fb41ff4d18",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:4b80bc242bf4108132092097a8f5b641e6a56bd640c5f048e8bbcbf82862ca04",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:3d5314ddf0c5e8d85fc2ad1f82947fc8923794f629e4490f8a1e58bdaf444e17",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:d0b8fc159371c4d131e01b7e586c191502d7b8484bf904332c4ec02625011837",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"actor\":\"a State\",\"kind\":\"requirement\",\"modality\":\"must\",\"scope_text\":\"Beginning with fiscal year 2000, to be eligible to receive a grant or allotment under section 9905 or 9906 of this title\",\"summary\":\"Beginning with fiscal year 2000, the State's application and plan submitted to be eligible for a grant or allotment under section 9905 or 9906 of this title must contain information provided by eligible entities in the State, containing: (A) a description of the service delivery system for services provided or coordinated with funds from grants made under section 9907(a) targeted to low-income individuals and families; (B) a description of how linkages will be developed to fill identified service gaps via information, referrals, case management, and followup consultations; (C) a description of how funds from section 9907(a) grants will be coordinated with other public and private resources; and (D) a description of how the local entity will use the funds to support innovative community and neighborhood-based initiatives related to the purposes of this chapter (which may include fatherhood initiatives and other family-strengthening and parenting initiatives).\"}",
        "@type": "xsd:string"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed",
      "rkaf:hasApplicability": "urn:rulespec:document-understanding:scope:dd7c1818b57327538a957baed6ff52091d9f9e712a6eb96149c9cc05d67144bc"
    },

    {
      "@id": "urn:rulespec:document-understanding:revision:da8b38551e2301b10ac79b5f3ab26e97577d2b8aa59743d99f8738d977622f47",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:da8b38551e2301b10ac79b5f3ab26e97577d2b8aa59743d99f8738d977622f47",

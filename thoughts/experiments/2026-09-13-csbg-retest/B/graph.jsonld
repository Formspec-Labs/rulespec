    {
      "@id": "urn:rulespec:document-understanding:binding:4a735053fd4cbd117b0cb83e1a621a96a9701cc4146e716da50950c002e03dde",
      "@type": "rkaf:EvidenceBinding",
      "rkaf:bindsAssertion": "urn:rulespec:document-understanding:assertion:4b6cc5b81855bb374d933d739195511e1b2d6e8c8cc344172e9fba4688100ff3",

      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"The Secretary\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:0705eeea5004b1a01924c0928c1a9a219a9a0331dc4e464f674cead224573558\",\"urn:rulespec:document-understanding:assertion:d6e20ab57c8dc34f54f78b72a4844dacfadcd277186eadb94fd7c168dec54968\",\"urn:rulespec:document-understanding:assertion:94974bfa4ec6fc6125854f91683a6eed153fb2c262f099798b2ca9d2a0cb2635\",\"urn:rulespec:document-understanding:assertion:72bf140e0fc883052f874b591c1da8e375e2ace4a41a471315f924072d519d37\",\"urn:rulespec:document-understanding:assertion:baf47254a8860ce493ba6154cb5bacd722765ee21670fd4bca5f32526ad81ddc\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":82595,\"evidence\":[{\"end\":82595,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:82297:82595:sha256-65c9029741b4ac369a5c5a7f1df60649c1c4148eb927c2ee9fcc4bdc2e54a4e0\",\"quote\":\"The Secretary, after consultation with the Office of Personnel Management, shall issue rules and regulations to provide for the enforcement of this subsection, which shall include provisions for summary suspension of assistance or other action necessary to permit enforcement on an emergency basis.\",\"start\":82297},{\"end\":82310,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:82297:82310:sha256-d6dd2bb6d3c44b4545cc3f97cb6f8a38842ecd30d2c58ec3e1c53a8c1a0ac77c\",\"quote\":\"The Secretary\",\"start\":82297},{\"end\":82595,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:82297:82595:sha256-65c9029741b4ac369a5c5a7f1df60649c1c4148eb927c2ee9fcc4bdc2e54a4e0\",\"quote\":\"The Secretary, after consultation with the Office of Personnel Management, shall issue rules and regulations to provide for the enforcement of this subsection, which shall include provisions for summary suspension of assistance or other action necessary to permit enforcement on an emergency basis.\",\"start\":82297}],\"id\":\"urn:rulespec:document-understanding:revision:56bf9f7fa3f779001bcbac8e93f99c1bb16cab2cc0846e4fa8ca4bdb306e13a6\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:baf47254a8860ce493ba6154cb5bacd722765ee21670fd4bca5f32526ad81ddc\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:fbfa89873e52d22aa6f09d6b4fa07b73c2c07edfdae5b6c8adae83056007a690\",\"origin\":\"aiSuggested\",\"quote\":\"The Secretary, after consultation with the Office of Personnel Management, shall issue rules and regulations to provide for the enforcement of this subsection, which shall include provisions for summary suspension of assistance or other action necessary to permit enforcement on an emergency basis.\",\"references\":[\"this subsection\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:d7cf3d7e3df0e6dd33140a591e533dbc32b807329f6c6a2ac4242a7660bd0e18\",\"scope_quotes\":[\"The Secretary, after consultation with the Office of Personnel Management, shall issue rules and regulations to provide for the enforcement of this subsection, which shall include provisions for summary suspension of assistance or other action necessary to permit enforcement on an emergency basis.\"],\"scope_text\":\"after consultation with the Office of Personnel Management\",\"section_id\":\"urn:rulespec:document-understanding:section:c2d7d2b3c184cf50d82366ce65cb8d6112ac79f92281542f43e74ba5049712d4\",\"start\":82297,\"summary\":\"The Secretary, after consultation with the Office of Personnel Management, shall issue rules and regulations to provide for the enforcement of subsection (b), which shall include provisions for summary suspension of assistance or other action necessary to permit enforcement on an emergency basis.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

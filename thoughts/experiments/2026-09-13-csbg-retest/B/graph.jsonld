      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"defined_terms\":[{\"id\":\"urn:rulespec:document-understanding:term:1e351419499b530ac54db497abdccb87895b108bc08093b46b291d5adfbc497c\",\"label\":\"poverty program expense\",\"quote\":\"The term “poverty program expense” means any expense in providing direct services referred to in clause (iii).\",\"source_quotes\":[\"(II) Poverty program expense For purposes of subclause (I)—\\n\\n(aa) In general\\n\\nThe term “poverty program expense” means any expense in providing direct services referred to in clause (iii).\\n\\n\\n(bb) Exceptions\\n\\nSuch term shall not include any management or general expense, any expense for the purpose of influencing legislation (as defined in section 4911(d) of title 26), any expense for the purpose of fundraising, any expense for a legal service provided on behalf of any individual referred to in clause (iii), any expense for providing tuition assistance relating to compulsory school attendance, and any expense that consists of a payment to an affiliate of the organization.\"]}],\"kind\":\"definition\",\"modality\":\"not_stated\",\"scope_text\":\"For purposes of subclause (I).\",\"summary\":\"For purposes of subclause (I), the term “poverty program expense” means any expense in providing direct services referred to in clause (iii).\"}",
        "@type": "xsd:string"
      },

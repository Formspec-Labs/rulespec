    {
      "@id": "urn:rulespec:document-understanding:assertion:030f41fbffdd419d6446c182aa3f9e5724baa985685111c90a1d19461e9aa840",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:4b80bc242bf4108132092097a8f5b641e6a56bd640c5f048e8bbcbf82862ca04",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:316f1f3feca7570c79d2b5e529a0d71a9ac993af4e481522e7807e3839fda03a",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:83fe163b989064a3b87487e77f55ea0367da49cb49b9768e43c250a398e64783",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:alternative:0",
      "rkaf:assertsValue": {
        "@value": "(1) a tripartite board, which shall have members selected by the organization and shall be composed so as to assure that not fewer than ⅓ of the members are persons chosen in accordance with democratic selection procedures adequate to assure that these members—\n\n(A) are representative of low-income individuals and families in the neighborhood served;\n\n(B) reside in the neighborhood served; and\n\n(C) are able to participate actively in the development, planning, implementation, and evaluation of programs funded under this chapter; or",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },
    {

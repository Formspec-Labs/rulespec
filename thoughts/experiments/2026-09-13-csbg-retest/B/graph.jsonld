      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"the State\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:dfe8b2d676ed9a5219af59a41fbf3722cb475efbb54f7a606b404b741fa29acc\",\"urn:rulespec:document-understanding:assertion:9ef574064432c51ef3483bc884cee4db1a623a9649cadf6a5c91e8b900a4b5e0\",\"urn:rulespec:document-understanding:assertion:403a72ee23c07affca880381aa91095e39c0d8e99e3dba5779b643b10ddb698d\",\"urn:rulespec:document-understanding:assertion:d873cf42cfdbf88aeb4f7fc4c5a1eb3ddcd45ef082d775f9f242abe4bdc5d724\",\"urn:rulespec:document-understanding:assertion:185047b5d894582c0d1c800b1c8bf15e77c9046669b1742e1419a7a86cc5a6a7\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[\"(a) Determination If the State determines, on the basis of a final decision in a review pursuant to section 9914 of this title, that an eligible entity fails to comply with the terms of an agreement, or the State plan, to provide services under this chapter or to meet appropriate standards, goals, and other requirements established by the State (including performance objectives), the State shall—\"],\"defined_terms\":[],\"effective_periods\":[],\"end\":69780,\"evidence\":[{\"end\":69780,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:69545:69780:sha256-59c9c50c6b1f4a7c9df7e8c149d0b2d6b1e46148369453abfa158ee9d9a55209\",\"quote\":\"(B) not later than 30 days after receiving from an eligible entity a proposed quality improvement plan pursuant to subparagraph (A), either approve such proposed plan or specify the reasons why the proposed plan cannot be approved; and\",\"start\":69545},{\"end\":69780,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22a
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:e7d3067f2d95f7ad632ab3685abd977667efb9d657811f1ae3fad84388b771d1\",\"urn:rulespec:document-understanding:assertion:ad52dacec58f61ffa0ab7be5cc172a25a6ca5e0d020d81d9d7ab608078b3b198\",\"urn:rulespec:document-understanding:assertion:84dbd8929c140c5e4bc74373f267c0a3feedcb924c049204b4bea3bfab765d94\",\"urn:rulespec:document-understanding:assertion:06e993938891b1c34455b1bed8e2a3661f77bc334ff89b1e2645818eb916bb0f\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":55379,\"evidence\":[{\"end\":55379,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:54969:55379:sha256-94624c7accf08a8952baa758af54681fae19daf287fe7df0c075dede3c36ce9b\",\"quote\":\"(A) ⅓ of the members of the board are elected public officials, holding office on the date of selection, or their representatives, except that if the number of such elected officials reasonably available and willing to serve on the board is less than ⅓ of the membership of the board, membership on the board of appointive public officials or their representatives may be counted in meeting such ⅓ requirement;\",\"start\":54969},{\"end\":55337,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:55334:55337:sha256-ee4d988c65de860fabbfbcd27f73d50bbebe3fba37fe419284f4811389c30bdc\",\"quote\":\"may\",\"start\":55334},{\"end\":55379,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:54969:55379:sha256-94624c7accf08a8952baa758af54681fae19daf287fe7df0c075dede3c36ce9b\",\"quote\":\"(A) ⅓ of the members of the board are elected public officials, holding office on the date of selection, or their representatives, except that if the number of such elected officials reasonably available and willing to serve on the board is less than ⅓ of the membership of the board, membership on the board of appointive public officials or their representatives may be counted in meeting such ⅓ requirement;\",\"start\":54969}],\"id\":\"urn:rulespec:document-understanding:revision:8a4fc975ef7ca4e843d0912a6b94e6acd24ef55a37634bdddf98951e43e27c09\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"permission\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:06e993938891b1c34455b1bed8e2a3661f77bc334ff89b1e2645818eb916bb0f\",\"modality\":\"may\",\"modality_quote\":\"may\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:4907923365538a2445de4a91989600c00e62b5446d1b055dd8376b8143698cd2\",\"origin\":\"aiSuggested\",\"quote\":\"(A) ⅓ of the members of the board are elected public officials, holding office on the date of selection, or their representatives, except that if the number of such elected officials reasonably available and willing to serve on the board is less than ⅓ of the membership of the board, membership on the board of appointive public officials or their representatives may be counted in meeting such ⅓ requirement;\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:3ec6ccb98235afe8b1ea7b6299e427588408086b9a798d5dab928f633b34e4bc\",\"scope_quotes\":[\"(A) ⅓ of the members of the board are elected public officials, holding office on the date of selection, or their representatives, except that if the number of such elected officials reasonably available and willing to serve on the board is less than ⅓ of the membership of the board, membership on the board of appointive public officials or their representatives may be counted in meeting such ⅓ requirement;\"],\"scope_text\":\"if the number of such elected officials reasonably available and willing to serve on the board is less than ⅓ of the membership of the board\",\"section_id\":\"urn:rulespec:document-understanding:section:e86efa42546ebfabc5a45ab5fdacdad8192ede5d781723b46383a2f15e9b7f09\",\"start\":54969,\"summary\":\"If the number of elected public officials reasonably available and willing to serve on the board is less than ⅓ of the membership of the board, membership on the board of appointive public officials or their representatives may be counted in meeting the ⅓ elected public official requirement.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

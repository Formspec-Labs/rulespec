    {
      "@id": "urn:rulespec:document-understanding:revision:7c589ddda1de27930dc367eef604370c702af4b4ae9c8a60282d629696cac76f",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:7c589ddda1de27930dc367eef604370c702af4b4ae9c8a60282d629696cac76f",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:d06cbaeb8d548120dab7877a07e93d818382dc622ea88e39c6b5d3df321bbf48",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"a State\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:66bd5648ee06f3b39577bd7be5d7a5c9fbbefc73a9b3dbe8b86c527ab5ae426e\",\"urn:rulespec:document-understanding:assertion:735658dedb7b67730c3a3793504424114734912879a6786510e40b243abed9a2\",\"urn:rulespec:document-understanding:assertion:a11bf3c5803f57c693ff607617458d6613750ab1987b2b65b653441e755beefc\",\"urn:rulespec:document-understanding:assertion:dafefffd8c0b773ce202f3d1ec6bf6b8a22c3c7ac7baf555638cae16052f3ea7\",\"urn:rulespec:document-understanding:assertion:c88f1e20e6b6a9107f711e27c6ddd7c3c4a20317f450c596d75a25568222459b\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":42812,\"evidence\":[{\"end\":37850,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:37820:37850:sha256-e4eb5b6a8a7b9dd983a231deb98e7f6f65d6bc1675e6e9cecd8040a5250bb93d\",\"quote\":\"(b) State application and plan\",\"start\":37820},{\"end\":38333,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:37851:38333:sha256-584aa26d7ceb291cf4946eb3097ae0e9eaf3d8132583bd5b99429b4a3becd4c1\",\"quote\":\"Beginning with fiscal year 2000, to be eligible to receive a grant or allotment under section 9905 or 9906 of this title, a State shall prepare and submit to the Secretary an application and State plan covering a period of not less than 1 fiscal year and not more than 2 fiscal years. The plan shall be submitted not later than 30 days prior to the beginning of the first fiscal year covered by the plan, and shall contain such information as the Secretary shall require, including—\",\"start\":37851},{\"end\":38422,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:38335:38422:sha256-5a41c84474aa24cf672e53c4180cfdb03a238bfb10007ceb06382c577663f517\",\"quote\":\"(1) an assurance that funds made available through the grant or allotment will be used—\",\"start\":38335},{\"end\":38847,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:38424:38847:sha256-fd8ab136c0f1e722fe1809a4cd0b30f6e080e93e8b687b5450eff8b410333828\",\"quote\":\"(A) to support activities that are designed to assist low-income families and individuals, including families and individuals receiving assistance under part A of title IV of the Social Security Act (42 U.S.C. 601 et seq.), homeless families and individuals, migrant or seasonal farmworkers, and elderly low-income individuals and families, and a description of how such activities will enable the families and individuals—\",\"start\":38424},{\"end\":39925,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:38849:39925:sha256-c90ec600eb31a131f3d2d90e00b2bbe2d695eaa9e23d055def8f37c462c930e3\",\"quote\":\"(i) to remove obstacles and solve problems that block the achievement of self-sufficiency (including self-sufficiency for families and individuals who are attempting to transition off a State program carried out under part A of title IV of the Social Security Act);\\n\\n(ii) to secure and retain meaningful employment;\\n\\n(iii) to attain an adequate education, with particular attention toward improving literacy skills of the low-income families in the communities involved, which may include carrying out family literacy initiatives;\\n\\n(iv) to make better use of available income;\\n\\n(v) to obtain and maintain adequate housing and a suitable living environment;\\n\\n(vi) to obtain emergency assistance through loans, grants, or other means to meet immediate and urgent family and individual needs; and\\n\\n(vii) to achieve greater participation in the affairs of the communities involved, including the development of public and private grassroots partnerships with local law enforcement agencies, local housing authorities, private foundations, and other public and private partners to—\",\"start\":38849},{\"end\":40721,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:39927:40721:sha256-3d08bea6733861a07ad00abe3780a31f177159f9f7b61bff284c551f6d690e10\",\"quote\":\"(I) document best practices based on successful grassroots intervention in urban areas, to develop methodologies for widespread replication; and\\n\\n(II) strengthen and improve relationships with local law enforcement agencies, which may include participation in activities such as neighborhood or community policing efforts;\\n\\n\\n\\n(B) to address the needs of youth in low-income communities through youth development programs that support the primary role of the family, give priority to the prevention of youth problems and crime, and promote increased community coordination and collaboration in meeting the needs of youth, and support development and expansion of innovative community-based youth development programs that have demonstrated success in preventing or reducing youth crime, such as—\",\"start\":39927},{\"end\":41607,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:40723:41607:sha256-d609391bb5312fb10fdbeaf7eae645d104b9174654f651abd43f115c50fe9aae\",\"quote\":\"(i) programs for the establishment of violence-free zones that would involve youth development and intervention models (such as models involving youth mediation, youth mentoring, life skills training, job creation, and entrepreneurship programs); and\\n\\n(ii) after-school child care programs; and\\n\\n\\n(C) to make more effective use of, and to coordinate with, other programs related to the purposes of this chapter (including State welfare reform efforts);\\n\\n\\n(2) a description of how the State intends to use discretionary funds made available from the remainder of the grant or allotment described in section 9907(b) of this title in accordance with this chapter, including a description of how the State will support innovative community and neighborhood-based initiatives related to the purposes of this chapter;\\n\\n(3) information provided by eligible entities in the State, containing—\",\"start\":40723},{\"end\":42812,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:41609:42812:sha256-6591031bbb4e8ba726d31e21c1136c2f46a23831754026b17cf1a006f5c87b7f\",\"quote\":\"(A) a description of the service delivery system, for services provided or coordinated with funds made available through grants made under section 9907(a) of this title, targeted to low-income individuals and families in communities within the State;\\n\\n(B) a description of how linkages will be developed to fill identified gaps in the services, through the provision of information, referrals, case management, and followup consultations;\\n\\n(C) a description of how funds made available through grants made under section 9907(a) of this title will be coordinated with other public and private resources; and\\n\\n(D) a description of how the local entity will use the funds to support innovative community and neighborhood-based initiatives related to the purposes of this chapter, which may include fatherhood initiatives and other initiatives with the goal of strengthening families and encouraging effective parenting;\\n\\n\\n(4) an assurance that eligible entities in the State will provide, on an emergency basis, for the provision of such supplies and services, nutritious foods, and related services, as may be necessary to counteract conditions of starvation and malnutrition among low-income individuals;\",\"start\":41609},{\"end\":37850,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:37820:37850:sha256-e4eb5b6a8a7b9dd983a231deb98e7f6f65d6bc1675e6e9cecd8040a5250bb93d\",\"quote\":\"(b) State application and plan\",\"start\":37820},{\"end\":38333,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:37851:38333:sha256-584aa26d7ceb291cf4946eb3097ae0e9eaf3d8132583bd5b99429b4a3becd4c1\",\"quote\":\"Beginning with fiscal year 2000, to be eligible to receive a grant or allotment under section 9905 or 9906 of this title, a State shall prepare and submit to the Secretary an application and State plan covering a period of not less than 1 fiscal year and not more than 2 fiscal years. The plan shall be submitted not later than 30 days prior to the beginning of the first fiscal year covered by the plan, and shall contain such information as the Secretary shall require, including—\",\"start\":37851}],\"id\":\"urn:rulespec:document-understanding:revision:7c589ddda1de27930dc367eef604370c702af4b4ae9c8a60282d629696cac76f\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:c88f1e20e6b6a9107f711e27c6ddd7c3c4a20317f450c596d75a25568222459b\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:a026e105bd671e4caa1d7b6b1460f4596ca0e3087c9fb4e7656f62ad42a9c5ea\",\"origin\":\"aiSuggested\",\"quote\":\"(b) State application and plan Beginning with fiscal year 2000, to be eligible to receive a grant or allotment under section 9905 or 9906 of this title, a State shall prepare and submit to the Secretary an application and State plan covering a period of not less than 1 fiscal year and not more than 2 fiscal years. The plan shall be submitted not later than 30 days prior to the beginning of the first fiscal year covered by the plan, and shall contain such information as the Secretary shall require, including—\\n\\n(1) an assurance that funds made available through the grant or allotment will be used—\\n\\n(A) to support activities that are designed to assist low-income families and individuals, including families and individuals receiving assistance under part A of title IV of the Social Security Act (42 U.S.C. 601 et seq.), homeless families and individuals, migrant or seasonal farmworkers, and elderly low-income individuals and families, and a description of how such activities will enable the families and individuals—\\n\\n(i) to remove obstacles and solve problems that block the achievement of self-sufficiency (including self-sufficiency for families and individuals who are attempting to transition off a State program carried out under part A of title IV of the Social Security Act);\\n\\n(ii) to secure and retain meaningful employment;\\n\\n(iii) to attain an adequate education, with particular attention toward improving literacy skills of the low-income families in the communities involved, which may include carrying out family literacy initiatives;\\n\\n(iv) to make better use of available income;\\n\\n(v) to obtain and maintain adequate housing and a suitable living environment;\\n\\n(vi) to obtain emergency assistance through loans, grants, or other means to meet immediate and urgent family and individual needs; and\\n\\n(vii) to achieve greater participation in the affairs of the communities involved, including the development of public and private grassroots partnerships with local law enforcement agencies, local housing authorities, private foundations, and other public and private partners to—\\n\\n(I) document best practices based on successful grassroots intervention in urban areas, to develop methodologies for widespread replication; and\\n\\n(II) strengthen and improve relationships with local law enforcement agencies, which may include participation in activities such as neighborhood or community policing efforts;\\n\\n\\n\\n(B) to address the needs of youth in low-income communities through youth development programs that support the primary role of the family, give priority to the prevention of youth problems and crime, and promote increased community coordination and collaboration in meeting the needs of youth, and support development and expansion of innovative community-based youth development programs that have demonstrated success in preventing or reducing youth crime, such as—\\n\\n(i) programs for the establishment of violence-free zones that would involve youth development and intervention models (such as models involving youth mediation, youth mentoring, life skills training, job creation, and entrepreneurship programs); and\\n\\n(ii) after-school child care programs; and\\n\\n\\n(C) to make more effective use of, and to coordinate with, other programs related to the purposes of this chapter (including State welfare reform efforts);\\n\\n\\n(2) a description of how the State intends to use discretionary funds made available from the remainder of the grant or allotment described in section 9907(b) of this title in accordance with this chapter, including a description of how the State will support innovative community and neighborhood-based initiatives related to the purposes of this chapter;\\n\\n(3) information provided by eligible entities in the State, containing—\\n\\n(A) a description of the service delivery system, for services provided or coordinated with funds made available through grants made under section 9907(a) of this title, targeted to low-income individuals and families in communities within the State;\\n\\n(B) a description of how linkages will be developed to fill identified gaps in the services, through the provision of information, referrals, case management, and followup consultations;\\n\\n(C) a description of how funds made available through grants made under section 9907(a) of this title will be coordinated with other public and private resources; and\\n\\n(D) a description of how the local entity will use the funds to support innovative community and neighborhood-based initiatives related to the purposes of this chapter, which may include fatherhood initiatives and other initiatives with the goal of strengthening families and encouraging effective parenting;\\n\\n\\n(4) an assurance that eligible entities in the State will provide, on an emergency basis, for the provision of such supplies and services, nutritious foods, and related services, as may be necessary to counteract conditions of starvation and malnutrition among low-income individuals;\",\"references\":[\"section 9905\",\"section 9906\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:489f3a484490d91bbe57e2183b87700881083b8bb485e75cb45809dd626bf24d\",\"scope_quotes\":[\"(b) State application and plan Beginning with fiscal year 2000, to be eligible to receive a grant or allotment under section 9905 or 9906 of this title, a State shall prepare and submit to the Secretary an application and State plan covering a period of not less than 1 fiscal year and not more than 2 fiscal years. The plan shall be submitted not later than 30 days prior to the beginning of the first fiscal year covered by the plan, and shall contain such information as the Secretary shall require, including—\"],\"scope_text\":\"Beginning with fiscal year 2000, to be eligible to receive a grant or allotment under section 9905 or 9906 of this title\",\"section_id\":\"urn:rulespec:document-understanding:section:0b55006ce2c906add8328d3986f73bcd1ded9a87a908d01ae85b5595b9018d1b\",\"start\":37820,\"summary\":\"Beginning with fiscal year 2000, the State's application and plan submitted to be eligible for a grant or allotment under section 9905 or 9906 of this title must contain an assurance that eligible entities in the State will provide, on an emergency basis, for the provision of such supplies and services, nutritious foods, and related services, as may be necessary to counteract conditions of starvation and malnutrition among low-income individuals.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",
      "dcterms:references": [
        {
          "@id": "urn:rulespec:document-understanding:assertion:66bd5648ee06f3b39577bd7be5d7a5c9fbbefc73a9b3dbe8b86c527ab5ae426e"

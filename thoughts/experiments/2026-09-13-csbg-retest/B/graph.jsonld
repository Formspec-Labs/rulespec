    {
      "@id": "urn:rulespec:document-understanding:scope:fa4ebd7d5bb4a965949b0b610ec40e7f25ad6847f7cc061a029668547dcb3ce7",
      "@type": "rkaf:ApplicabilityScope",
      "rkaf:appliesInJurisdiction": [],
      "rkaf:applicabilityCondition": "Whenever the Secretary determines that a State that has received a payment under this chapter has failed to comply with paragraph (1) or an applicable regulation ... If within a reasonable period of time, not to exceed 60 days, the chief executive officer fails or refuses to secure compliance"
    },
    {
      "@id": "urn:rulespec:document-understanding:assertion:1bd60832bb8eccdb777b25f6b9b04c5dbbcf70de86a09051e80a709c8ef0851d",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:4b80bc242bf4108132092097a8f5b641e6a56bd640c5f048e8bbcbf82862ca04",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:24429a0a720b6bfe15b58819624c839ed51118343729fffead67d1fbabdfe223",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:c391f40310c4acf66b5e4c6a972703fd13dc7ccbc7a15f6ba871862bd1cb6aee",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:states-authority",
      "rkaf:assertsValue": {
        "@value": "Whenever the Secretary determines that a State that has received a payment under this chapter has failed to comply with paragraph (1) or an applicable regulation, and if within a reasonable period of time, not to exceed 60 days, the chief executive officer fails or refuses to secure compliance, the Secretary is authorized to: (A) refer the matter to the Attorney General with a recommendation that an appropriate civil action be instituted; (B) exercise the powers and functions provided by title VI of the Civil Rights Act of 1964 (42 U.S.C. 2000d et seq.), the Age Discrimination Act of 1975 (42 U.S.C. 6101 et seq.), section 504 of the Rehabilitation Act of 1973 (29 U.S.C. 794), or title II of the Americans with Disabilities Act of 1990 (42 U.S.C. 12131 et seq.), as may be applicable; or (C) take such other action as may be provided by law.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

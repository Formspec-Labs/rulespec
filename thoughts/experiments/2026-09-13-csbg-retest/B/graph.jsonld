        "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:37851:38333:sha256-584aa26d7ceb291cf4946eb3097ae0e9eaf3d8132583bd5b99429b4a3becd4c1"
      ]
    },
    {
      "@id": "urn:rulespec:document-understanding:revision:2c4f92375709ef25371c48707e1904506051722b7ed63f3595dbd94ac9f30270",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:2c4f92375709ef25371c48707e1904506051722b7ed63f3595dbd94ac9f30270",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:fc61b9390e00d3dbc242f50510792db2d64f931e497c89dd44bfae2f4cd41eaa",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"a State\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:cc92d57cbec49acfd48f05b05e418d87739598fe6895d63371f5eea2326b4531\",\"urn:rulespec:document-understanding:assertion:db367f38c5de87920ead14f92f5763503b5e0395db3219756097858b6e37cda3\",\"urn:rulespec:document-understanding:assertion:6363eedbd8363275c4f3da08f34333a451054b824b7101ba4317e6b305097cdd\",\"urn:rulespec:document-understanding:assertion:26c10170d48810a3d6670bedbd50a9e33a07f688db8b6cb1ad2e3b30e3c5477a\",\"urn:rulespec:document-understanding:assertion:83fd0586ffbd5da9d633c65a817028a685f36a0ca9d1a6ee814cf83d2cb6554b\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":41534,\"evidence\":[{\"end\":37850,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:37820:37850:sha256-e4eb5b6a8a7b9dd983a231deb98e7f6f65d6bc1675e6e9cecd8040a5250bb93d\",\"quote\":\"(b) State application and plan\",\"start\":37820},{\"end\":38333,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:37851:38333:sha256-584aa26d7ceb291cf4946eb3097ae0e9eaf3d8132583bd5b99429b4a3becd4c1\",\"quote\":\"Beginning with fiscal year 2000, to be eligible to receive a grant or allotment under section 9905 or 9906 of this title, a State shall prepare and submit to the Secretary an application and State plan covering a period of not less than 1 fiscal year and not more than 2 fiscal years. The plan shall be submitted not later than 30 days prior to the beginning of the first fiscal year covered by the plan, and shall contain such information as the Secretary shall require, including—\",\"start\":37851},{\"end\":38422,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:38335:38422:sha256-5a41c84474aa24cf672e53c4180cfdb03a238bfb10007ceb06382c577663f517\",\"quote\":\"(1) an assurance that funds made available through the grant or allotment will be used—\",\"start\":38335},{\"end\":38847,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:38424:38847:sha256-fd8ab136c0f1e722fe1809a4cd0b30f6e080e93e8b687b5450eff8b410333828\",\"quote\":\"(A) to support activities that are designed to assist low-income families and individuals, including families and individuals receiving assistance under part A of title IV of the Social Security Act (42 U.S.C. 601 et seq.), homeless families and individuals, migrant or seasonal farmworkers, and elderly low-income individuals and families, and a description of how such activities will enable the families and individuals—\",\"start\":38424},{\"end\":39925,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:38849:39925:sha256-c90ec600eb31a131f3d2d90e00b2bbe2d695eaa9e23d055def8f37c462c930e3\",\"quote\":\"(i) to remove obstacles and solve problems that block the achievement of self-sufficiency (including self-sufficiency for families and individuals who are attempting to transition off a State program carried out under part A of title IV of the Social Security Act);\\n\\n(ii) to secure and retain meaningful employment;\\n\\n(iii) to attain an adequate education, with particular attention toward improving literacy skills of the low-income families in the communities involved, which may include carrying out family literacy initiatives;\\n\\n(iv) to make better use of available income;\\n\\n(v) to obtain and maintain adequate housing and a suitable living environment;\\n\\n(vi) to obtain emergency assistance through loans, grants, or other means to meet immediate and urgent family and individual needs; and\\n\\n(vii) to achieve greater participation in the affairs of the communities involved, including the development of public and private grassroots partnerships with local law enforcement agencies, local housing authorities, private foundations, and other public and private partners to—\",\"start\":38849},{\"end\":40721,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:39927:40721:sha256-3d08bea6733861a07ad00abe3780a31f177159f9f7b61bff284c551f6d690e10\",\"quote\":\"(I) document best practices based on successful grassroots intervention in urban areas, to develop methodologies for widespread replication; and\\n\\n(II) strengthen and improve relationships with local law enforcement agencies, which may include participation in activities such as neighborhood or community policing efforts;\\n\\n\\n\\n(B) to address the needs of youth in low-income communities through youth development programs that support the primary role of the family, give priority to the prevention of youth problems and crime, and promote increased community coordination and collaboration in meeting the needs of youth, and support development and expansion of innovative community-based youth development programs that have demonstrated success in preventing or reducing youth crime, such as—\",\"start\":39927},{\"end\":41534,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:40723:41534:sha256-6bf4636ef9bddf2a0d0afdfb4a8a56b1e99edf73de6815144e3902292f85c66d\",\"quote\":\"(i) programs for the establishment of violence-free zones that would involve youth development and intervention models (such as models involving youth mediation, youth mentoring, life skills training, job creation, and entrepreneurship programs); and\\n\\n(ii) after-school child care programs; and\\n\\n\\n(C) to make more effective use of, and to coordinate with, other programs related to the purposes of this chapter (including State welfare reform efforts);\\n\\n\\n(2) a description of how the State intends to use discretionary funds made available from the remainder of the grant or allotment described in section 9907(b) of this title in accordance with this chapter, including a description of how the State will support innovative community and neighborhood-based initiatives related to the purposes of this chapter;\",\"start\":40723},{\"end\":37850,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:37820:37850:sha256-e4eb5b6a8a7b9dd983a231deb98e7f6f65d6bc1675e6e9cecd8040a5250bb93d\",\"quote\":\"(b) State application and plan\",\"start\":37820},{\"end\":38333,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:37851:38333:sha256-584aa26d7ceb291cf4946eb3097ae0e9eaf3d8132583bd5b99429b4a3becd4c1\",\"quote\":\"Beginning with fiscal year 2000, to be eligible to receive a grant or allotment under section 9905 or 9906 of this title, a State shall prepare and submit to the Secretary an application and State plan covering a period of not less than 1 fiscal year and not more than 2 fiscal years. The plan shall be submitted not later than 30 days prior to the beginning of the first fiscal year covered by the plan, and shall contain such information as the Secretary shall require, including—\",\"start\":37851}],\"id\":\"urn:rulespec:document-understanding:revision:2c4f92375709ef25371c48707e1904506051722b7ed63f3595dbd94ac9f30270\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:83fd0586ffbd5da9d633c65a817028a685f36a0ca9d1a6ee814cf83d2cb6554b\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:65f8ebc2b9696aa80ceb1ca14c6ecccde801d7436942afe17054f4c75be6cc18\",\"origin\":\"aiSuggested\",\"quote\":\"(b) State application and plan Beginning with fiscal year 2000, to be eligible to receive a grant or allotment under section 9905 or 9906 of this title, a State shall prepare and submit to the Secretary an application and State plan covering a period of not less than 1 fiscal year and not more than 2 fiscal years. The plan shall be submitted not later than 30 days prior to the beginning of the first fiscal year covered by the plan, and shall contain such information as the Secretary shall require, including—\\n\\n(1) an assurance that funds made available through the grant or allotment will be used—\\n\\n(A) to support activities that are designed to assist low-income families and individuals, including families and individuals receiving assistance under part A of title IV of the Social Security Act (42 U.S.C. 601 et seq.), homeless families and individuals, migrant or seasonal farmworkers, and elderly low-income individuals and families, and a description of how such activities will enable the families and individuals—\\n\\n(i) to remove obstacles and solve problems that block the achievement of self-sufficiency (including self-sufficiency for families and individuals who are attempting to transition off a State program carried out under part A of title IV of the Social Security Act);\\n\\n(ii) to secure and retain meaningful employment;\\n\\n(iii) to attain an adequate education, with particular attention toward improving literacy skills of the low-income families in the communities involved, which may include carrying out family literacy initiatives;\\n\\n(iv) to make better use of available income;\\n\\n(v) to obtain and maintain adequate housing and a suitable living environment;\\n\\n(vi) to obtain emergency assistance through loans, grants, or other means to meet immediate and urgent family and individual needs; and\\n\\n(vii) to achieve greater participation in the affairs of the communities involved, including the development of public and private grassroots partnerships with local law enforcement agencies, local housing authorities, private foundations, and other public and private partners to—\\n\\n(I) document best practices based on successful grassroots intervention in urban areas, to develop methodologies for widespread replication; and\\n\\n(II) strengthen and improve relationships with local law enforcement agencies, which may include participation in activities such as neighborhood or community policing efforts;\\n\\n\\n\\n(B) to address the needs of youth in low-income communities through youth development programs that support the primary role of the family, give priority to the prevention of youth problems and crime, and promote increased community coordination and collaboration in meeting the needs of youth, and support development and expansion of innovative community-based youth development programs that have demonstrated success in preventing or reducing youth crime, such as—\\n\\n(i) programs for the establishment of violence-free zones that would involve youth development and intervention models (such as models involving youth mediation, youth mentoring, life skills training, job creation, and entrepreneurship programs); and\\n\\n(ii) after-school child care programs; and\\n\\n\\n(C) to make more effective use of, and to coordinate with, other programs related to the purposes of this chapter (including State welfare reform efforts);\\n\\n\\n(2) a description of how the State intends to use discretionary funds made available from the remainder of the grant or allotment described in section 9907(b) of this title in accordance with this chapter, including a description of how the State will support innovative community and neighborhood-based initiatives related to the purposes of this chapter;\",\"references\":[\"section 9905\",\"section 9906\",\"section 9907(b)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:f1b15c02f3fe7f7f973dafacbaf3063f84ab78a2f211403ee07ce17dee07ca8b\",\"scope_quotes\":[\"(b) State application and plan Beginning with fiscal year 2000, to be eligible to receive a grant or allotment under section 9905 or 9906 of this title, a State shall prepare and submit to the Secretary an application and State plan covering a period of not less than 1 fiscal year and not more than 2 fiscal years. The plan shall be submitted not later than 30 days prior to the beginning of the first fiscal year covered by the plan, and shall contain such information as the Secretary shall require, including—\"],\"scope_text\":\"Beginning with fiscal year 2000, to be eligible to receive a grant or allotment under section 9905 or 9906 of this title\",\"section_id\":\"urn:rulespec:document-understanding:section:0b55006ce2c906add8328d3986f73bcd1ded9a87a908d01ae85b5595b9018d1b\",\"start\":37820,\"summary\":\"Beginning with fiscal year 2000, the State's application and plan submitted to be eligible for a grant or allotment under section 9905 or 9906 of this title must contain a description of how the State intends to use discretionary funds made available from the remainder of the grant or allotment described in section 9907(b) of this title in accordance with this chapter, including a description of how the State will support innovative community and neighborhood-based initiatives related to the purposes of this chapter.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",
      "dcterms:references": [
        {
          "@id": "urn:rulespec:document-understanding:assertion:cc92d57cbec49acfd48f05b05e418d87739598fe6895d63371f5eea2326b4531"

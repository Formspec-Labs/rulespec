    {
      "@id": "urn:rulespec:document-understanding:revision:ddcf3a3fd90607511d30f9c916fc5fd0a62ed0dc77078cfc2d66abbbe21230ab",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:ddcf3a3fd90607511d30f9c916fc5fd0a62ed0dc77078cfc2d66abbbe21230ab",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:e184f61a462a1683d73501be86c760c78bbea80bc5190ca1deea3ac8c479b11d",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"Each State\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:e5d2662d2374bb64df8d46d91f97ee996ac92e5b2892ad018f20a3836f376fc3\",\"urn:rulespec:document-understanding:assertion:5515fb564029a3257d86b257bfb79b2da2f0cfe401b9a58418d413cff19c44fc\",\"urn:rulespec:document-understanding:assertion:f5bfe594fa2b53350340eb2c49227d3b35dfc372ad199ac4b79a49f9f9c2100a\",\"urn:rulespec:document-understanding:assertion:a3856e0b83338b8844ea8562ce6f8294ef6863ac285e5c27ff682f308de53dc9\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":76900,\"evidence\":[{\"end\":76900,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:75850:76900:sha256-a8c97f226194b31c7800e46ee385858e4e2bb2ea3d8bf2f47166ef843912e6be\",\"quote\":\"Each State shall annually prepare and submit to the Secretary a report on the measured performance of the State and the eligible entities in the State. Prior to the participation of the State in the performance measurement system, the State shall include in the report any information collected by the State relating to such performance. Each State shall also include in the report an accounting of the expenditure of funds received by the State through the community services block grant program, including an accounting of funds spent on administrative costs by the State and the eligible entities, and funds spent by eligible entities on the direct delivery of local services, and shall include information on the number of and characteristics of clients served under this chapter in the State, based on data collected from the eligible entities. The State shall also include in the report a summary describing the training and technical assistance offered by the State under section 9915(a)(3) of this title during the year covered by the report.\",\"start\":75850}],\"id\":\"urn:rulespec:document-understanding:revision:ddcf3a3fd90607511d30f9c916fc5fd0a62ed0dc77078cfc2d66abbbe21230ab\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:a3856e0b83338b8844ea8562ce6f8294ef6863ac285e5c27ff682f308de53dc9\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:954f925a2b618988209fb8d0b33c623c04bb4a51c5c81052da7a10a925dadaa3\",\"origin\":\"aiSuggested\",\"quote\":\"Each State shall annually prepare and submit to the Secretary a report on the measured performance of the State and the eligible entities in the State. Prior to the participation of the State in the performance measurement system, the State shall include in the report any information collected by the State relating to such performance. Each State shall also include in the report an accounting of the expenditure of funds received by the State through the community services block grant program, including an accounting of funds spent on administrative costs by the State and the eligible entities, and funds spent by eligible entities on the direct delivery of local services, and shall include information on the number of and characteristics of clients served under this chapter in the State, based on data collected from the eligible entities. The State shall also include in the report a summary describing the training and technical assistance offered by the State under section 9915(a)(3) of this title during the year covered by the report.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:c32220d076381cd9beb187a34cc01ec8fdf991b558821597a4edf48990a37375\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"urn:rulespec:document-understanding:section:fa489a00ccb41098ac2b415167888ae0d85e530b88cc3c90eda7efe29c7dad7b\",\"start\":75850,\"summary\":\"Each State must also include in its annual report an accounting of the expenditure of funds received by the State through the community services block grant program, including an accounting of funds spent on administrative costs by the State and the eligible entities, and funds spent by eligible entities on the direct delivery of local services, and must include information on the number of and characteristics of clients served under 42 U.S.C. chapter 106 in the State, based on data collected from the eligible entities.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

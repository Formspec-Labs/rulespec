    {
      "@id": "urn:rulespec:document-understanding:binding:25ab1af24d94f497fcf86ff6f632e83b2b802575b1cc69ac4a77a70d620b353f",
      "@type": "rkaf:EvidenceBinding",
      "rkaf:bindsAssertion": "urn:rulespec:document-understanding:assertion:f6a1a72e5ab29988946a336f31acef2fdbf14ab56ea42433afca6938d7fea4ee",

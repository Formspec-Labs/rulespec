      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"actor\":\"the State\",\"kind\":\"requirement\",\"modality\":\"must\",\"scope_text\":\"In order to determine whether eligible entities meet the performance goals, administrative standards, financial management requirements, and other requirements of a State\",\"summary\":\"In order to determine whether eligible entities meet the performance goals, administrative standards, financial management requirements, and other requirements of a State, the State shall conduct other reviews as appropriate, including reviews of entities with programs that have had other Federal, State, or local grants (other than assistance provided under this chapter) terminated for cause.\"}",

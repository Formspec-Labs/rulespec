      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:states-requirement",
      "rkaf:assertsValue": {
        "@value": "Beginning with fiscal year 2000, the State's application and plan submitted to be eligible for a grant or allotment under section 9905 or 9906 of this title must contain an assurance that the State will require each eligible entity in the State to establish procedures under which a low-income individual, community organization, or religious organization, or representative of low-income individuals that considers its organization, or low-income individuals, to be inadequately represented on the board (or other mechanism) of the eligible entity may petition for adequate representation.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

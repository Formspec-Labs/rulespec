    {
      "@id": "urn:rulespec:document-understanding:revision:d575bbb7a1e684f7225db1facbde48604dac311d4c09809cf3f848274753d911",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:d575bbb7a1e684f7225db1facbde48604dac311d4c09809cf3f848274753d911",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:d4ef2697536190d3b57d9faec551720340afbd78a5d29ee6716effa09326384a",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"the intermediate organization\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:c14e417c90c6eafee923ae43dada549066f608f58d058a0079abe20b63925264\",\"urn:rulespec:document-understanding:assertion:d3e988e5b551a0451f4f14a21f0df70d55a07f5e4561451a637d81d4a6cf7327\",\"urn:rulespec:document-understanding:assertion:3d1ddfde201ea4b210cb91fb15306f5ad6ea054231588b759bf38eea0d091bd9\",\"urn:rulespec:document-understanding:assertion:398ac98ad9973e0bbbe7456cadb4b52a6e265bf2100177242efa775e2b99b017\",\"urn:rulespec:document-understanding:assertion:7a364f7d3b32e67ba40ce08db2ce526387966920bba21c8c70d90d40e02d057a\",\"urn:rulespec:document-understanding:assertion:d696309bc5b210e797c914da0cbf1ab5e66543cd8df8b92c822c5e337d61dd82\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[\"For any program carried out by the Federal Government, or by a State or local government under this chapter, the government shall consider, on the same basis as other nongovernmental organizations, religious organizations to provide the assistance under the program, so long as the program is implemented in a manner consistent with the Establishment Clause of the first amendment to the Constitution. Neither the Federal Government nor a State or local government receiving funds under this chapter shall discriminate against an organization that provides assistance under, or applies to provide assistance under, this chapter, on the basis that the organization has a religious character.\"],\"defined_terms\":[],\"effective_periods\":[],\"end\":90661,\"evidence\":[{\"end\":90661,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:90176:90661:sha256-c3d5794ac75b428e8fcb53ccef6c91d28bccd6d9dfc1ab319d85930bc8dd111b\",\"quote\":\"If an eligible entity or other organization (referred to in this subsection as an “intermediate organization”), acting under a contract, or grant or other agreement, with the Federal Government or a State or local government, is given the authority under the contract or agreement to select nongovernmental organizations to provide assistance under the programs described in subsection (a), the intermediate organization shall have the same duties under this section as the government.\",\"start\":90176},{\"end\":90596,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:90567:90596:sha256-b5dff4955ad27b361a2301463683396f24dc2ee97212a7a9202c8f08b0c12cd8\",\"quote\":\"the intermediate organization\",\"start\":90567},{\"end\":90602,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:90597:90602:sha256-56ee5b508706bf2de91712d85d6d1e11ddbff01949142ed6e8c22e3b1bed1c71\",\"quote\":\"shall\",\"start\":90597},{\"end\":90661,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:90176:90661:sha256-c3d5794ac75b428e8fcb53ccef6c91d28bccd6d9dfc1ab319d85930bc8dd111b\",\"quote\":\"If an eligible entity or other organization (referred to in this subsection as an “intermediate organization”), acting under a contract, or grant or other agreement, with the Federal Government or a State or local government, is given the authority under the contract or agreement to select nongovernmental organizations to provide assistance under the programs described in subsection (a), the intermediate organization shall have the same duties under this section as the government.\",\"start\":90176},{\"end\":88263,\"field\":\"context:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:87573:88263:sha256-7f698273643ebaac09dd116e5fd1cab7db7c4e700d5aca2c7489efe5e05abd4a\",\"quote\":\"For any program carried out by the Federal Government, or by a State or local government under this chapter, the government shall consider, on the same basis as other nongovernmental organizations, religious organizations to provide the assistance under the program, so long as the program is implemented in a manner consistent with the Establishment Clause of the first amendment to the Constitution. Neither the Federal Government nor a State or local government receiving funds under this chapter shall discriminate against an organization that provides assistance under, or applies to provide assistance under, this chapter, on the basis that the organization has a religious character.\",\"start\":87573}],\"id\":\"urn:rulespec:document-understanding:revision:d575bbb7a1e684f7225db1facbde48604dac311d4c09809cf3f848274753d911\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:7a364f7d3b32e67ba40ce08db2ce526387966920bba21c8c70d90d40e02d057a\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:79612fc84eff756dfd35b2189e2c4f4a54b68f4998e0662ba4957c1cb930dd0f\",\"origin\":\"aiSuggested\",\"quote\":\"If an eligible entity or other organization (referred to in this subsection as an “intermediate organization”), acting under a contract, or grant or other agreement, with the Federal Government or a State or local government, is given the authority under the contract or agreement to select nongovernmental organizations to provide assistance under the programs described in subsection (a), the intermediate organization shall have the same duties under this section as the government.\",\"references\":[\"subsection (a)\",\"this section\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:42f6171a12d23babd7692cc60f53efe6c10c2adc999372f65ab1dfc8eaef39af\",\"scope_quotes\":[\"If an eligible entity or other organization (referred to in this subsection as an “intermediate organization”), acting under a contract, or grant or other agreement, with the Federal Government or a State or local government, is given the authority under the contract or agreement to select nongovernmental organizations to provide assistance under the programs described in subsection (a), the intermediate organization shall have the same duties under this section as the government.\"],\"scope_text\":\"If an eligible entity or other organization (referred to in this subsection as an “intermediate organization”), acting under a contract, or grant or other agreement, with the Federal Government or a State or local government, is given the authority under the contract or agreement to select nongovernmental organizations to provide assistance under the programs described in subsection (a)\",\"section_id\":\"urn:rulespec:document-understanding:section:cfe00c4667f8a705b619c6842c9a05b4aaa1e3ace7adcf5723b0c39c5a6aa621\",\"start\":90176,\"summary\":\"If an eligible entity or other organization (referred to in this subsection as an “intermediate organization”), acting under a contract, or grant or other agreement, with the Federal Government or a State or local government, is given the authority under the contract or agreement to select nongovernmental organizations to provide assistance under the programs described in subsection (a), the intermediate organization shall have the same duties under section 9920 of this title as the government.\",\"target_ids\":[],\"term_refs\":[\"urn:rulespec:document-understanding:term:8ef9293aacee1129bfaacf140d9de22efd854fe401cacde2b178419a0025c6e2\"],\"typed_values\":[]}",

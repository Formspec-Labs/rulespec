      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"the Secretary\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:2412c7a7d6ef65e36857f86443ef372d45a9867cd31abb46c94642250c94cc17\",\"urn:rulespec:document-understanding:assertion:107c6e8c23a83fa20ab955c3b98c14f72927b007e6e50622a2948a34d38be43a\",\"urn:rulespec:document-understanding:assertion:1bcc6cd25cf08c2790709a3890fe0445c739efc83554846c5571120ea4c12183\",\"urn:rulespec:document-understanding:assertion:5a4bec4ea2135c63636b983227f73707a28f2680432ecb097b3684563aa33e6a\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":99205,\"evidence\":[{\"end\":98581,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:98571:98581:sha256-851b36e7dd69092e8308cf5053adc86e7fbac2f89f8d3476a4c6f93d78ee38f1\",\"quote\":\"(a) Grants\",\"start\":98571},{\"end\":98728,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:98582:98728:sha256-3e44541ba46f3b6e5167bcf04943f1481d6438476f784ef2596af5fe8aa1c9c8\",\"quote\":\"The Secretary may, through grants to public and private, nonprofit agencies, provide for community-based, local, statewide, and national programs—\",\"start\":98582},{\"end\":99205,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:98730:99205:sha256-414e1d6d3cc8ff6fa3a83764a8fc7914796458316b653657ef8b8ee0e746b5dd\",\"quote\":\"(1) to coordinate private and public food assistance resources, wherever the grant recipient involved determines such coordination to be inadequate, to better serve low-income populations;\\n\\n(2) to assist low-income communities to identify potential sponsors of child nutrition programs and to initiate such programs in underserved or unserved areas; and\\n\\n(3) to develop innovative approaches at the State and local level to meet the nutrition needs of low-income individuals.\",\"start\":98730},{\"end\":98599,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:98596:98599:sha256-ee4d988c65de860fabbfbcd27f73d50bbebe3fba37fe419284f4811389c30bdc\",\"quote\":\"may\",\"start\":98596}],\"id\":\"urn:rulespec:document-understanding:revision:f5a2215f3ed83b9a82bf5b84be4c436c8464b9860ce2bcdf411d9af2b4d08447\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"permission\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:5a4bec4ea2135c63636b983227f73707a28f2680432ecb097b3684563aa33e6a\",\"modality\":\"may\",\"modality_quote\":\"may\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:1693786c45006e5c33edf408feec7ade9ac57ab0fb0b9ae38e1eff504c17b261\",\"origin\":\"aiSuggested\",\"quote\":\"(a) Grants The Secretary may, through grants to public and private, nonprofit agencies, provide for community-based, local, statewide, and national programs—\\n\\n(1) to coordinate private and public food assistance resources, wherever the grant recipient involved determines such coordination to be inadequate, to better serve low-income populations;\\n\\n(2) to assist low-income communities to identify potential sponsors of child nutrition programs and to initiate such programs in underserved or unserved areas; and\\n\\n(3) to develop innovative approaches at the State and local level to meet the nutrition needs of low-income individuals.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:1cce5edb913331b3cbe66a3d0bb56802a390c771b893ef76651c2ff56f2636a3\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"urn:rulespec:document-understanding:section:cad1a9ce814f7bc8d23a6ff48e1865a684b16830bcf049a10118a7b6cab89b15\",\"start\":98571,\"summary\":\"The Secretary may, through grants to public and private, nonprofit agencies, provide for community-based, local, statewide, and national programs: (1) to coordinate private and public food assistance resources, wherever the grant recipient involved determines such coordination to be inadequate, to better serve low-income populations; (2) to assist low-income communities to identify potential sponsors of child nutrition programs and to initiate such programs in underserved or unserved areas; and (3) to develop innovative approaches at the State and local level to meet the nutrition needs of low-income individuals.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

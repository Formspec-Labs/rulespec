      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "(i) programs for the establishment of violence-free zones that would involve youth development and intervention models (such as models involving youth mediation, youth mentoring, life skills training, job creation, and entrepreneurship programs); and\n\n(ii) after-school child care programs; and\n\n\n(C) to make more effective use of, and to coordinate with, other programs related to the purposes of this chapter (including State welfare reform efforts);"
        },

      "dcterms:description": "{\"action\":\"\",\"actor\":\"the entity\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:2db61a62a685ee8c10d36e6b40ed0885327447866051db60a9df0cf62113f3e2\",\"urn:rulespec:document-understanding:assertion:3c823eadd5bc9659dddce5749cf53e2111b862678629c6775126e465f4242592\",\"urn:rulespec:document-understanding:assertion:a6e26f22eb629f4d4352ac2d696f58104588c18b7b195da17934140493f179c2\",\"urn:rulespec:document-understanding:assertion:49f6704f6e4ec9090da015478ba07075ee081d84bdb9d77d82dc461bcf1cf3fc\",\"urn:rulespec:document-understanding:assertion:183087e01b926e46cd9a9b40945daeefdfd4c4a38c580596baaee06839db5604\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":56015,\"evidence\":[{\"end\":54827,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:54789:54827:sha256-6db0ab40f8cd296014e554511a051ad8a132e69f76c9fd36c168feb53115bbe3\",\"quote\":\"(2) Selection and composition of board\",\"start\":54789},{\"end\":54967,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:54828:54967:sha256-370aca08154e0847fc8b38b3b9b3f61ba76e90d0b0afdd266979fee9acdb74cf\",\"quote\":\"The members of the board referred to in paragraph (1) shall be selected by the entity and the board shall be composed so as to assure that—\",\"start\":54828},{\"end\":55384,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:54969:55384:sha256-cda433f67d8f3b607d9affecc9a429dde53af6459e82bc3e65db8cee13a0e26d\",\"quote\":\"(A) ⅓ of the members of the board are elected public officials, holding office on the date of selection, or their representatives, except that if the number of such elected officials reasonably available and willing to serve on the board is less than ⅓ of the membership of the board, membership on the board of appointive public officials or their representatives may be counted in meeting such ⅓ requirement;\\n\\n(B)\",\"start\":54969},{\"end\":56015,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:55386:56015:sha256-188345e3b9db32fb00744442d9f8e5d1ce43c1fc6fde6b59bf859d15854c5d7e\",\"quote\":\"(i) not fewer than ⅓ of the members are persons chosen in accordance with democratic selection procedures adequate to assure that these members are representative of low-income individuals and families in the neighborhood served; and\\n\\n(ii) each representative of low-income individuals and families selected to represent a specific neighborhood within a community under clause (i) resides in the neighborhood represented by the member; and\\n\\n\\n(C) the remainder of the members are officials or members of business, industry, labor, religious, law enforcement, education, or other major groups and interests in the community served.\",\"start\":55386},{\"end\":54913,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:54903:54913:sha256-607e0c7f5cf2a8a38ed6f7e5ed63d71442e20bef61cc9cc3e59c2ec8d4bb0545\",\"quote\":\"the entity\",\"start\":54903},{\"end\":54827,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:54789:54827:sha256-6db0ab40f8cd296014e554511a051ad8a132e69f76c9fd36c168feb53115bbe3\",\"quote\":\"(2) Selection and composition of board\",\"start\":54789},{\"end\":54967,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:54828:54967:sha256-370aca08154e0847fc8b38b3b9b3f61ba76e90d0b0afdd266979fee9acdb74cf\",\"quote\":\"The members of the board referred to in paragraph (1) shall be selected by the entity and the board shall be composed so as to assure that—\",\"start\":54828}],\"id\":\"urn:rulespec:document-understanding:revision:c7e8734698e3050e98df9468ddf66947da2f0002d6f3c64c089a9da52a6e038c\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:183087e01b926e46cd9a9b40945daeefdfd4c4a38c580596baaee06839db5604\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:2631e44bf99e3b201eaebb9c2ada03c7d17e423bb4efb0f67211746a28e0619c\",\"origin\":\"aiSuggested\",\"quote\":\"(2) Selection and composition of board The members of the board referred to in paragraph (1) shall be selected by the entity and the board shall be composed so as to assure that—\\n\\n(A) ⅓ of the members of the board are elected public officials, holding office on the date of selection, or their representatives, except that if the number of such elected officials reasonably available and willing to serve on the board is less than ⅓ of the membership of the board, membership on the board of appointive public officials or their representatives may be counted in meeting such ⅓ requirement;\\n\\n(B)\\n\\n(i) not fewer than ⅓ of the members are persons chosen in accordance with democratic selection procedures adequate to assure that these members are representative of low-income individuals and families in the neighborhood served; and\\n\\n(ii) each representative of low-income individuals and families selected to represent a specific neighborhood within a community under clause (i) resides in the neighborhood represented by the member; and\\n\\n\\n(C) the remainder of the members are officials or members of business, industry, labor, religious, law enforcement, education, or other major groups and interests in the community served.\",\"references\":[\"paragraph (1)\",\"clause (i)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:c70381929051685e13874a8e5ca4d62d5d7457ea23b6099229204ea824c04ab2\",\"scope_quotes\":[\"(2) Selection and composition of board The members of the board referred to in paragraph (1) shall be selected by the entity and the board shall be composed so as to assure that—\"],\"scope_text\":\"The members of the board referred to in paragraph (1)\",\"section_id\":\"urn:rulespec:document-understanding:section:e86efa42546ebfabc5a45ab5fdacdad8192ede5d781723b46383a2f15e9b7f09\",\"start\":54789,\"summary\":\"For a private nonprofit entity's tripartite board under paragraph (1), the members of the board must be selected by the entity and the board must be composed so as to assure that: (A) ⅓ of the members of the board are elected public officials holding office on the date of selection, or their representatives (except that if the number of such elected officials reasonably available and willing to serve on the board is less than ⅓ of the membership of the board, membership on the board of appointive public officials or their representatives may be counted in meeting such ⅓ requirement); (B)(i) not fewer than ⅓ of the members are persons chosen in accordance with democratic selection procedures adequate to assure that these members are representative of low-income individuals and families in the neighborhood served; and (ii) each representative of low-income individuals and families selected to represent a specific neighborhood within a community under clause (i) resides in the neighborhood represented by the member; and (C) the remainder of the members are officials or members of business, industry, labor, religious, law enforcement, education, or other major groups and interests in the community served.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

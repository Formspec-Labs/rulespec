      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"the Secretary\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:6cefc7b6db39a2d5a1c1e252ba0441d033233d1773818cf082d90d9025c90695\",\"urn:rulespec:document-understanding:assertion:7c0f2f22ce4193566779a3e05f96e6802b08e608fe5178888ff716960d016a6c\",\"urn:rulespec:document-understanding:assertion:b83aedb85cec86ba913b13341be5b0c72c8055196f0b65c12f39f1c256c6738b\",\"urn:rulespec:document-understanding:assertion:1ea0dd682d6d5513a98c9769b31bff36d454ed6b4572b62c33849266333ef915\",\"urn:rulespec:document-understanding:assertion:34d6ce47a96b2a07e16d85709f64cc3a1512e6e436e4c8ae4c3eb4bd6a0ac397\",\"urn:rulespec:document-understanding:assertion:a8edfe60f8d7b6790824f8336ed1a8965ae1ca69b6f94dcaa47300dc077c76ff\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":23264,\"evidence\":[{\"end\":23264,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:22875:23264:sha256-788b266dcb666b21f42cf1560aef8254bd6fbc2ca19244fb0745b945a3ceaffd\",\"quote\":\"Subject to paragraphs (2) and (3), if the amount appropriated under section 9903(a) of this title for a fiscal year that remains after the Secretary makes the reservations required in section 9903(b) of this title exceeds $345,000,000, the Secretary shall allot to each State not less than ½ of 1 percent of the amount appropriated under section 9903(a) of this title for such fiscal year.\",\"start\":22875},{\"end\":23130,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:23125:23130:sha256-56ee5b508706bf2de91712d85d6d1e11ddbff01949142ed6e8c22e3b1bed1c71\",\"quote\":\"shall\",\"start\":23125},{\"end\":23264,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:22875:23264:sha256-788b266dcb666b21f42cf1560aef8254bd6fbc2ca19244fb0745b945a3ceaffd\",\"quote\":\"Subject to paragraphs (2) and (3), if the amount appropriated under section 9903(a) of this title for a fiscal year that remains after the Secretary makes the reservations required in section 9903(b) of this title exceeds $345,000,000, the Secretary shall allot to each State not less than ½ of 1 percent of the amount appropriated under section 9903(a) of this title for such fiscal year.\",\"start\":22875}],\"id\":\"urn:rulespec:document-understanding:revision:28e303bbebb9bae59f606d60bab1d98b61117bd97f2526b49db233dbb137d719\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:34d6ce47a96b2a07e16d85709f64cc3a1512e6e436e4c8ae4c3eb4bd6a0ac397\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:22b724ba22e30a08913c063d72c923e15025e68890b228f2e8b9ad7bdcd01d9b\",\"origin\":\"aiSuggested\",\"quote\":\"Subject to paragraphs (2) and (3), if the amount appropriated under section 9903(a) of this title for a fiscal year that remains after the Secretary makes the reservations required in section 9903(b) of this title exceeds $345,000,000, the Secretary shall allot to each State not less than ½ of 1 percent of the amount appropriated under section 9903(a) of this title for such fiscal year.\",\"references\":[\"paragraphs (2) and (3)\",\"section 9903(a)\",\"section 9903(b)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:8e0fa1af8fa4c7e8db5b89eaceb9e93dc5c32b4a1502aa8ff4b55afc8f204ab9\",\"scope_quotes\":[\"Subject to paragraphs (2) and (3), if the amou
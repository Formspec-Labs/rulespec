      "dcterms:description": "{\"action\":\"\",\"actor\":\"The Secretary\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:2efb38ea84729e5851b8fa3486c01f19100c77dc1b6c5c13acef011121dc8274\",\"urn:rulespec:document-understanding:assertion:fab4144f3cb314f6fb7cb92b6d06b7b5f26d68eaa75416e8bd233cd4be68d63d\",\"urn:rulespec:document-understanding:assertion:22342ab992a57587da6f905a0d5e471e331b0a6e1e12e5340648de85cfa3d252\",\"urn:rulespec:document-understanding:assertion:df8c09683908b94131a3b6025925be02ce5d2cea636d8dd557dfa193288809e8\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":63858,\"evidence\":[{\"end\":63382,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:63368:63382:sha256-cf4ae417d8281c48072a48750d2a58c3678e30cc403d581be91a252e93ff2139\",\"quote\":\"(1) In general\",\"start\":63368},{\"end\":63460,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:63383:63460:sha256-a2e0347b31208ed1c88427b0282edd40d5e997b7f05e15af46f4b28f400b2934\",\"quote\":\"The Secretary shall use amounts reserved in section 9903(b)(2) of this title—\",\"start\":63383},{\"end\":63858,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:63462:63858:sha256-d719cd2848159497c8878dacd23d84ba43ed7377f22df43ce823fc1e9538b058\",\"quote\":\"(A) for training, technical assistance, planning, evaluation, and performance measurement, to assist States in carrying out corrective action activities and monitoring (to correct programmatic deficiencies of eligible entities), and for reporting and data collection activities, related to programs carried out under this chapter; and\\n\\n(B) to distribute amounts in accordance with subsection (c).\",\"start\":63462},{\"end\":63396,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:63383:63396:sha256-d6dd2bb6d3c44b4545cc3f97cb6f8a38842ecd30d2c58ec3e1c53a8c1a0ac77c\",\"quote\":\"The Secretary\",\"start\":63383},{\"end\":63402,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:63397:63402:sha256-56ee5b508706bf2de91712d85d6d1e11ddbff01949142ed6e8c22e3b1bed1c71\",\"quote\":\"shall\",\"start\":63397}],\"id\":\"urn:rulespec:document-understanding:revision:85ad008b4da102638f7cc61ac38c6ce4ff2fa946498ed2131a6eb7dce6758145\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:df8c09683908b94131a3b6025925be02ce5d2cea636d8dd557dfa193288809e8\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:ed0728a9fa03bee3f02b8888931fb76d4df4e34fca1a36bd129c29085580a36d\",\"origin\":\"aiSuggested\",\"quote\":\"(1) In general The Secretary shall use amounts reserved in section 9903(b)(2) of this title—\\n\\n(A) for training, technical assistance, planning, evaluation, and performance measurement, to assist States in carrying out corrective action activities and monitoring (to correct programmatic deficiencies of eligible entities), and for reporting and data collection activities, related to programs carried out under this chapter; and\\n\\n(B) to distribute amounts in accordance with subsection (c).\",\"references\":[\"section 9903(b)(2)\",\"subsection (c)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:7c5ea959db08b72c977062a22356e7b5f4a78f456d4301ff5c6a6870057f4cfa\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"urn:rulespec:document-understanding:section:14940ce669f832206b65cbb2eca659f59bd1cde99a702e87cfeffc3340239793\",\"start\":63368,\"summary\":\"The Secretary shall use amounts reserved in section 9903(b)(2) of this title to distribute amounts in accordance with subsection (c).\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:ec7265dc3071bd97134c3b6c6584d093503a19ab0e5ada41ce1023195f623fa0\",\"urn:rulespec:document-understanding:assertion:fa025034e01bc9b0aeca8f2a89ea43ddfd165ed849fa6520282d4ad575111414\",\"urn:rulespec:document-understanding:assertion:fa7898ff0065d7505785421556cba4ddf2750874ae0038833c13891e4e1ee82b\",\"urn:rulespec:document-understanding:assertion:0659bf92eba85376de71bd2e410fc6c2a8acfc72fa94392709047de2360b9cbd\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":110528,\"evidence\":[{\"end\":110528,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:110012:110528:sha256-a4567bf1a30dd78f87b8b6158b39216cd91743856669822726c97d4ac1ed9c2b\",\"quote\":\"Any reference in any provision of law to the poverty line set forth in section 624 or 625 of the Economic Opportunity Act of 1964 shall be construed to be a reference to the poverty line defined in section 9902 of this title. Except as otherwise provided, any reference in any provision of law to any community action agency designated under title II of the Economic Opportunity Act of 1964 shall be construed to be a reference to an entity eligible to receive funds under the community services block grant program.\",\"start\":110012},{\"end\":110528,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:110012:110528:sha256-a4567bf1a30dd78f87b8b6158b39216cd91743856669822726c97d4ac1ed9c2b\",\"quote\":\"Any reference in any provision of law to the poverty line set forth in section 624 or 625 of the Economic Opportunity Act of 1964 shall be construed to be a reference to the poverty line defined in section 9902 of this title. Except as otherwise provided, any reference in any provision of law to any community action agency designated under title II of the Economic Opportunity Act of 1964 shall be construed to be a reference to an entity eligible to receive funds under the community services block grant program.\",\"start\":110012}],\"id\":\"urn:rulespec:document-understanding:revision:0a190b4a48e32c55f32051efe2221b4a50d8a380a9b427d2189d07e81d250731\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:0659bf92eba85376de71bd2e410fc6c2a8acfc72fa94392709047de2360b9cbd\",\"modality\":\"must\",\"modality_quote\":\"shall be construed\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:83a2d2cf97e27d71253799c92c3962892b3bed46ad32bab96412d5dddb8cb829\",\"origin\":\"aiSuggested\",\"quote\":\"Any reference in any provision of law to the poverty line set forth in section 624 or 625 of the Economic Opportunity Act of 1964 shall be construed to be a reference to the poverty line defined in section 9902 of this title. Except as otherwise provided, any reference in any provision of law to any community action agency designated under title II of the Economic Opportunity Act of 1964 shall be construed to be a reference to an entity eligible to receive funds under the community services block grant program.\",\"references\":[\"title II of the Economic Opportunity Act of 1964\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:4cdf40e0e8470dc348947e0162d0158ed4945fdd37f62fbe3059bd8495b21886\",\"scope_quotes\":[\"Any reference in any provision of law to the poverty line set forth in section 624 or 625 of the Economic Opportunity Act of 1964 shall be construed to be a reference to the poverty line defined in section 9902 of this title. Except as otherwise provided, any reference in any provision of law to any community action agency designated under title II of the Economic Opportunity Act of 1964 shall be construed to be a reference to an entity eligible to receive funds under the community services block grant program.\"],\"scope_text\":\"Except as otherwise provided\",\"section_id\":\"urn:rulespec:document-understanding:section:8a4e6d70ab56a073272f0b3d5540f6b1b55f6d1129769834787143ec0c1eecd9\",\"start\":110012,\"summary\":\"Except as otherwise provided, any reference in any provision of law to any community action agency designated under title II of the Economic Opportunity Act of 1964 shall be construed to be a reference to an entity eligible to receive funds under the community services block grant program.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

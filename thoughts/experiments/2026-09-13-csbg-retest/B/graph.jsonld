    {
      "@id": "urn:rulespec:document-understanding:revision:5a1c92b5ea0f5d39d86827edb66acbdbbfd8c81b45ded8fd0992100ae071c17d",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:5a1c92b5ea0f5d39d86827edb66acbdbbfd8c81b45ded8fd0992100ae071c17d",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:dee1d996c29e067417865d1a38e77850eb99a54fc2c8e26d497ea0912bc6474d",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"State\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:ec3fa108bd95f2df1ad5730c42ea0d6af3364a6e3762345466393296f822a8a3\",\"urn:rulespec:document-understanding:assertion:9e39a33730effa9b5484a6f3732f7cddb287e6cb7d9d09354d7413ac0b19b1f0\",\"urn:rulespec:document-understanding:assertion:95a7f98c9bdee083a543b63eb83db8c536652490d52a6cc0c843540fd958a3e8\",\"urn:rulespec:document-understanding:assertion:e02a6f6ad10fe13639f09ae3fa37fee54324b08cd50973c4a45baf681505e3bc\",\"urn:rulespec:document-understanding:assertion:315b127aa25f12b7d939e324560b839f7a6286559a7118872617c86cdea31ff1\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[\"(a) Drug testing and rehabilitation\",\"(1) In general\"],\"defined_terms\":[],\"effective_periods\":[],\"end\":86531,\"evidence\":[{\"end\":86531,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:86081:86531:sha256-1f0392c74c19d0a1caef9fdd65626f1f73405d082df638e9645c4ae0deafbcd2\",\"quote\":\"Nothing in this chapter shall be construed to prohibit a State from testing participants in programs, activities, or services carried out or provided under this chapter for controlled substances. A State that conducts such testing shall inform the participants who test positive for any of such substances about the availability of treatment or rehabilitation services and refer such participants for appropriate treatment or rehabilitation services.\",\"start\":86081},{\"end\":86143,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:86136:86143:sha256-c178fdd744dfc1cc76caac454515b335da2f0b1008fe2c7653ec53a1e7a63255\",\"quote\":\"a State\",\"start\":86136},{\"end\":86135,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:86081:86135:sha256-cf96e2a97bc8c6d2395d0b5895d4168bfedbba549f9ff48782c95529111c60f8\",\"quote\":\"Nothing in this chapter shall be construed to prohibit\",\"start\":86081},{\"end\":86063,\"field\":\"context:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:86028:86063:sha256-6d76775d5350e3c5818491c7af74d45118efcf0ececcafb68aacb683a1184c2f\",\"quote\":\"(a) Drug testing and rehabilitation\",\"start\":86028}],\"id\":\"urn:rulespec:document-understanding:revision:5a1c92b5ea0f5d39d86827edb66acbdbbfd8c81b45ded8fd0992100ae071c17d\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"permission\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:e02a6f6ad10fe13639f09ae3fa37fee54324b08cd50973c4a45baf681505e3bc\",\"modality\":\"may\",\"modality_quote\":\"Nothing in this chapter shall be construed to prohibit\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:d07d19da3b6b7b048a60d447e3294b9b34871e251b9c00d748fef3b29e0930d5\",\"origin\":\"aiSuggested\",\"quote\":\"Nothing in this chapter shall be construed to prohibit a State from testing participants in programs, activities, or services carried out or provided under this chapter for controlled substances. A State that conducts such testing shall inform the participants who test positive for any of such substances about the availability of treatment or rehabilitation services and refer such participants for appropriate treatment or rehabilitation services.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:b93ac794d0c75da088ef1889089facdae542edec57557a5e60dc6ea7e6dbf4bc\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"urn:rulespec:document-understanding:section:214ad60901a587753e79aabc24ace858a542d5405e31b466690ba730688916c0\",\"start\":86081,\"summary\":\"Nothing in this chapter shall be construed to prohibit a State from testing participants in programs, activities, or services carried out or provided under this chapter for controlled substances.\",\"target_ids\":[],\"term_refs\":[\"urn:rulespec:document-understanding:term:6bbc300c908c37f17bd770ac79351e2f73a7907fd41fbd4359723f71c0c578f1\"],\"typed_values\":[]}",

      "rkaf:hasContentDigest": "sha256:7bedc5bc35cb533db70dfc9985614f8998c11c081aa7805a2d30a4af62c249cd",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:3fd606f12772f9dcbe49a1c70de396ee9b79a1f8c2967334bbdbb2996a89fa62\",\"urn:rulespec:document-understanding:assertion:0c18c8359900be52f11f990d1364dfa327c2dcd7d06912a240917ab3ff24a5bc\",\"urn:rulespec:document-understanding:assertion:1d7ea425ddf1b49f942f1297119815f29adb52e6635c07cfbf40e808b756c74c\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":83316,\"evidence\":[{\"end\":83316,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:82638:83316:sha256-c6d8f434ec5b03e35c67e6acf8f25926a4958c6e9bdf44d9b0cf125814aaf26a\",\"quote\":\"No person shall, on the basis of race, color, national origin, or sex be excluded from participation in, be denied the benefits of, or be subjected to discrimination under, any program or activity funded in whole or in part with funds made available under this chapter. Any prohibition against discrimination on the basis of age under the Age Discrimination Act of 1975 (42 U.S.C. 6101 et seq.) or with respect to an otherwise qualified individual with a disability as provided in section 504 of the Rehabilitation Act of 1973 (29 U.S.C. 794), or title II of the Americans with Disabilities Act of 1990 (42 U.S.C. 12131 et seq.) shall also apply to any such program or activity.\",\"start\":82638}],\"id\":\"urn:rulespec:document-understanding:revision:58f42c795092df19f068f8e8418c412aef973e4eeed2d7c8c5b1976984a023c7\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:1d7ea425ddf1b49f942f1297119815f29adb52e6635c07cfbf40e808b756c74c\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:c4fb09c1bcb1718ea751c944c424703f6ec6c34d4c56f2d41131fca302ba6009\",\"origin\":\"aiSuggested\",\"quote\":\"No person shall, on the basis of race, color, national origin, or sex be excluded from participation in, be denied the benefits of, or be subjected to discrimination under, any program or activity funded in whole or in part with funds made available under this chapter. Any prohibition against discrimination on the basis of age under the Age Discrimination Act of 1975 (42 U.S.C. 6101 et seq.) or with respect to an otherwise qualified individual with a disability as provided in section 504 of the Rehabilitation Act of 1973 (29 U.S.C. 794), or title II of the Americans with Disabilities Act of 1990 (42 U.S.C. 12131 et seq.) shall also apply to any such program or activity.\",\"references\":[\"Age Discrimination Act of 1975\",\"42 U.S.C. 6101 et seq.\",\"section 504 of the Rehabilitation Act of 1973\",\"29 U.S.C. 794\",\"title II of the Americans with Disabilities Act of 1990\",\"42 U.S.C. 12131 et seq.\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:ced3fa330b71ebb8d7edbf72ec4083676d5b8c7cf47c991f02a9f84d6c371cd1\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"urn:rulespec:document-understanding:section:c2d7d2b3c184cf50d82366ce65cb8d6112ac79f92281542f43e74ba5049712d4\",\"start\":82638,\"summary\":\"Any prohibition against discrimination on the basis of age under the Age Discrimination Act of 1975 (42 U.S.C. 6101 et seq.) or with respect to an otherwise qualified individual with a disability as provided in section 504 of the Rehabilitation Act of 1973 (29 U.S.C. 794), or title II of the Americans with Disabilities Act of 1990 (42 U.S.C. 12131 et seq.) shall also apply to any program or activity funded in whole or in part with funds made available under this chapter.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

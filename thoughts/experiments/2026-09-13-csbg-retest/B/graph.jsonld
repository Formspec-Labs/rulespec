    {
      "@id": "urn:rulespec:document-understanding:revision:58563aff91ddcaacf2d164d3a5e890ccc4f748b0c0090278a11d86214ccc3f56",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:58563aff91ddcaacf2d164d3a5e890ccc4f748b0c0090278a11d86214ccc3f56",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:b09f2527e2322896d64540f4d856c2a47445f584ec0373dad0aafba2a8dd54b0",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"The Secretary\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:1f342794e97e0cf776a7846920fa475ce8dd67fc2d7bffd0bf7380d2b8390ef5\",\"urn:rulespec:document-understanding:assertion:0e363978c91debc51fe83d37b31638830615fd5abe39626eb29aca94cea5fc69\",\"urn:rulespec:document-understanding:assertion:c3ce06a8ccca7383c1bb590fa52b32baca368b326439e40afc9be8f8c054a80e\",\"urn:rulespec:document-understanding:assertion:9a8ea365165b46a24d0292d2d9319762327819be96d6b55387c4edea8399b495\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":77647,\"evidence\":[{\"end\":77647,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:76992:77647:sha256-ae6390ba42cc646aed1b474d84a9db6a486f1ddea6a8c8cfb74a598e1b301dc7\",\"quote\":\"The Secretary, in collaboration with the States and with eligible entities throughout the Nation, shall facilitate the development of one or more model performance measurement systems, which may be used by the States and by eligible entities to measure their performance in carrying out the requirements of this chapter and in achieving the goals of their community action plans. The Secretary shall provide technical assistance, including support for the enhancement of electronic data systems, to States and to eligible entities to enhance their capability to collect and report data for such a system and to aid in their participation in such a system.\",\"start\":76992}],\"id\":\"urn:rulespec:document-understanding:revision:58563aff91ddcaacf2d164d3a5e890ccc4f748b0c0090278a11d86214ccc3f56\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:9a8ea365165b46a24d0292d2d9319762327819be96d6b55387c4edea8399b495\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:4e71506dade494405996ebdefb60b7f798d80937c13e7655878b474f045d6634\",\"origin\":\"aiSuggested\",\"quote\":\"The Secretary, in collaboration with the States and with eligible entities throughout the Nation, shall facilitate the development of one or more model performance measurement systems, which may be used by the States and by eligible entities to measure their performance in carrying out the requirements of this chapter and in achieving the goals of their community action plans. The Secretary shall provide technical assistance, including support for the enhancement of electronic data systems, to States and to eligible entities to enhance their capability to collect and report data for such a system and to aid in their participation in such a system.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:638739619891468752b5059c1d19fe9c89923ae36becd5e021f313e5d5fcfafc\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"urn:rulespec:document-understanding:section:fa489a00ccb41098ac2b415167888ae0d85e530b88cc3c90eda7efe29c7dad7b\",\"start\":76992,\"summary\":\"The Secretary must provide technical assistance, including support for the enhancement of electronic data systems, to States and to eligible entities to enhance their capability to collect and report data for such a model performance measurement system and to aid in their participation in such a system.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",
      "dcterms:references": [

    {
      "@id": "urn:rulespec:document-understanding:revision:a8897d3a9bd4c2d3e6373c9569c4568eb2207e9c2ea15b3331952aeef9c4b5b6",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:a8897d3a9bd4c2d3e6373c9569c4568eb2207e9c2ea15b3331952aeef9c4b5b6",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:7fe21d29b1c0a5ee0e57eb29b9309301ac6ea6eb584d62a7b8b90723837266eb",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"The Secretary\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:9d49a9d6dca9d7f933d984e5bad5e1afb44ec8267242923bcdb791425166ade2\",\"urn:rulespec:document-understanding:assertion:68048e8dc8b694bd9ccda5e8ce0b74fc462d9e516aa0ee0126608268747320fb\",\"urn:rulespec:document-understanding:assertion:4d35f3186cafc154f1dcd9b97f98e0ef088b9b0cd505039f53c20fef54b364d0\",\"urn:rulespec:document-understanding:assertion:14f4e0f450e4198b6f7175a413e713f0c84066f5fc6d69d3024404844ad8d087\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":67833,\"evidence\":[{\"end\":67833,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:66787:67833:sha256-6029fefdb7fae5c5b046e858a6ecbf3e689c9da8af5615d345e4ffce339968de\",\"quote\":\"The Secretary shall conduct in several States in each fiscal year evaluations (including investigations) of the use of funds received by the States under this chapter in order to evaluate compliance with the provisions of this chapter, and especially with respect to compliance with section 9908(b) of this title. The Secretary shall submit, to each State evaluated, a report containing the results of such evaluations, and recommendations of improvements designed to enhance the benefit and impact of the activities carried out with such funds for people in need. On receiving the report, the State shall submit to the Secretary a plan of action in response to the recommendations contained in the report. The results of the evaluations shall be submitted annually to the Chairperson of the Committee on Education and the Workforce of the House of Representatives and the Chairperson of the Committee on Labor and Human Resources of the Senate as part of the report submitted by the Secretary in accordance with section 9917(b)(2) of this title.\",\"start\":66787}],\"id\":\"urn:rulespec:document-understanding:revision:a8897d3a9bd4c2d3e6373c9569c4568eb2207e9c2ea15b3331952aeef9c4b5b6\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:14f4e0f450e4198b6f7175a413e713f0c84066f5fc6d69d3024404844ad8d087\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:a1b82696c433ac8472de635fe73f3499d0f3f3c3ac3163d38a13fdacc4332a66\",\"origin\":\"aiSuggested\",\"quote\":\"The Secretary shall conduct in several States in each fiscal year evaluations (including investigations) of the use of funds received by the States under this chapter in order to evaluate compliance with the provisions of this chapter, and especially with respect to compliance with section 9908(b) of this title. The Secretary shall submit, to each State evaluated, a report containing the results of such evaluations, and recommendations of improvements designed to enhance the benefit and impact of the activities carried out with such funds for people in need. On receiving the report, the State shall submit to the Secretary a plan of action in response to the recommendations contained in the report. The results of the evaluations shall be submitted annually to the Chairperson of the Committee on Education and the Workforce of the House of Representatives and the Chairperson of the Committee on Labor and Human Resources of the Senate as part of the report submitted by the Secretary in accordance with section 9917(b)(2) of this title.\",\"references\":[\"section 9908(b) of this title\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:6411247149cd6054f85763850e25aed7da15d17982ace2e08689917903da79eb\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"urn:rulespec:document-understanding:section:c0349af1123d989776fe253553df69642696cd32996dd791c280bdbf3d513641\",\"start\":66787,\"summary\":\"The Secretary shall conduct in several States in each fiscal year evaluations (including investigations) of the use of funds received by the States under this chapter in order to evaluate compliance with the provisions of this chapter, and especially with respect to compliance with section 9908(b) of this title.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

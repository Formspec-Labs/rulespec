      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:19461b1e9c5826c985763b75b41f1e6027a16321e5341db71aeee26cdbbfb09a\",\"urn:rulespec:document-understanding:assertion:f18cfafa087eb77cd7a76f09f22d389fb0d999f3d0e714c1c12288ab78d6cdbb\",\"urn:rulespec:document-understanding:assertion:c66dfe4b8358adcf66f3e4e31716025d7b32b2956a594c8a645e84e89828fcf6\",\"urn:rulespec:document-understanding:assertion:7f4faa4ceb7ff5075ea6559c6852e25f238483f183abd66e2903eba71dca943f\",\"urn:rulespec:document-understanding:assertion:837730d3ed5423484f5aee5dd3e8a77d58558882b036f67c6bd12676fb5291db\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":116389,\"evidence\":[{\"end\":115782,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:115715:115782:sha256-83735de030c71ea5df9d5f3b054591e6d2f3d4a8f1d67584a63d5b5d8949d9a6\",\"quote\":\"(2) Such grants may be made only with respect to applications that—\",\"start\":115715},{\"end\":116389,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:115784:116389:sha256-d9f8d26926fb897040e51a4b576045656f8681e6567693fe55af4eab937b6e33\",\"quote\":\"(A) identify and describe the population to be served, the problems to be addressed, the overall approach and methods of outreach and recruitment to be used, and the services to be provided;\\n\\n(B) describe how the approach to be used differs from other approaches used for the population to be served by the project;\\n\\n(C) describe the objectives of the project and contain a plan for measuring progress toward meeting those objectives; and\\n\\n(D) contain assurances that the grantee will report on the progress and results of the demonstration at such times and in such manner as the Secretary shall require.\",\"start\":115784},{\"end\":115763,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:115743:115763:sha256-915dd51283b6defbd0ad9b3b94f541bb8c5879aff3c8eefecfb7cf117b221f93\",\"quote\":\"only with respect to\",\"start\":115743},{\"end\":115782,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:115715:115782:sha256-83735de030c71ea5df9d5f3b054591e6d2f3d4a8f1d67584a63d5b5d8949d9a6\",\"quote\":\"(2) Such grants may be made only with respect to applications that—\",\"start\":115715}],\"id\":\"urn:rulespec:document-understanding:revision:0f6efa03a55bde5128ad5bcb5895bbd4a16839af0dd1f0cd722a75e38fd46767\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:7f4faa4ceb7ff5075ea6559c6852e25f238483f183abd66e2903eba71dca943f\",\"modality\":\"must\",\"modality_quote\":\"only with respect to\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:72d5a4ffca49290a742c4730a82fe0f0d02f5383d93e1b8f20ae117728e0fc9d\",\"origin\":\"aiSuggested\",\"quote\":\"(2) Such grants may be made only with respect to applications that—\\n\\n(A) identify and describe the population to be served, the problems to be addressed, the overall approach and methods of outreach and recruitment to be used, and the services to be provided;\\n\\n(B) describe how the approach to be used differs from other approaches used for the population to be served by the project;\\n\\n(C) describe the objectives of the project and contain a plan for measuring progress toward meeting those objectives; and\\n\\n(D) contain assurances that the grantee will report on the progress and results of the demonstration at such times and in such manner as the Secretary shall require.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:2e1f1b4211d2f879e2aaeb3f7a286c15012a4507d8e6cbf6a7d9940482b07fd4\",\"scope_quotes\":[\"(2) Such grants may be made only with respect to applications that—\"],\"scope_text\":\"Grants under subsection (c)\",\"section_id\":\"urn:rulespec:document-understanding:section:5fba676d6775544d7cae048a3634eb9fe091aa0a96f2f732b41f08ff944d6890\",\"start\":115715,\"summary\":\"Grants under 42 U.S.C. 9925(c) may be made only with respect to applications that identify and describe the population to be served, the problems to be addressed, the overall approach and methods of outreach and recruitment to be used, and the services to be provided; describe how the approach to be used differs from other approaches used for the population to be served by the project; describe the objectives of the project and contain a plan for measuring progress toward meeting those objectives; and contain assurances that the grantee will report on the progress and results of the demonstration at such times and in such manner as the Secretary shall require.\",\"target_ids\":[],\"term_refs\":[\"urn:rulespec:document-understanding:term:576e9257cb479321316fb378bb4b88ddb844dc1e33b39dc213b46732e75aa46c\"],\"typed_values\":[]}",

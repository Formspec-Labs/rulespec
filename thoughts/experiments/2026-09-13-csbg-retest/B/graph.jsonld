      "dcterms:description": "{\"action\":\"\",\"actor\":\"the State\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:5316a1269cc38a0dbdb32b06f73df8d89678904d39695e5c4bd574458d803589\",\"urn:rulespec:document-understanding:assertion:d5479b8e9d01711cbbea875573d158be20b6df76904efbfa95e5b0e8327bf69c\",\"urn:rulespec:document-understanding:assertion:e9ea1b64d70d4bb62e928a4cb631de3100ec1cd6c5515927938f821ecc19d5f1\",\"urn:rulespec:document-understanding:assertion:222548b3df8d8f420a2baa1b6fb1bf2477b0cb8883b72f508156eca053d42e2c\",\"urn:rulespec:document-understanding:assertion:944e85a2c4488a44b229563cb13cbebe490611b884048258e06d900e0cc7f6c3\",\"urn:rulespec:document-understanding:assertion:9abbe3c4f00944408aae5a022a86a24a6dd64edc968b1fbb913f53be0169fdde\",\"urn:rulespec:document-understanding:assertion:15a8214dbaa318667ab01836bebbbcce6fbad89c1933de669a2d02638683d424\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":16172,\"evidence\":[{\"end\":16172,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:15218:16172:sha256-1603cf9f43b064a37fb684b67c0b13a2cd9a6ea24370dcbf44b41db1b03cbdd8\",\"quote\":\"The term “poverty line” means the official poverty line defined by the Office of Management and Budget based on the most recent data available from the Bureau of the Census. The Secretary shall revise annually (or at any shorter interval the Secretary determines to be feasible and desirable) the poverty line, which shall be used as a criterion of eligibility in the community services block grant program established under this chapter. The required revision shall be accomplished by multiplying the official poverty line by the percentage change in the Consumer Price Index for All Urban Consumers during the annual or other interval immediately preceding the time at which the revision is made. Whenever a State determines that it serves the objectives of the block grant program established under this chapter, the State may revise the poverty line to not to exceed 125 percent of the official poverty line otherwise applicable under this paragraph.\",\"start\":15218},{\"end\":16043,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:16034:16043:sha256-b25ac3a3200d1b12b577827b3daca4cc1dbfb9dc07d0af8b19b9d897125aa638\",\"quote\":\"the State\",\"start\":16034},{\"end\":16047,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:16044:16047:sha256-ee4d988c65de860fabbfbcd27f73d50bbebe3fba37fe419284f4811389c30bdc\",\"quote\":\"may\",\"start\":16044},{\"end\":16172,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:15218:16172:sha256-1603cf9f43b064a37fb684b67c0b13a2cd9a6ea24370dcbf44b41db1b03cbdd8\",\"quote\":\"The term “poverty line” means the official poverty line defined by the Office of Management and Budget based on the most recent data available from the Bureau of the Census. The Secretary shall revise annually (or at any shorter interval the Secretary determines to be feasible and desirable) the poverty line, which shall be used as a criterion of eligibility in the community services block grant program established under this chapter. The required revision shall be accomplished by multiplying the official poverty line by the percentage change in the Consumer Price Index for All Urban Consumers during the annual or other interval immediately preceding the time at which the revision is made. Whenever a State determines that it serves the objectives of the block grant program established under this chapter, the State may revise the poverty line to not to exceed 125 percent of the official poverty line otherwise applicable under this paragraph.\",\"start\":15218}],\"id\":\"urn:rulespec:document-understanding:revision:1a8f04809152f03cb0ff56325fc4f2562174a237c9252b88de2f716483173e52\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"permission\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:944e85a2c4488a44b229563cb13cbebe490611b884048258e06d900e0cc7f6c3\",\"modality\":\"may\",\"modality_quote\":\"may\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:2f541b15fb367604793dc967eb2d8ed1ae6930ae83f1dd3cc20e5fb7bcdaf7ed\",\"origin\":\"aiSuggested\",\"quote\":\"The term “poverty line” means the official poverty line defined by the Office of Management and Budget based on the most recent data available from the Bureau of the Census. The Secretary shall revise annually (or at any shorter interval the Secretary determines to be feasible and desirable) the poverty line, which shall be used as a criterion of eligibility in the community services block grant program established under this chapter. The required revision shall be accomplished by multiplying the official poverty line by the percentage change in the Consumer Price Index for All Urban Consumers during the annual or other interval immediately preceding the time at which the revision is made. Whenever a State determines that it serves the objectives of the block grant program established under this chapter, the State may revise the poverty line to not to exceed 125 percent of the official poverty line otherwise applicable under this paragraph.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:4a3f3766a3854a751b73cda792e23681a3ce1f6918be9c804715390a847f5d45\",\"scope_quotes\":[\"The term “poverty line” means the official poverty line defined by the Office of Management and Budget based on the most recent data available from the Bureau of the Census. The Secretary shall revise annually (or at any shorter interval the Secretary determines to be feasible and desirable) the poverty line, which shall be used as a criterion of eligibility in the community services block grant program established under this chapter. The required revision shall be accomplished by multiplying the official poverty line by the percentage change in the Consumer Price Index for All Urban Consumers during the annual or other interval immediately preceding the time at which the revision is made. Whenever a State determines that it serves the objectives of the block grant program established under this chapter, the State may revise the poverty line to not to exceed 125 percent of the official poverty line otherwise applicable under this paragraph.\"],\"scope_text\":\"Whenever a State determines that it serves the objectives of the block grant program established under this chapter\",\"section_id\":\"urn:rulespec:document-understanding:section:9a5224c808327e88c75f83b7cee8be31a7428e0086505e2dd784698ca11dd1d8\",\"start\":15218,\"summary\":\"Whenever a State determines that it serves the objectives of the block grant program established under this chapter, the State may revise the poverty line to not to exceed 125 percent of the official poverty line otherwise applicable under paragraph (2).\",\"target_ids\":[],\"term_refs\":[\"urn:rulespec:document-understanding:term:a5f435ed18594c5c30a861f8cb9ad4afd696755f11251838ef92e988b5953845\",\"urn:rulespec:document-understanding:term:439ac6c78277042f21626d5a2b780e789d2dc444f69020a0e5e8e5b326ae1ee8\"],\"typed_values\":[]}",

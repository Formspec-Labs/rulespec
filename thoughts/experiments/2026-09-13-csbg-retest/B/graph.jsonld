      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:ea5cb3e70d1a8bca1070ddbdbbe2cfa0304777e1dea7f999152ed86ee3170dd1\",\"urn:rulespec:document-understanding:assertion:a1b48790382f68dee043bade16d2571be9001fafb3480bad10737b897d0e7286\",\"urn:rulespec:document-understanding:assertion:53b7be0befa9a6ead20f63e38223eb007ac67ad3813b7ccafff6ffa11ac9bfdd\",\"urn:rulespec:document-understanding:assertion:0d6212fe190518e5f847e07e979239a4a4ee77756430fe330e994aaa2ccbb49a\",\"urn:rulespec:document-understanding:assertion:9006d00dd74933ed2817f92cf610f80b9c7e312cac0e3334ab82174445016b53\",\"urn:rulespec:document-understanding:assertion:e5732b24a1efc779226c3df5fb0b5f2cd7526f0a56cb3a082f9de7d43581542a\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[{\"aliases\":[],\"id\":\"urn:rulespec:document-understanding:term:8b535e3bff727ad86cce793967575c31c932a462c4ac5517a99808502b4d01d8\",\"label\":\"collection organization\",\"quote\":\"(II) Collection organization The term “collection organization” means an organization described in section 501(c)(3) of such title and exempt from tax under section 501(a) of such title—\\n\\n(aa) that solicits and collects gifts and grants that, by agreement, are distributed to qualified charities;\\n\\n(bb) that distributes to qualified charities at least 90 percent of the gifts and grants the organization receives that are designated for such qualified charities; and\\n\\n(cc) that meets the requirements of clause (vi).\",\"source_quotes\":[\"(II) Collection organization The term “collection organization” means an organization described in section 501(c)(3) of such title and exempt from tax under section 501(a) of such title—\\n\\n(aa) that solicits and collects gifts and grants that, by agreement, are distributed to qualified charities;\\n\\n(bb) that distributes to qualified charities at least 90 percent of the gifts and grants the organization receives that are designated for such qualified charities; and\\n\\n(cc) that meets the requirements of clause (vi).\"]}],\"effective_periods\":[],\"end\":31059,\"evidence\":[{\"end\":30571,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:30543:30571:sha256-65df4a9aabeb4c860dae071e837f18ee26f640d851b6787492562500704883a8\",\"quote\":\"(II) Collection organization\",\"start\":30543},{\"end\":30729,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:30572:30729:sha256-fb9b614999ea802de07ce07a9dc68c93659c6943db03ce614e7421f152eb415a\",\"quote\":\"The term “collection organization” means an organization described in section 501(c)(3) of such title and exempt from tax under section 501(a) of such title—\",\"start\":30572},{\"end\":31059,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:30731:31059:sha256-097e29daffcb5df56a869d30c3f69cd594b9569243356f23ad1bcb861ac04b1e\",\"quote\":\"(aa) that solicits and collects gifts and grants that, by agreement, are distributed to qualified charities;\\n\\n(bb) that distributes to qualified charities at least 90 percent of the gifts and grants the organization receives that are designated for such qualified charities; and\\n\\n(cc) that meets the requirements of clause (vi).\",\"start\":30731},{\"end\":29266,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:29241:29266:sha256-aea566b0f29d0189db01116b9bd6a1dbb8292c28864bce72d66471186cd8b70d\",\"quote\":\"(3)
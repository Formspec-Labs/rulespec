      "dcterms:description": "{\"action\":\"\",\"actor\":\"Secretary\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:1027791bc4f4150ec981dd02aad65c6843b00b191289d23bd091c6df8689147e\",\"urn:rulespec:document-understanding:assertion:7e0ff23d1430ef1111891a4b850d16906eeeb3b5ca48f3d979e5c65aa1dd7b81\",\"urn:rulespec:document-understanding:assertion:d54acbdbe52f577faf7fde339c925bf37e9b9170483904b34ea64ebd097149a0\",\"urn:rulespec:document-understanding:assertion:f33ef074a4a0136b75e38e71b7cba41cc4e166a643097e9c0b518dd909956ee4\",\"urn:rulespec:document-understanding:assertion:f845775e70de3b9163270795d7b31c75deac9e8d12e459c2f94a8a7e2ef1d2a0\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":114889,\"evidence\":[{\"end\":114486,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:114378:114486:sha256-f2c5a73488bd8e405c3c454579e5296cf821e70c18db797d61398c1bd5972f2c\",\"quote\":\"(4) No application may be approved for assistance under this section unless the Secretary is satisfied that—\",\"start\":114378},{\"end\":114889,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:114488:114889:sha256-4486151ef99cd715a533229f3dcdba29e492cb6157792924c77c5189d860cebb\",\"quote\":\"(A) the activities to be carried out under the application will be in addition to, and not in substitution for, activities previously carried on without Federal assistance; and\\n\\n(B) funds or other resources devoted to programs designed to meet the needs of the poor within the community, area, or State will not be diminished in order to provide the matching contributions required under this section.\",\"start\":114488},{\"end\":114467,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:114454:114467:sha256-67afe9d5c4310238267da793c265a616f9e90d554f2458a8065b7bb971d853b5\",\"quote\":\"the Secretary\",\"start\":114454},{\"end\":114412,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:114382:114412:sha256-cc1ca500fdd8ff5403aea7f6185423b92da045864de84b94bba0ca6e86df2798\",\"quote\":\"No application may be approved\",\"start\":114382}],\"id\":\"urn:rulespec:document-understanding:revision:548caf4a61dcd31138a09c978149c40a020c692a935cb9fd6f49568fdbb5d35e\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"prohibition\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:f33ef074a4a0136b75e38e71b7cba41cc4e166a643097e9c0b518dd909956ee4\",\"modality\":\"must_not\",\"modality_quote\":\"No application may be approved\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:abbe1a1bfacb8763ddbe3fbbacf74ba536cfeeb72ae36d24bd3abdc0057d695e\",\"origin\":\"aiSuggested\",\"quote\":\"(4) No application may be approved for assistance under this section unless the Secretary is satisfied that—\\n\\n(A) the activities to be carried out under the application will be in addition to, and not in substitution for, activities previously carried on without Federal assistance; and\\n\\n(B) funds or other resources devoted to programs designed to meet the needs of the poor within the community, area, or State will not be diminished in order to provide the matching contributions required under this section.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:39eb1116b0bcd6d020fe4708fa3ef8e1784dcae79fd9ce36d71163f3e2403556\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"urn:rulespec:document-understanding:section:5fba676d6775544d7cae048a3634eb9fe091aa0a96f2f732b41f08ff944d6890\",\"start\":114378,\"summary\":\"No application may be approved for assistance under 42 U.S.C. 9925 unless the Secretary is satisfied that the activities to be carried out under the application will be in addition to, and not in substitution for, activities previously carried on without Federal assistance, and funds or other resources devoted to programs designed to meet the needs of the poor within the community, area, or State will not be diminished in order to provide the matching contributions required under this section.\",\"target_ids\":[],\"term_refs\":[\"urn:rulespec:document-understanding:term:576e9257cb479321316fb378bb4b88ddb844dc1e33b39dc213b46732e75aa46c\"],\"typed_values\":[]}",

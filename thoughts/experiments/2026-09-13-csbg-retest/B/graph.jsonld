    {
      "@id": "urn:rulespec:document-understanding:revision:ead00c591ef2ff9a6d7dfb798553028adf3cd89f196f746b53c08a3d3caa6560",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:ead00c591ef2ff9a6d7dfb798553028adf3cd89f196f746b53c08a3d3caa6560",

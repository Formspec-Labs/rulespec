      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:4b80bc242bf4108132092097a8f5b641e6a56bd640c5f048e8bbcbf82862ca04",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:bc313875f8641fa1e56f9241762379751a49fc4be4a4a417a8121b0bdf8258f7",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:77c34d174a32f150ddb03293c89b8f3253bc45a11e832e0d1926ac416cd0ed82",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"kind\":\"requirement\",\"modality\":\"must\",\"scope_text\":\"With respect to applications for grants under subsection (a)\",\"summary\":\"Grants under 42 U.S.C. 9925(a) may be made only with respect to applications which involve activities that can be incorporated into or be closely coordinated with eligible entities' ongoing programs; involve significant new combinations of resources or new and innovative approaches involving partnership agreements; are structured in a way that will, within the limits of the type of assistance or activities contemplated, most fully and effectively promote the purposes of the Community Services Block Grant Act; and contain an assurance that the applicant for such grants will obtain an independent, methodologically sound evaluation of the effectiveness of the activities carried out with such grant and will submit such evaluation to the Secretary.\",\"term_refs\":[\"urn:rulespec:document-understanding:term:576e9257cb479321316fb378bb4b88ddb844dc1e33b39dc213b46732e75aa46c\"]}",
        "@type": "xsd:string"
      },

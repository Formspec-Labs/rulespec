    {
      "@id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:65939:66395:sha256-92834f2d2e3428c0c5ad88e6724e99ddbfe8dc6ab4f0ae02b799c22600dcb903",
      "@type": "rkaf:SourceFragment",
      "oa:hasSource": "urn:rulespec:document-understanding:document:26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023",
      "rkaf:fragmentIdentityScheme": "rkaf:carrier-local-fragment",
      "rkaf:sourceArtifactDigest": "sha256:26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023",
      "rkaf:fragmentContentDigest": "sha256:92834f2d2e3428c0c5ad88e6724e99ddbfe8dc6ab4f0ae02b799c22600dcb903",
      "rkaf:selectorKind": [
        "oa:TextQuoteSelector",
        "oa:TextPositionSelector"
      ],
      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "(1) A full onsite review of each such entity at least once during each 3-year period.\n\n(2) An onsite review of each newly designated entity immediately after the completion of the first year in which such entity receives funds through the community services block grant program.\n\n(3) Followup reviews including prompt return visits to eligible entities, and their programs, that fail to meet the goals, standards, and requirements established by the State."
        },
        {
          "@type": "oa:TextPositionSelector",
          "oa:start": 65939,
          "oa:end": 66395,
          "rkaf:coordinateSystem": "rkaf:unicode-codepoint"
        }
      ]

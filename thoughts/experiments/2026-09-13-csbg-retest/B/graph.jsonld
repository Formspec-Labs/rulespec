      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"the Secretary\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:1bd60832bb8eccdb777b25f6b9b04c5dbbcf70de86a09051e80a709c8ef0851d\",\"urn:rulespec:document-understanding:assertion:ed2b6d6ed1fc502315544c95d3b071b0fb7e60b3f449e095194bb637a66f5f88\",\"urn:rulespec:document-understanding:assertion:2e20bc7585a1d29cd6975b94fc44e7c642de2f4ba8f3be3b6471e2bddfc6fc2a\",\"urn:rulespec:document-understanding:assertion:c97c96d46f155610027960d77f91293268881e14d0e96a6a4fad8c904a7008b9\",\"urn:rulespec:document-understanding:assertion:67fcb45376f668342d88705690fe74dd87a5696717f6761d216bff927f24a68b\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":84313,\"evidence\":[{\"end\":83342,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:83319:83342:sha256-6c96d44781a8b80d349f834eaf7691d48a4edcc1ef9c2ed749a91bd73eee3288\",\"quote\":\"(2) Action of Secretary\",\"start\":83319},{\"end\":83788,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:83343:83788:sha256-486910efee42d9779dcd701f56767816dc86a1919c5a452ba9f06e49c73f638e\",\"quote\":\"Whenever the Secretary determines that a State that has received a payment under this chapter has failed to comply with paragraph (1) or an applicable regulation, the Secretary shall notify the chief executive officer of the State and shall request that the officer secure compliance. If within a reasonable period of time, not to exceed 60 days, the chief executive officer fails or refuses to secure compliance, the Secretary is authorized to—\",\"start\":83343},{\"end\":84313,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:83790:84313:sha256-b1a64913cbc2ca9a28e6f71ad26f9d0ac43478f0b408507aa4548ab362c9d6be\",\"quote\":\"(A) refer the matter to the Attorney General with a recommendation that an appropriate civil action be instituted;\\n\\n(B) exercise the powers and functions provided by title VI of the Civil Rights Act of 1964 (42 U.S.C. 2000d et seq.), the Age Discrimination Act of 1975 (42 U.S.C. 6101 et seq.), section 504 of the Rehabilitation Act of 1973 (29 U.S.C. 794), or title II of the Americans with Disabilities Act of 1990 (42 U.S.C. 12131 et seq.), as may be applicable; or\\n\\n(C) take such other action as may be provided by law.\",\"start\":83790},{\"end\":83787,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:83771:83787:sha256-99b99f6ee0f807e32b2a2c99f3ca55a3ef3c808479973e8823bffb6d64443f30\",\"quote\":\"is authorized to\",\"start\":83771},{\"end\":83342,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:83319:83342:sha256-6c96d44781a8b80d349f834eaf7691d48a4edcc1ef9c2ed749a91bd73eee3288\",\"quote\":\"(2) Action of Secretary\",\"start\":83319},{\"end\":83788,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:83343:83788:sha256-486910efee42d9779dcd701f56767816dc86a1919c5a452ba9f06e49c73f638e\",\"quote\":\"Whenever the Secretary determines that a State that has received a payment under this chapter has failed to comply with paragraph (1) or an applicable regulation, the Secretary shall notify the chief executive officer of the State and shall request that the officer secure compliance. If within a reasonable period of time, not to exceed 60 days, the chief executive officer fails or refuses to secure compliance, the Secretary is authorized to—\",\"start\":83343}],\"id\":\"urn:rulespec:document-understanding:revision:da8b38551e2301b10ac79b5f3ab26e97577d2b8aa59743d99f8738d977622f47\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"authority\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:67fcb45376f668342d88705690fe74dd87a5696717f6761d216bff927f24a68b\",\"modality\":\"may\",\"modality_quote\":\"is authorized to\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:bdd5ceb8ac880ab3b0741c4abf648c9a9c0852742c6fec2c19e081fb49388afd\",\"origin\":\"aiSuggested\",\"quote\":\"(2) Action of Secretary Whenever the Secretary determines that a State that has received a payment under this chapter has failed to comply with paragraph (1) or an applicable regulation, the Secretary shall notify the chief executive officer of the State and shall request that the officer secure compliance. If within a reasonable period of time, not to exceed 60 days, the chief executive officer fails or refuses to secure compliance, the Secretary is authorized to—\\n\\n(A) refer the matter to the Attorney General with a recommendation that an appropriate civil action be instituted;\\n\\n(B) exercise the powers and functions provided by title VI of the Civil Rights Act of 1964 (42 U.S.C. 2000d et seq.), the Age Discrimination Act of 1975 (42 U.S.C. 6101 et seq.), section 504 of the Rehabilitation Act of 1973 (29 U.S.C. 794), or title II of the Americans with Disabilities Act of 1990 (42 U.S.C. 12131 et seq.), as may be applicable; or\\n\\n(C) take such other action as may be provided by law.\",\"references\":[\"paragraph (1)\",\"title VI of the Civil Rights Act of 1964\",\"42 U.S.C. 2000d et seq.\",\"Age Discrimination Act of 1975\",\"42 U.S.C. 6101 et seq.\",\"section 504 of the Rehabilitation Act of 1973\",\"29 U.S.C. 794\",\"title II of the Americans with Disabilities Act of 1990\",\"42 U.S.C. 12131 et seq.\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:c391f40310c4acf66b5e4c6a972703fd13dc7ccbc7a15f6ba871862bd1cb6aee\",\"scope_quotes\":[\"(2) Action of Secretary Whenever the Secretary determines that a State that has received a payment under this chapter has failed to comply with paragraph (1) or an applicable regulation, the Secretary shall notify the chief executive officer of the State and shall request that the officer secure compliance. If within a reasonable period of time, not to exceed 60 days, the chief executive officer fails or refuses to secure compliance, the Secretary is authorized to—\"],\"scope_text\":\"Whenever the Secretary determines that a State that has received a payment under this chapter has failed to comply with paragraph (1) or an applicable regulation ... If within a reasonable period of time, not to exceed 60 days, the chief executive officer fails or refuses to secure compliance\",\"section_id\":\"urn:rulespec:document-understanding:section:c2d7d2b3c184cf50d82366ce65cb8d6112ac79f92281542f43e74ba5049712d4\",\"start\":83319,\"summary\":\"Whenever the Secretary determines that a State that has received a payment under this chapter has failed to comply with paragraph (1) or an applicable regulation, and if within a reasonable period of time, not to exceed 60 days, the chief executive officer fails or refuses to secure compliance, the Secretary is authorized to: (A) refer the matter to the Attorney General with a recommendation that an appropriate civil action be instituted; (B) exercise the powers and functions provided by title VI of the Civil Rights Act of 1964 (42 U.S.C. 2000d et seq.), the Age Discrimination Act of 1975 (42 U.S.C. 6101 et seq.), section 504 of the Rehabilitation Act of 1973 (29 U.S.C. 794), or title II of the Americans with Disabilities Act of 1990 (42 U.S.C. 12131 et seq.), as may be applicable; or (C) take such other action as may be provided by law.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

      "rkaf:assertsValue": {
        "@value": "{\"defined_terms\":[{\"id\":\"urn:rulespec:document-understanding:term:8b535e3bff727ad86cce793967575c31c932a462c4ac5517a99808502b4d01d8\",\"label\":\"collection organization\",\"quote\":\"(II) Collection organization The term “collection organization” means an organization described in section 501(c)(3) of such title and exempt from tax under section 501(a) of such title—\\n\\n(aa) that solicits and collects gifts and grants that, by agreement, are distributed to qualified charities;\\n\\n(bb) that distributes to qualified charities at least 90 percent of the gifts and grants the organization receives that are designated for such qualified charities; and\\n\\n(cc) that meets the requirements of clause (vi).\",\"source_quotes\":[\"(II) Collection organization The term “collection organization” means an organization described in section 501(c)(3) of such title and exempt from tax under section 501(a) of such title—\\n\\n(aa) that solicits and collects gifts and grants that, by agreement, are distributed to qualified charities;\\n\\n(bb) that distributes to qualified charities at least 90 percent of the gifts and grants the organization receives that are designated for such qualified charities; and\\n\\n(cc) that meets the requirements of clause (vi).\"]}],\"kind\":\"definition\",\"modality\":\"not_stated\",\"scope_text\":\"In subsection (c).\",\"summary\":\"The term “collection organization” means an organization described in section 501(c)(3) of title 26 and exempt from tax under section 501(a) of such title that solicits and collects gifts and grants that, by agreement, are distributed to qualified charities; that distributes to qualified charities at least 90 percent of the gifts and grants the organization receives that are designated for such qualified charities; and that meets the requirements of clause (vi).\",\"term_refs\":[\"urn:rulespec:document-understanding:term:63469c0d2442b190f2220845329335cfed02029cc2785e1f3826c7ec59ec7182\"]}",

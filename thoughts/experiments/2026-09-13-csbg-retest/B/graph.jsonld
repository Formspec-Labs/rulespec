      "@id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:82638:83316:sha256-c6d8f434ec5b03e35c67e6acf8f25926a4958c6e9bdf44d9b0cf125814aaf26a",

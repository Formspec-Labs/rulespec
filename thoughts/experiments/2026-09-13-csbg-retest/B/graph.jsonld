    {
      "@id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:65939:66600:sha256-dc035a80b369059d25c7cae1c27a0ee8755eec3476d78634862e5ecccc9c1108",
      "@type": "rkaf:SourceFragment",
      "oa:hasSource": "urn:rulespec:document-understanding:document:26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023",
      "rkaf:fragmentIdentityScheme": "rkaf:carrier-local-fragment",
      "rkaf:sourceArtifactDigest": "sha256:26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023",
      "rkaf:fragmentContentDigest": "sha256:dc035a80b369059d25c7cae1c27a0ee8755eec3476d78634862e5ecccc9c1108",
      "rkaf:selectorKind": [
        "oa:TextQuoteSelector",
        "oa:TextPositionSelector"
      ],
      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "(1) A full onsite review of each such entity at least once during each 3-year period.\n\n(2) An onsite review of each newly designated entity immediately after the completion of the first year in which such entity receives funds through the community services block grant program.\n\n(3) Followup reviews including prompt return visits to eligible entities, and their programs, that fail to meet the goals, standards, and requirements established by the State.\n\n(4) Other reviews as appropriate, including reviews of entities with programs that have had other Federal, State, or local grants (other than assistance provided under this chapter) terminated for cause."
        },
        {
          "@type": "oa:TextPositionSelector",
          "oa:start": 65939,
          "oa:end": 66600,
          "rkaf:coordinateSystem": "rkaf:unicode-codepoint"
        }
      ]
    },

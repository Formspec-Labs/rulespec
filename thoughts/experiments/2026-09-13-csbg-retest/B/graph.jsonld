      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "The Secretary of Health and Human Services (in this section referred to as the “Secretary”) shall enter into agreements with nonprofit organizations (including community development corporations) submitting applications under this section for the purpose of conducting projects in accordance with subsection (b) to create employment opportunities for certain low-income individuals."
        },

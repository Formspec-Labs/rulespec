      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"actor\":\"Secretary\",\"kind\":\"permission\",\"modality\":\"may\",\"summary\":\"In order to stimulate the development of new approaches to provide for greater self-sufficiency of the poor, to test and evaluate such new approaches, to disseminate project results and evaluation findings so that such approaches can be replicated, and to strengthen the integration, coordination, and redirection of activities to promote maximum self-sufficiency among the poor, the Secretary may make grants from funds appropriated under subsection (e) to eligible entities for the development and implementation of new and innovative approaches to deal with particularly critical needs or problems of the poor which are common to a number of communities.\",\"term_refs\":[\"urn:rulespec:document-understanding:term:576e9257cb479321316fb378bb4b88ddb844dc1e33b39dc213b46732e75aa46c\",\"urn:rulespec:document-understanding:term:2b4a0e0f50499d8d1d3fc49284b4a8396f8bd249309fd91a3f8a3916e278ef08\"]}",

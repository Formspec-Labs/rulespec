      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"State\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:8bec3ba8af217b4f00e59d90d0556f1feafcb2face17fef5eddd897045339df2\",\"urn:rulespec:document-understanding:assertion:71054a8d9f4e634e5fdd526eeadd7377d66c330b51478419b6d34cd259f5356d\",\"urn:rulespec:document-understanding:assertion:70ddb544a1bc816245bc95ec0928d5b079620ae3e684b832b1fba5fdbc5a4681\",\"urn:rulespec:document-understanding:assertion:ebf07cb0d8ffc58c4d82b6982f38fa0d49c2a3a7a0ce172ef9d6895cc373aae4\",\"urn:rulespec:document-understanding:assertion:49bed8068e50904a41f65ec3a0a6dd209bd5aefa0eab87f34026a4699b82527c\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":25825,\"evidence\":[{\"end\":25825,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:25508:25825:sha256-36d6caadf233ac0e28d3c134ef00634c496a0e57983e6d3bd97fb8a05030c4b1\",\"quote\":\"Beginning on October 1, 2000, a State may recapture and redistribute funds distributed to an eligible entity through a grant made under paragraph (1) that are unobligated at the end of a fiscal year if such unobligated funds exceed 20 percent of the amount so distributed to such eligible entity for such fiscal year.\",\"start\":25508},{\"end\":25545,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:25540:25545:sha256-a3b50c476732c7409d297c3d7d0e23569fee5e08318553ae76041ab5fe60582e\",\"quote\":\"State\",\"start\":25540},{\"end\":25549,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:25546:25549:sha256-ee4d988c65de860fabbfbcd27f73d50bbebe3fba37fe419284f4811389c30bdc\",\"quote\":\"may\",\"start\":25546},{\"end\":25825,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:25508:25825:sha256-36d6caadf233ac0e28d3c134ef00634c496a0e57983e6d3bd97fb8a05030c4b1\",\"quote\":\"Beginning on October 1, 2000, a State may recapture and redistribute funds distributed to an eligible entity through a grant made under paragraph (1) that are unobligated at the end of a fiscal year if such unobligated funds exceed 20 percent of the amount so distributed to such eligible entity for such fiscal year.\",\"start\":25508}],\"id\":\"urn:rulespec:document-understanding:revision:b693b350b25d07ff2b58b09cb07afea8bc12ed6abed759d8390dc8a4ccb27c5d\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"permission\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:49bed8068e50904a41f65ec3a0a6dd209bd5aefa0eab87f34026a4699b82527c\",\"modality\":\"may\",\"modality_quote\":\"may\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:fe94846d5fe4dde24b517cc337e931ebbda8725148c242bebdba051b235780c6\",\"origin\":\"aiSuggested\",\"quote\":\"Beginning on October 1, 2000, a State may recapture and redistribute funds distributed to an eligible entity through a grant made under paragraph (1) that are unobligated at the end of a fiscal year if such unobligated funds exceed 20 percent of the amount so distributed to such eligible entity for such fiscal year.\",\"references\":[\"paragraph (1)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:5f1070e0706f2d1afc0f4356adbff130bb6c4ac6d7456bf2416029d412fc54c5\",\"scope_quotes\":[\"Beginning on October 1, 2000, a State may recapture and redistribute funds distributed to an eligible entity through a grant made under paragraph (1) that are unobligated at the end of a fiscal year if such unobligated funds exceed 20 percent of the amount so distributed to such eligible entity for such fiscal year.\"],\"scope_text\":\"Beginning on October 1, 2000, if unobligated funds distributed to an eligible entity through a grant made under paragraph (1) at the end of a fiscal year exceed 20 percent of the amount distributed to such eligible entity for such fiscal year.\",\"section_id\":\"urn:rulespec:document-understanding:section:065d5bd1b1fd12e07012730aaa12714e330211d213042d09aad361bcfa67ebfa\",\"start\":25508,\"summary\":\"Beginning on October 1, 2000, a State may recapture and redistribute funds distributed to an eligible entity through a grant made under paragraph (1) that are unobligated at the end of a fiscal year if such unobligated funds exceed 20 percent of the amount so distributed to such eligible entity for such fiscal year.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

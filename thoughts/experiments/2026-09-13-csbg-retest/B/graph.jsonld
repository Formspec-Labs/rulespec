      "rkaf:assertsValue": {
        "@value": "{\"actor\":\"The State\",\"kind\":\"requirement\",\"modality\":\"must\",\"summary\":\"The State must also include in its annual report a summary describing the training and technical assistance offered by the State under 42 U.S.C. 9915(a)(3) during the year covered by the report.\"}",
        "@type": "xsd:string"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

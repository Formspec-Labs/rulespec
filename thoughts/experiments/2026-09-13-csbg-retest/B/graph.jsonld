        "@value": "{\"actor\":\"the Secretary\",\"kind\":\"requirement\",\"modality\":\"must\",\"scope_text\":\"Subject to paragraphs (2) and (3), if the amount appropriated under section 9903(a) of this title for a fiscal year that remains after the Secretary makes the reservations required in section 9903(b) of this title exceeds $345,000,000\",\"summary\":\"Subject to paragraphs (2) and (3), if the amount appropriated under section 9903(a) of this title for a fiscal year that remains after the Secretary makes the reservations required in section 9903(b) of this title exceeds $345,000,000, the Secretary must allot to each State not less than 1/2 of 1 percent of the amount appropriated under section 9903(a) of this title for such fiscal year.\",\"term_refs\":[\"urn:rulespec:document-understanding:term:c3a6dc2397e2c0695b6af8b70bbc3d8d09172d19a96d71862190a71266dd8e8e\"]}",

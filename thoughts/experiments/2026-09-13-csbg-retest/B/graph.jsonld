      "dcterms:description": "{\"action\":\"\",\"actor\":\"The Secretary\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:9925e3d9cdde3fb65d48ab5852cebad3153606b35c6979440c2f4457486b270e\",\"urn:rulespec:document-understanding:assertion:2cb1edc85b684725b0d5c0a92522210067eca65789937f1b88b5420f76081c14\",\"urn:rulespec:document-understanding:assertion:b207283359f1694b9986e9ed0baa564afbaf32538772cc96134eb17f08152906\",\"urn:rulespec:document-understanding:assertion:086986612467cd904375e75cca7336918cda54d16d033a0bf2796d6a281eaf3c\",\"urn:rulespec:document-understanding:assertion:99075cf9d9e4b778683de80446a2efeec337793e0cc32af4924afaae9de0aea6\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":73940,\"evidence\":[{\"end\":73940,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:73572:73940:sha256-445355eaffcde4351390562fd51e18544222059fbd0ce8966dd0c7542d379553\",\"quote\":\"The Secretary shall, after providing adequate notice and an opportunity for a hearing conducted within the affected State, withhold funds from any State that does not utilize the grant or allotment under section 9905 or 9906 of this title in accordance with the provisions of this chapter, including the assurances such State provided under section 9908 of this title.\",\"start\":73572},{\"end\":73585,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:73572:73585:sha256-d6dd2bb6d3c44b4545cc3f97cb6f8a38842ecd30d2c58ec3e1c53a8c1a0ac77c\",\"quote\":\"The Secretary\",\"start\":73572},{\"end\":73591,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:73586:73591:sha256-56ee5b508706bf2de91712d85d6d1e11ddbff01949142ed6e8c22e3b1bed1c71\",\"quote\":\"shall\",\"start\":73586},{\"end\":73940,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:73572:73940:sha256-445355eaffcde4351390562fd51e18544222059fbd0ce8966dd0c7542d379553\",\"quote\":\"The Secretary shall, after providing adequate notice and an opportunity for a hearing conducted within the affected State, withhold funds from any State that does not utilize the grant or allotment under section 9905 or 9906 of this title in accordance with the provisions of this chapter, including the assurances such State provided under section 9908 of this title.\",\"start\":73572}],\"id\":\"urn:rulespec:document-understanding:revision:2c925ae7e4b24f574d8b00d6a19dffe91635c9400852ed8773ee50ff28d50b69\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:99075cf9d9e4b778683de80446a2efeec337793e0cc32af4924afaae9de0aea6\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:25584280f346b5f1d20eebaada535dd8475d027f895478a03fd5beda7d1c5f96\",\"origin\":\"aiSuggested\",\"quote\":\"The Secretary shall, after providing adequate notice and an opportunity for a hearing conducted within the affected State, withhold funds from any State that does not utilize the grant or allotment under section 9905 or 9906 of this title in accordance with the provisions of this chapter, including the assurances such State provided under section 9908 of this title.\",\"references\":[\"section 9905\",\"section 9906\",\"section 9908\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:a5dec51296a0cb0fef58abedd3bd38f58b825a040b398cfa750766f4782e91fc\",\"scope_quotes\":[\"The Secretary shall, after providing adequate notice and an opportunity for a hearing conducted within the affected State, withhold funds from any State that does not utilize the grant or allotment under section 9905 or 9906 of this title in accordance with the provisions of this chapter, including the assurances such State provided under section 9908 of this title.\"],\"scope_text\":\"after providing adequate notice and an opportunity for a hearing conducted within the affected State, from any State that does not utilize the grant or allotment under section 9905 or 9906 of this title in accordance with the provisions of this chapter, including the assurances such State provided under section 9908 of this title\",\"section_id\":\"urn:rulespec:document-understanding:section:0b25ac9c8446d0124b5ecb28732f48c838d6393d415b560a4767e735df70b004\",\"start\":73572,\"summary\":\"The Secretary must, after providing adequate notice and an opportunity for a hearing conducted within the affected State, withhold funds from any State that does not utilize the grant or allotment under section 9905 or 9906 of this title in accordance with the provisions of this chapter, including the assurances such State provided under section 9908 of this title.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

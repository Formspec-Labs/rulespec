      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:5017db02c4d44e2ab56cb75dfcc2e38042d17b84919cfc9be33a2a33de957446\",\"urn:rulespec:document-understanding:assertion:3114066fdf1c11dc216b8734e871ca2f29ef949de173fa5d1500088a1250fc29\",\"urn:rulespec:document-understanding:assertion:b7773b82c069f5ba89a1fbffcb6a3fd89cb723b19a0557d96465899c9f130508\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":4256,\"evidence\":[{\"end\":2805,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:2742:2805:sha256-78b8182a722625d9070e1c42c6a2e0922a1ee293f1d3dfedd430dbc80613dd7a\",\"quote\":\"(2) to accomplish the goals described in paragraph (1) through—\",\"start\":2742},{\"end\":4009,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:2807:4009:sha256-9838e329389ba2c4d9a0150858fd0251acce28e55ffd919c3197b6f891ce90fd\",\"quote\":\"(A) the strengthening of community capabilities for planning and coordinating the use of a broad range of Federal, State, local, and other assistance (including private resources) related to the elimination of poverty, so that this assistance can be used in a manner responsive to local needs and conditions;\\n\\n(B) the organization of a range of services related to the needs of low-income families and individuals, so that these services may have a measurable and potentially major impact on the causes of poverty in the community and may help the families and individuals to achieve self-sufficiency;\\n\\n(C) the greater use of innovative and effective community-based approaches to attacking the causes and effects of poverty and of community breakdown;\\n\\n(D) the maximum participation of residents of the low-income communities and members of the groups served by programs assisted through the block grants made under this chapter to empower such residents and members to respond to the unique problems and needs within their communities; and\\n\\n(E) the broadening of the resource base of programs directed to the elimination of poverty so as to secure a more active role in the provision of services for—\",\"start\":2807},{\"end\":4256,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:4011:4256:sha256-f485a858b2d7fd3556734066ce1c4dbdcedffd46d4d6c8ec4fe5f3ccda427b78\",\"quote\":\"(i) private, religious, charitable, and neighborhood-based organizations; and\\n\\n(ii) individual citizens, and business, labor, and professional groups, who are able to influence the quantity and quality of opportunities and services for the poor.\",\"start\":4011}],\"id\":\"urn:rulespec:document-understanding:revision:14c8bff5e90ae6d446538833f5751c6af58669655c9bc54884b608e13c50b3d1\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"statement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:b7773b82c069f5ba89a1fbffcb6a3fd89cb723b19a0557d96465899c9f130508\",\"modality\":\"not_stated\",\"modality_quote\":\"\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:4ae1a39aa8f6dfdf32a8e2bcb71f74ebfce2a1d3a646bf120432a1e3124a3d5d\",\"origin\":\"aiSuggested\",\"quote\":\"(2) to accomplish the goals described in paragraph (1) through—\\n\\n(A) the strengthening of community capabilities for planning and coordinating the use of a broad range of Federal, State, local, and other assistance (including private resources) related to the elimination of poverty, so that this assistance can be used in a manner responsive to local needs and conditions;\\n\\n(B) the organization of a range of services related to the needs of low-income families and individuals, so that these services may have a measurable and potentially major impact on the causes of poverty in the community and may help the families and individuals to achieve self-sufficiency;\\n\\n(C) the greater use of innovative and effective community-based approaches to attacking the causes and effects of poverty and of community breakdown;\\n\\n(D) the maximum participation of residents of the low-income communities and members of the groups served by programs assisted through the block grants made under this chapter to empower such residents and members to respond to the unique problems and needs within their communities; and\\n\\n(E) the broadening of the resource base of programs directed to the elimination of poverty so as to secure a more active role in the provision of services for—\\n\\n(i) private, religious, charitable, and neighborhood-based organizations; and\\n\\n(ii) individual citizens, and business, labor, and professional groups, who are able to influence the quantity and quality of opportunities and services for the poor.\",\"references\":[\"paragraph (1)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:87a1108f899495c4542e4398dd1d3f008678b41d5d40d073bb7c6e2f96bf123b\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"urn:rulespec:document-understanding:section:7323930aa170deb28e8e4c58b97489268b7a6a77f0c9e944a4a0c1a4cb2ef66d\",\"start\":2742,\"summary\":\"The purposes of this chapter are to accomplish the goals described in paragraph (1) through: (A) strengthening community capabilities for planning and coordinating the use of a broad range of Federal, State, local, and other assistance (including private resources) related to the elimination of poverty, so that this assistance can be used in a manner responsive to local needs and conditions; (B) organizing a range of services related to the needs of low-income families and individuals, so that these services may have a measurable and potentially major impact on the causes of poverty in the community and may help the families and individuals to achieve self-sufficiency; (C) greater use of innovative and effective community-based approaches to attacking the causes and effects of poverty and of community breakdown; (D) maximum participation of residents of the low-income communities and members of the groups served by programs assisted through the block grants made under this chapter to empower such residents and members to respond to the unique problems and needs within their communities; and (E) broadening the resource base of programs directed to the elimination of poverty so as to secure a more active role in the provision of services for private, religious, charitable, and neighborhood-based organizations, as well as individual citizens, and business, labor, and professional groups, who are able to influence the quantity and quality of opportunities and services for the poor.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

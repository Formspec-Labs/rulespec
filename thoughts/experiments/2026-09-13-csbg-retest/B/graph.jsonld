      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"the Secretary\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:49eeb9d048a8ec97d46628186e0f3d0e8644cfb0b652448b7f1bb05efcf6d8bf\",\"urn:rulespec:document-understanding:assertion:f64349dd6aa3a3a242050ebc1eac7f597387f3da473270280db47ae7232da99d\",\"urn:rulespec:document-understanding:assertion:c7fbb2c64436089e0cf6700346d0431044e27090e65b9f7e7f08cfb475bb3730\",\"urn:rulespec:document-understanding:assertion:d843736fff9d1a0b0644a1bc34127585f08ac77d3b3eb7d3b5b31f307a94d570\",\"urn:rulespec:document-understanding:assertion:7978d2e6c93af29c9960647d94a2b9fbc3e8c344dd248efe060e07fd502eb2f3\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":93254,\"evidence\":[{\"end\":93254,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:92782:93254:sha256-ad1937794400725340cd8b6b2ef58ca4ddf5b77ccb8e21fc86fe4ce092ca6ea7\",\"quote\":\"Of the amounts made available to carry out this paragraph, the Secretary may reserve not more than 1 percent for each fiscal year to make grants to private, nonprofit organizations or to enter into contracts with private, nonprofit or for-profit organizations to provide technical assistance to aid community development corporations in developing or implementing activities funded to carry out this paragraph and to evaluate activities funded to carry out this paragraph.\",\"start\":92782},{\"end\":92854,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:92841:92854:sha256-67afe9d5c4310238267da793c265a616f9e90d554f2458a8065b7bb971d853b5\",\"quote\":\"the Secretary\",\"start\":92841},{\"end\":92858,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:92855:92858:sha256-ee4d988c65de860fabbfbcd27f73d50bbebe3fba37fe419284f4811389c30bdc\",\"quote\":\"may\",\"start\":92855},{\"end\":93254,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:92782:93254:sha256-ad1937794400725340cd8b6b2ef58ca4ddf5b77ccb8e21fc86fe4ce092ca6ea7\",\"quote\":\"Of the amounts made available to carry out this paragraph, the Secretary may reserve not more than 1 percent for each fiscal year to make grants to private, nonprofit organizations or to enter into contracts with private, nonprofit or for-profit organizations to provide technical assistance to aid community development corporations in developing or implementing activities funded to carry out this paragraph and to evaluate activities funded to carry out this paragraph.\",\"start\":92782}],\"id\":\"urn:rulespec:document-understanding:revision:174d4bee7369277ede49d333715012e475b6be32d00b3516aca67bef18530a8c\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"permission\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:7978d2e6c93af29c9960647d94a2b9fbc3e8c344dd248efe060e07fd502eb2f3\",\"modality\":\"may\",\"modality_quote\":\"may\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:33f76d6ccc0ff5bf62104e202f6af9147d0839687fe7cb02b24c42537ad2da9c\",\"origin\":\"aiSuggested\",\"quote\":\"Of the amounts made available to carry out this paragraph, the Secretary may reserve not more than 1 percent for each fiscal year to make grants to private, nonprofit organizations or to enter into contracts with private, nonprofit or for-profit organizations to provide technical assistance to aid community development corporations in developing or implementing activities funded to carry out this paragraph and to evaluate activities funded to carry out this paragraph.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:1829fb1121dd341d1d3a764c4b9b9c42dce3871166f08e51220579f6e760b712\",\"scope_quotes\":[\"Of the amounts made available to carry out this paragraph, the Secretary may reserve not more than 1 percent for each fiscal year to make grants to private, nonprofit organizations or to enter into contracts with private, nonprofit or for-profit organizations to provide technical assistance to aid community development corporations in developing or implementing activities funded to carry out this paragraph and to evaluate activities funded to carry out this paragraph.\"],\"scope_text\":\"Of the amounts made available to carry out this paragraph\",\"section_id\":\"urn:rulespec:document-understanding:section:6888d98c59cc2331f4c6a6a1e0052761ef3a8008658a9708c0cec6503ed121ed\",\"start\":92782,\"summary\":\"Of the amounts made available to carry out paragraph (2), the Secretary may reserve not more than 1 percent for each fiscal year to make grants to private, nonprofit organizations or to enter into contracts with private, nonprofit or for-profit organizations to provide technical assistance to aid community development corporations in developing or implementing activities funded to carry out paragraph (2) and to evaluate activities funded to carry out paragraph (2).\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

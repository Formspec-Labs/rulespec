      "dcterms:description": "{\"action\":\"\",\"actor\":\"any religious organization providing assistance under any program described in subsection (a)\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:1ec7d7818c35924f6c480426319212cf00e1d18c9d68ef9d58ab48abbec34b9d\",\"urn:rulespec:document-understanding:assertion:5ed2da59e2917c5215267be7d0160ff2754b3773bb1dfb6db1181a5be9367ce3\",\"urn:rulespec:document-understanding:assertion:1a24f6d9d9a43baba648dfc0acc6f0332d301466d30024bc91ee2c9166d0f6e3\",\"urn:rulespec:document-understanding:assertion:252a0ae34e5a832d879f0b2ebe0271967ddce0b9468042ccf92835497f0ae674\",\"urn:rulespec:document-understanding:assertion:6f56491d70fec8ca716e04bf9309e7ca0be86a70c7e9d83432c11d912d1d4c23\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[\"For any program carried out by the Federal Government, or by a State or local government under this chapter, the government shall consider, on the same basis as other nongovernmental organizations, religious organizations to provide the assistance under the program, so long as the program is implemented in a manner consistent with the Establishment Clause of the first amendment to the Constitution. Neither the Federal Government nor a State or local government receiving funds under this chapter shall discriminate against an organization that provides assistance under, or applies to provide assistance under, this chapter, on the basis that the organization has a religious character.\"],\"defined_terms\":[],\"effective_periods\":[],\"end\":89903,\"evidence\":[{\"end\":89903,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:89571:89903:sha256-78ffadc5d148f304287c452ea7a013f121080ee1428ba6ba9d7238447f95be22\",\"quote\":\"Except as provided in paragraph (2), any religious organization providing assistance under any program described in subsection (a) shall be subject to the same regulations as other nongovernmental organizations to account in accord with generally accepted accounting principles for the use of such funds provided under such program.\",\"start\":89571},{\"end\":89701,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:89608:89701:sha256-79ec3479e5092d58e1cd94dc554b939a9fb45efe136396336c494af77b31545d\",\"quote\":\"any religious organization providing assistance under any program described in subsection (a)\",\"start\":89608},{\"end\":89707,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:89702:89707:sha256-56ee5b508706bf2de91712d85d6d1e11ddbff01949142ed6e8c22e3b1bed1c71\",\"quote\":\"shall\",\"start\":89702},{\"end\":89903,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:89571:89903:sha256-78ffadc5d148f304287c452ea7a013f121080ee1428ba6ba9d7238447f95be22\",\"quote\":\"Except as provided in paragraph (2), any religious organization providing assistance under any program described in subsection (a) shall be subject to the same regulations as other nongovernmental organizations to account in accord with generally accepted accounting principles for the use of such funds provided under such program.\",\"start\":89571},{\"end\":88263,\"field\":\"context:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:87573:88263:sha256-7f698273643ebaac09dd116e5fd1cab7db7c4e700d5aca2c7489efe5e05abd4a\",\"quote\":\"For any program carried out by the Federal Government, or by a State or local government under this chapter, the government shall consider, on the same basis as other nongovernmental organizations, religious organizations to provide the assistance under the program, so long as the program is implemented in a manner consistent with the Establishment Clause of the first amendment to the Constitution. Neither the Federal Government nor a State or local government receiving funds under this chapter shall discriminate against an organization that provides assistance under, or applies to provide assistance under, this chapter, on the basis that the organization has a religious character.\",\"start\":87573}],\"id\":\"urn:rulespec:document-understanding:revision:a5aab67524ac50da4acddb107957804e1b249b5ac2909ac5e650f9221215b3b3\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:6f56491d70fec8ca716e04bf9309e7ca0be86a70c7e9d83432c11d912d1d4c23\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:a1f0fc1103dcbd9a366ad38638a031424e778a32d97bf9cbe7d2a03552375fe4\",\"origin\":\"aiSuggested\",\"quote\":\"Except as provided in paragraph (2), any religious organization providing assistance under any program described in subsection (a) shall be subject to the same regulations as other nongovernmental organizations to account in accord with generally accepted accounting principles for the use of such funds provided under such program.\",\"references\":[\"paragraph (2)\",\"subsection (a)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:b4e57c47ed42975c7c452ce28ec25f19b0a8c52a37a56602721f4b01f7f69358\",\"scope_quotes\":[\"Except as provided in paragraph (2), any religious organization providing assistance under any program described in subsection (a) shall be subject to the same regulations as other nongovernmental organizations to account in accord with generally accepted accounting principles for the use of such funds provided under such program.\"],\"scope_text\":\"Except as provided in paragraph (2)\",\"section_id\":\"urn:rulespec:document-understanding:section:cfe00c4667f8a705b619c6842c9a05b4aaa1e3ace7adcf5723b0c39c5a6aa621\",\"start\":89571,\"summary\":\"Except as provided in paragraph (2) of subsection (d), any religious organization providing assistance under any program carried out by the Federal Government, or by a State or local government under this chapter, shall be subject to the same regulations as other nongovernmental organizations to account in accord with generally accepted accounting principles for the use of such funds provided under such program.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

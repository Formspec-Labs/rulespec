    {
      "@id": "urn:rulespec:document-understanding:assertion:ffd65cc252241cc5c2a82979adefe9b2286cf3d6ab9663b3270ce63ab08c1751",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:4b80bc242bf4108132092097a8f5b641e6a56bd640c5f048e8bbcbf82862ca04",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:31395ba7d5334d84fb0b494cef7940aef1f2057d347346c5e570b85817a7b200",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:9185d503979c7fd45346c4083608ff0008e6351b90bdc392e5ee3a8d29aab2fb",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"choice_text\":\"To qualify, an organization must satisfy three conditions: (1) be either a 501(c)(3) tax-exempt entity, an eligible entity, or a public housing agency; (2) be certified by the appropriate State authority as meeting clauses (iii) and (iv); and (3) if otherwise required to file a return under section 6033, elect to treat information required by clause (v) as specified in section 6033(b).\",\"defined_terms\":[{\"id\":\"urn:rulespec:document-understanding:term:63469c0d2442b190f2220845329335cfed02029cc2785e1f3826c7ec59ec7182\",\"label\":\"qualified charity\",\"quote\":\"(i) In general The term “qualified charity” means any organization—\\n\\n(I) that is—\\n\\n(aa) described in section 501(c)(3) of title 26 and exempt from tax under section 501(a) of such title;\\n\\n(bb) an eligible entity; or\\n\\n(cc) a public housing agency as defined in section 1437a(b)(6) of this title;\\n\\n\\n(II) that is certified by the appropriate State authority as meeting the requirements of clauses (iii) and (iv); and\\n\\n(III) if such organization is otherwise required to file a return under section 6033 of such title, that elects to treat the information required to be furnished by clause (v) as being specified in section 6033(b) of such title.\",\"source_quotes\":[\"(B) Qualified charity\\n\\n(i) In general The term “qualified charity” means any organization—\\n\\n(I) that is—\\n\\n(aa) described in section 501(c)(3) of title 26 and exempt from tax under section 501(a) of such title;\\n\\n(bb) an eligible entity; or\\n\\n(cc) a public housing agency as defined in section 1437a(b)(6) of this title;\\n\\n\\n(II) that is certified by the appropriate State authority as meeting the requirements of clauses (iii) and (iv); and\\n\\n(III) if such organization is otherwise required to file a return under section 6033 of such title, that elects to treat the information required to be furnished by clause (v) as being specified in section 6033(b) of such title.\"]}],\"kind\":\"definition\",\"modality\":\"not_stated\",\"scope_text\":\"In subsection (c).\",\"summary\":\"The term “qualified charity” means any organization that is described in section 501(c)(3) of title 26 and exempt from tax under section 501(a) of such title, an eligible entity, or a public housing agency as defined in section 1437a(b)(6) of this title; that is certified by the appropriate State authority as meeting the requirements of clauses (iii) and (iv); and, if such organization is otherwise required to file a return under section 6033 of such title, that elects to treat the information required to be furnished by clause (v) as being specified in section 6033(b) of such title.\"}",
        "@type": "xsd:string"
      },

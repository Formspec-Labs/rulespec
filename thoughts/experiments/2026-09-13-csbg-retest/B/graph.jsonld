    {
      "@id": "urn:rulespec:document-understanding:revision:2a96414a62c6dce59a873657c5a7c03074af00aab5c87ecdb405df7adf97ad73",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:2a96414a62c6dce59a873657c5a7c03074af00aab5c87ecdb405df7adf97ad73",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:4746726ba6ec938cfc96b2b15d78730ec0413bf8c471a3d4c4f1eafc177446f3",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:8265334c1382436433fc1d77e7f9aa50cf743840a62daba9bc35e931542baad1\",\"urn:rulespec:document-understanding:assertion:84953fc58b707f1fcdaa397adc9804b9f7a26af28155a1e156b02102cd802632\",\"urn:rulespec:document-understanding:assertion:a9a744a01e49ba2505c1ebd5b45b3b89cc2e81b9e0a4a2d9787b3725d414049f\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[\"For any program carried out by the Federal Government, or by a State or local government under this chapter, the government shall consider, on the same basis as other nongovernmental organizations, religious organizations to provide the assistance under the program, so long as the program is implemented in a manner consistent with the Establishment Clause of the first amendment to the Constitution. Neither the Federal Government nor a State or local government receiving funds under this chapter shall discriminate against an organization that provides assistance under, or applies to provide assistance under, this chapter, on the basis that the organization has a religious character.\"],\"defined_terms\":[],\"effective_periods\":[],\"end\":89525,\"evidence\":[{\"end\":89525,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:89329:89525:sha256-320269e8d3d5f36e905fa5a6db796fe7b7bd5964028c796671d8a5b60eb8aeab\",\"quote\":\"No funds provided directly to a religious organization to provide assistance under any program described in subsection (a) shall be expended for sectarian worship, instruction, or proselytization.\",\"start\":89329},{\"end\":89469,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:89329:89469:sha256-f73e68d004af36327a023ed3aadb3dae9eeefcfeacf0d6090b55547fe6ed574b\",\"quote\":\"No funds provided directly to a religious organization to provide assistance under any program described in subsection (a) shall be expended\",\"start\":89329},{\"end\":88263,\"field\":\"context:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:87573:88263:sha256-7f698273643ebaac09dd116e5fd1cab7db7c4e700d5aca2c7489efe5e05abd4a\",\"quote\":\"For any program carried out by the Federal Government, or by a State or local government under this chapter, the government shall consider, on the same basis as other nongovernmental organizations, religious organizations to provide the assistance under the program, so long as the program is implemented in a manner consistent with the Establishment Clause of the first amendment to the Constitution. Neither the Federal Government nor a State or local government receiving funds under this chapter shall discriminate against an organization that provides assistance under, or applies to provide assistance under, this chapter, on the basis that the organization has a religious character.\",\"start\":87573}],\"id\":\"urn:rulespec:document-understanding:revision:2a96414a62c6dce59a873657c5a7c03074af00aab5c87ecdb405df7adf97ad73\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"prohibition\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:a9a744a01e49ba2505c1ebd5b45b3b89cc2e81b9e0a4a2d9787b3725d414049f\",\"modality\":\"must_not\",\"modality_quote\":\"No funds provided directly to a religious organization to provide assistance under any program described in subsection (a) shall be expended\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:e0d64bb1cf35e37d01243c9c872fc1f05cf7bf91d90853c76bf81f800b00db4b\",\"origin\":\"aiSuggested\",\"quote\":\"No funds provided directly to a religious organization to provide assistance under any program described in subsection (a) shall be expended for sectarian worship, instruction, or proselytization.\",\"references\":[\"subsection (a)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:e54252a8d9fa13b60e1aca0a04fe79842ee70e4f783eef590135b0adce0271c4\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"urn:rulespec:document-understanding:section:cfe00c4667f8a705b619c6842c9a05b4aaa1e3ace7adcf5723b0c39c5a6aa621\",\"start\":89329,\"summary\":\"No funds provided directly to a religious organization to provide assistance under any program carried out by the Federal Government, or by a State or local government under this chapter, shall be expended for sectarian worship, instruction, or proselytization.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

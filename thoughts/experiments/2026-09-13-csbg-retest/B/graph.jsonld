      "@id": "urn:rulespec:document-understanding:revision:1bd766b933526795be47fb4fe3fc3ecf5985e0b556697fd1b76de22cc88d274d",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:1bd766b933526795be47fb4fe3fc3ecf5985e0b556697fd1b76de22cc88d274d",

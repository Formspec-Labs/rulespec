      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"actor\":\"the State\",\"kind\":\"requirement\",\"modality\":\"must\",\"scope_text\":\"If the State determines, on the basis of a final decision in a review pursuant to section 9914 of this title, that an eligible entity fails to comply with the terms of an agreement, or the State plan, to provide services under this chapter or to meet appropriate standards, goals, and other requirements established by the State (including performance objectives)\",\"summary\":\"If the State determines, on the basis of a final decision in a review pursuant to section 9914 of this title, that an eligible entity fails to comply with the terms of an agreement, or the State plan, to provide services under this chapter or to meet appropriate standards, goals, and other requirements established by the State (including performance objectives), the State shall offer training and technical assistance, if appropriate, to help correct the deficiency, and prepare and submit to the Secretary a report describing the training and technical assistance offered (unless it determines such assistance is not appropriate and reports its reasons).\"}",
        "@type": "xsd:string"
      },

    {
      "@id": "urn:rulespec:document-understanding:revision:5c1eeaa483a0bb28dd183ded3258cd4d149d8f56fb0be8fa66b675951edafcc4",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:5c1eeaa483a0bb28dd183ded3258cd4d149d8f56fb0be8fa66b675951edafcc4",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:d99e00089f987f85b476e7e3fd3516e228de7e7f7db045ae1be757d2b434a398",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"a State\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:ca25346c89d44cde650cf557706f02063c32ae493d32ddab998b297c476a131e\",\"urn:rulespec:document-understanding:assertion:b9ec3066a040a1b4660f757ecd9dd4ceaf8e9095a04c5fd1ba334ba7b92a6b7c\",\"urn:rulespec:document-understanding:assertion:6e107ff7c1439d60dc78290eff76aa0534cd75ca361e66e2afbc15ae30af79bd\",\"urn:rulespec:document-understanding:assertion:75192b9f9ca2694637d9f5da07451d005d165198a8fce295e660df7498aa8290\",\"urn:rulespec:document-understanding:assertion:369c1aee73a337abb558af64fdeac51ae7940c1f9f30480c258559c70369b6bd\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":41017,\"evidence\":[{\"end\":37850,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:37820:37850:sha256-e4eb5b6a8a7b9dd983a231deb98e7f6f65d6bc1675e6e9cecd8040a5250bb93d\",\"quote\":\"(b) State application and plan\",\"start\":37820},{\"end\":38333,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:37851:38333:sha256-584aa26d7ceb291cf4946eb3097ae0e9eaf3d8132583bd5b99429b4a3becd4c1\",\"quote\":\"Beginning with fiscal year 2000, to be eligible to receive a grant or allotment under section 9905 or 9906 of this title, a State shall prepare and submit to the Secretary an application and State plan covering a period of not less than 1 fiscal year and not more than 2 fiscal years. The plan shall be submitted not later than 30 days prior to the beginning of the first fiscal year covered by the plan, and shall contain such information as the Secretary shall require, including—\",\"start\":37851},{\"end\":38422,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:38335:38422:sha256-5a41c84474aa24cf672e53c4180cfdb03a238bfb10007ceb06382c577663f517\",\"quote\":\"(1) an assurance that funds made available through the grant or allotment will be used—\",\"start\":38335},{\"end\":38847,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:38424:38847:sha256-fd8ab136c0f1e722fe1809a4cd0b30f6e080e93e8b687b5450eff8b410333828\",\"quote\":\"(A) to support activities that are designed to assist low-income families and individuals, including families and individuals receiving assistance under part A of title IV of the Social Security Act (42 U.S.C. 601 et seq.), homeless families and individuals, migrant or seasonal farmworkers, and elderly low-income individuals and families, and a description of how such activities will enable the families and individuals—\",\"start\":38424},{\"end\":39925,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:38849:39925:sha256-c90ec600eb31a131f3d2d90e00b2bbe2d695eaa9e23d055def8f37c462c930e3\",\"quote\":\"(i) to remove obstacles and solve problems that block the achievement of self-sufficiency (including self-sufficiency for families and individuals who are attempting to transition off a State program carried out under part A of title IV of the Social Security Act);\\n\\n(ii) to secure and retain meaningful employment;\\n\\n(iii) to attain an adequate education, with particular attention toward improving literacy skills of the low-income families in the communities involved, which may include carrying out family literacy initiatives;\\n\\n(iv) to make better use of available income;\\n\\n(v) to obtain and maintain adequate housing and a suitable living environment;\\n\\n(vi) to obtain emergency assistance through loans, grants, or other means to meet immediate and urgent family and individual needs; and\\n\\n(vii) to achieve greater participation in the affairs of the communities involved, including the development of public and private grassroots partnerships with local law enforcement agencies, local housing authorities, private foundations, and other public and private partners to—\",\"start\":38849},{\"end\":40721,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:39927:40721:sha256-3d08bea6733861a07ad00abe3780a31f177159f9f7b61bff284c551f6d690e10\",\"quote\":\"(I) document best practices based on successful grassroots intervention in urban areas, to develop methodologies for widespread replication; and\\n\\n(II) strengthen and improve relationships with local law enforcement agencies, which may include participation in activities such as neighborhood or community policing efforts;\\n\\n\\n\\n(B) to address the needs of youth in low-income communities through youth development programs that support the primary role of the family, give priority to the prevention of youth problems and crime, and promote increased community coordination and collaboration in meeting the needs of youth, and support development and expansion of innovative community-based youth development programs that have demonstrated success in preventing or reducing youth crime, such as—\",\"start\":39927},{\"end\":41017,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:40723:41017:sha256-be69153ce623e639779ddb7aa3fbe49dc110920293905cb4cac62c9d9200a2f2\",\"quote\":\"(i) programs for the establishment of violence-free zones that would involve youth development and intervention models (such as models involving youth mediation, youth mentoring, life skills training, job creation, and entrepreneurship programs); and\\n\\n(ii) after-school child care programs; and\",\"start\":40723},{\"end\":37850,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:37820:37850:sha256-e4eb5b6a8a7b9dd983a231deb98e7f6f65d6bc1675e6e9cecd8040a5250bb93d\",\"quote\":\"(b) State application and plan\",\"start\":37820},{\"end\":38333,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:37851:38333:sha256-584aa26d7ceb291cf4946eb3097ae0e9eaf3d8132583bd5b99429b4a3becd4c1\",\"quote\":\"Beginning with fiscal year 2000, to be eligible to receive a grant or allotment under section 9905 or 9906 of this title, a State shall prepare and submit to the Secretary an application and State plan covering a period of not less than 1 fiscal year and not more than 2 fiscal years. The plan shall be submitted not later than 30 days prior to the beginning of the first fiscal year covered by the plan, and shall contain such information as the Secretary shall require, including—\",\"start\":37851}],\"id\":\"urn:rulespec:document-understanding:revision:5c1eeaa483a0bb28dd183ded3258cd4d149d8f56fb0be8fa66b675951edafcc4\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:369c1aee73a337abb558af64fdeac51ae7940c1f9f30480c258559c70369b6bd\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:a79636860c44a14411a43fc508ccd06f7a2fbc70274bba622ffcf34115be6051\",\"origin\":\"aiSuggested\",\"quote\":\"(b) State application and plan Beginning with fiscal year 2000, to be eligible to receive a grant or allotment under section 9905 or 9906 of this title, a State shall prepare and submit to the Secretary an application and State plan covering a period of not less than 1 fiscal year and not more than 2 fiscal years. The plan shall be submitted not later than 30 days prior to the beginning of the first fiscal year covered by the plan, and shall contain such information as the Secretary shall require, including—\\n\\n(1) an assurance that funds made available through the grant or allotment will be used—\\n\\n(A) to support activities that are designed to assist low-income families and individuals, including families and individuals receiving assistance under part A of title IV of the Social Security Act (42 U.S.C. 601 et seq.), homeless families and individuals, migrant or seasonal farmworkers, and elderly low-income individuals and families, and a description of how such activities will enable the families and individuals—\\n\\n(i) to remove obstacles and solve problems that block the achievement of self-sufficiency (including self-sufficiency for families and individuals who are attempting to transition off a State program carried out under part A of title IV of the Social Security Act);\\n\\n(ii) to secure and retain meaningful employment;\\n\\n(iii) to attain an adequate education, with particular attention toward improving literacy skills of the low-income families in the communities involved, which may include carrying out family literacy initiatives;\\n\\n(iv) to make better use of available income;\\n\\n(v) to obtain and maintain adequate housing and a suitable living environment;\\n\\n(vi) to obtain emergency assistance through loans, grants, or other means to meet immediate and urgent family and individual needs; and\\n\\n(vii) to achieve greater participation in the affairs of the communities involved, including the development of public and private grassroots partnerships with local law enforcement agencies, local housing authorities, private foundations, and other public and private partners to—\\n\\n(I) document best practices based on successful grassroots intervention in urban areas, to develop methodologies for widespread replication; and\\n\\n(II) strengthen and improve relationships with local law enforcement agencies, which may include participation in activities such as neighborhood or community policing efforts;\\n\\n\\n\\n(B) to address the needs of youth in low-income communities through youth development programs that support the primary role of the family, give priority to the prevention of youth problems and crime, and promote increased community coordination and collaboration in meeting the needs of youth, and support development and expansion of innovative community-based youth development programs that have demonstrated success in preventing or reducing youth crime, such as—\\n\\n(i) programs for the establishment of violence-free zones that would involve youth development and intervention models (such as models involving youth mediation, youth mentoring, life skills training, job creation, and entrepreneurship programs); and\\n\\n(ii) after-school child care programs; and\",\"references\":[\"section 9905\",\"section 9906\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:f2fe3bb46b5328ff6e7a4182e1882c764237096d784f5659cd167c8cafd13ec2\",\"scope_quotes\":[\"(b) State application and plan Beginning with fiscal year 2000, to be eligible to receive a grant or allotment under section 9905 or 9906 of this title, a State shall prepare and submit to the Secretary an application and State plan covering a period of not less than 1 fiscal year and not more than 2 fiscal years. The plan shall be submitted not later than 30 days prior to the beginning of the first fiscal year covered by the plan, and shall contain such information as the Secretary shall require, including—\"],\"scope_text\":\"Beginning with fiscal year 2000, to be eligible to receive a grant or allotment under section 9905 or 9906 of this title\",\"section_id\":\"urn:rulespec:document-understanding:section:0b55006ce2c906add8328d3986f73bcd1ded9a87a908d01ae85b5595b9018d1b\",\"start\":37820,\"summary\":\"Beginning with fiscal year 2000, the State's application and plan submitted to be eligible for a grant or allotment under section 9905 or 9906 of this title must contain an assurance that funds made available through the grant or allotment will be used to address the needs of youth in low-income communities through youth development programs that support the primary role of the family, give priority to preventing youth problems and crime, promote community coordination and collaboration, and support the development and expansion of innovative community-based youth development programs demonstrating success in preventing or reducing youth crime, such as violence-free zone programs involving youth development and intervention models (e.g., youth mediation, mentoring, life skills training, job creation, and entrepreneurship programs) and after-school child care programs.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",
      "dcterms:references": [
        {
          "@id": "urn:rulespec:document-understanding:assertion:ca25346c89d44cde650cf557706f02063c32ae493d32ddab998b297c476a131e"

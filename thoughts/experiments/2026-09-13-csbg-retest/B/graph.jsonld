      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:1068679b757c7eabe2b69a0bb23c7761db9330ce6bf2ff1b7abbd45b49fb3be6\",\"urn:rulespec:document-understanding:assertion:01ca95ba528ca50654049c81d56b1291558f08cfc3f325f07f998489fc5278c8\",\"urn:rulespec:document-understanding:assertion:1fc885efa10a7d1cfa0c6da60c39353c9e4b1ecf72e2192f018beb468f684965\",\"urn:rulespec:document-understanding:assertion:b82ae56e00c0c48082cc392ffc598fd724adc6d727b922c6832dff40a9a9ff5c\",\"urn:rulespec:document-understanding:assertion:5a230152030cdd2bf7840f353a60646c401ee1e49485ebda45de4d52cc8e0719\",\"urn:rulespec:document-understanding:assertion:a6be8edacc5c0d354c93a80bde9ddc7ffca44f5197f8a81a3bb24d28678c9ad0\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[{\"aliases\":[],\"id\":\"urn:rulespec:document-understanding:term:28aeae45433297cac74db47f9b0c3a69575405081d8e0aae4329cbf4510e8200\",\"label\":\"charity tax credit\",\"quote\":\"The term “charity tax credit” means a nonrefundable credit against State income tax (or, in the case of a State that does not impose an income tax, a comparable benefit) that is allowable for contributions, in cash or in kind, to qualified charities.\",\"source_quotes\":[\"(A) Charity tax credit\\n\\nThe term “charity tax credit” means a nonrefundable credit against State income tax (or, in the case of a State that does not impose an income tax, a comparable benefit) that is allowable for contributions, in cash or in kind, to qualified charities.\"]}],\"effective_periods\":[],\"end\":29562,\"evidence\":[{\"end\":29562,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:29312:29562:sha256-d0e7c5456f101f23222186a285b1376d9d984ec406299ccc8b6aa4314e9acfa2\",\
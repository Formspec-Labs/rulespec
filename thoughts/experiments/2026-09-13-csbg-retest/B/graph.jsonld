      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"Secretary\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:aea474e8ae03b32c6cc8f3f3a2c6f63a48f4bfd1d050451bafc0600a559f6563\",\"urn:rulespec:document-understanding:assertion:c5e171f910a64fac58d067dc6dc167ccb415e951f909325d56a569f053095143\",\"urn:rulespec:document-understanding:assertion:b24841a5bf5faa03c3d77b0cc945c74e538142eb8df8942ba8fe7f102ba0cb29\",\"urn:rulespec:document-understanding:assertion:a550257ba6c960a40fc0115b82c7aa020cbd1a3951ce1da98d0ffe27fac8b166\",\"urn:rulespec:document-understanding:assertion:1c6ce22b84a1fd065b9757662bebad1e50c0a96399cd00a4ac603c38381dcf8d\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":115713,\"evidence\":[{\"end\":115713,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:114939:115713:sha256-bc914a5d52ad8cc2bd0ce9128c30d54964bc79a27b7e74f99a7f4db83649975e\",\"quote\":\"(1) In addition to the grant programs described in subsection (a), the Secretary may make grants to community action agencies for the purpose of enabling such agencies to demonstrate new approaches to dealing with the problems caused by entrenched, chronic unemployment and lack of economic opportunities for urban youth. Demonstrations shall include such activities as peer counseling, mentoring, development of job skills, assistance with social skills, community services, family literacy, parenting skills, opportunities for employment or entrepreneurship, and other services designed to assist such at-risk youth to continue their education, to secure meaningful employment, to perform community service, or to pursue other productive alternatives within the community.\",\"start\":114939},{\"end\":115019,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:115006:115019:sha256-67afe9d5c4310238267da793c265a616f9e90d554f2458a8065b7bb971d853b5\",\"quote\":\"the Secretary\",\"start\":115006},{\"end\":115023,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:115020:115023:sha256-ee4d988c65de860fabbfbcd27f73d50bbebe3fba37fe419284f4811389c30bdc\",\"quote\":\"may\",\"start\":115020}],\"id\":\"urn:rulespec:document-understanding:revision:620c93ce4b8e6a49acb768737f3451874c37a9001d83d7007220b7c31c2a52a7\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"permission\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:a550257ba6c960a40fc0115b82c7aa020cbd1a3951ce1da98d0ffe27fac8b166\",\"modality\":\"may\",\"modality_quote\":\"may\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:6b549a57c9c38648272addc8408962c7ced286bb56352c9226832c20fca94b3d\",\"origin\":\"aiSuggested\",\"quote\":\"(1) In addition to the grant programs described in subsection (a), the Secretary may make grants to community action agencies for the purpose of enabling such agencies to demonstrate new approaches to dealing with the problems caused by entrenched, chronic unemployment and lack of economic opportunities for urban youth. Demonstrations shall include such activities as peer counseling, mentoring, development of job skills, assistance with social skills, community services, family literacy, parenting skills, opportunities for employment or entrepreneurship, and other services designed to assist such at-risk youth to continue their education, to secure meaningful employment, to perform community service, or to pursue other productive alternatives within the community.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:697dd341d1942586168c973fdaf3d1936cecf82b8a27dcb0e61126bf7d1ae9bd\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"urn:rulespec:document-understanding:section:5fba676d6775544d7cae048a3634eb9fe091aa0a96f2f732b41f08ff944d6890\",\"start\":114939,\"summary\":\"In addition to the grant programs described in subsection (a), the Secretary may make grants to community action agencies for the purpose of enabling such agencies to demonstrate new approaches to dealing with the problems caused by entrenched, chronic unemployment and lack of economic opportunities for urban youth, and such demonstrations shall include such activities as peer counseling, mentoring, development of job skills, assistance with social skills, community services, family literacy, parenting skills, opportunities for employment or entrepreneurship, and other services designed to assist such at-risk youth to continue their education, to secure meaningful employment, to perform community service, or to pursue other productive alternatives within the community.\",\"target_ids\":[],\"term_refs\":[\"urn:rulespec:document-understanding:term:576e9257cb479321316fb378bb4b88ddb844dc1e33b39dc213b46732e75aa46c\"],\"typed_values\":[]}",

      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:4b80bc242bf4108132092097a8f5b641e6a56bd640c5f048e8bbcbf82862ca04",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:f9f8775c9eae440584f3b98d1450131f73443791fcf2b8965c449f2646d33ed8",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:1cce5edb913331b3cbe66a3d0bb56802a390c771b893ef76651c2ff56f2636a3",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"actor\":\"the Secretary\",\"kind\":\"permission\",\"modality\":\"may\",\"summary\":\"The Secretary may, through grants to public and private, nonprofit agencies, provide for community-based, local, statewide, and national programs: (1) to coordinate private and public food assistance resources, wherever the grant recipient involved determines such coordination to be inadequate, to better serve low-income populations; (2) to assist low-income communities to identify potential sponsors of child nutrition programs and to initiate such programs in underserved or unserved areas; and (3) to develop innovative approaches at the State and local level to meet the nutrition needs of low-income individuals.\"}",
        "@type": "xsd:string"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },
    {

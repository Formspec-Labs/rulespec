      "dcterms:description": "{\"action\":\"\",\"actor\":\"the State\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:dbff370a04a72223fee12a7ad45b7850cfc69be1a0d31018c51c855e722aa6fb\",\"urn:rulespec:document-understanding:assertion:3051b553cc158108e392dd41ae0299f634e51d55c6e91feb1327425ed9ee791c\",\"urn:rulespec:document-understanding:assertion:0924da558dd67b4418a88e75198ec2f5daae2bffe41352b8636a5b574281ce81\",\"urn:rulespec:document-understanding:assertion:566bbc76ad9ce0b11b4a6147d606e9978cecb7f51bc7fe526fa20ce1ef16b25c\",\"urn:rulespec:document-understanding:assertion:62ea456e89eb5ceeae450411388654e8043c08afb5377b49dbaa9cb4be457756\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":69543,\"evidence\":[{\"end\":69543,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:69173:69543:sha256-26c29bebe76c6ca02ff1af74dc328918a482234ac8f06600b26ff208bfe7c911\",\"quote\":\"(A) at the discretion of the State (taking into account the seriousness of the deficiency and the time reasonably required to correct the deficiency), allow the entity to develop and implement, within 60 days after being informed of the deficiency, a quality improvement plan to correct such deficiency within a reasonable period of time, as determined by the State; and\",\"start\":69173},{\"end\":69207,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:69177:69207:sha256-3f0c4782cf38354ca6e14a0e544baec60c761aafb4e8e69358d3825a142f9b5a\",\"quote\":\"at the discretion of the State\",\"start\":69177},{\"end\":68283,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:68266:68283:sha256-fef9c1804c1c46956067d6581df93df72444872647b70b72bb3e6af066606522\",\"quote\":\"(a) Determination\",\"start\":68266},{\"end\":68665,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:68284:68665:sha256-2bd94d684e3542cfb70726d612ccd37955e615f0fc0c805729f83b029a200513\",\"quote\":\"If the State determines, on the basis of a final decision in a review pursuant to section 9914 of this title, that an eligible entity fails to comply with the terms of an agreement, or the State plan, to provide services under this chapter or to meet appropriate standards, goals, and other requirements established by the State (including performance objectives), the State shall—\",\"start\":68284}],\"id\":\"urn:rulespec:document-understanding:revision:810484779ef9e17b801117f3f63b65d42b56a16d8731cbbe4a5450c931cc9a9a\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"permission\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:62ea456e89eb5ceeae450411388654e8043c08afb5377b49dbaa9cb4be457756\",\"modality\":\"may\",\"modality_quote\":\"at the discretion of the State\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:53a3af0f63270c0a527424bdd4fb38e1c674fc66d74acf4fe8f00a18f0d33707\",\"origin\":\"aiSuggested\",\"quote\":\"(A) at the discretion of the State (taking into account the seriousness of the deficiency and the time reasonably required to correct the deficiency), allow the entity to develop and implement, within 60 days after being informed of the deficiency, a quality improvement plan to correct such deficiency within a reasonable period of time, as determined by the State; and\",\"references\":[\"section 9914 of this title\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:ece13c33ffff1319cb79b4f28ddd0d0cec703f49b97afa1e093e19f95f571f1a\",\"scope_quotes\":[\"(a) Determination If the State determines, on the basis of a final decision in a review pursuant to section 9914 of this title, that an eligible entity fails to comply with the terms of an agreement, or the State plan, to provide services under this chapter or to meet appropriate standards, goals, and other requirements established by the State (including performance objectives), the State shall—\"],\"scope_text\":\"If the State determines, on the basis of a final decision in a review pursuant to section 9914 of this title, that an eligible entity fails to comply with the terms of an agreement, or the State plan, to provide services under this chapter or to meet appropriate standards, goals, and other requirements established by the State (including performance objectives)\",\"section_id\":\"urn:rulespec:document-understanding:section:237b538fca368735fd9d07469584e65428d74fd94b694e39006074ead5c84559\",\"start\":69173,\"summary\":\"If the State determines, on the basis of a final decision in a review pursuant to section 9914 of this title, that an eligible entity fails to comply with the terms of an agreement, or the State plan, to provide services under this chapter or to meet appropriate standards, goals, and other requirements established by the State (including performance objectives), the State has discretion, taking into account the seriousness of the deficiency and the time reasonably required to correct the deficiency, to allow the entity to develop and implement, within 60 days after being informed of the deficiency, a quality improvement plan to correct such deficiency within a reasonable period of time, as determined by the State.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

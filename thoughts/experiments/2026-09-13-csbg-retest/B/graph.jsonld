          "@id": "urn:rulespec:document-understanding:assertion:1fe2fb3c907dd8ecadcc441abcfc31796023f350e8492e2b0368a453e79491a7"
        },
        {
          "@id": "urn:rulespec:document-understanding:assertion:5d1d098c227a35b8b761334e82d1eb5be5113c42ec32f5d5579366552733fd28"

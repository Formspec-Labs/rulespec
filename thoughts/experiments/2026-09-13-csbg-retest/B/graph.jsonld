      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:f73133225ecb06c84e669882ea933f8f87b9cc54fe4679fca7df073b1b021484\",\"urn:rulespec:document-understanding:assertion:55ffc9cdd3260eb2270746f350062446d332e4c6aa1c03d5a73864969dd487ee\",\"urn:rulespec:document-understanding:assertion:b210705100ce28be32c167c0aa56b20a87d51a6683be332052fad3b2098c55d8\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":64610,\"evidence\":[{\"end\":64118,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:64076:64118:sha256-2099245815bb7b3e12b200c774121a9819dd415cec37a3f42061ec38d6164d08\",\"quote\":\"(b) Terms and technical assistance process\",\"start\":64076},{\"end\":64228,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:64119:64228:sha256-52882140d840111f4e85484a4f49440a838631804cf8b34dd55d7917278462eb\",\"quote\":\"The process for determining the training and technical assistance to be carried out under this section shall—\",\"start\":64119},{\"end\":64610,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:64230:64610:sha256-fecc9f400dcba65557e9213d4c2362435bc5d305033a30f49188ee700c22da82\",\"quote\":\"(1) ensure that the needs of eligible entities and programs relating to improving program quality (including quality of financial management practices) are addressed to the maximum extent feasible; and\\n\\n(2) incorporate mechanisms to ensure responsiveness to local needs, including an ongoing procedure for obtaining input from the national and State networks of eligible entities.\",\"start\":64230},{\"end\":64227,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:64222:64227:sha256-56ee5b508706bf2de91712d85d6d1e11ddbff01949142ed6e8c22e3b1bed1c71\",\"quote\":\"shall\",\"start\":64222}],\"id\":\"urn:rulespec:document-understanding:revision:e8d014096ea0bb1ac14b990fce519deae4d100475d11f1f4e176742acf9e2fd2\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:b210705100ce28be32c167c0aa56b20a87d51a6683be332052fad3b2098c55d8\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:038e5fa1590b3c92ef0625809b4a28784bfc9c3c094a0a1ffa7173488e98a6e4\",\"origin\":\"aiSuggested\",\"quote\":\"(b) Terms and technical assistance process The process for determining the training and technical assistance to be carried out under this section shall—\\n\\n(1) ensure that the needs of eligible entities and programs relating to improving program quality (including quality of financial management practices) are addressed to the maximum extent feasible; and\\n\\n(2) incorporate mechanisms to ensure responsiveness to local needs, including an ongoing procedure for obtaining input from the national and State networks of eligible entities.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:bba920ca14cd2d79a7f6264744c12f7f3dbe452e216a1b728647c91749b1f4ed\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"urn:rulespec:document-understanding:section:14940ce669f832206b65cbb2eca659f59bd1cde99a702e87cfeffc3340239793\",\"start\":64076,\"summary\":\"The process for determining the training and technical assistance to be carried out under this section shall incorporate mechanisms to ensure responsiveness to local needs, including an ongoing procedure for obtaining input from the national and State networks of eligible entities.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

      "rkaf:hasContentDigest": "sha256:74d23d8a633d4ea8b3526024300a5da92408411c8cedc1367f9837fd66448f6a",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:0e053a52145f1f6852b4c3af84bcf7047fdd96f93d2ada91480f7842fd341291\",\"urn:rulespec:document-understanding:assertion:562ec6fe09d5e3fbafec018549a5bd6bda9e53f46eb67ffa0de14a959e4ded53\",\"urn:rulespec:document-understanding:assertion:3e381b9ff554d2a4f67becf1273d67053fa201a77341ae1cadad20765b1a8253\",\"urn:rulespec:document-understanding:assertion:0142a0eed5657d54068ce028c85145cdec772f21e7a07e60b73083dd32ebd5e7\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":13695,\"evidence\":[{\"end\":13476,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:13045:13476:sha256-a2f5e94bcdbfe6d574f9a82b09fa97a44e74afb83c0b1a46fbf4e885748906dd\",\"quote\":\"Sec. 2. Providing Emergency Learning Scholarships for Students. The Secretary of Health and Human Services shall take steps, consistent with law, to allow funds available through the Community Services Block Grant program to be used by grantees and eligible entities to provide emergency learning scholarships to disadvantaged families for use by any child without access to in-person learning. These scholarships may be used for:\\n\",\"start\":13045},{\"end\":13533,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:13477:13533:sha256-b48c9ea9f4bb61e3ede3a4d33fc44f34e0caae3a31f7a94bb9971b9a8f551a6c\",\"quote\":\"(i) tuition and fees for a private or parochial school;\\n\",\"start\":13477},{\"end\":13587,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:13534:13587:sha256-b4c83e55d6db7683ce9a6b8c28c48f85530337afce2377f88d0aee9f7b54c034\",\"quote\":\"(ii) homeschool, microschool, or learning-pod costs;\\n\",\"start\":13534},{\"end\":13658,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:13588:13658:sha256-f8b35d5b6063cd6ac355f1060d632330225bd32b56b0283314368285c0d2e688\",\"quote\":\"(iii) special education and related services, including therapies; or\\n\",\"start\":13588},{\"end\":13695,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:13659:13695:sha256-4ac127865eef9f235251bc4c928ff4fac414f570357a08cb198f99fcddb800a0\",\"quote\":\"(iv) tutoring or remedial education.\",\"start\":13659},{\"end\":13462,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:13459:13462:sha256-ee4d988c65de860fabbfbcd27f73d50bbebe3fba37fe419284f4811389c30bdc\",\"quote\":\"may\",\"start\":13459},{\"end\":13475,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:13045:13475:sha256-87d83c3af0c8cfdfbed1033c13922b321ac87692a9c076f3a28e8b6bc5e2f120\",\"quote\":\"Sec. 2. Providing Emergency Learning Scholarships for Students. The Secretary of Health and Human Services shall take steps, consistent with law, to allow funds available through the Community Services Block Grant program to be used by grantees and eligible entities to provide emergency learning scholarships to disadvantaged families for use by any child without access to in-person learning. These scholarships may be used for:\",\"start\":13045}],\"id\":\"urn:rulespec:document-understanding:revision:adffa6df679430670defcf55a5f583426103cc5ed35c82f12af91e29e8bda599\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"permission\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:0142a0eed5657d54068ce028c85145cdec772f21e7a07e60b73083dd32ebd5e7\",\"modality\":\"may\",\"modality_quote\":\"may\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:7c6e73b31d54271a96fdecbf9c331a500b055721def69c1b36c298324121a3df\",\"origin\":\"aiSuggested\",\"quote\":\"Sec. 2. Providing Emergency Learning Scholarships for Students. The Secretary of Health and Human Services shall take steps, consistent with law, to allow funds available through the Community Services Block Grant program to be used by grantees and eligible entities to provide emergency learning scholarships to disadvantaged families for use by any child without access to in-person learning. These scholarships may be used for:\\n\\n(i) tuition and fees for a private or parochial school;\\n\\n(ii) homeschool, microschool, or learning-pod costs;\\n\\n(iii) special education and related services, including therapies; or\\n\\n(iv) tutoring or remedial education.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:8af32e7fdcd46cdf2ba179e1a0c06843327ad07fde9e8c32aeb24c33379c83cb\",\"scope_quotes\":[\"Sec. 2. Providing Emergency Learning Scholarships for Students. The Secretary of Health and Human Services shall take steps, consistent with law, to allow funds available through the Community Services Block Grant program to be used by grantees and eligible entities to provide emergency learning scholarships to disadvantaged families for use by any child without access to in-person learning. These scholarships may be used for:\"],\"scope_text\":\"for emergency learning scholarships provided to disadvantaged families for use by any child without access to in-person learning\",\"section_id\":\"urn:rulespec:document-understanding:section:7323930aa170deb28e8e4c58b97489268b7a6a77f0c9e944a4a0c1a4cb2ef66d\",\"start\":13045,\"summary\":\"Emergency learning scholarships provided to disadvantaged families for use by any child without access to in-person learning may be used for: (i) tuition and fees for a private or parochial school; (ii) homeschool, microschool, or learning-pod costs; (iii) special education and related services, including therapies; or (iv) tutoring or remedial education.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

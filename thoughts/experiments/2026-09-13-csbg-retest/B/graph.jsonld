    {
      "@id": "urn:rulespec:document-understanding:assertion:03cf3383f73d31ee4bfa49cae932e9513f346a4f6390e49be2541da73021a873",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:4b80bc242bf4108132092097a8f5b641e6a56bd640c5f048e8bbcbf82862ca04",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:11bef7aa57c32d28c2b4f2f7c802a05c477966f9f18dba0ae2791f70aed66cf3",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:6e2a371995f6471cea7420eb4cdde06183c1823243df073d070c95e9756deb1c",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:states-requirement",
      "rkaf:assertsValue": {
        "@value": "If the State determines, on the basis of a final decision in a review pursuant to section 9914 of this title, that an eligible entity fails to comply with the terms of an agreement, or the State plan, to provide services under this chapter or to meet appropriate standards, goals, and other requirements established by the State (including performance objectives), the State shall offer training and technical assistance, if appropriate, to help correct the deficiency, and prepare and submit to the Secretary a report describing the training and technical assistance offered (unless it determines such assistance is not appropriate and reports its reasons).",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },
    {

      ]
    },
    {
      "@id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:41609:43461:sha256-14a2d3fdfb56703f460a0214b7db6539032eb644e6ec8e724e46867b59e82454",
      "@type": "rkaf:SourceFragment",
      "oa:hasSource": "urn:rulespec:document-understanding:document:26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023",
      "rkaf:fragmentIdentityScheme": "rkaf:carrier-local-fragment",
      "rkaf:sourceArtifactDigest": "sha256:26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023",
      "rkaf:fragmentContentDigest": "sha256:14a2d3fdfb56703f460a0214b7db6539032eb644e6ec8e724e46867b59e82454",
      "rkaf:selectorKind": [
        "oa:TextQuoteSelector",
        "oa:TextPositionSelector"
      ],
      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "(A) a description of the service delivery system, for services provided or coordinated with funds made available through grants made under section 9907(a) of this title, targeted to low-income individuals and families in communities within the State;\n\n(B) a description of how linkages will be developed to fill identified gaps in the services, through the provision of information, referrals, case management, and followup consultations;\n\n(C) a description of how funds made available through grants made under section 9907(a) of this title will be coordinated with other public and private resources; and\n\n(D) a description of how the local entity will use the funds to support innovative community and neighborhood-based initiatives related to the purposes of this chapter, which may include fatherhood initiatives and other initiatives with the goal of strengthening families and encouraging effective parenting;\n\n\n(4) an assurance that eligible entities in the State will provide, on an emergency basis, for the provision of such supplies and services, nutritious foods, and related services, as may be necessary to counteract conditions of starvation and malnutrition among low-income individuals;\n\n(5) an assurance that the State and the eligible entities in the State will coordinate, and establish linkages between, governmental and other social services programs to assure the effective delivery of such services to low-income individuals and to avoid duplication of such services, and a description of how the State and the eligible entities will coordinate the provision of employment and training activities, as defined in section 3 of the Workforce Innovation and Opportunity Act [29 U.S.C. 3102], in the State and in communities with entities providing activities through statewide and local workforce development systems under such Act;"
        },
        {
          "@type": "oa:TextPositionSelector",
          "oa:start": 41609,
          "oa:end": 43461,
          "rkaf:coordinateSystem": "rkaf:unicode-codepoint"
        }
      ]
    },
    {
      "@id": "urn:rulespec:document-understanding:assertion:68384476ace9dfa5097c21e6b1ec0d584f65fd312a711a11a5d80eb5e0bec9da",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:4b80bc242bf4108132092097a8f5b641e6a56bd640c5f048e8bbcbf82862ca04",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:3d5314ddf0c5e8d85fc2ad1f82947fc8923794f629e4490f8a1e58bdaf444e17",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:cff60be81ce2cdd4e193dd5466a4ad8e8d9a7e9856e25ff5e4872ef02a4efdcc",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:states-requirement",
      "rkaf:assertsValue": {
        "@value": "Beginning with fiscal year 2000, the State's application and plan submitted to be eligible for a grant or allotment under section 9905 or 9906 of this title must contain an assurance that the State and eligible entities in the State will coordinate and establish linkages between governmental and other social services programs to assure effective delivery and avoid duplication, and a description of how the State and eligible entities will coordinate the provision of employment and training activities (as defined in section 3 of the Workforce Innovation and Opportunity Act) in the State and communities with entities providing activities through statewide and local workforce development systems under that Act.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

      "rkaf:assertsValue": {
        "@value": "Emergency learning scholarships provided to disadvantaged families for use by any child without access to in-person learning may be used for: (i) tuition and fees for a private or parochial school; (ii) homeschool, microschool, or learning-pod costs; (iii) special education and related services, including therapies; or (iv) tutoring or remedial education.",
        "@language": "en"
      },

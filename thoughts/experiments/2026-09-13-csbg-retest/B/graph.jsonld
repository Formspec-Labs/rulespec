      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "At the end of each fiscal year beginning after September 30, 1999, the Secretary shall, directly or by grant or contract, prepare a report containing—"
        },
        {
          "@type": "oa:TextPositionSelector",
          "oa:start": 77677,
          "oa:end": 77827,
          "rkaf:coordinateSystem": "rkaf:unicode-codepoint"

      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "In redistributing funds recaptured in accordance with this paragraph, States shall redistribute such funds to an eligible entity, or require the original recipient of the funds to redistribute the funds to a private, nonprofit organization, located within the community served by the original recipient of the funds, for activities consistent with the purposes of this chapter."
        },

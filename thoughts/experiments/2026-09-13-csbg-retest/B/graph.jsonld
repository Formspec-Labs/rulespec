          "@id": "urn:rulespec:document-understanding:assertion:704093e467392bf2844d4d733a6b49c31b3fb5da7408c068ea5e12c9d88a3b82"
        },
        {
          "@id": "urn:rulespec:document-understanding:assertion:6ad5ad234ee13c668defe9954adf606956dec503e9fc01f4564e2b1dc8abbf8d"
        }
      ]
    },
    {
      "@id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:41609:44496:sha256-ef55b3af55a64b8031137a140ce5cbba9c7bcc5c664bb02b7afb67a0b2146381",
      "@type": "rkaf:SourceFragment",
      "oa:hasSource": "urn:rulespec:document-understanding:document:26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023",
      "rkaf:fragmentIdentityScheme": "rkaf:carrier-local-fragment",
      "rkaf:sourceArtifactDigest": "sha256:26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023",
      "rkaf:fragmentContentDigest": "sha256:ef55b3af55a64b8031137a140ce5cbba9c7bcc5c664bb02b7afb67a0b2146381",
      "rkaf:selectorKind": [
        "oa:TextQuoteSelector",
        "oa:TextPositionSelector"
      ],
      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "(A) a description of the service delivery system, for services provided or coordinated with funds made available through grants made under section 9907(a) of this title, targeted to low-income individuals and families in communities within the State;\n\n(B) a description of how linkages will be developed to fill identified gaps in the services, through the provision of information, referrals, case management, and followup consultations;\n\n(C) a description of how funds made available through grants made under section 9907(a) of this title will be coordinated with other public and private resources; and\n\n(D) a description of how the local entity will use the funds to support innovative community and neighborhood-based initiatives related to the purposes of this chapter, which may include fatherhood initiatives and other initiatives with the goal of strengthening families and encouraging effective parenting;\n\n\n(4) an assurance that eligible entities in the State will provide, on an emergency basis, for the provision of such supplies and services, nutritious foods, and related services, as may be necessary to counteract conditions of starvation and malnutrition among low-income individuals;\n\n(5) an assurance that the State and the eligible entities in the State will coordinate, and establish linkages between, governmental and other social services programs to assure the effective delivery of such services to low-income individuals and to avoid duplication of such services, and a description of how the State and the eligible entities will coordinate the provision of employment and training activities, as defined in section 3 of the Workforce Innovation and Opportunity Act [29 U.S.C. 3102], in the State and in communities with entities providing activities through statewide and local workforce development systems under such Act;\n\n(6) an assurance that the State will ensure coordination between antipoverty programs in each community in the State, and ensure, where appropriate, that emergency energy crisis intervention programs under title XXVI [42 U.S.C. 8621 et seq.] (relating to low-income home energy assistance) are conducted in such community;\n\n(7) an assurance that the State will permit and cooperate with Federal investigations undertaken in accordance with section 9916 of this title;\n\n(8) an assurance that any eligible entity in the State that received funding in the previous fiscal year through a community services block grant made under this chapter will not have its funding terminated under this chapter, or reduced below the proportional share of funding the entity received in the previous fiscal year unless, after providing notice and an opportunity for a hearing on the record, the State determines that cause exists for such termination or such reduction, subject to review by the Secretary as provided in section 9915(b) of this title;"
        },
        {
          "@type": "oa:TextPositionSelector",
          "oa:start": 41609,
          "oa:end": 44496,
          "rkaf:coordinateSystem": "rkaf:unicode-codepoint"
        }
      ]
    },
    {
      "@id": "urn:rulespec:document-understanding:assertion:4941136306b62e50652392484d26a3f16472ac0edfcb9a774811080e86514995",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:4b80bc242bf4108132092097a8f5b641e6a56bd640c5f048e8bbcbf82862ca04",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:3d5314ddf0c5e8d85fc2ad1f82947fc8923794f629e4490f8a1e58bdaf444e17",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:9fd33b173fd9d180118962f85ca6df6e3068ad3e0d5c82bc2147785cac386075",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:states-requirement",
      "rkaf:assertsValue": {
        "@value": "Beginning with fiscal year 2000, the State's application and plan submitted to be eligible for a grant or allotment under section 9905 or 9906 of this title must contain an assurance that any eligible entity in the State that received funding in the previous fiscal year through a community services block grant made under this chapter will not have its funding terminated under this chapter, or reduced below the proportional share of funding it received in the previous fiscal year unless, after providing notice and an opportunity for a hearing on the record, the State determines that cause exists for such termination or reduction, subject to review by the Secretary as provided in section 9915(b) of this title.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },
    {
      "@id": "urn:rulespec:document-understanding:binding:0856d5488205212190a4875cb563aa883266b54c8a5393ed76a1986b7dcd4357",

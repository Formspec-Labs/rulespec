      "rkaf:hasContentDigest": "sha256:ecd2da01e67b858b8a15191a64af5e89b8b1731927970ac0af63d503349dde45",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"the State\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:b6aa4c63db36aa2ee3e7bffdb09940a467c0270432452edbbe9d1025c9b213fd\",\"urn:rulespec:document-understanding:assertion:9ac2f45bae7c6363b93794733e6f25c6865cfd38a9e9eeb627e4243872ff4086\",\"urn:rulespec:document-understanding:assertion:ac794177af21a8167511fdd646e6605675c8518d0549b95fd23e39b937fba36d\",\"urn:rulespec:document-understanding:assertion:30644bf804b7b3a0b868abcd14af507c036a029010a54ae070481a6a7c5ff7ac\",\"urn:rulespec:document-understanding:assertion:97e7511cf565d874f674e9eba006b123ea76fd14e6c6fd2e391cd96d5f9d7172\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":70012,\"evidence\":[{\"end\":70012,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:69783:70012:sha256-e181b894a7b28bc61ebc680b8bb7023f33f9bf5c195a1d6fe02654ccb36646d6\",\"quote\":\"(5) after providing adequate notice and an opportunity for a hearing, initiate proceedings to terminate the designation of or reduce the funding under this chapter of the eligible entity unless the entity corrects the deficiency.\",\"start\":69783},{\"end\":68283,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:68266:68283:sha256-fef9c1804c1c46956067d6581df93df72444872647b70b72bb3e6af066606522\",\"quote\":\"(a) Determination\",\"start\":68266},{\"end\":68665,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:68284:68665:sha256-2bd94d684e3542cfb70726d612ccd37955e615f0fc0c805729f83b029a200513\",\"quote\":\"If the State determines, on the basis of a final decision in a review pursuant to section 9914 of this title, that an eligible entity fails to comply with the terms of an agreement, or the State plan, to provide services under this chapter or to meet appropriate standards, goals, and other requirements established by the State (including performance objectives), the State shall—\",\"start\":68284}],\"id\":\"urn:rulespec:document-understanding:revision:c69cdb7c2366b2fd5d7365a75b8b53d3c8737386b65f9b9b92d4dd729ee89f09\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:97e7511cf565d874f674e9eba006b123ea76fd14e6c6fd2e391cd96d5f9d7172\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:6bac5966532d06ab183b5e9351cdb8c74329bf14dd15b376a22d4c087ccf8a3a\",\"origin\":\"aiSuggested\",\"quote\":\"(5) after providing adequate notice and an opportunity for a hearing, initiate proceedings to terminate the designation of or reduce the funding under this chapter of the eligible entity unless the entity corrects the deficiency.\",\"references\":[\"section 9914 of this title\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:9636e4128e95619faf675355d212fe9bd9204d9ea5a2ebfef23dd9a0f3c9f2c3\",\"scope_quotes\":[\"(a) Determination If the State determines, on the basis of a final decision in a review pursuant to section 9914 of this title, that an eligible entity fails to comply with the terms of an agreement, or the State plan, to provide services under this chapter or to meet appropriate standards, goals, and other requirements established by the State (including performance objectives), the State shall—\"],\"scope_text\":\"If the State determines, on the basis of a final decision in a review pursuant to section 9914 of this title, that an eligible entity fails to comply with the terms of an agreement, or the State plan, to provide services under this chapter or to meet appropriate standards, goals, and other requirements established by the State (including performance objectives)\",\"section_id\":\"urn:rulespec:document-understanding:section:237b538fca368735fd9d07469584e65428d74fd94b694e39006074ead5c84559\",\"start\":69783,\"summary\":\"If the State determines, on the basis of a final decision in a review pursuant to section 9914 of this title, that an eligible entity fails to comply with the terms of an agreement, or the State plan, to provide services under this chapter or to meet appropriate standards, goals, and other requirements established by the State (including performance objectives), the State shall, after providing adequate notice and an opportunity for a hearing, initiate proceedings to terminate the designation of or reduce the funding under this chapter of the eligible entity unless the entity corrects the deficiency.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

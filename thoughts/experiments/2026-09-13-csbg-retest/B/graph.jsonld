      "dcterms:description": "{\"action\":\"\",\"actor\":\"the State\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:03f851d3a08614ede6df32ee686a0fcc62f75e271c9d60a6ac79f4440aa9faa5\",\"urn:rulespec:document-understanding:assertion:2e839471ab2fe0a9bce2d145054557643815a914201f6575c8083082129e34a3\",\"urn:rulespec:document-understanding:assertion:9b8d8797a10e30bf25a1486c646d4301d1ceeeed48729f687dc497e61d73007d\",\"urn:rulespec:document-understanding:assertion:ced09f15dedc060b1a0863f63cac246096f573a0092fcf718058c5a22a253cc2\",\"urn:rulespec:document-understanding:assertion:d0a8f50c50c47ce2e87073fa58411b7e0856984a2c382b9040f8fc057b779375\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":67833,\"evidence\":[{\"end\":67833,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:66787:67833:sha256-6029fefdb7fae5c5b046e858a6ecbf3e689c9da8af5615d345e4ffce339968de\",\"quote\":\"The Secretary shall conduct in several States in each fiscal year evaluations (including investigations) of the use of funds received by the States under this chapter in order to evaluate compliance with the provisions of this chapter, and especially with respect to compliance with section 9908(b) of this title. The Secretary shall submit, to each State evaluated, a report containing the results of such evaluations, and recommendations of improvements designed to enhance the benefit and impact of the activities carried out with such funds for people in need. On receiving the report, the State shall submit to the Secretary a plan of action in response to the recommendations contained in the report. The results of the evaluations shall be submitted annually to the Chairperson of the Committee on Education and the Workforce of the House of Representatives and the Chairperson of the Committee on Labor and Human Resources of the Senate as part of the report submitted by the Secretary in accordance with section 9917(b)(2) of this title.\",\"start\":66787},{\"end\":67833,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:66787:67833:sha256-6029fefdb7fae5c5b046e858a6ecbf3e689c9da8af5615d345e4ffce339968de\",\"quote\":\"The Secretary shall conduct in several States in each fiscal year evaluations (including investigations) of the use of funds received by the States under this chapter in order to evaluate compliance with the provisions of this chapter, and especially with respect to compliance with section 9908(b) of this title. The Secretary shall submit, to each State evaluated, a report containing the results of such evaluations, and recommendations of improvements designed to enhance the benefit and impact of the activities carried out with such funds for people in need. On receiving the report, the State shall submit to the Secretary a plan of action in response to the recommendations contained in the report. The results of the evaluations shall be submitted annually to the Chairperson of the Committee on Education and the Workforce of the House of Representatives and the Chairperson of the Committee on Labor and Human Resources of the Senate as part of the report submitted by the Secretary in accordance with section 9917(b)(2) of this title.\",\"start\":66787}],\"id\":\"urn:rulespec:document-understanding:revision:9945b368e0b4b51986b6b8fffa0dbc389c60d19dd83d22f4a4fd65de157f73e8\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:d0a8f50c50c47ce2e87073fa58411b7e0856984a2c382b9040f8fc057b779375\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:7ef9f9dcae904a726d50518358d92ff7028655fe01b2ffb71327b4706fe7b44d\",\"origin\":\"aiSuggested\",\"quote\":\"The Secretary shall conduct in several States in each fiscal year evaluations (including investigations) of the use of funds received by the States under this chapter in order to evaluate compliance with the provisions of this chapter, and especially with respect to compliance with section 9908(b) of this title. The Secretary shall submit, to each State evaluated, a report containing the results of such evaluations, and recommendations of improvements designed to enhance the benefit and impact of the activities carried out with such funds for people in need. On receiving the report, the State shall submit to the Secretary a plan of action in response to the recommendations contained in the report. The results of the evaluations shall be submitted annually to the Chairperson of the Committee on Education and the Workforce of the House of Representatives and the Chairperson of the Committee on Labor and Human Resources of the Senate as part of the report submitted by the Secretary in accordance with section 9917(b)(2) of this title.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:aee02e68b458d493f6a243949f45597169056261608ae6740c049b9191e839f0\",\"scope_quotes\":[\"The Secretary shall conduct in several States in each fiscal year evaluations (including investigations) of the use of funds received by the States under this chapter in order to evaluate compliance with the provisions of this chapter, and especially with respect to compliance with section 9908(b) of this title. The Secretary shall submit, to each State evaluated, a report containing the results of such evaluations, and recommendations of improvements designed to enhance the benefit and impact of the activities carried out with such funds for people in need. On receiving the report, the State shall submit to the Secretary a plan of action in response to the recommendations contained in the report. The results of the evaluations shall be submitted annually to the Chairperson of the Committee on Education and the Workforce of the House of Representatives and the Chairperson of the Committee on Labor and Human Resources of the Senate as part of the report submitted by the Secretary in accordance with section 9917(b)(2) of this title.\"],\"scope_text\":\"On receiving the report\",\"section_id\":\"urn:rulespec:document-understanding:section:c0349af1123d989776fe253553df69642696cd32996dd791c280bdbf3d513641\",\"start\":66787,\"summary\":\"On receiving the report, the State shall submit to the Secretary a plan of action in response to the recommendations contained in the report.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

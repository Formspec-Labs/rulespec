      "dcterms:description": "{\"action\":\"\",\"actor\":\"the Secretary\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:b22d1a70e73d1b801d1908a11031eef1c3fe59c15e8eceb4baea7ccf9ad66ed0\",\"urn:rulespec:document-understanding:assertion:57f0fe563b814ba27c118f1ebd7a577e0a4d106f4e785f4d6caa08e102716b3c\",\"urn:rulespec:document-understanding:assertion:9c6616bea15b76f3a93d10de528d90e01d73ccb21310b2435cde60f6fa9a2bbc\",\"urn:rulespec:document-understanding:assertion:ebfb6353435f0aa6f381c7c2e6b862c2003a0da631a507e2e67b43eb103239c0\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":60715,\"evidence\":[{\"end\":60715,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:60438:60715:sha256-0b6a70853ea0eadd7184bf5f9e0c49c71c4ae985227c410c0f41a3824e43128c\",\"quote\":\"In order for an Indian tribe or tribal organization to be eligible for a grant award for a fiscal year under this section, the tribe or organization shall submit to the Secretary a plan for such fiscal year that meets such criteria as the Secretary may prescribe by regulation.\",\"start\":60438},{\"end\":60690,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:60687:60690:sha256-ee4d988c65de860fabbfbcd27f73d50bbebe3fba37fe419284f4811389c30bdc\",\"quote\":\"may\",\"start\":60687}],\"id\":\"urn:rulespec:document-understanding:revision:8594830643d94050f9b0c1b8889f3787eac1b132430bbbbbd410b164e17a072b\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"permission\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:ebfb6353435f0aa6f381c7c2e6b862c2003a0da63
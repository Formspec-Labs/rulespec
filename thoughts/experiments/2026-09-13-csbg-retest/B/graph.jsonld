    {
      "@id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:59685:60173:sha256-901ae373cc0d25378bf40d01144f50b2197f94ce920d6a9871717f03bd480a31",

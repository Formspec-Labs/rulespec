      "dcterms:description": "{\"action\":\"\",\"actor\":\"Each jurisdiction to which subsection (a) applies\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:87ba17e440fc0dd95af434e12b1f5e51e989142d0eb90859372fc65babe7301f\",\"urn:rulespec:document-understanding:assertion:30eeef48ae8e4da1030ab45157afdb0f9695ce33c0f0b485a7f6e5a3c10da015\",\"urn:rulespec:document-understanding:assertion:310df9f6e50c6c1e951a93b8f6dce679afcb720d4eb51991b81f7d1ba6830fe9\",\"urn:rulespec:document-understanding:assertion:3ac09234722761e6c71bcdcacd9fd17abc7398559686ce8aeace835d2897163b\",\"urn:rulespec:document-understanding:assertion:161486ec63885b3d3511cc7b6c5a71ae1293d719896c5c53ab10b09947abc051\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":21229,\"evidence\":[{\"end\":21229,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:20810:21229:sha256-00851f9b573430b2dc13e68c24328aca9ef4ffb66ecad52c0ba109cfa48ff41a\",\"quote\":\"Each jurisdiction to which subsection (a) applies may receive a grant under this section for the amount apportioned under subsection (a) on submitting to the Secretary, and obtaining approval of, an application, containing provisions that describe the programs for which assistance is sought under this section, that is prepared in accordance with, and contains the information described in, section 9908 of this title.\",\"start\":20810},{\"end\":20859,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:20810:20859:sha256-bef06dced2bc974f931b967b69aa093ecf399427dbfedf098eb40ad35708d256\",\"quote\":\"Each jurisdiction to which subsection (a) applies\",\"start\":20810},{\"end\":20863,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:20860:20863:sha256-ee4d988c65de860fabbfbcd27f73d50bbebe3fba37fe419284f4811389c30bdc\",\"quote\":\"may\",\"start\":20860},{\"end\":21229,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:20810:21229:sha256-00851f9b573430b2dc13e68c24328aca9ef4ffb66ecad52c0ba109cfa48ff41a\",\"quote\":\"Each jurisdiction to which subsection (a) applies may receive a grant under this section for the amount apportioned under subsection (a) on submitting to the Secretary, and obtaining approval of, an application, containing provisions that describe the programs for which assistance is sought under this section, that is prepared in accordance with, and contains the information described in, section 9908 of this title.\",\"start\":20810}],\"id\":\"urn:rulespec:document-understanding:revision:ccfc872ad346563ab48fd0d66ed262e276c9ed663257c3acbd1e720fc3652569\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"permission\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:161486ec63885b3d3511cc7b6c5a71ae1293d719896c5c53ab10b09947abc051\",\"modality\":\"may\",\"modality_quote\":\"may\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:2ba5245857f48d5775cda1de6640350326e5a285dd8732f0b37b4c42fbb0924c\",\"origin\":\"aiSuggested\",\"quote\":\"Each jurisdiction to which subsection (a) applies may receive a grant under this section for the amount apportioned under subsection (a) on submitting to the Secretary, and obtaining approval of, an application, containing provisions that describe the programs for which assistance is sought under this section, that is prepared in accordance with, and co
    {
      "@id": "urn:rulespec:document-understanding:assertion:dbff370a04a72223fee12a7ad45b7850cfc69be1a0d31018c51c855e722aa6fb",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:4b80bc242bf4108132092097a8f5b641e6a56bd640c5f048e8bbcbf82862ca04",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:11bef7aa57c32d28c2b4f2f7c802a05c477966f9f18dba0ae2791f70aed66cf3",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:ece13c33ffff1319cb79b4f28ddd0d0cec703f49b97afa1e093e19f95f571f1a",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:states-permission",
      "rkaf:assertsValue": {
        "@value": "If the State determines, on the basis of a final decision in a review pursuant to section 9914 of this title, that an eligible entity fails to comply with the terms of an agreement, or the State plan, to provide services under this chapter or to meet appropriate standards, goals, and other requirements established by the State (including performance objectives), the State has discretion, taking into account the seriousness of the deficiency and the time reasonably required to correct the deficiency, to allow the entity to develop and implement, within 60 days after being informed of the deficiency, a quality improvement plan to correct such deficiency within a reasonable period of time, as determined by the State.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

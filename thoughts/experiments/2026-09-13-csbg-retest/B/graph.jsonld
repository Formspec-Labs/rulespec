    {
      "@id": "urn:rulespec:document-understanding:assertion:3c3273d750502cb49168d07a16fbaa0650824c62ff20c241352ff2933bd7107c",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:4b80bc242bf4108132092097a8f5b641e6a56bd640c5f048e8bbcbf82862ca04",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:3d5314ddf0c5e8d85fc2ad1f82947fc8923794f629e4490f8a1e58bdaf444e17",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:050296464021f35b00d7c957dc3a4a88350b4e6cc44d5e1b6f4549a9bbe5e419",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"actor\":\"a State\",\"kind\":\"requirement\",\"modality\":\"must\",\"scope_text\":\"Beginning with fiscal year 2000, to be eligible to receive a grant or allotment under section 9905 or 9906 of this title\",\"summary\":\"Beginning with fiscal year 2000, the State's application and plan submitted to be eligible for a grant or allotment under section 9905 or 9906 of this title must contain an assurance that funds made available through the grant or allotment will be used to support activities designed to assist low-income families and individuals (including families and individuals receiving assistance under part A of title IV of the Social Security Act, homeless families and individuals, migrant or seasonal farmworkers, and elderly low-income individuals and families), and a description of how such activities will enable families and individuals: (i) to remove obstacles and solve problems blocking self-sufficiency (including for those transitioning off part A of title IV assistance); (ii) to secure and retain meaningful employment; (iii) to attain an adequate education, with particular attention toward improving literacy skills in the communities involved (which may include family literacy initiatives); (iv) to make better use of available income; (v) to obtain and maintain adequate housing and a suitable living environment; (vi) to obtain emergency assistance through loans, grants, or other means for immediate and urgent needs; and (vii) to achieve greater community participation, including grassroots partnerships with local law enforcement, housing authorities, private foundations, and other partners to document best practices for urban replication and strengthen relationships with local law enforcement (which may include neighborhood or community policing efforts).\"}",
        "@type": "xsd:string"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed",
      "rkaf:hasApplicability": "urn:rulespec:document-understanding:scope:dd7c1818b57327538a957baed6ff52091d9f9e712a6eb96149c9cc05d67144bc"
    },

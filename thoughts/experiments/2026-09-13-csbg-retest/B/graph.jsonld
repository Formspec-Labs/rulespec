      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:15102a477d92fb68a1bb4e3532d2c09b70fa91296cfd3b348b5b2e40549b6a03\",\"urn:rulespec:document-understanding:assertion:c85a4a3fd412f2b1c8c5d82405f1dd09926e0d753fdc8aa2791c08059fa9c81c\",\"urn:rulespec:document-understanding:assertion:309bf2e4b25fac95dc7cec685b6689bce10571af086dab9c2ded408d37fd198d\",\"urn:rulespec:document-understanding:assertion:94e160811c2fe7e615143791cdc74fda70bf85ddbc349a5a7a8e613876e45529\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":18271,\"evidence\":[{\"end\":18271,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:17971:18271:sha256-8f40cc397888479db650cbd2df25c31442c7cdbe2b7eeeeb52c561cc26b80ac7\",\"quote\":\"(A) not less than ½ of the amount reserved by the Secretary under this paragraph shall be distributed directly to eligible entities, organizations, or associations described in section 9913(c)(2) of this title for the purpose of carrying out activities described in section 9913(c) of this title; and\",\"start\":17971},{\"end\":18072,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:18052:18072:sha256-d46d6528c86a27948f3c8bbee5121c50662cd0a78dea5d756d00298e10a58936\",\"quote\":\"shall be distributed\",\"start\":18052},{\"end\":17668,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:17652:17668:sha256-74fda605329d9b1ceb4fc23f202c17e0235b89f64f355a31862ab1a252852db2\",\"quote\":\"(b) Reservations\",\"start\":17652},{\"end\":17768,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:17669:17768:sha256-52e40889c206e95327235a9da3d28d4bc66f4b76274d478cbed27729f4c0dbe7\",\"quote\":\"Of the amounts appropriated under subsection (a) for each fiscal year, the Secretary shall reserve—\",\"start\":17669},{\"end\":17969,\"field\":\"scope_text:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:17874:17969:sha256-f6a1bacd7ebe59bc871f6b1fdffd4ac3332e0b231c37822c5e67c2a01c271213\",\"quote\":\"(2) 1½ percent for activities authorized in sections 9913 through 9918 of this title, of which—\",\"start\":17874}],\"id\":\"urn:rulespec:document-understanding:revision:a28fd2d15603a620c8db0f05ab18d7b9c2e0b23c2c3787edd2dcd9d57af068c3\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:94e160811c2fe7e615143791cdc74fda70bf85ddbc349a5a7a8e613876e45529\",\"modality\":\"must\",\"modality_quote\":\"shall be distributed\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:3d32466cb96c60b743999e016e8ed8ccd5b6d3c3dc71c68c8e4d5469b9c4d3f5\",\"origin\":\"aiSuggested\",\"quote\":\"(A) not less than ½ of the amount reserved by the Secretary under this paragraph shall be distributed directly to eligible entities, organizations, or associations described in section 9913(c)(2) of this title for the purpose of carrying out activities described in section 9913(c) of this title; and\",\"references\":[\"section 9913(c)(2) of this title\",\"section 9913(c) of this title\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:6fa2fb277ec3f1dd608751a43df8f12ccec2112571902d10688d559b7ae14eb7\",\"scope_quotes\":[\"(b) Reservations Of the amounts appropriated under subsection (a) for each fiscal year, the Secretary shall reserve—\",\"(2) 1½ percent for activities authorized in sections 9913 through 9918 of this title, of which—\"],\"scope_text\":\"Of the amounts appropriated under subsection (a) for each fiscal year, of the 1½ percent reserved under paragraph (2)\",\"section_id\":\"urn:rulespec:document-understanding:section:12fca79c614e56d4c2834f93ce1a7d98eff6aeadfd069e9f4c6aeffa5285544c\",\"start\":17971,\"summary\":\"Of the 1 1/2 percent reserved by the Secretary under 42 U.S.C. 9903(b)(2) from amounts appropriated under subsection (a) for each fiscal year, not less than 1/2 of that reserved amount shall be distributed directly to eligible entities, organizations, or associations described in section 9913(c)(2) of this title for the purpose of carrying out activities described in section 9913(c) of this title.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

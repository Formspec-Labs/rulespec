      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:4b80bc242bf4108132092097a8f5b641e6a56bd640c5f048e8bbcbf82862ca04",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:bc313875f8641fa1e56f9241762379751a49fc4be4a4a417a8121b0bdf8258f7",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:2e1f1b4211d2f879e2aaeb3f7a286c15012a4507d8e6cbf6a7d9940482b07fd4",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:states-requirement",
      "rkaf:assertsValue": {
        "@value": "Grants under 42 U.S.C. 9925(c) may be made only with respect to applications that identify and describe the population to be served, the problems to be addressed, the overall approach and methods of outreach and recruitment to be used, and the services to be provided; describe how the approach to be used differs from other approaches used for the population to be served by the project; describe the objectives of the project and contain a plan for measuring progress toward meeting those objectives; and contain assurances that the grantee will report on the progress and results of the demonstration at such times and in such manner as the Secretary shall require.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

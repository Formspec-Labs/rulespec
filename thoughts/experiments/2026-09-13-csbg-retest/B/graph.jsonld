      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "(A) to alter its form of internal governance, except (for purposes of administration of the community services block grant program) as provided in section 9910 of this title; or\n\n(B) to remove religious art, icons, scripture, or other symbols;\n\n\nin order to be eligible to provide assistance under a program described in subsection (a)."
        },

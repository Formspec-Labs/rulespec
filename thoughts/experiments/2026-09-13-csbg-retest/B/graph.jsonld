    {
      "@id": "urn:rulespec:document-understanding:revision:3acbc81ec64089f98dbfbccf4ff158ba2dc3ab12e72e959b1ad0117d65624e6c",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:3acbc81ec64089f98dbfbccf4ff158ba2dc3ab12e72e959b1ad0117d65624e6c",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:aa8e5210f7fc1cc9666d11962c70fb37cbfb73826eb67aca47d032521f4fabd3",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"grantees\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:fde9a111ac9f1b05d920c693d447a72b037c069d8e238dafae3f5d38a404179a\",\"urn:rulespec:document-understanding:assertion:0cb951718e5303f8f7adb02c5fa9eac26a14d5e50ee2c99b4cf88f1e274e3d41\",\"urn:rulespec:document-understanding:assertion:cdbb6558ee6117ddc1c5beb30dc57bff3273f9dd8b8e3d71294dee775aa4e320\",\"urn:rulespec:document-understanding:assertion:1bf195cda22e6e4c9e562ff9b3ebafadc02e44e1bd3351f8fe74e5d4cc1ab5de\",\"urn:rulespec:document-understanding:assertion:39b0b7a607685c9e06fdab64de8e2ffee2b05cd47860221e365eaf5846027956\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":96963,\"evidence\":[{\"end\":96963,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:95995:96963:sha256-217579195f09dded46d5fe486ff35bb87cd4f873f27592d75dfa76116affea8d\",\"quote\":\"Pub. L. 119–75, div. B, title II, Feb. 3, 2026, 140 Stat. 277, provided in part: “That the Secretary [of Health and Human Services] shall establish procedures regarding the disposition of intangible assets and program income that permit such assets acquired with, and program income derived from, grant funds authorized under section 680 of the CSBG Act [Community Services Block Grant Act, 42 U.S.C. 9921] to become the sole property of such grantees after a period of not more than 12 years after the end of the grant period for any activity consistent with section 680(a)(2)(A) of the CSBG Act [42 U.S.C. 9921(a)(2)(A)]: Provided further, That intangible assets in the form of loans, equity investments and other debt instruments, and program income may be used by grantees for any eligible purpose consistent with section 680(a)(2)(A) of the CSBG Act: Provided further, That these procedures shall apply to such grant funds made available after November 29, 1999”.\",\"start\":95995},{\"end\":96751,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:96748:96751:sha256-ee4d988c65de860fabbfbcd27f73d50bbebe3fba37fe419284f4811389c30bdc\",\"quote\":\"may\",\"start\":96748},{\"end\":96963,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:95995:96963:sha256-217579195f09dded46d5fe486ff35bb87cd4f873f27592d75dfa76116affea8d\",\"quote\":\"Pub. L. 119–75, div. B, title II, Feb. 3, 2026, 140 Stat. 277, provided in part: “That the Secretary [of Health and Human Services] shall establish procedures regarding the disposition of intangible assets and program income that permit such assets acquired with, and program income derived from, grant funds authorized under section 680 of the CSBG Act [Community Services Block Grant Act, 42 U.S.C. 9921] to become the sole property of such grantees after a period of not more than 12 years after the end of the grant period for any activity consistent with section 680(a)(2)(A) of the CSBG Act [42 U.S.C. 9921(a)(2)(A)]: Provided further, That intangible assets in the form of loans, equity investments and other debt instruments, and program income may be used by grantees for any eligible purpose consistent with section 680(a)(2)(A) of the CSBG Act: Provided further, That these procedures shall apply to such grant funds made available after November 29, 1999”.\",\"start\":95995}],\"id\":\"urn:rulespec:document-understanding:revision:3acbc81ec64089f98dbfbccf4ff158ba2dc3ab12e72e959b1ad0117d65624e6c\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"permission\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:39b0b7a607685c9e06fdab64de8e2ffee2b05cd47860221e365eaf5846027956\",\"modality\":\"may\",\"modality_quote\":\"may\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:915dd365c2b06d00e5ea497591d1d1da0411f40e32523d161bc9e3086eaa24e9\",\"origin\":\"aiSuggested\",\"quote\":\"Pub. L. 119–75, div. B, title II, Feb. 3, 2026, 140 Stat. 277, provided in part: “That the Secretary [of Health and Human Services] shall establish procedures regarding the disposition of intangible assets and program income that permit such assets acquired with, and program income derived from, grant funds authorized under section 680 of the CSBG Act [Community Services Block Grant Act, 42 U.S.C. 9921] to become the sole property of such grantees after a period of not more than 12 years after the end of the grant period for any activity consistent with section 680(a)(2)(A) of the CSBG Act [42 U.S.C. 9921(a)(2)(A)]: Provided further, That intangible assets in the form of loans, equity investments and other debt instruments, and program income may be used by grantees for any eligible purpose consistent with section 680(a)(2)(A) of the CSBG Act: Provided further, That these procedures shall apply to such grant funds made available after November 29, 1999”.\",\"references\":[\"section 680(a)(2)(A) of the CSBG Act\",\"42 U.S.C. 9921(a)(2)(A)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:c2475bcfc97066e3826cfbaddaebe8a72a1c3d4131269f7652a98e09a9a6608f\",\"scope_quotes\":[\"Pub. L. 119–75, div. B, title II, Feb. 3, 2026, 140 Stat. 277, provided in part: “That the Secretary [of Health and Human Services] shall establish procedures regarding the disposition of intangible assets and program income that permit such assets acquired with, and program income derived from, grant funds authorized under section 680 of the CSBG Act [Community Services Block Grant Act, 42 U.S.C. 9921] to become the sole property of such grantees after a period of not more than 12 years after the end of the grant period for any activity consistent with section 680(a)(2)(A) of the CSBG Act [42 U.S.C. 9921(a)(2)(A)]: Provided further, That intangible assets in the form of loans, equity investments and other debt instruments, and program income may be used by grantees for any eligible purpose consistent with section 680(a)(2)(A) of the CSBG Act: Provided further, That these procedures shall apply to such grant funds made available after November 29, 1999”.\"],\"scope_text\":\"applicable to such grant funds made available after November 29, 1999\",\"section_id\":\"urn:rulespec:document-understanding:section:6888d98c59cc2331f4c6a6a1e0052761ef3a8008658a9708c0cec6503ed121ed\",\"start\":95995,\"summary\":\"Intangible assets in the form of loans, equity investments and other debt instruments, and program income may be used by grantees for any eligible purpose consistent with section 680(a)(2)(A) of the CSBG Act (42 U.S.C. 9921(a)(2)(A)), applicable to grant funds made available after November 29, 1999.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

    {
      "@id": "urn:rulespec:document-understanding:revision:25dcd8a0e503916d127c450e0f2b169d113a2c5b800a829a6de6a4ac3c9642d3",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:25dcd8a0e503916d127c450e0f2b169d113a2c5b800a829a6de6a4ac3c9642d3",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:dc93413612b90f439c85f6bc313c8e0795c88516be693f67a40d9149a0fafc49",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"the State\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:676b09d284f0fcce0bd4ae1e950a9d30a99c9efa534add672d2783ef51af146b\",\"urn:rulespec:document-understanding:assertion:e729661980d033dc8e1abff333e1e8fc2bc5cd6056290ea9e474a484b1ffcc1e\",\"urn:rulespec:document-understanding:assertion:298a8d8059461b6bf59dbc01074fee11d48a27078366e7416ad71d83f942b804\",\"urn:rulespec:document-understanding:assertion:53f1ba6af040d416b3a71541791b155db9052478b31566b202b3103eeed90078\",\"urn:rulespec:document-understanding:assertion:661cb2bc3bf8f63d53f5e522174447762d900414c47719175d49fcfdee29fca1\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":66600,\"evidence\":[{\"end\":65697,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:65683:65697:sha256-821875740dcc88c64698494aba68e2c0df4c8e0344d861f75db1c3aa2bab9fff\",\"quote\":\"(a) In general\",\"start\":65683},{\"end\":65937,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:65698:65937:sha256-6ebdc7fd475d36546f6b2d5aded717f4cd807a570a1ce6120506ae6d22c87db1\",\"quote\":\"In order to determine whether eligible entities meet the performance goals, administrative standards, financial management requirements, and other requirements of a State, the State shall conduct the following reviews of eligible entities:\",\"start\":65698},{\"end\":66600,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:65939:66600:sha256-dc035a80b369059d25c7cae1c27a0ee8755eec3476d78634862e5ecccc9c1108\",\"quote\":\"(1) A full onsite review of each such entity at least once during each 3-year period.\\n\\n(2) An onsite review of each newly designated entity immediately after the completion of the first year in which such entity receives funds through the community services block grant program.\\n\\n(3) Followup reviews including prompt return visits to eligible entities, and their programs, that fail to meet the goals, standards, and requirements established by the State.\\n\\n(4) Other reviews as appropriate, including reviews of entities with programs that have had other Federal, State, or local grants (other than assistance provided under this chapter) terminated for cause.\",\"start\":65939},{\"end\":65885,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:65880:65885:sha256-56ee5b508706bf2de91712d85d6d1e11ddbff01949142ed6e8c22e3b1bed1c71\",\"quote\":\"shall\",\"start\":65880},{\"end\":65697,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:65683:65697:sha256-821875740dcc88c64698494aba68e2c0df4c8e0344d861f75db1c3aa2bab9fff\",\"quote\":\"(a) In general\",\"start\":65683},{\"end\":65937,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:65698:65937:sha256-6ebdc7fd475d36546f6b2d5aded717f4cd807a570a1ce6120506ae6d22c87db1\",\"quote\":\"In order to determine whether eligible entities meet the performance goals, administrative standards, financial management requirements, and other requirements of a State, the State shall conduct the following reviews of eligible entities:\",\"start\":65698}],\"id\":\"urn:rulespec:document-understanding:revision:25dcd8a0e503916d127c450e0f2b169d113a2c5b800a829a6de6a4ac3c9642d3\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:661cb2bc3bf8f63d53f5e522174447762d900414c47719175d49fcfdee29fca1\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:1643d16aa4c6e3f0b1275a44b1ea58831ba4e6bff157005980d91423a813c9e3\",\"origin\":\"aiSuggested\",\"quote\":\"(a) In general In order to determine whether eligible entities meet the performance goals, administrative standards, financial management requirements, and other requirements of a State, the State shall conduct the following reviews of eligible entities:\\n\\n(1) A full onsite review of each such entity at least once during each 3-year period.\\n\\n(2) An onsite review of each newly designated entity immediately after the completion of the first year in which such entity receives funds through the community services block grant program.\\n\\n(3) Followup reviews including prompt return visits to eligible entities, and their programs, that fail to meet the goals, standards, and requirements established by the State.\\n\\n(4) Other reviews as appropriate, including reviews of entities with programs that have had other Federal, State, or local grants (other than assistance provided under this chapter) terminated for cause.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:1cb888e4513397239bfbc1e7a8bdbc2e7eb45976681e4747914034b0957969bc\",\"scope_quotes\":[\"(a) In general In order to determine whether eligible entities meet the performance goals, administrative standards, financial management requirements, and other requirements of a State, the State shall conduct the following reviews of eligible entities:\"],\"scope_text\":\"In order to determine whether eligible entities meet the performance goals, administrative standards, financial management requirements, and other requirements of a State\",\"section_id\":\"urn:rulespec:document-understanding:section:c0349af1123d989776fe253553df69642696cd32996dd791c280bdbf3d513641\",\"start\":65683,\"summary\":\"In order to determine whether eligible entities meet the performance goals, administrative standards, financial management requirements, and other requirements of a State, the State shall conduct other reviews as appropriate, including reviews of entities with programs that have had other Federal, State, or local grants (other than assistance provided under this chapter) terminated for cause.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:cde5041856d74521ba554c9b322fe2dc623862d970e48b59dc58502665af5df1\",\"urn:rulespec:document-understanding:assertion:1aebff20d4600f8b9053afa306e182ad5a7fc12b3581b47ff4b800a4d3a521bd\",\"urn:rulespec:document-understanding:assertion:b6b8b92667e58c382c8619cf6d61c517c061dc2ed43a4a249b49afa70b99d743\",\"urn:rulespec:document-understanding:assertion:fb29f7d6d8666c8cd5c734a09acc3d2d06ebb918e86ca3d3b2dbb9bd2a4e6768\",\"urn:rulespec:document-understanding:assertion:e7f926963a97c89e224004e063e1b201e5c6a73275c9ff3a6ab3aecf86cbfa65\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":102024,\"evidence\":[{\"end\":101525,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:101511:101525:sha256-ca9693d7a03c9f0992c78cc6587bb92ef32954c0803056e0a7056d093f04556c\",\"quote\":\"(A) In general\",\"start\":101511},{\"end\":101661,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:101526:101661:sha256-d194ab067108ebacee148f7b71a9928f8c80933f85235db7ffbc090abc518a06\",\"quote\":\"From the amounts allotted under paragraphs (1)(A) and (2)(A), the minimum total allotment for each State for each fiscal year shall be—\",\"start\":101526},{\"end\":102024,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:101663:102024:sha256-d86aea92e919c4479e02f5b6fae78a381e01fde3e0a444ebb3317a172e8cb5e6\",\"quote\":\"(i) $15,000 if the total amount appropriated to carry out this section is not less than $7,000,000 but less than $10,000,000;\\n\\n(ii) $20,000 if the total amount appropriated to carry out this section is not less than $10,000,000 but less than $15,000,000; or\\n\\n(iii) $30,000 if the total amount appropriated to carry out this section is not less than $15,000,000.\",\"start\":101663},{\"end\":101657,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:101652:101657:sha256-56ee5b508706bf2de91712d85d6d1e11ddbff01949142ed6e8c22e3b1bed1c71\",\"quote\":\"shall\",\"start\":101652},{\"end\":102024,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:101922:102024:sha256-069b0688e13152e8dbfdc742d20018063686e0653c539cc894b5d305e941f7ed\",\"quote\":\"(iii) $30,000 if the total amount appropriated to carry out this section is not less than $15,000,000.\",\"start\":101922}],\"id\":\"urn:rulespec:document-understanding:revision:5b823ca4afbe64551574228cc06042d3d4aa96491dc1779e64da49cd0fe4739c\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:fb29f7d6d8666c8cd5c734a09acc3d2d06ebb918e86ca3d3b2dbb9bd2a4e6768\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:6f1dc8aa723e0f5abc0c537954caeea01975f43e091dff53380dfc0d1210c10f\",\"origin\":\"aiSuggested\",\"quote\":\"(A) In general From the amounts allotted under paragraphs (1)(A) and (2)(A), the minimum total allotment for each State for each fiscal year shall be—\\n\\n(i) $15,000 if the total amount appropriated to carry out this section is not less than $7,000,000 but less than $10,000,000;\\n\\n(ii) $20,000 if the total amount appropriated to carry out this section is not less than $10,000,000 but less than $15,000,000; or\\n\\n(iii) $30,000 if the total amount appropriated to carry out this section is not less than $15,000,000.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:8c19ea2bff38053ce1de5df9919db38662e4d7559e64d1f5b2cacd2bccafa391\",\"scope_quotes\":[\"(iii) $30,000 if the total amount appropriated to carry out this section is not less than $15,000,000.\"],\"scope_text\":\"if the total amount appropriated to carry out this section is not less than $15,000,000\",\"section_id\":\"urn:rulespec:document-understanding:section:cad1a9ce814f7bc8d23a6ff48e1865a684b16830bcf049a10118a7b6cab89b15\",\"start\":101511,\"summary\":\"From the amounts allotted under paragraphs (1)(A) and (2)(A), the minimum total allotment for each State for each fiscal year shall be $30,000 if the total amount appropriated to carry out this section is not less than $15,000,000.\",\"target_ids\":[],\"term_refs\":[\"urn:rulespec:document-understanding:term:550663f04290e4c0432d461c54153ca79b1a7845732eb11bb9eac015d4030f87\"],\"typed_values\":[]}",

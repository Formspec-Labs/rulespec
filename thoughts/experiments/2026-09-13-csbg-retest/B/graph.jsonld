      "rkaf:assertsValue": {
        "@value": "{\"actor\":\"The eligible service provider\",\"kind\":\"requirement\",\"modality\":\"must\",\"scope_text\":\"in each community in which a program is funded under this section\",\"summary\":\"The eligible service provider shall, in each community in which a program is funded under this section, enter into formal partnerships with youth-serving organizations or other appropriate social service entities in order to link program participants with year-round services in their home communities that support and continue the objectives of this chapter.\"}",

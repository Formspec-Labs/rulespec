    {
      "@id": "urn:rulespec:document-understanding:revision:935427c078b9ff32083a8c0b794d2af8998395841dc56b0b4d1d8521088f23d7",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:935427c078b9ff32083a8c0b794d2af8998395841dc56b0b4d1d8521088f23d7",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:b2762a0c42f1a04ea832bc00c4427cf91e662a195ecfc7e79b9101c31983db17",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"the State\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:dd113586b92ad9e8db5d59962742cf09fc23bb20094f2c01eee870bfb539e902\",\"urn:rulespec:document-understanding:assertion:f836610fafbe62b9bc942cd146895fcae82f15487315554287f110842c5630f9\",\"urn:rulespec:document-understanding:assertion:e50139147aefb4ee26272121f9cd9faeb510c072afec6e676fa9b98e14ee95be\",\"urn:rulespec:document-understanding:assertion:0c42c5b63eb5c79ea3f127a76ab009899d6a607695675af5e9f29edcd93f6beb\",\"urn:rulespec:document-understanding:assertion:9200a254f22636e2ff4fd04322d4744eafd3def69aafe4e2862f72099b409a51\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":66395,\"evidence\":[{\"end\":65697,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:65683:65697:sha256-821875740dcc88c64698494aba68e2c0df4c8e0344d861f75db1c3aa2bab9fff\",\"quote\":\"(a) In general\",\"start\":65683},{\"end\":65937,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:65698:65937:sha256-6ebdc7fd475d36546f6b2d5aded717f4cd807a570a1ce6120506ae6d22c87db1\",\"quote\":\"In order to determine whether eligible entities meet the performance goals, administrative standards, financial management requirements, and other requirements of a State, the State shall conduct the following reviews of eligible entities:\",\"start\":65698},{\"end\":66395,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:65939:66395:sha256-92834f2d2e3428c0c5ad88e6724e99ddbfe8dc6ab4f0ae02b799c22600dcb903\",\"quote\":\"(1) A full onsite review of each such entity at least once during each 3-year period.\\n\\n(2) An onsite review of each newly designated entity immediately after the completion of the first year in which such entity receives funds through the community services block grant program.\\n\\n(3) Followup reviews including prompt return visits to eligible entities, and their programs, that fail to meet the goals, standards, and requirements established by the State.\",\"start\":65939},{\"end\":65885,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:65880:65885:sha256-56ee5b508706bf2de91712d85d6d1e11ddbff01949142ed6e8c22e3b1bed1c71\",\"quote\":\"shall\",\"start\":65880},{\"end\":65697,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:65683:65697:sha256-821875740dcc88c64698494aba68e2c0df4c8e0344d861f75db1c3aa2bab9fff\",\"quote\":\"(a) In general\",\"start\":65683},{\"end\":65937,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:65698:65937:sha256-6ebdc7fd475d36546f6b2d5aded717f4cd807a570a1ce6120506ae6d22c87db1\",\"quote\":\"In order to determine whether eligible entities meet the performance goals, administrative standards, financial management requirements, and other requirements of a State, the State shall conduct the following reviews of eligible entities:\",\"start\":65698}],\"id\":\"urn:rulespec:document-understanding:revision:935427c078b9ff32083a8c0b794d2af8998395841dc56b0b4d1d8521088f23d7\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:9200a254f22636e2ff4fd04322d4744eafd3def69aafe4e2862f72099b409a51\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:94bb3acee49af9bc62605435172615b5f798785d57f5d4d3c486a5db6203c6e5\",\"origin\":\"aiSuggested\",\"quote\":\"(a) In general In order to determine whether eligible entities meet the performance goals, administrative standards, financial management requirements, and other requirements of a State, the State shall conduct the following reviews of eligible entities:\\n\\n(1) A full onsite review of each such entity at least once during each 3-year period.\\n\\n(2) An onsite review of each newly designated entity immediately after the completion of the first year in which such entity receives funds through the community services block grant program.\\n\\n(3) Followup reviews including prompt return visits to eligible entities, and their programs, that fail to meet the goals, standards, and requirements established by the State.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:bc69970f73d4f56d37f23763ccd6e02df8500d74996ba9cbd832c9112e55b050\",\"scope_quotes\":[\"(a) In general In order to determine whether eligible entities meet the performance goals, administrative standards, financial management requirements, and other requirements of a State, the State shall conduct the following reviews of eligible entities:\"],\"scope_text\":\"In order to determine whether eligible entities meet the performance goals, administrative standards, financial management requirements, and other requirements of a State\",\"section_id\":\"urn:rulespec:document-understanding:section:c0349af1123d989776fe253553df69642696cd32996dd791c280bdbf3d513641\",\"start\":65683,\"summary\":\"In order to determine whether eligible entities meet the performance goals, administrative standards, financial management requirements, and other requirements of a State, the State shall conduct followup reviews including prompt return visits to eligible entities, and their programs, that fail to meet the goals, standards, and requirements established by the State.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

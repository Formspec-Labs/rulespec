    },
    {
      "@id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:41609:42525:sha256-cc9eb7f14015b7e63c420abd1952234459d3a709fae5aeb068640821250f0c06",
      "@type": "rkaf:SourceFragment",
      "oa:hasSource": "urn:rulespec:document-understanding:document:26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023",
      "rkaf:fragmentIdentityScheme": "rkaf:carrier-local-fragment",
      "rkaf:sourceArtifactDigest": "sha256:26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023",
      "rkaf:fragmentContentDigest": "sha256:cc9eb7f14015b7e63c420abd1952234459d3a709fae5aeb068640821250f0c06",
      "rkaf:selectorKind": [
        "oa:TextQuoteSelector",
        "oa:TextPositionSelector"
      ],
      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "(A) a description of the service delivery system, for services provided or coordinated with funds made available through grants made under section 9907(a) of this title, targeted to low-income individuals and families in communities within the State;\n\n(B) a description of how linkages will be developed to fill identified gaps in the services, through the provision of information, referrals, case management, and followup consultations;\n\n(C) a description of how funds made available through grants made under section 9907(a) of this title will be coordinated with other public and private resources; and\n\n(D) a description of how the local entity will use the funds to support innovative community and neighborhood-based initiatives related to the purposes of this chapter, which may include fatherhood initiatives and other initiatives with the goal of strengthening families and encouraging effective parenting;"
        },
        {
          "@type": "oa:TextPositionSelector",
          "oa:start": 41609,
          "oa:end": 42525,
          "rkaf:coordinateSystem": "rkaf:unicode-codepoint"
        }
      ]
    },
    {
      "@id": "urn:rulespec:document-understanding:assertion:0f8a751636ea498e4f2a1d9717885319e08b94e21481a45030906a559625688c",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:4b80bc242bf4108132092097a8f5b641e6a56bd640c5f048e8bbcbf82862ca04",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:3d5314ddf0c5e8d85fc2ad1f82947fc8923794f629e4490f8a1e58bdaf444e17",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:d0b8fc159371c4d131e01b7e586c191502d7b8484bf904332c4ec02625011837",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:states-requirement",
      "rkaf:assertsValue": {
        "@value": "Beginning with fiscal year 2000, the State's application and plan submitted to be eligible for a grant or allotment under section 9905 or 9906 of this title must contain information provided by eligible entities in the State, containing: (A) a description of the service delivery system for services provided or coordinated with funds from grants made under section 9907(a) targeted to low-income individuals and families; (B) a description of how linkages will be developed to fill identified service gaps via information, referrals, case management, and followup consultations; (C) a description of how funds from section 9907(a) grants will be coordinated with other public and private resources; and (D) a description of how the local entity will use the funds to support innovative community and neighborhood-based initiatives related to the purposes of this chapter (which may include fatherhood initiatives and other family-strengthening and parenting initiatives).",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },
    {
      "@id": "urn:rulespec:document-understanding:binding:13e9fbf66d9234d177ac290d12a98a210ea480c98af2dea7ca2c0d5f94bc677d",

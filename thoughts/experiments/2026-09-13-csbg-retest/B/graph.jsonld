      "dcterms:description": "{\"action\":\"\",\"actor\":\"Secretary\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:db77d9ad7fab55f76c3c0b225ce3ad41cb3472b99da68108db264d98b5f470c1\",\"urn:rulespec:document-understanding:assertion:1ad10c9d30ff44b803090ea521d7e6975fbdc29715d131eace01903a697c6533\",\"urn:rulespec:document-understanding:assertion:94b8d3132573bd5788a50273efd3d0b3af2043208619cde0a17085e09554c487\",\"urn:rulespec:document-understanding:assertion:fd9045b4c7e84265cf6b45aedd5270cec48997bcfd80a54b14e5ab9837bb92b6\",\"urn:rulespec:document-understanding:assertion:390ae2e7a9fdaa6bb517ea8111c91f24f3dca8f9396385f726acae5661a32b3f\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":119188,\"evidence\":[{\"end\":118943,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:118789:118943:sha256-516b62709bebd30c3d0aaca26186292754ae137911d977ded0930e71de231eba\",\"quote\":\"(3) In addition to sums which are required to carry out the evaluation, reporting, and dissemination of results under subsections (a), (c), (d), and (f),1\",\"start\":118789},{\"end\":118981,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:118945:118981:sha256-82a1f00ab9f241bcc5b63b8eff430fdb902e17c51a01d85e25a2659602172a39\",\"quote\":\"1 See References in Text note below.\",\"start\":118945},{\"end\":119188,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:118983:119188:sha256-1418bda27a91913db766de16ecb6b103e9e4e805cbff9ac7743f53b347ad9027\",\"quote\":\" the Secretary is authorized to reserve up to 2 percent of the amounts appropriated pursuant to subparagraphs (1) and (2) for administration of the program as well as for planning and technical assistance.\",\"start\":118983},{\"end\":118997,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:118984:118997:sha256-67afe9d5c4310238267da793c265a616f9e90d554f2458a8065b7bb971d853b5\",\"quote\":\"the Secretary\",\"start\":118984}],\"id\":\"urn:rulespec:document-understanding:revision:d456adaf15ffaff7d442dae981f5d385ceffcdb7c91a2dba06f843b7f2486127\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"authority\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:fd9045b4c7e84265cf6b45aedd5270cec48997bcfd80a54b14e5ab9837bb92b6\",\"modality\":\"not_stated\",\"modality_quote\":\"\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:9088610dd27513e3bb8f4b7264b9b551c340503b03d77a7ffa3b8e9973ba3355\",\"origin\":\"aiSuggested\",\"quote\":\"(3) In addition to sums which are required to carry out the evaluation, reporting, and dissemination of results under subsections (a), (c), (d), and (f),1\\n\\n1 See References in Text note below.\\n\\n the Secretary is authorized to reserve up to 2 percent of the amounts appropriated pursuant to subparagraphs (1) and (2) for administration of the program as well as for planning and technical assistance.\",\"references\":[\"subsections (a), (c), (d), and (f)\",\"subparagraphs (1) and (2)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:1b91b9bdbc775b09f1600227f32ec54a77fd24e48d05bee66cc42fe3d45cff27\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"urn:rulespec:document-understanding:section:5fba676d6775544d7cae048a3634eb9fe091aa0a96f2f732b41f08ff944d6890\",\"start\":118789,\"summary\":\"In addition to sums which are required to carry out the evaluation, reporting, and dissemination of results under subsections (a), (c), (d), and (f), the Secretary is authorized to reserve up to 2 percent of the amounts appropriated pursuant to subparagraphs (1) and (2) for administration of the program as well as for planning and technical assistance.\",\"target_ids\":[],\"term_refs\":[\"urn:rulespec:document-understanding:term:576e9257cb479321316fb378bb4b88ddb844dc1e33b39dc213b46732e75aa46c\"],\"typed_values\":[]}",

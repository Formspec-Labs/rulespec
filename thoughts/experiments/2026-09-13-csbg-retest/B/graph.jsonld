      "rkaf:appliesInJurisdiction": [],
      "rkaf:applicabilityCondition": "If a State uses less than 100 percent of the grant or allotment received under section 9905 or 9906 of this title to make grants under subsection (a)."
    },
    {
      "@id": "urn:rulespec:document-understanding:assertion:d3c8741622e28dca1c9b81c6cf66ae6e081a7585963ecbdd6abb320c051a01f7",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:4b80bc242bf4108132092097a8f5b641e6a56bd640c5f048e8bbcbf82862ca04",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:31395ba7d5334d84fb0b494cef7940aef1f2057d347346c5e570b85817a7b200",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:dfcb0a867a5a370c8ed8ef59ed0828387840825f4bf0b19685a5233a608035c1",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:states-requirement",
      "rkaf:assertsValue": {
        "@value": "If a State uses less than 100 percent of the grant or allotment received under section 9905 or 9906 of this title to make grants under subsection (a), the State shall use the remainder of the grant or allotment under section 9905 or 9906 of this title (subject to paragraph (2)) for activities that may include providing training and technical assistance to entities in need; coordinating State-operated and, at the State's option, locally-operated programs targeted to low-income children and families with services provided by eligible entities and other funded organizations, including detailing appropriate employees; supporting statewide coordination and communication among eligible entities; analyzing fund distribution to determine targeting to areas of greatest need; supporting asset-building programs for low-income individuals such as individual development accounts; supporting innovative programs conducted by community action agencies or neighborhood-based organizations; supporting State charity tax credits as described in subsection (c); and supporting other activities consistent with the purposes of this chapter.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"

      "rkaf:assertsValue": {
        "@value": "{\"actor\":\"The Secretary\",\"kind\":\"requirement\",\"modality\":\"must\",\"summary\":\"The Secretary shall annually submit the report containing a summary of evaluations and listing of activities to the Chairperson of the Committee on Education and the Workforce of the House of Representatives and the Chairperson of the Committee on Labor and Human Resources of the Senate.\"}",
        "@type": "xsd:string"
      },

      "dcterms:description": "{\"action\":\"\",\"actor\":\"an entity described in paragraph (1)(B)\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:3ba97d97901f4fc327e17903369de6fd34858e28fade3671900404c9695b6ad9\",\"urn:rulespec:document-understanding:assertion:ff8049a04ad9d9ee0b6f1bd5601c7e17807e41da56a7ac58cc88e9e1287da7ae\",\"urn:rulespec:document-understanding:assertion:82ec1bf433aed1848ecf9a6a35f84d321eb87b61ed99647792e3287fb32474d5\",\"urn:rulespec:document-understanding:assertion:6d096bbf3d1317a2b85b6a92e9a2c7405e6064a7419758649c3bde2b289cfbfa\",\"urn:rulespec:document-understanding:assertion:ee1ee92faa9a84d0e3e3786bbf24a7b13de6aabef5434e9b9a2d5998d83a0e0f\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":52714,\"evidence\":[{\"end\":52187,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:52172:52187:sha256-ad91a0a713211e0b83761d8b3d1ae9448e1a500dfadbc96f1bae422e4e460da5\",\"quote\":\"(2) Requirement\",\"start\":52172},{\"end\":52382,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:52188:52382:sha256-587ddf15f214f4c12672296421e01679d376ce037fb5bad0dd7e510bd80c267c\",\"quote\":\"In order to serve as the eligible entity for the area, an entity described in paragraph (1)(B) shall agree to add additional members to the board of the entity to ensure adequate representation—\",\"start\":52188},{\"end\":52714,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:52384:52714:sha256-5283ca511d8fe75de67df5d052af879654337411408e87d261d5772f714cd913\",\"quote\":\"(A) in each of the three required categories described in subparagraphs (A), (B), and (C) of section 9910(a)(2) of this title, by members that reside in the community comprised by the unserved area; and\\n\\n(B) in the category described in section 9910(a)(2)(B) of this title, by members that reside in the neighborhood to be served.\",\"start\":52384},{\"end\":52282,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:52243:52282:sha256-a97563653c6e82d590b1bc1da7161c9dc70758e895ff3d58231fb00cba3a05e0\",\"quote\":\"an entity described in paragraph (1)(B)\",\"start\":52243},{\"end\":52288,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:52283:52288:sha256-56ee5b508706bf2de91712d85d6d1e11ddbff01949142ed6e8c22e3b1bed1c71\",\"quote\":\"shall\",\"start\":52283},{\"end\":52187,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:52172:52187:sha256-ad91a0a713211e0b83761d8b3d1ae9448e1a500dfadbc96f1bae422e4e460da5\",\"quote\":\"(2) Requirement\",\"start\":52172},{\"end\":52382,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:52188:52382:sha256-587ddf15f214f4c12672296421e01679d376ce037fb5bad0dd7e510bd80c267c\",\"quote\":\"In order to serve as the eligible entity for the area, an entity described in paragraph (1)(B) shall agree to add additional members to the board of the entity to ensure adequate representation—\",\"start\":52188}],\"id\":\"urn:rulespec:document-understanding:revision:29476ad3d29c9ef1833dc76bcb2145747a52a1c3e803ddc5d66fddc445aed58f\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:ee1ee92faa9a84d0e3e3786bbf24a7b13de6aabef5434e9b9a2d5998d83a0e0f\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:7f6da13f33b6b6a7fdd4b02018141cd372f93a8c182682d60c2dd93b69afd9d7\",\"origin\":\"aiSuggested\",\"quote\":\"(2) Requirement In order to serve as the eligible entity for the area, an entity described in paragraph (1)(B) shall agree to add additional members to the board of the entity to ensure adequate representation—\\n\\n(A) in each of the three required categories described in subparagraphs (A), (B), and (C) of section 9910(a)(2) of this title, by members that reside in the community comprised by the unserved area; and\\n\\n(B) in the category described in section 9910(a)(2)(B) of this title, by members that reside in the neighborhood to be served.\",\"references\":[\"section 9910(a)(2)\",\"subparagraphs (A), (B), and (C) of section 9910(a)(2)\",\"section 9910(a)(2)(B)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:cb76d4b97c95c05a983037e72358bc7ddbad249d3cb22d0bbd595fb47d806367\",\"scope_quotes\":[\"(2) Requirement In order to serve as the eligible entity for the area, an entity described in paragraph (1)(B) shall agree to add additional members to the board of the entity to ensure adequate representation—\"],\"scope_text\":\"In order to serve as the eligible entity for the area\",\"section_id\":\"urn:rulespec:document-understanding:section:b8000f1ee8341d7eccdb1b202ebee86bddd6c2a58344891bf3dfbc5b7909fb1a\",\"start\":52172,\"summary\":\"In order to serve as the eligible entity for the area, an entity described in paragraph (1)(B) shall agree to add additional members to the board of the entity to ensure adequate representation: (A) in each of the three required categories described in subparagraphs (A), (B), and (C) of section 9910(a)(2) of this title, by members that reside in the community comprised by the unserved area; and (B) in the category described in section 9910(a)(2)(B) of this title, by members that reside in the neighborhood to be served.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

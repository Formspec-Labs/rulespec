      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:4b80bc242bf4108132092097a8f5b641e6a56bd640c5f048e8bbcbf82862ca04",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:31395ba7d5334d84fb0b494cef7940aef1f2057d347346c5e570b85817a7b200",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:9185d503979c7fd45346c4083608ff0008e6351b90bdc392e5ee3a8d29aab2fb",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:choice_text",
      "rkaf:assertsValue": {
        "@value": "To qualify, an organization must satisfy three conditions: (1) be either a 501(c)(3) tax-exempt entity, an eligible entity, or a public housing agency; (2) be certified by the appropriate State authority as meeting clauses (iii) and (iv); and (3) if otherwise required to file a return under section 6033, elect to treat information required by clause (v) as specified in section 6033(b).",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"the Secretary\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:9ab0e3620a77094e06320bf833b6d28ae39bb6a947fc2b98bd84cf48a4945ade\",\"urn:rulespec:document-understanding:assertion:24d4b604e36fb7c4337ed989829a632230490b7453ffd9b6386b90f5c6b21087\",\"urn:rulespec:document-understanding:assertion:5894b8d64bce9967c39481b9ec0f2fbdf19f854c62e27593846d0e2efab5061a\",\"urn:rulespec:document-understanding:assertion:ae64126d405983cae73b1da167e4b21c102f0b614a5e4592743b97825ad0620c\",\"urn:rulespec:document-understanding:assertion:43d1b2ade10d28b90d4c66d7191c1032f8db7ecd909c1cf2080201dfbd10e3ce\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":79116,\"evidence\":[{\"end\":77676,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:77650:77676:sha256-16e312c7470c4980fff1319adb4b68e43439dd324cb4772b7083df92055a8382\",\"quote\":\"(2) Reporting requirements\",\"start\":77650},{\"end\":77827,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:77677:77827:sha256-709576a59dfac0d4d99977e3d14fe699d93348872acd158444a34c22d23af9ed\",\"quote\":\"At the end of each fiscal year beginning after September 30, 1999, the Secretary shall, directly or by grant or contract, prepare a report containing—\",\"start\":77677},{\"end\":79116,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:77829:79116:sha256-9de2516b56c6feb7b8c3326df1a0ff833b652e1752c77b3066a0df8095e94c15\",\"quote\":\"(A) a summary of the planned use of funds by each State, and the eligible entities in the State, under the community services block grant program, as contained in each State plan submitted pursuant to section 9908 of this title;\\n\\n(B) a description of how funds were actually spent by the State and eligible entities in the State, including a breakdown of funds spent on administrative costs and on the direct delivery of local services by eligible entities;\\n\\n(C) information on the number of entities eligible for funds under this chapter, the number of low-income persons served under this chapter, and such demographic data on the low-income populations served by eligible entities as is determined by the Secretary to be feasible;\\n\\n(D) a comparison of the planned uses of funds for each State and the actual uses of the funds;\\n\\n(E) a summary of each State’s performance results, and the results for the eligible entities, as collected and submitted by the States in accordance with subsection (a)(2); and\\n\\n(F) any additional information that the Secretary considers to be appropriate to carry out this chapter, if the Secretary informs the States of the need for such additional information and allows a reasonable period of time for the States to collect and provide the information.\",\"start\":77829},{\"end\":77763,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:77758:77763:sha256-56ee5b508706bf2de91712d85d6d1e11ddbff01949142ed6e8c22e3b1bed1c71\",\"quote\":\"shall\",\"start\":77758},{\"end\":77676,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:77650:77676:sha256-16e312c7470c4980fff1319adb4b68e43439dd324cb4772b7083df92055a8382\",\"quote\":\"(2) Reporting requirements\",\"start\":77650},{\"end\":77827,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:77677:77827:sha256-709576a59dfac0d4d99977e3d14fe699d93348872acd158444a34c22d23af9ed\",\"quote\":\"At the end of each fiscal year beginning after September 30, 1999, the Secretary shall, directly or by grant or contract, prepare a report containing—\",\"start\":77677}],\"id\":\"urn:rulespec:document-understanding:revision:d40388113be5857cdf356b44df04ab23ad87a81e5c39c229afad992bf4c54d4c\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:43d1b2ade10d28b90d4c66d7191c1032f8db7ecd909c1cf2080201dfbd10e3ce\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:18259e12648b4731580dfc0364fbfbe6ac6328363a1f7c29b990177abeed5a96\",\"origin\":\"aiSuggested\",\"quote\":\"(2) Reporting requirements At the end of each fiscal year beginning after September 30, 1999, the Secretary shall, directly or by grant or contract, prepare a report containing—\\n\\n(A) a summary of the planned use of funds by each State, and the eligible entities in the State, under the community services block grant program, as contained in each State plan submitted pursuant to section 9908 of this title;\\n\\n(B) a description of how funds were actually spent by the State and eligible entities in the State, including a breakdown of funds spent on administrative costs and on the direct delivery of local services by eligible entities;\\n\\n(C) information on the number of entities eligible for funds under this chapter, the number of low-income persons served under this chapter, and such demographic data on the low-income populations served by eligible entities as is determined by the Secretary to be feasible;\\n\\n(D) a comparison of the planned uses of funds for each State and the actual uses of the funds;\\n\\n(E) a summary of each State’s performance results, and the results for the eligible entities, as collected and submitted by the States in accordance with subsection (a)(2); and\\n\\n(F) any additional information that the Secretary considers to be appropriate to carry out this chapter, if the Secretary informs the States of the need for such additional information and allows a reasonable period of time for the States to collect and provide the information.\",\"references\":[\"section 9908 of this title\",\"subsection (a)(2)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:706f05f798933f34ff56d63f1108bf31af9efeb5743755928dc27795f577b77d\",\"scope_quotes\":[\"(2) Reporting requirements At the end of each fiscal year beginning after September 30, 1999, the Secretary shall, directly or by grant or contract, prepare a report containing—\"],\"scope_text\":\"At the end of each fiscal year beginning after September 30, 1999\",\"section_id\":\"urn:rulespec:document-understanding:section:fa489a00ccb41098ac2b415167888ae0d85e530b88cc3c90eda7efe29c7dad7b\",\"start\":77650,\"summary\":\"At the end of each fiscal year beginning after September 30, 1999, the Secretary must, directly or by grant or contract, prepare a report containing: (A) a summary of the planned use of funds by each State, and the eligible entities in the State, under the community services block grant program, as contained in each State plan submitted pursuant to section 9908 of title 42; (B) a description of how funds were actually spent by the State and eligible entities in the State, including a breakdown of funds spent on administrative costs and on the direct delivery of local services by eligible entities; (C) information on the number of entities eligible for funds under this chapter, the number of low-income persons served under this chapter, and such demographic data on the low-income populations served by eligible entities as is determined by the Secretary to be feasible; (D) a comparison of the planned uses of funds for each State and the actual uses of the funds; (E) a summary of each State's performance results, and the results for the eligible entities, as collected and submitted by the States in accordance with subsection (a)(2); and (F) any additional information that the Secretary considers to be appropriate to carry out this chapter, if the Secretary informs the States of the need for such additional information and allows a reasonable period of time for the States to collect and provide the information.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",
      "dcterms:references": [

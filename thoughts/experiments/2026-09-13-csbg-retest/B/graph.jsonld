      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"the chief executive officer\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:370da633bcb633a7c8d44fbd8d9dc4d2ad636bb0b6095145a5c1fac82e25fbdb\",\"urn:rulespec:document-understanding:assertion:a75eb3b77454d8d815dc560626cba0d8d626bbaec63d2378c77aa9e1bf7fc7cc\",\"urn:rulespec:document-understanding:assertion:4792345c7164a0489997fd8c68729d1f50ab8da9215b60458940bf498142166c\",\"urn:rulespec:document-understanding:assertion:9e75cb03139f22faf84351a192de7c519d59c40c414c39a9d5c3f90c64b8f365\",\"urn:rulespec:document-understanding:assertion:fab3b34a872058331b112b184ba5e8c0d346402b4fe7e60b315d27cb53a361d5\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":53156,\"evidence\":[{\"end\":53156,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:52745:53156:sha256-e1706c26f78180af15def5eab3e88737527dae03f4a18f55387d1c424e1477d2\",\"quote\":\"In designating an eligible entity under subsection (a), the chief executive officer shall grant the designation to an organization of demonstrated effectiveness in meeting the goals and purposes of this chapter and may give priority, in granting the designation, to eligible entities that are providing related services in the unserved area, consistent with the needs identified by a community-needs assessment.\",\"start\":52745},{\"end\":52828,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:52801:52828:sha256-d44239874c9022ec9a79a4927817d7b4a7191564f32fab802aa5e97eb7824a2d\",\"quote\":\"the chief executive officer\",\"start\":52801},{\"end\":52963,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:52960:52963:sha256-ee4d988c65de860fabbfbcd27f73d50bbebe3fba37fe419284f4811389c30bdc\",\"quote\":\"may\",\"start\":52960},{\"end\":53156,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:52745:53156:sha256-e1706c26f78180af15def5eab3e88737527dae03f4a18f55387d1c424e1477d2\",\"quote\":\"In designating an eligible entity under subsection (a), the chief executive officer shall grant the designation to an organization of demonstrated effectiveness in meeting the goals and purposes of this chapter and may give priority, in granting the designation, to eligible entities that are providing related services in the unserved area, consistent with the needs identified by a community-needs assessment.\",\"start\":52745}],\"id\":\"urn:rulespec:document-understanding:revision:f5ab1b15947f5d3027af19f2638108c8037267acbdcc6b543f2de7826e213e97\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"permission\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:fab3b34a872058331b112b184ba5e8c0d346402b4fe7e60b315d27cb53a361d5\",\"modality\":\"may\",\"modality_quote\":\"may\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:3b62d1173240f8aad230465b31c00e68407ac07e0217cb6ddb09aa70956f7593\",\"origin\":\"aiSuggested\",\"quote\":\"In designating an eligible entity under subsection (a), the chief executive officer shall grant the designation to an organization of demonstrated effectiveness in meeting the goals and purposes of this chapter and may give priority, in granting the designation, to eligible entities that are providing related services in the unserved area, consistent with the needs identified by a community-needs assessment.\",\"references\":[\"subsection (a)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:ab5abad8864719cb887968cf0fa27773fcfb2237383980a5f9e193e3a04a767c\",\"scope_quotes\":[\"In designating an eligible entity under subsection (a), the chief executive officer shall grant the designation to an organization of demonstrated effectiveness in meeting the goals and purposes of this chapter and may give priority, in granting the designation, to eligible entities that are providing related services in the unserved area, consistent with the needs identified by a community-needs assessment.\"],\"scope_text\":\"In designating an eligible entity under subsection (a)\",\"section_id\":\"urn:rulespec:document-understanding:section:b8000f1ee8341d7eccdb1b202ebee86bddd6c2a58344891bf3dfbc5b7909fb1a\",\"start\":52745,\"summary\":\"In designating an eligible entity under subsection (a), the chief executive officer may give priority, in granting the designation, to eligible entities that are providing related services in the unserved area, consistent with the needs identified by a community-needs assessment.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

    {
      "@id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:33567:34064:sha256-adfaca298672897468ff1478214ace5d637e765d31bc296ec2864358b6fea81d",

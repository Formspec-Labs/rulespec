      "rkaf:assertsValue": {
        "@value": "{\"actor\":\"a State\",\"kind\":\"requirement\",\"modality\":\"must\",\"scope_text\":\"Beginning with fiscal year 2000, to be eligible to receive a grant or allotment under section 9905 or 9906 of this title\",\"summary\":\"Beginning with fiscal year 2000, the State's application and plan submitted to be eligible for a grant or allotment under section 9905 or 9906 of this title must contain an assurance that the State will permit and cooperate with Federal investigations undertaken in accordance with section 9916 of this title.\"}",
        "@type": "xsd:string"

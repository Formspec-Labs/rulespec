      ]
    },
    {
      "@id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:77829:79116:sha256-9de2516b56c6feb7b8c3326df1a0ff833b652e1752c77b3066a0df8095e94c15",
      "@type": "rkaf:SourceFragment",
      "oa:hasSource": "urn:rulespec:document-understanding:document:26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023",
      "rkaf:fragmentIdentityScheme": "rkaf:carrier-local-fragment",
      "rkaf:sourceArtifactDigest": "sha256:26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023",
      "rkaf:fragmentContentDigest": "sha256:9de2516b56c6feb7b8c3326df1a0ff833b652e1752c77b3066a0df8095e94c15",
      "rkaf:selectorKind": [
        "oa:TextQuoteSelector",
        "oa:TextPositionSelector"
      ],
      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "(A) a summary of the planned use of funds by each State, and the eligible entities in the State, under the community services block grant program, as contained in each State plan submitted pursuant to section 9908 of this title;\n\n(B) a description of how funds were actually spent by the State and eligible entities in the State, including a breakdown of funds spent on administrative costs and on the direct delivery of local services by eligible entities;\n\n(C) information on the number of entities eligible for funds under this chapter, the number of low-income persons served under this chapter, and such demographic data on the low-income populations served by eligible entities as is determined by the Secretary to be feasible;\n\n(D) a comparison of the planned uses of funds for each State and the actual uses of the funds;\n\n(E) a summary of each State’s performance results, and the results for the eligible entities, as collected and submitted by the States in accordance with subsection (a)(2); and\n\n(F) any additional information that the Secretary considers to be appropriate to carry out this chapter, if the Secretary informs the States of the need for such additional information and allows a reasonable period of time for the States to collect and provide the information."
        },
        {
          "@type": "oa:TextPositionSelector",
          "oa:start": 77829,
          "oa:end": 79116,
          "rkaf:coordinateSystem": "rkaf:unicode-codepoint"
        }
      ]
    },
    {

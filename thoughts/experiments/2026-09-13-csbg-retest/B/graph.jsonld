      "dcterms:description": "{\"action\":\"\",\"actor\":\"organization\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:ac5d6d87cd29159e62fb2e91e38a49c22719f7579b802339eb9d8f48987aea69\",\"urn:rulespec:document-understanding:assertion:6a2c5ef301b574d678354e2f9ee67b7291bb8a93cf0fe4f8f495604885a49a9f\",\"urn:rulespec:document-understanding:assertion:6092cc7a50c9245b6ab712170f2dd2c057cd6fa17863459cef8d34757bdff59e\",\"urn:rulespec:document-understanding:assertion:7572a6299652bd2efd9e72995856bcd9b09c3d4dc30834918cbb397927183552\",\"urn:rulespec:document-understanding:assertion:4357506d7e95506c5d3c2daf798f40b22a1fc07b2c40186b1edbf6ed0cca00f4\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":34472,\"evidence\":[{\"end\":34124,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:34067:34124:sha256-2ba6dae58448fc2b7a6c690d6cd1f62c0bc5507ccfe43c9ee323e5a089316d9b\",\"quote\":\"(vi) Additional requirements for collection organizations\",\"start\":34067},{\"end\":34185,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:34125:34185:sha256-90e8c94d0e08f84b98c0a791bda03be51d2faab83bc1652963f0cd591786815d\",\"quote\":\"The requirements of this clause are met if the organization—\",\"start\":34125},{\"end\":34472,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:34187:34472:sha256-e5708d0e60b3e3a9734b3cd52093a06ed122320a17bd6c840e26cce206d17a9a\",\"quote\":\"(I) maintains separate accounting for revenues and expenses; and\\n\\n(II) makes available to the public information on the administrative and fundraising costs of the organization, and information as to the organizations receiving funds from the organization and the amount of such funds.\",\"start\":34187},{\"end\":34124,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:34067:34124:sha256-2ba6dae58448fc2b7a6c690d6cd1f62c0bc5507ccfe43c9ee323e5a089316d9b\",\"quote\":\"(vi) Additional requirements for collection organizations\",\"start\":34067},{\"end\":34185,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:34125:34185:sha256-90e8c94d0e08f84b98c0a791bda03be51d2faab83bc1652963f0cd591786815d\",\"quote\":\"The requirements of this clause are met if the organization—\",\"start\":34125}],\"id\":\"urn:rulespec:document-understanding:revision:cb7c96de349bac669540dc8650e7587f843bf3c6bbbbfc333248816e28ce6a35\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"statement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:4357506d7e95506c5d3c2daf798f40b22a1fc07b2c40186b1edbf6ed0cca00f4\",\"modality\":\"not_stated\",\"modality_quote\":\"\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:d8be606264aa6f5d9cc1591e2c18b1e4417bda97e2887a60c87225cf9801e13f\",\"origin\":\"aiSuggested\",\"quote\":\"(vi) Additional requirements for collection organizations The requirements of this clause are met if the organization—\\n\\n(I) maintains separate accounting for revenues and expenses; and\\n\\n(II) makes available to the public information on the administrative and fundraising costs of the organization, and information as to the organizations receiving funds from the organization and the amount of such funds.\",\"references\":[\"clause (vi)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:8a984c6bdfbbab954a89e6755d1ac0f10654e58e85cb803ee0252bf97b02836a\",\"scope_quotes\":[\"(vi) Additional requirements for collection organizations The requirements of this clause are met if the organization—\"],\"scope_text\":\"For collection organizations under clause (vi).\",\"section_id\":\"urn:rulespec:document-understanding:section:065d5bd1b1fd12e07012730aaa12714e330211d213042d09aad361bcfa67ebfa\",\"start\":34067,\"summary\":\"The requirements of clause (vi) for collection organizations are met if the organization maintains separate accounting for revenues and expenses, and makes available to the public information on the administrative and fundraising costs of the organization and information as to the organizations receiving funds from the organization and the amount of such funds.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

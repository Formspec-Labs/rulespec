    {
      "@id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:112429:113144:sha256-b725608f49010a5eb25319d26ea55488767bea2dc5ad9ccf657bae834002618c",
      "@type": "rkaf:SourceFragment",
      "oa:hasSource": "urn:rulespec:document-understanding:document:26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023",
      "rkaf:fragmentIdentityScheme": "rkaf:carrier-local-fragment",
      "rkaf:sourceArtifactDigest": "sha256:26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023",
      "rkaf:fragmentContentDigest": "sha256:b725608f49010a5eb25319d26ea55488767bea2dc5ad9ccf657bae834002618c",
      "rkaf:selectorKind": [
        "oa:TextQuoteSelector",
        "oa:TextPositionSelector"
      ],
      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "(A) involve activities which can be incorporated into or be closely coordinated with eligible entities’ ongoing programs;\n\n(B) involve significant new combinations of resources or new and innovative approaches involving partnership agreements;\n\n(C) are structured in a way that will, within the limits of the type of assistance or activities contemplated, most fully and effectively promote the purposes of the Community Services Block Grant Act [42 U.S.C. 9901 et seq.]; and\n\n(D) contain an assurance that the applicant for such grants will obtain an independent, methodologically sound evaluation of the effectiveness of the activities carried out with such grant and will submit such evaluation to the Secretary."
        },
        {
          "@type": "oa:TextPositionSelector",
          "oa:start": 112429,
          "oa:end": 113144,
          "rkaf:coordinateSystem": "rkaf:unicode-codepoint"
        }
      ]
    },

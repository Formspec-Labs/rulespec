      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"The Secretary\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:59a674f77ea84a23702240d4b0f51feb051ede4dab0a7da3d4050d1e9ccd6cd4\",\"urn:rulespec:document-understanding:assertion:b73657b2f31c335e480a50c6df1be974b5418218ab703d36bc1420f69d833e53\",\"urn:rulespec:document-understanding:assertion:2671d352ccb939f22741cb13e04143e4c666362581d2e5b5c44ded0e7a6a99bb\",\"urn:rulespec:document-understanding:assertion:dd5e4a546308e230e377c57bc3f3f7e8d4a4f369d53f8d3c4f5321f8deb5f1e6\",\"urn:rulespec:document-understanding:assertion:8cc21fc698001a004d81e3aec5ff169ad66353c167be7a0cd302a310a426926d\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":81128,\"evidence\":[{\"end\":81128,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:80719:81128:sha256-70dbc2b58f06de175a08772f0c59a3156ae80dadd36392ab723db6240714be25\",\"quote\":\"The Secretary may waive the limitation contained in paragraph (1) upon a State request for such a waiver, if the Secretary finds that the request describes extraordinary circumstances to justify the purchase of land or the construction of facilities (or the making of permanent improvements) and that permitting the waiver will contribute to the ability of the State to carry out the purposes of this chapter.\",\"start\":80719},{\"end\":80732,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:80719:80732:sha256-d6dd2bb6d3c44b4545cc3f97cb6f8a38842ecd30d2c58ec3e1c53a8c1a0ac77c\",\"quote\":\"The Secretary\",\"start\":80719},{\"end\":80736,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:80733:80736:sha256-ee4d988c65de860fabbfbcd27f73d50bbebe3fba37fe419284f4811389c30bdc\",\"quote\":\"may\",\"start\":80733},{\"end\":81128,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:80719:81128:sha256-70dbc2b58f06de175a08772f0c59a3156ae80dadd36392ab723db6240714be25\",\"quote\":\"The Secretary may waive the limitation contained in paragraph (1) upon a State request for such a waiver, if the Secretary finds that the request describes extraordinary circumstances to justify the purchase of land or the construction of facilities (or the making of permanent improvements) and that permitting the waiver will contribute to the ability of the State to carry out the purposes of this chapter.\",\"start\":80719}],\"id\":\"urn:rulespec:document-understanding:revision:daa523ffa7b47de361cd826f6b4dc57dd52e2ae2e766b7f3c26f8f0f2562b4dd\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"permission\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:8cc21fc698001a004d81e3aec5ff169ad66353c167be7a0cd302a310a426926d\",\"modality\":\"may\",\"modality_quote\":\"may\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:48ed17c659c8ea28ddd4a26df42a433ea2340ea5047f01f60407fc9eead7ccd1\",\"origin\":\"aiSuggested\",\"quote\":\"The Secretary may waive the limitation contained in paragraph (1) upon a State request for such a waiver, if the Secretary finds that the request describes extraordinary circumstances to justify the purchase of land or the construction of facilities (or the making of permanent improvements) and that permitting the waiver will contribute to the ability of the State to carry out the purposes of this chapter.\",\"references\":[\"paragraph (1)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:5985da84de878529baf0382c323bcd0b21be2aee1671bd55ca7b984a59a31b46\",\"scope_quotes\":[\"The Secretary may waive the limitation contained in paragraph (1) upon a State request for such a waiver, if the Secretary finds that the request describes extraordinary circumstances to justify the purchase of land or the construction of facilities (or the making of permanent improvements) and that permitting the waiver will contribute to the ability of the State to carry out the purposes of this chapter.\"],\"scope_text\":\"upon a State request for such a waiver, if the Secretary finds that the request describes extraordinary circumstances to justify the purchase of land or the construction of facilities (or the making of permanent improvements) and that permitting the waiver will contribute to the ability of the State to carry out the purposes of this chapter\",\"section_id\":\"urn:rulespec:document-understanding:section:c2d7d2b3c184cf50d82366ce65cb8d6112ac79f92281542f43e74ba5049712d4\",\"start\":80719,\"summary\":\"The Secretary may waive the limitation contained in paragraph (1) upon a State request for such a waiver, if the Secretary finds that the request describes extraordinary circumstances to justify the purchase of land or the construction of facilities (or the making of permanent improvements) and that permitting the waiver will contribute to the ability of the State to carry out the purposes of this chapter.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

      "dcterms:description": "{\"action\":\"\",\"actor\":\"The Secretary\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:f4aa29970414b8e45ca2784ca86af83ca264c817b447f3022a6f357c5ff57096\",\"urn:rulespec:document-understanding:assertion:2215c2efb4c7b7fd99aa626cc4f20a4db24d3d91454131a7cbdae564aa2754cd\",\"urn:rulespec:document-understanding:assertion:1f028a01aef425bda85997246cf50ccc6d07a3aeb35148eaa67ddc1adbcd87cc\",\"urn:rulespec:document-understanding:assertion:037be916448e826ad7ed180b15fcd9ae2f678355fab98dec1612c7250e4c6934\",\"urn:rulespec:document-understanding:assertion:9d03b585db813766f7ae6b631ba00cf2076d610b0f42c064220a959fbb487216\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":100593,\"evidence\":[{\"end\":100112,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:100076:100112:sha256-5c4fa0260cf3562af3e87741f8f065246b6ea8e7184ea1182d24116ee479c2c8\",\"quote\":\"(2) Greater available appropriations\",\"start\":100076},{\"end\":100235,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:100113:100235:sha256-0294a65becc188b40e74b654402e9866c3cf9bd7d94ea71f98cd9fecfbda59ab\",\"quote\":\"Any amounts appropriated for a fiscal year to carry out this section in excess of $6,000,000 shall be allotted as follows:\",\"start\":100113},{\"end\":100251,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:100237:100251:sha256-9c42fb46ddf93b999d39103000936dbcb7ffda46cd45642986088a12333f6098\",\"quote\":\"(A) Allotments\",\"start\":100237},{\"end\":100593,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:100253:100593:sha256-a1282becf22f0f75ef22146ff27e52c79d852d4e22f621b6668a90c72131c584\",\"quote\":\"The Secretary shall use 40 percent of such excess to allot for grants under subsection (a) to eligible agencies for statewide programs in each State an amount that bears the same ratio to 40 percent of such excess as the low-income and unemployed population of such State bears to the low-income and unemployed population of all the States.\",\"start\":100253},{\"end\":100266,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:100253:100266:sha256-d6dd2bb6d3c44b4545cc3f97cb6f8a38842ecd30d2c58ec3e1c53a8c1a0ac77c\",\"quote\":\"The Secretary\",\"start\":100253},{\"end\":100112,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:100076:100112:sha256-5c4fa0260cf3562af3e87741f8f065246b6ea8e7184ea1182d24116ee479c2c8\",\"quote\":\"(2) Greater available appropriations\",\"start\":100076},{\"end\":100235,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:100113:100235:sha256-0294a65becc188b40e74b654402e9866c3cf9bd7d94ea71f98cd9fecfbda59ab\",\"quote\":\"Any amounts appropriated for a fiscal year to carry out this section in excess of $6,000,000 shall be allotted as follows:\",\"start\":100113}],\"id\":\"urn:rulespec:document-understanding:revision:337ccf3bcfa231bb7c82a8adb7378b0bb9cf02c8b82bdb8bd22068e47391f8cd\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:9d03b585db813766f7ae6b631ba00cf2076d610b0f42c064220a959fbb487216\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:4b0a2aabb61aaf672d63064a7d1bd006bb98f3d179bd8d1b97187e1705492ff3\",\"origin\":\"aiSuggested\",\"quote\":\"(2) Greater available appropriations Any amounts appropriated for a fiscal year to carry out this section in excess of $6,000,000 shall be allotted as follows:\\n\\n(A) Allotments\\n\\nThe Secretary shall use 40 percent of such excess to allot for grants under subsection (a) to eligible agencies for statewide programs in each State an amount that bears the same ratio to 40 percent of such excess as the low-income and unemployed population of such State bears to the low-income and unemployed population of all the States.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:f01ab68dae619de6f78597cc2d4f6ec4f936fdb32c3df978cddb80f797d9411d\",\"scope_quotes\":[\"(2) Greater available appropriations Any amounts appropriated for a fiscal year to carry out this section in excess of $6,000,000 shall be allotted as follows:\"],\"scope_text\":\"Any amounts appropriated for a fiscal year to carry out this section in excess of $6,000,000\",\"section_id\":\"urn:rulespec:document-understanding:section:cad1a9ce814f7bc8d23a6ff48e1865a684b16830bcf049a10118a7b6cab89b15\",\"start\":100076,\"summary\":\"When amounts appropriated for a fiscal year to carry out this section exceed $6,000,000, the Secretary shall use 40 percent of such excess to allot for grants under subsection (a) to eligible agencies for statewide programs in each State an amount that bears the same ratio to 40 percent of such excess as the low-income and unemployed population of such State bears to the low-income and unemployed population of all the States.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"the State\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:3d9a7fac5426a4a9770e04bbc4e3f374e5cfed9c855900703f1ec4ff8a2c5ce3\",\"urn:rulespec:document-understanding:assertion:161ec92ff6388e910acb543b7cf4da8e90a73a538acb74b8143a2875f72342c8\",\"urn:rulespec:document-understanding:assertion:8462cfb454408e8fb0d2d5089b362dd3f607a08890f3df1aac56d19ad099e3f0\",\"urn:rulespec:document-understanding:assertion:b1019b34370979193e73f74be84e73b2eed3a4741e7024ba3ad15b1f34b748a0\",\"urn:rulespec:document-understanding:assertion:0c3f16dc768886f675ba83a4f44d096939712bce1ba666aa1600c9c0f894809d\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":66217,\"evidence\":[{\"end\":65697,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:65683:65697:sha256-821875740dcc88c64698494aba68e2c0df4c8e0344d861f75db1c3aa2bab9fff\",\"quote\":\"(a) In general\",\"start\":65683},{\"end\":65937,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:65698:65937:sha256-6ebdc7fd475d36546f6b2d5aded717f4cd807a570a1ce6120506ae6d22c87db1\",\"quote\":\"In order to determine whether eligible entities meet the performance goals, administrative standards, financial management requirements, and other requirements of a State, the State shall conduct the following reviews of eligible entities:\",\"start\":65698},{\"end\":66217,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:65939:66217:sha256-e9e305a324323ede4354eaaba489c76d770d08ae3e8bb14fe995eb7f83a5ddc1\",\"quote\":\"(1) A full onsite review of each such entity at least once during each 3-year period.\\n\\n(2) An onsite review of each newly designated entity immediately after the completion of the first year in which such entity receives funds through the community services block grant program.\",\"start\":65939},{\"end\":65879,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:65870:65879:sha256-b25ac3a3200d1b12b577827b3daca4cc1dbfb9dc07d0af8b19b9d897125aa638\",\"quote\":\"the State\",\"start\":65870},{\"end\":65885,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:65880:65885:sha256-56ee5b508706bf2de91712d85d6d1e11ddbff01949142ed6e8c22e3b1bed1c71\",\"quote\":\"shall\",\"start\":65880},{\"end\":65697,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:65683:65697:sha256-821875740dcc88c64698494aba68e2c0df4c8e0344d861f75db1c3aa2bab9fff\",\"quote\":\"(a) In general\",\"start\":65683},{\"end\":65937,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:65698:65937:sha256-6ebdc7fd475d36546f6b2d5aded717f4cd807a570a1ce6120506ae6d22c87db1\",\"quote\":\"In order to determine whether eligible entities meet the performance goals, administrative standards, financial management requirements, and other requirements of a State, the State shall conduct the following reviews of eligible entities:\",\"start\":65698}],\"id\":\"urn:rulespec:document-understanding:revision:f8427905331519b9bd7777527c36ae7de9cd5cf4e70032636d5d636c4e4eccc1\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:0c3f16dc768886f675ba83a4f44d096939712bce1ba666aa1600c9c0f894809d\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:7773a58b75925f7fa2d0bc22073443f4ea06e211e746baa7e31bf47b89780dac\",\"origin\":\"aiSuggested\",\"quote\":\"(a) In general In order to determine whether eligible entities meet the performance goals, administrative standards, financial management requirements, and other requirements of a State, the State shall conduct the following reviews of eligible entities:\\n\\n(1) A full onsite review of each such entity at least once during each 3-year period.\\n\\n(2) An onsite review of each newly designated entity immediately after the completion of the first year in which such entity receives funds through the community services block grant program.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:b832ede4fa447b6f3aadd3a36c4626c4c4a1d56fb824dee7634108709f32155b\",\"scope_quotes\":[\"(a) In general In order to determine whether eligible entities meet the performance goals, administrative standards, financial management requirements, and other requirements of a State, the State shall conduct the following reviews of eligible entities:\"],\"scope_text\":\"In order to determine whether eligible entities meet the performance goals, administrative standards, financial management requirements, and other requirements of a State\",\"section_id\":\"urn:rulespec:document-understanding:section:c0349af1123d989776fe253553df69642696cd32996dd791c280bdbf3d513641\",\"start\":65683,\"summary\":\"In order to determine whether eligible entities meet the performance goals, administrative standards, financial management requirements, and other requirements of a State, the State shall conduct an onsite review of each newly designated entity immediately after the completion of the first year in which such entity receives funds through the community services block grant program.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

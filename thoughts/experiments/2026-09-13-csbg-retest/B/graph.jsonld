    {
      "@id": "urn:rulespec:document-understanding:scope:0138907ab7adf5268047ff3465c3b9dee72968741d931528d2d372fd5925809d",
      "@type": "rkaf:ApplicabilityScope",
      "rkaf:appliesInJurisdiction": [],
      "rkaf:applicabilityCondition": "With respect to applications for grants under subsection (a)"
    },
    {
      "@id": "urn:rulespec:document-understanding:assertion:e9054f81a41ee745982a7c63e2df1e6a6907b42deb4822ae474dbafa6c1551b9",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:4b80bc242bf4108132092097a8f5b641e6a56bd640c5f048e8bbcbf82862ca04",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:bc313875f8641fa1e56f9241762379751a49fc4be4a4a417a8121b0bdf8258f7",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:77c34d174a32f150ddb03293c89b8f3253bc45a11e832e0d1926ac416cd0ed82",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:states-requirement",
      "rkaf:assertsValue": {
        "@value": "Grants under 42 U.S.C. 9925(a) may be made only with respect to applications which involve activities that can be incorporated into or be closely coordinated with eligible entities' ongoing programs; involve significant new combinations of resources or new and innovative approaches involving partnership agreements; are structured in a way that will, within the limits of the type of assistance or activities contemplated, most fully and effectively promote the purposes of the Community Services Block Grant Act; and contain an assurance that the applicant for such grants will obtain an independent, methodologically sound evaluation of the effectiveness of the activities carried out with such grant and will submit such evaluation to the Secretary.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },
    {

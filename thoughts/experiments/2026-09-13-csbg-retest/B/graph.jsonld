    {
      "@id": "urn:rulespec:document-understanding:revision:085483b785e40dd7fde48b593501317130530169b07b61fde1ad20ae26d52947",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:085483b785e40dd7fde48b593501317130530169b07b61fde1ad20ae26d52947",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:7f402f40e72e3604f30062a32e43451fc3adfc3f3e694d7767d80b22943f9b7a",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"The Secretary\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:4ddf6a593a907f6d7a2790324dc5e025c5870333bf2c094c3a69672d61f50715\",\"urn:rulespec:document-understanding:assertion:6ea37f850a592bdca565b768079ce499e406ed96e455bb64fa48374a4417599c\",\"urn:rulespec:document-understanding:assertion:a8122d07efd880d413710304892608e18999bfe3fbe3b29e5be724189d593b16\",\"urn:rulespec:document-understanding:assertion:ea81646adf0e0cec0a6602ae813b46e3cc00add5c452ab9a4d98bba6f78a376a\",\"urn:rulespec:document-understanding:assertion:2400f2c9565580c4dcee1bfa5c014ac45de034cf3920c8ec7e6e1d64d908c235\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":100816,\"evidence\":[{\"end\":100112,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:100076:100112:sha256-5c4fa0260cf3562af3e87741f8f065246b6ea8e7184ea1182d24116ee479c2c8\",\"quote\":\"(2) Greater available appropriations\",\"start\":100076},{\"end\":100235,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:100113:100235:sha256-0294a65becc188b40e74b654402e9866c3cf9bd7d94ea71f98cd9fecfbda59ab\",\"quote\":\"Any amounts appropriated for a fiscal year to carry out this section in excess of $6,000,000 shall be allotted as follows:\",\"start\":100113},{\"end\":100251,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:100237:100251:sha256-9c42fb46ddf93b999d39103000936dbcb7ffda46cd45642986088a12333f6098\",\"quote\":\"(A) Allotments\",\"start\":100237},{\"end\":100651,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:100253:100651:sha256-978f071079c0619102a2d1f6608a09bef41092feef21729f28471f6c220bb871\",\"quote\":\"The Secretary shall use 40 percent of such excess to allot for grants under subsection (a) to eligible agencies for statewide programs in each State an amount that bears the same ratio to 40 percent of such excess as the low-income and unemployed population of such State bears to the low-income and unemployed population of all the States.\\n\\n\\n(B) Competitive grants for local and statewide programs\",\"start\":100253},{\"end\":100816,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:100653:100816:sha256-0bfab57559634bc879174ae5c3430c1a168a5d98b0675be7f751ce1b001754cd\",\"quote\":\"The Secretary shall use 40 percent of such excess to make grants under subsection (a) on a competitive basis to eligible agencies for local and statewide programs.\",\"start\":100653},{\"end\":100112,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:100076:100112:sha256-5c4fa0260cf3562af3e87741f8f065246b6ea8e7184ea1182d24116ee479c2c8\",\"quote\":\"(2) Greater available appropriations\",\"start\":100076},{\"end\":100235,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:100113:100235:sha256-0294a65becc188b40e74b654402e9866c3cf9bd7d94ea71f98cd9fecfbda59ab\",\"quote\":\"Any amounts appropriated for a fiscal year to carry out this section in excess of $6,000,000 shall be allotted as follows:\",\"start\":100113}],\"id\":\"urn:rulespec:document-understanding:revision:085483b785e40dd7fde48b593501317130530169b07b61fde1ad20ae26d52947\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:2400f2c9565580c4dcee1bfa5c014ac45de034cf3920c8ec7e6e1d64d908c235\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:2c1c9fb539a0e471aea6a5a3ce1e36dc191ba8f74d2f0384d75e5cefa24cea1a\",\"origin\":\"aiSuggested\",\"quote\":\"(2) Greater available appropriations Any amounts appropriated for a fiscal year to carry out this section in excess of $6,000,000 shall be allotted as follows:\\n\\n(A) Allotments\\n\\nThe Secretary shall use 40 percent of such excess to allot for grants under subsection (a) to eligible agencies for statewide programs in each State an amount that bears the same ratio to 40 percent of such excess as the low-income and unemployed population of such State bears to the low-income and unemployed population of all the States.\\n\\n\\n(B) Competitive grants for local and statewide programs\\n\\nThe Secretary shall use 40 percent of such excess to make grants under subsection (a) on a competitive basis to eligible agencies for local and statewide programs.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:ab38a7134fcb51bc6f2e7f7abb89d076cb72006075008a6a1be9c13cda9a38b4\",\"scope_quotes\":[\"(2) Greater available appropriations Any amounts appropriated for a fiscal year to carry out this section in excess of $6,000,000 shall be allotted as follows:\"],\"scope_text\":\"Any amounts appropriated for a fiscal year to carry out this section in excess of $6,000,000\",\"section_id\":\"urn:rulespec:document-understanding:section:cad1a9ce814f7bc8d23a6ff48e1865a684b16830bcf049a10118a7b6cab89b15\",\"start\":100076,\"summary\":\"When amounts appropriated for a fiscal year to carry out this section exceed $6,000,000, the Secretary shall use 40 percent of such excess to make grants under subsection (a) on a competitive basis to eligible agencies for local and statewide programs.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

    {
      "@id": "urn:rulespec:document-understanding:assertion:5d1d098c227a35b8b761334e82d1eb5be5113c42ec32f5d5579366552733fd28",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:4b80bc242bf4108132092097a8f5b641e6a56bd640c5f048e8bbcbf82862ca04",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:3d5314ddf0c5e8d85fc2ad1f82947fc8923794f629e4490f8a1e58bdaf444e17",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:cff60be81ce2cdd4e193dd5466a4ad8e8d9a7e9856e25ff5e4872ef02a4efdcc",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"actor\":\"a State\",\"kind\":\"requirement\",\"modality\":\"must\",\"scope_text\":\"Beginning with fiscal year 2000, to be eligible to receive a grant or allotment under section 9905 or 9906 of this title\",\"summary\":\"Beginning with fiscal year 2000, the State's application and plan submitted to be eligible for a grant or allotment under section 9905 or 9906 of this title must contain an assurance that the State and eligible entities in the State will coordinate and establish linkages between governmental and other social services programs to assure effective delivery and avoid duplication, and a description of how the State and eligible entities will coordinate the provision of employment and training activities (as defined in section 3 of the Workforce Innovation and Opportunity Act) in the State and communities with entities providing activities through statewide and local workforce development systems under that Act.\"}",
        "@type": "xsd:string"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed",
      "rkaf:hasApplicability": "urn:rulespec:document-understanding:scope:dd7c1818b57327538a957baed6ff52091d9f9e712a6eb96149c9cc05d67144bc"
    },

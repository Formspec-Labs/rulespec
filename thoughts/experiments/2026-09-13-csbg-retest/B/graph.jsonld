    {
      "@id": "urn:rulespec:document-understanding:revision:875984b755569097e3d8d0250aad50342d37fada56dd32ba2e09dc4ad6ca6423",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:875984b755569097e3d8d0250aad50342d37fada56dd32ba2e09dc4ad6ca6423",

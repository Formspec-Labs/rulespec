    {
      "@id": "urn:rulespec:document-understanding:revision:1e2a0055f0f25889640e76286dbd0e6a2b715f37a83201e4ab627b6227bbd86a",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:1e2a0055f0f25889640e76286dbd0e6a2b715f37a83201e4ab627b6227bbd86a",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:88744ac5988a97f9a4fdae5d0216520f0df33895b22bb87c1077bfaf501408dc",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"the Secretary\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:44c58e7384ad1739b7d2dd93952ed258439d6f21c326f778fb88dbfe7fc2fb54\",\"urn:rulespec:document-understanding:assertion:5d34f8f895473880d743d7262e4c59268ad8585ef05067839d0bb3fab5e5d6e0\",\"urn:rulespec:document-understanding:assertion:9873d04bea3a6acda514aceaaa7262e3a95f70d85076c23beea5b54f8c4e9a78\",\"urn:rulespec:document-understanding:assertion:630247ba578027cd4b052fef4e7c2f3066d280fe6d555b7a7a8eef84ae16ea88\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":70543,\"evidence\":[{\"end\":70543,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:70027:70543:sha256-91e604693d4c823d306166a3982ca7c6f673309ef90fea1a5da82f8a9f83ed3a\",\"quote\":\"A determination to terminate the designation or reduce the funding of an eligible entity is reviewable by the Secretary. The Secretary shall, upon request, review such a determination. The review shall be completed not later than 90 days after the Secretary receives from the State all necessary documentation relating to the determination to terminate the designation or reduce the funding. If the review is not completed within 90 days, the determination of the State shall become final at the end of the 90th day.\",\"start\":70027}],\"id\":\"urn:rulespec:document-understanding:revision:1e2a0055f0f25889640e76286dbd0e6a2b715f37a83201e4ab627b6227bbd86a\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:630247ba578027cd4b052fef4e7c2f3066d280fe6d555b7a7a8eef84ae16ea88\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:8c6c5b18818de289693ad09bc654ba68abe68b1e621e637bf55efe9a614a6355\",\"origin\":\"aiSuggested\",\"quote\":\"A determination to terminate the designation or reduce the funding of an eligible entity is reviewable by the Secretary. The Secretary shall, upon request, review such a determination. The review shall be completed not later than 90 days after the Secretary receives from the State all necessary documentation relating to the determination to terminate the designation or reduce the funding. If the review is not completed within 90 days, the determination of the State shall become final at the end of the 90th day.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:14e32c6ac4d8c972fb54b22911339ed01db1f402dcf54fdee6f79223a1c75369\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"urn:rulespec:document-understanding:section:237b538fca368735fd9d07469584e65428d74fd94b694e39006074ead5c84559\",\"start\":70027,\"summary\":\"The review of a determination to terminate designation or reduce funding shall be completed not later than 90 days after the Secretary receives from the State all necessary documentation relating to the determination to terminate the designation or reduce the funding.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

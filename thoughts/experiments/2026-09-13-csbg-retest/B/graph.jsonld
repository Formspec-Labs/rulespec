    {
      "@id": "urn:rulespec:document-understanding:assertion:f072d6cc28c59bc73aa6aea9c4af9d042412b37d9094ca5cdd4dd5b61cd52600",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:4b80bc242bf4108132092097a8f5b641e6a56bd640c5f048e8bbcbf82862ca04",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:316f1f3feca7570c79d2b5e529a0d71a9ac993af4e481522e7807e3839fda03a",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:83fe163b989064a3b87487e77f55ea0367da49cb49b9768e43c250a398e64783",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"actor\":\"the entity\",\"alternative_quotes\":[\"(1) a tripartite board, which shall have members selected by the organization and shall be composed so as to assure that not fewer than ⅓ of the members are persons chosen in accordance with democratic selection procedures adequate to assure that these members—\\n\\n(A) are representative of low-income individuals and families in the neighborhood served;\\n\\n(B) reside in the neighborhood served; and\\n\\n(C) are able to participate actively in the development, planning, implementation, and evaluation of programs funded under this chapter; or\",\"(2) another mechanism specified by the State to assure decisionmaking and participation by low-income individuals in the development, planning, implementation, and evaluation of programs funded under this chapter.\"],\"choice_text\":\"The public organization must administer the community services block grant program through either (1) a tripartite board meeting specified composition requirements or (2) another mechanism specified by the State.\",\"kind\":\"requirement\",\"modality\":\"must\",\"scope_text\":\"In order for a public organization to be considered to be an eligible entity for purposes of section 9902(1) of this title\",\"summary\":\"In order for a public organization to be considered to be an eligible entity for purposes of section 9902(1) of this title, the entity must administer the community services block grant program through either (1) a tripartite board, which must have members selected by the organization and must be composed so as to assure that not fewer than ⅓ of the members are persons chosen in accordance with democratic selection procedures adequate to assure that these members (A) are representative of low-income individuals and families in the neighborhood served, (B) reside in the neighborhood served, and (C) are able to participate actively in the development, planning, implementation, and evaluation of programs funded under this chapter; or (2) another mechanism specified by the State to assure decisionmaking and participation by low-income individuals in the development, planning, implementation, and evaluation of programs funded under this chapter.\"}",
        "@type": "xsd:string"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed",
      "rkaf:hasApplicability": "urn:rulespec:document-understanding:scope:8049c8420486928865fd5ced0d335c16273c43418e7ba4252f048b335e5f5e36"
    },

    },
    {
      "@id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:54969:55384:sha256-cda433f67d8f3b607d9affecc9a429dde53af6459e82bc3e65db8cee13a0e26d",
      "@type": "rkaf:SourceFragment",
      "oa:hasSource": "urn:rulespec:document-understanding:document:26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023",
      "rkaf:fragmentIdentityScheme": "rkaf:carrier-local-fragment",
      "rkaf:sourceArtifactDigest": "sha256:26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023",
      "rkaf:fragmentContentDigest": "sha256:cda433f67d8f3b607d9affecc9a429dde53af6459e82bc3e65db8cee13a0e26d",
      "rkaf:selectorKind": [
        "oa:TextQuoteSelector",
        "oa:TextPositionSelector"
      ],
      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "(A) ⅓ of the members of the board are elected public officials, holding office on the date of selection, or their representatives, except that if the number of such elected officials reasonably available and willing to serve on the board is less than ⅓ of the membership of the board, membership on the board of appointive public officials or their representatives may be counted in meeting such ⅓ requirement;\n\n(B)"
        },
        {
          "@type": "oa:TextPositionSelector",
          "oa:start": 54969,
          "oa:end": 55384,
          "rkaf:coordinateSystem": "rkaf:unicode-codepoint"
        }
      ]
    },
    {
      "@id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:55386:56015:sha256-188345e3b9db32fb00744442d9f8e5d1ce43c1fc6fde6b59bf859d15854c5d7e",
      "@type": "rkaf:SourceFragment",
      "oa:hasSource": "urn:rulespec:document-understanding:document:26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023",
      "rkaf:fragmentIdentityScheme": "rkaf:carrier-local-fragment",
      "rkaf:sourceArtifactDigest": "sha256:26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023",
      "rkaf:fragmentContentDigest": "sha256:188345e3b9db32fb00744442d9f8e5d1ce43c1fc6fde6b59bf859d15854c5d7e",
      "rkaf:selectorKind": [
        "oa:TextQuoteSelector",
        "oa:TextPositionSelector"
      ],
      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "(i) not fewer than ⅓ of the members are persons chosen in accordance with democratic selection procedures adequate to assure that these members are representative of low-income individuals and families in the neighborhood served; and\n\n(ii) each representative of low-income individuals and families selected to represent a specific neighborhood within a community under clause (i) resides in the neighborhood represented by the member; and\n\n\n(C) the remainder of the members are officials or members of business, industry, labor, religious, law enforcement, education, or other major groups and interests in the community served."
        },
        {
          "@type": "oa:TextPositionSelector",
          "oa:start": 55386,
          "oa:end": 56015,
          "rkaf:coordinateSystem": "rkaf:unicode-codepoint"
        }
      ]
    },

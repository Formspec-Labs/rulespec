    {
      "@id": "urn:rulespec:document-understanding:binding:3e5cdab70b85e7c3d58d1d2001dddbe3e5ce2a5aefc96d66d0406aff5e4f2d81",
      "@type": "rkaf:EvidenceBinding",
      "rkaf:bindsAssertion": "urn:rulespec:document-understanding:assertion:da19b63a3bf3ba99f1191bcdc902dfe1dbe2ce8716126fa12d66a61f9ff051ef",

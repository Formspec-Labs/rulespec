      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"actor\":\"the Secretary\",\"kind\":\"requirement\",\"modality\":\"must\",\"scope_text\":\"Of the amount appropriated for a fiscal year to carry out this section (but not to exceed $6,000,000)\",\"summary\":\"Of the amount appropriated for a fiscal year to carry out this section (but not to exceed $6,000,000), the Secretary shall allot for grants to eligible agencies for statewide programs in each State, from a portion equal to 60 percent of such amount (but not to exceed $3,600,000), the amount that bears the same ratio to such portion as the low-income and unemployed population of such State bears to the low-income and unemployed population of all the States.\"}",
        "@type": "xsd:string"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed",
      "rkaf:hasApplicability": "urn:rulespec:document-understanding:scope:ab590f3c1909281080c3e85904906babfd13bfec28b5cb124b0416865fcfef6f"
    },

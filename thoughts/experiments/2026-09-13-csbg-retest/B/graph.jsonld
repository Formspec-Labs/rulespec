g%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:48080:48085:sha256-56ee5b508706bf2de91712d85d6d1e11ddbff01949142ed6e8c22e3b1bed1c71\",\"quote\":\"shall\",\"start\":48080},{\"end\":48346,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:47961:48346:sha256-ccacad5ea3c940de64ddf962065946de9b2ed898fa6d7c1ff6ccb0bc1ae99ec4\",\"quote\":\"For fiscal year 2000, to be eligible to receive a grant or allotment under section 9905 or 9906 of this title, a State shall prepare and submit to the Secretary an application and State plan in accordance with the provisions of this chapter (as in effect on the day before October 27, 1998), rather than the provisions of subsections (a) through (c) relating to applications and plans.\",\"start\":47961}],\"id\":\"urn:rulespec:document-understanding:revision:f67046f88c32aca2ceba1dc2b4e0b5771ffcca219cd9a668c5296d725ea2272d\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:66cf5e0dd530d5184ee957a0975ba0d3f86ccd7bc9df69868361e51a1ce9f02c\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:b47a9a6df76aeb1774119bbb0935efd4ccca71147da67fc041aa56b4108b2689\",\"origin\":\"aiSuggested\",\"quote\":\"For fiscal year 2000, to be eligible to receive a grant or allotment under section 9905 or 9906 of this title, a State shall prepare and submit to the Secretary an application and State plan in accordance with the provisions of this chapter (as in effect on the day before October 27, 1998), rather than the provisions of subsections (a) through (c) relating to applications and plans.\",\"references\":[\"section 9905\",\"section 9906\",\"subsections (a) through (c)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:0573244691ef5025797235d624728e1ee8d3f0c4091a1184b8739157408f6304\",\"scope_quotes\":[\"For fiscal year 2000, to be eligible to receive a grant or allotment under section 9905 or 9906 of this title, a State shall prepare and submit to the Secretary an application and State plan in accordance with the provisions of this chapter (as in effect on the day before October 27, 1998), rather than the provisions of subsections (a) through (c) relating to applications and plans.\"],\"scope_text\":\"For fiscal year 2000, to be eligible to receive a grant or allotment under section 9905 or 9906 of this title\",\"section_id\":\"urn:rulespec:document-understanding:section:0b55006ce2c906add8328d3986f73bcd1ded9a87a908d01ae85b5595b9018d1b\",\"start\":47961,\"summary\":\"For fiscal year 2000, to be eligible to receive a grant or allotment under section 9905 or 9906 of this title, a State shall prepare and submit to the Secretary an application and State plan in accordance with the provisions of this chapter (as in effect on the day before October 27, 1998), rather than the provisions of subsections (a) through (c) relating to applications and plans.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

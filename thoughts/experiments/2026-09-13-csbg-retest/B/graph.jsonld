      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"the political subdivision\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:9035cba62eafd6b69738f4665778efbbdaded165799b29312afefaeb9509db0c\",\"urn:rulespec:document-understanding:assertion:51e0afef448bf3a10e2664007bcc3d9fa9c702fd4087fe970e62a958e3c72fe1\",\"urn:rulespec:document-understanding:assertion:e3a136450322c36206182bee7d3e7da84d27e802a0e602f8be9cc20e485b381c\",\"urn:rulespec:document-understanding:assertion:449f924f7da2c621b7d235afa4db517d6e731215681a9439c2f095833cecbdf9\",\"urn:rulespec:document-understanding:assertion:fffe15367c8312571992d8bbcf4cdd4970a0efde4c7c0ca9fade66e231e2da56\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":53660,\"evidence\":[{\"end\":53660,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:53206:53660:sha256-ddb73ce1975e3100655a3d0112384d33e68535c9148ffc1c78d8f5179c67e1a1\",\"quote\":\"If no private, nonprofit organization is identified or determined to be qualified under subsection (a) to serve the unserved area as an eligible entity the chief executive officer may designate an appropriate political subdivision of the State to serve as an eligible entity for the area. In order to serve as the eligible entity for that area, the political subdivision shall have a board or other mechanism as required in section 9910(b) of this title.\",\"start\":53206},{\"end\":53576,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:53551:53576:sha256-dae92698511950d8a49507e6ebe47c8366d4c4145478fc5ea49212c8773f4d8e\",\"quote\":\"the political subdivision\",\"start\":53551},{\"end\":53582,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:53577:53582:sha256-56ee5b508706bf2de91712d85d6d1e11ddbff01949142ed6e8c22e3b1bed1c71\",\"quote\":\"shall\",\"start\":53577},{\"end\":53660,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:53206:53660:sha256-ddb73ce1975e3100655a3d0112384d33e68535c9148ffc1c78d8f5179c67e1a1\",\"quote\":\"If no private, nonprofit organization is identified or determined to be qualified under subsection (a) to serve the unserved area as an eligible entity the chief executive officer may designate an appropriate political subdivision of the State to serve as an eligible entity for the area. In order to serve as the eligible entity for that area, the political subdivision shall have a board or other mechanism as required in section 9910(b) of this title.\",\"start\":53206}],\"id\":\"urn:rulespec:document-understanding:revision:555a16a27e9db94913c1c75eaee2e9bcda11e65f4f0430a61ddc61ee96faea4e\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:fffe15367c8312571992d8bbcf4cdd4970a0efde4c7c0ca9fade66e231e2da56\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:c3665adc34f8e944b07ad76879c772e50fa9d212104e63b28b2a72133f36c9c0\",\"origin\":\"aiSuggested\",\"quote\":\"If no private, nonprofit organization is identified or determined to be qualified under subsection (a) to serve the unserved area as an eligible entity the chief executive officer may designate an appropriate political subdivision of the State to serve as an eligible entity for the area. In order to serve as the eligible entity for that area, the political subdivision shall have a board or other mechanism as required in section 9910(b) of this title.\",\"references\":[\"section 9910(b)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:cfb5fa6ea2a4630fc978587cb09889a1a7d29534269f38d9a879c030e6c96f92\",\"scope_quotes\":[\"If no private, nonprofit organization is identified or determined to be qualified under subsection (a) to serve the unserved area as an eligible entity the chief executive officer may designate an appropriate political subdivision of the State to serve as an eligible entity for the area. In order to serve as the eligible entity for that area, the political subdivision shall have a board or other mechanism as required in section 9910(b) of this title.\"],\"scope_text\":\"In order to serve as the eligible entity for that area\",\"section_id\":\"urn:rulespec:document-understanding:section:b8000f1ee8341d7eccdb1b202ebee86bddd6c2a58344891bf3dfbc5b7909fb1a\",\"start\":53206,\"summary\":\"In order to serve as the eligible entity for that area, the political subdivision designated to serve as an eligible entity when no private nonprofit organization is qualified under subsection (a) shall have a board or other mechanism as required in section 9910(b) of this title.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

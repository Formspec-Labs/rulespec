      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"such entity\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:da0aa7cdcc1c67316980f4155094399dcc2c8b56be63ba5cc7ec3ca4603e0731\",\"urn:rulespec:document-understanding:assertion:3ff7f47571d344bfa8b42e7ebb3db28f1854225462a8d58be328f61cee93b0fd\",\"urn:rulespec:document-understanding:assertion:9e861cd0fc9cdeb472335bd996096926170ea152707c7484b9c202a2778fb8d2\",\"urn:rulespec:document-understanding:assertion:d20aced36c501896b6e882a363c606294b1d984cf80b70d2dd14d91f05289d63\",\"urn:rulespec:document-understanding:assertion:2bebd42fe04ec42f23443e2f5d7eef42a3f1e008c6b2d5d4579c55eaee677f42\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":87367,\"evidence\":[{\"end\":86948,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:86908:86948:sha256-e200c260a581cab743b8870e8e767a86bfa157f8e1b720d3266a3fa5107b8421\",\"quote\":\"(b) Child support services and referrals\",\"start\":86908},{\"end\":87071,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:86949:87071:sha256-f18e6329dd831ce0db3eb747c51e6dad3d9ee42cbac01b65b147ef530f58bc2f\",\"quote\":\"During each fiscal year for which an eligible entity receives a grant under section 9907 of this title, such entity shall—\",\"start\":86949},{\"end\":87367,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:87073:87367:sha256-1b0e31e9b9021ee496dfc233d6068f8bfc19ed3bddbe7325c540d10c84d6f323\",\"quote\":\"(1) inform custodial parents in single-parent families that participate in programs, activities, or services carried out or provided under this chapter about the availability of child support services; and\\n\\n(2) refer eligible parents to the child support offices of State and local governments.\",\"start\":87073},{\"end\":87064,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:87053:87064:sha256-410fc3f18e8c99392951c86488ea1cefb2b632159295da2abc1b6b8b7798ed6d\",\"quote\":\"such entity\",\"start\":87053},{\"end\":87070,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:87065:87070:sha256-56ee5b508706bf2de91712d85d6d1e11ddbff01949142ed6e8c22e3b1bed1c71\",\"quote\":\"shall\",\"start\":87065},{\"end\":86948,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:86908:86948:sha256-e200c260a581cab743b8870e8e767a86bfa157f8e1b720d3266a3fa5107b8421\",\"quote\":\"(b) Child support services and referrals\",\"start\":86908},{\"end\":87071,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:86949:87071:sha256-f18e6329dd831ce0db3eb747c51e6dad3d9ee42cbac01b65b147ef530f58bc2f\",\"quote\":\"During each fiscal year for which an eligible entity receives a grant under section 9907 of this title, such entity shall—\",\"start\":86949}],\"id\":\"urn:rulespec:document-understanding:revision:f1114aca1060eea62b3ba7c30e9babe3859bd6de2771eed26fb1beca65390547\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:2bebd42fe04ec42f23443e2f5d7eef42a3f1e008c6b2d5d4579c55eaee677f42\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:db1bb74363289eeeb4b6160238d29f6b5feecdc567380c17fe94be0792143a0e\",\"origin\":\"aiSuggested\",\"quote\":\"(b) Child support services and referrals During each fiscal year for which an eligible entity receives a grant under section 9907 of this title, such entity shall—\\n\\n(1) inform custodial parents in single-parent families that participate in programs, activities, or services carried out or provided under this chapter about the availability of child support services; and\\n\\n(2) refer eligible parents to the child support offices of State and local governments.\",\"references\":[\"section 9907 of this title\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:b61efaab31698f9e2496b0a4d5dcc69820b0d3b7abd228f91235f3ab471b094c\",\"scope_quotes\":[\"(b) Child support services and referrals During each fiscal year for which an eligible entity receives a grant under section 9907 of this title, such entity shall—\"],\"scope_text\":\"During each fiscal year for which an eligible entity receives a grant under section 9907 of this title\",\"section_id\":\"urn:rulespec:document-understanding:section:214ad60901a587753e79aabc24ace858a542d5405e31b466690ba730688916c0\",\"start\":86908,\"summary\":\"During each fiscal year for which an eligible entity receives a grant under section 9907 of this title, such entity shall refer eligible parents to the child support offices of State and local governments.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

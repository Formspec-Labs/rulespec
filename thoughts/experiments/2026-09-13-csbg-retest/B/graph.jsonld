      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"the Secretary\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:b2fb469b079fe2d993d04cbd984d9b8ac2b44d9f34bd8da3abd3e5fd9923da49\",\"urn:rulespec:document-understanding:assertion:7b1c69d68aa666dab60aae1a45dbd888caf6dab8f7e5b7d995326267009e0d15\",\"urn:rulespec:document-understanding:assertion:5f852e814482d3f51e0850cf3924e8a9b361f9f7cad51fefba54c54ccb660582\",\"urn:rulespec:document-understanding:assertion:fb3ea7e2c160eb5068e1602b386411736405abb83a35873f1235177a826e1314\",\"urn:rulespec:document-understanding:assertion:8da3324762e76f057a70de3b4cd341939c362c816d0452412ee6fc9b22b296f2\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":22794,\"evidence\":[{\"end\":22055,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:22030:22055:sha256-6cfd4b588a93bba09a1211c941bb513cf4fbd1667c78adb687f3ccea5c9902c4\",\"quote\":\"(a) Allotments in general\",\"start\":22030},{\"end\":22460,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:22056:22460:sha256-7af9b81f4443a2406710719cc067af906e8d0cf6274ee5f2e76facf8961cdcf3\",\"quote\":\"The Secretary shall, from the amount appropriated under section 9903(a) of this title for each fiscal year that remains after the Secretary makes the reservations required in section 9903(b) of this title, allot to each State (subject to section 9911 of this title) an amount that bears the same ratio to such remaining amount as the amount received by the State for fiscal year 1981 under section 2808 1\",\"start\":22056},{\"end\":22498,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:22462:22498:sha256-82a1f00ab9f241bcc5b63b8eff430fdb902e17c51a01d85e25a2659602172a39\",\"quote\":\"1 See References in Text note below.\",\"start\":22462},{\"end\":22611,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:22500:22611:sha256-656e54a1c2bb522e3be4e8d6d3c8c2851f1cf88ba7a87a2ab8a518e800291fb9\",\"quote\":\" of this title bore to the total amount received by all States for fiscal year 1981 under such section, except—\",\"start\":22500},{\"end\":22794,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:22613:22794:sha256-a82740fba7e11bec22e317608f44690612221ea196eae9f95e24896bc23b670f\",\"quote\":\"(1) that no State shall receive less than ¼ of 1 percent of the amount appropriated under section 9903(a) of this title for such fiscal year; and\\n\\n(2) as provided in subsection (b).\",\"start\":22613},{\"end\":22069,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:22056:22069:sha256-d6dd2bb6d3c44b4545cc3f97cb6f8a38842ecd30d2c58ec3e1c53a8c1a0ac77c\",\"quote\":\"The Secretary\",\"start\":22056}],\"id\":\"urn:rulespec:document-understanding:revision:4b68f1a057da354cc51ced1aa626ab2841e784e55479de689f938592e895dfbc\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:fb3ea7e2c160eb5068e1602b386411736405abb83a35873f1235177a826e1314\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:05bfb2c212979b87d91a06e6cc0e4387c9efcde20bb5c71c8b38711938b87145\",\"origin\":\"aiSuggested\",\"quote\":\"(a) Allotments in general The Secretary shall, from the amount appropriated under section 9903(a) of this title for each fiscal year that remains after the Secretary makes the reservations required in section 9903(b) of this title, allot to each State (subject to section 9911 of this title) an amount that bears the same ratio to such remaining amount as the amount received by the State for fiscal year 1981 under section 2808 1\\n\\n1 See References in Text note below.\\n\\n of this title bore to the total amount received by all States for fiscal year 1981 under such section, except—\\n\\n(1) that no State shall receive less than ¼ of 1 percent of the amount appropriated under section 9903(a) of this title for such fiscal year; and\\n\\n(2) as provided in subsection (b).\",\"references\":[\"9903(a)\",\"9903(b)\",\"9911\",\"2808\",\"subsection (b)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:d2911fb9402e1e08d1251e87698321c733feb0a1a7f64c1c5583743340d76b37\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"urn:rulespec:document-understanding:section:77b293a31882899a97687fe9cf87dc80be98be00fdc4957f7ebc1a1856d5f6c9\",\"start\":22030,\"summary\":\"From the amount appropriated under section 9903(a) of this title for each fiscal year that remains after making the reservations required in section 9903(b) of this title, the Secretary must allot to each State (subject to section 9911 of this title) an amount that bears the same ratio to such remaining amount as the amount received by the State for fiscal year 1981 under section 2808 of this title bore to the total amount received by all States for fiscal year 1981 under such section, except that no State shall receive less than 1/4 of 1 percent of the amount appropriated under section 9903(a) of this title for such fiscal year, and except as provided in subsection (b).\",\"target_ids\":[],\"term_refs\":[\"urn:rulespec:document-understanding:term:c3a6dc2397e2c0695b6af8b70bbc3d8d09172d19a96d71862190a71266dd8e8e\"],\"typed_values\":[]}",

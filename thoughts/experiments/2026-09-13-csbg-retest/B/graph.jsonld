      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"The eligible service provider\",\"alternative_quotes\":[\"(A) a community-based advisory committee is established, with representatives from local youth, family, and social service organizations, schools, entities providing park and recreation services, and other community-based organizations serving high-risk youth; or\",\"(B) an existing community-based advisory board, commission, or committee with similar membership is utilized to serve as the committee described in subparagraph (A); and\"],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:2b5063c2fd430e0805be0d7f8f91c361a7469a7997a798b49d659a0873735fa3\",\"urn:rulespec:document-understanding:assertion:986a876fdd0ac6f583f1db44356039890f098c075c7f9079a6aa54ee4e5eb9c7\",\"urn:rulespec:document-understanding:assertion:34782ae0bf38e6a073cfa381677a13c8f786cd264e2b20844cb24a8817df2d36\",\"urn:rulespec:document-understanding:assertion:5d0f86de4eb96cd334b62b65ee35e3f0ce0d36a1e49734921801d098eeb339f8\",\"urn:rulespec:document-understanding:assertion:d8aebe6df87f8d1c3aef2a5a6e710b591cd84d9b47ca16b99db8790e9ca8c15e\",\"urn:rulespec:document-understanding:assertion:1eb169d10037d14a364b03c67621049e18557f029251bfac19e6cb9557fd70c1\",\"urn:rulespec:document-understanding:assertion:2a9d2384f4021b825a0fe68c038cfbaf015578650d046c12529fa2a1d9f421cc\",\"urn:rulespec:document-understanding:assertion:1aab9e0f106088f7738750356fced47a1af9dce104a4a4e645d1a87a6de34570\"],\"choice_quote\":\"(1) ensure that—\\n\\n(A) a community-based advisory committee is established, with representatives from local youth, family, and social service organizations, schools, entities providing park and recreation services, and other community-based organizations serving high-risk youth; or\\n\\n(B) an existing community-based advisory board, commission, or committee with similar membership is utilized to serve as the committee described in subparagraph (A); and\",\"choice_text\":\"The eligible service provider must either ensure a community-based advisory committee is established with specified representatives, or ensure an existing community-based advisory board, commission, or committee with similar membership is utilized.\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":106306,\"evidence\":[{\"end\":105748,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:105712:105748:sha256-f9b9c116fcd48bea70cb53ac79681f2811f993db70466fbab9239943517e0b6b\",\"quote\":\"(c) Advisory committee; partnerships\",\"start\":105712},{\"end\":105852,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:105749:105852:sha256-cb157ba9c97c251f44ee82b13ad864ea761fede60323da0c6d4b616e702286b9\",\"quote\":\"The eligible service provider shall, in each community in which a program is funded under this section—\",\"start\":105749},{\"end\":105870,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:105854:105870:sha256-95f73eccbcb87b56eb2ca1d56081911438cb01df0446a25b8738612b20ffe77d\",\"quote\":\"(1) ensure that—\",\"start\":105854},{\"end\":106306,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:105872:106306:sha256-194ed051132c7902d9abf30de41ed32cf0e3d9eec8089a111b3a568e0cee0a90\",\"quote\":\"(A) a community-based advisory committee is established, with representatives from local youth, family, and social service organizations, schools, entities providing park and recreation services, and other community-based organizations serving high-risk youth; or\\n\\n(B) an existing community-based advisory board, commission, or committee with similar membership is utilized to serve as the committee described in subparagraph (A); and\",\"start\":105872},{\"end\":105778,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:105749:105778:sha256-33e0bdbc3c87c6a11104f895351b5ecced29a04349fb919e322e50f3fa95c673\",\"quote\":\"The eligible service provider\",\"start\":105749},{\"end\":105784,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:105779:105784:sha256-56ee5b508706bf2de91712d85d6d1e11ddbff01949142ed6e8c22e3b1bed1c71\",\"quote\":\"shall\",\"start\":105779},{\"end\":105870,\"field\":\"choice_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:105854:105870:sha256-95f73eccbcb87b56eb2ca1d56081911438cb01df0446a25b8738612b20ffe77d\",\"quote\":\"(1) ensure that—\",\"start\":105854},{\"end\":106306,\"field\":\"choice_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:105872:106306:sha256-194ed051132c7902d9abf30de41ed32cf0e3d9eec8089a111b3a568e0cee0a90\",\"quote\":\"(A) a community-based advisory committee is established, with representatives from local youth, family, and social service organizations, schools, entities providing park and recreation services, and other community-based organizations serving high-risk youth; or\\n\\n(B) an existing community-based advisory board, commission, or committee with similar membership is utilized to serve as the committee described in subparagraph (A); and\",\"start\":105872},{\"end\":105748,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:105712:105748:sha256-f9b9c116fcd48bea70cb53ac79681f2811f993db70466fbab9239943517e0b6b\",\"quote\":\"(c) Advisory committee; partnerships\",\"start\":105712},{\"end\":105852,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:105749:105852:sha256-cb157ba9c97c251f44ee82b13ad864ea761fede60323da0c6d4b616e702286b9\",\"quote\":\"The eligible service provider shall, in each community in which a program is funded under this section—\",\"start\":105749},{\"end\":106135,\"field\":\"alternative:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:105872:106135:sha256-21b43fabc53de0986af63c5585a08dc6399d781cabcd9e0016b60ddb50f7bd25\",\"quote\":\"(A) a community-based advisory committee is established, with representatives from local youth, family, and social service organizations, schools, entities providing park and recreation services, and other community-based organizations serving high-risk youth; or\",\"start\":105872},{\"end\":106306,\"field\":\"alternative:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:106137:106306:sha256-875429f8a987fa9f8b4fda82647218b5358fe1be6e1a490bd17f1f65cc0c0a25\",\"quote\":\"(B) an existing community-based advisory board, commission, or committee with similar membership is utilized to serve as the committee described in subparagraph (A); and\",\"start\":106137}],\"id\":\"urn:rulespec:document-understanding:revision:4e84b7250467738d5cf7d5c8d27afcecfa00529ea819c3048ed62d1a2be9a291\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:1aab9e0f106088f7738750356fced47a1af9dce104a4a4e645d1a87a6de34570\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:355c75e55272f2f21f8c058c767495efd2eff22128833fc795a4327ff38a72f3\",\"origin\":\"aiSuggested\",\"quote\":\"(c) Advisory committee; partnerships The eligible service provider shall, in each community in which a program is funded under this section—\\n\\n(1) ensure that—\\n\\n(A) a community-based advisory committee is established, with representatives from local youth, family, and social service organizations, schools, entities providing park and recreation services, and other community-based organizations serving high-risk youth; or\\n\\n(B) an existing community-based advisory board, commission, or committee with similar membership is utilized to serve as the committee described in subparagraph (A); and\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:fe3cf76c025e03e3dd3db3e917553dd7684732256a7535cf8cbdad0698b10edf\",\"scope_quotes\":[\"(c) Advisory committee; partnerships The eligible service provider shall, in each community in which a program is funded under this section—\"],\"scope_text\":\"in each community in which a program is funded under this section\",\"section_id\":\"urn:rulespec:document-understanding:section:f3eea5347c895856895eee6edec328881bdec01acc0faf09e4d4dd77b2ba0a81\",\"start\":105712,\"summary\":\"The eligible service provider shall, in each community in which a program is funded under this section, ensure that: (A) a community-based advisory committee is established, with representatives from local youth, family, and social service organizations, schools, entities providing park and recreation services, and other community-based organizations serving high-risk youth; or (B) an existing community-based advisory board, commission, or committee with similar membership is utilized to serve as the committee described in subparagraph (A).\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

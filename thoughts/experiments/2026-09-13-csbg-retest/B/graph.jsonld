      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:fd69db01fa9cd73781cd7d9f2aaf359a5a36a6c81d81e88e746718587a4eaf2e\",\"urn:rulespec:document-understanding:assertion:297fa6968c494a7162f5beadb4eb86db3f4ac651644b74688b13d8473bb0746a\",\"urn:rulespec:document-understanding:assertion:991eb9a45636bc2e11a67d392695a1f2a57f3363d31c77fa1b03a6774e70cc9d\",\"urn:rulespec:document-understanding:assertion:8102004eea304e5f2e43940a44dbe5460fea3aa77324e6044f5fbf31b9a5ec64\",\"urn:rulespec:document-understanding:assertion:ffd65cc252241cc5c2a82979adefe9b2286cf3d6ab9663b3270ce63ab08c1751\",\"urn:rulespec:document-understanding:assertion:1371d86d60e40abb0919ecd69c3bfc7e89b0620ef8679f90a690fee16dc91e2c\"],\"choice_quote\":\"(i) In general The term “qualified charity” means any organization—\\n\\n(I) that is—\\n\\n(aa) described in section 501(c)(3) of title 26 and exempt from tax under section 501(a) of such title;\\n\\n(bb) an eligible entity; or\\n\\n(cc) a public housing agency as defined in section 1437a(b)(6) of this title;\\n\\n\\n(II) that is certified by the appropriate State authority as meeting the requirements of clauses (iii) and (iv); and\\n\\n(III) if such organization is otherwise required to file a return under section 6033 of such title, that elects to treat the information required to be furnished by clause (v) as being specified in section 6033(b) of such title.\",\"choice_text\":\"To qualify, an organization must satisfy three conditions: (1) be either a 501(c)(3) tax-exempt entity, an eligible entity, or a public housing agency; (2) be certified by the appropriate State authority as meeting clauses (iii) and (iv); and (3) if otherwise required to file a return under section 6033, elect to treat information required by clause (v) as specified in section 6033(b).\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[{\"aliases\":[],\"id\":\"urn:rulespec:document-understanding:term:63469c0d2442b190f2220845329335cfed02029cc2785e1f3826c7ec59ec7182\",\"label\":\"qualified charity\",\"quote\":\"(i) In general The term “qualified charity” means any organization—\\n\\n(I) that is—\\n\\n(aa) described in section 501(c)(3) of title 26 and exempt from tax under section 501(a) of such title;\\n\\n(bb) an eligible entity; or\\n\\n(cc) a public housing agency as defined in section 1437a(b)(6) of this title;\\n\\n\\n(II) that is certified by the appropriate State authority as meeting the requirements of clauses (iii) and (iv); and\\n\\n(III) if such organization is otherwise required to file a return under section 6033 of such title, that elects to treat the information required to be furnished by clause (v) as being specified in section 6033(b) of such title.\",\"source_quotes\":[\"(B) Qualified charity\\n\\n(i) In general The term “qualified charity” means any organization—\\n\\n(I) that is—\\n\\n(aa) described in section 501(c)(3) of title 26 and exempt from tax under section 501(a) of such title;\\n\\n(bb) an eligible entity; or\\n\\n(cc) a public housing agency as defined in section 1437a(b)(6) of this title;\\n\\n\\n(II) that is certified by the appropriate State authority as meeting the requirements of clauses (iii) and (iv); and\\n\\n(III) if such organization is otherwise required to file a return under section 6033 of such title, that elects to treat the information required to be furnished by clause (v) as being specified in section 6033(b) of such title.\"]}],\"effective_periods\":[],\"end\":30231,\"evidence\":[{\"end\":29602,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:29588:29602:sha256-5b7a5118168f01eb0c113c4a86fb8eaaf3152b12972bcf36b8bf52bf0f5a8c4f\",\"quote\":\"(i) In general\",\"start\":29588},{\"end\":29655,\"field\":\"summary\",\"fragment_id\":\"urn:rka
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:3d5314ddf0c5e8d85fc2ad1f82947fc8923794f629e4490f8a1e58bdaf444e17",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:a6425c59223bd9e1bdd8ea56aa56f66a9f9110b66f317ecf7715ccf0eeca0cf8",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"defined_terms\":[{\"id\":\"urn:rulespec:document-understanding:term:079616ed8d6d9aa90bf9f36ba14c8bf60612c1552530087f2f7df47e57d4cfbf\",\"label\":\"cause\",\"quote\":\"(c) Funding termination or reductions For purposes of making a determination in accordance with subsection (b)(8) with respect to—\\n\\n(1) a funding reduction, the term “cause” includes—\\n\\n(A) a statewide redistribution of funds provided through a community services block grant under this chapter to respond to—\\n\\n(i) the results of the most recently available census or other appropriate data;\\n\\n(ii) the designation of a new eligible entity; or\\n\\n(iii) severe economic dislocation; or\\n\\n\\n(B) the failure of an eligible entity to comply with the terms of an agreement or a State plan, or to meet a State requirement, as described in section 9915(a) of this title; and\",\"source_quotes\":[\"(c) Funding termination or reductions For purposes of making a determination in accordance with subsection (b)(8) with respect to—\\n\\n(1) a funding reduction, the term “cause” includes—\\n\\n(A) a statewide redistribution of funds provided through a community services block grant under this chapter to respond to—\\n\\n(i) the results of the most recently available census or other appropriate data;\\n\\n(ii) the designation of a new eligible entity; or\\n\\n(iii) severe economic dislocation; or\\n\\n\\n(B) the failure of an eligible entity to comply with the terms of an agreement or a State plan, or to meet a State requirement, as described in section 9915(a) of this title; and\"]}],\"kind\":\"definition\",\"modality\":\"not_stated\",\"scope_text\":\"For purposes of making a determination in accordance with subsection (b)(8) with respect to a funding reduction\",\"summary\":\"For purposes of making a determination in accordance with subsection (b)(8) with respect to a funding reduction, the term “cause” includes: (A) a statewide redistribution of funds provided through a community services block grant under this chapter to respond to (i) the results of the most recently available census or other appropriate data, (ii) the designation of a new eligible entity, or (iii) severe economic dislocation; or (B) the failure of an eligible entity to comply with the terms of an agreement or a State plan, or to meet a State requirement, as described in section 9915(a) of this title.\"}",
        "@type": "xsd:string"
      },

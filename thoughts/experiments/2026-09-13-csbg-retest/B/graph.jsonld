      "dcterms:description": "{\"action\":\"\",\"actor\":\"State\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:8a4bdb7b73ee421b2de4d256a7cc0320a0e6efdee20b277746e49004df537545\",\"urn:rulespec:document-understanding:assertion:d9e897863106049a734737f6b4442e720ba05918259907b4a6fc8a0eb9497cc4\",\"urn:rulespec:document-understanding:assertion:5c0c29c83ebc03f6eea8fdd5fb02645bf456920f040d51fc04e798773e8a3232\",\"urn:rulespec:document-understanding:assertion:64eddefa6cb8ed13b229e6b3e39742e058f68d115ac00909e9f6514576096de8\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":28646,\"evidence\":[{\"end\":28646,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:27936:28646:sha256-0ccc78999d8251cfc48e1f2d8bfd523cb624c053da648e5d37cde8b989f627d0\",\"quote\":\"No State may spend more than the greater of $55,000, or 5 percent, of the grant received under section 9905 of this title or State allotment received under section 9906 of this title for administrative expenses, including monitoring activities. Funds to be spent for such expenses shall be taken from the portion of the grant under section 9905 of this title or State allotment that remains after the State makes grants to eligible entities under subsection (a). The cost of activities conducted under paragraph (1)(A) shall not be considered to be administrative expenses. The startup cost and cost of administrative activities conducted under subsection (c) shall be considered to be administrative expenses.\",\"start\":27936},{\"end\":27948,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:27936:27948:sha256-341784b
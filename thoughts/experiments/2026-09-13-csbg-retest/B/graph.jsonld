    {
      "@id": "urn:rulespec:document-understanding:revision:4cb01e8d189df720557d716c44c4949b86f95768ef2745e5ab4e053a84a05eaa",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:4cb01e8d189df720557d716c44c4949b86f95768ef2745e5ab4e053a84a05eaa",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:5062edf4ddc0564ab79e1dfc056b25bf253ce75b48eb3e03831b994feb8c56ae",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"Neither the Federal Government nor a State or local government\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:dd9280ab3d8cf9599618bf132e451ef51ba31dad2a398bf3671f0b2ff65a7e6c\",\"urn:rulespec:document-understanding:assertion:bde8486acd8366991650aebddfb10ddd846d59925b7a2eba2cfa02b5226f382f\",\"urn:rulespec:document-understanding:assertion:51e7b3992d717d37af58932b80f5d2785cf0e8fabb1e07769d61f9ab6fc761e4\",\"urn:rulespec:document-understanding:assertion:b462dd068b844b8808086f03dba02c9a6957dd830b1c59c9d8a9ba8f4f720449\",\"urn:rulespec:document-understanding:assertion:8544f648fabf590b78da1103c1621cca759ad66b7f569a8be4d3ba4541bb212e\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[\"For any program carried out by the Federal Government, or by a State or local government under this chapter, the government shall consider, on the same basis as other nongovernmental organizations, religious organizations to provide the assistance under the program, so long as the program is implemented in a manner consistent with the Establishment Clause of the first amendment to the Constitution. Neither the Federal Government nor a State or local government receiving funds under this chapter shall discriminate against an organization that provides assistance under, or applies to provide assistance under, this chapter, on the basis that the organization has a religious character.\"],\"defined_terms\":[],\"effective_periods\":[],\"end\":89020,\"evidence\":[{\"end\":88579,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:88554:88579:sha256-90a0bb9c6c106a0aada6fb6731f55c84564a14a985f3b5028fdca5c19c791f96\",\"quote\":\"(2) Additional safeguards\",\"start\":88554},{\"end\":88682,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:88580:88682:sha256-58fe8a511c69f548a69d1e81096a99aa0092183262e46937acbfa93547f8da91\",\"quote\":\"Neither the Federal Government nor a State or local government shall require a religious organization—\",\"start\":88580},{\"end\":89020,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:88684:89020:sha256-a84b6eaf57681d26bd43f8006087ef31c69186d17b56a2dc7b81d7c4a66a3b7b\",\"quote\":\"(A) to alter its form of internal governance, except (for purposes of administration of the community services block grant program) as provided in section 9910 of this title; or\\n\\n(B) to remove religious art, icons, scripture, or other symbols;\\n\\n\\nin order to be eligible to provide assistance under a program described in subsection (a).\",\"start\":88684},{\"end\":88642,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:88580:88642:sha256-df36c3a66c306eb8a018ea99c140821adc451c1d4a1650744ffd578f9c30f0a8\",\"quote\":\"Neither the Federal Government nor a State or local government\",\"start\":88580},{\"end\":88656,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:88580:88656:sha256-e9ef654d25d41b7ec6b756866ce69471a049c6189903236dce6de055f33c9a8b\",\"quote\":\"Neither the Federal Government nor a State or local government shall require\",\"start\":88580},{\"end\":89020,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:88930:89020:sha256-e8ac75d12e5eb9b3ea85e274c27297592735aa78676b365097f1a3338aef0a1c\",\"quote\":\"in order to be eligible to provide assistance under a program described in subsection (a).\",\"start\":88930},{\"end\":88263,\"field\":\"context:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:87573:88263:sha256-7f698273643ebaac09dd116e5fd1cab7db7c4e700d5aca2c7489efe5e05abd4a\",\"quote\":\"For any program carried out by the Federal Government, or by a State or local government under this chapter, the government shall consider, on the same basis as other nongovernmental organizations, religious organizations to provide the assistance under the program, so long as the program is implemented in a manner consistent with the Establishment Clause of the first amendment to the Constitution. Neither the Federal Government nor a State or local government receiving funds under this chapter shall discriminate against an organization that provides assistance under, or applies to provide assistance under, this chapter, on the basis that the organization has a religious character.\",\"start\":87573}],\"id\":\"urn:rulespec:document-understanding:revision:4cb01e8d189df720557d716c44c4949b86f95768ef2745e5ab4e053a84a05eaa\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"prohibition\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:8544f648fabf590b78da1103c1621cca759ad66b7f569a8be4d3ba4541bb212e\",\"modality\":\"must_not\",\"modality_quote\":\"Neither the Federal Government nor a State or local government shall require\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:03a785cdb8e688063b07a33557e913bd365ed04605f56fdfbf9f9c5ace358aed\",\"origin\":\"aiSuggested\",\"quote\":\"(2) Additional safeguards Neither the Federal Government nor a State or local government shall require a religious organization—\\n\\n(A) to alter its form of internal governance, except (for purposes of administration of the community services block grant program) as provided in section 9910 of this title; or\\n\\n(B) to remove religious art, icons, scripture, or other symbols;\\n\\n\\nin order to be eligible to provide assistance under a program described in subsection (a).\",\"references\":[\"section 9910\",\"subsection (a)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:cff33c49130674a584d6f253b112d921161f8c010c78dec4d119ab95d37fef16\",\"scope_quotes\":[\"in order to be eligible to provide assistance under a program described in subsection (a).\"],\"scope_text\":\"in order to be eligible to provide assistance under a program described in subsection (a)\",\"section_id\":\"urn:rulespec:document-understanding:section:cfe00c4667f8a705b619c6842c9a05b4aaa1e3ace7adcf5723b0c39c5a6aa621\",\"start\":88554,\"summary\":\"Neither the Federal Government nor a State or local government shall require a religious organization to alter its form of internal governance, except (for purposes of administration of the community services block grant program) as provided in section 9910 of this title, or to remove religious art, icons, scripture, or other symbols, in order to be eligible to provide assistance under a program carried out by the Federal Government, or by a State or local government under this chapter.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

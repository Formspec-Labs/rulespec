      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"Secretary\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:ce40760916a5606ace5b107d4a51b9e54dca3c6a49644ecbeb4c6e8fb997dc42\",\"urn:rulespec:document-understanding:assertion:76548aa0245d2139c9632ce3a81c1152356ce6dd3959fcb28e56d16ca4d79b52\",\"urn:rulespec:document-understanding:assertion:0cfe66a58bbbffb112069d636b7abddfd3529e23e7b5d30e36aadd02177befeb\",\"urn:rulespec:document-understanding:assertion:006fde194beac46bfd12f4c401d23d58520e98f088a0c2faed6719b3de4abeaa\",\"urn:rulespec:document-understanding:assertion:e786fa55f90291989040ff838b9dc78cef7f216c0dfe29231c8ea91e9cbe2435\",\"urn:rulespec:document-understanding:assertion:d478a8d248d6bdf4744babb7656e2013efc364114e3bc23ce589fe1962778867\",\"urn:rulespec:document-understanding:assertion:0310115e0c63984996f320283c2e5fc8794e0e4153a5edd461c4f1252edff37d\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":117265,\"evidence\":[{\"end\":117265,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:116727:117265:sha256-0a3ab17af9d270604f78e7351d8e0dd59922957cd740a6a7205e7341f7c20dea\",\"quote\":\"As soon as practicable, but not later than 180 days after the end of the fiscal year in which a recipient of a grant under this section completes the expenditure of such grant, the Secretary shall prepare and make available to each State and each eligible entity a description of the program carried out with such grant, any relevant information developed and results achieved, and a summary of the evaluation of such program received under subsection (a)(1)(D) so as to provide a model of innovative programs for other eligible entities.\",\"start\":116727},{\"end\":116917,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:116904:116917:sha256-67afe9d5c4310238267da793c265a616f9e90d554f2458a8065b7bb971d853b5\",\"quote\":\"the Secretary\",\"start\":116904},{\"end\":116923,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:116918:116923:sha256-56ee5b508706bf2de91712d85d6d1e11ddbff01949142ed6e8c22e3b1bed1c71\",\"quote\":\"shall\",\"start\":116918},{\"end\":117265,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:116727:117265:sha256-0a3ab17af9d270604f78e7351d8e0dd59922957cd740a6a7205e7341f7c20dea\",\"quote\":\"As soon as practicable, but not later than 180 days after the end of the fiscal year in which a recipient of a grant under this section completes the expenditure of such grant, the Secretary shall prepare and make available to each State and each eligible entity a description of the program carried out with such grant, any relevant information developed and results achieved, and a summary of the evaluation of such program received under subsection (a)(1)(D) so as to provide a model of innovative programs for other eligible entities.\",\"start\":116727}],\"id\":\"urn:rulespec:document-understanding:revision:be961d7b66258833173101191d08a21510c240e9bcc0b47c8988f89438865473\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:e786fa55f90291989040ff838b9dc78cef7f216c0dfe29231c8ea91e9cbe2435\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:07013deefcc0e9e2b1ca5b0220c3643ce4078bcb43326dfa195f2f720af99171\",\"origin\":\"aiSuggested\",\"quote\":\"As soon as practicable, but not later than 180 days after the end of the fiscal year in which a recipient of a grant under this section completes the expenditure of such grant, the Secretary shall prepare and make available to each State and each eligible entity a description of the program carried out with such grant, any relevant information developed and results achieved, and a summary of the evaluation of such program received under subsection (a)(1)(D) so as to provide a model of innovative programs for other eligible entities.\",\"references\":[\"subsection (a)(1)(D)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:33a9a1ab55ff5bc18bfad164afd3fda8df2def27ad3035c77d9863c6432b285c\",\"scope_quotes\":[\"As soon as practicable, but not later than 180 days after the end of the fiscal year in which a recipient of a grant under this section completes the expenditure of such grant, the Secretary shall prepare and make available to each State and each eligible entity a description of the program carried out with such grant, any relevant information developed and results achieved, and a summary of the evaluation of such program received under subsection (a)(1)(D) so as to provide a model of innovative programs for other eligible entities.\"],\"scope_text\":\"After the end of the fiscal year in which a recipient of a grant under this section completes the expenditure of such grant\",\"section_id\":\"urn:rulespec:document-understanding:section:5fba676d6775544d7cae048a3634eb9fe091aa0a96f2f732b41f08ff944d6890\",\"start\":116727,\"summary\":\"As soon as practicable, but not later than 180 days after the end of the fiscal year in which a recipient of a grant under 42 U.S.C. 9925 completes the expenditure of such grant, the Secretary shall prepare and make available to each State and each eligible entity a description of the program carried out with such grant, any relevant information developed and results achieved, and a summary of the evaluation of such program received under subsection (a)(1)(D) so as to provide a model of innovative programs for other eligible entities.\",\"target_ids\":[],\"term_refs\":[\"urn:rulespec:document-understanding:term:576e9257cb479321316fb378bb4b88ddb844dc1e33b39dc213b46732e75aa46c\",\"urn:rulespec:document-understanding:term:2b4a0e0f50499d8d1d3fc49284b4a8396f8bd249309fd91a3f8a3916e278ef08\"],\"typed_values\":[]}",

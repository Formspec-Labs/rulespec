      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"the Secretary\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:afb1bba113939ee0bf34e51ead4fb56ab373f60a1f8eaae2e8f7969405a2a666\",\"urn:rulespec:document-understanding:assertion:a6eb55e688875fb605c7ce526f8caaebd5da701b5d8bcd1906b5c427aac9b4fc\",\"urn:rulespec:document-understanding:assertion:b1cadca9ac6a80c498dc9840c281584daa7d580cf10bd1244a0d654c4e8d5bc5\",\"urn:rulespec:document-understanding:assertion:acfdb3cdc0cb9a594b9f535a74985f4ffe3eb7476b671b051a1fc0858a069bb1\",\"urn:rulespec:document-understanding:assertion:e1ead6d8907fbafa3a2568820e7e9d939af33b949bc68bf6fd3d7f219e7b9eb2\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":18614,\"evidence\":[{\"end\":18614,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:18273:18614:sha256-a3d3f052872e8d9256074d5ace2c4242f68823f46832260c52b0f6e735a62af3\",\"quote\":\"(B) ½ of the remainder of the amount reserved by the Secretary under this paragraph shall be used by the Secretary to carry out evaluation and to assist States in carrying out corrective action activities and monitoring (to correct programmatic deficiencies of eligible entities), as described in sections 9914(c) and 9913 of this title; and\",\"start\":18273},{\"end\":18370,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:18357:18370:sha256-62a0d14945d59ee214a5af08fd631f1e285c8cf69cc01e8561958e470e80ecf0\",\"quote\":\"shall be used\",\"start\":18357},{\"end\":17668,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:17652:17668:sha256-74fda605329d9b1ceb4fc23f202c17e0235b89f64f355a31862ab1a252852db2\",\"quote\":\"(b) Reservations\",\"start\":17652},{\"end\":17768,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:17669:17768:sha256-52e40889c206e95327235a9da3d28d4bc66f4b76274d478cbed27729f4c0dbe7\",\"quote\":\"Of the amounts appropriated under subsection (a) for each fiscal year, the Secretary shall reserve—\",\"start\":17669},{\"end\":17969,\"field\":\"scope_text:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:17874:17969:sha256-f6a1bacd7ebe59bc871f6b1fdffd4ac3332e0b231c37822c5e67c2a01c271213\",\"quote\":\"(2) 1½ percent for activities authorized in sections 9913 through 9918 of this title, of which—\",\"start\":17874}],\"id\":\"urn:rulespec:document-understanding:revision:7bbd3f05a4dbc82cd12f7a01f3d9d38be93af41c82101fa358818d5e8f09f4b8\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:e1ead6d8907fbafa3a2568820e7e9d939af33b949bc68bf6fd3d7f219e7b9eb2\",\"modality\":\"must\",\"modality_quote\":\"shall be used\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:d22587715943cc769fc58b1d925bc03aa99df50278a4fc55231bd583eb7e526a\",\"origin\":\"aiSuggested\",\"quote\":\"(B) ½ of the remainder of the amount reserved by the Secretary under this paragraph shall be used by the Secretary to carry out evaluation and to assist States in carrying out corrective action activities and monitoring (to correct programmatic deficiencies of eligible entities), as described in sections 9914(c) and 9913 of this title; and\",\"references\":[\"sections 9914(c) and 9913 of this title\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:f4906db8979ed38f524b3e903477f4cec0a404ba466fc306d2b3ff57fae59604\",\"scope_quotes\":[\"(b) Reservations Of the amounts appropriated under subsection (a) for each fiscal year, the Secretary shall reserve—\",\"(2) 1½ percent for activities authorized in sections 9913 through 9918 of this title, of which—\"],\"scope_text\":\"Of the amounts appropriated under subsection (a) for each fiscal year, of the 1½ percent reserved under paragraph (2)\",\"section_id\":\"urn:rulespec:document-understanding:section:12fca79c614e56d4c2834f93ce1a7d98eff6aeadfd069e9f4c6aeffa5285544c\",\"start\":18273,\"summary\":\"Of the 1 1/2 percent reserved under 42 U.S.C. 9903(b)(2) from amounts appropriated under subsection (a) for each fiscal year, 1/2 of the remainder of that reserved amount shall be used by the Secretary to carry out evaluation and to assist States in carrying out corrective action activities and monitoring (to correct programmatic deficiencies of eligible entities), as described in sections 9914(c) and 9913 of this title.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

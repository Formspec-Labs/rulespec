      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"Secretary\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:3f2cad649d84f6dc91a47cc09fff70edd46d31a4775da87cb7ebee5051e0f8f3\",\"urn:rulespec:document-understanding:assertion:9fbeed377de78279ffcb8e64fad143965e601398309bf1a301a5cc43bb9dc393\",\"urn:rulespec:document-understanding:assertion:7347eaf9ad68ad6f26464aa2af40ba3e115b5a01c8bf033fe120e9e7e27326da\",\"urn:rulespec:document-understanding:assertion:4416c0e2689f709c220f0e5a6f44ddd222c99fb7cc62e49d0dcdae6304e682ed\",\"urn:rulespec:document-understanding:assertion:559c7628a928deead00901020f28a876c1a6f4290ea282231e8925bf17f85318\",\"urn:rulespec:document-understanding:assertion:b53bf3f4a4d3ee1a7a43155fd995776909fb7ea3433ed70a330fef667d8df380\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":112427,\"evidence\":[{\"end\":112427,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:111706:112427:sha256-faacd91b9e43b9b4bf2cfe238a1afcd06418b51a05c41d8467c42e6187cadd67\",\"quote\":\"(1) In order to stimulate the development of new approaches to provide for greater self-sufficiency of the poor, to test and evaluate such new approaches, to disseminate project results and evaluation findings so that such approaches can be replicated, and to strengthen the integration, coordination, and redirection of activities to promote maximum self-sufficiency among the poor, the Secretary may make grants from funds appropriated under subsection (e) to eligible entities for the development and implementation of new and innovative approaches to deal with particularly critical needs or problems of the poor which are common to a number of communities. Grants may be made only with respect to applications which—\",\"start\":111706},{\"end\":112103,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:112090:112103:sha256-67afe9d5c4310238267da793c265a616f9e90d554f2458a8065b7bb971d853b5\",\"quote\":\"the Secretary\",\"start\":112090}],\"id\":\"urn:rulespec:document-understanding:revision:fed19385f50c4f60618ad06a7029e80a461e04d85c874357d3f17135a40fe4be\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"permission\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:4416c0e2689f709c220f0e5a6f44ddd222c99fb7cc62e49d0dcdae6304e682ed\",\"modality\":\"may\",\"modality_quote\":\"may\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:5f4aa0fe52923fa2f296467d9b79882ec91439bf3b2efe21e47b842fb7793096\",\"origin\":\"aiSuggested\",\"quote\":\"(1) In order to stimulate the development of new approaches to provide for greater self-sufficiency of the poor, to test and evaluate such new approaches, to disseminate project results and evaluation findings so that such approaches can be replicated, and to strengthen the integration, coordination, and redirection of activities to promote maximum self-sufficiency among the poor, the Secretary may make grants from funds appropriated under subsection (e) to eligible entities for the development and implementation of new and innovative approaches to deal with particularly critical needs or problems of the poor which are common to a number of communities. Grants may be made only with respect to applications which—\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:e115de0612f939e33c6335b06416598ab776fbaf23ab0b92854ff4f7a382d7ed\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"urn:rulespec:document-understanding:section:5fba676d6775544d7cae048a3634eb9fe091aa0a96f2f732b41f08ff944d6890\",\"start\":111706,\"summary\":\"In order to stimulate the development of new approaches to provide for greater self-sufficiency of the poor, to test and evaluate such new approaches, to disseminate project results and evaluation findings so that such approaches can be replicated, and to strengthen the integration, coordination, and redirection of activities to promote maximum self-sufficiency among the poor, the Secretary may make grants from funds appropriated under subsection (e) to eligible entities for the development and implementation of new and innovative approaches to deal with particularly critical needs or problems of the poor which are common to a number of communities.\",\"target_ids\":[],\"term_refs\":[\"urn:rulespec:document-understanding:term:576e9257cb479321316fb378bb4b88ddb844dc1e33b39dc213b46732e75aa46c\",\"urn:rulespec:document-understanding:term:2b4a0e0f50499d8d1d3fc49284b4a8396f8bd249309fd91a3f8a3916e278ef08\"],\"typed_values\":[]}",

      ]
    },
    {
      "@id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:41609:45774:sha256-275411d429cc018c308d5f795e14cdf806924eabbbb1d1e2ded58398a702cdde",

      "rkaf:assertsValue": {
        "@value": "{\"actor\":\"the Secretary\",\"kind\":\"requirement\",\"modality\":\"must\",\"summary\":\"The review of a determination to terminate designation or reduce funding shall be completed not later than 90 days after the Secretary receives from the State all necessary documentation relating to the determination to terminate the designation or reduce the funding.\"}",
        "@type": "xsd:string"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

      "rkaf:assertsValue": {
        "@value": "{\"kind\":\"requirement\",\"modality\":\"must\",\"scope_text\":\"Except as otherwise provided by the appropriate State authority, for purposes of subclause (I), if the location and provision of services in the form of donations of food or meals, or temporary shelter to homeless individuals, are such that the service provider may reasonably conclude that beneficiaries are predominantly individuals described in subclause (I).\",\"summary\":\"Except as otherwise provided by the appropriate State authority, for purposes of subclause (I), services to individuals in the form of donations of food or meals, or temporary shelter to homeless individuals, shall be treated as provided to individuals described in subclause (I) if the location and provision of such services are such that the service provider may reasonably conclude that the beneficiaries of such services are predominantly individuals described in subclause (I).\"}",
        "@type": "xsd:string"
      },

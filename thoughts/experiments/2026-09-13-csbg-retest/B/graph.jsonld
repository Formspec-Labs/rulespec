      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:9db2d0a4c3f533cc1a07c2c35083fc63185e160cb6cbd11bc56ce95587d5f367\",\"urn:rulespec:document-understanding:assertion:9a2ee9d24e29f927d6ff75100b64b2be880c862793adbf10d7ba649fe81dcc82\",\"urn:rulespec:document-understanding:assertion:47b87355bc396e46263bca3a980c87475d1c36ac6335a78b21610443f8d9c0a1\",\"urn:rulespec:document-understanding:assertion:5663909d939e397a7903d33abcccf4931e7163de43e1abf47cee9d8cf5c8b0fd\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":71229,\"evidence\":[{\"end\":71229,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:70569:71229:sha256-839e4147687db874cf158bdb26785077263ea2b10ebf9d4a38d9764d33527775\",\"quote\":\"Whenever a State violates the assurances contained in section 9908(b)(8) of this title and terminates or reduces the funding of an eligible entity prior to the completion of the State hearing described in that section and the Secretary’s review as required in subsection (b), the Secretary is authorized to provide financial assistance under this chapter to the eligible entity affected until the violation is corrected. In such a case, the grant or allotment for the State under section 9905 or 9906 of this title for the earliest appropriate fiscal year shall be reduced by an amount equal to the funds provided under this subsection to such eligible entity.\",\"start\":70569},{\"end\":71130,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:71125:71130:sha256-56ee5b508706bf2de91712d85d6d1e11ddbff01949142ed6e8c22e3b1bed1c71\",\"quote\":\"shall\",\"start\":71125},{\"end\":71229,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:70569:71229:sha256-839e4147687db874cf158bdb26785077263ea2b10ebf9d4a38d9764d33527775\",\"quote\":\"Whenever a State violates the assurances contained in section 9908(b)(8) of this title and terminates or reduces the funding of an eligible entity prior to the completion of the State hearing described in that section and the Secretary’s review as required in subsection (b), the Secretary is authorized to provide financial assistance under this chapter to the eligible entity affected until the violation is corrected. In such a case, the grant or allotment for the State under section 9905 or 9906 of this title for the earliest appropriate fiscal year shall be reduced by an amount equal to the funds provided under this subsection to such eligible entity.\",\"start\":70569}],\"id\":\"urn:rulespec:document-understanding:revision:2ef07d2bfb71fd87601795aa03b7aae97b5720645085841db4ff9d1d468ff353\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:5663909d939e397a7903d33abcccf4931e7163de43e1abf47cee9d8cf5c8b0fd\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:138d9a0e6cfb9a2f705d83721bf7284e54062f23f828064190d1c4f860549711\",\"origin\":\"aiSuggested\",\"quote\":\"Whenever a State violates the assurances contained in section 9908(b)(8) of this title and terminates or reduces the funding of an eligible entity prior to the completion of the State hearing described in that section and the Secretary’s review as required in subsection (b), the Secretary is authorized to provide financial assistance under this chapter to the eligible entity affected until the violation is corrected. In such a case, the grant or allotment for the State under section 9905 or 9906 of this title for the earliest appropriate fiscal year shall be reduced by an amount equal to the funds provided under this subsection to such eligible entity.\",\"references\":[\"section 9905 or 9906 of this title\",\"this subsection\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:ff936acf25e096f0b6cbe09a25ac746dd9f5dc5246bc9a7bbf1e25f438d14a24\",\"scope_quotes\":[\"Whenever a State violates the assurances contained in section 9908(b)(8) of this title and terminates or reduces the funding of an eligible entity prior to the completion of the State hearing described in that section and the Secretary’s review as required in subsection (b), the Secretary is authorized to provide financial assistance under this chapter to the eligible entity affected until the violation is corrected. In such a case, the grant or allotment for the State under section 9905 or 9906 of this title for the earliest appropriate fiscal year shall be reduced by an amount equal to the funds provided under this subsection to such eligible entity.\"],\"scope_text\":\"In such a case\",\"section_id\":\"urn:rulespec:document-understanding:section:237b538fca368735fd9d07469584e65428d74fd94b694e39006074ead5c84559\",\"start\":70569,\"summary\":\"In a case where the Secretary provides financial assistance to an eligible entity affected because a State violated the assurances in section 9908(b)(8) and terminated or reduced funding prior to completion of the State hearing and the Secretary's review, the grant or allotment for the State under section 9905 or 9906 of this title for the earliest appropriate fiscal year shall be reduced by an amount equal to the funds provided under this subsection to such eligible entity.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

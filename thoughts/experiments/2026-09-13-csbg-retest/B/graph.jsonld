      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"The lead agency\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:125dfef30691eacd3adca350cf18caf9c28a55ac31af21835810fc512d46ed18\",\"urn:rulespec:document-understanding:assertion:3c159ea1e955309e2fadb64820e1ecff43e5400ef6a744bd6d83bfda0d88607f\",\"urn:rulespec:document-understanding:assertion:2f14d49acfcd8a52f004bf748fddac84063d68ca7c9ed7712bf186f2734d4dc7\",\"urn:rulespec:document-understanding:assertion:bac31230314fff7a348c2f3210632c94d08f96e53a5f44176aeacf46b440816b\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":37492,\"evidence\":[{\"end\":36949,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:36939:36949:sha256-c1a6178974286f72d9fd740bd5be1b1a9b525125e9da974f338f146da94caab7\",\"quote\":\"(2) Duties\",\"start\":36939},{\"end\":36972,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:36950:36972:sha256-746ec0a9da99b2f1abfa1436e01eed1e11e74349301e8d968b26ec08c93d0d0a\",\"quote\":\"The lead agency shall—\",\"start\":36950},{\"end\":37492,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:36974:37492:sha256-e15e15c1f1deada0f444b88147a24507d47b69c8c2c1a5d35698396778b893ee\",\"quote\":\"(A) develop the State plan to be submitted to the Secretary under subsection (b);\\n\\n(B) in conjunction with the development of the State plan as required under subsection (b), hold at least one hearing in the State with sufficient time and statewide distribution of notice of such hearing, to provide to the public an opportunity to comment on the proposed use and distribution of funds to be provided through the grant or allotment under section 9905 or 9906 of this title for the period covered by the State plan; and\",\"start\":36974},{\"end\":36965,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:36950:36965:sha256-acd435c9913e2bd8c98dbbf6e320a08055ec7715d47ac6266620fede1211fce7\",\"quote\":\"The lead agency\",\"start\":36950},{\"end\":36971,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:36966:36971:sha256-56ee5b508706bf2de91712d85d6d1e11ddbff01949142ed6e8c22e3b1bed1c71\",\"quote\":\"shall\",\"start\":36966}],\"id\":\"urn:rulespec:document-understanding:revision:b7639d402844650ea7d4d3f0db67c9814183fab250e92af1c6abf5abee5a7d57\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:bac31230314fff7a348c2f3210632c94d08f96e53a5f44176aeacf46b440816b\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:341ad2ee7b95de42a49dc979957c7bcddc4b1bbeffa18dffc81ad7e7775bf2c9\",\"origin\":\"aiSuggested\",\"quote\":\"(2) Duties The lead agency shall—\\n\\n(A) develop the State plan to be submitted to the Secretary under subsection (b);\\n\\n(B) in conjunction with the development of the State plan as required under subsection (b), hold at least one hearing in the State with sufficient time and statewide distribution of notice of such hearing, to provide to the public an opportunity to comment on the proposed use and distribution of funds to be provided through the grant or allotment under section 9905 or 9906 of this title for the period covered by the State plan; and\",\"references\":[\"subsection (b)\",\"section 9905\",\"section 9906\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:487c9ab6ca442e6fd1b58fbbd5e7472b63feb2d352d345176e77d29b8f7b2284\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"urn:rulespec:document-understanding:section:0b55006ce2c906add8328d3986f73bcd1ded9a87a908d01ae85b5595b9018d1b\",\"start\":36939,\"summary\":\"In conjunction with the development of the State plan as required under subsection (b), the lead agency shall hold at least one hearing in the State with sufficient time and statewide distribution of notice of such hearing, to provide to the public an opportunity to comment on the proposed use and distribution of funds to be provided through the grant or allotment under section 9905 or 9906 of this title for the period covered by the State plan.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

      "rkaf:assertsValue": {
        "@value": "{\"actor\":\"The Secretary\",\"kind\":\"requirement\",\"modality\":\"must\",\"scope_text\":\"Any amounts appropriated for a fiscal year to carry out this section in excess of $6,000,000\",\"summary\":\"When amounts appropriated for a fiscal year to carry out this section exceed $6,000,000, the Secretary shall use the remaining 20 percent of such excess to make grants under subsection (a) on a competitive basis to eligible agencies for nationwide programs, including programs benefiting Indians, as defined in section 9911 of this title, and migrant or seasonal farmworkers.\"}",
        "@type": "xsd:string"
      },

      "rkaf:assertsValue": {
        "@value": "{\"actor\":\"a State\",\"kind\":\"requirement\",\"modality\":\"must\",\"scope_text\":\"Beginning with fiscal year 2000, to be eligible to receive a grant or allotment under section 9905 or 9906 of this title\",\"summary\":\"Beginning with fiscal year 2000, the State's application and plan submitted to be eligible for a grant or allotment under section 9905 or 9906 of this title must contain an assurance that funds made available through the grant or allotment will be used to make more effective use of, and coordinate with, other programs related to the purposes of this chapter (including State welfare reform efforts).\"}",
        "@type": "xsd:string"

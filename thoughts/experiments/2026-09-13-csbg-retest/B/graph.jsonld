      "dcterms:description": "{\"action\":\"\",\"actor\":\"The Secretary\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:b10a764ee2dde086d24d0e6bd6a62caf578b3f121b7e92a48f7f5dc01ed624ea\",\"urn:rulespec:document-understanding:assertion:44976612282d9d02f8dd153c7e838ec6f8c1a03365ec8ac48980abb6c495538b\",\"urn:rulespec:document-understanding:assertion:023bc4f4a6d0d9292b4341b127a39c3dcbb2c554cd3bbec3e47849bc4ac37674\",\"urn:rulespec:document-understanding:assertion:d3b91e2d6111b8e8fa71516b133c44e9e36ccc71354e17f941e42fabd0f7476d\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":74489,\"evidence\":[{\"end\":74489,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:73971:74489:sha256-b45f3bbc0f9e2bbc513ea28e61d058da702d9c1438b5183f56792be012b1c2d0\",\"quote\":\"The Secretary shall respond in an expeditious and speedy manner to complaints of a substantial or serious nature that a State has failed to use funds in accordance with the provisions of this chapter, including the assurances provided by the State under section 9908 of this title. For purposes of this paragraph, a complaint of a failure to meet any one of the assurances provided under section 9908 of this title that constitutes disregarding that assurance shall be considered to be a complaint of a serious nature.\",\"start\":73971},{\"end\":73984,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:73971:73984:sha256-d6dd2bb6d3c44b4545cc3f97cb6f8a38842ecd30d2c58ec3e1c53a8c1a0ac77c\",\"quote\":\"The Secretary\",\"start\":73971}],\"id\":\"urn:rulespec:document-understanding:revision:611deea8d68a4b9c2c41733e26e
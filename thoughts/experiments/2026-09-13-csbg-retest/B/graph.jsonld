      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:4b80bc242bf4108132092097a8f5b641e6a56bd640c5f048e8bbcbf82862ca04",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:31395ba7d5334d84fb0b494cef7940aef1f2057d347346c5e570b85817a7b200",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:e5c5129832747e4a96c697e27b458f2fabd627015cffc336b8996a29bf2b5bc1",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"kind\":\"requirement\",\"modality\":\"must\",\"scope_text\":\"In the case of a State that has a constitutional requirement of tax uniformity and that, as of December 31, 1997, imposed a tax on personal income with a single flat rate applicable to all earned and unearned income (except insofar as any amount is not taxed pursuant to tax forgiveness provisions) and no generally available exemptions or deductions to individuals.\",\"summary\":\"In the case of a State that has a constitutional requirement of tax uniformity and that, as of December 31, 1997, imposed a tax on personal income with a single flat rate applicable to all earned and unearned income (except insofar as any amount is not taxed pursuant to tax forgiveness provisions) and no generally available exemptions or deductions to individuals, the requirement of paragraph (2) shall be treated as met if the amount of the credit described in paragraph (2) is limited to a uniform percentage (but not greater than 25 percent) of State personal income tax liability (determined without regard to credits).\"}",
        "@type": "xsd:string"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed",

    {
      "@id": "urn:rulespec:document-understanding:revision:d157fb0cfcc0f0efaf56f6d96a3e3583ce97ad2df40957c39fe00db701efbb76",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:d157fb0cfcc0f0efaf56f6d96a3e3583ce97ad2df40957c39fe00db701efbb76",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:99978ec4603818392f34a0a80ce797a8e45cdf003e914d3b8c1c4a605c175f5a",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"Such organization\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:32cf4ea17a5e6c5a5da3d26639240b418c3ed4210eddb166ff533d57d0071473\",\"urn:rulespec:document-understanding:assertion:94d1fff0cbcea8ad343c40cbd173c16fde576ad115d3db7be1dc386c44dc7ec3\",\"urn:rulespec:document-understanding:assertion:7261a47ac989858341ae654f2dc45fffbcdd19cd164921f258e3f4b1a7fb891a\",\"urn:rulespec:document-understanding:assertion:4293f8593a21b5729d6420f20f28521a2c06c5330648c94ddc480b9ad3844199\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[\"For any program carried out by the Federal Government, or by a State or local government under this chapter, the government shall consider, on the same basis as other nongovernmental organizations, religious organizations to provide the assistance under the program, so long as the program is implemented in a manner consistent with the Establishment Clause of the first amendment to the Constitution. Neither the Federal Government nor a State or local government receiving funds under this chapter shall discriminate against an organization that provides assistance under, or applies to provide assistance under, this chapter, on the basis that the organization has a religious character.\",\"Except as provided in paragraph (2), any religious organization providing assistance under any program described in subsection (a) shall be subject to the same regulations as other nongovernmental organizations to account in accord with generally accepted accounting principles for the use of such funds provided under such program.\"],\"defined_terms\":[],\"effective_periods\":[],\"end\":90099,\"evidence\":[{\"end\":90099,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:89925:90099:sha256-f948f095949c96c104e09e36a19574c85694c68535fbffc5803b72ef57b1d52d\",\"quote\":\"Such organization shall segregate government funds provided under such program into a separate account. Only the government funds shall be subject to audit by the government.\",\"start\":89925},{\"end\":89942,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:89925:89942:sha256-c1f0f95f3041bbe9190e5a605c49f42c8fbc1b6c875a886a7a5bb8eedc586647\",\"quote\":\"Such organization\",\"start\":89925},{\"end\":88263,\"field\":\"context:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:87573:88263:sha256-7f698273643ebaac09dd116e5fd1cab7db7c4e700d5aca2c7489efe5e05abd4a\",\"quote\":\"For any program carried out by the Federal Government, or by a State or local government under this chapter, the government shall consider, on the same basis as other nongovernmental organizations, religious organizations to provide the assistance under the program, so long as the program is implemented in a manner consistent with the Establishment Clause of the first amendment to the Constitution. Neither the Federal Government nor a State or local government receiving funds under this chapter shall discriminate against an organization that provides assistance under, or applies to provide assistance under, this chapter, on the basis that the organization has a religious character.\",\"start\":87573},{\"end\":89903,\"field\":\"context:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:89571:89903:sha256-78ffadc5d148f304287c452ea7a013f121080ee1428ba6ba9d7238447f95be22\",\"quote\":\"Except as provided in paragraph (2), any religious organization providing assistance under any program described in subsection (a) shall be subject to the same regulations as other nongovernmental organizations to account in accord with generally accepted accounting principles for the use of such funds provided under such program.\",\"start\":89571}],\"id\":\"urn:rulespec:document-understanding:revision:d157fb0cfcc0f0efaf56f6d96a3e3583ce97ad2df40957c39fe00db701efbb76\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:4293f8593a21b5729d6420f20f28521a2c06c5330648c94ddc480b9ad3844199\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:738423ec9b5cf3479ed1be18b07f82ec2b69f4317f9bf48a2facb0eaee1b4bf4\",\"origin\":\"aiSuggested\",\"quote\":\"Such organization shall segregate government funds provided under such program into a separate account. Only the government funds shall be subject to audit by the government.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:377e4fdca9efc53f0495a69305412c44f6ba8ab2771b213fa59ecab9dcb7371a\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"urn:rulespec:document-understanding:section:cfe00c4667f8a705b619c6842c9a05b4aaa1e3ace7adcf5723b0c39c5a6aa621\",\"start\":89925,\"summary\":\"A religious organization providing assistance under a program carried out by the Federal Government, or by a State or local government under this chapter, shall segregate government funds provided under such program into a separate account.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"the Secretary [of Health and Human Services]\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:28bccd0b5dc5e058aee78747b668a02ecd85ef78c3174cd5f2fe343fb80e239b\",\"urn:rulespec:document-understanding:assertion:4948be2a21801dffab2888cad47e43e4ea1cbb3e011d933492b3bfffd8dc422f\",\"urn:rulespec:document-understanding:assertion:e381d6305f3f1b1803aa45df27728da5a6cb60c784fcc917ae34056ff50b3336\",\"urn:rulespec:document-understanding:assertion:ee562b780cf69fc32b73187000071aeddbb2dfc9deaab8f301b06014b8243030\",\"urn:rulespec:document-understanding:assertion:df307a23ae79bbe666245f1cfdc69a9c23c6699a3d7219d16f42f2e9d1861e75\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":96963,\"evidence\":[{\"end\":96963,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:95995:96963:sha256-217579195f09dded46d5fe486ff35bb87cd4f873f27592d75dfa76116affea8d\",\"quote\":\"Pub. L. 119–75, div. B, title II, Feb. 3, 2026, 140 Stat. 277, provided in part: “That the Secretary [of Health and Human Services] shall establish procedures regarding the disposition of intangible assets and program income that permit such assets acquired with, and program income derived from, grant funds authorized under section 680 of the CSBG Act [Community Services Block Grant Act, 42 U.S.C. 9921] to become the sole property of such grantees after a period of not more than 12 years after the end of the grant period for any activity consistent with section 680(a)(2)(A) of the CSBG Act [42 U.S.C. 9921(a)(2)(A)]: Provided further, That intangible assets in the form of loans, equity investments and other debt instruments, and program income may be used by grantees for any eligible purpose consistent with section 680(a)(2)(A) of the CSBG Act: Provided further, That these procedures shall apply to such grant funds made available after November 29, 1999”.\",\"start\":95995},{\"end\":96126,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:96082:96126:sha256-089128b7d3ae9e9bfb1fb777e25322162b67359523defdee803bedf43eec556f\",\"quote\":\"the Secretary [of Health and Human Services]\",\"start\":96082},{\"end\":96963,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:95995:96963:sha256-217579195f09dded46d5fe486ff35bb87cd4f873f27592d75dfa76116affea8d\",\"quote\":\"Pub. L. 119–75, div. B, title II, Feb. 3, 2026, 140 Stat. 277, provided in part: “That the Secretary [of Health and Human Services] shall establish procedures regarding the disposition of intangible assets and program income that permit such assets acquired with, and program income derived from, grant funds authorized under section 680 of the CSBG Act [Community Services Block Grant Act, 42 U.S.C. 9921] to become the sole property of such grantees after a period of not more than 12 years after the end of the grant period for any activity consistent with section 680(a)(2)(A) of the CSBG Act [42 U.S.C. 9921(a)(2)(A)]: Provided further, That intangible assets in the form of loans, equity investments and other debt instruments, and program income may be used by grantees for any eligible purpose consistent with section 680(a)(2)(A) of the CSBG Act: Provided further, That these procedures shall apply to such grant funds made available after November 29, 1999”.\",\"start\":95995}],\"id\":\"urn:rulespec:document-understanding:revision:71d3e5b9d4ea32fa3ae1c3d9ce0205c4ea0dea8452310ccdbba80db36cad2b85\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:df307a23ae79bbe666245f1cfdc69a9c23c6699a3d7219d16f42f2e9d1861e75\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:0855e9604a4d1f651d3ce8c0e755f18808d93c659d2a5e1149d7a6db03714521\",\"origin\":\"aiSuggested\",\"quote\":\"Pub. L. 119–75, div. B, title II, Feb. 3, 2026, 140 Stat. 277, provided in part: “That the Secretary [of Health and Human Services] shall establish procedures regarding the disposition of intangible assets and program income that permit such assets acquired with, and program income derived from, grant funds authorized under section 680 of the CSBG Act [Community Services Block Grant Act, 42 U.S.C. 9921] to become the sole property of such grantees after a period of not more than 12 years after the end of the grant period for any activity consistent with section 680(a)(2)(A) of the CSBG Act [42 U.S.C. 9921(a)(2)(A)]: Provided further, That intangible assets in the form of loans, equity investments and other debt instruments, and program income may be used by grantees for any eligible purpose consistent with section 680(a)(2)(A) of the CSBG Act: Provided further, That these procedures shall apply to such grant funds made available after November 29, 1999”.\",\"references\":[\"section 680 of the CSBG Act\",\"42 U.S.C. 9921\",\"section 680(a)(2)(A) of the CSBG Act\",\"42 U.S.C. 9921(a)(2)(A)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:40df432698bd2facda2d3fb565c76bf0e1fa96b146d8b1004f41b9c787f03b5f\",\"scope_quotes\":[\"Pub. L. 119–75, div. B, title II, Feb. 3, 2026, 140 Stat. 277, provided in part: “That the Secretary [of Health and Human Services] shall establish procedures regarding the disposition of intangible assets and program income that permit such assets acquired with, and program income derived from, grant funds authorized under section 680 of the CSBG Act [Community Services Block Grant Act, 42 U.S.C. 9921] to become the sole property of such grantees after a period of not more than 12 years after the end of the grant period for any activity consistent with section 680(a)(2)(A) of the CSBG Act [42 U.S.C. 9921(a)(2)(A)]: Provided further, That intangible assets in the form of loans, equity investments and other debt instruments, and program income may be used by grantees for any eligible purpose consistent with section 680(a)(2)(A) of the CSBG Act: Provided further, That these procedures shall apply to such grant funds made available after November 29, 1999”.\"],\"scope_text\":\"applicable to such grant funds made available after November 29, 1999\",\"section_id\":\"urn:rulespec:document-understanding:section:6888d98c59cc2331f4c6a6a1e0052761ef3a8008658a9708c0cec6503ed121ed\",\"start\":95995,\"summary\":\"The Secretary of Health and Human Services shall establish procedures regarding the disposition of intangible assets and program income that permit such assets acquired with, and program income derived from, grant funds authorized under section 680 of the CSBG Act (42 U.S.C. 9921) to become the sole property of such grantees after a period of not more than 12 years after the end of the grant period for any activity consistent with section 680(a)(2)(A) of the CSBG Act (42 U.S.C. 9921(a)(2)(A)), applicable to such grant funds made available after November 29, 1999.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

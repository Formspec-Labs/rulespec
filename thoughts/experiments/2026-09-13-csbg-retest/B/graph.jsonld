      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:40960e62e45f6c91922c368c2d4edd56fcfefce071567324b8276d198f1571bc\",\"urn:rulespec:document-understanding:assertion:7cb91b7c5202a0388fa76ba4bb7b4fd6897213fdafaf362e157ada2ccd54704f\",\"urn:rulespec:document-understanding:assertion:09e6252d39985a705a2df0ce2cdcd9feb6db6977ae7350fdac9f15db385719b3\",\"urn:rulespec:document-understanding:assertion:7e2385ec94a9aac00c92d637934d83704df65c9250c6555d0429acca8c3cf0a4\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":35188,\"evidence\":[{\"end\":34529,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:34475:34529:sha256-02fd9ef07115b8b0d38fca7d531611e1378bb6d290502126ba5ca38125fa5e7e\",\"quote\":\"(vii) Special rule for States requiring tax uniformity\",\"start\":34475},{\"end\":34553,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:34530:34553:sha256-e952ba9b58a60fc1e0bf7031e30cb8004b7aa72944ce496282493e87f4ed85a6\",\"quote\":\"In the case of a State—\",\"start\":34530},{\"end\":34695,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:34555:34695:sha256-857ef718394bbcbc477c416bdeb788f253e0645fe067a5d77b2fb85c20ab1160\",\"quote\":\"(I) that has a constitutional requirement of tax uniformity; and\\n\\n(II) that, as of December 31, 1997, imposed a tax on personal income with—\",\"start\":34555},{\"end\":35188,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:34697:35188:sha256-28c66fedbb46552ad13a553bea01c6dcec2177f1aeef4d901b2bdc4a8a4afd5d\",\"quote\":\"(aa) a single flat rate applicable to all earned and unearned income (except insofar as any amount is not taxed pursuant to tax forgiveness provisions); and\\n\\n(bb) no generally available exemptions or deductions to individuals;\\n\\n\\n\\n\\n the requirement of paragraph (2) shall be treated as met if the amount of the credit described in paragraph (2) is limited to a uniform percentage (but not greater than 25 percent) of State personal income tax liability (determined without regard to credits).\",\"start\":34697},{\"end\":34967,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:34962:34967:sha256-56ee5b508706bf2de91712d85d6d1e11ddbff01949142ed6e8c22e3b1bed1c71\",\"quote\":\"shall\",\"start\":34962},{\"end\":34529,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:34475:34529:sha256-02fd9ef07115b8b0d38fca7d531611e1378bb6d290502126ba5ca38125fa5e7e\",\"quote\":\"(vii) Special rule for States requiring tax uniformity\",\"start\":34475},{\"end\":34553,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:34530:34553:sha256-e952ba9b58a60fc1e0bf7031e30cb8004b7aa72944ce496282493e87f4ed85a6\",\"quote\":\"In the case of a State—\",\"start\":34530},{\"end\":34695,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:34555:34695:sha256-857ef718394bbcbc477c416bdeb788f253e0645fe067a5d77b2fb85c20ab1160\",\"quote\":\"(I) that has a constitutional requirement of tax uniformity; and\\n\\n(II) that, as of December 31, 1997, imposed a tax on personal income with—\",\"start\":34555},{\"end\":34923,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:34697:34923:sha256-a68b9587bb2ab8a0259228f12760feb4f55831841c5d04acb3ff34d488d627d0\",\"quote\":\"(aa) a single flat rate applicable to all earned and unearned income (except insofar as any amount is not taxed pursuant to tax forgiveness provisions); and\\n\\n(bb) no generally available exemptions or deductions to individuals;\",\"start\":34697}],\"id\":\"urn:rulespec:document-understanding:revision:6161cc98f9454ca805774d0d032147de44ce17fdb4feab702324765ebb7b3040\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:7e2385ec94a9aac00c92d637934d83704df65c9250c6555d0429acca8c3cf0a4\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:fb258c8ebbdcdb7d9d32f8bf45086534520918fdc8f1100a691c09753b0b10a8\",\"origin\":\"aiSuggested\",\"quote\":\"(vii) Special rule for States requiring tax uniformity In the case of a State—\\n\\n(I) that has a constitutional requirement of tax uniformity; and\\n\\n(II) that, as of December 31, 1997, imposed a tax on personal income with—\\n\\n(aa) a single flat rate applicable to all earned and unearned income (except insofar as any amount is not taxed pursuant to tax forgiveness provisions); and\\n\\n(bb) no generally available exemptions or deductions to individuals;\\n\\n\\n\\n\\n the requirement of paragraph (2) shall be treated as met if the amount of the credit described in paragraph (2) is limited to a uniform percentage (but not greater than 25 percent) of State personal income tax liability (determined without regard to credits).\",\"references\":[\"paragraph (2)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:e5c5129832747e4a96c697e27b458f2fabd627015cffc336b8996a29bf2b5bc1\",\"scope_quotes\":[\"(vii) Special rule for States requiring tax uniformity In the case of a State—\\n\\n(I) that has a constitutional requirement of tax uniformity; and\\n\\n(II) that, as of December 31, 1997, imposed a tax on personal income with—\\n\\n(aa) a single flat rate applicable to all earned and unearned income (except insofar as any amount is not taxed pursuant to tax forgiveness provisions); and\\n\\n(bb) no generally available exemptions or deductions to individuals;\"],\"scope_text\":\"In the case of a State that has a constitutional requirement of tax uniformity and that, as of December 31, 1997, imposed a tax on personal income with a single flat rate applicable to all earned and unearned income (except insofar as any amount is not taxed pursuant to tax forgiveness provisions) and no generally available exemptions or deductions to individuals.\",\"section_id\":\"urn:rulespec:document-understanding:section:065d5bd1b1fd12e07012730aaa12714e330211d213042d09aad361bcfa67ebfa\",\"start\":34475,\"summary\":\"In the case of a State that has a constitutional requirement of tax uniformity and that, as of December 31, 1997, imposed a tax on personal income with a single flat rate applicable to all earned and unearned income (except insofar as any amount is not taxed pursuant to tax forgiveness provisions) and no generally available exemptions or deductions to individuals, the requirement of paragraph (2) shall be treated as met if the amount of the credit described in paragraph (2) is limited to a uniform percentage (but not greater than 25 percent) of State personal income tax liability (determined without regard to credits).\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"the Secretary\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:284e4a090cf248969ea00dbe5e396b8b667d0489f863f53dba2f5cc518f87cde\",\"urn:rulespec:document-understanding:assertion:7efb402e1b3ac9e624f463ec2315842d407eb71195226c38fd6fed6b2fee3a2c\",\"urn:rulespec:document-understanding:assertion:eda36ec91ae68b00e1bbe24f20fa9f21f3497337ae623ca4833403b69d050063\",\"urn:rulespec:document-understanding:assertion:d03c8defe9549ccbd7802e3d3b4dfcdc389108d0850f71f2cd783a6f1d3fb50e\",\"urn:rulespec:document-understanding:assertion:526e61822f4dbc4c8e112a4935e8ebd90daa25a82e076ea8d10db863e796b998\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":99854,\"evidence\":[{\"end\":99296,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:99250:99296:sha256-6f4ce65cb40c1b27bb630d4326b30f18dd7cd25e04a1cfde46dc7930cb924b1f\",\"quote\":\"(1) Not to exceed $6,000,000 in appropriations\",\"start\":99250},{\"end\":99480,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:99297:99480:sha256-ab20de0207ce633bb3642097e52e1c6c730fc64096c1fa1eda9080fb52fa0795\",\"quote\":\"Of the amount appropriated for a fiscal year to carry out this section (but not to exceed $6,000,000), the Secretary shall distribute funds for grants under subsection (a) as follows:\",\"start\":99297},{\"end\":99496,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:99482:99496:sha256-9c42fb46ddf93b999d39103000936dbcb7ffda46cd45642986088a12333f6098\",\"quote\":\"(A) Allotments\",\"start\":99482},{\"end\":99854,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:99498:99854:sha256-05525e3ffd062825cf0fe131f1a9733052d7de215ee33318b315cab5eeacd05f\",\"quote\":\"From a portion equal to 60 percent of such amount (but not to exceed $3,600,000), the Secretary shall allot for grants to eligible agencies for statewide programs in each State the amount that bears the same ratio to such portion as the low-income and unemployed population of such State bears to the low-income and unemployed population of all the States.\",\"start\":99498},{\"end\":99296,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:99250:99296:sha256-6f4ce65cb40c1b27bb630d4326b30f18dd7cd25e04a1cfde46dc7930cb924b1f\",\"quote\":\"(1) Not to exceed $6,000,000 in appropriations\",\"start\":99250},{\"end\":99480,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:99297:99480:sha256-ab20de0207ce633bb3642097e52e1c6c730fc64096c1fa1eda9080fb52fa0795\",\"quote\":\"Of the amount appropriated for a fiscal year to carry out this section (but not to exceed $6,000,000), the Secretary shall distribute funds for grants under subsection (a) as follows:\",\"start\":99297}],\"id\":\"urn:rulespec:document-understanding:revision:85ce0d5d5e8921ddd08714cdb9bd7d7cd8b8f4c7d9754a471e05c51fec59de09\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:526e61822f4dbc4c8e112a4935e8ebd90daa25a82e076ea8d10db863e796b998\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:f3f16c520f383120f763ca8f2fac92beff40732ee65c6650942412f360d414e1\",\"origin\":\"aiSuggested\",\"quote\":\"(1) Not to exceed $6,000,000 in appropriations Of the amount appropriated for a fiscal year to carry out this section (but not to exceed $6,000,000), the Secretary shall distribute funds for grants under subsection (a) as follows:\\n\\n(A) Allotments\\n\\nFrom a portion equal to 60 percent of such amount (but not to exceed $3,600,000), the Secretary shall allot for grants to eligible agencies for statewide programs in each State the amount that bears the same ratio to such portion as the low-income and unemployed population of such State bears to the low-income and unemployed population of all the States.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:259489e55c10a75e1a7aa3cf18d99c0074007b0a2c77bf81024206215448e84f\",\"scope_quotes\":[\"(1) Not to exceed $6,000,000 in appropriations Of the amount appropriated for a fiscal year to carry out this section (but not to exceed $6,000,000), the Secretary shall distribute funds for grants under subsection (a) as follows:\"],\"scope_text\":\"Of the amount appropriated for a fiscal year to carry out this section (but not to exceed $6,000,000)\",\"section_id\":\"urn:rulespec:document-understanding:section:cad1a9ce814f7bc8d23a6ff48e1865a684b16830bcf049a10118a7b6cab89b15\",\"start\":99250,\"summary\":\"Of the amount appropriated for a fiscal year to carry out this section (but not to exceed $6,000,000), the Secretary shall allot for grants to eligible agencies for statewide programs in each State, from a portion equal to 60 percent of such amount (but not to exceed $3,600,000), the amount that bears the same ratio to such portion as the low-income and unemployed population of such State bears to the low-income and unemployed population of all the States.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

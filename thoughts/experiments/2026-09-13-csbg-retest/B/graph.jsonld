    {
      "@id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:38424:38847:sha256-fd8ab136c0f1e722fe1809a4cd0b30f6e080e93e8b687b5450eff8b410333828",
      "@type": "rkaf:SourceFragment",
      "oa:hasSource": "urn:rulespec:document-understanding:document:26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023",
      "rkaf:fragmentIdentityScheme": "rkaf:carrier-local-fragment",
      "rkaf:sourceArtifactDigest": "sha256:26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023",
      "rkaf:fragmentContentDigest": "sha256:fd8ab136c0f1e722fe1809a4cd0b30f6e080e93e8b687b5450eff8b410333828",
      "rkaf:selectorKind": [
        "oa:TextQuoteSelector",
        "oa:TextPositionSelector"
      ],
      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "(A) to support activities that are designed to assist low-income families and individuals, including families and individuals receiving assistance under part A of title IV of the Social Security Act (42 U.S.C. 601 et seq.), homeless families and individuals, migrant or seasonal farmworkers, and elderly low-income individuals and families, and a description of how such activities will enable the families and individuals—"
        },
        {
          "@type": "oa:TextPositionSelector",
          "oa:start": 38424,
          "oa:end": 38847,
          "rkaf:coordinateSystem": "rkaf:unicode-codepoint"
        }
      ]
    },
    {
      "@id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:38849:39925:sha256-c90ec600eb31a131f3d2d90e00b2bbe2d695eaa9e23d055def8f37c462c930e3",
      "@type": "rkaf:SourceFragment",
      "oa:hasSource": "urn:rulespec:document-understanding:document:26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023",
      "rkaf:fragmentIdentityScheme": "rkaf:carrier-local-fragment",
      "rkaf:sourceArtifactDigest": "sha256:26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023",
      "rkaf:fragmentContentDigest": "sha256:c90ec600eb31a131f3d2d90e00b2bbe2d695eaa9e23d055def8f37c462c930e3",
      "rkaf:selectorKind": [
        "oa:TextQuoteSelector",
        "oa:TextPositionSelector"
      ],
      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "(i) to remove obstacles and solve problems that block the achievement of self-sufficiency (including self-sufficiency for families and individuals who are attempting to transition off a State program carried out under part A of title IV of the Social Security Act);\n\n(ii) to secure and retain meaningful employment;\n\n(iii) to attain an adequate education, with particular attention toward improving literacy skills of the low-income families in the communities involved, which may include carrying out family literacy initiatives;\n\n(iv) to make better use of available income;\n\n(v) to obtain and maintain adequate housing and a suitable living environment;\n\n(vi) to obtain emergency assistance through loans, grants, or other means to meet immediate and urgent family and individual needs; and\n\n(vii) to achieve greater participation in the affairs of the communities involved, including the development of public and private grassroots partnerships with local law enforcement agencies, local housing authorities, private foundations, and other public and private partners to—"
        },
        {
          "@type": "oa:TextPositionSelector",
          "oa:start": 38849,
          "oa:end": 39925,
          "rkaf:coordinateSystem": "rkaf:unicode-codepoint"
        }
      ]
    },
    {
      "@id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:39927:40249:sha256-052d8954611d998c7e065eceb23341406831dd554e7a60c58d38fb73166217b0",
      "@type": "rkaf:SourceFragment",
      "oa:hasSource": "urn:rulespec:document-understanding:document:26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023",
      "rkaf:fragmentIdentityScheme": "rkaf:carrier-local-fragment",
      "rkaf:sourceArtifactDigest": "sha256:26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023",
      "rkaf:fragmentContentDigest": "sha256:052d8954611d998c7e065eceb23341406831dd554e7a60c58d38fb73166217b0",
      "rkaf:selectorKind": [
        "oa:TextQuoteSelector",
        "oa:TextPositionSelector"
      ],
      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "(I) document best practices based on successful grassroots intervention in urban areas, to develop methodologies for widespread replication; and\n\n(II) strengthen and improve relationships with local law enforcement agencies, which may include participation in activities such as neighborhood or community policing efforts;"
        },
        {
          "@type": "oa:TextPositionSelector",
          "oa:start": 39927,
          "oa:end": 40249,
          "rkaf:coordinateSystem": "rkaf:unicode-codepoint"
        }
      ]
    },
    {
      "@id": "urn:rulespec:document-understanding:assertion:1b5c71688b3c29c733a2eb9dc3dea767f46fe53c5dae77129b9462095354710c",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:4b80bc242bf4108132092097a8f5b641e6a56bd640c5f048e8bbcbf82862ca04",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:3d5314ddf0c5e8d85fc2ad1f82947fc8923794f629e4490f8a1e58bdaf444e17",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:050296464021f35b00d7c957dc3a4a88350b4e6cc44d5e1b6f4549a9bbe5e419",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:states-requirement",
      "rkaf:assertsValue": {
        "@value": "Beginning with fiscal year 2000, the State's application and plan submitted to be eligible for a grant or allotment under section 9905 or 9906 of this title must contain an assurance that funds made available through the grant or allotment will be used to support activities designed to assist low-income families and individuals (including families and individuals receiving assistance under part A of title IV of the Social Security Act, homeless families and individuals, migrant or seasonal farmworkers, and elderly low-income individuals and families), and a description of how such activities will enable families and individuals: (i) to remove obstacles and solve problems blocking self-sufficiency (including for those transitioning off part A of title IV assistance); (ii) to secure and retain meaningful employment; (iii) to attain an adequate education, with particular attention toward improving literacy skills in the communities involved (which may include family literacy initiatives); (iv) to make better use of available income; (v) to obtain and maintain adequate housing and a suitable living environment; (vi) to obtain emergency assistance through loans, grants, or other means for immediate and urgent needs; and (vii) to achieve greater community participation, including grassroots partnerships with local law enforcement, housing authorities, private foundations, and other partners to document best practices for urban replication and strengthen relationships with local law enforcement (which may include neighborhood or community policing efforts).",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },
    {
      "@id": "urn:rulespec:document-understanding:binding:416d70970c785226a5d157555a1e6cf38ce4a9156c7a83eb72b1fe07187216f8",
      "@type": "rkaf:EvidenceBinding",

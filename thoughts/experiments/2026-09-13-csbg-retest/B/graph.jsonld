    {
      "@id": "urn:rulespec:document-understanding:term:079616ed8d6d9aa90bf9f36ba14c8bf60612c1552530087f2f7df47e57d4cfbf",
      "@type": "rkaf:LocalConcept",
      "skos:prefLabel": {
        "en": "cause"
      },
      "skos:definition": {
        "en": "For purposes of making a determination in accordance with subsection (b)(8) with respect to a funding reduction, the term “cause” includes: (A) a statewide redistribution of funds provided through a community services block grant under this chapter to respond to (i) the results of the most recently available census or other appropriate data, (ii) the designation of a new eligible entity, or (iii) severe economic dislocation; or (B) the failure of an eligible entity to comply with the terms of an agreement or a State plan, or to meet a State requirement, as described in section 9915(a) of this title."
      },
      "skos:inScheme": "urn:rulespec:document-understanding:defined-term-scheme:26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023",

      "dcterms:description": "{\"action\":\"\",\"actor\":\"Each nonprofit organization submitting an application under this section\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:b4e4953049a3f8a4513ebc7f20204740d157ea144051dd36778dc3f197076be4\",\"urn:rulespec:document-understanding:assertion:b662ab73d0cf586e6ffdf28fc201bebe53bc5ae02f4336d71e59b7fe73866b0e\",\"urn:rulespec:document-understanding:assertion:3f5a5203526ea19072e94539a1699ad4e7df95cc4a1a79caa4743a8e54069867\",\"urn:rulespec:document-understanding:assertion:d346348aa9f249ef4090fbf56b46082b605ae12bcdf6c88d0d2ae140bfd87a31\",\"urn:rulespec:document-understanding:assertion:b2d332ec64b7e5ab8f27dd47a9a047474b6585bbaed2321b4ca0e608ff1d2481\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":130008,\"evidence\":[{\"end\":129396,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:129274:129396:sha256-240ba195fadd39121bb23bfd64e05e37a31e19a49cc987cfb59db0fcdb41ad1f\",\"quote\":\"(1) Each nonprofit organization submitting an application under this section shall, as part of such application, describe—\",\"start\":129274},{\"end\":130008,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:129398:130008:sha256-d723a3d60fe0619200227fdd3d91630643080fcda94cd5356edce7e244113ec7\",\"quote\":\"(A) the technical and financial assistance that will be made available under the project conducted under this section;\\n\\n(B) the geographic area to be served by the project;\\n\\n(C) the percentage of low-income individuals (as described in subsection (b)) and individuals receiving assistance under a State program funded under part A of title IV of the Social Security Act [42 U.S.C. 601 et seq.] in the area to be served by the project; and\\n\\n(D) unemployment rates in the geographic areas to be served and (to the extent practicable) the jobs available and skills necessary to fill those vacancies in such areas.\",\"start\":129398},{\"end\":129350,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:129278:129350:sha256-9e317eb0a87f41bbedda18caf1a44280c8bc7f4836a4a42a1c552313f7143c27\",\"quote\":\"Each nonprofit organization submitting an application under this section\",\"start\":129278},{\"end\":129356,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:129351:129356:sha256-56ee5b508706bf2de91712d85d6d1e11ddbff01949142ed6e8c22e3b1bed1c71\",\"quote\":\"shall\",\"start\":129351}],\"id\":\"urn:rulespec:document-understanding:revision:abd85caa580da36b7b309ee61a5417952fdfabe943ac018f4d0086fab93745ce\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:d346348aa9f249ef4090fbf56b46082b605ae12bcdf6c88d0d2ae140bfd87a31\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:35c7187733a10ef7f0aecca59e87d83bbe80dc4948aaea7fc30123966bab5fde\",\"origin\":\"aiSuggested\",\"quote\":\"(1) Each nonprofit organization submitting an application under this section shall, as part of such application, describe—\\n\\n(A) the technical and financial assistance that will be made available under the project conducted under this section;\\n\\n(B) the geographic area to be served by the project;\\n\\n(C) the percentage of low-income individuals (as described in subsection (b)) and individuals receiving assistance under a State program funded under part A of title IV of the Social Security Act [42 U.S.C. 601 et seq.] in the area to be served by the project; and\\n\\n(D) unemployment rates in the geographic areas to be served and (to the extent practicable) the jobs available and skills necessary to fill those vacancies in such areas.\",\"references\":[\"subsection (b)\",\"part A of title IV of the Social Security Act\",\"42 U.S.C. 601 et seq.\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:b5b80e39da9f88de52c297dcaa784fa9b11e23d3efa04ad6d2749c1257743adb\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"urn:rulespec:document-understanding:section:5cb9e3013811792481482abb8750d37c55ae5065c06c0e2b4c0138fff8f3e929\",\"start\":129274,\"summary\":\"Each nonprofit organization submitting an application under this section shall, as part of such application, describe: (A) the technical and financial assistance that will be made available under the project conducted under this section; (B) the geographic area to be served by the project; (C) the percentage of low-income individuals (as described in subsection (b)) and individuals receiving assistance under a State program funded under part A of title IV of the Social Security Act [42 U.S.C. 601 et seq.] in the area to be served by the project; and (D) unemployment rates in the geographic areas to be served and (to the extent practicable) the jobs available and skills necessary to fill those vacancies in such areas.\",\"target_ids\":[],\"term_refs\":[\"urn:rulespec:document-understanding:term:d65da2ee6880fefdb8fe7922d42acf06a861a717592953a48d77e3468316fc4f\"],\"typed_values\":[]}",

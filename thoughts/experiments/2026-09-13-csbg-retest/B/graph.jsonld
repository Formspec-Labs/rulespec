      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"the chief executive officer\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:cf68e5c313107101ab1d5de19a4eef575de533983474c8156f9ab56b2563b6da\",\"urn:rulespec:document-understanding:assertion:a9e672f49188ae2584f69e7f30bbbc4f13f6d6cf0fd1617e000e48c075990193\",\"urn:rulespec:document-understanding:assertion:f9bb1876a5dbf66f6b37e8ede10333a8acee96334be62dcf2764eb75da0e3933\",\"urn:rulespec:document-understanding:assertion:4c602108beda82c2dfe51f7db4d2f3983745b0c387b20a89ee7b1fe293212def\",\"urn:rulespec:document-understanding:assertion:25d8cffdd47702c11610d821648aeb37742929fe75614bbc5dcdbfe71ec12ee0\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":53660,\"evidence\":[{\"end\":53660,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:53206:53660:sha256-ddb73ce1975e3100655a3d0112384d33e68535c9148ffc1c78d8f5179c67e1a1\",\"quote\":\"If no private, nonprofit organization is identified or determined to be qualified under subsection (a) to serve the unserved area as an eligible entity the chief executive officer may designate an appropriate political subdivision of the State to serve as an eligible entity for the area. In order to serve as the eligible entity for that area, the political subdivision shall have a board or other mechanism as required in section 9910(b) of this title.\",\"start\":53206},{\"end\":53385,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:53358:53385:sha256-d44239874c9022ec9a79a4927817d7b4a7191564f32fab802aa5e97eb7824a2d\",\"quote\":\"the chief executive officer\",\"start\":53358},{\"end\":53389,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:53386:53389:sha256-ee4d988c65de860fabbfbcd27f73d50bbebe3fba37fe419284f4811389c30bdc\",\"quote\":\"may\",\"start\":53386},{\"end\":53660,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:53206:53660:sha256-ddb73ce1975e3100655a3d0112384d33e68535c9148ffc1c78d8f5179c67e1a1\",\"quote\":\"If no private, nonprofit organization is identified or determined to be qualified under subsection (a) to serve the unserved area as an eligible entity the chief executive officer may designate an appropriate political subdivision of the State to serve as an eligible entity for the area. In order to serve as the eligible entity for that area, the political subdivision shall have a board or other mechanism as required in section 9910(b) of this title.\",\"start\":53206}],\"id\":\"urn:rulespec:document-understanding:revision:d0ef9b6fd127b53f5fd026c1991ff29f2bdc7e8a2e87bfd91dd965a0acdafdf0\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"permission\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:25d8cffdd47702c11610d821648aeb37742929fe75614bbc5dcdbfe71ec12ee0\",\"modality\":\"may\",\"modality_quote\":\"may\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:f03577c014bd3d30ef586ce7a0bb4843b35114ff4cfc1f089268a5e0627b2675\",\"origin\":\"aiSuggested\",\"quote\":\"If no private, nonprofit organization is identified or determined to be qualified under subsection (a) to serve the unserved area as an eligible entity the chief executive officer may designate an appropriate political subdivision of the State to serve as an eligible entity for the area. In order to serve as the eligible entity for that area, the political subdivision shall have a board or other mechanism as required in section 9910(b) of this title.\",\"references\":[\"subsection (a)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:1fcf19746a5c3e2cbf93d514c45e3aa6350e8600306263db25262dde3a7291db\",\"scope_quotes\":[\"If no private, nonprofit organization is identified or determined to be qualified under subsection (a) to serve the unserved area as an eligible entity the chief executive officer may designate an appropriate political subdivision of the State to serve as an eligible entity for the area. In order to serve as the eligible entity for that area, the political subdivision shall have a board or other mechanism as required in section 9910(b) of this title.\"],\"scope_text\":\"If no private, nonprofit organization is identified or determined to be qualified under subsection (a) to serve the unserved area as an eligible entity\",\"section_id\":\"urn:rulespec:document-understanding:section:b8000f1ee8341d7eccdb1b202ebee86bddd6c2a58344891bf3dfbc5b7909fb1a\",\"start\":53206,\"summary\":\"If no private, nonprofit organization is identified or determined to be qualified under subsection (a) to serve the unserved area as an eligible entity, the chief executive officer may designate an appropriate political subdivision of the State to serve as an eligible entity for the area.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

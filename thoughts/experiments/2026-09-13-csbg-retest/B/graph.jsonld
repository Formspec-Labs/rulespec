      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"The Secretary\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:cfacd6299a1c8030dd10c1a9b22e8af187f3aed627f02c6b33c8c26c8d2aa7cb\",\"urn:rulespec:document-understanding:assertion:93784486c5cc224baa37278a445d9fb3e979d5b3e538079124090873fcc703f9\",\"urn:rulespec:document-understanding:assertion:44b643b9bdf7fb2f158a6bd36c5b70fc19f9901da9a131470d2eb163c73cf02d\",\"urn:rulespec:document-understanding:assertion:437efb9b6b2e94b2e979b0e7e973f7052eb5017f412fa7489bf03165ca5ffdd1\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":77647,\"evidence\":[{\"end\":77647,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:76992:77647:sha256-ae6390ba42cc646aed1b474d84a9db6a486f1ddea6a8c8cfb74a598e1b301dc7\",\"quote\":\"The Secretary, in collaboration with the States and with eligible entities throughout the Nation, shall facilitate the development of one or more model performance measurement systems, which may be used by the States and by eligible entities to measure their performance in carrying out the requirements of this chapter and in achieving the goals of their community action plans. The Secretary shall provide technical assistance, including support for the enhancement of electronic data systems, to States and to eligible entities to enhance their capability to collect and report data for such a system and to aid in their participation in such a system.\",\"start\":76992}],\"id\":\"urn:rulespec:document-understanding:revision:8c4d993049eecb653103c3aa1251743ba4ef9f4e74ea04a82de65ebe07cb8620\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:437efb9b6b2e94b2e979b0e7e973f7052eb5017f412fa7489bf03165ca5ffdd1\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:81b77feddb7392ecf53f3b17312c1d7d535b623b4feb03a8db0088974155b90a\",\"origin\":\"aiSuggested\",\"quote\":\"The Secretary, in collaboration with the States and with eligible entities throughout the Nation, shall facilitate the development of one or more model performance measurement systems, which may be used by the States and by eligible entities to measure their performance in carrying out the requirements of this chapter and in achieving the goals of their community action plans. The Secretary shall provide technical assistance, including support for the enhancement of electronic data systems, to States and to eligible entities to enhance their capability to collect and report data for such a system and to aid in their participation in such a system.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:86d0e0542694dc43ad4fafccbe9e1d7d7078ed1aa50456f7e853e2d1c20d72b7\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"urn:rulespec:document-understanding:section:fa489a00ccb41098ac2b415167888ae0d85e530b88cc3c90eda7efe29c7dad7b\",\"start\":76992,\"summary\":\"The Secretary, in collaboration with the States and with eligible entities throughout the Nation, must facilitate the development of one or more model performance measurement systems, which may be used by the States and by eligible entities to measure their performance in carrying out the requirements of 42 U.S.C. chapter 106 and in achieving the goals of their community action plans.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

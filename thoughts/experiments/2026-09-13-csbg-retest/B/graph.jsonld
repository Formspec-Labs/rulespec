      "dcterms:description": "{\"action\":\"\",\"actor\":\"the Secretary\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:30c60eadcda1a9950ee3e91d0ca98c52ad57f21fdd4a66bf05de8818bddef801\",\"urn:rulespec:document-understanding:assertion:c6d0ff8a863dd493faf33bc80ed934545edce370d7944102606469f3929becaf\",\"urn:rulespec:document-understanding:assertion:97ecf760a4810844400b3e42341af994976c95c5df6de04f37ee931ee5a0a054\",\"urn:rulespec:document-understanding:assertion:6618deb6a0a3d9df2168ad090c0067c00359d24fa1ce608a1db5b82ccdb98dc9\",\"urn:rulespec:document-understanding:assertion:d07273c3a61510dcff07158419157d00db94b36ec670e5958a09fec4b4af40bd\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":71229,\"evidence\":[{\"end\":71229,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:70569:71229:sha256-839e4147687db874cf158bdb26785077263ea2b10ebf9d4a38d9764d33527775\",\"quote\":\"Whenever a State violates the assurances contained in section 9908(b)(8) of this title and terminates or reduces the funding of an eligible entity prior to the completion of the State hearing described in that section and the Secretary’s review as required in subsection (b), the Secretary is authorized to provide financial assistance under this chapter to the eligible entity affected until the violation is corrected. In such a case, the grant or allotment for the State under section 9905 or 9906 of this title for the earliest appropriate fiscal year shall be reduced by an amount equal to the funds provided under this subsection to such eligible entity.\",\"start\":70569},{\"end\":70872,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:70859:70872:sha256-d94ee30ad09952c2291cc4b9c90ea8913bd5aa95378aeed99dffff5a5cff0b49\",\"quote\":\"is authorized\",\"start\":70859},{\"end\":71229,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:70569:71229:sha256-839e4147687db874cf158bdb26785077263ea2b10ebf9d4a38d9764d33527775\",\"quote\":\"Whenever a State violates the assurances contained in section 9908(b)(8) of this title and terminates or reduces the funding of an eligible entity prior to the completion of the State hearing described in that section and the Secretary’s review as required in subsection (b), the Secretary is authorized to provide financial assistance under this chapter to the eligible entity affected until the violation is corrected. In such a case, the grant or allotment for the State under section 9905 or 9906 of this title for the earliest appropriate fiscal year shall be reduced by an amount equal to the funds provided under this subsection to such eligible entity.\",\"start\":70569}],\"id\":\"urn:rulespec:document-understanding:revision:9cdd24eb5e2bc802bb46dc8ee94e24c766ee40e4d41b67cc0ecf41461a170533\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"authority\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:d07273c3a61510dcff07158419157d00db94b36ec670e5958a09fec4b4af40bd\",\"modality\":\"may\",\"modality_quote\":\"is authorized\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:93de29c4a1e920ef30c5ba5f296fa36c029a2b8d8a13c75ffedc54834520fae2\",\"origin\":\"aiSuggested\",\"quote\":\"Whenever a State violates the assurances contained in section 9908(b)(8) of this title and terminates or reduces the funding of an eligible entity prior to the completion of the State hearing described in that section and the Secretary’s review as required in subsection (b), the Secretary is authorized to provide financial assistance under this chapter to the eligible entity affected until the violation is corrected. In such a case, the grant or allotment for the State under section 9905 or 9906 of this title for the earliest appropriate fiscal year shall be reduced by an amount equal to the funds provided under this subsection to such eligible entity.\",\"references\":[\"section 9908(b)(8) of this title\",\"subsection (b)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:9da125d95aa81ce41852f95d4136d7de9815ddab56a96b51610b1cf73ceb8a3f\",\"scope_quotes\":[\"Whenever a State violates the assurances contained in section 9908(b)(8) of this title and terminates or reduces the funding of an eligible entity prior to the completion of the State hearing described in that section and the Secretary’s review as required in subsection (b), the Secretary is authorized to provide financial assistance under this chapter to the eligible entity affected until the violation is corrected. In such a case, the grant or allotment for the State under section 9905 or 9906 of this title for the earliest appropriate fiscal year shall be reduced by an amount equal to the funds provided under this subsection to such eligible entity.\"],\"scope_text\":\"Whenever a State violates the assurances contained in section 9908(b)(8) of this title and terminates or reduces the funding of an eligible entity prior to the completion of the State hearing described in that section and the Secretary’s review as required in subsection (b)\",\"section_id\":\"urn:rulespec:document-understanding:section:237b538fca368735fd9d07469584e65428d74fd94b694e39006074ead5c84559\",\"start\":70569,\"summary\":\"Whenever a State violates the assurances contained in section 9908(b)(8) of this title and terminates or reduces the funding of an eligible entity prior to the completion of the State hearing described in that section and the Secretary’s review as required in subsection (b), the Secretary is authorized to provide financial assistance under this chapter to the eligible entity affected until the violation is corrected.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

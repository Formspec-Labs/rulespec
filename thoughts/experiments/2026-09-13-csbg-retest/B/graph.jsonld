      "rkaf:assertsValue": {
        "@value": "If the State determines, on the basis of a final decision in a review pursuant to section 9914 of this title, that an eligible entity fails to comply with the terms of an agreement, or the State plan, to provide services under this chapter or to meet appropriate standards, goals, and other requirements established by the State (including performance objectives), the State shall require the entity to correct the deficiency.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"Each jurisdiction to which subsection (a) applies\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:b161c02de0870ce2be37371c5be2e71f1f811b923735ab72cb0c0ac2dddbcd6f\",\"urn:rulespec:document-understanding:assertion:461adf9c70d5d674eefaf87937a0d2402bfe5f299bae6f501774106fbd8080d3\",\"urn:rulespec:document-understanding:assertion:37203ee13cc515911deb26d5d67753345fb73077fbc23a7ae5f7b494fb16f66b\",\"urn:rulespec:document-understanding:assertion:8b0ddaf5028bc1088928e303841f8fae09cc8cddc71e3817836dc5691e7d618a\",\"urn:rulespec:document-understanding:assertion:25d1639e27d0150d3f11d17a661219ed1164464aabe4ec3d0b1a264735b442c6\",\"urn:rulespec:document-understanding:assertion:2a67e25a090bf8489d5314092fc2f825a589398b0c89da411e94519cf8ef9669\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[\"The Secretary shall apportion the amount reserved under section 9903(b)(1) of this title for each fiscal year on the basis of need among Guam, American Samoa, the United States Virgin Islands, and the Commonwealth of the Northern Mariana Islands.\"],\"defined_terms\":[],\"effective_periods\":[],\"end\":21229,\"evidence\":[{\"end\":20808,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:20793:20808:sha256-7af1ea3cf5ebf20dc4c737677d503346f49ed30c0f919a406427e5c6cccc5535\",\"quote\":\"(b) Application\",\"start\":20793},{\"end\":21229,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:20810:21229:sha256-00851f9b573430b2dc13e68c24328aca9ef4ffb66ecad52c0ba109cfa48ff41a\",\"quote\":\"Each jurisdiction to which subsection (a) applies may receive a grant under this section for the amount apportioned under subsection (a) on submitting to the Secretary, and obtaining approval of, an application, containing provisions that describe the programs for which assistance is sought under this section, that is prepared in accordance with, and contains the information described in, section 9908 of this title.\",\"start\":20810},{\"end\":20859,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:20810:20859:sha256-bef06dced2bc974f931b967b69aa093ecf399427dbfedf098eb40ad35708d256\",\"quote\":\"Each jurisdiction to which subsection (a) applies\",\"start\":20810},{\"end\":20871,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:20860:20871:sha256-6a1f3f8f3e810b051956495e77ddb954ea553655e959c46610f65c8b238fab1f\",\"quote\":\"may receive\",\"start\":20860},{\"end\":21229,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:20810:21229:sha256-00851f9b573430b2dc13e68c24328aca9ef4ffb66ecad52c0ba109cfa48ff41a\",\"quote\":\"Each jurisdiction to which subsection (a) applies may receive a grant under this section for the amount apportioned under subsection (a) on submitting to the Secretary, and obtaining approval of, an application, containing provisions that describe the programs for which assistance is sought under this section, that is prepared in accordance with, and contains the information described in, section 9908 of this title.\",\"start\":20810},{\"end\":20790,\"field\":\"context:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:20544:20790:sha256-084c6a9c7c3f65623b5babcb4caee888029c5b712d8cdbc2b6528f8267f9d82b\",\"quote\":\"The Secretary shall apportion the amount reserved under section 9903(b)(1) of this title for each fiscal year on the basis of need among Guam, American Samoa, the United States Virgin Islands, and the Commonwealth of the Northern Mariana Islands.\",\"start\":20544}],\"id\":\"urn:rulespec:document-understanding:revision:9fc0ccde7173ba0834107fd1c3ce0896e8ff99c483b6bd01714b003ce71ecaa0\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"permission\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:25d1639e27d0150d3f11d17a661219ed1164464aabe4ec3d0b1a264735b442c6\",\"modality\":\"may\",\"modality_quote\":\"may receive\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:2097b0d5fcbc5c77e3c212d8d52eb16ac4f17ca28031a72ac5c434d6ea24c04d\",\"origin\":\"aiSuggested\",\"quote\":\"(b) Application\\n\\nEach jurisdiction to which subsection (a) applies may receive a grant under this section for the amount apportioned under subsection (a) on submitting to the Secretary, and obtaining approval of, an application, containing provisions that describe the programs for which assistance is sought under this section, that is prepared in accordance with, and contains the information described in, section 9908 of this title.\",\"references\":[\"subsection (a)\",\"section 9908\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:2807ccc0badd25293543d99c12ed1d4f7300f4a97955c70945e948493e539d80\",\"scope_quotes\":[\"Each jurisdiction to which subsection (a) applies may receive a grant under this section for the amount apportioned under subsection (a) on submitting to the Secretary, and obtaining approval of, an application, containing provisions that describe the programs for which assistance is sought under this section, that is prepared in accordance with, and contains the information described in, section 9908 of this title.\"],\"scope_text\":\"on submitting to the Secretary, and obtaining approval of, an application, containing provisions that describe the programs for which assistance is sought under this section, that is prepared in accordance with, and contains the information described in, section 9908 of this title\",\"section_id\":\"urn:rulespec:document-understanding:section:069086a849267c558368f52c4b2d944fc5f6f374f28f691bc0875d11be6e8597\",\"start\":20793,\"summary\":\"Each jurisdiction to which subsection (a) applies (Guam, American Samoa, the United States Virgin Islands, and the Commonwealth of the Northern Mariana Islands) may receive a grant under section 9905 of title 42 for the amount apportioned under subsection (a) on submitting to the Secretary, and obtaining approval of, an application containing provisions describing the programs for which assistance is sought under section 9905, prepared in accordance with and containing the information described in section 9908 of title 42.\",\"target_ids\":[],\"term_refs\":[\"urn:rulespec:document-understanding:term:f4c9f84c522e2926470ee048e00856dd704855d4dcd8ecb6fa6c2d3ecf28658e\"],\"typed_values\":[]}",

    {
      "@id": "urn:rulespec:document-understanding:revision:dcccd5914e3640488cd04a8226d5c2c60db4808d26a7e7834c4054eb3121c1f2",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:dcccd5914e3640488cd04a8226d5c2c60db4808d26a7e7834c4054eb3121c1f2",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:a90dfb0f1c6e1c70bcf3ff9bcd266fd01f5f3433d7b179cada91d85a7f3fe1d7",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:7867f5f556279324760e8dac0beb742b86c4adeca6a87d45da6e754464ee3003\",\"urn:rulespec:document-understanding:assertion:3ee8acad8eb3e9b0098eb38d4d2506d9a674b8fe259f5c7395635c76063a5164\",\"urn:rulespec:document-understanding:assertion:4772af10f9c4baefe2c79ba9a11ed99fa9d55877478a725bd9419f02a6cffac3\",\"urn:rulespec:document-understanding:assertion:a289fca23dac52151c08af6c11a765c33b0dba566739fa3ea699592769f12ff1\",\"urn:rulespec:document-understanding:assertion:c4bd05d35ba3778a5bad6014f38b42130b6ef5d91571f00c9189f08569914910\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":116389,\"evidence\":[{\"end\":114937,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:114893:114937:sha256-d89d82995e94ea0388116a77d5470661fcc901a9aa8bd14963e1097f8e3d8996\",\"quote\":\"(c) Programs directed to special populations\",\"start\":114893},{\"end\":115782,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:114939:115782:sha256-17cdb3296507e7fb51e8b3e441a9fb9cf988902a72eb41ef827dd516c01a7459\",\"quote\":\"(1) In addition to the grant programs described in subsection (a), the Secretary may make grants to community action agencies for the purpose of enabling such agencies to demonstrate new approaches to dealing with the problems caused by entrenched, chronic unemployment and lack of economic opportunities for urban youth. Demonstrations shall include such activities as peer counseling, mentoring, development of job skills, assistance with social skills, community services, family literacy, parenting skills, opportunities for employment or entrepreneurship, and other services designed to assist such at-risk youth to continue their education, to secure meaningful employment, to perform community service, or to pursue other productive alternatives within the community.\\n\\n(2) Such grants may be made only with respect to applications that—\",\"start\":114939},{\"end\":116389,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:115784:116389:sha256-d9f8d26926fb897040e51a4b576045656f8681e6567693fe55af4eab937b6e33\",\"quote\":\"(A) identify and describe the population to be served, the problems to be addressed, the overall approach and methods of outreach and recruitment to be used, and the services to be provided;\\n\\n(B) describe how the approach to be used differs from other approaches used for the population to be served by the project;\\n\\n(C) describe the objectives of the project and contain a plan for measuring progress toward meeting those objectives; and\\n\\n(D) contain assurances that the grantee will report on the progress and results of the demonstration at such times and in such manner as the Secretary shall require.\",\"start\":115784},{\"end\":115747,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:115731:115747:sha256-4da41808c143261c6d39a43bd32abf09ea465c7e28d99ebe7296b7d7c8362b45\",\"quote\":\"may be made only\",\"start\":115731},{\"end\":114937,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:114893:114937:sha256-d89d82995e94ea0388116a77d5470661fcc901a9aa8bd14963e1097f8e3d8996\",\"quote\":\"(c) Programs directed to special populations\",\"start\":114893},{\"end\":115782,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:114939:115782:sha256-17cdb3296507e7fb51e8b3e441a9fb9cf988902a72eb41ef827dd516c01a7459\",\"quote\":\"(1) In addition to the grant programs described in subsection (a), the Secretary may make grants to community action agencies for the purpose of enabling such agencies to demonstrate new approaches to dealing with the problems caused by entrenched, chronic unemployment and lack of economic opportunities for urban youth. Demonstrations shall include such activities as peer counseling, mentoring, development of job skills, assistance with social skills, community services, family literacy, parenting skills, opportunities for employment or entrepreneurship, and other services designed to assist such at-risk youth to continue their education, to secure meaningful employment, to perform community service, or to pursue other productive alternatives within the community.\\n\\n(2) Such grants may be made only with respect to applications that—\",\"start\":114939}],\"id\":\"urn:rulespec:document-understanding:revision:dcccd5914e3640488cd04a8226d5c2c60db4808d26a7e7834c4054eb3121c1f2\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:a289fca23dac52151c08af6c11a765c33b0dba566739fa3ea699592769f12ff1\",\"modality\":\"must\",\"modality_quote\":\"may be made only\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:93219faa6604e9c5b4b20fcd449f74281eeaa9a1add5dcf3bb5576302bffb894\",\"origin\":\"aiSuggested\",\"quote\":\"(c) Programs directed to special populations\\n\\n(1) In addition to the grant programs described in subsection (a), the Secretary may make grants to community action agencies for the purpose of enabling such agencies to demonstrate new approaches to dealing with the problems caused by entrenched, chronic unemployment and lack of economic opportunities for urban youth. Demonstrations shall include such activities as peer counseling, mentoring, development of job skills, assistance with social skills, community services, family literacy, parenting skills, opportunities for employment or entrepreneurship, and other services designed to assist such at-risk youth to continue their education, to secure meaningful employment, to perform community service, or to pursue other productive alternatives within the community.\\n\\n(2) Such grants may be made only with respect to applications that—\\n\\n(A) identify and describe the population to be served, the problems to be addressed, the overall approach and methods of outreach and recruitment to be used, and the services to be provided;\\n\\n(B) describe how the approach to be used differs from other approaches used for the population to be served by the project;\\n\\n(C) describe the objectives of the project and contain a plan for measuring progress toward meeting those objectives; and\\n\\n(D) contain assurances that the grantee will report on the progress and results of the demonstration at such times and in such manner as the Secretary shall require.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:69efdb0edd59162f5ef4803455475e62cd0424d54acdd325fb75e2a59709c9d6\",\"scope_quotes\":[\"(c) Programs directed to special populations\\n\\n(1) In addition to the grant programs described in subsection (a), the Secretary may make grants to community action agencies for the purpose of enabling such agencies to demonstrate new approaches to dealing with the problems caused by entrenched, chronic unemployment and lack of economic opportunities for urban youth. Demonstrations shall include such activities as peer counseling, mentoring, development of job skills, assistance with social skills, community services, family literacy, parenting skills, opportunities for employment or entrepreneurship, and other services designed to assist such at-risk youth to continue their education, to secure meaningful employment, to perform community service, or to pursue other productive alternatives within the community.\\n\\n(2) Such grants may be made only with respect to applications that—\"],\"scope_text\":\"Applicable to grants under section 9925(c).\",\"section_id\":\"urn:rulespec:document-understanding:section:5fba676d6775544d7cae048a3634eb9fe091aa0a96f2f732b41f08ff944d6890\",\"start\":114893,\"summary\":\"Grants under section 9925(c) may be made only with respect to applications that: (A) identify and describe the population to be served, the problems to be addressed, the overall approach and methods of outreach and recruitment to be used, and the services to be provided; (B) describe how the approach to be used differs from other approaches used for the population to be served by the project; (C) describe the objectives of the project and contain a plan for measuring progress toward meeting those objectives; and (D) contain assurances that the grantee will report on the progress and results of the demonstration at such times and in such manner as the Secretary shall require.\",\"target_ids\":[],\"term_refs\":[\"urn:rulespec:document-understanding:term:c34823cba19ec45c3e7c0693ac9271e54d8940154d5fd8186d72962709e90ce2\"],\"typed_values\":[]}",

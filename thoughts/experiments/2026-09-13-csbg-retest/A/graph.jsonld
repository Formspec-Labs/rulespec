      "dcterms:description": "{\"action\":\"\",\"actor\":\"an entity described in paragraph (1)(B)\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:eb355534cbf21093c9149873790c77751944d191f13bbe390087572a294bcf8f\",\"urn:rulespec:document-understanding:assertion:59435e2238131cfb232727f18e835c76d1573c126f51a7c4b8cf26cde2fb15f4\",\"urn:rulespec:document-understanding:assertion:5007ac2aa84bf06d42c28f5f7cfa9154c7553f56204e98fb6b32419779d9ff8d\",\"urn:rulespec:document-understanding:assertion:39bdf0360d43db8b9d213489b78356f933908b8e58e32bc5ed72a3e6e1610856\",\"urn:rulespec:document-understanding:assertion:e837e60717259278d4a57ee8d0698e9b425bb5e173a79a5b4ea89c475a4bde5d\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":52714,\"evidence\":[{\"end\":52187,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:52172:52187:sha256-ad91a0a713211e0b83761d8b3d1ae9448e1a500dfadbc96f1bae422e4e460da5\",\"quote\":\"(2) Requirement\",\"start\":52172},{\"end\":52382,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:52188:52382:sha256-587ddf15f214f4c12672296421e01679d376ce037fb5bad0dd7e510bd80c267c\",\"quote\":\"In order to serve as the eligible entity for the area, an entity described in paragraph (1)(B) shall agree to add additional members to the board of the entity to ensure adequate representation—\",\"start\":52188},{\"end\":52714,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:52384:52714:sha256-5283ca511d8fe75de67df5d052af879654337411408e87d261d5772f714cd913\",\"quote\":\"(A) in each of the three required categories described in subparagraphs (A), (B), and (C) of section 9910(a)(2) of this title, by members that reside in the community comprised by the unserved area; and\\n\\n(B) in the category described in section 9910(a)(2)(B) of this title, by members that reside in the neighborhood to be served.\",\"start\":52384},{\"end\":52282,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:52243:52282:sha256-a97563653c6e82d590b1bc1da7161c9dc70758e895ff3d58231fb00cba3a05e0\",\"quote\":\"an entity described in paragraph (1)(B)\",\"start\":52243},{\"end\":52288,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:52283:52288:sha256-56ee5b508706bf2de91712d85d6d1e11ddbff01949142ed6e8c22e3b1bed1c71\",\"quote\":\"shall\",\"start\":52283},{\"end\":52187,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:52172:52187:sha256-ad91a0a713211e0b83761d8b3d1ae9448e1a500dfadbc96f1bae422e4e460da5\",\"quote\":\"(2) Requirement\",\"start\":52172},{\"end\":52382,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:52188:52382:sha256-587ddf15f214f4c12672296421e01679d376ce037fb5bad0dd7e510bd80c267c\",\"quote\":\"In order to serve as the eligible entity for the area, an entity described in paragraph (1)(B) shall agree to add additional members to the board of the entity to ensure adequate representation—\",\"start\":52188}],\"id\":\"urn:rulespec:document-understanding:revision:f671a1437d512cea17fd1891f116d6a2cac6ffbab532cc792a90de6a0d6d1afa\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:e837e60717259278d4a57ee8d0698e9b425bb5e173a79a5b4ea89c475a4bde5d\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:69ad65426a15f6364cb43dc79cbd51897047ae055fdf24818e83cafb21ec4083\",\"origin\":\"aiSuggested\",\"quote\":\"(2) Requirement In order to serve as the eligible entity for the area, an entity described in paragraph (1)(B) shall agree to add additional members to the board of the entity to ensure adequate representation—\\n\\n(A) in each of the three required categories described in subparagraphs (A), (B), and (C) of section 9910(a)(2) of this title, by members that reside in the community comprised by the unserved area; and\\n\\n(B) in the category described in section 9910(a)(2)(B) of this title, by members that reside in the neighborhood to be served.\",\"references\":[\"section 9910(a)(2)\",\"section 9910(a)(2)(B)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:aa50e39fa701a347ff90727dba203082383209e4c223887660968cba17f051ad\",\"scope_quotes\":[\"(2) Requirement In order to serve as the eligible entity for the area, an entity described in paragraph (1)(B) shall agree to add additional members to the board of the entity to ensure adequate representation—\"],\"scope_text\":\"In order to serve as the eligible entity for the area\",\"section_id\":\"urn:rulespec:document-understanding:section:b8000f1ee8341d7eccdb1b202ebee86bddd6c2a58344891bf3dfbc5b7909fb1a\",\"start\":52172,\"summary\":\"In order to serve as the eligible entity for the area, a private nonprofit eligible entity that is geographically located in an area contiguous to or within reasonable proximity of the unserved area and that is already providing related services in the unserved area shall agree to add additional members to the board of the entity to ensure adequate representation in each of the three required categories described in section 9910(a)(2)(A), (B), and (C) of title 42 by members that reside in the community comprised by the unserved area, and in the category described in section 9910(a)(2)(B) of title 42 by members that reside in the neighborhood to be served.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

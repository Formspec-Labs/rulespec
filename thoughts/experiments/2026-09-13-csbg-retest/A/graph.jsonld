      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"the State\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:f9553d310c94891acf4ea70d2639143a231938d9c7b5f1b6e3b80964fc60efeb\",\"urn:rulespec:document-understanding:assertion:74219568cc2366e836a07b2e858d8d44ce961f57ad7a5a8955ce4af837f63ad6\",\"urn:rulespec:document-understanding:assertion:de9638a9c2a56c59e1a872a55653da92960ebe8d4dc2ff142e6971c26624900e\",\"urn:rulespec:document-understanding:assertion:7a20a2eac5a167e672eb6f5561b4e8255aac898681d00ab7bf243fc7d71ca456\",\"urn:rulespec:document-understanding:assertion:5e0b34943bd4031531a0459a8b137963056adfeec08a78650c3cc8e54f207450\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":66600,\"evidence\":[{\"end\":65697,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:65683:65697:sha256-821875740dcc88c64698494aba68e2c0df4c8e0344d861f75db1c3aa2bab9fff\",\"quote\":\"(a) In general\",\"start\":65683},{\"end\":65937,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:65698:65937:sha256-6ebdc7fd475d36546f6b2d5aded717f4cd807a570a1ce6120506ae6d22c87db1\",\"quote\":\"In order to determine whether eligible entities meet the performance goals, administrative standards, financial management requirements, and other requirements of a State, the State shall conduct the following reviews of eligible entities:\",\"start\":65698},{\"end\":66600,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:65939:66600:sha256-dc035a80b369059d25c7cae1c27a0ee8755eec3476d78634862e5ecccc9c1108\",\"quote\":\"(1) A full onsite review of each such entity at least once during each 3-year period.\\n\\n(2) An onsite review of each newly designated entity immediately after the completion of the first year in which such entity receives funds through the community services block grant program.\\n\\n(3) Followup reviews including prompt return visits to eligible entities, and their programs, that fail to meet the goals, standards, and requirements established by the State.\\n\\n(4) Other reviews as appropriate, including reviews of entities with programs that have had other Federal, State, or local grants (other than assistance provided under this chapter) terminated for cause.\",\"start\":65939},{\"end\":65885,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:65880:65885:sha256-56ee5b508706bf2de91712d85d6d1e11ddbff01949142ed6e8c22e3b1bed1c71\",\"quote\":\"shall\",\"start\":65880},{\"end\":65697,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:65683:65697:sha256-821875740dcc88c64698494aba68e2c0df4c8e0344d861f75db1c3aa2bab9fff\",\"quote\":\"(a) In general\",\"start\":65683},{\"end\":65937,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:65698:65937:sha256-6ebdc7fd475d36546f6b2d5aded717f4cd807a570a1ce6120506ae6d22c87db1\",\"quote\":\"In order to determine whether eligible entities meet the performance goals, administrative standards, financial management requirements, and other requirements of a State, the State shall conduct the following reviews of eligible entities:\",\"start\":65698}],\"id\":\"urn:rulespec:document-understanding:revision:73288a34ba55995095b7deca001efdb61a160ff4b0ec862a56de6dc98a635c4a\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:5e0b34943bd4031531a0459a8b137963056adfeec08a78650c3cc8e54f207450\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:baba268894eef3b54a5858880503795a39222f5a6a3b797511b620af50de33b8\",\"origin\":\"aiSuggested\",\"quote\":\"(a) In general In order to determine whether eligible entities meet the performance goals, administrative standards, financial management requirements, and other requirements of a State, the State shall conduct the following reviews of eligible entities:\\n\\n(1) A full onsite review of each such entity at least once during each 3-year period.\\n\\n(2) An onsite review of each newly designated entity immediately after the completion of the first year in which such entity receives funds through the community services block grant program.\\n\\n(3) Followup reviews including prompt return visits to eligible entities, and their programs, that fail to meet the goals, standards, and requirements established by the State.\\n\\n(4) Other reviews as appropriate, including reviews of entities with programs that have had other Federal, State, or local grants (other than assistance provided under this chapter) terminated for cause.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:3ca96c0741e72232f963a856f205a6879d667be95bbc1f484484f0c76d1128e4\",\"scope_quotes\":[\"(a) In general In order to determine whether eligible entities meet the performance goals, administrative standards, financial management requirements, and other requirements of a State, the State shall conduct the following reviews of eligible entities:\"],\"scope_text\":\"In order to determine whether eligible entities meet the performance goals, administrative standards, financial management requirements, and other requirements of a State\",\"section_id\":\"urn:rulespec:document-understanding:section:c0349af1123d989776fe253553df69642696cd32996dd791c280bdbf3d513641\",\"start\":65683,\"summary\":\"In order to determine whether eligible entities meet the performance goals, administrative standards, financial management requirements, and other requirements of a State, the State shall conduct the following reviews of eligible entities: (1) a full onsite review of each such entity at least once during each 3-year period; (2) an onsite review of each newly designated entity immediately after the completion of the first year in which such entity receives funds through the community services block grant program; (3) followup reviews including prompt return visits to eligible entities, and their programs, that fail to meet the goals, standards, and requirements established by the State; and (4) other reviews as appropriate, including reviews of entities with programs that have had other Federal, State, or local grants (other than assistance provided under chapter 106) terminated for cause.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

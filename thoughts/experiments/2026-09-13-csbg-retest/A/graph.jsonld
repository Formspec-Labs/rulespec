      "rkaf:assertsValue": {
        "@value": "{\"actor\":\"Secretary\",\"kind\":\"requirement\",\"modality\":\"must\",\"scope_text\":\"When amounts appropriated for a fiscal year to carry out section 9922 are in excess of $6,000,000.\",\"summary\":\"If amounts appropriated for a fiscal year to carry out section 9922 exceed $6,000,000, the Secretary must use 40 percent of such excess to allot for grants under subsection (a) to eligible agencies for statewide programs in each State an amount that bears the same ratio to 40 percent of such excess as the low-income and unemployed population of such State bears to the low-income and unemployed population of all the States.\"}",
        "@type": "xsd:string"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed",
      "rkaf:hasApplicability": "urn:rulespec:document-understanding:scope:0e2a750c496573b5559cd22f13fb38aa710c30258e0c5cdfb3152aa642ef86d9"
    },

      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"actor\":\"Secretary\",\"kind\":\"requirement\",\"modality\":\"must\",\"scope_text\":\"Of the amount appropriated for a fiscal year to carry out section 9922, not to exceed $6,000,000.\",\"summary\":\"Of the amount appropriated for a fiscal year to carry out section 9922 (but not to exceed $6,000,000), the Secretary must allot 60 percent of such amount (not to exceed $3,600,000) for grants to eligible agencies for statewide programs in each State in an amount that bears the same ratio to such portion as the low-income and unemployed population of such State bears to the low-income and unemployed population of all the States.\"}",
        "@type": "xsd:string"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed",
      "rkaf:hasApplicability": "urn:rulespec:document-understanding:scope:37cc8464f68b12f8eb1add3073c7459e3518e2f99357cbef38e742c7f5933f57"
    },

      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"actor\":\"Secretary\",\"kind\":\"requirement\",\"modality\":\"must\",\"scope_text\":\"Not later than 180 days after the end of the fiscal year in which a grant recipient completes expenditure of the grant.\",\"summary\":\"As soon as practicable, but not later than 180 days after the end of the fiscal year in which a recipient of a grant under section 9925 completes the expenditure of such grant, the Secretary must prepare and make available to each State and each eligible entity a description of the program carried out with such grant, any relevant information developed and results achieved, and a summary of the evaluation of such program received under subsection (a)(1)(D) so as to provide a model of innovative programs for other eligible entities.\",\"term_refs\":[\"urn:rulespec:document-understanding:term:6c942a864d133c150c6e5a0a0917192e8ec313034816c84c25762c653bb7ad0b\",\"urn:rulespec:document-understanding:term:c34823cba19ec45c3e7c0693ac9271e54d8940154d5fd8186d72962709e90ce2\"]}",

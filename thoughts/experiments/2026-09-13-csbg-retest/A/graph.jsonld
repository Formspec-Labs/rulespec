      "rkaf:assertsValue": {
        "@value": "From the amounts allotted under paragraphs (1)(A) and (2)(A) of section 9922(b), the minimum total allotment for each State for each fiscal year must be: (i) $15,000 if the total amount appropriated to carry out section 9922 is not less than $7,000,000 but less than $10,000,000; (ii) $20,000 if the total amount appropriated is not less than $10,000,000 but less than $15,000,000; or (iii) $30,000 if the total amount appropriated is not less than $15,000,000.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

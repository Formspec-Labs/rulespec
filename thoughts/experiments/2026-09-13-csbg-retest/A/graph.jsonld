      "dcterms:description": "{\"action\":\"\",\"actor\":\"Secretary\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:9f220a9aee2dde7408b0647e50e96500ea562a486395802f555e782740d3948d\",\"urn:rulespec:document-understanding:assertion:196979e5033644981a2c55eb53c655111c36bbfe0d41c49806276047ba4e43b0\",\"urn:rulespec:document-understanding:assertion:179dff3dc55b58d6e6aff606dcb5b56aa4a342829857380674257a6cc11e73bf\",\"urn:rulespec:document-understanding:assertion:8ab365b56e9db5340fec89bb33b7d86388614f3cbe37896b9d4fc98291632292\",\"urn:rulespec:document-understanding:assertion:1802e93305b2ec5835bf0b7364706ca71499009a301f83584de9ae357cd7ee11\",\"urn:rulespec:document-understanding:assertion:94eb8db16b9fcbc066da23775cbdae587ad36bedb208a4d4298fbaab8369eec4\",\"urn:rulespec:document-understanding:assertion:ae4cf1b28e80ad460767f715da6f5e191f84ea08cf253d706ea872aaf0295d7c\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":22794,\"evidence\":[{\"end\":22055,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:22030:22055:sha256-6cfd4b588a93bba09a1211c941bb513cf4fbd1667c78adb687f3ccea5c9902c4\",\"quote\":\"(a) Allotments in general\",\"start\":22030},{\"end\":22460,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:22056:22460:sha256-7af9b81f4443a2406710719cc067af906e8d0cf6274ee5f2e76facf8961cdcf3\",\"quote\":\"The Secretary shall, from the amount appropriated under section 9903(a) of this title for each fiscal year that remains after the Secretary makes the reservations required in section 9903(b) of this title, allot to each State (subject to section 9911 of this title) an amount that bears the same ratio to such remaining amount as the amount received by the State for fiscal year 1981 under section 2808 1\",\"start\":22056},{\"end\":22498,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:22462:22498:sha256-82a1f00ab9f241bcc5b63b8eff430fdb902e17c51a01d85e25a2659602172a39\",\"quote\":\"1 See References in Text note below.\",\"start\":22462},{\"end\":22611,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:22500:22611:sha256-656e54a1c2bb522e3be4e8d6d3c8c2851f1cf88ba7a87a2ab8a518e800291fb9\",\"quote\":\" of this title bore to the total amount received by all States for fiscal year 1981 under such section, except—\",\"start\":22500},{\"end\":22794,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:22613:22794:sha256-a82740fba7e11bec22e317608f44690612221ea196eae9f95e24896bc23b670f\",\"quote\":\"(1) that no State shall receive less than ¼ of 1 percent of the amount appropriated under section 9903(a) of this title for such fiscal year; and\\n\\n(2) as provided in subsection (b).\",\"start\":22613},{\"end\":22069,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:22056:22069:sha256-d6dd2bb6d3c44b4545cc3f97cb6f8a38842ecd30d2c58ec3e1c53a8c1a0ac77c\",\"quote\":\"The Secretary\",\"start\":22056},{\"end\":22055,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:22030:22055:sha256-6cfd4b588a93bba09a1211c941bb513cf4fbd1667c78adb687f3ccea5c9902c4\",\"quote\":\"(a) Allotments in general\",\"start\":22030},{\"end\":22460,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:22056:22460:sha256-7af9b81f4443a2406710719cc067af906e8d0cf6274ee5f2e76facf8961cdcf3\",\"quote\":\"The Secretary shall, from the amount appropriated under section 9903(a) of this title for each fiscal year that remains after the Secretary makes the reservations required in section 9903(b) of this title, allot to each State (subject to section 9911 of this title) an amount that bears the same ratio to such remaining amount as the amount received by the State for fiscal year 1981 under section 2808 1\",\"start\":22056}],\"id\":\"urn:rulespec:document-understanding:revision:ae0e6bbf005afa51b4c86534db088fe63a406e7b99b8de27c51f43a5d8068a2c\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:1802e93305b2ec5835bf0b7364706ca71499009a301f83584de9ae357cd7ee11\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:0d811d6bfd2986688ccb3ba442ce5922a4137c795c7b1bf311578a246e60ef1a\",\"origin\":\"aiSuggested\",\"quote\":\"(a) Allotments in general The Secretary shall, from the amount appropriated under section 9903(a) of this title for each fiscal year that remains after the Secretary makes the reservations required in section 9903(b) of this title, allot to each State (subject to section 9911 of this title) an amount that bears the same ratio to such remaining amount as the amount received by the State for fiscal year 1981 under section 2808 1\\n\\n1 See References in Text note below.\\n\\n of this title bore to the total amount received by all States for fiscal year 1981 under such section, except—\\n\\n(1) that no State shall receive less than ¼ of 1 percent of the amount appropriated under section 9903(a) of this title for such fiscal year; and\\n\\n(2) as provided in subsection (b).\",\"references\":[\"section 9903(a)\",\"section 9903(b)\",\"section 9911\",\"section 2808\",\"subsection (b)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:11de0e9d1f9175e066dc5017a64e8877b3a46cd210a6d1504f2f130888863380\",\"scope_quotes\":[\"(a) Allotments in general The Secretary shall, from the amount appropriated under section 9903(a) of this title for each fiscal year that remains after the Secretary makes the reservations required in section 9903(b) of this title, allot to each State (subject to section 9911 of this title) an amount that bears the same ratio to such remaining amount as the amount received by the State for fiscal year 1981 under section 2808 1\"],\"scope_text\":\"for each fiscal year that remains after the Secretary makes the reservations required in section 9903(b) of this title\",\"section_id\":\"urn:rulespec:document-understanding:section:77b293a31882899a97687fe9cf87dc80be98be00fdc4957f7ebc1a1856d5f6c9\",\"start\":22030,\"summary\":\"The Secretary shall, from the amount appropriated under section 9903(a) of title 42 for each fiscal year that remains after the Secretary makes the reservations required in section 9903(b) of title 42, allot to each State (subject to section 9911 of title 42) an amount bearing the same ratio to such remaining amount as the amount received by the State for fiscal year 1981 under section 2808 of title 42 bore to the total amount received by all States for fiscal year 1981 under such section, except that no State shall receive less than 1/4 of 1 percent of the amount appropriated under section 9903(a) for such fiscal year, and except as provided in subsection (b) of section 9906.\",\"target_ids\":[],\"term_refs\":[\"urn:rulespec:document-understanding:term:f4c9f84c522e2926470ee048e00856dd704855d4dcd8ecb6fa6c2d3ecf28658e\",\"urn:rulespec:document-understanding:term:737b4a835a77703334e5da03eb8fc1a624a2cb0dd700298e37ccafb980c36609\"],\"typed_values\":[]}",

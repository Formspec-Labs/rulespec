      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "The Secretary shall use the remaining 20 percent of such excess to make grants under subsection (a) on a competitive basis to eligible agencies for nationwide programs, including programs benefiting Indians, as defined in section 9911 of this title, and migrant or seasonal farmworkers."

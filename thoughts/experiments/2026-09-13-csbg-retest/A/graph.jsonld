      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:4633c72b9949e6d6951371bc0574fba50f8ba6a46700aec92d15b8c8b10c59fa",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:772912910f25c3b018f6b2b9d0d9f52575d2682e55f10e3ebc6f00b827dd5dfd",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:0330d359dce0da1ffb6a7c6206a91e3eeee31f91f2d62c3158d812279f5ee95a",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:states-requirement",
      "rkaf:assertsValue": {
        "@value": "The members of the tripartite board referred to in 42 U.S.C. 9910(a)(1) shall be selected by the entity and the board shall be composed so as to assure that: (A) ⅓ of the members of the board are elected public officials, holding office on the date of selection, or their representatives, except that if the number of such elected officials reasonably available and willing to serve on the board is less than ⅓ of the membership of the board, membership on the board of appointive public officials or their representatives may be counted in meeting such ⅓ requirement; (B)(i) not fewer than ⅓ of the members are persons chosen in accordance with democratic selection procedures adequate to assure that these members are representative of low-income individuals and families in the neighborhood served, and (ii) each representative of low-income individuals and families selected to represent a specific neighborhood within a community under clause (i) resides in the neighborhood represented by the member; and (C) the remainder of the members are officials or members of business, industry, labor, religious, law enforcement, education, or other major groups and interests in the community served.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

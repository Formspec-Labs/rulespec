      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"The Secretary\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:01eba2b22fbc5a4458e0daab9fa9d9926b7bd38196cef6f7fdf8bad9f7997906\",\"urn:rulespec:document-understanding:assertion:90801e2ff70b86bd2a90a3b33e3a93b9a9625a0780950cb917cc46e52b7a8db0\",\"urn:rulespec:document-understanding:assertion:355461f936459d822b75f7aba38c1df72fffef9921a846692f3196de36eaf647\",\"urn:rulespec:document-understanding:assertion:2047663014ce59f9cb3b56b66f8c42c1e776305e5baf6366aca58dd19c8b400f\",\"urn:rulespec:document-understanding:assertion:97d665b940daf1699e85a7643a730e75c35b57bcdd2db204ea13421605ad43b7\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":70543,\"evidence\":[{\"end\":70543,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:70027:70543:sha256-91e604693d4c823d306166a3982ca7c6f673309ef90fea1a5da82f8a9f83ed3a\",\"quote\":\"A determination to terminate the designation or reduce the funding of an eligible entity is reviewable by the Secretary. The Secretary shall, upon request, review such a determination. The review shall be completed not later than 90 days after the Secretary receives from the State all necessary documentation relating to the determination to terminate the designation or reduce the funding. If the review is not completed within 90 days, the determination of the State shall become final at the end of the 90th day.\",\"start\":70027},{\"end\":70161,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:70148:70161:sha256-d6dd2bb6d3c44b4545cc3f97cb6f8a38842ecd30d2c58ec3e1c53a8c1a0ac77c\",\"quote\":\"The Secretary\",\"start\":70148},{\"end\":70543,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:70027:70543:sha256-91e604693d4c823d306166a3982ca7c6f673309ef90fea1a5da82f8a9f83ed3a\",\"quote\":\"A determination to terminate the designation or reduce the funding of an eligible entity is reviewable by the Secretary. The Secretary shall, upon request, review such a determination. The review shall be completed not later than 90 days after the Secretary receives from the State all necessary documentation relating to the determination to terminate the designation or reduce the funding. If the review is not completed within 90 days, the determination of the State shall become final at the end of the 90th day.\",\"start\":70027}],\"id\":\"urn:rulespec:document-understanding:revision:7676da5b5f8f5fd820b7331fe58c3d4cfc540bf3d5d3bf8e8bb160945c60186d\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:97d665b940daf1699e85a7643a730e75c35b57bcdd2db204ea13421605ad43b7\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:5afee202b59215d25d3576ac310e4b6e04e4a48bc77464ddb98584aab921716e\",\"origin\":\"aiSuggested\",\"quote\":\"A determination to terminate the designation or reduce the funding of an eligible entity is reviewable by the Secretary. The Secretary shall, upon request, review such a determination. The review shall be completed not later than 90 days after the Secretary receives from the State all necessary documentation relating to the determination to terminate the designation or reduce the funding. If the review is not completed within 90 days, the determination of the State shall become final at the end of the 90th day.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:09f23a281f7dae350e80c890d4224c8c2b9e7165a04140567f53237a1c594822\",\"scope_quotes\":[\"A determination to terminate the designation or reduce the funding of an eligible entity is reviewable by the Secretary. The Secretary shall, upon request, review such a determination. The review shall be completed not later than 90 days after the Secretary receives from the State all necessary documentation relating to the determination to terminate the designation or reduce the funding. If the review is not completed within 90 days, the determination of the State shall become final at the end of the 90th day.\"],\"scope_text\":\"upon request\",\"section_id\":\"urn:rulespec:document-understanding:section:237b538fca368735fd9d07469584e65428d74fd94b694e39006074ead5c84559\",\"start\":70027,\"summary\":\"The Secretary shall, upon request, review a determination to terminate the designation or reduce the funding of an eligible entity, and the review shall be completed not later than 90 days after the Secretary receives from the State all necessary documentation relating to the determination.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

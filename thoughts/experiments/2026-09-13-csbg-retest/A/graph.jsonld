      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:2f664493e55684ff21f0684c32190c4f434e75e8229e1fd8446ac4cbe71e7a67\",\"urn:rulespec:document-understanding:assertion:5098316de175b318dcd1ec4a25f801f66aa2f04244d8f54db4b0436fdc631887\",\"urn:rulespec:document-understanding:assertion:749d63194a1b5f44f6ea7b0be800a1d390da9fbe363e6142ace05fa446546bfc\",\"urn:rulespec:document-understanding:assertion:c0a8f6f76126368f769e16524931cd549194605c5c8c6be45f72407e6016085a\",\"urn:rulespec:document-understanding:assertion:90d2475ebd0223c4cfd152fd286998eb7c14b0be919df23d41164fe70469e578\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":114009,\"evidence\":[{\"end\":113486,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:113483:113486:sha256-fd0ad9026eee596b7072a762941f60bef57e760a230edd450b3a634825685c2a\",\"quote\":\"(1)\",\"start\":113483},{\"end\":114009,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:113488:114009:sha256-91261f5e78a3ec21e591e84c905799c930a4f61e1cd6881315a22bfe12cc2a6c\",\"quote\":\"(A) Subject to subparagraph (B), grants awarded pursuant to this section shall be used for programs and shall not exceed 50 per centum of the cost of such programs.\\n\\n(B) After the first funding period for which an eligible entity receives a grant under this section to carry out a program, the amount of a subsequent grant made under this section to such entity to carry out such program may not exceed 80 percent of the amount of the grant previously received by such entity under this section to carry out such program.\",\"start\":113488},{\"end\":113883,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:113876:113883:sha256-0007a8bea4dcd3f6b1490fc7199650f1046713dd92d9314e1f2ede6946fcd999\",\"quote\":\"may not\",\"start\":113876},{\"end\":114009,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:113654:114009:sha256-f1476447bb888b3fa522dfd1b419f427c2e1f479c8e0c0ca5f974d5f365e1503\",\"quote\":\"(B) After the first funding period for which an eligible entity receives a grant under this section to carry out a program, the amount of a subsequent grant made under this section to such entity to carry out such program may not exceed 80 percent of the amount of the grant previously received by such entity under this section to carry out such program.\",\"start\":113654}],\"id\":\"urn:rulespec:document-understanding:revision:95985f9b59e3bb7b0989d3fa34406f39d3e8adad17d37d5cf0652016577fb949\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"prohibition\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:c0a8f6f76126368f769e16524931cd549194605c5c8c6be45f72407e6016085a\",\"modality\":\"must_not\",\"modality_quote\":\"may not\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:92bd912d1feb9f1e9896637d1cf7047ef62d5c30fe6b44c066cbc6c75cd159b0\",\"origin\":\"aiSuggested\",\"quote\":\"(1)\\n\\n(A) Subject to subparagraph (B), grants awarded pursuant to this section shall be used for programs and shall not exceed 50 per centum of the cost of such programs.\\n\\n(B) After the first funding period for which an eligible entity receives a grant under this section to carry out a program, the amount of a subsequent grant made under this section to such entity to carry out such program may not exceed 80 percent of the amount of the grant previously received by such entity under this section to carry out such program.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:f59aa167fe28528e8c8469330033c0a331679b784dff5ac626fc04192b8e5cbc\",\"scope_quotes\":[\"(B) After the first funding period for which an eligible entity receives a grant under this section to carry out a program, the amount of a subsequent grant made under this section to such entity to carry out such program may not exceed 80 percent of the amount of the grant previously received by such entity under this section to carry out such program.\"],\"scope_text\":\"After the first funding period for which an eligible entity receives a grant under section 9925 to carry out a program.\",\"section_id\":\"urn:rulespec:document-understanding:section:5fba676d6775544d7cae048a3634eb9fe091aa0a96f2f732b41f08ff944d6890\",\"start\":113483,\"summary\":\"After the first funding period for which an eligible entity receives a grant under section 9925 to carry out a program, the amount of a subsequent grant made under this section to such entity to carry out such program must not exceed 80 percent of the amount of the grant previously received by such entity under this section to carry out such program.\",\"target_ids\":[],\"term_refs\":[\"urn:rulespec:document-understanding:term:6c942a864d133c150c6e5a0a0917192e8ec313034816c84c25762c653bb7ad0b\"],\"typed_values\":[]}",

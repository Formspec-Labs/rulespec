      "@id": "urn:rulespec:document-understanding:revision:b3a3ad60d5041ef3864b2d2c9a109c3ab5a57f768f8baff72b605940c3b7cd45",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:b3a3ad60d5041ef3864b2d2c9a109c3ab5a57f768f8baff72b605940c3b7cd45",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:cd9c676c0ef96bb9c9232ffd968ce1d127fd24dc1819fe7bd8540e03f14c0ad8",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"Secretary\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:460d80d5d4c67510df56f98cc598573762a213c8a38e32683c5653c628a06daa\",\"urn:rulespec:document-understanding:assertion:a90d979d1bcd7f0eb91a341c1042d7f0563d618425e2821b6054d5be2712844e\",\"urn:rulespec:document-understanding:assertion:a54e46a90d7456b3b838c380d08315fb0b6b484a5acb235474c5ffb62145bea2\",\"urn:rulespec:document-understanding:assertion:74dd497d04a24a750c875d56bbdc874506c980858b01194d4c72eb6f0641ba05\",\"urn:rulespec:document-understanding:assertion:d95cc89da98b44e5a8558b990935720b331e5a8741e9d1b32724759bc88aeb71\",\"urn:rulespec:document-understanding:assertion:3a10ac7dc27a4710056a416fea96bbb4d62812ab54e8d83ae4ebd5e3c75ef34d\",\"urn:rulespec:document-understanding:assertion:8551a1294c0df143662ca90cd00db0a8158f9cc6374b1cae618129d47545ffca\",\"urn:rulespec:document-understanding:assertion:fd0ad86b6bded709316d51ebbad9a04b5041db9ba59dd7d8311563bf850a1b82\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":18614,\"evidence\":[{\"end\":17668,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:17652:17668:sha256-74fda605329d9b1ceb4fc23f202c17e0235b89f64f355a31862ab1a252852db2\",\"quote\":\"(b) Reservations\",\"start\":17652},{\"end\":17768,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:17669:17768:sha256-52e40889c206e95327235a9da3d28d4bc66f4b76274d478cbed27729f4c0dbe7\",\"quote\":\"Of the amounts appropriated under subsection (a) for each fiscal year, the Secretary shall reserve—\",\"start\":17669},{\"end\":17969,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:17770:17969:sha256-efae5c543dd8ff050e9e7b4135c1a0010d0f8390d462bedae86f6e571afdf702\",\"quote\":\"(1) ½ of 1 percent for carrying out section 9905 of this title (relating to payments for territories);\\n\\n(2) 1½ percent for activities authorized in sections 9913 through 9918 of this title, of which—\",\"start\":17770},{\"end\":18614,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:17971:18614:sha256-0ead8824ba59d95f4cb4e94d3f57cbe48f684d236a57acfa0e698cddf0427545\",\"quote\":\"(A) not less than ½ of the amount reserved by the Secretary under this paragraph shall be distributed directly to eligible entities, organizations, or associations described in section 9913(c)(2) of this title for the purpose of carrying out activities described in section 9913(c) of this title; and\\n\\n(B) ½ of the remainder of the amount reserved by the Secretary under this paragraph shall be used by the Secretary to carry out evaluation and to assist States in carrying out corrective action activities and monitoring (to correct programmatic deficiencies of eligible entities), as described in sections 9914(c) and 9913 of this title; and\",\"start\":17971},{\"end\":18370,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:18357:18370:sha256-62a0d14945d59ee214a5af08fd631f1e285c8cf69cc01e8561958e470e80ecf0\",\"quote\":\"shall be used\",\"start\":18357},{\"end\":17668,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:17652:17668:sha256-74fda605329d9b1ceb4fc23f202c17e0235b89f64f355a31862ab1a252852db2\",\"quote\":\"(b) Reservations\",\"start\":17652},{\"end\":17768,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:17669:17768:sha256-52e40889c206e95327235a9da3d28d4bc66f4b76274d478cbed27729f4c0dbe7\",\"quote\":\"Of the amounts appropriated under subsection (a) for each fiscal year, the Secretary shall reserve—\",\"start\":17669}],\"id\":\"urn:rulespec:document-understanding:revision:b3a3ad60d5041ef3864b2d2c9a109c3ab5a57f768f8baff72b605940c3b7cd45\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:d95cc89da98b44e5a8558b990935720b331e5a8741e9d1b32724759bc88aeb71\",\"modality\":\"must\",\"modality_quote\":\"shall be used\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:0e44e0c865f1b8bb4d7b3a840bb3e5fb1d3ccb74b335948723bcba040c2bbaae\",\"origin\":\"aiSuggested\",\"quote\":\"(b) Reservations Of the amounts appropriated under subsection (a) for each fiscal year, the Secretary shall reserve—\\n\\n(1) ½ of 1 percent for carrying out section 9905 of this title (relating to payments for territories);\\n\\n(2) 1½ percent for activities authorized in sections 9913 through 9918 of this title, of which—\\n\\n(A) not less than ½ of the amount reserved by the Secretary under this paragraph shall be distributed directly to eligible entities, organizations, or associations described in section 9913(c)(2) of this title for the purpose of carrying out activities described in section 9913(c) of this title; and\\n\\n(B) ½ of the remainder of the amount reserved by the Secretary under this paragraph shall be used by the Secretary to carry out evaluation and to assist States in carrying out corrective action activities and monitoring (to correct programmatic deficiencies of eligible entities), as described in sections 9914(c) and 9913 of this title; and\",\"references\":[\"section 9903(a)\",\"sections 9913 through 9918\",\"section 9914(c)\",\"section 9913\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:31295bbb4ff3e392552b8da31aee7213d1f6d52a0aff245ba5125d548245eee7\",\"scope_quotes\":[\"(b) Reservations Of the amounts appropriated under subsection (a) for each fiscal year, the Secretary shall reserve—\"],\"scope_text\":\"for each fiscal year\",\"section_id\":\"urn:rulespec:document-understanding:section:12fca79c614e56d4c2834f93ce1a7d98eff6aeadfd069e9f4c6aeffa5285544c\",\"start\":17652,\"summary\":\"Of the amounts appropriated under section 9903(a) of title 42 for each fiscal year, of the 1 1/2 percent reserved under paragraph (2) for activities authorized in sections 9913 through 9918, 1/2 of the remainder of the amount reserved shall be used by the Secretary to carry out evaluation and to assist States in carrying out corrective action activities and monitoring (to correct programmatic deficiencies of eligible entities), as described in sections 9914(c) and 9913 of title 42.\",\"target_ids\":[],\"term_refs\":[\"urn:rulespec:document-understanding:term:609da2cab4326e363e5f445c4b18a0b7dafa3403032088b82b5e79a3af703c4e\",\"urn:rulespec:document-understanding:term:f4c9f84c522e2926470ee048e00856dd704855d4dcd8ecb6fa6c2d3ecf28658e\",\"urn:rulespec:document-understanding:term:737b4a835a77703334e5da03eb8fc1a624a2cb0dd700298e37ccafb980c36609\"],\"typed_values\":[]}",

      "dcterms:description": "{\"action\":\"\",\"actor\":\"The Secretary\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:3be064d9b334bc3957860dde5c5eb22a1f2ec0ed5fc34ee54ce48f4529b6a3a1\",\"urn:rulespec:document-understanding:assertion:a14625106f1f0dd36a759c446cb89c0acfdcb8c6be0510b595b4bc0baf696ec5\",\"urn:rulespec:document-understanding:assertion:0c6d550df979d60d1ef4ed81416918ebb3fff478efcc15820a11b3f303dca99c\",\"urn:rulespec:document-understanding:assertion:fe428a4bc8b94c732597cd629192316f8079776ef5f423a21a298ae36633988b\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":24184,\"evidence\":[{\"end\":24184,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:23980:24184:sha256-4de79bc0841236001e80e6a3d1aca411f25057ff1b356ee6d1480f4ac6fb16bb\",\"quote\":\"The Secretary shall make grants to eligible States for the allotments described in subsections (a) and (b). The Secretary shall make payments for the grants in accordance with section 6503(a) of title 31.\",\"start\":23980}],\"id\":\"urn:rulespec:document-understanding:revision:34834251f1d0d775cde6860b2354e3de11f23b44eb5b10ee0337e69501f55b7a\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:fe428a4bc8b94c732597cd629192316f8079776ef5f423a21a298ae36633988b\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:b7f993ead9443e0cc8e61dc2d194cee9a2afac5fb472a0e4b6c39ee8c92f940a\",\"origin\":\"aiSuggested\",\"quote\":\"The Secretary shall make grants to eligible States for the allotments described in subsections (a) and (b). The Secretary shall make payments for the grants in accordance with section 6503(a) of title 31.\",\"references\":[\"section 6503(a) of title 31\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:41a2261330d5b2e3cac17b6634053581b5bbad99063eb3b9824290e9d9473e5d\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"urn:rulespec:document-understanding:section:77b293a31882899a97687fe9cf87dc80be98be00fdc4957f7ebc1a1856d5f6c9\",\"start\":23980,\"summary\":\"The Secretary shall make grants to eligible States for the allotments described in subsections (a) and (b), and shall make payments for the grants in accordance with section 6503(a) of title 31.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

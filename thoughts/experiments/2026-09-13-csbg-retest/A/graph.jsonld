      "rkaf:selectorKind": [
        "oa:TextQuoteSelector",
        "oa:TextPositionSelector"
      ],
      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "(A) Subject to subparagraph (B), grants awarded pursuant to this section shall be used for programs and shall not exceed 50 per centum of the cost of such programs.\n\n(B) After the first funding period for which an eligible entity receives a grant under this section to carry out a program, the amount of a subsequent grant made under this section to such entity to carry out such program may not exceed 80 percent of the amount of the grant previously received by such entity under this section to carry out such program."
        },
        {
          "@type": "oa:TextPositionSelector",
          "oa:start": 113488,
          "oa:end": 114009,
          "rkaf:coordinateSystem": "rkaf:unicode-codepoint"
        }
      ]
    },

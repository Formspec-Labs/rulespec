      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"Secretary\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:2cb4f302dfa7e4dc5c2f711d56d2cde19752a410a7e29888be62cf7526681c20\",\"urn:rulespec:document-understanding:assertion:4fe17d817f9a8214ce6bfeff6d1f553181f0633a49470f6a1f89731fcec0c78c\",\"urn:rulespec:document-understanding:assertion:dbeffcb1ebdc843cfa99722166d34aca5bbe9df65f89cb4ea31433b0d5a50135\",\"urn:rulespec:document-understanding:assertion:20797204193e4ee8539ad179f599b6b03863458e2b3e6315eefc10ec7c7b70fc\",\"urn:rulespec:document-understanding:assertion:6577abfbbe11c76c852d60ebccfaa71d354dbbbc1d122266fe1036b85a6f9acf\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":100593,\"evidence\":[{\"end\":100112,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:100076:100112:sha256-5c4fa0260cf3562af3e87741f8f065246b6ea8e7184ea1182d24116ee479c2c8\",\"quote\":\"(2) Greater available appropriations\",\"start\":100076},{\"end\":100235,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:100113:100235:sha256-0294a65becc188b40e74b654402e9866c3cf9bd7d94ea71f98cd9fecfbda59ab\",\"quote\":\"Any amounts appropriated for a fiscal year to carry out this section in excess of $6,000,000 shall be allotted as follows:\",\"start\":100113},{\"end\":100251,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:100237:100251:sha256-9c42fb46ddf93b999d39103000936dbcb7ffda46cd45642986088a12333f6098\",\"quote\":\"(A) Allotments\",\"start\":100237},{\"end\":100593,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:100253:100593:sha256-a1282becf22f0f75ef22146ff27e52c79d852d4e22f621b6668a90c72131c584\",\"quote\":\"The Secretary shall use 40 percent of such excess to allot for grants under subsection (a) to eligible agencies for statewide programs in each State an amount that bears the same ratio to 40 percent of such excess as the low-income and unemployed population of such State bears to the low-income and unemployed population of all the States.\",\"start\":100253},{\"end\":100266,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:100257:100266:sha256-1395996a1068d26dcb8486df1e1db89b97a66f2ecf98d655defe059fcec4bd97\",\"quote\":\"Secretary\",\"start\":100257},{\"end\":100112,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:100076:100112:sha256-5c4fa0260cf3562af3e87741f8f065246b6ea8e7184ea1182d24116ee479c2c8\",\"quote\":\"(2) Greater available appropriations\",\"start\":100076},{\"end\":100235,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:100113:100235:sha256-0294a65becc188b40e74b654402e9866c3cf9bd7d94ea71f98cd9fecfbda59ab\",\"quote\":\"Any amounts appropriated for a fiscal year to carry out this section in excess of $6,000,000 shall be allotted as follows:\",\"start\":100113}],\"id\":\"urn:rulespec:document-understanding:revision:7530f47daad932a0449cba48fb85a81a7807b2f130b9e237075983855366d447\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:6577abfbbe11c76c852d60ebccfaa71d354dbbbc1d122266fe1036b85a6f9acf\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:040bd988b0965f4c2890d7cb474d8b1f20e596ecf64cc55cbc18ad795065ce61\",\"origin\":\"aiSuggested\",\"quote\":\"(2) Greater available appropriations Any amounts appropriated for a fiscal year to carry out this section in excess of $6,000,000 shall be allotted as follows:\\n\\n(A) Allotments\\n\\nThe Secretary shall use 40 percent of such excess to allot for grants under subsection (a) to eligible agencies for statewide programs in each State an amount that bears the same ratio to 40 percent of such excess as the low-income and unemployed population of such State bears to the low-income and unemployed population of all the States.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:caec4b68e2403a4cea02aa93c25e87f2002431295ba42c615af53d8737d9ddc8\",\"scope_quotes\":[\"(2) Greater available appropriations Any amounts appropriated for a fiscal year to carry out this section in excess of $6,000,000 shall be allotted as follows:\"],\"scope_text\":\"When amounts appropriated for a fiscal year to carry out section 9922 are in excess of $6,000,000.\",\"section_id\":\"urn:rulespec:document-understanding:section:cad1a9ce814f7bc8d23a6ff48e1865a684b16830bcf049a10118a7b6cab89b15\",\"start\":100076,\"summary\":\"If amounts appropriated for a fiscal year to carry out section 9922 exceed $6,000,000, the Secretary must use 40 percent of such excess to allot for grants under subsection (a) to eligible agencies for statewide programs in each State an amount that bears the same ratio to 40 percent of such excess as the low-income and unemployed population of such State bears to the low-income and unemployed population of all the States.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

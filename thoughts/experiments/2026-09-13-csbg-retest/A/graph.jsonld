      "dcterms:description": "{\"action\":\"\",\"actor\":\"service provider\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:d43524953831da527ede801995be24cc81f989b1b0814a6c6fd108e08232f8dd\",\"urn:rulespec:document-understanding:assertion:a7431751d29f4227187cfe90c7026dfc3cde53e885cd0c4b1a6b3e776aeefbb8\",\"urn:rulespec:document-understanding:assertion:a1bbb98d0d4515c394aa89359b8a0caa17a140ddb9c98a29b9ca3243b11eca03\",\"urn:rulespec:document-understanding:assertion:8dfa861150d1c73674c7f97647b9c8dacdac4ca6d3b2587d1f2ea2a4f9aa56b8\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":107413,\"evidence\":[{\"end\":106593,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:106571:106593:sha256-b22dea09f187f844d1f1a4c23f31678d9994d3ed45b831103a805c95fee515ee\",\"quote\":\"(d) Eligible providers\",\"start\":106571},{\"end\":106839,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:106594:106839:sha256-4156c5bef20658b50dde9946f239d650fb089cccd03ebc685285399e99145e08\",\"quote\":\"A service provider that is a national private, nonprofit organization, a coalition of such organizations, or a private, nonprofit organization applying jointly with a business concern shall be eligible to apply for a grant under this section if—\",\"start\":106594},{\"end\":107413,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:106841:107413:sha256-d5c87a6def94f59b4e5d9d33ac71dcb61eb73d311c48eda8dc8569e8e15cedb8\",\"quote\":\"(1) the applicant has demonstrated experience in operating a program providing instruction to low-income youth;\\n\\n(2) the applicant agrees to contribute an amount (in cash or in kind, fairly evaluated) of not less than 25 percent of the amount requested, for the program funded through the grant;\\n\\n(3) the applicant agrees to use no funds from a grant authorized under this section for administrative expenses; and\\n\\n(4) the applicant agrees to comply with the regulations or program guidelines promulgated by the Secretary for use of funds made available through the grant.\",\"start\":106841},{\"end\":106777,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:106596:106777:sha256-d2e0a9fec5899ef679b9025393618d2682b917a21434b1fec0768fb3af820bd7\",\"quote\":\"service provider that is a national private, nonprofit organization, a coalition of such organizations, or a private, nonprofit organization applying jointly with a business concern\",\"start\":106596},{\"end\":106804,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:106778:106804:sha256-6d9b2a075eb057a5b2ec9a79da03edef9f2c838fbbeaa33ea73834dc13bfe21a\",\"quote\":\"shall be eligible to apply\",\"start\":106778}],\"id\":\"urn:rulespec:document-understanding:revision:9bfce09a1d3e4ef1c8a3d2cc3f28cd75fb151d1d03e2e214b3306fe220ced658\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"permission\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:8dfa861150d1c73674c7f97647b9c8dacdac4ca6d3b2587d1f2ea2a4f9aa56b8\",\"modality\":\"may\",\"modality_quote\":\"shall be eligible to apply\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:08c877cc45dd3e3120d76e4b70254c73c3277feffba660663554f47bfc370e89\",\"origin\":\"aiSuggested\",\"quote\":\"(d) Eligible providers A service provider that is a national private, nonprofit organization, a coalition of such organizations, or a private, nonprofit organization applying jointly with a business concern shall be eligible to apply for a grant under this section if—\\n\\n(1) the applicant has demonstrated experience in operating a program providing instruction to low-income youth;\\n\\n(2) the applicant agrees to contribute an amount (in cash or in kind, fairly evaluated) of not less than 25 percent of the amount requested, for the program funded through the grant;\\n\\n(3) the applicant agrees to use no funds from a grant authorized under this section for administrative expenses; and\\n\\n(4) the applicant agrees to comply with the regulations or program guidelines promulgated by the Secretary for use of funds made available through the grant.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:53bc8df6c4a5d7694a272078e32559ff6f3f65568d6972937026ef666ab7d453\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"urn:rulespec:document-understanding:section:f3eea5347c895856895eee6edec328881bdec01acc0faf09e4d4dd77b2ba0a81\",\"start\":106571,\"summary\":\"A service provider that is a national private, nonprofit organization, a coalition of such organizations, or a private, nonprofit organization applying jointly with a business concern is eligible to apply for a grant under section 9923 if: (1) the applicant has demonstrated experience in operating a program providing instruction to low-income youth; (2) the applicant agrees to contribute an amount (in cash or in kind, fairly evaluated) of not less than 25 percent of the amount requested, for the program funded through the grant; (3) the applicant agrees to use no funds from a grant authorized under this section for administrative expenses; and (4) the applicant agrees to comply with the regulations or program guidelines promulgated by the Secretary for use of funds made available through the grant.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

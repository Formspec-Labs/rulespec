      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"defined_terms\":[{\"id\":\"urn:rulespec:document-understanding:term:18197e44e9217e632771fc8cefe12121ae56acb89335f8400a39dbebe2f91f91\",\"label\":\"qualified charity\",\"quote\":\"(i) In general The term “qualified charity” means any organization—\\n\\n(I) that is—\\n\\n(aa) described in section 501(c)(3) of title 26 and exempt from tax under section 501(a) of such title;\\n\\n(bb) an eligible entity; or\\n\\n(cc) a public housing agency as defined in section 1437a(b)(6) of this title;\\n\\n\\n(II) that is certified by the appropriate State authority as meeting the requirements of clauses (iii) and (iv); and\\n\\n(III) if such organization is otherwise required to file a return under section 6033 of such title, that elects to treat the information required to be furnished by clause (v) as being specified in section 6033(b) of such title.\",\"source_quotes\":[\"(i) In general The term “qualified charity” means any organization—\",\"(I) that is—\",\"(aa) described in section 501(c)(3) of title 26 and exempt from tax under section 501(a) of such title;\",\"(bb) an eligible entity; or\",\"(cc) a public housing agency as defined in section 1437a(b)(6) of this title;\",\"(II) that is certified by the appropriate State authority as meeting the requirements of clauses (iii) and (iv); and\",\"(III) if such organization is otherwise required to file a return under section 6033 of such title, that elects to treat the information required to be furnished by clause (v) as being specified in section 6033(b) of such title.\"]}],\"kind\":\"definition\",\"modality\":\"not_stated\",\"scope_text\":\"In this subsection\",\"summary\":\"The term \\\"qualified charity\\\" means any organization: (I) that is (aa) described in section 501(c)(3) of title 26 and exempt from tax under section 501(a) of such title, (bb) an eligible entity, or (cc) a public housing agency as defined in section 1437a(b)(6) of this title; (II) that is certified by the appropriate State authority as meeting the requirements of clauses (iii) and (iv); and (III) if such organization is otherwise required to file a return under section 6033 of such title, that elects to treat the information required to be furnished by clause (v) as being specified in section 6033(b) of such title.\"}",
        "@type": "xsd:string"
      },

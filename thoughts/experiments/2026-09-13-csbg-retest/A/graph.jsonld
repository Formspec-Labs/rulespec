    {
      "@id": "urn:rulespec:document-understanding:scope:d3a7a21a1e52b71ced9a5ef754e29d8aace9eb02f68dd17c75187ef8e1a4423d",
      "@type": "rkaf:ApplicabilityScope",
      "rkaf:appliesInJurisdiction": [],
      "rkaf:applicabilityCondition": "In order to determine whether eligible entities meet the performance goals, administrative standards, financial management requirements, and other requirements of a State"
    },
    {
      "@id": "urn:rulespec:document-understanding:assertion:f9553d310c94891acf4ea70d2639143a231938d9c7b5f1b6e3b80964fc60efeb",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:4633c72b9949e6d6951371bc0574fba50f8ba6a46700aec92d15b8c8b10c59fa",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:772912910f25c3b018f6b2b9d0d9f52575d2682e55f10e3ebc6f00b827dd5dfd",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:3ca96c0741e72232f963a856f205a6879d667be95bbc1f484484f0c76d1128e4",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:states-requirement",
      "rkaf:assertsValue": {
        "@value": "In order to determine whether eligible entities meet the performance goals, administrative standards, financial management requirements, and other requirements of a State, the State shall conduct the following reviews of eligible entities: (1) a full onsite review of each such entity at least once during each 3-year period; (2) an onsite review of each newly designated entity immediately after the completion of the first year in which such entity receives funds through the community services block grant program; (3) followup reviews including prompt return visits to eligible entities, and their programs, that fail to meet the goals, standards, and requirements established by the State; and (4) other reviews as appropriate, including reviews of entities with programs that have had other Federal, State, or local grants (other than assistance provided under chapter 106) terminated for cause.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },
    {
      "@id": "urn:rulespec:document-understanding:binding:eea85ab46b1ae89641aa79602ee08df7cf0beda9f36cec1df289747440aef711",
      "@type": "rkaf:EvidenceBinding",
      "rkaf:bindsAssertion": "urn:rulespec:document-understanding:assertion:f9553d310c94891acf4ea70d2639143a231938d9c7b5f1b6e3b80964fc60efeb",
      "rkaf:evidenceRole": "rkaf:textualEvidence",

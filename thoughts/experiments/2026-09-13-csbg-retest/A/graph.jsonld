      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:13ca9ad2e7bba057ac6d588ddf7d5eb42520e31913a6df6c48fea8f27b78156f\",\"urn:rulespec:document-understanding:assertion:ae42cc42148d65514edcfcd1c0199f7103a65eeb10b2ed05014d21aaf0bc1693\",\"urn:rulespec:document-understanding:assertion:c9307dad8014ebb2fc50845bc13bb1490baf2f1da639fed8ca1c507456ab657f\",\"urn:rulespec:document-understanding:assertion:63b1a2816e8f359fbd58daeb952f7b2aad0373c8be2984225a70a0ce351082c0\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":102024,\"evidence\":[{\"end\":101509,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:101464:101509:sha256-f48315f2a244f2c94b03d91853ce922a3feeeeb646aa5f070962814d69794168\",\"quote\":\"(4) Minimum allotments for statewide programs\",\"start\":101464},{\"end\":101525,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:101511:101525:sha256-ca9693d7a03c9f0992c78cc6587bb92ef32954c0803056e0a7056d093f04556c\",\"quote\":\"(A) In general\",\"start\":101511},{\"end\":101661,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:101526:101661:sha256-d194ab067108ebacee148f7b71a9928f8c80933f85235db7ffbc090abc518a06\",\"quote\":\"From the amounts allotted under paragraphs (1)(A) and (2)(A), the minimum total allotment for each State for each fiscal year shall be—\",\"start\":101526},{\"end\":102024,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:101663:102024:sha256-d86aea92e919c4479e02f5b6fae78a381e01fde3e0a444ebb3317a172e8cb5e6\",\"quote\":\"(i) $15,000 if the total amount appropriated to carry out this section is not less than $7,000,000 but less than $10,000,000;\\n\\n(ii) $20,000 if the total amount appropriated to carry out this section is not less than $10,000,000 but less than $15,000,000; or\\n\\n(iii) $30,000 if the total amount appropriated to carry out this section is not less than $15,000,000.\",\"start\":101663},{\"end\":101657,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:101652:101657:sha256-56ee5b508706bf2de91712d85d6d1e11ddbff01949142ed6e8c22e3b1bed1c71\",\"quote\":\"shall\",\"start\":101652}],\"id\":\"urn:rulespec:document-understanding:revision:00efbea6e7ecd0aab91764de917f818940277e7794a7050fbb6796432fd67c29\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:c9307dad8014ebb2fc50845bc13bb1490baf2f1da639fed8ca1c507456ab657f\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:7d17e5c46d000781d32458c6a83fd2fd2b8721281cd4276faf2f0e65b57b2c8d\",\"origin\":\"aiSuggested\",\"quote\":\"(4) Minimum allotments for statewide programs\\n\\n(A) In general From the amounts allotted under paragraphs (1)(A) and (2)(A), the minimum total allotment for each State for each fiscal year shall be—\\n\\n(i) $15,000 if the total amount appropriated to carry out this section is not less than $7,000,000 but less than $10,000,000;\\n\\n(ii) $20,000 if the total amount appropriated to carry out this section is not less than $10,000,000 but less than $15,000,000; or\\n\\n(iii) $30,000 if the total amount appropriated to carry out this section is not less than $15,000,000.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:79cb938cb6adfb519a9967949d2c1e9b96b1ff4272c9416af2d7e14281aa6039\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"urn:rulespec:document-understanding:section:cad1a9ce814f7bc8d23a6ff48e1865a684b16830bcf049a10118a7b6cab89b15\",\"start\":101464,\"summary\":\"From the amounts allotted under paragraphs (1)(A) and (2)(A) of section 9922(b), the minimum total allotment for each State for each fiscal year must be: (i) $15,000 if the total amount appropriated to carry out section 9922 is not less than $7,000,000 but less than $10,000,000; (ii) $20,000 if the total amount appropriated is not less than $10,000,000 but less than $15,000,000; or (iii) $30,000 if the total amount appropriated is not less than $15,000,000.\",\"target_ids\":[],\"term_refs\":[\"urn:rulespec:document-understanding:term:e974d50017e171b119207310224dda30d9f1cb5e9e6df8de3c891ee2defedac2\"],\"typed_values\":[]}",

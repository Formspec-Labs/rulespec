      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"actor\":\"Secretary\",\"kind\":\"prohibition\",\"modality\":\"must_not\",\"scope_text\":\"For any fiscal year, regarding funds made available under paragraphs (1)(B), (2)(B), and (2)(C) of section 9922(b).\",\"summary\":\"The Secretary must not make grants under subsection (a) to an eligible agency in an aggregate amount exceeding $50,000 from funds made available under paragraphs (1)(B) and (2)(B) for any fiscal year, and must not make grants under subsection (a) to an eligible agency in an aggregate amount exceeding $300,000 from funds made available under paragraph (2)(C) for any fiscal year.\"}",
        "@type": "xsd:string"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed",

      "dcterms:description": "{\"action\":\"\",\"actor\":\"the Secretary\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:91554f4eb0879018aa57afdfc2f517cca724f6c2249bc45c024fb14b3b0214ae\",\"urn:rulespec:document-understanding:assertion:7c5a25c921c4de2d4128aee321a15e0e8411d01416838ee75639b731df10239d\",\"urn:rulespec:document-understanding:assertion:f6898585f6f0612bc58369e949cf3d48938c30f413c9885180237935cc88e01b\",\"urn:rulespec:document-understanding:assertion:ff1e69d03037c5804bbf28c7b69980cf7671a09b3d0496b62e2ae96460e6f670\",\"urn:rulespec:document-understanding:assertion:389a600cd529b20e96235dcbc4247f503e2bec1e71dc1f45e49bd5f1cebcf3fe\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":71229,\"evidence\":[{\"end\":71229,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:70569:71229:sha256-839e4147687db874cf158bdb26785077263ea2b10ebf9d4a38d9764d33527775\",\"quote\":\"Whenever a State violates the assurances contained in section 9908(b)(8) of this title and terminates or reduces the funding of an eligible entity prior to the completion of the State hearing described in that section and the Secretary’s review as required in subsection (b), the Secretary is authorized to provide financial assistance under this chapter to the eligible entity affected until the violation is corrected. In such a case, the grant or allotment for the State under section 9905 or 9906 of this title for the earliest appropriate fiscal year shall be reduced by an amount equal to the funds provided under this subsection to such eligible entity.\",\"start\":70569},{\"end\":70875,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac
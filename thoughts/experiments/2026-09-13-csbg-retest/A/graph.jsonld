      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"actor\":\"Each jurisdiction to which subsection (a) applies\",\"kind\":\"permission\",\"modality\":\"may\",\"scope_text\":\"on submitting to the Secretary, and obtaining approval of, an application, containing provisions that describe the programs for which assistance is sought under this section, that is prepared in accordance with, and contains the information described in, section 9908 of this title\",\"summary\":\"Each jurisdiction to which subsection (a) applies (Guam, American Samoa, the United States Virgin Islands, and the Commonwealth of the Northern Mariana Islands) may receive a grant under section 9905 of title 42 for the amount apportioned under subsection (a) on submitting to the Secretary, and obtaining approval of, an application containing provisions describing the programs for which assistance is sought under section 9905, prepared in accordance with and containing the information described in section 9908 of title 42.\",\"term_refs\":[\"urn:rulespec:document-understanding:term:f4c9f84c522e2926470ee048e00856dd704855d4dcd8ecb6fa6c2d3ecf28658e\"]}",

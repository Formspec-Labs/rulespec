      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"kind\":\"statement\",\"modality\":\"not_stated\",\"summary\":\"The purposes of chapter 106 are (1) to provide assistance to States and local communities, working through a network of community action agencies and other neighborhood-based organizations, for the reduction of poverty, the revitalization of low-income communities, and the empowerment of low-income families and individuals in rural and urban areas to become fully self-sufficient (particularly families attempting to transition off a State program carried out under part A of title IV of the Social Security Act); and (2) to accomplish those goals through strengthening community capabilities for planning and coordinating broad assistance responsive to local needs; organizing services related to low-income family and individual needs to have measurable and potentially major impact on causes of poverty and help achieve self-sufficiency; greater use of innovative and effective community-based approaches to attacking poverty and community breakdown causes and effects; maximum participation of residents of low-income communities and members of groups served by block grant assisted programs to empower them to respond to unique community problems and needs; and broadening the resource base to secure a more active role in service provision for private, religious, charitable, and neighborhood-based organizations as well as individual citizens, business, labor, and professional groups.\",\"term_refs\":[\"urn:rulespec:document-understanding:term:737b4a835a77703334e5da03eb8fc1a624a2cb0dd700298e37ccafb980c36609\"]}",
        "@type": "xsd:string"
      },

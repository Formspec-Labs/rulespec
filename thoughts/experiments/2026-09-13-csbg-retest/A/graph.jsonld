      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:772912910f25c3b018f6b2b9d0d9f52575d2682e55f10e3ebc6f00b827dd5dfd",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:fbc4fced25c584079a90ce3bb1b070f243897dcd692582e99f35d9fd69e3aeb8",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"actor\":\"The Secretary\",\"kind\":\"requirement\",\"modality\":\"must\",\"summary\":\"The Secretary shall conduct in several States in each fiscal year evaluations (including investigations) of the use of funds received by the States under chapter 106 of title 42 in order to evaluate compliance with the provisions of chapter 106, and especially with respect to compliance with section 9908(b) of title 42.\"}",
        "@type": "xsd:string"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

    {
      "@id": "urn:rulespec:document-understanding:term:ca20ceed30ae0a0911767a093489f68e805d2d7d4521647642dbcb955f99464f",
      "@type": "rkaf:LocalConcept",
      "skos:prefLabel": {
        "en": "poverty program expense"
      },
      "skos:definition": {
        "en": "For purposes of subclause (I), the term \"poverty program expense\" means any expense in providing direct services referred to in clause (iii), but shall not include any management or general expense, any expense for the purpose of influencing legislation (as defined in section 4911(d) of title 26), any expense for the purpose of fundraising, any expense for a legal service provided on behalf of any individual referred to in clause (iii), any expense for providing tuition assistance relating to compulsory school attendance, and any expense that consists of a payment to an affiliate of the organization."
      },
      "skos:inScheme": "urn:rulespec:document-understanding:defined-term-scheme:26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023",

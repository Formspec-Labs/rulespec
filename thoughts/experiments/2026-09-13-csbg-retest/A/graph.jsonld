      "rkaf:hasContentDigest": "sha256:0d859b4b1e92c9d0770e8d2f78a422283a500a2c114a9ea0890b46b9856b5e52",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"Secretary\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:ce62756db749b8cadb8f5d7fc9e2af50b2f9356e0d006f2bfe0c9b36457c6ffa\",\"urn:rulespec:document-understanding:assertion:c1dd0a4df026309676148f6fc905d17188ffbe360f998c29da6bfad62194a29b\",\"urn:rulespec:document-understanding:assertion:0e5b8f90a7592d0fa81de4909980e5d38057b85b7f4e7160a4d02e5a7261f95a\",\"urn:rulespec:document-understanding:assertion:cf9e6c478b07b7ee56f4cc34f5cda898bdcca6e09a34c386409ea4c10345272a\",\"urn:rulespec:document-understanding:assertion:28715c1ee074aeda80693d13404a981fc1db19189480b535a46a3ac5b5e45d53\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":101153,\"evidence\":[{\"end\":100112,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:100076:100112:sha256-5c4fa0260cf3562af3e87741f8f065246b6ea8e7184ea1182d24116ee479c2c8\",\"quote\":\"(2) Greater available appropriations\",\"start\":100076},{\"end\":100235,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:100113:100235:sha256-0294a65becc188b40e74b654402e9866c3cf9bd7d94ea71f98cd9fecfbda59ab\",\"quote\":\"Any amounts appropriated for a fiscal year to carry out this section in excess of $6,000,000 shall be allotted as follows:\",\"start\":100113},{\"end\":100251,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:100237:100251:sha256-9c42fb46ddf93b999d39103000936dbcb7ffda46cd45642986088a12333f6098\",\"quote\":\"(A) Allotments\",\"start\":100237},{\"end\":100651,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:100253:100651:sha256-978f071079c0619102a2d1f6608a09bef41092feef21729f28471f6c220bb871\",\"quote\":\"The Secretary shall use 40 percent of such excess to allot for grants under subsection (a) to eligible agencies for statewide programs in each State an amount that bears the same ratio to 40 percent of such excess as the low-income and unemployed population of such State bears to the low-income and unemployed population of all the States.\\n\\n\\n(B) Competitive grants for local and statewide programs\",\"start\":100253},{\"end\":100865,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:100653:100865:sha256-ed81782d1eee5369e9393bd6d94ba14a8fd15dfb074e51d7b441863978841c4a\",\"quote\":\"The Secretary shall use 40 percent of such excess to make grants under subsection (a) on a competitive basis to eligible agencies for local and statewide programs.\\n\\n\\n(C) Competitive grants for nationwide programs\",\"start\":100653},{\"end\":101153,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:100867:101153:sha256-86b5769ffb068f6962d131f0ff6fed5ff5798dc28c35ffe851aeb6a8a23ad5f5\",\"quote\":\"The Secretary shall use the remaining 20 percent of such excess to make grants under subsection (a) on a competitive basis to eligible agencies for nationwide programs, including programs benefiting Indians, as defined in section 9911 of this title, and migrant or seasonal farmworkers.\",\"start\":100867},{\"end\":100112,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:100076:100112:sha256-5c4fa0260cf3562af3e87741f8f065246b6ea8e7184ea1182d24116ee479c2c8\",\"quote\":\"(2) Greater available appropriations\",\"start\":100076},{\"end\":100235,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:100113:100235:sha256-0294a65becc188b40e74b654402e9866c3cf9bd7d94ea71f98cd9fecfbda59ab\",\"quote\":\"Any amounts appropriated for a fiscal year to carry out this section in excess of $6,000,000 shall be allotted as follows:\",\"start\":100113}],\"id\":\"urn:rulespec:document-understanding:revision:35c6590b6e2f8e457d8eb954e687475c06183c17335a738ba8653a429ff83089\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:28715c1ee074aeda80693d13404a981fc1db19189480b535a46a3ac5b5e45d53\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:6dbd1dcff912a4e68c2f773b79416e8ecb358254130933d1a6bd82a9ac1700df\",\"origin\":\"aiSuggested\",\"quote\":\"(2) Greater available appropriations Any amounts appropriated for a fiscal year to carry out this section in excess of $6,000,000 shall be allotted as follows:\\n\\n(A) Allotments\\n\\nThe Secretary shall use 40 percent of such excess to allot for grants under subsection (a) to eligible agencies for statewide programs in each State an amount that bears the same ratio to 40 percent of such excess as the low-income and unemployed population of such State bears to the low-income and unemployed population of all the States.\\n\\n\\n(B) Competitive grants for local and statewide programs\\n\\nThe Secretary shall use 40 percent of such excess to make grants under subsection (a) on a competitive basis to eligible agencies for local and statewide programs.\\n\\n\\n(C) Competitive grants for nationwide programs\\n\\nThe Secretary shall use the remaining 20 percent of such excess to make grants under subsection (a) on a competitive basis to eligible agencies for nationwide programs, including programs benefiting Indians, as defined in section 9911 of this title, and migrant or seasonal farmworkers.\",\"references\":[\"42 U.S.C. 9911\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:0afde7ff4b5e969f293385e138a364c624465dbdad1fbcbee23f44d082018fe4\",\"scope_quotes\":[\"(2) Greater available appropriations Any amounts appropriated for a fiscal year to carry out this section in excess of $6,000,000 shall be allotted as follows:\"],\"scope_text\":\"When amounts appropriated for a fiscal year to carry out section 9922 are in excess of $6,000,000.\",\"section_id\":\"urn:rulespec:document-understanding:section:cad1a9ce814f7bc8d23a6ff48e1865a684b16830bcf049a10118a7b6cab89b15\",\"start\":100076,\"summary\":\"If amounts appropriated for a fiscal year to carry out section 9922 exceed $6,000,000, the Secretary must use the remaining 20 percent of such excess to make grants under subsection (a) on a competitive basis to eligible agencies for nationwide programs, including programs benefiting Indians (as defined in section 9911 of this title) and migrant or seasonal farmworkers.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

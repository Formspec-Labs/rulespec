      "dcterms:description": "{\"action\":\"\",\"actor\":\"Secretary\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:fbbee1bf0115fa25a8afdfe18b717f05d1b9bff7f3cad8866c62a42f13b94528\",\"urn:rulespec:document-understanding:assertion:4833e539e57bf62807c62980ffe0683d1b6876c17c55416cf00857bca509d68a\",\"urn:rulespec:document-understanding:assertion:82ca29a6ce5b80c62eee30eaba4e82a603f3f7a9fa2fc39bc734ca4f409695e2\",\"urn:rulespec:document-understanding:assertion:efc33cfe493e66639f722eaf0bc8bf394eb8a33c5722a4f4dd1a34a9ce0dce8d\",\"urn:rulespec:document-understanding:assertion:75a19546546e3d32b8df576e7dc416b98a077783abcd86d87f3f09b8e07ce41f\",\"urn:rulespec:document-understanding:assertion:5bd3bdace23d980fba69c2c5d1dab592f3a36a8d6453bdd85591aeee14756332\",\"urn:rulespec:document-understanding:assertion:fc7dc450cc17c42b92668f75c8bf9d90cfeb08b0c2e347a60aad5d39b54445d6\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":23264,\"evidence\":[{\"end\":22849,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:22797:22849:sha256-4541d45ba60b9f52c3f9f8efcde31f12ef7a1dec61f2c442fb8a60bb8443fb60\",\"quote\":\"(b) Allotments in years with greater available funds\",\"start\":22797},{\"end\":22873,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:22851:22873:sha256-8690012e52083c30f31880c2ce66cff1b189e6929526cef3a4b3f07dd7b05813\",\"quote\":\"(1) Minimum allotments\",\"start\":22851},{\"end\":23264,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:22875:23264:sha256-788b266dcb666b21f42cf1560aef8254bd6fbc2ca19244fb0745b945a3ceaffd\",\"quote\":\"Subject to paragraphs (2) and (3), if the amount appropriated under section 9903(a) of this title for a fiscal year that remains after the Secretary makes the reservations required in section 9903(b) of this title exceeds $345,000,000, the Secretary shall allot to each State not less than ½ of 1 percent of the amount appropriated under section 9903(a) of this title for such fiscal year.\",\"start\":22875},{\"end\":23136,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:23125:23136:sha256-c235b786870eb293aa012d1f74adf87dd0f5f32a74e8cfdc7c5f8a8e46268d0c\",\"quote\":\"shall allot\",\"start\":23125},{\"end\":23264,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:22875:23264:sha256-788b266dcb666b21f42cf1560aef8254bd6fbc2ca19244fb0745b945a3ceaffd\",\"quote\":\"Subject to paragraphs (2) and (3), if the amount appropriated under section 9903(a) of this title for a fiscal year that remains after the Secretary makes the reservations required in section 9903(b) of this title exceeds $345,000,000, the Secretary shall allot to each State not less than ½ of 1 percent of the amount appropriated under section 9903(a) of this title for such fiscal year.\",\"start\":22875}],\"id\":\"urn:rulespec:document-understanding:revision:6156049f5f82bd87f098865ec5752c245ccbc0acc9547c62f15335b9cb21b1a8\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:75a19546546e3d32b8df576e7dc416b98a077783abcd86d87f3f09b8e07ce41f\",\"modality\":\"must\",\"modality_quote\":\"shall allot\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:380a3c697e8af94878324a14dc7437637eb05b5870cd9d1849a6a389d98eb0a4\",\"origin\":\"aiSuggested\",\"quote\":\"(b) Allotments in years with greater available funds\\n\\n(1) Minimum allotments\\n\\nSubject to paragraphs (2) and (3), if the amount appropriated under section 9903(a) of this title for a fiscal year that remains after the Secretary makes the reservations required in section 9903(b) of this title exceeds $345,000,000, the Secretary shall allot to each State not less than ½ of 1 percent of the amount appropriated under section 9903(a) of this title for such fiscal year.\",\"references\":[\"paragraphs (2) and (3)\",\"section 9903(a)\",\"section 9903(b)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:4ed92f6af3edcff3d5caf655eade142639969771151e2db6720969b6d9b3d2a0\",\"scope_quotes\":[\"Subject to paragraphs (2) and (3), if the amount appropriated under section 9903(a) of this title for a fiscal year that remains after the Secretary makes the reservations required in section 9903(b) of this title exceeds $345,000,000, the Secretary shall allot to each State not less than ½ of 1 percent of the amount appropriated under section 9903(a) of this title for such fiscal year.\"],\"scope_text\":\"Subject to paragraphs (2) and (3), if the amount appropriated under section 9903(a) of this title for a fiscal year that remains after the Secretary makes the reservations required in section 9903(b) of this title exceeds $345,000,000\",\"section_id\":\"urn:rulespec:document-understanding:section:77b293a31882899a97687fe9cf87dc80be98be00fdc4957f7ebc1a1856d5f6c9\",\"start\":22797,\"summary\":\"Subject to paragraphs (2) and (3) of section 9906(b), if the amount appropriated under section 9903(a) of title 42 for a fiscal year that remains after the Secretary makes the reservations required in section 9903(b) exceeds $345,000,000, the Secretary shall allot to each State not less than 1/2 of 1 percent of the amount appropriated under section 9903(a) for such fiscal year.\",\"target_ids\":[],\"term_refs\":[\"urn:rulespec:document-understanding:term:f4c9f84c522e2926470ee048e00856dd704855d4dcd8ecb6fa6c2d3ecf28658e\",\"urn:rulespec:document-understanding:term:737b4a835a77703334e5da03eb8fc1a624a2cb0dd700298e37ccafb980c36609\"],\"typed_values\":[]}",

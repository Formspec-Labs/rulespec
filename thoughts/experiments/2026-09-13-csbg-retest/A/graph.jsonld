      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"the Secretary\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:351527be19ce904962499340b42dcf334cd0db924768244b01c20e65147b7c7c\",\"urn:rulespec:document-understanding:assertion:5e648efc1f2ea2f3a3a0694c3a9e11ebeb31ec5a1ef9bd3cbd72bf60eb3d940e\",\"urn:rulespec:document-understanding:assertion:c280ea0e77c130a2fffbab001d01012efd8e861088964acdbb2c13890683a3a6\",\"urn:rulespec:document-understanding:assertion:732afda3e12b3c66fd15f8aaf03f309b0308aa3911ac91c6c4d4c3d088851391\",\"urn:rulespec:document-understanding:assertion:0757649bdfd59804a8f91637faf2afe8b11c67d1b73667e5227fb4b2263d54ee\",\"urn:rulespec:document-understanding:assertion:558b4a4b7548ba7057a5a2f801f08d387901e2ace28a5b5a7fcbb656f1575033\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":59645,\"evidence\":[{\"end\":59052,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:59037:59052:sha256-99a455f2bc376242ecdd7d7e7b84122bdc7bafcc965610878f7ab795359830e7\",\"quote\":\"(a) Reservation\",\"start\":59037},{\"end\":59098,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:59053:59098:sha256-97c4a983cdbaf1fa6f20740d38976072f6e4b9e308cb34c59f3c5824aec1d170\",\"quote\":\"If, with respect to any State, the Secretary—\",\"start\":59053},{\"end\":59645,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:59100:59645:sha256-5694ee3d4d8344894755da128ae6d9aee99ca5674bbe68a656d7631613cd5121\",\"quote\":\"(1) receives a request from the governing body of an Indian tribe or tribal organization within the State that assistance under this chapter be made directly to such tribe or organization; and\\n\\n(2) determines that the members of such tribe or tribal organization would be better served by means of grants made directly to provide benefits under this chapter,\\n\\n\\nthe Secretary shall reserve from amounts that would otherwise be allotted to such State under section 9906 of this title for the fiscal year the amount determined under subsection (b).\",\"start\":59100},{\"end\":59480,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:59475:59480:sha256-56ee5b508706bf2de91712d85d6d1e11ddbff01949142ed6e8c22e3b1bed1c71\",\"quote\":\"shall\",\"start\":59475},{\"end\":59052,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:59037:59052:sha256-99a455f2bc376242ecdd7d7e7b84122bdc7bafcc965610878f7ab795359830e7\",\"quote\":\"(a) Reservation\",\"start\":59037},{\"end\":59098,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:59053:59098:sha256-97c4a983cdbaf1fa6f20740d38976072f6e4b9e308cb34c59f3c5824aec1d170\",\"quote\":\"If, with respect to any State, the Secretary—\",\"start\":59053},{\"end\":59458,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:59100:59458:sha256-8cb1ad39da86d02340642f0122adbe126f5259b3d36f1b25301ae7a3d563ad15\",\"quote\":\"(1) receives a request from the governing body of an Indian tribe or tribal organization within the State that assistance under this chapter be made directly to such tribe or organization; and\\n\\n(2) determines that the members of such tribe or tribal organization would be better served by means of grants made directly to provide benefits under this chapter,\",\"start\":59100}],\"id\":\"urn:rulespec:document-understanding:revision:657acf8a8fa91a8a4e8ab8fe8e4bb69fde30fb23f3a9d99552cd0ce6d9b50743\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:0757649bdfd59804a8f91637faf2afe8b11c67d1b73667e5227fb4b2263d54ee\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:91de98fed5d3e2dc8c60facaa45db682cc9600765e23da065e8047849b0ee36c\",\"origin\":\"aiSuggested\",\"quote\":\"(a) Reservation If, with respect to any State, the Secretary—\\n\\n(1) receives a request from the governing body of an Indian tribe or tribal organization within the State that assistance under this chapter be made directly to such tribe or organization; and\\n\\n(2) determines that the members of such tribe or tribal organization would be better served by means of grants made directly to provide benefits under this chapter,\\n\\n\\nthe Secretary shall reserve from amounts that would otherwise be allotted to such State under section 9906 of this title for the fiscal year the amount determined under subsection (b).\",\"references\":[\"section 9906\",\"subsection (b)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:4a5b633ee72e34b94327f129082bcb6af9ec1f19320417a045e3b1cb82c735cc\",\"scope_quotes\":[\"(a) Reservation If, with respect to any State, the Secretary—\\n\\n(1) receives a request from the governing body of an Indian tribe or tribal organization within the State that assistance under this chapter be made directly to such tribe or organization; and\\n\\n(2) determines that the members of such tribe or tribal organization would be better served by means of grants made directly to provide benefits under this chapter,\"],\"scope_text\":\"If, with respect to any State, the Secretary— (1) receives a request from the governing body of an Indian tribe or tribal organization within the State that assistance under this chapter be made directly to such tribe or organization; and (2) determines that the members of such tribe or tribal organization would be better served by means of grants made directly to provide benefits under this chapter\",\"section_id\":\"urn:rulespec:document-understanding:section:3c750aa6689e2d574a3e823610c64c083d9c43e7cd5caf47f66392a719ccd88d\",\"start\":59037,\"summary\":\"If, with respect to any State, the Secretary receives a request from the governing body of an Indian tribe or tribal organization within the State that assistance under chapter 106 of title 42 be made directly to such tribe or organization, and determines that the members of such tribe or tribal organization would be better served by means of grants made directly to provide benefits under chapter 106, the Secretary shall reserve from amounts that would otherwise be allotted to such State under section 9906 of title 42 for the fiscal year the amount determined under 42 U.S.C. 9911(b).\",\"target_ids\":[],\"term_refs\":[\"urn:rulespec:document-understanding:term:be208b5fb6ddd45aa2cd6341bd365708cad1f86d8514c718263e4e43b937e694\"],\"typed_values\":[]}",

    {
      "@id": "urn:rulespec:document-understanding:scope:ba04bc880fa12bc71704b1f3b052256137b7b78d62645930451b8885593877aa",
      "@type": "rkaf:ApplicabilityScope",
      "rkaf:appliesInJurisdiction": [],
      "rkaf:applicabilityCondition": "If the State determines, on the basis of a final decision in a review pursuant to section 9914 of this title, that an eligible entity fails to comply with the terms of an agreement, or the State plan, to provide services under this chapter or to meet appropriate standards, goals, and other requirements established by the State (including performance objectives)"
    },
    {
      "@id": "urn:rulespec:document-understanding:assertion:075b3f947467f1991d98439e620c1eb278b64c2bcc23e0ef695851a849c233b2",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:4633c72b9949e6d6951371bc0574fba50f8ba6a46700aec92d15b8c8b10c59fa",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:772912910f25c3b018f6b2b9d0d9f52575d2682e55f10e3ebc6f00b827dd5dfd",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:779c6c34c323804dbce9a0279ddf467cc0b1bf22ef3b3830d87685eeb3a08d23",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:states-requirement",
      "rkaf:assertsValue": {
        "@value": "If the State determines, on the basis of a final decision in a review pursuant to section 9914 of title 42, that an eligible entity fails to comply with the terms of an agreement, or the State plan, to provide services under chapter 106 of title 42 or to meet appropriate standards, goals, and other requirements established by the State (including performance objectives), the State shall: (1) inform the entity of the deficiency to be corrected; (2) require the entity to correct the deficiency; (3) offer training and technical assistance, if appropriate, to help correct the deficiency, and prepare and submit to the Secretary a report describing the training and technical assistance offered, or if the State determines that such training and technical assistance are not appropriate, prepare and submit to the Secretary a report stating the reasons for the determination; (4) at the discretion of the State (taking into account the seriousness of the deficiency and the time reasonably required to correct the deficiency), allow the entity to develop and implement, within 60 days after being informed of the deficiency, a quality improvement plan to correct such deficiency within a reasonable period of time, as determined by the State, and not later than 30 days after receiving from an eligible entity a proposed quality improvement plan pursuant to subparagraph (A), either approve such proposed plan or specify the reasons why the proposed plan cannot be approved; and (5) after providing adequate notice and an opportunity for a hearing, initiate proceedings to terminate the designation of or reduce the funding under chapter 106 of the eligible entity unless the entity corrects the deficiency.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

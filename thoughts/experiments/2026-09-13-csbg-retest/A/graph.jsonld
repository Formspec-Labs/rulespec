      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"the State\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:85cc1fa4b1034abdb21ea6bbeda9e1ed0cec10621983c9ddf454b6170e42381a\",\"urn:rulespec:document-understanding:assertion:5a022e171b0241a1336c9b6304a05ff44980e4cc7af10b5e3cca19eb90d1df16\",\"urn:rulespec:document-understanding:assertion:0778bd4164784ce1943c6fa840bb692c99ce2a7245a8cd3f1e5892770445d48f\",\"urn:rulespec:document-understanding:assertion:6cf06362691ad1cdcd3bbbbc1153fa276cc215d684dcef7889f5819aa7252b0b\",\"urn:rulespec:document-understanding:assertion:7f96b2f3bb4957faac4adb0dab429705cd3dc329696d4abcc90bd8b23c4181f8\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":27909,\"evidence\":[{\"end\":26276,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:26256:26276:sha256-48199a5a79ebce7b33fc8b9d76880c9b50a9385f015b3c974ffcbaf5772fe56c\",\"quote\":\"(1) Use of remainder\",\"start\":26256},{\"end\":26588,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:26277:26588:sha256-aa538aa00af95f7c408e6ce9d451df4b12e8ddce453f448fe3df053af7b707b4\",\"quote\":\"If a State uses less than 100 percent of the grant or allotment received under section 9905 or 9906 of this title to make grants under subsection (a), the State shall use the remainder of the grant or allotment under section 9905 or 9906 of this title (subject to paragraph (2)) for activities that may include—\",\"start\":26277},{\"end\":27909,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:26590:27909:sha256-8e49b3b1de77b5bc0e4764034d037439fddbb252a4d3e43126578fa30c03efb8\",\"quote\":\"(A) providing training and technical assistance to those entities in need of such training and assistance;\\n\\n(B) coordinating State-operated programs and services, and at the option of the State, locally-operated programs and services, targeted to low-income children and families with services provided by eligible entities and other organizations funded under this chapter, including detailing appropriate employees of State or local agencies to entities funded under this chapter, to ensure increased access to services provided by such State or local agencies;\\n\\n(C) supporting statewide coordination and communication among eligible entities;\\n\\n(D) analyzing the distribution of funds made available under this chapter within the State to determine if such funds have been targeted to the areas of greatest need;\\n\\n(E) supporting asset-building programs for low-income individuals, such as programs supporting individual development accounts;\\n\\n(F) supporting innovative programs and activities conducted by community action agencies or other neighborhood-based organizations to eliminate poverty, promote self-sufficiency, and promote community revitalization;\\n\\n(G) supporting State charity tax credits as described in subsection (c); and\\n\\n(H) supporting other activities, consistent with the purposes of this chapter.\",\"start\":26590},{\"end\":26443,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:26438:26443:sha256-56ee5b508706bf2de91712d85d6d1e11ddbff01949142ed6e8c22e3b1bed1c71\",\"quote\":\"shall\",\"start\":26438},{\"end\":26276,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:26256:26276:sha256-48199a5a79ebce7b33fc8b9d76880c9b50a9385f015b3c974ffcbaf5772fe56c\",\"quote\":\"(1) Use of remainder\",\"start\":26256},{\"end\":26588,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:26277:26588:sha256-aa538aa00af95f7c408e6ce9d451df4b12e8ddce453f448fe3df053af7b707b4\",\"quote\":\"If a State uses less than 100 percent of the grant or allotment received under section 9905 or 9906 of this title to make grants under subsection (a), the State shall use the remainder of the grant or allotment under section 9905 or 9906 of this title (subject to paragraph (2)) for activities that may include—\",\"start\":26277}],\"id\":\"urn:rulespec:document-understanding:revision:9867d090f0f643b8325c8c126c9d9be3c0df6452ee035023908119ebf22b2cef\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:7f96b2f3bb4957faac4adb0dab429705cd3dc329696d4abcc90bd8b23c4181f8\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:6ec19b4429b55d10ad5e6281bc15ed1bc501491962753771c875eb468dd8b064\",\"origin\":\"aiSuggested\",\"quote\":\"(1) Use of remainder If a State uses less than 100 percent of the grant or allotment received under section 9905 or 9906 of this title to make grants under subsection (a), the State shall use the remainder of the grant or allotment under section 9905 or 9906 of this title (subject to paragraph (2)) for activities that may include—\\n\\n(A) providing training and technical assistance to those entities in need of such training and assistance;\\n\\n(B) coordinating State-operated programs and services, and at the option of the State, locally-operated programs and services, targeted to low-income children and families with services provided by eligible entities and other organizations funded under this chapter, including detailing appropriate employees of State or local agencies to entities funded under this chapter, to ensure increased access to services provided by such State or local agencies;\\n\\n(C) supporting statewide coordination and communication among eligible entities;\\n\\n(D) analyzing the distribution of funds made available under this chapter within the State to determine if such funds have been targeted to the areas of greatest need;\\n\\n(E) supporting asset-building programs for low-income individuals, such as programs supporting individual development accounts;\\n\\n(F) supporting innovative programs and activities conducted by community action agencies or other neighborhood-based organizations to eliminate poverty, promote self-sufficiency, and promote community revitalization;\\n\\n(G) supporting State charity tax credits as described in subsection (c); and\\n\\n(H) supporting other activities, consistent with the purposes of this chapter.\",\"references\":[\"section 9905\",\"section 9906\",\"subsection (a)\",\"paragraph (2)\",\"subsection (c)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:122697e68db0cc224ecf1415b48a0126f8c3808f6888553121abe368f67ddee7\",\"scope_quotes\":[\"(1) Use of remainder If a State uses less than 100 percent of the grant or allotment received under section 9905 or 9906 of this title to make grants under subsection (a), the State shall use the remainder of the grant or allotment under section 9905 or 9906 of this title (subject to paragraph (2)) for activities that may include—\"],\"scope_text\":\"If a State uses less than 100 percent of the grant or allotment received under section 9905 or 9906 of this title to make grants under subsection (a)\",\"section_id\":\"urn:rulespec:document-understanding:section:065d5bd1b1fd12e07012730aaa12714e330211d213042d09aad361bcfa67ebfa\",\"start\":26256,\"summary\":\"If a State uses less than 100 percent of the grant or allotment received under section 9905 or 9906 of this title to make grants under subsection (a), the State shall use the remainder of the grant or allotment under section 9905 or 9906 of this title (subject to paragraph (2)) for activities that may include: (A) providing training and technical assistance to those entities in need of such training and assistance; (B) coordinating State-operated programs and services, and at the option of the State, locally-operated programs and services, targeted to low-income children and families with services provided by eligible entities and other organizations funded under this chapter, including detailing appropriate employees of State or local agencies to entities funded under this chapter, to ensure increased access to services provided by such State or local agencies; (C) supporting statewide coordination and communication among eligible entities; (D) analyzing the distribution of funds made available under this chapter within the State to determine if such funds have been targeted to the areas of greatest need; (E) supporting asset-building programs for low-income individuals, such as programs supporting individual development accounts; (F) supporting innovative programs and activities conducted by community action agencies or other neighborhood-based organizations to eliminate poverty, promote self-sufficiency, and promote community revitalization; (G) supporting State charity tax credits as described in subsection (c); and (H) supporting other activities, consistent with the purposes of this chapter.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",
      "dcterms:references": [

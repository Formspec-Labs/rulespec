      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:570d857dd0a0dcb84f08db6744d48b5954c2ebed55338ab4ff4300f5060fdc85\",\"urn:rulespec:document-understanding:assertion:171e4c89805a5b2f58d020794a7a9ac9d81ac2be1501acce282ab34536e1d5ba\",\"urn:rulespec:document-understanding:assertion:b57488c69b443b47a3804b5e01e0b10dcf6a85788032d54fb4115d9f040700c0\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":34472,\"evidence\":[{\"end\":34124,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:34067:34124:sha256-2ba6dae58448fc2b7a6c690d6cd1f62c0bc5507ccfe43c9ee323e5a089316d9b\",\"quote\":\"(vi) Additional requirements for collection organizations\",\"start\":34067},{\"end\":34185,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:34125:34185:sha256-90e8c94d0e08f84b98c0a791bda03be51d2faab83bc1652963f0cd591786815d\",\"quote\":\"The requirements of this clause are met if the organization—\",\"start\":34125},{\"end\":34472,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:34187:34472:sha256-e5708d0e60b3e3a9734b3cd52093a06ed122320a17bd6c840e26cce206d17a9a\",\"quote\":\"(I) maintains separate accounting for revenues and expenses; and\\n\\n(II) makes available to the public information on the administrative and fundraising costs of the organization, and information as to the organizations receiving funds from the organization and the amount of such funds.\",\"start\":34187}],\"id\":\"urn:rulespec:document-understanding:revision:419096fc535b9892ae3eef57be8670929c819209aa737ea10c651895cc7ef2ec\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"statement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:b57488c69b443b47a3804b5e01e0b10dcf6a85788032d54fb4115d9f040700c0\",\"modality\":\"not_stated\",\"modality_quote\":\"\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:894aba767db02655eddc205fa670803afae5f195e44660248f5f25ed93f07e61\",\"origin\":\"aiSuggested\",\"quote\":\"(vi) Additional requirements for collection organizations The requirements of this clause are met if the organization—\\n\\n(I) maintains separate accounting for revenues and expenses; and\\n\\n(II) makes available to the public information on the administrative and fundraising costs of the organization, and information as to the organizations receiving funds from the organization and the amount of such funds.\",\"references\":[\"clause (vi)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:2a7ec46b979fb866b2aef69b85aee69cf0a075ba1b37dd55768d9a568af20887\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"urn:rulespec:document-understanding:section:065d5bd1b1fd12e07012730aaa12714e330211d213042d09aad361bcfa67ebfa\",\"start\":34067,\"summary\":\"The requirements of clause (vi) are met if the organization maintains separate accounting for revenues and expenses, and makes available to the public information on the administrative and fundraising costs of the organization, and information as to the organizations receiving funds from the organization and the amount of such funds.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

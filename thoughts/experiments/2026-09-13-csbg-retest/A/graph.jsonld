    {
      "@id": "urn:rulespec:document-understanding:assertion:57cfcc1f50e64b2a8cf93b3b8f2442b5f63482abf45bf95b93f250256fff7c27",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:4633c72b9949e6d6951371bc0574fba50f8ba6a46700aec92d15b8c8b10c59fa",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:1ddeb6b4f93733a4c226fb5c5105c6676871030f792da9f04d6343c46af5d65d",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:bd97b49244581fdf984b55839ee45b88d793ea81c9c08d4377f23a9c68d86f28",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"defined_terms\":[{\"id\":\"urn:rulespec:document-understanding:term:ca20ceed30ae0a0911767a093489f68e805d2d7d4521647642dbcb955f99464f\",\"label\":\"poverty program expense\",\"quote\":\"(II) Poverty program expense For purposes of subclause (I)—\\n\\n(aa) In general\\n\\nThe term “poverty program expense” means any expense in providing direct services referred to in clause (iii).\\n\\n\\n(bb) Exceptions\\n\\nSuch term shall not include any management or general expense, any expense for the purpose of influencing legislation (as defined in section 4911(d) of title 26), any expense for the purpose of fundraising, any expense for a legal service provided on behalf of any individual referred to in clause (iii), any expense for providing tuition assistance relating to compulsory school attendance, and any expense that consists of a payment to an affiliate of the organization.\",\"source_quotes\":[\"(II) Poverty program expense For purposes of subclause (I)—\",\"The term “poverty program expense” means any expense in providing direct services referred to in clause (iii).\",\"(bb) Exceptions\",\"Such term shall not include any management or general expense, any expense for the purpose of influencing legislation (as defined in section 4911(d) of title 26), any expense for the purpose of fundraising, any expense for a legal service provided on behalf of any individual referred to in clause (iii), any expense for providing tuition assistance relating to compulsory school attendance, and any expense that consists of a payment to an affiliate of the organization.\"]}],\"kind\":\"definition\",\"modality\":\"not_stated\",\"scope_text\":\"For purposes of subclause (I)\",\"summary\":\"For purposes of subclause (I), the term \\\"poverty program expense\\\" means any expense in providing direct services referred to in clause (iii), but shall not include any management or general expense, any expense for the purpose of influencing legislation (as defined in section 4911(d) of title 26), any expense for the purpose of fundraising, any expense for a legal service provided on behalf of any individual referred to in clause (iii), any expense for providing tuition assistance relating to compulsory school attendance, and any expense that consists of a payment to an affiliate of the organization.\"}",
        "@type": "xsd:string"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed",
      "rkaf:hasApplicability": "urn:rulespec:document-understanding:scope:94d678020ef834bf37bc777923b0d5c7c566b7bbebccc2a21cbf8a34079fab9e"
    },

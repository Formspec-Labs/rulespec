      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:dc23f15774a1f939871193d786f52866cc9cda7614ca93341642991a13c5cc8b\",\"urn:rulespec:document-understanding:assertion:522c277f8ee646f685601ec52f005404c0ef2c46c806c188e5d292dba2d9cbc5\",\"urn:rulespec:document-understanding:assertion:2b2fb872773a7daec99953de6f30560b53930a7d1d1b1cdc21e0e33ccb6b6b51\",\"urn:rulespec:document-understanding:assertion:ce144056847e3d6b3469ff9d4f8a4cf729deb1b7adb70670a239a03d8c2c728a\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":71229,\"evidence\":[{\"end\":71229,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:70569:71229:sha256-839e4147687db874cf158bdb26785077263ea2b10ebf9d4a38d9764d33527775\",\"quote\":\"Whenever a State violates the assurances contained in section 9908(b)(8) of this title and terminates or reduces the funding of an eligible entity prior to the completion of the State hearing described in that section and the Secretary’s review as required in subsection (b), the Secretary is authorized to provide financial assistance under this chapter to the eligible entity affected until the violation is corrected. In such a case, the grant or allotment for the State under section 9905 or 9906 of this title for the earliest appropriate fiscal year shall be reduced by an amount equal to the funds provided under this subsection to such eligible entity.\",\"start\":70569},{\"end\":71130,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:71125:71130:sha256-56ee5b508706bf2de91712d85d6d1e11ddbff01949142ed6e8c22e3b1bed1c71\",\"quote\":\"shall\",\"start\":71125},{\"end\":71229,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:70569:71229:sha256-839e4147687db874cf158bdb26785077263ea2b10ebf9d4a38d9764d33527775\",\"quote\":\"Whenever a State violates the assurances contained in section 9908(b)(8) of this title and terminates or reduces the funding of an eligible entity prior to the completion of the State hearing described in that section and the Secretary’s review as required in subsection (b), the Secretary is authorized to provide financial assistance under this chapter to the eligible entity affected until the violation is corrected. In such a case, the grant or allotment for the State under section 9905 or 9906 of this title for the earliest appropriate fiscal year shall be reduced by an amount equal to the funds provided under this subsection to such eligible entity.\",\"start\":70569}],\"id\":\"urn:rulespec:document-understanding:revision:3e3f14226350ef7dfb396c5a826bd8f4bdb55c01a3c6c8ccac4eccaf34d0fe0b\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:ce144056847e3d6b3469ff9d4f8a4cf729deb1b7adb70670a239a03d8c2c728a\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:409b4b604bc55f922cf16437ac8a7203573702dc88fee54db4ac71e8e5e72fea\",\"origin\":\"aiSuggested\",\"quote\":\"Whenever a State violates the assurances contained in section 9908(b)(8) of this title and terminates or reduces the funding of an eligible entity prior to the completion of the State hearing described in that section and the Secretary’s review as required in subsection (b), the Secretary is authorized to provide financial assistance under this chapter to the eligible entity affected until the violation is corrected. In such a case, the grant or allotment for the State under section 9905 or 9906 of this title for the earliest appropriate fiscal year shall be reduced by an amount equal to the funds provided under this subsection to such eligible entity.\",\"references\":[\"section 9905\",\"section 9906\",\"this subsection\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:e31c18dec91cda6c25afe43f942e09a471653c42b9b788a48c18f711c895c684\",\"scope_quotes\":[\"Whenever a State violates the assurances contained in section 9908(b)(8) of this title and terminates or reduces the funding of an eligible entity prior to the completion of the State hearing described in that section and the Secretary’s review as required in subsection (b), the Secretary is authorized to provide financial assistance under this chapter to the eligible entity affected until the violation is corrected. In such a case, the grant or allotment for the State under section 9905 or 9906 of this title for the earliest appropriate fiscal year shall be reduced by an amount equal to the funds provided under this subsection to such eligible entity.\"],\"scope_text\":\"In such a case\",\"section_id\":\"urn:rulespec:document-understanding:section:237b538fca368735fd9d07469584e65428d74fd94b694e39006074ead5c84559\",\"start\":70569,\"summary\":\"Whenever financial assistance is provided to an eligible entity under 42 U.S.C. 9915(c) following a State's violation of assurances under section 9908(b)(8) and termination or reduction of funding prior to the completion of the State hearing and the Secretary's review, the grant or allotment for the State under section 9905 or 9906 of title 42 for the earliest appropriate fiscal year shall be reduced by an amount equal to the funds provided under 42 U.S.C. 9915(c) to such eligible entity.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",
      "dcterms:references": [

      "rkaf:hasContentDigest": "sha256:209ff7a94c409eae11cca04c2922d12914305cec13731db9f5b200be7ed6a573",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"Secretary\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:293d5be88d2db5a15b4484abc5878af8a7c533a4e3c32ac4754015cf741add77\",\"urn:rulespec:document-understanding:assertion:a8d2ba387024dd3130c7dbe081b0a6433ffec37fded1f3a29fbaeec12f3da513\",\"urn:rulespec:document-understanding:assertion:c55b52e526d9c25137ec0588d1c262899696ae3f0bf0de23d35216fbfcede648\",\"urn:rulespec:document-understanding:assertion:4a992b3861938f18363d542e2da99bcece167610630b4c4b336ffba304e521f4\",\"urn:rulespec:document-understanding:assertion:6208994cfb716323318e070047f75bf22ec66e621357319c1de44150253e692f\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":114889,\"evidence\":[{\"end\":114486,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:114378:114486:sha256-f2c5a73488bd8e405c3c454579e5296cf821e70c18db797d61398c1bd5972f2c\",\"quote\":\"(4) No application may be approved for assistance under this section unless the Secretary is satisfied that—\",\"start\":114378},{\"end\":114889,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:114488:114889:sha256-4486151ef99cd715a533229f3dcdba29e492cb6157792924c77c5189d860cebb\",\"quote\":\"(A) the activities to be carried out under the application will be in addition to, and not in substitution for, activities previously carried on without Federal assistance; and\\n\\n(B) funds or other resources devoted to programs designed to meet the needs of the poor within the community, area, or State will not be diminished in order to provide the matching contributions required under this section.\",\"start\":114488},{\"end\":114467,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:114458:114467:sha256-1395996a1068d26dcb8486df1e1db89b97a66f2ecf98d655defe059fcec4bd97\",\"quote\":\"Secretary\",\"start\":114458},{\"end\":114412,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:114382:114412:sha256-cc1ca500fdd8ff5403aea7f6185423b92da045864de84b94bba0ca6e86df2798\",\"quote\":\"No application may be approved\",\"start\":114382}],\"id\":\"urn:rulespec:document-understanding:revision:cb1bde79598d2091fc1d793828c8661f6d57dc30390594d83b9b97e52aae35e2\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"prohibition\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:4a992b3861938f18363d542e2da99bcece167610630b4c4b336ffba304e521f4\",\"modality\":\"must_not\",\"modality_quote\":\"No application may be approved\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:a63be0d3370acb84cf75850746352e22b422ff1ac214bf9ce1860f4aaace9943\",\"origin\":\"aiSuggested\",\"quote\":\"(4) No application may be approved for assistance under this section unless the Secretary is satisfied that—\\n\\n(A) the activities to be carried out under the application will be in addition to, and not in substitution for, activities previously carried on without Federal assistance; and\\n\\n(B) funds or other resources devoted to programs designed to meet the needs of the poor within the community, area, or State will not be diminished in order to provide the matching contributions required under this section.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:6b9a40eec5a5c9c3f5a669b526d7a8ba5575bb7fab0c4b5334e351328f08bb11\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"urn:rulespec:document-understanding:section:5fba676d6775544d7cae048a3634eb9fe091aa0a96f2f732b41f08ff944d6890\",\"start\":114378,\"summary\":\"No application may be approved for assistance under section 9925 unless the Secretary is satisfied that: (A) the activities to be carried out under the application will be in addition to, and not in substitution for, activities previously carried on without Federal assistance; and (B) funds or other resources devoted to programs designed to meet the needs of the poor within the community, area, or State will not be diminished in order to provide the matching contributions required under this section.\",\"target_ids\":[],\"term_refs\":[\"urn:rulespec:document-understanding:term:c34823cba19ec45c3e7c0693ac9271e54d8940154d5fd8186d72962709e90ce2\"],\"typed_values\":[]}",

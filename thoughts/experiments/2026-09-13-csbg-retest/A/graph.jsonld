    {
      "@id": "urn:rulespec:document-understanding:term:6c942a864d133c150c6e5a0a0917192e8ec313034816c84c25762c653bb7ad0b",
      "@type": "rkaf:LocalConcept",
      "skos:prefLabel": {
        "en": "eligible entity"
      },
      "skos:definition": {
        "en": "As used in section 9925, the term “eligible entity” has the same meaning given such term by section 673(1) of the Community Services Block Grant Act (42 U.S.C. 9902(1)), except that such term includes an organization that serves migrant and seasonal farm workers and that receives a grant under the Community Services Block Grant Act (42 U.S.C. 9901 et seq.) in the fiscal year preceding the fiscal year for which such organization requests a grant under this section."
      },
      "skos:inScheme": "urn:rulespec:document-understanding:defined-term-scheme:26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023",

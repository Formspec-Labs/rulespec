    {
      "@id": "urn:rulespec:document-understanding:revision:eb7806a01ff2bffe600cd49ca61e3dddcb29e509cf3004eef9ba34af75939919",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:eb7806a01ff2bffe600cd49ca61e3dddcb29e509cf3004eef9ba34af75939919",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:dc33e8b3a19885a06bacbe3d5ab590866c8d57ea55b6dd0539e92407ef6e5d68",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:1899f2cad28d2956b4185a56e537b8a919e56773c9909b3d90e116a5eb830689\",\"urn:rulespec:document-understanding:assertion:3fd64a94a923a5d5e8d45e6a32b29c036bc0bb5aeade4c8ce0b4d9a944ba59e5\",\"urn:rulespec:document-understanding:assertion:86e96492fa9f4906c67f98b9ab9db6f9e4a121537976e839fbe2b624995b6f1c\",\"urn:rulespec:document-understanding:assertion:90464efe754fe5d6e7b3d9be24daeacf5138aabf940cecdd3211ed0ec06ca4b9\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":4256,\"evidence\":[{\"end\":2219,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:2186:2219:sha256-5a45b27d253b24474ba80e54cf27f862c1ba8eba5aa7c5025751f0b2f6334fcc\",\"quote\":\"The purposes of this chapter are—\",\"start\":2186},{\"end\":2805,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:2221:2805:sha256-eb418852e3677a0d98902c7e4141a0fc5695300b5b38d3545ce4767f3af99a16\",\"quote\":\"(1) to provide assistance to States and local communities, working through a network of community action agencies and other neighborhood-based organizations, for the reduction of poverty, the revitalization of low-income communities, and the empowerment of low-income families and individuals in rural and urban areas to become fully self-sufficient (particularly families who are attempting to transition off a State program carried out under part A of title IV of the Social Security Act (42 U.S.C. 601 et seq.)); and\\n\\n(2) to accomplish the goals described in paragraph (1) through—\",\"start\":2221},{\"end\":4009,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:2807:4009:sha256-9838e329389ba2c4d9a0150858fd0251acce28e55ffd919c3197b6f891ce90fd\",\"quote\":\"(A) the strengthening of community capabilities for planning and coordinating the use of a broad range of Federal, State, local, and other assistance (including private resources) related to the elimination of poverty, so that this assistance can be used in a manner responsive to local needs and conditions;\\n\\n(B) the organization of a range of services related to the needs of low-income families and individuals, so that these services may have a measurable and potentially major impact on the causes of poverty in the community and may help the families and individuals to achieve self-sufficiency;\\n\\n(C) the greater use of innovative and effective community-based approaches to attacking the causes and effects of poverty and of community breakdown;\\n\\n(D) the maximum participation of residents of the low-income communities and members of the groups served by programs assisted through the block grants made under this chapter to empower such residents and members to respond to the unique problems and needs within their communities; and\\n\\n(E) the broadening of the resource base of programs directed to the elimination of poverty so as to secure a more active role in the provision of services for—\",\"start\":2807},{\"end\":4256,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:4011:4256:sha256-f485a858b2d7fd3556734066ce1c4dbdcedffd46d4d6c8ec4fe5f3ccda427b78\",\"quote\":\"(i) private, religious, charitable, and neighborhood-based organizations; and\\n\\n(ii) individual citizens, and business, labor, and professional groups, who are able to influence the quantity and quality of opportunities and services for the poor.\",\"start\":4011}],\"id\":\"urn:rulespec:document-understanding:revision:eb7806a01ff2bffe600cd49ca61e3dddcb29e509cf3004eef9ba34af75939919\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"statement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:86e96492fa9f4906c67f98b9ab9db6f9e4a121537976e839fbe2b624995b6f1c\",\"modality\":\"not_stated\",\"modality_quote\":\"\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:0b53943b1e2ac27791894f2cbfbd28853640389dd5ea7c9fdc1a5f402f976782\",\"origin\":\"aiSuggested\",\"quote\":\"The purposes of this chapter are—\\n\\n(1) to provide assistance to States and local communities, working through a network of community action agencies and other neighborhood-based organizations, for the reduction of poverty, the revitalization of low-income communities, and the empowerment of low-income families and individuals in rural and urban areas to become fully self-sufficient (particularly families who are attempting to transition off a State program carried out under part A of title IV of the Social Security Act (42 U.S.C. 601 et seq.)); and\\n\\n(2) to accomplish the goals described in paragraph (1) through—\\n\\n(A) the strengthening of community capabilities for planning and coordinating the use of a broad range of Federal, State, local, and other assistance (including private resources) related to the elimination of poverty, so that this assistance can be used in a manner responsive to local needs and conditions;\\n\\n(B) the organization of a range of services related to the needs of low-income families and individuals, so that these services may have a measurable and potentially major impact on the causes of poverty in the community and may help the families and individuals to achieve self-sufficiency;\\n\\n(C) the greater use of innovative and effective community-based approaches to attacking the causes and effects of poverty and of community breakdown;\\n\\n(D) the maximum participation of residents of the low-income communities and members of the groups served by programs assisted through the block grants made under this chapter to empower such residents and members to respond to the unique problems and needs within their communities; and\\n\\n(E) the broadening of the resource base of programs directed to the elimination of poverty so as to secure a more active role in the provision of services for—\\n\\n(i) private, religious, charitable, and neighborhood-based organizations; and\\n\\n(ii) individual citizens, and business, labor, and professional groups, who are able to influence the quantity and quality of opportunities and services for the poor.\",\"references\":[\"42 U.S.C. 601 et seq.\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:f51916ecc93a086986d9d4fdbdd8f3ca77423e3d2ea587d9396f64d76bafa123\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"urn:rulespec:document-understanding:section:7323930aa170deb28e8e4c58b97489268b7a6a77f0c9e944a4a0c1a4cb2ef66d\",\"start\":2186,\"summary\":\"The purposes of chapter 106 are (1) to provide assistance to States and local communities, working through a network of community action agencies and other neighborhood-based organizations, for the reduction of poverty, the revitalization of low-income communities, and the empowerment of low-income families and individuals in rural and urban areas to become fully self-sufficient (particularly families attempting to transition off a State program carried out under part A of title IV of the Social Security Act); and (2) to accomplish those goals through strengthening community capabilities for planning and coordinating broad assistance responsive to local needs; organizing services related to low-income family and individual needs to have measurable and potentially major impact on causes of poverty and help achieve self-sufficiency; greater use of innovative and effective community-based approaches to attacking poverty and community breakdown causes and effects; maximum participation of residents of low-income communities and members of groups served by block grant assisted programs to empower them to respond to unique community problems and needs; and broadening the resource base to secure a more active role in service provision for private, religious, charitable, and neighborhood-based organizations as well as individual citizens, business, labor, and professional groups.\",\"target_ids\":[],\"term_refs\":[\"urn:rulespec:document-understanding:term:737b4a835a77703334e5da03eb8fc1a624a2cb0dd700298e37ccafb980c36609\"],\"typed_values\":[]}",
      "dcterms:references": [

    {
      "@id": "urn:rulespec:document-understanding:revision:621c99efc7ac76283245475359604fe2aded753126e867e6b9dc3e2385f175df",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:621c99efc7ac76283245475359604fe2aded753126e867e6b9dc3e2385f175df",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:6d4af9e0c98cb83dd86ad8d79e6995430a028dce62a1e2cdb43a5ddc2d6519ae",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"the State\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:075b3f947467f1991d98439e620c1eb278b64c2bcc23e0ef695851a849c233b2\",\"urn:rulespec:document-understanding:assertion:445e41fdbacf0b8f54d8f5eb82974367a5cd4fc710d6a8e9043ca460e6d5780a\",\"urn:rulespec:document-understanding:assertion:903f79ae0a932550ae7c291646a37552f7660b2597ee0e5965cce306a1c14029\",\"urn:rulespec:document-understanding:assertion:6ef3dbd8c41e89bd2db9298ba6a4cd372c895e335bba8c602378868c7afdf5c5\",\"urn:rulespec:document-understanding:assertion:80652cf175f00194f22b46009f3f7a2f8b9237c9b5ce1a693e130fbad0481656\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":70012,\"evidence\":[{\"end\":68283,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:68266:68283:sha256-fef9c1804c1c46956067d6581df93df72444872647b70b72bb3e6af066606522\",\"quote\":\"(a) Determination\",\"start\":68266},{\"end\":68665,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:68284:68665:sha256-2bd94d684e3542cfb70726d612ccd37955e615f0fc0c805729f83b029a200513\",\"quote\":\"If the State determines, on the basis of a final decision in a review pursuant to section 9914 of this title, that an eligible entity fails to comply with the terms of an agreement, or the State plan, to provide services under this chapter or to meet appropriate standards, goals, and other requirements established by the State (including performance objectives), the State shall—\",\"start\":68284},{\"end\":68779,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:68667:68779:sha256-cbdedc079c86a26642d45157f0061ec4b8d1bf21640333cff4d072d91f3656de\",\"quote\":\"(1) inform the entity of the deficiency to be corrected;\\n\\n(2) require the entity to correct the deficiency;\\n\\n(3)\",\"start\":68667},{\"end\":69171,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:68781:69171:sha256-0e9aed507a07211b31a8e4b612b52ec0c884d29c07b4e7913ce270ca0d354d89\",\"quote\":\"(A) offer training and technical assistance, if appropriate, to help correct the deficiency, and prepare and submit to the Secretary a report describing the training and technical assistance offered; or\\n\\n(B) if the State determines that such training and technical assistance are not appropriate, prepare and submit to the Secretary a report stating the reasons for the determination;\\n\\n\\n(4)\",\"start\":68781},{\"end\":70012,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:69173:70012:sha256-d0632b27e3280dcdb66043127aeda9fc19f276e1c860ce891db25a717f6ea3cc\",\"quote\":\"(A) at the discretion of the State (taking into account the seriousness of the deficiency and the time reasonably required to correct the deficiency), allow the entity to develop and implement, within 60 days after being informed of the deficiency, a quality improvement plan to correct such deficiency within a reasonable period of time, as determined by the State; and\\n\\n(B) not later than 30 days after receiving from an eligible entity a proposed quality improvement plan pursuant to subparagraph (A), either approve such proposed plan or specify the reasons why the proposed plan cannot be approved; and\\n\\n\\n(5) after providing adequate notice and an opportunity for a hearing, initiate proceedings to terminate the designation of or reduce the funding under this chapter of the eligible entity unless the entity corrects the deficiency.\",\"start\":69173},{\"end\":68664,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:68659:68664:sha256-56ee5b508706bf2de91712d85d6d1e11ddbff01949142ed6e8c22e3b1bed1c71\",\"quote\":\"shall\",\"start\":68659},{\"end\":68283,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:68266:68283:sha256-fef9c1804c1c46956067d6581df93df72444872647b70b72bb3e6af066606522\",\"quote\":\"(a) Determination\",\"start\":68266},{\"end\":68665,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:68284:68665:sha256-2bd94d684e3542cfb70726d612ccd37955e615f0fc0c805729f83b029a200513\",\"quote\":\"If the State determines, on the basis of a final decision in a review pursuant to section 9914 of this title, that an eligible entity fails to comply with the terms of an agreement, or the State plan, to provide services under this chapter or to meet appropriate standards, goals, and other requirements established by the State (including performance objectives), the State shall—\",\"start\":68284}],\"id\":\"urn:rulespec:document-understanding:revision:621c99efc7ac76283245475359604fe2aded753126e867e6b9dc3e2385f175df\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:80652cf175f00194f22b46009f3f7a2f8b9237c9b5ce1a693e130fbad0481656\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:32dd648d750c92628f4d10aa599e0d933aa23d67921217e9d654ba14c88b7a13\",\"origin\":\"aiSuggested\",\"quote\":\"(a) Determination If the State determines, on the basis of a final decision in a review pursuant to section 9914 of this title, that an eligible entity fails to comply with the terms of an agreement, or the State plan, to provide services under this chapter or to meet appropriate standards, goals, and other requirements established by the State (including performance objectives), the State shall—\\n\\n(1) inform the entity of the deficiency to be corrected;\\n\\n(2) require the entity to correct the deficiency;\\n\\n(3)\\n\\n(A) offer training and technical assistance, if appropriate, to help correct the deficiency, and prepare and submit to the Secretary a report describing the training and technical assistance offered; or\\n\\n(B) if the State determines that such training and technical assistance are not appropriate, prepare and submit to the Secretary a report stating the reasons for the determination;\\n\\n\\n(4)\\n\\n(A) at the discretion of the State (taking into account the seriousness of the deficiency and the time reasonably required to correct the deficiency), allow the entity to develop and implement, within 60 days after being informed of the deficiency, a quality improvement plan to correct such deficiency within a reasonable period of time, as determined by the State; and\\n\\n(B) not later than 30 days after receiving from an eligible entity a proposed quality improvement plan pursuant to subparagraph (A), either approve such proposed plan or specify the reasons why the proposed plan cannot be approved; and\\n\\n\\n(5) after providing adequate notice and an opportunity for a hearing, initiate proceedings to terminate the designation of or reduce the funding under this chapter of the eligible entity unless the entity corrects the deficiency.\",\"references\":[\"section 9914\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:779c6c34c323804dbce9a0279ddf467cc0b1bf22ef3b3830d87685eeb3a08d23\",\"scope_quotes\":[\"(a) Determination If the State determines, on the basis of a final decision in a review pursuant to section 9914 of this title, that an eligible entity fails to comply with the terms of an agreement, or the State plan, to provide services under this chapter or to meet appropriate standards, goals, and other requirements established by the State (including performance objectives), the State shall—\"],\"scope_text\":\"If the State determines, on the basis of a final decision in a review pursuant to section 9914 of this title, that an eligible entity fails to comply with the terms of an agreement, or the State plan, to provide services under this chapter or to meet appropriate standards, goals, and other requirements established by the State (including performance objectives)\",\"section_id\":\"urn:rulespec:document-understanding:section:237b538fca368735fd9d07469584e65428d74fd94b694e39006074ead5c84559\",\"start\":68266,\"summary\":\"If the State determines, on the basis of a final decision in a review pursuant to section 9914 of title 42, that an eligible entity fails to comply with the terms of an agreement, or the State plan, to provide services under chapter 106 of title 42 or to meet appropriate standards, goals, and other requirements established by the State (including performance objectives), the State shall: (1) inform the entity of the deficiency to be corrected; (2) require the entity to correct the deficiency; (3) offer training and technical assistance, if appropriate, to help correct the deficiency, and prepare and submit to the Secretary a report describing the training and technical assistance offered, or if the State determines that such training and technical assistance are not appropriate, prepare and submit to the Secretary a report stating the reasons for the determination; (4) at the discretion of the State (taking into account the seriousness of the deficiency and the time reasonably required to correct the deficiency), allow the entity to develop and implement, within 60 days after being informed of the deficiency, a quality improvement plan to correct such deficiency within a reasonable period of time, as determined by the State, and not later than 30 days after receiving from an eligible entity a proposed quality improvement plan pursuant to subparagraph (A), either approve such proposed plan or specify the reasons why the proposed plan cannot be approved; and (5) after providing adequate notice and an opportunity for a hearing, initiate proceedings to terminate the designation of or reduce the funding under chapter 106 of the eligible entity unless the entity corrects the deficiency.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

    {
      "@id": "urn:rulespec:document-understanding:revision:6f24d827f47323847df2f3173756b109f4c196d32d35f639c1b3c1f5aa1d7db1",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:6f24d827f47323847df2f3173756b109f4c196d32d35f639c1b3c1f5aa1d7db1",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:fcd46154e1652b4aa98fec3d52133dbac7dc6530d89698bd4efe555093e4afa4",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"Secretary\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:7b791adebafb623f6f05d64354fb6947826da10e84490bf9d59ae355bfb4b56f\",\"urn:rulespec:document-understanding:assertion:8958a2c766ff5092216528a112dcc0e50cd993cc7d20aee4544bb2795cf4e8cc\",\"urn:rulespec:document-understanding:assertion:84eb3fe7b411237ddb1b426b5e7b80a98d531a437bb9ece300caedebe33a5530\",\"urn:rulespec:document-understanding:assertion:d0aeae17afe3b0e01e211d5b3b29b668001b7a6154742363fe6bdd349203afaf\",\"urn:rulespec:document-understanding:assertion:388dc85b453213dc02ba899101f8d4efb19bf62dc6ed7a94b5a350352ea27b8b\",\"urn:rulespec:document-understanding:assertion:786f22ac84cd81cfc382d9b17787c7ecf9f41000df8770a91129fda46082eda9\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":113144,\"evidence\":[{\"end\":112427,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:111706:112427:sha256-faacd91b9e43b9b4bf2cfe238a1afcd06418b51a05c41d8467c42e6187cadd67\",\"quote\":\"(1) In order to stimulate the development of new approaches to provide for greater self-sufficiency of the poor, to test and evaluate such new approaches, to disseminate project results and evaluation findings so that such approaches can be replicated, and to strengthen the integration, coordination, and redirection of activities to promote maximum self-sufficiency among the poor, the Secretary may make grants from funds appropriated under subsection (e) to eligible entities for the development and implementation of new and innovative approaches to deal with particularly critical needs or problems of the poor which are common to a number of communities. Grants may be made only with respect to applications which—\",\"start\":111706},{\"end\":113144,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:112429:113144:sha256-b725608f49010a5eb25319d26ea55488767bea2dc5ad9ccf657bae834002618c\",\"quote\":\"(A) involve activities which can be incorporated into or be closely coordinated with eligible entities’ ongoing programs;\\n\\n(B) involve significant new combinations of resources or new and innovative approaches involving partnership agreements;\\n\\n(C) are structured in a way that will, within the limits of the type of assistance or activities contemplated, most fully and effectively promote the purposes of the Community Services Block Grant Act [42 U.S.C. 9901 et seq.]; and\\n\\n(D) contain an assurance that the applicant for such grants will obtain an independent, methodologically sound evaluation of the effectiveness of the activities carried out with such grant and will submit such evaluation to the Secretary.\",\"start\":112429}],\"id\":\"urn:rulespec:document-understanding:revision:6f24d827f47323847df2f3173756b109f4c196d32d35f639c1b3c1f5aa1d7db1\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"permission\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:d0aeae17afe3b0e01e211d5b3b29b668001b7a6154742363fe6bdd349203afaf\",\"modality\":\"may\",\"modality_quote\":\"may\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:f522d4e79fb8f7a3241f255de91a827e898e0b5e48051707e04a1475232edf80\",\"origin\":\"aiSuggested\",\"quote\":\"(1) In order to stimulate the development of new approaches to provide for greater self-sufficiency of the poor, to test and evaluate such new approaches, to disseminate project results and evaluation findings so that such approaches can be replicated, and to strengthen the integration, coordination, and redirection of activities to promote maximum self-sufficiency among the poor, the Secretary may make grants from funds appropriated under subsection (e) to eligible entities for the development and implementation of new and innovative approaches to deal with particularly critical needs or problems of the poor which are common to a number of communities. Grants may be made only with respect to applications which—\\n\\n(A) involve activities which can be incorporated into or be closely coordinated with eligible entities’ ongoing programs;\\n\\n(B) involve significant new combinations of resources or new and innovative approaches involving partnership agreements;\\n\\n(C) are structured in a way that will, within the limits of the type of assistance or activities contemplated, most fully and effectively promote the purposes of the Community Services Block Grant Act [42 U.S.C. 9901 et seq.]; and\\n\\n(D) contain an assurance that the applicant for such grants will obtain an independent, methodologically sound evaluation of the effectiveness of the activities carried out with such grant and will submit such evaluation to the Secretary.\",\"references\":[\"42 U.S.C. 9901 et seq.\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:95ca046e2744e2357d9fe313b2b48eab77e579635bb225bdc81c30950f2e5f2f\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"urn:rulespec:document-understanding:section:5fba676d6775544d7cae048a3634eb9fe091aa0a96f2f732b41f08ff944d6890\",\"start\":111706,\"summary\":\"The Secretary may make grants from funds appropriated under subsection (e) to eligible entities for the development and implementation of new and innovative approaches to deal with particularly critical needs or problems of the poor which are common to a number of communities, but grants may be made only with respect to applications that: (A) involve activities which can be incorporated into or be closely coordinated with eligible entities’ ongoing programs; (B) involve significant new combinations of resources or new and innovative approaches involving partnership agreements; (C) are structured in a way that will, within the limits of the type of assistance or activities contemplated, most fully and effectively promote the purposes of the Community Services Block Grant Act; and (D) contain an assurance that the applicant will obtain an independent, methodologically sound evaluation of the effectiveness of the activities carried out with such grant and submit it to the Secretary.\",\"target_ids\":[],\"term_refs\":[\"urn:rulespec:document-understanding:term:6c942a864d133c150c6e5a0a0917192e8ec313034816c84c25762c653bb7ad0b\",\"urn:rulespec:document-understanding:term:c34823cba19ec45c3e7c0693ac9271e54d8940154d5fd8186d72962709e90ce2\"],\"typed_values\":[]}",

      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:ecf665b30189bd23b49daff3d8b1ddaeb2d2642112e16f7b91e8b777f9ca1a04\",\"urn:rulespec:document-understanding:assertion:f9a744b28bc1924c8e2c4bd14867520d8673d154171ba95079fb027a45f04972\",\"urn:rulespec:document-understanding:assertion:f6df848341b5521653af84d9751bf605648eb98612bcf153900ad80e83b873de\",\"urn:rulespec:document-understanding:assertion:fdfd83bec06bc7f470f97ab8615f34db08b10205871f47876bf95b248a151f5f\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":47132,\"evidence\":[{\"end\":46508,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:46471:46508:sha256-d4f1bfddd0872a5183a6dbe2d364892802414a219f1484035e3935087ff59c1a\",\"quote\":\"(c) Funding termination or reductions\",\"start\":46471},{\"end\":46601,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:46509:46601:sha256-13a8d19add8f635f66ac3fe59c819acbf3bc3fbd052edca0c021af3b3e89cc78\",\"quote\":\"For purposes of making a determination in accordance with subsection (b)(8) with respect to—\",\"start\":46509},{\"end\":46654,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:46603:46654:sha256-c12577b5702dccfdc47e6d2666a875b63b5599537340d2278d0cff8a1cb2f846\",\"quote\":\"(1) a funding reduction, the term “cause” includes—\",\"start\":46603},{\"end\":46779,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:46656:46779:sha256-666f1bc31db8076ac930d96d12a392c08b0279bd05ce7c782415b07f67a4be46\",\"quote\":\"(A) a statewide redistribution of funds provided through a community services block grant under this chapter to respond to—\",\"start\":46656},{\"end\":47132,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:46781:47132:sha256-a52f057edcbb07289970ea0cbc630539dd7bc31163f59c5929e657fb95da65e1\",\"quote\":\"(i) the results of the most recently available census or other appropriate data;\\n\\n(ii) the designation of a new eligible entity; or\\n\\n(iii) severe economic dislocation; or\\n\\n\\n(B) the failure of an eligible entity to comply with the terms of an agreement or a State plan, or to meet a State requirement, as described in section 9915(a) of this title; and\",\"start\":46781},{\"end\":46508,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:46471:46508:sha256-d4f1bfddd0872a5183a6dbe2d364892802414a219f1484035e3935087ff59c1a\",\"quote\":\"(c) Funding termination or reductions\",\"start\":46471},{\"end\":46601,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:46509:46601:sha256-13a8d19add8f635f66ac3fe59c819acbf3bc3fbd052edca0c021af3b3e89cc78\",\"quote\":\"For purposes of making a determination in accordance with subsection (b)(8) with respect to—\",\"start\":46509},{\"end\":46654,\"field\":\"scope_text:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:46603:46654:sha256-c12577b5702dccfdc47e6d2666a875b63b5599537340d2278d0cff8a1cb2f846\",\"quote\":\"(1) a funding reduction, the term “cause” includes—\",\"start\":46603}],\"id\":\"urn:rulespec:document-understanding:revision:e0783f6f57e832a56db06fd18ee8591a2354c59d93221701ce1ef0baaf08cd24\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"definition\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:fdfd83bec06bc7f470f97ab8615f34db08b10205871f47876bf95b248a151f5f\",\"modality\":\"not_stated\",\"modality_quote\":\"\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:69d597dfec7b5536e903f60ade23c86ecd653f25096d336e9d355bec9e278251\",\"origin\":\"aiSuggested\",\"quote\":\"(c) Funding termination or reductions For purposes of making a determination in accordance with subsection (b)(8) with respect to—\\n\\n(1) a funding reduction, the term “cause” includes—\\n\\n(A) a statewide redistribution of funds provided through a community services block grant under this chapter to respond to—\\n\\n(i) the results of the most recently available census or other appropriate data;\\n\\n(ii) the designation of a new eligible entity; or\\n\\n(iii) severe economic dislocation; or\\n\\n\\n(B) the failure of an eligible entity to comply with the terms of an agreement or a State plan, or to meet a State requirement, as described in section 9915(a) of this title; and\",\"references\":[\"subsection (b)(8)\",\"section 9915(a)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:5cc8828a02782de3bd4c7a74ef50079b41e4808e3107e92dedc8b8547189f8b0\",\"scope_quotes\":[\"(c) Funding termination or reductions For purposes of making a determination in accordance with subsection (b)(8) with respect to—\",\"(1) a funding reduction, the term “cause” includes—\"],\"scope_text\":\"For purposes of making a determination in accordance with subsection (b)(8) with respect to a funding reduction\",\"section_id\":\"urn:rulespec:document-understanding:section:0b55006ce2c906add8328d3986f73bcd1ded9a87a908d01ae85b5595b9018d1b\",\"start\":46471,\"summary\":\"For purposes of making a determination in accordance with subsection (b)(8) with respect to a funding reduction, the term \\\"cause\\\" includes: (A) a statewide redistribution of funds provided through a community services block grant under this chapter to respond to (i) the results of the most recently available census or other appropriate data, (ii) the designation of a new eligible entity, or (iii) severe economic dislocation; or (B) the failure of an eligible entity to comply with the terms of an agreement or a State plan, or to meet a State requirement, as described in section 9915(a) of this title.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

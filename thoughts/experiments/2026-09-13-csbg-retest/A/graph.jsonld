      "rkaf:fragmentContentDigest": "sha256:857ef718394bbcbc477c416bdeb788f253e0645fe067a5d77b2fb85c20ab1160",
      "rkaf:selectorKind": [
        "oa:TextQuoteSelector",
        "oa:TextPositionSelector"
      ],
      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "(I) that has a constitutional requirement of tax uniformity; and\n\n(II) that, as of December 31, 1997, imposed a tax on personal income with—"
        },
        {
          "@type": "oa:TextPositionSelector",
          "oa:start": 34555,
          "oa:end": 34695,
          "rkaf:coordinateSystem": "rkaf:unicode-codepoint"

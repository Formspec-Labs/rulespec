      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:49cd66d8c27e0a9a7f4a41cebb04643576145ff1a7017885d460aed9b800ddaa\",\"urn:rulespec:document-understanding:assertion:569b81a5f770bfceca9b19c51b93da17891706bc641f29b656c76348d59a637a\",\"urn:rulespec:document-understanding:assertion:0ee641eff583a1775bc44ec6db41f0c690e9592c83e032d81726bd2a98b94efa\",\"urn:rulespec:document-understanding:assertion:7552b8a9a34c8f4954c8550d020948f674db5885eaa0e0ee2d295f20c2b1d245\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":110528,\"evidence\":[{\"end\":110528,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:110012:110528:sha256-a4567bf1a30dd78f87b8b6158b39216cd91743856669822726c97d4ac1ed9c2b\",\"quote\":\"Any reference in any provision of law to the poverty line set forth in section 624 or 625 of the Economic Opportunity Act of 1964 shall be construed to be a reference to the poverty line defined in section 9902 of this title. Except as otherwise provided, any reference in any provision of law to any community action agency designated under title II of the Economic Opportunity Act of 1964 shall be construed to be a reference to an entity eligible to receive funds under the community services block grant program.\",\"start\":110012},{\"end\":110528,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:110012:110528:sha256-a4567bf1a30dd78f87b8b6158b39216cd91743856669822726c97d4ac1ed9c2b\",\"quote\":\"Any reference in any provision of law to the poverty line set forth in section 624 or 625 of the Economic Opportunity Act of 1964 shall be construed to be a reference to the poverty line defined in section 9902 of this title. Except as otherwise provided, any reference in any provision of law to any community action agency designated under title II of the Economic Opportunity Act of 1964 shall be construed to be a reference to an entity eligible to receive funds under the community services block grant program.\",\"start\":110012}],\"id\":\"urn:rulespec:document-understanding:revision:8a851b2b86c15da67221f51c0151f8e8b8f9c6438ec427c61bc02ffbcb57767d\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:7552b8a9a34c8f4954c8550d020948f674db5885eaa0e0ee2d295f20c2b1d245\",\"modality\":\"must\",\"modality_quote\":\"shall be construed\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:f106356ccb13efb81fc5c0d068b7188825598dec6fc178d0e3c6ec317779262f\",\"origin\":\"aiSuggested\",\"quote\":\"Any reference in any provision of law to the poverty line set forth in section 624 or 625 of the Economic Opportunity Act of 1964 shall be construed to be a reference to the poverty line defined in section 9902 of this title. Except as otherwise provided, any reference in any provision of law to any community action agency designated under title II of the Economic Opportunity Act of 1964 shall be construed to be a reference to an entity eligible to receive funds under the community services block grant program.\",\"references\":[\"42 U.S.C. 9902\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:d0e9305bc40e870108351fdcdb2368c596de2e0905c365fd85e71a6ffa0f8f26\",\"scope_quotes\":[\"Any reference in any provision of law to the poverty line set forth in section 624 or 625 of the Economic Opportunity Act of 1964 shall be construed to be a reference to the poverty line defined in section 9902 of this title. Except as otherwise provided, any reference in any provision of law to any community action agency designated under title II of the Economic Opportunity Act of 1964 shall be construed to be a reference to an entity eligible to receive funds under the community services block grant program.\"],\"scope_text\":\"Any reference in any provision of law to the poverty line set forth in section 624 or 625 of the Economic Opportunity Act of 1964.\",\"section_id\":\"urn:rulespec:document-understanding:section:8a4e6d70ab56a073272f0b3d5540f6b1b55f6d1129769834787143ec0c1eecd9\",\"start\":110012,\"summary\":\"Any reference in any provision of law to the poverty line set forth in section 624 or 625 of the Economic Opportunity Act of 1964 must be construed to be a reference to the poverty line defined in section 9902 of title 42.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

    {
      "@id": "urn:rulespec:document-understanding:revision:2594b30fc34fa09ac0719ae423e0e33e08005d25d264827cd99702a7197c0032",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:2594b30fc34fa09ac0719ae423e0e33e08005d25d264827cd99702a7197c0032",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:b9a8419fc1ca2f8f09c1215f84b9af8e8c627f6144ac880f14ce3d3eae751e09",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"State\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:2aae5e313805189cb00b7a4d89897cea0625ad182e7895350651c16a80b68f95\",\"urn:rulespec:document-understanding:assertion:5bebacffab293da3403c377904fb8a4b314585109f4067aede9471ef20d03c69\",\"urn:rulespec:document-understanding:assertion:9a886fa782ee7306072acbd11778dfd1e3de1c003f7f69c97b90f42216bcc027\",\"urn:rulespec:document-understanding:assertion:a916a5b1953b9c5bdfd3c88dbb40bd684f14f87fd9743ef9d308eae19e4449de\",\"urn:rulespec:document-understanding:assertion:0a9430013bd98b240c8b24fcec8d39e567b5e580c3b3699344bcb1e1107980f5\",\"urn:rulespec:document-understanding:assertion:e013abfe8610633b8653195fb5bdca4f4ac6e691529afdad1f5ff3aa483f194e\",\"urn:rulespec:document-understanding:assertion:3595222ce8f1237fa63c92cc1d3e06a55a1711de568d89c0c2d937187e5c9b06\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":16172,\"evidence\":[{\"end\":16172,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:15218:16172:sha256-1603cf9f43b064a37fb684b67c0b13a2cd9a6ea24370dcbf44b41db1b03cbdd8\",\"quote\":\"The term “poverty line” means the official poverty line defined by the Office of Management and Budget based on the most recent data available from the Bureau of the Census. The Secretary shall revise annually (or at any shorter interval the Secretary determines to be feasible and desirable) the poverty line, which shall be used as a criterion of eligibility in the community services block grant program established under this chapter. The required revision shall be accomplished by multiplying the official poverty line by the percentage change in the Consumer Price Index for All Urban Consumers during the annual or other interval immediately preceding the time at which the revision is made. Whenever a State determines that it serves the objectives of the block grant program established under this chapter, the State may revise the poverty line to not to exceed 125 percent of the official poverty line otherwise applicable under this paragraph.\",\"start\":15218},{\"end\":16043,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:16034:16043:sha256-b25ac3a3200d1b12b577827b3daca4cc1dbfb9dc07d0af8b19b9d897125aa638\",\"quote\":\"the State\",\"start\":16034},{\"end\":16047,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:16044:16047:sha256-ee4d988c65de860fabbfbcd27f73d50bbebe3fba37fe419284f4811389c30bdc\",\"quote\":\"may\",\"start\":16044},{\"end\":16172,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:15218:16172:sha256-1603cf9f43b064a37fb684b67c0b13a2cd9a6ea24370dcbf44b41db1b03cbdd8\",\"quote\":\"The term “poverty line” means the official poverty line defined by the Office of Management and Budget based on the most recent data available from the Bureau of the Census. The Secretary shall revise annually (or at any shorter interval the Secretary determines to be feasible and desirable) the poverty line, which shall be used as a criterion of eligibility in the community services block grant program established under this chapter. The required revision shall be accomplished by multiplying the official poverty line by the percentage change in the Consumer Price Index for All Urban Consumers during the annual or other interval immediately preceding the time at which the revision is made. Whenever a State determines that it serves the objectives of the block grant program established under this chapter, the State may revise the poverty line to not to exceed 125 percent of the official poverty line otherwise applicable under this paragraph.\",\"start\":15218}],\"id\":\"urn:rulespec:document-understanding:revision:2594b30fc34fa09ac0719ae423e0e33e08005d25d264827cd99702a7197c0032\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"permission\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:0a9430013bd98b240c8b24fcec8d39e567b5e580c3b3699344bcb1e1107980f5\",\"modality\":\"may\",\"modality_quote\":\"may\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:3d7339b85e564863696c5298f37659ba8cc4e5863c2f399f33133dfd958d17df\",\"origin\":\"aiSuggested\",\"quote\":\"The term “poverty line” means the official poverty line defined by the Office of Management and Budget based on the most recent data available from the Bureau of the Census. The Secretary shall revise annually (or at any shorter interval the Secretary determines to be feasible and desirable) the poverty line, which shall be used as a criterion of eligibility in the community services block grant program established under this chapter. The required revision shall be accomplished by multiplying the official poverty line by the percentage change in the Consumer Price Index for All Urban Consumers during the annual or other interval immediately preceding the time at which the revision is made. Whenever a State determines that it serves the objectives of the block grant program established under this chapter, the State may revise the poverty line to not to exceed 125 percent of the official poverty line otherwise applicable under this paragraph.\",\"references\":[\"paragraph (2)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:c87eebb4ac301212abfba2acd6636e17a0b2777bef0e4c2dcae226f7e8f40725\",\"scope_quotes\":[\"The term “poverty line” means the official poverty line defined by the Office of Management and Budget based on the most recent data available from the Bureau of the Census. The Secretary shall revise annually (or at any shorter interval the Secretary determines to be feasible and desirable) the poverty line, which shall be used as a criterion of eligibility in the community services block grant program established under this chapter. The required revision shall be accomplished by multiplying the official poverty line by the percentage change in the Consumer Price Index for All Urban Consumers during the annual or other interval immediately preceding the time at which the revision is made. Whenever a State determines that it serves the objectives of the block grant program established under this chapter, the State may revise the poverty line to not to exceed 125 percent of the official poverty line otherwise applicable under this paragraph.\"],\"scope_text\":\"Whenever a State determines that it serves the objectives of the block grant program established under this chapter\",\"section_id\":\"urn:rulespec:document-understanding:section:9a5224c808327e88c75f83b7cee8be31a7428e0086505e2dd784698ca11dd1d8\",\"start\":15218,\"summary\":\"Whenever a State determines that it serves the objectives of the block grant program established under chapter 106, the State may revise the poverty line to not to exceed 125 percent of the official poverty line otherwise applicable under paragraph (2) of section 9902.\",\"target_ids\":[],\"term_refs\":[\"urn:rulespec:document-understanding:term:dda2226824755c110df3f6adf59bbb00aed25bc533cb17846b3e5677efa37bb1\",\"urn:rulespec:document-understanding:term:737b4a835a77703334e5da03eb8fc1a624a2cb0dd700298e37ccafb980c36609\"],\"typed_values\":[]}",

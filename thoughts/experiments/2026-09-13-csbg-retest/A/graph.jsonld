      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:740babc5fa6355144f9ed81da4afcc2b4590947c7570a603a379b01b3cf4ebad\",\"urn:rulespec:document-understanding:assertion:09e6ea5ce75727a7d5b0a2dc7017908564cc4011cc1f948a97c44ea1146cb82d\",\"urn:rulespec:document-understanding:assertion:4ebd072e7f44a0df59fd677b2cefabbe5bbd9d476dcb036d9c705d022250f4ea\",\"urn:rulespec:document-understanding:assertion:57cfcc1f50e64b2a8cf93b3b8f2442b5f63482abf45bf95b93f250256fff7c27\",\"urn:rulespec:document-understanding:assertion:a2cd48ddd9217e8309a70bd0665bdc3133b85909234c255999a814ac83375286\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[{\"aliases\":[],\"id\":\"urn:rulespec:document-understanding:term:ca20ceed30ae0a0911767a093489f68e805d2d7d4521647642dbcb955f99464f\",\"label\":\"poverty program expense\",\"quote\":\"(II) Poverty program expense For purposes of subclause (I)—\\n\\n(aa) In general\\n\\nThe term “poverty program expense” means any expense in providing direct services referred to in clause (iii).\\n\\n\\n(bb) Exceptions\\n\\nSuch term shall not include any management or general expense, any expense for the purpose of influencing legislation (as defined in section 4911(d) of title 26), any expense for the purpose of fundraising, any expense for a legal service provided on behalf of any individual referred to in clause (iii), any expense for providing tuition assistance relating to compulsory school attendance, and any expense that consists of a payment to an affiliate of the organization.\",\"source_quotes\":[\"(II) Poverty program expense For purposes of subclause (I)—\",\"The term “poverty program expense” means any expense in providing direct services referred to in clause (iii).\",\"(bb) Exceptions\",\"Such term shall not include any management or general expense, any expense for the purpose of influencing legislation (as defined in section 4911(d) of title 26), any expense for the purpose of fundraising, any expense for a legal service provided on behalf of any individual referred to in clause (iii), any expense for providing tuition assistance relating to compulsory school attendance, and any expense that consists of a payment to an affiliate of the organization.\"]}],\"effective_periods\":[],\"end\":33450,\"evidence\":[{\"end\":32799,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:32771:32799:sha256-a12843c74be3bdfbec9a8a0a356f86ac8a043c70b3da58d357d126574fabe796\",\"quote\":\"(II) Poverty program expense\",\"start\":32771},{\"end\":32830,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:32800:32830:sha256-40a6f5ef4c9fe7728967e6e2d190c41851b86b8c43bb7ad7ee656d2a33ae4312\",\"quote\":\"For purposes of subclause (I)—\",\"start\":32800},{\"end\":32847,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:32832:32847:sha256-5cdfcdce35de531f0c5cd2e91c498bb65cb44acc2b3a96588379ab2c2419d7e1\",\"quote\":\"(aa) In general\",\"start\":32832},{\"end\":32977,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:32849:32977:sha256-aebd309f020b864420416ef062ea25a0d88becadd4790985237d9600186dac91\",\"quote\":\"The term “poverty program expense” means any expense in providing direct services referred to in clause (iii).\\n\\n\\n(bb) Exceptions\",\"start\":32849},{\"end\":33450,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:32979:33450:sha256-0b22097c8c83a4795d618590cf7632be0a7d7e0758592a9f65f21a04015f0327\",\"quote\":\"Such term shall not include any management or general expense, any expense for the purpose of influencing legislation (as defined in section 4911(d) of title 26), any expense for the purpose of fundraising, any expense for a legal service provided on behalf of any individual referred to in clause (iii), any expense for providing tuition assistance relating to compulsory school attendance, and any expense that consists of a payment to an affiliate of the organization.\",\"start\":32979},{\"end\":32799,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:32771:32799:sha256-a12843c74be3bdfbec9a8a0a356f86ac8a043c70b3da58d357d126574fabe796\",\"quote\":\"(II) Poverty program expense\",\"start\":32771},{\"end\":32830,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:32800:32830:sha256-40a6f5ef4c9fe7728967e6e2d190c41851b86b8c43bb7ad7ee656d2a33ae4312\",\"quote\":\"For purposes of subclause (I)—\",\"start\":32800},{\"end\":32799,\"field\":\"defined_terms:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:32771:32799:sha256-a12843c74be3bdfbec9a8a0a356f86ac8a043c70b3da58d357d126574fabe796\",\"quote\":\"(II) Poverty program expense\",\"start\":32771},{\"end\":32830,\"field\":\"defined_terms:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:32800:32830:sha256-40a6f5ef4c9fe7728967e6e2d190c41851b86b8c43bb7ad7ee656d2a33ae4312\",\"quote\":\"For purposes of subclause (I)—\",\"start\":32800},{\"end\":32847,\"field\":\"defined_terms:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:32832:32847:sha256-5cdfcdce35de531f0c5cd2e91c498bb65cb44acc2b3a96588379ab2c2419d7e1\",\"quote\":\"(aa) In general\",\"start\":32832},{\"end\":32977,\"field\":\"defined_terms:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:32849:32977:sha256-aebd309f020b864420416ef062ea25a0d88becadd4790985237d9600186dac91\",\"quote\":\"The term “poverty program expense” means any expense in providing direct services referred to in clause (iii).\\n\\n\\n(bb) Exceptions\",\"start\":32849},{\"end\":33450,\"field\":\"defined_terms:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:32979:33450:sha256-0b22097c8c83a4795d618590cf7632be0a7d7e0758592a9f65f21a04015f0327\",\"quote\":\"Such term shall not include any management or general expense, any expense for the purpose of influencing legislation (as defined in section 4911(d) of title 26), any expense for the purpose of fundraising, any expense for a legal service provided on behalf of any individual referred to in clause (iii), any expense for providing tuition assistance relating to compulsory school attendance, and any expense that consists of a payment to an affiliate of the organization.\",\"start\":32979},{\"end\":32799,\"field\":\"defined_terms:0:source:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:32771:32799:sha256-a12843c74be3bdfbec9a8a0a356f86ac8a043c70b3da58d357d126574fabe796\",\"quote\":\"(II) Poverty program expense\",\"start\":32771},{\"end\":32830,\"field\":\"defined_terms:0:source:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:32800:32830:sha256-40a6f5ef4c9fe7728967e6e2d190c41851b86b8c43bb7ad7ee656d2a33ae4312\",\"quote\":\"For purposes of subclause (I)—\",\"start\":32800},{\"end\":32959,\"field\":\"defined_terms:0:source:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:32849:32959:sha256-58de0b9d6af24afe09b496b5c6532d0c26a0f4653b07043d1b9cf0f6ad5f812b\",\"quote\":\"The term “poverty program expense” means any expense in providing direct services referred to in clause (iii).\",\"start\":32849},{\"end\":32977,\"field\":\"defined_terms:0:source:2\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:32962:32977:sha256-b47bde36af10674e639976fb7b67f61140fd73520509763f1f6a32929e5b70fa\",\"quote\":\"(bb) Exceptions\",\"start\":32962},{\"end\":33450,\"field\":\"defined_terms:0:source:3\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:32979:33450:sha256-0b22097c8c83a4795d618590cf7632be0a7d7e0758592a9f65f21a04015f0327\",\"quote\":\"Such term shall not include any management or general expense, any expense for the purpose of influencing legislation (as defined in section 4911(d) of title 26), any expense for the purpose of fundraising, any expense for a legal service provided on behalf of any individual referred to in clause (iii), any expense for providing tuition assistance relating to compulsory school attendance, and any expense that consists of a payment to an affiliate of the organization.\",\"start\":32979}],\"id\":\"urn:rulespec:document-understanding:revision:284c6165405bf2f813e8d5b0e9695902f41ef688bb7fb154516b464f36d13cbf\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"definition\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:57cfcc1f50e64b2a8cf93b3b8f2442b5f63482abf45bf95b93f250256fff7c27\",\"modality\":\"not_stated\",\"modality_quote\":\"\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:4fa878ab7985bca0b594e2f80b6b1a7829fd859723fddba7fa896b1a32525680\",\"origin\":\"aiSuggested\",\"quote\":\"(II) Poverty program expense For purposes of subclause (I)—\\n\\n(aa) In general\\n\\nThe term “poverty program expense” means any expense in providing direct services referred to in clause (iii).\\n\\n\\n(bb) Exceptions\\n\\nSuch term shall not include any management or general expense, any expense for the purpose of influencing legislation (as defined in section 4911(d) of title 26), any expense for the purpose of fundraising, any expense for a legal service provided on behalf of any individual referred to in clause (iii), any expense for providing tuition assistance relating to compulsory school attendance, and any expense that consists of a payment to an affiliate of the organization.\",\"references\":[\"subclause (I)\",\"clause (iii)\",\"section 4911(d) of title 26\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:bd97b49244581fdf984b55839ee45b88d793ea81c9c08d4377f23a9c68d86f28\",\"scope_quotes\":[\"(II) Poverty program expense For purposes of subclause (I)—\"],\"scope_text\":\"For purposes of subclause (I)\",\"section_id\":\"urn:rulespec:document-understanding:section:065d5bd1b1fd12e07012730aaa12714e330211d213042d09aad361bcfa67ebfa\",\"start\":32771,\"summary\":\"For purposes of subclause (I), the term \\\"poverty program expense\\\" means any expense in providing direct services referred to in clause (iii), but shall not include any management or general expense, any expense for the purpose of influencing legislation (as defined in section 4911(d) of title 26), any expense for the purpose of fundraising, any expense for a legal service provided on behalf of any individual referred to in clause (iii), any expense for providing tuition assistance relating to compulsory school attendance, and any expense that consists of a payment to an affiliate of the organization.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "The Secretary may, through grants to public and private, nonprofit agencies, provide for community-based, local, statewide, and national programs—"
        },
        {
          "@type": "oa:TextPositionSelector",
          "oa:start": 98582,
          "oa:end": 98728,
          "rkaf:coordinateSystem": "rkaf:unicode-codepoint"

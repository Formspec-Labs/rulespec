    {
      "@id": "urn:rulespec:document-understanding:revision:66896a4d6b445741409f00f342a00e31955df3b1f3aafb65ad58a89881794297",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:66896a4d6b445741409f00f342a00e31955df3b1f3aafb65ad58a89881794297",

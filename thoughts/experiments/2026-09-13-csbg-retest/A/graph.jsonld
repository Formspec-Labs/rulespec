      "dcterms:description": "{\"action\":\"\",\"actor\":\"The Secretary\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:3b4b64250a9233c8eb073dbe9ee15ea806eacf437fa89024d1d3cc5ec1bd3d94\",\"urn:rulespec:document-understanding:assertion:27e8fbae56d47fef104115038ae8b83bdc9ef80f7dab1989d606b6ebcb866de2\",\"urn:rulespec:document-understanding:assertion:323d87a92b927c1629b16f398cae6a3a9a996bab045421c2bf01068eaae1c0fc\",\"urn:rulespec:document-understanding:assertion:7806834b0d805b5ed9a22f5c57933ebfb3c8e4f0be78fa90e7285c16db6a7d1f\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":67833,\"evidence\":[{\"end\":67833,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:66787:67833:sha256-6029fefdb7fae5c5b046e858a6ecbf3e689c9da8af5615d345e4ffce339968de\",\"quote\":\"The Secretary shall conduct in several States in each fiscal year evaluations (including investigations) of the use of funds received by the States under this chapter in order to evaluate compliance with the provisions of this chapter, and especially with respect to compliance with section 9908(b) of this title. The Secretary shall submit, to each State evaluated, a report containing the results of such evaluations, and recommendations of improvements designed to enhance the benefit and impact of the activities carried out with such funds for people in need. On receiving the report, the State shall submit to the Secretary a plan of action in response to the recommendations contained in the report. The results of the evaluations shall be submitted annually to the Chairperson of the Committee on Education and the Workforce of the House of Representatives and the Chairperson of the Committee on Labor and Human Resources of the Senate as part of the report submitted by the Secretary in accordance with section 9917(b)(2) of this title.\",\"start\":66787}],\"id\":\"urn:rulespec:document-understanding:revision:dbb90f486f304be534fb35cbc71eeac8a0af88c751fd374c4004c297fa510583\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:7806834b0d805b5ed9a22f5c57933ebfb3c8e4f0be78fa90e7285c16db6a7d1f\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:375a05e63ae4d88977acbc4e03509b58d8f0cd4ba06e3a244c0f909556aeb68e\",\"origin\":\"aiSuggested\",\"quote\":\"The Secretary shall conduct in several States in each fiscal year evaluations (including investigations) of the use of funds received by the States under this chapter in order to evaluate compliance with the provisions of this chapter, and especially with respect to compliance with section 9908(b) of this title. The Secretary shall submit, to each State evaluated, a report containing the results of such evaluations, and recommendations of improvements designed to enhance the benefit and impact of the activities carried out with such funds for people in need. On receiving the report, the State shall submit to the Secretary a plan of action in response to the recommendations contained in the report. The results of the evaluations shall be submitted annually to the Chairperson of the Committee on Education and the Workforce of the House of Representatives and the Chairperson of the Committee on Labor and Human Resources of the Senate as part of the report submitted by the Secretary in accordance with section 9917(b)(2) of this title.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:c5259bd38421a4a69ea66a4d1c62c147ed808ffbe1d5bb55e18724e838dcc9f9\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"urn:rulespec:document-understanding:section:c0349af1123d989776fe253553df69642696cd32996dd791c280bdbf3d513641\",\"start\":66787,\"summary\":\"The Secretary shall submit, to each State evaluated, a report containing the results of such evaluations, and recommendations of improvements designed to enhance the benefit and impact of the activities carried out with such funds for people in need.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

      "rkaf:assertsValue": {
        "@value": "{\"kind\":\"definition\",\"modality\":\"not_stated\",\"scope_text\":\"For purposes of making a determination in accordance with subsection (b)(8) with respect to a funding reduction\",\"summary\":\"For purposes of making a determination in accordance with subsection (b)(8) with respect to a funding reduction, the term \\\"cause\\\" includes: (A) a statewide redistribution of funds provided through a community services block grant under this chapter to respond to (i) the results of the most recently available census or other appropriate data, (ii) the designation of a new eligible entity, or (iii) severe economic dislocation; or (B) the failure of an eligible entity to comply with the terms of an agreement or a State plan, or to meet a State requirement, as described in section 9915(a) of this title.\"}",
        "@type": "xsd:string"
      },

      "@id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:37820:37850:sha256-e4eb5b6a8a7b9dd983a231deb98e7f6f65d6bc1675e6e9cecd8040a5250bb93d",

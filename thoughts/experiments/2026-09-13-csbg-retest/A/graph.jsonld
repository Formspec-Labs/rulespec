      "dcterms:description": "{\"action\":\"\",\"actor\":\"The Secretary\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:a1075b66a7e181ad0b58b984ce3971d45ded741d444028a449a8400b27f33eec\",\"urn:rulespec:document-understanding:assertion:b5e2f4b231469910c1a8c2678f7ab3bcc4f2d9a683f00e05766d2d8fec9a9d05\",\"urn:rulespec:document-understanding:assertion:fcaf32d035ebcd3c7e19ad89711b9480cfab2fc3a15049c1286884c3b2be3861\",\"urn:rulespec:document-understanding:assertion:412becfe14b0b905f55b864e742213a46a7084b4bf7045f79bbb9e5d37c1e2f4\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":63858,\"evidence\":[{\"end\":63382,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:63368:63382:sha256-cf4ae417d8281c48072a48750d2a58c3678e30cc403d581be91a252e93ff2139\",\"quote\":\"(1) In general\",\"start\":63368},{\"end\":63460,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:63383:63460:sha256-a2e0347b31208ed1c88427b0282edd40d5e997b7f05e15af46f4b28f400b2934\",\"quote\":\"The Secretary shall use amounts reserved in section 9903(b)(2) of this title—\",\"start\":63383},{\"end\":63858,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:63462:63858:sha256-d719cd2848159497c8878dacd23d84ba43ed7377f22df43ce823fc1e9538b058\",\"quote\":\"(A) for training, technical assistance, planning, evaluation, and performance measurement, to assist States in carrying out corrective action activities and monitoring (to correct programmatic deficiencies of eligible entities), and for reporting and data collection activities, related to programs carried out under this chapter; and\\n\\n(B) to distribute amounts in accordance with subsection (c).\",\"start\":63462},{\"end\":63396,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:63383:63396:sha256-d6dd2bb6d3c44b4545cc3f97cb6f8a38842ecd30d2c58ec3e1c53a8c1a0ac77c\",\"quote\":\"The Secretary\",\"start\":63383},{\"end\":63402,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:63397:63402:sha256-56ee5b508706bf2de91712d85d6d1e11ddbff01949142ed6e8c22e3b1bed1c71\",\"quote\":\"shall\",\"start\":63397}],\"id\":\"urn:rulespec:document-understanding:revision:80477b2b01f483606efab8baab77d4bb428e490a3118634e2ed54d7fe61eeec8\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:412becfe14b0b905f55b864e742213a46a7084b4bf7045f79bbb9e5d37c1e2f4\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:61fca68551aeef9dbc3fc82597bca84854b31b7ec1c2e83840bd95d1158a41aa\",\"origin\":\"aiSuggested\",\"quote\":\"(1) In general The Secretary shall use amounts reserved in section 9903(b)(2) of this title—\\n\\n(A) for training, technical assistance, planning, evaluation, and performance measurement, to assist States in carrying out corrective action activities and monitoring (to correct programmatic deficiencies of eligible entities), and for reporting and data collection activities, related to programs carried out under this chapter; and\\n\\n(B) to distribute amounts in accordance with subsection (c).\",\"references\":[\"section 9903(b)(2)\",\"subsection (c)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:fed864bec36e154296a1e6aa2a293c568b14380920676d6890cd84ca1e1a248e\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"urn:rulespec:document-understanding:section:14940ce669f832206b65cbb2eca659f59bd1cde99a702e87cfeffc3340239793\",\"start\":63368,\"summary\":\"The Secretary shall use amounts reserved in section 9903(b)(2) of title 42: (A) for training, technical assistance, planning, evaluation, and performance measurement, to assist States in carrying out corrective action activities and monitoring (to correct programmatic deficiencies of eligible entities), and for reporting and data collection activities, related to programs carried out under chapter 106; and (B) to distribute amounts in accordance with 42 U.S.C. 9913(c).\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "The term “poverty program expense” means any expense in providing direct services referred to in clause (iii).\n\n\n(bb) Exceptions"
        },
        {
          "@type": "oa:TextPositionSelector",
          "oa:start": 32849,
          "oa:end": 32977,
          "rkaf:coordinateSystem": "rkaf:unicode-codepoint"

      "dcterms:description": "{\"action\":\"\",\"actor\":\"Secretary\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:53334f32dd0b712d817a90ea7211c1c2a96ba2192e68bbd9db3833934fe1ba65\",\"urn:rulespec:document-understanding:assertion:b7102321afecff8417132f46437d049582a2ecf34627e0a04aeecd254c228467\",\"urn:rulespec:document-understanding:assertion:8846d28d68a0c2bb606e57f768f442f547275f21441f94e67b930777ec7e7e6a\",\"urn:rulespec:document-understanding:assertion:caa416b700d0586261b649ed244b392dfbf8f013c2bf8fe805daeda4356451b0\",\"urn:rulespec:document-understanding:assertion:5835f10b31ec6c5d740b7eb0cb23ae654cb1fe4c8acd53b898b5f23c8a744853\",\"urn:rulespec:document-understanding:assertion:f3fb6b611bea9bf05021c69d23fc33f9adb6b51861c6cb267aae20cdc6ff32a2\",\"urn:rulespec:document-understanding:assertion:d3a13d9b14b91c65c65f3bbec5925746c47263674edc4ae5c1f532f47e66bb12\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":117265,\"evidence\":[{\"end\":116725,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:116697:116725:sha256-80a8fb5659815f568dbdadabe2f910a3e098536d26d59a65ad07c0073664b0ea\",\"quote\":\"(d) Dissemination of results\",\"start\":116697},{\"end\":117265,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:116727:117265:sha256-0a3ab17af9d270604f78e7351d8e0dd59922957cd740a6a7205e7341f7c20dea\",\"quote\":\"As soon as practicable, but not later than 180 days after the end of the fiscal year in which a recipient of a grant under this section completes the expenditure of such grant, the Secretary shall prepare and make available to each State and each eligible entity a description of the program carried out with such grant, any relevant information developed and results achieved, and a summary of the evaluation of such program received under subsection (a)(1)(D) so as to provide a model of innovative programs for other eligible entities.\",\"start\":116727},{\"end\":116917,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:116908:116917:sha256-1395996a1068d26dcb8486df1e1db89b97a66f2ecf98d655defe059fcec4bd97\",\"quote\":\"Secretary\",\"start\":116908},{\"end\":116923,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:116918:116923:sha256-56ee5b508706bf2de91712d85d6d1e11ddbff01949142ed6e8c22e3b1bed1c71\",\"quote\":\"shall\",\"start\":116918},{\"end\":117265,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:116727:117265:sha256-0a3ab17af9d270604f78e7351d8e0dd59922957cd740a6a7205e7341f7c20dea\",\"quote\":\"As soon as practicable, but not later than 180 days after the end of the fiscal year in which a recipient of a grant under this section completes the expenditure of such grant, the Secretary shall prepare and make available to each State and each eligible entity a description of the program carried out with such grant, any relevant information developed and results achieved, and a summary of the evaluation of such program received under subsection (a)(1)(D) so as to provide a model of innovative programs for other eligible entities.\",\"start\":116727}],\"id\":\"urn:rulespec:document-understanding:revision:eb7fa71a5bb2d9297cde7fc8a7341de0aa8230b73f9be301552129a21ab05e92\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:5835f10b31ec6c5d740b7eb0cb23ae654cb1fe4c8acd53b898b5f23c8a744853\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:3121e80f96f01042d4e53eb54dabe8e1cfeecd72da566d7b31656b3b2e7d9c65\",\"origin\":\"aiSuggested\",\"quote\":\"(d) Dissemination of results\\n\\nAs soon as practicable, but not later than 180 days after the end of the fiscal year in which a recipient of a grant under this section completes the expenditure of such grant, the Secretary shall prepare and make available to each State and each eligible entity a description of the program carried out with such grant, any relevant information developed and results achieved, and a summary of the evaluation of such program received under subsection (a)(1)(D) so as to provide a model of innovative programs for other eligible entities.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:b6d2b15b584a3df90cbd1e642daa70f65f1fda71b36ba9db31d239053368ae26\",\"scope_quotes\":[\"As soon as practicable, but not later than 180 days after the end of the fiscal year in which a recipient of a grant under this section completes the expenditure of such grant, the Secretary shall prepare and make available to each State and each eligible entity a description of the program carried out with such grant, any relevant information developed and results achieved, and a summary of the evaluation of such program received under subsection (a)(1)(D) so as to provide a model of innovative programs for other eligible entities.\"],\"scope_text\":\"Not later than 180 days after the end of the fiscal year in which a grant recipient completes expenditure of the grant.\",\"section_id\":\"urn:rulespec:document-understanding:section:5fba676d6775544d7cae048a3634eb9fe091aa0a96f2f732b41f08ff944d6890\",\"start\":116697,\"summary\":\"As soon as practicable, but not later than 180 days after the end of the fiscal year in which a recipient of a grant under section 9925 completes the expenditure of such grant, the Secretary must prepare and make available to each State and each eligible entity a description of the program carried out with such grant, any relevant information developed and results achieved, and a summary of the evaluation of such program received under subsection (a)(1)(D) so as to provide a model of innovative programs for other eligible entities.\",\"target_ids\":[],\"term_refs\":[\"urn:rulespec:document-understanding:term:6c942a864d133c150c6e5a0a0917192e8ec313034816c84c25762c653bb7ad0b\",\"urn:rulespec:document-understanding:term:c34823cba19ec45c3e7c0693ac9271e54d8940154d5fd8186d72962709e90ce2\"],\"typed_values\":[]}",

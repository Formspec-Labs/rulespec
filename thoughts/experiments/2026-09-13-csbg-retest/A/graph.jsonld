      "@id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:100867:101153:sha256-86b5769ffb068f6962d131f0ff6fed5ff5798dc28c35ffe851aeb6a8a23ad5f5",

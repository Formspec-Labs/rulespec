":106306,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:105872:106306:sha256-194ed051132c7902d9abf30de41ed32cf0e3d9eec8089a111b3a568e0cee0a90\",\"quote\":\"(A) a community-based advisory committee is established, with representatives from local youth, family, and social service organizations, schools, entities providing park and recreation services, and other community-based organizations serving high-risk youth; or\\n\\n(B) an existing community-based advisory board, commission, or committee with similar membership is utilized to serve as the committee described in subparagraph (A); and\",\"start\":105872},{\"end\":105778,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:105753:105778:sha256-4e3196b2b4aa0cdda8d7052c46ef646ce3ac79982e9f3db9f7e86492ab410ad5\",\"quote\":\"eligible service provider\",\"start\":105753},{\"end\":105784,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:105779:105784:sha256-56ee5b508706bf2de91712d85d6d1e11ddbff01949142ed6e8c22e3b1bed1c71\",\"quote\":\"shall\",\"start\":105779},{\"end\":105748,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:105712:105748:sha256-f9b9c116fcd48bea70cb53ac79681f2811f993db70466fbab9239943517e0b6b\",\"quote\":\"(c) Advisory committee; partnerships\",\"start\":105712},{\"end\":105852,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:105749:105852:sha256-cb157ba9c97c251f44ee82b13ad864ea761fede60323da0c6d4b616e702286b9\",\"quote\":\"The eligible service provider shall, in each community in which a program is funded under this section—\",\"start\":105749}],\"id\":\"urn:rulespec:document-understanding:revision:642cb53d78b6fad2cb68befe312cd6e276044917b47809cf2d775fc0715f9682\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:b340604dc3796ea63da6c82059cf64ebb42ebc67fd5d8d0f7229bff95714aeac\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:64c14d468225c47288625939f6279fef347d4982ca9181cbbe858b1b4600155e\",\"origin\":\"aiSuggested\",\"quote\":\"(c) Advisory committee; partnerships The eligible service provider shall, in each community in which a program is funded under this section—\\n\\n(1) ensure that—\\n\\n(A) a community-based advisory committee is established, with representatives from local youth, family, and social service organizations, schools, entities providing park and recreation services, and other community-based organizations serving high-risk youth; or\\n\\n(B) an existing community-based advisory board, commission, or committee with similar membership is utilized to serve as the committee described in subparagraph (A); and\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:20e8ef2e32b12a6d951622587a7c8497eadbdc22217e87970b31e6a20c7bfb78\",\"scope_quotes\":[\"(c) Advisory committee; partnerships The eligible service provider shall, in each community in which a program is funded under this section—\"],\"scope_text\":\"In each community in which a program is funded under section 9923.\",\"section_id\":\"urn:rulespec:document-understanding:section:f3eea5347c895856895eee6edec328881bdec01acc0faf09e4d4dd77b2ba0a81\",\"start\":105712,\"summary\":\"In each community in which a program is funded under section 9923, the eligible service provider must ensure that: (A) a community-based advisory committee is established, with representatives from local youth, family, and social service organizations, schools, entities providing park and recreation services, and other community-based organizations serving high-risk youth; or (B) an existing community-based advisory board, commission, or committee with similar membership is utilized to serve as that committee.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",
      "dcterms:references": [
        {
          "@id": "urn:rulespec:document-understanding:assertion:1a695782dc1394db64bddfcd55c7b16df332f535c7b07defc49c760f4d95469a"

      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:95552eae5d059569ebf44e6120516aeb2fcfcdb40d4b1726693c2fcc718cd9a0\",\"urn:rulespec:document-understanding:assertion:ab29593b92413c4830991028ed29a8fedafb621d78685b0cc12a1def67733a61\",\"urn:rulespec:document-understanding:assertion:1a6a6fb6b729b239b3596b24cfbc85433846212864ecd9005e4d94bd9f6034c5\",\"urn:rulespec:document-understanding:assertion:6e873cb91ac1e824018c6bde55cca2e6b1160457efec342c788e9e8570cbb34d\",\"urn:rulespec:document-understanding:assertion:903259fd1fe1de60042311bacd8afba2ef249aa29e950f9e628aedcfe72fb6e4\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":23586,\"evidence\":[{\"end\":23309,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:23267:23309:sha256-d53300fd1468bf07eaab690203deea5fadab76c79d13e9b3b404c429c481b454\",\"quote\":\"(2) Maintenance of fiscal year 1990 levels\",\"start\":23267},{\"end\":23586,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:23311:23586:sha256-9524cf116da999e881f21b32f0c44ad3a9b5adaa79e3762bd65701e25b241bb9\",\"quote\":\"Paragraph (1) shall not apply with respect to a fiscal year if the amount allotted under subsection (a) to any State for that year is less than the amount allotted under section 9903(a)(1) of this title (as in effect on September 30, 1989) to such State for fiscal year 1990.\",\"start\":23311},{\"end\":23340,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:23325:23340:sha256-7001dc18e4250cacd3b4c31ed3fe0df3af0a721931a03c64cc5478da04eb29bd\",\"quote\":\"shall not apply\",\"start\":23325},{\"end\":23586,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:23311:23586:sha256-9524cf116da999e881f21b32f0c44ad3a9b5adaa79e3762bd65701e25b241bb9\",\"quote\":\"Paragraph (1) shall not apply with respect to a fiscal year if the amount allotted under subsection (a) to any State for that year is less than the amount allotted under section 9903(a)(1) of this title (as in effect on September 30, 1989) to such State for fiscal year 1990.\",\"start\":23311}],\"id\":\"urn:rulespec:document-understanding:revision:c70968303f1eee9ad14032ede60ed6e574f6fc1f622151805e4d9e683656d7f7\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"prohibition\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:6e873cb91ac1e824018c6bde55cca2e6b1160457efec342c788e9e8570cbb34d\",\"modality\":\"must_not\",\"modality_quote\":\"shall not apply\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:3ccc9a85007e72bad8e808fae73abdf5dbcfbf7d5db97907794e5188aa27c1a9\",\"origin\":\"aiSuggested\",\"quote\":\"(2) Maintenance of fiscal year 1990 levels\\n\\nParagraph (1) shall not apply with respect to a fiscal year if the amount allotted under subsection (a) to any State for that year is less than the amount allotted under section 9903(a)(1) of this title (as in effect on September 30, 1989) to such State for fiscal year 1990.\",\"references\":[\"Paragraph (1)\",\"subsection (a)\",\"section 9903(a)(1)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:4f7d6e4d54c1992800865ab5c8ddca55e4a49da83005bfc42531907548507f6b\",\"scope_quotes\":[\"Paragraph (1) shall not apply with respect to a fiscal year if the amount allotted under subsection (a) to any State for that year is less than the amount allotted under section 9903(a)(1) of this title (as in effect on September 30, 1989) to such State for fiscal year 1990.\"],\"scope_text\":\"if the amount allotted under subsection (a) to any State for that year is less than the amount allotted under section 9903(a)(1) of this title (as in effect on September 30, 1989) to such State for fiscal year 1990\",\"section_id\":\"urn:rulespec:document-understanding:section:77b293a31882899a97687fe9cf87dc80be98be00fdc4957f7ebc1a1856d5f6c9\",\"start\":23267,\"summary\":\"Paragraph (1) of section 9906(b) shall not apply with respect to a fiscal year if the amount allotted under subsection (a) to any State for that year is less than the amount allotted under section 9903(a)(1) of title 42 (as in effect on September 30, 1989) to such State for fiscal year 1990.\",\"target_ids\":[],\"term_refs\":[\"urn:rulespec:document-understanding:term:737b4a835a77703334e5da03eb8fc1a624a2cb0dd700298e37ccafb980c36609\"],\"typed_values\":[]}",

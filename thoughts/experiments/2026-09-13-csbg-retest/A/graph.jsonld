      "dcterms:description": "{\"action\":\"\",\"actor\":\"the Secretary\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:a38e79b2d577aab913c8d1ee3a3c9b496acf22823b86fd0861abcfddcc2b91c9\",\"urn:rulespec:document-understanding:assertion:4665fa1f265df4e291780ddd1286ea33994d5b713eb45737b4449be8ca2bb440\",\"urn:rulespec:document-understanding:assertion:c961c8877374bd7566dd58497ead16210d75317cb82b2567f866f714ef255cd3\",\"urn:rulespec:document-understanding:assertion:cd8033a984c0e1e7cf23636b3a6c46a11a269b8696c0113132bcbfe0864cf1ff\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[\"(1) In general The Secretary shall use amounts reserved in section 9903(b)(2) of this title—\\n\\n(A) for training, technical assistance, planning, evaluation, and performance measurement, to assist States in carrying out corrective action activities and monitoring (to correct programmatic deficiencies of eligible entities), and for reporting and data collection activities, related to programs carried out under this chapter; and\"],\"defined_terms\":[],\"effective_periods\":[],\"end\":64072,\"evidence\":[{\"end\":64072,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:63912:64072:sha256-fea3612270c994fa5391964c179f272ce5fcb34f6f05d9bce357234f3ac91629\",\"quote\":\"The activities described in paragraph (1)(A) may be carried out by the Secretary through grants, contracts, or cooperative agreements with appropriate entities.\",\"start\":63912},{\"end\":63992,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:63979:63992:sha256-67afe9d5c4310238267da793c265a616f9e90d554f2458a8065b7bb971d853b5\",\"quote\":\"the Secretary\",\"start\":63979},{\"e
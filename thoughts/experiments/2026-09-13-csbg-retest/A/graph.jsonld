      "rkaf:applicabilityCondition": "In order for a public organization to be considered to be an eligible entity for purposes of section 9902(1) of this title"
    },
    {
      "@id": "urn:rulespec:document-understanding:assertion:3706f8f547d6a55a8442b60c22a8c2628dbc99d3748a0e64f5629aca65cf297f",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:4633c72b9949e6d6951371bc0574fba50f8ba6a46700aec92d15b8c8b10c59fa",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:772912910f25c3b018f6b2b9d0d9f52575d2682e55f10e3ebc6f00b827dd5dfd",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:2c44c127017c4c9655e019830f1fce02835d85b578ba5357c60b5211fbac0228",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:states-requirement",
      "rkaf:assertsValue": {
        "@value": "In order for a public organization to be considered to be an eligible entity for purposes of section 9902(1) of title 42, the entity shall administer the community services block grant program through either: (1) a tripartite board, which shall have members selected by the organization and shall be composed so as to assure that not fewer than ⅓ of the members are persons chosen in accordance with democratic selection procedures adequate to assure that these members are representative of low-income individuals and families in the neighborhood served, reside in the neighborhood served, and are able to participate actively in the development, planning, implementation, and evaluation of programs funded under chapter 106; or (2) another mechanism specified by the State to assure decisionmaking and participation by low-income individuals in the development, planning, implementation, and evaluation of programs funded under chapter 106.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

    {
      "@id": "urn:rulespec:document-understanding:revision:95e3c2d69cc8e970fa106ae6e7757449882bcdb97f0adff4a49c1d957f9412d1",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:95e3c2d69cc8e970fa106ae6e7757449882bcdb97f0adff4a49c1d957f9412d1",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:725cdbf6c3bdb15c6a22857303fb73010909e3b542b555f0430b2ffe344a91b8",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"grantees\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:0eb0bd28e0911bf47515dc58e6642528579887c92b62e8b992bef06762d73ccb\",\"urn:rulespec:document-understanding:assertion:49a87b6387f24a9d04ff9121f46813b9434ef4cc3bc690afec763a20e8bbfd76\",\"urn:rulespec:document-understanding:assertion:70f021e22c0b25d147e275def29b770fc6794bc6114f93669a268ca785f64e44\",\"urn:rulespec:document-understanding:assertion:b11065241e6c868f8809ae279dfbd01e334a157c203ba6a0aef3fd9a66123cae\",\"urn:rulespec:document-understanding:assertion:49587b61c2c6ec99dd9874e4ca71bd4bf72ed11bad4dc3147c098fe0e7c65f6c\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":96963,\"evidence\":[{\"end\":96963,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:95995:96963:sha256-217579195f09dded46d5fe486ff35bb87cd4f873f27592d75dfa76116affea8d\",\"quote\":\"Pub. L. 119–75, div. B, title II, Feb. 3, 2026, 140 Stat. 277, provided in part: “That the Secretary [of Health and Human Services] shall establish procedures regarding the disposition of intangible assets and program income that permit such assets acquired with, and program income derived from, grant funds authorized under section 680 of the CSBG Act [Community Services Block Grant Act, 42 U.S.C. 9921] to become the sole property of such grantees after a period of not more than 12 years after the end of the grant period for any activity consistent with section 680(a)(2)(A) of the CSBG Act [42 U.S.C. 9921(a)(2)(A)]: Provided further, That intangible assets in the form of loans, equity investments and other debt instruments, and program income may be used by grantees for any eligible purpose consistent with section 680(a)(2)(A) of the CSBG Act: Provided further, That these procedures shall apply to such grant funds made available after November 29, 1999”.\",\"start\":95995},{\"end\":96751,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:96748:96751:sha256-ee4d988c65de860fabbfbcd27f73d50bbebe3fba37fe419284f4811389c30bdc\",\"quote\":\"may\",\"start\":96748},{\"end\":96963,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:95995:96963:sha256-217579195f09dded46d5fe486ff35bb87cd4f873f27592d75dfa76116affea8d\",\"quote\":\"Pub. L. 119–75, div. B, title II, Feb. 3, 2026, 140 Stat. 277, provided in part: “That the Secretary [of Health and Human Services] shall establish procedures regarding the disposition of intangible assets and program income that permit such assets acquired with, and program income derived from, grant funds authorized under section 680 of the CSBG Act [Community Services Block Grant Act, 42 U.S.C. 9921] to become the sole property of such grantees after a period of not more than 12 years after the end of the grant period for any activity consistent with section 680(a)(2)(A) of the CSBG Act [42 U.S.C. 9921(a)(2)(A)]: Provided further, That intangible assets in the form of loans, equity investments and other debt instruments, and program income may be used by grantees for any eligible purpose consistent with section 680(a)(2)(A) of the CSBG Act: Provided further, That these procedures shall apply to such grant funds made available after November 29, 1999”.\",\"start\":95995}],\"id\":\"urn:rulespec:document-understanding:revision:95e3c2d69cc8e970fa106ae6e7757449882bcdb97f0adff4a49c1d957f9412d1\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"permission\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:49587b61c2c6ec99dd9874e4ca71bd4bf72ed11bad4dc3147c098fe0e7c65f6c\",\"modality\":\"may\",\"modality_quote\":\"may\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:1f628cc0f50c84cdc9b88e5864e542460e6601547fb449323b723e46c6eddcce\",\"origin\":\"aiSuggested\",\"quote\":\"Pub. L. 119–75, div. B, title II, Feb. 3, 2026, 140 Stat. 277, provided in part: “That the Secretary [of Health and Human Services] shall establish procedures regarding the disposition of intangible assets and program income that permit such assets acquired with, and program income derived from, grant funds authorized under section 680 of the CSBG Act [Community Services Block Grant Act, 42 U.S.C. 9921] to become the sole property of such grantees after a period of not more than 12 years after the end of the grant period for any activity consistent with section 680(a)(2)(A) of the CSBG Act [42 U.S.C. 9921(a)(2)(A)]: Provided further, That intangible assets in the form of loans, equity investments and other debt instruments, and program income may be used by grantees for any eligible purpose consistent with section 680(a)(2)(A) of the CSBG Act: Provided further, That these procedures shall apply to such grant funds made available after November 29, 1999”.\",\"references\":[\"42 U.S.C. 9921(a)(2)(A)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:6d33093c956e873bd526f9e15891b7f6fe9785978adbf00c14ce503ee191b467\",\"scope_quotes\":[\"Pub. L. 119–75, div. B, title II, Feb. 3, 2026, 140 Stat. 277, provided in part: “That the Secretary [of Health and Human Services] shall establish procedures regarding the disposition of intangible assets and program income that permit such assets acquired with, and program income derived from, grant funds authorized under section 680 of the CSBG Act [Community Services Block Grant Act, 42 U.S.C. 9921] to become the sole property of such grantees after a period of not more than 12 years after the end of the grant period for any activity consistent with section 680(a)(2)(A) of the CSBG Act [42 U.S.C. 9921(a)(2)(A)]: Provided further, That intangible assets in the form of loans, equity investments and other debt instruments, and program income may be used by grantees for any eligible purpose consistent with section 680(a)(2)(A) of the CSBG Act: Provided further, That these procedures shall apply to such grant funds made available after November 29, 1999”.\"],\"scope_text\":\"Regarding grant funds authorized under section 680 of the Community Services Block Grant Act made available after November 29, 1999.\",\"section_id\":\"urn:rulespec:document-understanding:section:6888d98c59cc2331f4c6a6a1e0052761ef3a8008658a9708c0cec6503ed121ed\",\"start\":95995,\"summary\":\"Intangible assets in the form of loans, equity investments and other debt instruments, and program income may be used by grantees for any eligible purpose consistent with section 680(a)(2)(A) of the Community Services Block Grant Act (42 U.S.C. 9921(a)(2)(A)), under the procedures established by the Secretary regarding grant funds made available after November 29, 1999.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

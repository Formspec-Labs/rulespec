      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:736f9902afb83e54d00d7ec20f97a1ed115484263baf424678e22c8a7defc37b\",\"urn:rulespec:document-understanding:assertion:3b8daf1abc84c2c4320841f169e57fd2e701106d29fe88148c3121f0ace97939\",\"urn:rulespec:document-understanding:assertion:d8a59f79e5bc1c6658db7785405a2b2bc8ebbe7c1a2b0b32e5e69aa2431870ae\",\"urn:rulespec:document-understanding:assertion:d94b6a7583c4ee7b7178d13b0110833efd360bb40eb98741b6448807c5f72ad3\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[{\"aliases\":[],\"id\":\"urn:rulespec:document-understanding:term:c6eb8403610191cb07207ea80615a01b90092c34655a8517252e17ea3ec5027f\",\"label\":\"low-income individual eligible to participate in a project conducted under this section\",\"quote\":\"(3) A low-income individual eligible to participate in a project conducted under this section is any individual eligible to receive assistance under the program funded part 1\\n\\n1 So in original. Probably should be “under part”.\\n\\n A of title IV of the Social Security Act [42 U.S.C. 601 et seq.] of the State in which the individual resides and any other individual whose income level does not exceed 100 percent of the official poverty line as defined by the Office of Management and Budget and revised in accordance with section 9902(2) of this title.\",\"source_quotes\":[\"(3) A low-income individual eligible to participate in a project conducted under this section is any individual eligible to receive assistance under the program funded part 1\",\"A of title IV of the Social Security Act [42 U.S.C. 601 et seq.] of the State in which the individual resides and any other individual whose income level does not exceed 100 percent of the official poverty line as defined by the Office of Management and Budget and revised in accordance with section 9902(2) of this title.\"]}],\"effective_periods\":[],\"end\":129222,\"evidence\":[{\"end\":128845,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:128671:128845:sha256-499a90245667a6f0f8645a86f1ed32a8190d711cdc2292a6e5dd4f67ae6e20c6\",\"quote\":\"(3) A low-income individual eligible to participate in a project conducted under this section is any individual eligible to receive assistance under the program funded part 1\",\"start\":128671},{\"end\":128897,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:128847:128897:sha256-884f80fcce9e6ac3d3b413e2059e15134e572a30c7eeaed910cc465b284a1e42\",\"quote\":\"1 So in original. Probably should be “under part”.\",\"start\":128847},{\"end\":129222,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:128899:129222:sha256-0acd2d3647ffc169c796c02d72256bc2b4a67847a0e4a4353d860f1e9599b971\",\"quote\":\" A of title IV of the Social Security Act [42 U.S.C. 601 et seq.] of the State in which the individual resides and any other individual whose income level does not exceed 100 percent of the official poverty line as defined by the Office of Management and Budget and revised in accordance with section 9902(2) of this title.\",\"start\":128899},{\"end\":128845,\"field\":\"defined_terms:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:128671:128845:sha256-499a90245667a6f0f8645a86f1ed32a8190d711cdc2292a6e5dd4f67ae6e20c6\",\"quote\":\"(3) A low-income individual eligible to participate in a project conducted under this section is any individual eligible to receive assistance under the program funded part 1\",\"start\":128671},{\"end\":128897,\"field\":\"defined_terms:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:128847:128897:sha256-884f80fcce9e6ac3d3b413e2059e15134e572a30c7eeaed910cc465b284a1e42\",\"quote\":\"1 So in original. Probably should be “under part”.\",\"start\":128847},{\"end\":129222,\"field\":\"defined_terms:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:128899:129222:sha256-0acd2d3647ffc169c796c02d72256bc2b4a67847a0e4a4353d860f1e9599b971\",\"quote\":\" A of title IV of the Social Security Act [42 U.S.C. 601 et seq.] of the State in which the individual resides and any other individual whose income level does not exceed 100 percent of the official poverty line as defined by the Office of Management and Budget and revised in accordance with section 9902(2) of this title.\",\"start\":128899},{\"end\":128845,\"field\":\"defined_terms:0:source:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:128671:128845:sha256-499a90245667a6f0f8645a86f1ed32a8190d711cdc2292a6e5dd4f67ae6e20c6\",\"quote\":\"(3) A low-income individual eligible to participate in a project conducted under this section is any individual eligible to receive assistance under the program funded part 1\",\"start\":128671},{\"end\":129222,\"field\":\"defined_terms:0:source:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:128900:129222:sha256-78c985b8d8eff23121beab64f63a165c1a4a91b7ce0ed5067fd0622b24b25b57\",\"quote\":\"A of title IV of the Social Security Act [42 U.S.C. 601 et seq.] of the State in which the individual resides and any other individual whose income level does not exceed 100 percent of the official poverty line as defined by the Office of Management and Budget and revised in accordance with section 9902(2) of this title.\",\"start\":128900}],\"id\":\"urn:rulespec:document-understanding:revision:9c68a14f414dbdd8525abb5dd0b8448e31ae15d5bf1ccc97e29ff9dbfcd32d9a\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"definition\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:d8a59f79e5bc1c6658db7785405a2b2bc8ebbe7c1a2b0b32e5e69aa2431870ae\",\"modality\":\"not_stated\",\"modality_quote\":\"\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:019a2fb061000a9eec3be227599d4efc752355775444b66786e5bffe07272332\",\"origin\":\"aiSuggested\",\"quote\":\"(3) A low-income individual eligible to participate in a project conducted under this section is any individual eligible to receive assistance under the program funded part 1\\n\\n1 So in original. Probably should be “under part”.\\n\\n A of title IV of the Social Security Act [42 U.S.C. 601 et seq.] of the State in which the individual resides and any other individual whose income level does not exceed 100 percent of the official poverty line as defined by the Office of Management and Budget and revised in accordance with section 9902(2) of this title.\",\"references\":[\"part A of title IV of the Social Security Act [42 U.S.C. 601 et seq.]\",\"section 9902(2) of this title\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:cd26dd5feeb238b77b0c828f3d1960b65dc626478468b2b912e9e6a9aaf325c8\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"urn:rulespec:document-understanding:section:5cb9e3013811792481482abb8750d37c55ae5065c06c0e2b4c0138fff8f3e929\",\"start\":128671,\"summary\":\"A low-income individual eligible to participate in a project conducted under 42 U.S.C. 9926 is any individual eligible to receive assistance under the program funded part A of title IV of the Social Security Act [42 U.S.C. 601 et seq.] of the State in which the individual resides and any other individual whose income level does not exceed 100 percent of the official poverty line as defined by the Office of Management and Budget and revised in accordance with section 9902(2) of this title.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

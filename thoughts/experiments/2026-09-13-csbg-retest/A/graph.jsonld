      "dcterms:description": "{\"action\":\"\",\"actor\":\"a State\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:9c6eb3ea56977f33ee5746ef1c09987fdb57badb183158095d65cecf8ea17ad7\",\"urn:rulespec:document-understanding:assertion:1c4d86a6d591adb5cd2d309aaf583ce38bd9418adc62c1c66e0cb12abcc14d6c\",\"urn:rulespec:document-understanding:assertion:0866fb55a05d6debeecd4b8823d1dfb47e25a0d7625c9ddf5feedc501860eb6d\",\"urn:rulespec:document-understanding:assertion:e86dee69032c5b6ce5f1b992dc62140e25a40d3705f1ce5455aa0723cf00c5c5\",\"urn:rulespec:document-understanding:assertion:6167602cf6d477849f0f438f77be9857586a2f6857911bb05f23d61d281b3371\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":48346,\"evidence\":[{\"end\":48346,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:47961:48346:sha256-ccacad5ea3c940de64ddf962065946de9b2ed898fa6d7c1ff6ccb0bc1ae99ec4\",\"quote\":\"For fiscal year 2000, to be eligible to receive a grant or allotment under section 9905 or 9906 of this title, a State shall prepare and submit to the Secretary an application and State plan in accordance with the provisions of this chapter (as in effect on the day before October 27, 1998), rather than the provisions of subsections (a) through (c) relating to applications and plans.\",\"start\":47961},{\"end\":48079,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:48072:48079:sha256-c178fdd744dfc1cc76caac454515b335da2f0b1008fe2c7653ec53a1e7a63255\",\"quote\":\"a State\",\"start\":48072},{\"end\":48085,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:48080:48085:sha256-56ee5b508706bf2de91712d85d6d1e11ddbff01949142ed6e8c22e3b1bed1c71\",\"quote\":\"shall\",\"start\":48080},{\"end\":48346,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:47961:48346:sha256-ccacad5ea3c940de64ddf962065946de9b2ed898fa6d7c1ff6ccb0bc1ae99ec4\",\"quote\":\"For fiscal year 2000, to be eligible to receive a grant or allotment under section 9905 or 9906 of this title, a State shall prepare and submit to the Secretary an application and State plan in accordance with the provisions of this chapter (as in effect on the day before October 27, 1998), rather than the provisions of subsections (a) through (c) relating to applications and plans.\",\"start\":47961}],\"id\":\"urn:rulespec:document-understanding:revision:30d68cf8934f27269b7eafae11bdaa771bc3512b18f5fd0518c1587020d33e12\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:6167602cf6d477849f0f438f77be9857586a2f6857911bb05f23d61d281b3371\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:fe2a4a5ca231deddc0adba63119a95b511f4125dff4044b7be505351730e9ff3\",\"origin\":\"aiSuggested\",\"quote\":\"For fiscal year 2000, to be eligible to receive a grant or allotment under section 9905 or 9906 of this title, a State shall prepare and submit to the Secretary an application and State plan in accordance with the provisions of this chapter (as in effect on the day before October 27, 1998), rather than the provisions of subsections (a) through (c) relating to applications and plans.\",\"references\":[\"section 9905\",\"section 9906\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:a06a0d6c9bd6926c0cc9a49e696a67fd76c1b7c543794d65fc404da5bdbc44d9\",\"scope_quotes\":[\"For fiscal year 2000, to be eligible to receive a grant or allotment under section 9905 or 9906 of this title, a State shall prepare and submit to the Secretary an application and State plan in accordance with the provisions of this chapter (as in effect on the day before October 27, 1998), rather than the provisions of subsections (a) through (c) relating to applications and plans.\"],\"scope_text\":\"For fiscal year 2000, to be eligible to receive a grant or allotment under section 9905 or 9906 of this title\",\"section_id\":\"urn:rulespec:document-understanding:section:0b55006ce2c906add8328d3986f73bcd1ded9a87a908d01ae85b5595b9018d1b\",\"start\":47961,\"summary\":\"For fiscal year 2000, to be eligible to receive a grant or allotment under section 9905 or 9906 of title 42, a State shall prepare and submit to the Secretary an application and State plan in accordance with the provisions of chapter 106 of title 42 (as in effect on the day before October 27, 1998), rather than the provisions of subsections (a) through (c) relating to applications and plans.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"the chief executive officer\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:507d475dad3ad6e1e31b0a633599183687ad0e1c61a4fa1af15f9b2ebbb790a2\",\"urn:rulespec:document-understanding:assertion:21de1357a1c0c46f031bb89a7db5340740c7b38d156bdd54ebe74f6f4d46d33c\",\"urn:rulespec:document-understanding:assertion:f6e89490b86128218fafffb7dcef093f504339e367abbca5d4eec4af11b77757\",\"urn:rulespec:document-understanding:assertion:9fcc612cf25495f407cf4943dd0c87af1dd73d425a2d1fb5b8d8c1507a6df1f8\",\"urn:rulespec:document-understanding:assertion:ed7ab7f7835652a5b9980d00880f7e6f9198e62d1a87e996d09638346a3923b3\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":53156,\"evidence\":[{\"end\":53156,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:52745:53156:sha256-e1706c26f78180af15def5eab3e88737527dae03f4a18f55387d1c424e1477d2\",\"quote\":\"In designating an eligible entity under subsection (a), the chief executive officer shall grant the designation to an organization of demonstrated effectiveness in meeting the goals and purposes of this chapter and may give priority, in granting the designation, to eligible entities that are providing related services in the unserved area, consistent with the needs identified by a community-needs assessment.\",\"start\":52745},{\"end\":52828,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:52801:52828:sha256-d44239874c9022ec9a79a4927817d7b4a7191564f32fab802aa5e97eb7824a2d\",\"quote\":\"the chief executive officer\",\"start\":52801},{\"end\":52963,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:52960:52963:sha256-ee4d988c65de860fabbfbcd27f73d50bbebe3fba37fe419284f4811389c30bdc\",\"quote\":\"may\",\"start\":52960},{\"end\":53156,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:52745:53156:sha256-e1706c26f78180af15def5eab3e88737527dae03f4a18f55387d1c424e1477d2\",\"quote\":\"In designating an eligible entity under subsection (a), the chief executive officer shall grant the designation to an organization of demonstrated effectiveness in meeting the goals and purposes of this chapter and may give priority, in granting the designation, to eligible entities that are providing related services in the unserved area, consistent with the needs identified by a community-needs assessment.\",\"start\":52745}],\"id\":\"urn:rulespec:document-understanding:revision:e5a7b4a7b05e9237928519f2a8d0a4412dae8a076a7917f64c2cc992a5b6e9f5\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"permission\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:ed7ab7f7835652a5b9980d00880f7e6f9198e62d1a87e996d09638346a3923b3\",\"modality\":\"may\",\"modality_quote\":\"may\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:2e46dc66d044c7d4d5e8142c228cf1a67ff772d679fa81cfbe16d38fa8509c42\",\"origin\":\"aiSuggested\",\"quote\":\"In designating an eligible entity under subsection (a), the chief executive officer shall grant the designation to an organization of demonstrated effectiveness in meeting the goals and purposes of this chapter and may give priority, in granting the designation, to eligible entities that are providing related services in the unserved area, consistent with the needs identified by a community-needs assessment.\",\"references\":[\"subsection (a)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:663182c97ce107c37da2230c7e7537cf272856a261d57732c962e40feafd025a\",\"scope_quotes\":[\"In designating an eligible entity under subsection (a), the chief executive officer shall grant the designation to an organization of demonstrated effectiveness in meeting the goals and purposes of this chapter and may give priority, in granting the designation, to eligible entities that are providing related services in the unserved area, consistent with the needs identified by a community-needs assessment.\"],\"scope_text\":\"In designating an eligible entity under subsection (a)\",\"section_id\":\"urn:rulespec:document-understanding:section:b8000f1ee8341d7eccdb1b202ebee86bddd6c2a58344891bf3dfbc5b7909fb1a\",\"start\":52745,\"summary\":\"In designating an eligible entity under 42 U.S.C. 9909(a), the chief executive officer may give priority, in granting the designation, to eligible entities that are providing related services in the unserved area, consistent with the needs identified by a community-needs assessment.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

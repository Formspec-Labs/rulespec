      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:4633c72b9949e6d6951371bc0574fba50f8ba6a46700aec92d15b8c8b10c59fa",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:df5c9c33272f572be5ef6667e12aa9bfa633d43d9b64a49c8d8dec9dce4f0d97",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:11de0e9d1f9175e066dc5017a64e8877b3a46cd210a6d1504f2f130888863380",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:states-requirement",
      "rkaf:assertsValue": {
        "@value": "The Secretary shall, from the amount appropriated under section 9903(a) of title 42 for each fiscal year that remains after the Secretary makes the reservations required in section 9903(b) of title 42, allot to each State (subject to section 9911 of title 42) an amount bearing the same ratio to such remaining amount as the amount received by the State for fiscal year 1981 under section 2808 of title 42 bore to the total amount received by all States for fiscal year 1981 under such section, except that no State shall receive less than 1/4 of 1 percent of the amount appropriated under section 9903(a) for such fiscal year, and except as provided in subsection (b) of section 9906.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

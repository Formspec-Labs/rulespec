      ],
      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "From funds made available under paragraphs (1)(B) and (2)(B) for any fiscal year, the Secretary may not make grants under subsection (a) to an eligible agency in an aggregate amount exceeding $50,000. From funds made available under paragraph (2)(C) for any fiscal year, the Secretary may not make grants under subsection (a) to an eligible agency in an aggregate amount exceeding $300,000."
        },
        {
          "@type": "oa:TextPositionSelector",
          "oa:start": 102229,
          "oa:end": 102619,
          "rkaf:coordinateSystem": "rkaf:unicode-codepoint"
        }
      ]
    },
    {

      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"Secretary [of Health and Human Services]\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:7084e9cf411e3e657daa16859773abc5bd8996682701ddf8c5b4caea475ea582\",\"urn:rulespec:document-understanding:assertion:676c1eed94f19aeee0d7b4f8100110101ff1684990c7db418a81755f1d25dc5a\",\"urn:rulespec:document-understanding:assertion:71dc4998714f40564907e1b84810768bdc7c597b541017eab90540738d3578b4\",\"urn:rulespec:document-understanding:assertion:eed1f8a633f0671a9d76a1e4a8f843deb5d946342cf2621e2ddd214444faa06b\",\"urn:rulespec:document-understanding:assertion:ac0d76db7a7dddb40893178c7af7845ea9b606c4f537d2ef2d352de7efbf04da\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":96963,\"evidence\":[{\"end\":96963,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:95995:96963:sha256-217579195f09dded46d5fe486ff35bb87cd4f873f27592d75dfa76116affea8d\",\"quote\":\"Pub. L. 119–75, div. B, title II, Feb. 3, 2026, 140 Stat. 277, provided in part: “That the Secretary [of Health and Human Services] shall establish procedures regarding the disposition of intangible assets and program income that permit such assets acquired with, and program income derived from, grant funds authorized under section 680 of the CSBG Act [Community Services Block Grant Act, 42 U.S.C. 9921] to become the sole property of such grantees after a period of not more than 12 years after the end of the grant period for any activity consistent with section 680(a)(2)(A) of the CSBG Act [42 U.S.C. 9921(a)(2)(A)]: Provided further, That intangible assets in the form of loans, equity investments and other debt instruments, and program income may be used by grantees for any eligible purpose consistent with section 680(a)(2)(A) of the CSBG Act: Provided further, That these procedures shall apply to such grant funds made available after November 29, 1999”.\",\"start\":95995},{\"end\":96126,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:96082:96126:sha256-089128b7d3ae9e9bfb1fb777e25322162b67359523defdee803bedf43eec556f\",\"quote\":\"the Secretary [of Health and Human Services]\",\"start\":96082},{\"end\":96963,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:95995:96963:sha256-217579195f09dded46d5fe486ff35bb87cd4f873f27592d75dfa76116affea8d\",\"quote\":\"Pub. L. 119–75, div. B, title II, Feb. 3, 2026, 140 Stat. 277, provided in part: “That the Secretary [of Health and Human Services] shall establish procedures regarding the disposition of intangible assets and program income that permit such assets acquired with, and program income derived from, grant funds authorized under section 680 of the CSBG Act [Community Services Block Grant Act, 42 U.S.C. 9921] to become the sole property of such grantees after a period of not more than 12 years after the end of the grant period for any activity consistent with section 680(a)(2)(A) of the CSBG Act [42 U.S.C. 9921(a)(2)(A)]: Provided further, That intangible assets in the form of loans, equity investments and other debt instruments, and program income may be used by grantees for any eligible purpose consistent with section 680(a)(2)(A) of the CSBG Act: Provided further, That these procedures shall apply to such grant funds made available after November 29, 1999”.\",\"start\":95995}],\"id\":\"urn:rulespec:document-understanding:revision:f971604a9d093b8754c70f26944c2983b514eac8b528f23d5a33f8a428ccf55e\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:ac0d76db7a7dddb40893178c7af7845ea9b606c4f537d2ef2d352de7efbf04da\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:1fe602ed45367d6b7616d0c607d03a96063b5e4e4684e5034938bc53d467ec29\",\"origin\":\"aiSuggested\",\"quote\":\"Pub. L. 119–75, div. B, title II, Feb. 3, 2026, 140 Stat. 277, provided in part: “That the Secretary [of Health and Human Services] shall establish procedures regarding the disposition of intangible assets and program income that permit such assets acquired with, and program income derived from, grant funds authorized under section 680 of the CSBG Act [Community Services Block Grant Act, 42 U.S.C. 9921] to become the sole property of such grantees after a period of not more than 12 years after the end of the grant period for any activity consistent with section 680(a)(2)(A) of the CSBG Act [42 U.S.C. 9921(a)(2)(A)]: Provided further, That intangible assets in the form of loans, equity investments and other debt instruments, and program income may be used by grantees for any eligible purpose consistent with section 680(a)(2)(A) of the CSBG Act: Provided further, That these procedures shall apply to such grant funds made available after November 29, 1999”.\",\"references\":[\"42 U.S.C. 9921\",\"42 U.S.C. 9921(a)(2)(A)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:cbc2d45eff21b984ac85f9b4048b1cb5f725b1ae04bee801262047615059e433\",\"scope_quotes\":[\"Pub. L. 119–75, div. B, title II, Feb. 3, 2026, 140 Stat. 277, provided in part: “That the Secretary [of Health and Human Services] shall establish procedures regarding the disposition of intangible assets and program income that permit such assets acquired with, and program income derived from, grant funds authorized under section 680 of the CSBG Act [Community Services Block Grant Act, 42 U.S.C. 9921] to become the sole property of such grantees after a period of not more than 12 years after the end of the grant period for any activity consistent with section 680(a)(2)(A) of the CSBG Act [42 U.S.C. 9921(a)(2)(A)]: Provided further, That intangible assets in the form of loans, equity investments and other debt instruments, and program income may be used by grantees for any eligible purpose consistent with section 680(a)(2)(A) of the CSBG Act: Provided further, That these procedures shall apply to such grant funds made available after November 29, 1999”.\"],\"scope_text\":\"Applicable to grant funds authorized under section 680 of the Community Services Block Grant Act made available after November 29, 1999.\",\"section_id\":\"urn:rulespec:document-understanding:section:6888d98c59cc2331f4c6a6a1e0052761ef3a8008658a9708c0cec6503ed121ed\",\"start\":95995,\"summary\":\"The Secretary of Health and Human Services must establish procedures regarding the disposition of intangible assets and program income that permit such assets acquired with, and program income derived from, grant funds authorized under section 680 of the Community Services Block Grant Act (42 U.S.C. 9921) to become the sole property of such grantees after a period of not more than 12 years after the end of the grant period for any activity consistent with section 680(a)(2)(A) of that Act (42 U.S.C. 9921(a)(2)(A)), applicable to such grant funds made available after November 29, 1999.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

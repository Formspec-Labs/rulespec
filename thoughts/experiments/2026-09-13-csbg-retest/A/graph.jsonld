      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"the chief executive officer\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:92fde6e9fd9200f4726769ac7460f8c1b4b09832cd5d90c70dae085de821925b\",\"urn:rulespec:document-understanding:assertion:b7e5b78deb79c3cfcfdb1aaa35589d20d70147b8807865cec6aacf4762cc825f\",\"urn:rulespec:document-understanding:assertion:1579151976a2ee549d9ee5ab44abe869fdb986c2428fd83c56bf87a79285e889\",\"urn:rulespec:document-understanding:assertion:19709441c619f0d8f8a488b7b3b4ee8c1312c6595895e76bc23e1a0b5c5cda6a\",\"urn:rulespec:document-understanding:assertion:19c205c8f5ca22b58610c012ad4d3d04aca8c0481d1816f2284f8f055dbcd305\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":53660,\"evidence\":[{\"end\":53660,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:53206:53660:sha256-ddb73ce1975e3100655a3d0112384d33e68535c9148ffc1c78d8f5179c67e1a1\",\"quote\":\"If no private, nonprofit organization is identified or determined to be qualified under subsection (a) to serve the unserved area as an eligible entity the chief executive officer may designate an appropriate political subdivision of the State to serve as an eligible entity for the area. In order to serve as the eligible entity for that area, the political subdivision shall have a board or other mechanism as required in section 9910(b) of this title.\",\"start\":53206},{\"end\":53385,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:53358:53385:sha256-d44239874c9022ec9a79a4927817d7b4a7191564f32fab802aa5e97eb7824a2d\",\"quote\":\"the chief executive officer\",\"start\":53358},{\"end\":53389,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:53386:53389:sha256-ee4d988c65de860fabbfbcd27f73d50bbebe3fba37fe419284f4811389c30bdc\",\"quote\":\"may\",\"start\":53386},{\"end\":53660,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:53206:53660:sha256-ddb73ce1975e3100655a3d0112384d33e68535c9148ffc1c78d8f5179c67e1a1\",\"quote\":\"If no private, nonprofit organization is identified or determined to be qualified under subsection (a) to serve the unserved area as an eligible entity the chief executive officer may designate an appropriate political subdivision of the State to serve as an eligible entity for the area. In order to serve as the eligible entity for that area, the political subdivision shall have a board or other mechanism as required in section 9910(b) of this title.\",\"start\":53206}],\"id\":\"urn:rulespec:document-understanding:revision:d7da1c52126b90c7bd927ecefe4db6f153e4b8a3e2e96c649e4d7d3f40d3200d\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"permission\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:19c205c8f5ca22b58610c012ad4d3d04aca8c0481d1816f2284f8f055dbcd305\",\"modality\":\"may\",\"modality_quote\":\"may\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:6098f41fd6a5ba1328ffc59ea717355d5c8ed1752219c3af5a142eb5d41dad6e\",\"origin\":\"aiSuggested\",\"quote\":\"If no private, nonprofit organization is identified or determined to be qualified under subsection (a) to serve the unserved area as an eligible entity the chief executive officer may designate an appropriate political subdivision of the State to serve as an eligible entity for the area. In order to serve as the eligible entity for that area, the political subdivision shall have a board or other mechanism as required in section 9910(b) of this title.\",\"references\":[\"subsection (a)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:a959985e62e0f80c60918864590086e6ec232850953592d56b5487c8f42abf6d\",\"scope_quotes\":[\"If no private, nonprofit organization is identified or determined to be qualified under subsection (a) to serve the unserved area as an eligible entity the chief executive officer may designate an appropriate political subdivision of the State to serve as an eligible entity for the area. In order to serve as the eligible entity for that area, the political subdivision shall have a board or other mechanism as required in section 9910(b) of this title.\"],\"scope_text\":\"If no private, nonprofit organization is identified or determined to be qualified under subsection (a) to serve the unserved area as an eligible entity\",\"section_id\":\"urn:rulespec:document-understanding:section:b8000f1ee8341d7eccdb1b202ebee86bddd6c2a58344891bf3dfbc5b7909fb1a\",\"start\":53206,\"summary\":\"If no private, nonprofit organization is identified or determined to be qualified under subsection (a) of 42 U.S.C. 9909 to serve the unserved area as an eligible entity, the chief executive officer may designate an appropriate political subdivision of the State to serve as an eligible entity for the area.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

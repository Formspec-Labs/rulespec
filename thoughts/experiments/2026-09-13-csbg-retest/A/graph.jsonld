      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:47bce28163cc76396e0b0855a7994604779209bc13dcf7c14aa1c78626561772\",\"urn:rulespec:document-understanding:assertion:6d981abf35f3448a5e17d927171ef92e72d7085086ffe06536090955ec274a92\",\"urn:rulespec:document-understanding:assertion:eb73092e69127713fce5dfc1f22413529479726050eb2cff9b4375f020cec8df\",\"urn:rulespec:document-understanding:assertion:3b038ff2f4d4ff2412d968c787076e2913d16436578d9a1ec75308a73691eea0\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":110528,\"evidence\":[{\"end\":110528,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:110012:110528:sha256-a4567bf1a30dd78f87b8b6158b39216cd91743856669822726c97d4ac1ed9c2b\",\"quote\":\"Any reference in any provision of law to the poverty line set forth in section 624 or 625 of the Economic Opportunity Act of 1964 shall be construed to be a reference to the poverty line defined in section 9902 of this title. Except as otherwise provided, any reference in any provision of law to any community action agency designated under title II of the Economic Opportunity Act of 1964 shall be construed to be a reference to an entity eligible to receive funds under the community services block grant program.\",\"start\":110012},{\"end\":110528,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:110012:110528:sha256-a4567bf1a30dd78f87b8b6158b39216cd91743856669822726c97d4ac1ed9c2b\",\"quote\":\"Any reference in any provision of law to the poverty line set forth in section 624 or 625 of the Economic Opportunity Act of 1964 shall be construed to be a reference to the poverty line defined in section 9902 of this title. Except as otherwise provided, any reference in any provision of law to any community action agency designated under title II of the Economic Opportunity Act of 1964 shall be construed to be a reference to an entity eligible to receive funds under the community services block grant program.\",\"start\":110012}],\"id\":\"urn:rulespec:document-understanding:revision:7b0706c7e93bc1898c89370dd2d6d8c84443b3a865502905a1836e670c7218f7\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:3b038ff2f4d4ff2412d968c787076e2913d16436578d9a1ec75308a73691eea0\",\"modality\":\"must\",\"modality_quote\":\"shall be construed\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:ff7c362360cc39ac15e224ff57b089f4d92e9ed5aa61e022eddcae118fd259c4\",\"origin\":\"aiSuggested\",\"quote\":\"Any reference in any provision of law to the poverty line set forth in section 624 or 625 of the Economic Opportunity Act of 1964 shall be construed to be a reference to the poverty line defined in section 9902 of this title. Except as otherwise provided, any reference in any provision of law to any community action agency designated under title II of the Economic Opportunity Act of 1964 shall be construed to be a reference to an entity eligible to receive funds under the community services block grant program.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:9dd10227804926e09b1a6181d015c5792e8fedb397b3a4fc5b77597058ef1928\",\"scope_quotes\":[\"Any reference in any provision of law to the poverty line set forth in section 624 or 625 of the Economic Opportunity Act of 1964 shall be construed to be a reference to the poverty line defined in section 9902 of this title. Except as otherwise provided, any reference in any provision of law to any community action agency designated under title II of the Economic Opportunity Act of 1964 shall be construed to be a reference to an entity eligible to receive funds under the community services block grant program.\"],\"scope_text\":\"Except as otherwise provided, for any reference in any provision of law to any community action agency designated under title II of the Economic Opportunity Act of 1964.\",\"section_id\":\"urn:rulespec:document-understanding:section:8a4e6d70ab56a073272f0b3d5540f6b1b55f6d1129769834787143ec0c1eecd9\",\"start\":110012,\"summary\":\"Except as otherwise provided, any reference in any provision of law to any community action agency designated under title II of the Economic Opportunity Act of 1964 must be construed to be a reference to an entity eligible to receive funds under the community services block grant program.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",
      "dcterms:references": [

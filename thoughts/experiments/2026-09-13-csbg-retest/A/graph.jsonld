    {
      "@id": "urn:rulespec:document-understanding:revision:6d25efb852f3b700424eae708a348cca810a26ca071fe87888668b64bf0a3b5a",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:6d25efb852f3b700424eae708a348cca810a26ca071fe87888668b64bf0a3b5a",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:180fba7df13e51fc7049c8c8b2d1d85057949b2b25bdb7431beb72da7a442726",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"Secretary\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:0c2daa7a9a4474d752610a5e9468ca1e504b5e82e064bf2350432c0b0719ea3e\",\"urn:rulespec:document-understanding:assertion:b0a1b763c22e69bed7a7bc6e2997245f2f16c7528a5bfae43deb329918d56275\",\"urn:rulespec:document-understanding:assertion:589fda0dec5f4351b1cb7aab326e320f80065f91ecc5d7a7b2310ee42afc5348\",\"urn:rulespec:document-understanding:assertion:c3849e12bafd020cbe321b4969693342fb9ad1788f2f297d3f10382fda987bcf\",\"urn:rulespec:document-understanding:assertion:29109ac8cc133dad4ccf9dc08a9622c3888bfb9f342fd47bcb113910f2f310a9\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":115713,\"evidence\":[{\"end\":114937,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:114893:114937:sha256-d89d82995e94ea0388116a77d5470661fcc901a9aa8bd14963e1097f8e3d8996\",\"quote\":\"(c) Programs directed to special populations\",\"start\":114893},{\"end\":115713,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:114939:115713:sha256-bc914a5d52ad8cc2bd0ce9128c30d54964bc79a27b7e74f99a7f4db83649975e\",\"quote\":\"(1) In addition to the grant programs described in subsection (a), the Secretary may make grants to community action agencies for the purpose of enabling such agencies to demonstrate new approaches to dealing with the problems caused by entrenched, chronic unemployment and lack of economic opportunities for urban youth. Demonstrations shall include such activities as peer counseling, mentoring, development of job skills, assistance with social skills, community services, family literacy, parenting skills, opportunities for employment or entrepreneurship, and other services designed to assist such at-risk youth to continue their education, to secure meaningful employment, to perform community service, or to pursue other productive alternatives within the community.\",\"start\":114939},{\"end\":115019,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:115010:115019:sha256-1395996a1068d26dcb8486df1e1db89b97a66f2ecf98d655defe059fcec4bd97\",\"quote\":\"Secretary\",\"start\":115010},{\"end\":115023,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:115020:115023:sha256-ee4d988c65de860fabbfbcd27f73d50bbebe3fba37fe419284f4811389c30bdc\",\"quote\":\"may\",\"start\":115020}],\"id\":\"urn:rulespec:document-understanding:revision:6d25efb852f3b700424eae708a348cca810a26ca071fe87888668b64bf0a3b5a\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"permission\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:c3849e12bafd020cbe321b4969693342fb9ad1788f2f297d3f10382fda987bcf\",\"modality\":\"may\",\"modality_quote\":\"may\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:35d2e2fa6e8545ca0d31227c1c5f314e4d33398c51deec00220b0fb3fd823ce7\",\"origin\":\"aiSuggested\",\"quote\":\"(c) Programs directed to special populations\\n\\n(1) In addition to the grant programs described in subsection (a), the Secretary may make grants to community action agencies for the purpose of enabling such agencies to demonstrate new approaches to dealing with the problems caused by entrenched, chronic unemployment and lack of economic opportunities for urban youth. Demonstrations shall include such activities as peer counseling, mentoring, development of job skills, assistance with social skills, community services, family literacy, parenting skills, opportunities for employment or entrepreneurship, and other services designed to assist such at-risk youth to continue their education, to secure meaningful employment, to perform community service, or to pursue other productive alternatives within the community.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:8959adc70f1d2822d78ab3ca1eff0b4ba99fbdfe87a1bc701071e6777e6e9434\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"urn:rulespec:document-understanding:section:5fba676d6775544d7cae048a3634eb9fe091aa0a96f2f732b41f08ff944d6890\",\"start\":114893,\"summary\":\"In addition to the grant programs described in section 9925(a), the Secretary may make grants to community action agencies for the purpose of enabling such agencies to demonstrate new approaches to dealing with the problems caused by entrenched, chronic unemployment and lack of economic opportunities for urban youth, which demonstrations must include such activities as peer counseling, mentoring, development of job skills, assistance with social skills, community services, family literacy, parenting skills, opportunities for employment or entrepreneurship, and other services designed to assist such at-risk youth to continue their education, secure meaningful employment, perform community service, or pursue other productive alternatives within the community.\",\"target_ids\":[],\"term_refs\":[\"urn:rulespec:document-understanding:term:c34823cba19ec45c3e7c0693ac9271e54d8940154d5fd8186d72962709e90ce2\"],\"typed_values\":[]}",
      "dcterms:references": [
        {
          "@id": "urn:rulespec:document-understanding:assertion:0c2daa7a9a4474d752610a5e9468ca1e504b5e82e064bf2350432c0b0719ea3e"

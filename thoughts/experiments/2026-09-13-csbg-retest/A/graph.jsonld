      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:states-definition",
      "rkaf:assertsValue": {
        "@value": "The term \"qualified charity\" means any organization: (I) that is (aa) described in section 501(c)(3) of title 26 and exempt from tax under section 501(a) of such title, (bb) an eligible entity, or (cc) a public housing agency as defined in section 1437a(b)(6) of this title; (II) that is certified by the appropriate State authority as meeting the requirements of clauses (iii) and (iv); and (III) if such organization is otherwise required to file a return under section 6033 of such title, that elects to treat the information required to be furnished by clause (v) as being specified in section 6033(b) of such title.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

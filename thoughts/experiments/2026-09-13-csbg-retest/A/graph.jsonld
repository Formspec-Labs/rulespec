922:103245:sha256-d7254c289de9c41eca3b169e419bf7d5f035c77f520a5f544bd031064d6db065\",\"quote\":\"(1) a list of grant recipients;\\n\\n(2) information on the amount of funding awarded to each grant recipient; and\\n\\n(3) a summary of the activities performed by the grant recipients with funding awarded under this section and a description of the manner in which such activities meet the objectives described in subsection (a).\",\"start\":102922},{\"end\":102669,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:102660:102669:sha256-1395996a1068d26dcb8486df1e1db89b97a66f2ecf98d655defe059fcec4bd97\",\"quote\":\"Secretary\",\"start\":102660},{\"end\":102633,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:102623:102633:sha256-ac4d70219ac88293e98f7ab8bfa2711d5b5545111568ddbae0cdf81bb2aec9de\",\"quote\":\"(c) Report\",\"start\":102623},{\"end\":102920,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:102634:102920:sha256-15ba2128cb386150c64630b9cb643fdf584b71427403b5f4af252cf8ac82f599\",\"quote\":\"For each fiscal year, the Secretary shall prepare and submit, to the Committee on Education and the Workforce of the House of Representatives and the Committee on Labor and Human Resources of the Senate, a report concerning the grants made under this section. Such report shall include—\",\"start\":102634}],\"id\":\"urn:rulespec:document-understanding:revision:af8bca5de5acab75b7b60d42d5010dd95f67a9b4f042730c74aec20a1e7aef02\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:3a8c4105737459290e7e89a3c05b0e473d27bbe0000f4028c875a3f342737012\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:ef179507a5226919c04ffca19a04c4da810ac918c3d4cea34bba17fd8e70f1f3\",\"origin\":\"aiSuggested\",\"quote\":\"(c) Report For each fiscal year, the Secretary shall prepare and submit, to the Committee on Education and the Workforce of the House of Representatives and the Committee on Labor and Human Resources of the Senate, a report concerning the grants made under this section. Such report shall include—\\n\\n(1) a list of grant recipients;\\n\\n(2) information on the amount of funding awarded to each grant recipient; and\\n\\n(3) a summary of the activities performed by the grant recipients with funding awarded under this section and a description of the manner in which such activities meet the objectives described in subsection (a).\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:9a36338c93d3dc5744b8b8b7983ddfcc1f1b965d7a73a4c65b9b52f3a63e203f\",\"scope_quotes\":[\"(c) Report For each fiscal year, the Secretary shall prepare and submit, to the Committee on Education and the Workforce of the House of Representatives and the Committee on Labor and Human Resources of the Senate, a report concerning the grants made under this section. Such report shall include—\"],\"scope_text\":\"For each fiscal year.\",\"section_id\":\"urn:rulespec:document-understanding:section:cad1a9ce814f7bc8d23a6ff48e1865a684b16830bcf049a10118a7b6cab89b15\",\"start\":102623,\"summary\":\"For each fiscal year, the Secretary must prepare and submit, to the Committee on Education and the Workforce of the House of Representatives and the Committee on Labor and Human Resources of the Senate, a report concerning the grants made under section 9922, including: (1) a list of grant recipients; (2) information on the amount of funding awarded to each grant recipient; and (3) a summary of the activities performed by the grant recipients with funding awarded under this section and a description of the manner in which such activities meet the objectives described in subsection (a).\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

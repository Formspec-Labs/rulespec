    {
      "@id": "urn:rulespec:document-understanding:revision:35c6590b6e2f8e457d8eb954e687475c06183c17335a738ba8653a429ff83089",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:35c6590b6e2f8e457d8eb954e687475c06183c17335a738ba8653a429ff83089",

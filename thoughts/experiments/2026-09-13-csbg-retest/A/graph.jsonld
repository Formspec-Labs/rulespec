      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"Secretary\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:f5e0e678cef10f2e621af93fe7766c4a12747d27a17f311b328612235a0cff91\",\"urn:rulespec:document-understanding:assertion:d57eacb30910ba508ad147914bcb761686f327b3d19ceece98d2c784d3ffec61\",\"urn:rulespec:document-understanding:assertion:aadb26d4e3c13ff561d2e52b88ea531d631bb8ece9f4dc7ef1342f9ec88f44a6\",\"urn:rulespec:document-understanding:assertion:c6533aee8c445b87471f46075bb4a05191305353bc705c25b02489b2fc4a48a6\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":99205,\"evidence\":[{\"end\":98581,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:98571:98581:sha256-851b36e7dd69092e8308cf5053adc86e7fbac2f89f8d3476a4c6f93d78ee38f1\",\"quote\":\"(a) Grants\",\"start\":98571},{\"end\":98728,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:98582:98728:sha256-3e44541ba46f3b6e5167bcf04943f1481d6438476f784ef2596af5fe8aa1c9c8\",\"quote\":\"The Secretary may, through grants to public and private, nonprofit agencies, provide for community-based, local, statewide, and national programs—\",\"start\":98582},{\"end\":99205,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:98730:99205:sha256-414e1d6d3cc8ff6fa3a83764a8fc7914796458316b653657ef8b8ee0e746b5dd\",\"quote\":\"(1) to coordinate private and public food assistance resources, wherever the grant recipient involved determines such coordination to be inadequate, to better serve low-income populations;\\n\\n(2) to assist low-income communities to identify potential sponsors of child nutrition programs and to initiate such programs in underserved or unserved areas; and\\n\\n(3) to develop innovative approaches at the State and local level to meet the nutrition needs of low-income individuals.\",\"start\":98730},{\"end\":98595,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:98586:98595:sha256-1395996a1068d26dcb8486df1e1db89b97a66f2ecf98d655defe059fcec4bd97\",\"quote\":\"Secretary\",\"start\":98586},{\"end\":98599,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:98596:98599:sha256-ee4d988c65de860fabbfbcd27f73d50bbebe3fba37fe419284f4811389c30bdc\",\"quote\":\"may\",\"start\":98596}],\"id\":\"urn:rulespec:document-understanding:revision:0c459f8daaef747674e76352400bdee64e7cfeb64cae9f69e0e4fad347ed3da5\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"permission\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:c6533aee8c445b87471f46075bb4a05191305353bc705c25b02489b2fc4a48a6\",\"modality\":\"may\",\"modality_quote\":\"may\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:052b52d47a0910c24e038d26d4cf72eb49a4f1689ab84fa804ec55fc1b2348d4\",\"origin\":\"aiSuggested\",\"quote\":\"(a) Grants The Secretary may, through grants to public and private, nonprofit agencies, provide for community-based, local, statewide, and national programs—\\n\\n(1) to coordinate private and public food assistance resources, wherever the grant recipient involved determines such coordination to be inadequate, to better serve low-income populations;\\n\\n(2) to assist low-income communities to identify potential sponsors of child nutrition programs and to initiate such programs in underserved or unserved areas; and\\n\\n(3) to develop innovative approaches at the State and local level to meet the nutrition needs of low-income individuals.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:4e060590d0533f28b71c4074aa420fe9a7f63f651eacd6bca77535b3b9fa2b87\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"urn:rulespec:document-understanding:section:cad1a9ce814f7bc8d23a6ff48e1865a684b16830bcf049a10118a7b6cab89b15\",\"start\":98571,\"summary\":\"The Secretary may, through grants to public and private, nonprofit agencies, provide for community-based, local, statewide, and national programs: (1) to coordinate private and public food assistance resources, wherever the grant recipient involved determines such coordination to be inadequate, to better serve low-income populations; (2) to assist low-income communities to identify potential sponsors of child nutrition programs and to initiate such programs in underserved or unserved areas; and (3) to develop innovative approaches at the State and local level to meet the nutrition needs of low-income individuals.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

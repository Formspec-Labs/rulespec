      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:4ef366fcdc4f7fc5945e1f607c42ed5a8d6b0289bff8ce88c91fcf71bcc9f56e\",\"urn:rulespec:document-understanding:assertion:b7a99ddc5da3528d2f726cbb84958b7ba051d887b018cfa82b90f5eaf70d457e\",\"urn:rulespec:document-understanding:assertion:6b53fc5e134ed49a4b7b3744519480b45c95acd10cf42aa9dab3666e878ef643\",\"urn:rulespec:document-understanding:assertion:df213927c1aa685cdeff8fd718a454c52c616f17ef37d1474c9bc580e3e32d5c\",\"urn:rulespec:document-understanding:assertion:cf8310175ccfb3f85cff61849117ec41dfead365304cd579bc109a8cfd561ce2\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":23962,\"evidence\":[{\"end\":23611,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:23589:23611:sha256-bdf5844ed6de5f43d48472674c1204e025f22bbb7274e45b53b928c105477656\",\"quote\":\"(3) Maximum allotments\",\"start\":23589},{\"end\":23962,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:23613:23962:sha256-3e4bca4abd805d2b8ca0d251d9a1d2eca1ad7adb629a840df26d90cff8550967\",\"quote\":\"The amount allotted under paragraph (1) to a State for a fiscal year shall be reduced, if necessary, so that the aggregate amount allotted to such State under such paragraph and subsection (a) does not exceed 140 percent of the aggregate amount allotted to such State under the corresponding provisions of this chapter for the preceding fiscal year.\",\"start\":23613},{\"end\":23698,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:23682:23698:sha256-2e0d5676f46739fee1d103cee6c9bc6acdd5f02b14eee5e8688b90dd0ec1a042\",\"quote\":\"shall be reduced\",\"start\":23682},{\"end\":23962,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:23613:23962:sha256-3e4bca4abd805d2b8ca0d251d9a1d2eca1ad7adb629a840df26d90cff8550967\",\"quote\":\"The amount allotted under paragraph (1) to a State for a fiscal year shall be reduced, if necessary, so that the aggregate amount allotted to such State under such paragraph and subsection (a) does not exceed 140 percent of the aggregate amount allotted to such State under the corresponding provisions of this chapter for the preceding fiscal year.\",\"start\":23613}],\"id\":\"urn:rulespec:document-understanding:revision:7af6724cff9eeb9b40ab23fdea3a197126e1da294453047ab3f097054290bbbb\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:df213927c1aa685cdeff8fd718a454c52c616f17ef37d1474c9bc580e3e32d5c\",\"modality\":\"must\",\"modality_quote\":\"shall be reduced\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:bd4ea1489187cc307ae87dd4775c6c97beab1d825d77d695e87caffa39593ce7\",\"origin\":\"aiSuggested\",\"quote\":\"(3) Maximum allotments\\n\\nThe amount allotted under paragraph (1) to a State for a fiscal year shall be reduced, if necessary, so that the aggregate amount allotted to such State under such paragraph and subsection (a) does not exceed 140 percent of the aggregate amount allotted to such State under the corresponding provisions of this chapter for the preceding fiscal year.\",\"references\":[\"paragraph (1)\",\"subsection (a)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:d4d4420496b594e4b6af5ed11b70746c13733093da7b9135a5f1155fbb4c94b8\",\"scope_quotes\":[\"The amount allotted under paragraph (1) to a State for a fiscal year shall be reduced, if necessary, so that the aggregate amount allotted to such State under such paragraph and subsection (a) does not exceed 140 percent of the aggregate amount allotted to such State under the corresponding provisions of this chapter for the preceding fiscal year.\"],\"scope_text\":\"if necessary, so that the aggregate amount allotted to such State under such paragraph and subsection (a) does not exceed 140 percent of the aggregate amount allotted to such State under the corresponding provisions of this chapter for the preceding fiscal year\",\"section_id\":\"urn:rulespec:document-understanding:section:77b293a31882899a97687fe9cf87dc80be98be00fdc4957f7ebc1a1856d5f6c9\",\"start\":23589,\"summary\":\"The amount allotted under section 9906(b)(1) to a State for a fiscal year shall be reduced, if necessary, so that the aggregate amount allotted to such State under such paragraph and subsection (a) does not exceed 140 percent of the aggregate amount allotted to such State under the corresponding provisions of chapter 106 for the preceding fiscal year.\",\"target_ids\":[],\"term_refs\":[\"urn:rulespec:document-understanding:term:737b4a835a77703334e5da03eb8fc1a624a2cb0dd700298e37ccafb980c36609\"],\"typed_values\":[]}",

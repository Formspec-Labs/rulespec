      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "An organization meets the requirements of this clause only if the appropriate State authority reasonably expects that the annual poverty program expenses of such organization will not be less than 75 percent of the annual aggregate expenses of such organization."
        },

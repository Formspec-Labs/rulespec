      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:4633c72b9949e6d6951371bc0574fba50f8ba6a46700aec92d15b8c8b10c59fa",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:1ddeb6b4f93733a4c226fb5c5105c6676871030f792da9f04d6343c46af5d65d",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:8237a90e02af5a7ed0aae10d20f29b19deeb85a8f044fc7d419cab55f7cb8d35",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:states-requirement",
      "rkaf:assertsValue": {
        "@value": "Beginning with fiscal year 2000, to be eligible to receive a grant or allotment under section 9905 or 9906 of this title, a State shall prepare and submit to the Secretary an application and State plan covering a period of not less than 1 fiscal year and not more than 2 fiscal years, submitted not later than 30 days prior to the beginning of the first fiscal year covered by the plan, containing such information as the Secretary shall require, including the assurances and information specified in paragraphs (1) through (13).",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

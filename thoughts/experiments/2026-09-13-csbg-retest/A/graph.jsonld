      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:3c48a869f15a07b78317f28bba19d39e1cce42a1161b052e6727906990013d43\",\"urn:rulespec:document-understanding:assertion:486cfe552256f633bc868ed1701da6d68427809ebb801be06a534b6770255647\",\"urn:rulespec:document-understanding:assertion:49e717c504cb2ae8abcdb972a8c3e3284d4e9b9bc947202141e9081a6c73579a\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[\"The amounts reserved under section 9903(b)(2)(A) of this title for activities to be carried out under this subsection shall be distributed directly to eligible entities, organizations, or associations described in paragraph (2) for the purpose of improving program quality (including quality of financial management practices), management information and reporting systems, and measurement of program results, and for the purpose of ensuring responsiveness to identified local needs.\"],\"defined_terms\":[],\"effective_periods\":[],\"end\":65528,\"evidence\":[{\"end\":65528,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:65200:65528:sha256-d78821ab19d4a066e0b9050cd347dbafedd3066014b738daa8fffc90568e79e2\",\"quote\":\"Eligible entities, organizations, or associations described in this paragraph shall be eligible entities, or statewide or local organizations or associations, with demonstrated expertise in providing training to individuals and organizations on methods of effectively addressing the needs of low-income families and communities.\",\"start\":65200},{\"end\":65283,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:65278:65283:sha256-56ee5b508706bf2de91712d85d6d1e11ddbff01949142ed6e8c22e3b1bed1c71\",\"quote\":\"shall\",\"start\":65278},{\"end\":65142,\"field\":\"context:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:64659:65142:sha256-f7f288905beb2df93a8503d2962d1dff0d034ab5289bf7ecbed80d81effef490\",\"quote\":\"The amounts reserved under section 9903(b)(2)(A) of this title for activities to be carried out under this subsection shall be distributed directly to eligible entities, organizations, or associations described in paragraph (2) for the purpose of improving program quality (including quality of financial management practices), management information and reporting systems, and measurement of program results, and for the purpose of ensuring responsiveness to identified local needs.\",\"start\":64659}],\"id\":\"urn:rulespec:document-understanding:revision:6de4cdbbd9ab07f7a39d79790eed8bc46150e5d1b0f828f76d5881602c0ac9af\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:49e717c504cb2ae8abcdb972a8c3e3284d4e9b9bc947202141e9081a6c73579a\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:2a3ad2ecea10711e846ce6ad40e450b67aebde945063222c0e73ef2b3c920ddb\",\"origin\":\"aiSuggested\",\"quote\":\"Eligible entities, organizations, or associations described in this paragraph shall be eligible entities, or statewide or local organizations or associations, with demonstrated expertise in providing training to individuals and organizations on methods of effectively addressing the needs of low-income families and communities.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:76272414a02670d5984d1baf7a7e4805da3884be6cddc45b8bec1f863d6717cb\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"urn:rulespec:document-understanding:section:14940ce669f832206b65cbb2eca659f59bd1cde99a702e87cfeffc3340239793\",\"start\":65200,\"summary\":\"Eligible entities, organizations, or associations described in 42 U.S.C. 9913(c)(2) shall be eligible entities, or statewide or local organizations or associations, with demonstrated expertise in providing training to individuals and organizations on methods of effectively addressing the needs of low-income families and communities.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

      "dcterms:description": "{\"action\":\"\",\"actor\":\"Secretary\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:414c69f922d94b25eefebdc1dea6feac3abf3bfec2da904f7a610a73e8c7074c\",\"urn:rulespec:document-understanding:assertion:99393c623f7d1ffa3fe921d3c8ba47fb22cc31815be8e46fe5cb7c3c93597b7c\",\"urn:rulespec:document-understanding:assertion:204cc7bf8a17b4fd309f0a5fbc4637f2974195b6867a9c2aace2c78a2ce9ffb3\",\"urn:rulespec:document-understanding:assertion:2f0eba9bf7f31b1dd6024a3b049f2d04a9f94cb1f6b4dbde5c104cc37d38ad2b\",\"urn:rulespec:document-understanding:assertion:89557be68a9d036faaebc29d5f3bc69614ce4e74ba6b800ec4798263c8f4871a\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":104430,\"evidence\":[{\"end\":104103,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:104082:104103:sha256-6a9a815f8c8b800df1d4f740dbf04a67350da7591e0b8433c45a56a2bb949ed3\",\"quote\":\"(a) General authority\",\"start\":104082},{\"end\":104430,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:104105:104430:sha256-61ebaec3a7919bb5250a9559211394d7f7aafbda7d39f8cb3757049da272d832\",\"quote\":\"The Secretary is authorized to make a grant to an eligible service provider to administer national or regional programs to provide instructional activities for low-income youth. In making such a grant, the Secretary shall give priority to eligible service providers that have a demonstrated ability to operate such a program.\",\"start\":104105},{\"end\":104326,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfa
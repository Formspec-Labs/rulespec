      "dcterms:description": "{\"action\":\"\",\"actor\":\"a State\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:b2049e68065647d3cf1fb83aad305181cfba66ca045c060fd9d0f41db6c12f5b\",\"urn:rulespec:document-understanding:assertion:b7f6ba3deffba57156b95835c0c7be3595b8a20e533e1a5575085fd2af60ddb9\",\"urn:rulespec:document-understanding:assertion:d37ca3c7467782450a068ccb19b95973139f51ae098ef295b93c73560c566f87\",\"urn:rulespec:document-understanding:assertion:80fd9a911be11b5de699bd94e47bff479dc81ebb29a63cd959429a5a17e1cf96\",\"urn:rulespec:document-understanding:assertion:2265ff0663a4cfa54b1c2ec5801308c848eeeef1b4df8318867ccac6a346c05b\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":29238,\"evidence\":[{\"end\":29238,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:28907:29238:sha256-8551f8679b04539fbc5f81a293331c755a4e23bcf1a418d61b1c792e79915194\",\"quote\":\"The aggregate amount a State may use under paragraph (1) during a fiscal year shall not exceed 100 percent of the revenue loss of the State during the fiscal year that is attributable to the charity tax credit, as determined by the Secretary of the Treasury without regard to any such revenue loss occurring before January 1, 1999.\",\"start\":28907},{\"end\":28935,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:28928:28935:sha256-c178fdd744dfc1cc76caac454515b335da2f0b1008fe2c7653ec53a1e7a63255\",\"quote\":\"a State\",\"start\":28928},{\"end\":29001,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22
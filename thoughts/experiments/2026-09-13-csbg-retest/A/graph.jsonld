      "rkaf:assertsValue": {
        "@value": "{\"actor\":\"Secretary of Health and Human Services\",\"kind\":\"requirement\",\"modality\":\"must\",\"summary\":\"The Secretary of Health and Human Services shall take steps, consistent with law, to allow funds available through the Community Services Block Grant program to be used by grantees and eligible entities to provide emergency learning scholarships to disadvantaged families for use by any child without access to in-person learning, which scholarships may be used for tuition and fees for a private or parochial school; homeschool, microschool, or learning-pod costs; special education and related services, including therapies; or tutoring or remedial education.\",\"term_refs\":[\"urn:rulespec:document-understanding:term:609da2cab4326e363e5f445c4b18a0b7dafa3403032088b82b5e79a3af703c4e\"]}",
        "@type": "xsd:string"

    {
      "@id": "urn:rulespec:document-understanding:revision:28f9ac657a260bd0a2942638d0ce8a8db772e18d1da08dbabcbead536d2dc63a",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:28f9ac657a260bd0a2942638d0ce8a8db772e18d1da08dbabcbead536d2dc63a",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:bd7081b4ae6964b5d79f2eefdaae4b8adf870aa3105922d324ebd939f149f029",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"Secretary\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:1facd21a41d22ba66ad6b7df154660ea84421d9be82f6bd6b181913ffc7225d0\",\"urn:rulespec:document-understanding:assertion:730022d42aaeaf3340a8941d01b01cb1a627693f856894dac5608da80001ad70\",\"urn:rulespec:document-understanding:assertion:63b08b82f5a8708daf0946af6b61b8bc5c4ffcf8f2dd40954e25274684724ddd\",\"urn:rulespec:document-understanding:assertion:02728f4406871e1ff2a28941bfd3b3e58fba3448df1a85a00b9aee28e1816da5\",\"urn:rulespec:document-understanding:assertion:eb75f29ef31ea9226f02411cd4e76f48b62e4a9c39b90bf81026e026e7c9f514\",\"urn:rulespec:document-understanding:assertion:190ff1a7ff40f0f3217f7d0a960fe7e3e394bff9e36e05062e2e079f9ab87cd5\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":18751,\"evidence\":[{\"end\":17668,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:17652:17668:sha256-74fda605329d9b1ceb4fc23f202c17e0235b89f64f355a31862ab1a252852db2\",\"quote\":\"(b) Reservations\",\"start\":17652},{\"end\":17768,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:17669:17768:sha256-52e40889c206e95327235a9da3d28d4bc66f4b76274d478cbed27729f4c0dbe7\",\"quote\":\"Of the amounts appropriated under subsection (a) for each fiscal year, the Secretary shall reserve—\",\"start\":17669},{\"end\":17969,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:17770:17969:sha256-efae5c543dd8ff050e9e7b4135c1a0010d0f8390d462bedae86f6e571afdf702\",\"quote\":\"(1) ½ of 1 percent for carrying out section 9905 of this title (relating to payments for territories);\\n\\n(2) 1½ percent for activities authorized in sections 9913 through 9918 of this title, of which—\",\"start\":17770},{\"end\":18751,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:17971:18751:sha256-dade7893d44d9343bd1d998e690771171be569c891fe2ab774bc8695bc9e5673\",\"quote\":\"(A) not less than ½ of the amount reserved by the Secretary under this paragraph shall be distributed directly to eligible entities, organizations, or associations described in section 9913(c)(2) of this title for the purpose of carrying out activities described in section 9913(c) of this title; and\\n\\n(B) ½ of the remainder of the amount reserved by the Secretary under this paragraph shall be used by the Secretary to carry out evaluation and to assist States in carrying out corrective action activities and monitoring (to correct programmatic deficiencies of eligible entities), as described in sections 9914(c) and 9913 of this title; and\\n\\n\\n(3) 9 percent for carrying out section 9921 of this title (relating to discretionary activities) and section 9917(b)(2) of this title.\",\"start\":17971},{\"end\":17767,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:17754:17767:sha256-ff904b5ffa7e59c4a2d14eca2d6d26f5b9b225782228171f19f3e1255707e8a7\",\"quote\":\"shall reserve\",\"start\":17754},{\"end\":17668,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:17652:17668:sha256-74fda605329d9b1ceb4fc23f202c17e0235b89f64f355a31862ab1a252852db2\",\"quote\":\"(b) Reservations\",\"start\":17652},{\"end\":17768,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:17669:17768:sha256-52e40889c206e95327235a9da3d28d4bc66f4b76274d478cbed27729f4c0dbe7\",\"quote\":\"Of the amounts appropriated under subsection (a) for each fiscal year, the Secretary shall reserve—\",\"start\":17669}],\"id\":\"urn:rulespec:document-understanding:revision:28f9ac657a260bd0a2942638d0ce8a8db772e18d1da08dbabcbead536d2dc63a\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:eb75f29ef31ea9226f02411cd4e76f48b62e4a9c39b90bf81026e026e7c9f514\",\"modality\":\"must\",\"modality_quote\":\"shall reserve\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:284936cdd65b7c28d2bae8f22fe35e2b8d2ac82edfe099dcfc32ab977e0213dc\",\"origin\":\"aiSuggested\",\"quote\":\"(b) Reservations Of the amounts appropriated under subsection (a) for each fiscal year, the Secretary shall reserve—\\n\\n(1) ½ of 1 percent for carrying out section 9905 of this title (relating to payments for territories);\\n\\n(2) 1½ percent for activities authorized in sections 9913 through 9918 of this title, of which—\\n\\n(A) not less than ½ of the amount reserved by the Secretary under this paragraph shall be distributed directly to eligible entities, organizations, or associations described in section 9913(c)(2) of this title for the purpose of carrying out activities described in section 9913(c) of this title; and\\n\\n(B) ½ of the remainder of the amount reserved by the Secretary under this paragraph shall be used by the Secretary to carry out evaluation and to assist States in carrying out corrective action activities and monitoring (to correct programmatic deficiencies of eligible entities), as described in sections 9914(c) and 9913 of this title; and\\n\\n\\n(3) 9 percent for carrying out section 9921 of this title (relating to discretionary activities) and section 9917(b)(2) of this title.\",\"references\":[\"section 9903(a)\",\"section 9921\",\"section 9917(b)(2)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:fe69dd8add7e8d8493ad1f2eff48ec62e5e225b824288a1034ed30b31e172e3e\",\"scope_quotes\":[\"(b) Reservations Of the amounts appropriated under subsection (a) for each fiscal year, the Secretary shall reserve—\"],\"scope_text\":\"for each fiscal year\",\"section_id\":\"urn:rulespec:document-understanding:section:12fca79c614e56d4c2834f93ce1a7d98eff6aeadfd069e9f4c6aeffa5285544c\",\"start\":17652,\"summary\":\"Of the amounts appropriated under section 9903(a) of title 42 for each fiscal year, the Secretary shall reserve 9 percent for carrying out section 9921 of title 42 (relating to discretionary activities) and section 9917(b)(2) of title 42.\",\"target_ids\":[],\"term_refs\":[\"urn:rulespec:document-understanding:term:f4c9f84c522e2926470ee048e00856dd704855d4dcd8ecb6fa6c2d3ecf28658e\"],\"typed_values\":[]}",

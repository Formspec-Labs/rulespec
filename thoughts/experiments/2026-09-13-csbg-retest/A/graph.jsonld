      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:ba77683e21a4defab1ce98b1734507f7ecb4092618eac143f8d27f2dc00ecc6e\",\"urn:rulespec:document-understanding:assertion:e13f7576c50f44cc5a1413b3c9e78792d2dabeb2e470efa1053c261945193ad7\",\"urn:rulespec:document-understanding:assertion:0542d94c4538eeb564358d17d5a7b1c04ed2133a12c54ec63ee6c2b90157e48a\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":64610,\"evidence\":[{\"end\":64118,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:64076:64118:sha256-2099245815bb7b3e12b200c774121a9819dd415cec37a3f42061ec38d6164d08\",\"quote\":\"(b) Terms and technical assistance process\",\"start\":64076},{\"end\":64228,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:64119:64228:sha256-52882140d840111f4e85484a4f49440a838631804cf8b34dd55d7917278462eb\",\"quote\":\"The process for determining the training and technical assistance to be carried out under this section shall—\",\"start\":64119},{\"end\":64610,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:64230:64610:sha256-fecc9f400dcba65557e9213d4c2362435bc5d305033a30f49188ee700c22da82\",\"quote\":\"(1) ensure that the needs of eligible entities and programs relating to improving program quality (including quality of financial management practices) are addressed to the maximum extent feasible; and\\n\\n(2) incorporate mechanisms to ensure responsiveness to local needs, including an ongoing procedure for obtaining input from the national and State networks of eligible entities.\",\"start\":64230},{\"end\":64227,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:64222:64227:sha256-56ee5b508706bf2de91712d85d6d1e11ddbff01949142ed6e8c22e3b1bed1c71\",\"quote\":\"shall\",\"start\":64222}],\"id\":\"urn:rulespec:document-understanding:revision:9c46b086341ca7e7a7d72cf8e07705f04cd02b542055cbc4224407a99ea19bc0\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:0542d94c4538eeb564358d17d5a7b1c04ed2133a12c54ec63ee6c2b90157e48a\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:0ba62ee8ca062ddffc0e86ee2da4032d4182da2164f4e6b0e7b6366ca89f79bb\",\"origin\":\"aiSuggested\",\"quote\":\"(b) Terms and technical assistance process The process for determining the training and technical assistance to be carried out under this section shall—\\n\\n(1) ensure that the needs of eligible entities and programs relating to improving program quality (including quality of financial management practices) are addressed to the maximum extent feasible; and\\n\\n(2) incorporate mechanisms to ensure responsiveness to local needs, including an ongoing procedure for obtaining input from the national and State networks of eligible entities.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:cb0edcb96348733b273d1bf6c53b0f65115f3b33cfc4d5410ee0ac2924c32898\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"urn:rulespec:document-understanding:section:14940ce669f832206b65cbb2eca659f59bd1cde99a702e87cfeffc3340239793\",\"start\":64076,\"summary\":\"The process for determining the training and technical assistance to be carried out under section 9913 of title 42 shall: (1) ensure that the needs of eligible entities and programs relating to improving program quality (including quality of financial management practices) are addressed to the maximum extent feasible; and (2) incorporate mechanisms to ensure responsiveness to local needs, including an ongoing procedure for obtaining input from the national and State networks of eligible entities.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

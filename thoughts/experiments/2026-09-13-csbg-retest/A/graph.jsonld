    {
      "@id": "urn:rulespec:document-understanding:revision:9f3b720293dc22d0a000f07e930271df3ea843e793a2df8ef805e701cb082bd9",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:9f3b720293dc22d0a000f07e930271df3ea843e793a2df8ef805e701cb082bd9",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:13d8585cdb5d79c7f49002268ef78d211e37c215b682bb25b3245c7873fb62ff",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"the entity\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:3706f8f547d6a55a8442b60c22a8c2628dbc99d3748a0e64f5629aca65cf297f\",\"urn:rulespec:document-understanding:assertion:caa0947e5bcab5800ee24230c31e5162c65ab04b8ab46cadce0345908703e3b7\",\"urn:rulespec:document-understanding:assertion:a60a6eff5e868ff564e382fbc78a9126342cd3151c656072077e6adc83635f43\",\"urn:rulespec:document-understanding:assertion:b66cc2b56768d6a55918a482ad602152b17085e7f357b6b357897ab47a0799a5\",\"urn:rulespec:document-understanding:assertion:ed86544caa193164c78b3d137c2c4b0f5b4cb75b0d6a4d909ed6bd390cb0f5c5\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":57002,\"evidence\":[{\"end\":56043,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:56019:56043:sha256-635d39a00486dd019673ff23683c729e4ffa8e17ed0ee05e6faf4848f2b74009\",\"quote\":\"(b) Public organizations\",\"start\":56019},{\"end\":56247,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:56044:56247:sha256-62155a2e638af8f83f7b2cd79f5ebb241acbcac533a2c66c4a368b315ac06f68\",\"quote\":\"In order for a public organization to be considered to be an eligible entity for purposes of section 9902(1) of this title, the entity shall administer the community services block grant program through—\",\"start\":56044},{\"end\":56510,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:56249:56510:sha256-574acf5f01b7f5b1e34fd1d1119df1a65a32fc29008035e616a040b61f3aff7c\",\"quote\":\"(1) a tripartite board, which shall have members selected by the organization and shall be composed so as to assure that not fewer than ⅓ of the members are persons chosen in accordance with democratic selection procedures adequate to assure that these members—\",\"start\":56249},{\"end\":57002,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:56512:57002:sha256-058283b4c9b56d4b1f9fa6c9f6a51535a26b3c2bd2bd961a9d98fcaa155eb5fb\",\"quote\":\"(A) are representative of low-income individuals and families in the neighborhood served;\\n\\n(B) reside in the neighborhood served; and\\n\\n(C) are able to participate actively in the development, planning, implementation, and evaluation of programs funded under this chapter; or\\n\\n\\n(2) another mechanism specified by the State to assure decisionmaking and participation by low-income individuals in the development, planning, implementation, and evaluation of programs funded under this chapter.\",\"start\":56512},{\"end\":56178,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:56168:56178:sha256-607e0c7f5cf2a8a38ed6f7e5ed63d71442e20bef61cc9cc3e59c2ec8d4bb0545\",\"quote\":\"the entity\",\"start\":56168},{\"end\":56043,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:56019:56043:sha256-635d39a00486dd019673ff23683c729e4ffa8e17ed0ee05e6faf4848f2b74009\",\"quote\":\"(b) Public organizations\",\"start\":56019},{\"end\":56247,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:56044:56247:sha256-62155a2e638af8f83f7b2cd79f5ebb241acbcac533a2c66c4a368b315ac06f68\",\"quote\":\"In order for a public organization to be considered to be an eligible entity for purposes of section 9902(1) of this title, the entity shall administer the community services block grant program through—\",\"start\":56044}],\"id\":\"urn:rulespec:document-understanding:revision:9f3b720293dc22d0a000f07e930271df3ea843e793a2df8ef805e701cb082bd9\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:ed86544caa193164c78b3d137c2c4b0f5b4cb75b0d6a4d909ed6bd390cb0f5c5\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:5f99a04a536c4a318677143732078d42cbafe3beafc05d7a909a7e59d2e8128c\",\"origin\":\"aiSuggested\",\"quote\":\"(b) Public organizations In order for a public organization to be considered to be an eligible entity for purposes of section 9902(1) of this title, the entity shall administer the community services block grant program through—\\n\\n(1) a tripartite board, which shall have members selected by the organization and shall be composed so as to assure that not fewer than ⅓ of the members are persons chosen in accordance with democratic selection procedures adequate to assure that these members—\\n\\n(A) are representative of low-income individuals and families in the neighborhood served;\\n\\n(B) reside in the neighborhood served; and\\n\\n(C) are able to participate actively in the development, planning, implementation, and evaluation of programs funded under this chapter; or\\n\\n\\n(2) another mechanism specified by the State to assure decisionmaking and participation by low-income individuals in the development, planning, implementation, and evaluation of programs funded under this chapter.\",\"references\":[\"section 9902(1)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:2c44c127017c4c9655e019830f1fce02835d85b578ba5357c60b5211fbac0228\",\"scope_quotes\":[\"(b) Public organizations In order for a public organization to be considered to be an eligible entity for purposes of section 9902(1) of this title, the entity shall administer the community services block grant program through—\"],\"scope_text\":\"In order for a public organization to be considered to be an eligible entity for purposes of section 9902(1) of this title\",\"section_id\":\"urn:rulespec:document-understanding:section:e86efa42546ebfabc5a45ab5fdacdad8192ede5d781723b46383a2f15e9b7f09\",\"start\":56019,\"summary\":\"In order for a public organization to be considered to be an eligible entity for purposes of section 9902(1) of title 42, the entity shall administer the community services block grant program through either: (1) a tripartite board, which shall have members selected by the organization and shall be composed so as to assure that not fewer than ⅓ of the members are persons chosen in accordance with democratic selection procedures adequate to assure that these members are representative of low-income individuals and families in the neighborhood served, reside in the neighborhood served, and are able to participate actively in the development, planning, implementation, and evaluation of programs funded under chapter 106; or (2) another mechanism specified by the State to assure decisionmaking and participation by low-income individuals in the development, planning, implementation, and evaluation of programs funded under chapter 106.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",
      "dcterms:references": [

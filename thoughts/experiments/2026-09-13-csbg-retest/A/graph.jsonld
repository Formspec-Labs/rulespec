      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:states-requirement",
      "rkaf:assertsValue": {
        "@value": "Grants under section 9925(c) may be made only with respect to applications that: (A) identify and describe the population to be served, the problems to be addressed, the overall approach and methods of outreach and recruitment to be used, and the services to be provided; (B) describe how the approach to be used differs from other approaches used for the population to be served by the project; (C) describe the objectives of the project and contain a plan for measuring progress toward meeting those objectives; and (D) contain assurances that the grantee will report on the progress and results of the demonstration at such times and in such manner as the Secretary shall require.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

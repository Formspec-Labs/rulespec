      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:4633c72b9949e6d6951371bc0574fba50f8ba6a46700aec92d15b8c8b10c59fa",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:772912910f25c3b018f6b2b9d0d9f52575d2682e55f10e3ebc6f00b827dd5dfd",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:4a5b633ee72e34b94327f129082bcb6af9ec1f19320417a045e3b1cb82c735cc",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"actor\":\"the Secretary\",\"kind\":\"requirement\",\"modality\":\"must\",\"scope_text\":\"If, with respect to any State, the Secretary— (1) receives a request from the governing body of an Indian tribe or tribal organization within the State that assistance under this chapter be made directly to such tribe or organization; and (2) determines that the members of such tribe or tribal organization would be better served by means of grants made directly to provide benefits under this chapter\",\"summary\":\"If, with respect to any State, the Secretary receives a request from the governing body of an Indian tribe or tribal organization within the State that assistance under chapter 106 of title 42 be made directly to such tribe or organization, and determines that the members of such tribe or tribal organization would be better served by means of grants made directly to provide benefits under chapter 106, the Secretary shall reserve from amounts that would otherwise be allotted to such State under section 9906 of title 42 for the fiscal year the amount determined under 42 U.S.C. 9911(b).\",\"term_refs\":[\"urn:rulespec:document-understanding:term:be208b5fb6ddd45aa2cd6341bd365708cad1f86d8514c718263e4e43b937e694\"]}",
        "@type": "xsd:string"
      },

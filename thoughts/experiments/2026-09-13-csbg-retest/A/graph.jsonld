      "rkaf:applicabilityCondition": "Beginning with fiscal year 2000, to be eligible to receive a grant or allotment under section 9905 or 9906 of this title"
    },
    {
      "@id": "urn:rulespec:document-understanding:assertion:308cc4dbe40627fddf1bc8400fe93cd01c58e11a4bf73a571a16d6c321e76ad3",

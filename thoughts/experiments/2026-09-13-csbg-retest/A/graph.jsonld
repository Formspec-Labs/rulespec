    {
      "@id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:68284:68665:sha256-2bd94d684e3542cfb70726d612ccd37955e615f0fc0c805729f83b029a200513",
      "@type": "rkaf:SourceFragment",
      "oa:hasSource": "urn:rulespec:document-understanding:document:26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023",
      "rkaf:fragmentIdentityScheme": "rkaf:carrier-local-fragment",
      "rkaf:sourceArtifactDigest": "sha256:26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023",
      "rkaf:fragmentContentDigest": "sha256:2bd94d684e3542cfb70726d612ccd37955e615f0fc0c805729f83b029a200513",
      "rkaf:selectorKind": [
        "oa:TextQuoteSelector",
        "oa:TextPositionSelector"
      ],
      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "If the State determines, on the basis of a final decision in a review pursuant to section 9914 of this title, that an eligible entity fails to comply with the terms of an agreement, or the State plan, to provide services under this chapter or to meet appropriate standards, goals, and other requirements established by the State (including performance objectives), the State shall—"
        },
        {
          "@type": "oa:TextPositionSelector",
          "oa:start": 68284,
          "oa:end": 68665,
          "rkaf:coordinateSystem": "rkaf:unicode-codepoint"
        }
      ]
    },
    {
      "@id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:68667:68779:sha256-cbdedc079c86a26642d45157f0061ec4b8d1bf21640333cff4d072d91f3656de",
      "@type": "rkaf:SourceFragment",
      "oa:hasSource": "urn:rulespec:document-understanding:document:26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023",
      "rkaf:fragmentIdentityScheme": "rkaf:carrier-local-fragment",
      "rkaf:sourceArtifactDigest": "sha256:26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023",
      "rkaf:fragmentContentDigest": "sha256:cbdedc079c86a26642d45157f0061ec4b8d1bf21640333cff4d072d91f3656de",
      "rkaf:selectorKind": [
        "oa:TextQuoteSelector",
        "oa:TextPositionSelector"
      ],
      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "(1) inform the entity of the deficiency to be corrected;\n\n(2) require the entity to correct the deficiency;\n\n(3)"
        },
        {
          "@type": "oa:TextPositionSelector",
          "oa:start": 68667,
          "oa:end": 68779,
          "rkaf:coordinateSystem": "rkaf:unicode-codepoint"
        }

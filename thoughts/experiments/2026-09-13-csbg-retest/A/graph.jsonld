      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:1ddeb6b4f93733a4c226fb5c5105c6676871030f792da9f04d6343c46af5d65d",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:ec2f4f32e4b12ee67ec7a6dce48b4d86365e2627330b8564f51bce8887bac73b",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"kind\":\"statement\",\"modality\":\"not_stated\",\"scope_text\":\"In the case of a State that has a constitutional requirement of tax uniformity and that, as of December 31, 1997, imposed a tax on personal income with a single flat rate applicable to all earned and unearned income (except insofar as any amount is not taxed pursuant to tax forgiveness provisions) and no generally available exemptions or deductions to individuals\",\"summary\":\"In the case of a State that has a constitutional requirement of tax uniformity and that, as of December 31, 1997, imposed a tax on personal income with a single flat rate applicable to all earned and unearned income (except insofar as any amount is not taxed pursuant to tax forgiveness provisions) and no generally available exemptions or deductions to individuals, the requirement of paragraph (2) shall be treated as met if the amount of the credit described in paragraph (2) is limited to a uniform percentage (but not greater than 25 percent) of State personal income tax liability (determined without regard to credits).\"}",
        "@type": "xsd:string"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed",

        "@value": "{\"kind\":\"requirement\",\"modality\":\"must\",\"scope_text\":\"Except as otherwise provided, for any reference in any provision of law to any community action agency designated under title II of the Economic Opportunity Act of 1964.\",\"summary\":\"Except as otherwise provided, any reference in any provision of law to any community action agency designated under title II of the Economic Opportunity Act of 1964 must be construed to be a reference to an entity eligible to receive funds under the community services block grant program.\"}",
        "@type": "xsd:string"
      },

      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:3ce140edb15721144f185ea7f7ea2e5820928cf33bc9574fc43729dae8c82b4d\",\"urn:rulespec:document-understanding:assertion:2065eff56484a6dd0d6af7399f8226cc9da74b809af06ed69b05a92d64bdc49e\",\"urn:rulespec:document-understanding:assertion:6b965d282304d26afe7eee0e9463f2b589b8f3de403def67a641cd53e1ec7327\",\"urn:rulespec:document-understanding:assertion:5e8e987c573de360578d8093d77e5551c11ff84795c88491c638582edce2f0e2\",\"urn:rulespec:document-understanding:assertion:89b2a1da5e52efcf40c7e6010b171e9429b4f3441accb9f0f2aeb4525016b943\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[{\"aliases\":[],\"id\":\"urn:rulespec:document-understanding:term:609da2cab4326e363e5f445c4b18a0b7dafa3403032088b82b5e79a3af703c4e\",\"label\":\"eligible entity\",\"quote\":\"(A) Eligible entity The term “eligible entity” means an entity—\\n\\n(i) that is an eligible entity described in paragraph (1) (as in effect on the day before October 27, 1998) as of the day before October 27, 1998, or is designated by the process described in section 9909 of this title (including an organization serving migrant or seasonal farmworkers that is so described or designated); and\\n\\n(ii) that has a tripartite board or other mechanism described in subsection (a) or (b), as appropriate, of section 9910 of this title.\",\"source_quotes\":[\"(A) Eligible entity The term “eligible entity” means an entity—\\n\\n(i) that is an eligible entity described in paragraph (1) (as in effect on the day before October 27, 1998) as of the day before October 27, 1998, or is designated by the process described in section 9909 of this title (including an organization serving migrant or seasonal farmworkers that is so described or designated); and\\n\\n(ii) that has a tripartite board or other mechanism described in subsection (a) or (b), as appropriate, of section 9910 of this title.\"]}],\"effective_periods\":[],\"end\":15066,\"evidence\":[{\"end\":14558,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:14539:14558:sha256-de8d503a8d217c241ef3a7904d48881c6df66c6f594e26c9ca8b7b281ca97720\",\"quote\":\"(A) Eligible entity\",\"start\":14539},{\"end\":14602,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:14559:14602:sha256-f02f192d85a43f5535bd894abf8ea6f011295f617ccb4c3ca4c6cc36343d8efd\",\"quote\":\"The term “eligible entity” means an entity—\",\"start\":14559},{\"end\":15066,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:14604:15066:sha256-98f708d1b919c746f774e2d32cec4deab1032fb8d9783753c6e136fb09c284bb\",\"quote\":\"(i) that is an eligible entity described in paragraph (1) (as in effect on the day before October 27, 1998) as of the day before October 27, 1998, or is designated by the process described in section 9909 of this title (including an organization serving migrant or seasonal farmworkers that is so described or designated); and\\n\\n(ii) that has a tripartite board or other mechanism described in subsection (a) or (b), as appropriate, of section 9910 of this title.\",\"start\":14604},{\"end\":14490,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:14474:14490:sha256-6ef26080ba5b156360ab82a0af83047ddb9f669fc217c8e473039fb3c28c162d\",\"quote\":\"In this chapter:\",\"start\":14474},{\"end\":14558,\"field\":\"defined_terms:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:14539:14558:sha256-de8d503a8d217c241ef3a7904d48881c6df66c6f594e26c9ca8b7b281ca97720\",\"quote\":\"(A) Eligible entity\",\"start\":14539},{\"end\":14602,\"field\":\"defined_terms:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:14559:14602:sha256-f02f192d85a43f5535bd894abf8ea6f011295f617ccb4c3ca4c6cc36343d8efd\",\"quote\":\"The term “eligible entity” means an entity—\",\"start\":14559},{\"end\":15066,\"field\":\"defined_terms:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:14604:15066:sha256-98f708d1b919c746f774e2d32cec4deab1032fb8d9783753c6e136fb09c284bb\",\"quote\":\"(i) that is an eligible entity described in paragraph (1) (as in effect on the day before October 27, 1998) as of the day before October 27, 1998, or is designated by the process described in section 9909 of this title (including an organization serving migrant or seasonal farmworkers that is so described or designated); and\\n\\n(ii) that has a tripartite board or other mechanism described in subsection (a) or (b), as appropriate, of section 9910 of this title.\",\"start\":14604},{\"end\":14558,\"field\":\"defined_terms:0:source:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:14539:14558:sha256-de8d503a8d217c241ef3a7904d48881c6df66c6f594e26c9ca8b7b281ca97720\",\"quote\":\"(A) Eligible entity\",\"start\":14539},{\"end\":14602,\"field\":\"defined_terms:0:source:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:14559:14602:sha256-f02f192d85a43f5535bd894abf8ea6f011295f617ccb4c3ca4c6cc36343d8efd\",\"quote\":\"The term “eligible entity” means an entity—\",\"start\":14559},{\"end\":15066,\"field\":\"defined_terms:0:source:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:14604:15066:sha256-98f708d1b919c746f774e2d32cec4deab1032fb8d9783753c6e136fb09c284bb\",\"quote\":\"(i) that is an eligible entity described in paragraph (1) (as in effect on the day before October 27, 1998) as of the day before October 27, 1998, or is designated by the process described in section 9909 of this title (including an organization serving migrant or seasonal farmworkers that is so described or designated); and\\n\\n(ii) that has a tripartite board or other mechanism described in subsection (a) or (b), as appropriate, of section 9910 of this title.\",\"start\":14604}],\"id\":\"urn:rulespec:document-understanding:revision:c34b45691b9cdc8f804501117262b9f49d56690b400df7e5cdecafd08b7a8c3e\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"definition\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:5e8e987c573de360578d8093d77e5551c11ff84795c88491c638582edce2f0e2\",\"modality\":\"not_stated\",\"modality_quote\":\"\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:d05306b9a94d175640e991f60a6e0462227403abca14969a8972ea2cb0efcbec\",\"origin\":\"aiSuggested\",\"quote\":\"(A) Eligible entity The term “eligible entity” means an entity—\\n\\n(i) that is an eligible entity described in paragraph (1) (as in effect on the day before October 27, 1998) as of the day before October 27, 1998, or is designated by the process described in section 9909 of this title (including an organization serving migrant or seasonal farmworkers that is so described or designated); and\\n\\n(ii) that has a tripartite board or other mechanism described in subsection (a) or (b), as appropriate, of section 9910 of this title.\",\"references\":[\"section 9909\",\"section 9910\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:22d2bbaf3b7d07010ed02aa2bab0d7dcdf9e0ed91548583a4a704a1dc6f55393\",\"scope_quotes\":[\"In this chapter:\"],\"scope_text\":\"In this chapter\",\"section_id\":\"urn:rulespec:document-understanding:section:9a5224c808327e88c75f83b7cee8be31a7428e0086505e2dd784698ca11dd1d8\",\"start\":14539,\"summary\":\"In chapter 106, \\\"eligible entity\\\" means an entity that is an eligible entity described in paragraph (1) (as in effect on the day before October 27, 1998) as of the day before October 27, 1998, or is designated by the process described in section 9909 of title 42 (including an organization serving migrant or seasonal farmworkers that is so described or designated), and that has a tripartite board or other mechanism described in subsection (a) or (b), as appropriate, of section 9910 of title 42.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

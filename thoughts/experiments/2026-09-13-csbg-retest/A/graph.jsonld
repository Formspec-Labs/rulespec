      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "(A) not less than ½ of the amount reserved by the Secretary under this paragraph shall be distributed directly to eligible entities, organizations, or associations described in section 9913(c)(2) of this title for the purpose of carrying out activities described in section 9913(c) of this title; and\n\n(B) ½ of the remainder of the amount reserved by the Secretary under this paragraph shall be used by the Secretary to carry out evaluation and to assist States in carrying out corrective action activities and monitoring (to correct programmatic deficiencies of eligible entities), as described in sections 9914(c) and 9913 of this title; and"
        },

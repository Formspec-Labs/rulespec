    {
      "@id": "urn:rulespec:document-understanding:assertion:72068c780a0c6102981bce1f1c59dd703e559f08a1c44b3f0cb4f6f52716b6ae",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:4633c72b9949e6d6951371bc0574fba50f8ba6a46700aec92d15b8c8b10c59fa",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:df5c9c33272f572be5ef6667e12aa9bfa633d43d9b64a49c8d8dec9dce4f0d97",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:8509889c253dbdd3162e97266212c190bf6d48ab38d7f3e586243a9c099ba248",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:states-requirement",
      "rkaf:assertsValue": {
        "@value": "The Secretary of Health and Human Services shall take steps, consistent with law, to allow funds available through the Community Services Block Grant program to be used by grantees and eligible entities to provide emergency learning scholarships to disadvantaged families for use by any child without access to in-person learning, which scholarships may be used for tuition and fees for a private or parochial school; homeschool, microschool, or learning-pod costs; special education and related services, including therapies; or tutoring or remedial education.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },
    {
      "@id": "urn:rulespec:document-understanding:binding:7c449d5cb550cba440bd1a21ad30dfaa0dd4b9e52beac9a6692441c30b48ba3a",
      "@type": "rkaf:EvidenceBinding",
      "rkaf:bindsAssertion": "urn:rulespec:document-understanding:assertion:72068c780a0c6102981bce1f1c59dd703e559f08a1c44b3f0cb4f6f52716b6ae",
      "rkaf:evidenceRole": "rkaf:textualEvidence",

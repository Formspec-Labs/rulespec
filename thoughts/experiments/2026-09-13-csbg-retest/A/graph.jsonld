    {
      "@id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:113488:114009:sha256-91261f5e78a3ec21e591e84c905799c930a4f61e1cd6881315a22bfe12cc2a6c",

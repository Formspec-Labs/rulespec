      "dcterms:description": "{\"action\":\"\",\"actor\":\"the chief executive officer of the State\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:0dbd648bc71b44ced5c95aaec7480fd4cdfab3352b38742ff5856eef4a24dc18\",\"urn:rulespec:document-understanding:assertion:2535732c8377e60f3aefcaa044e7e1f1905f2d85bae5381378a359cf09299989\",\"urn:rulespec:document-understanding:assertion:ddde106e82062b1a23abc1ce07a4155c758a920f3f5152ca9c85a3bf25772f09\",\"urn:rulespec:document-understanding:assertion:e96f57118369ed800ed6b53ea24eff9d9d1ab73595dec810acaf1d3fcf8c820a\",\"urn:rulespec:document-understanding:assertion:fd8f3da5ccab666901890a6ef6e19baf476656e7ed844f289a744c8c0763c4a0\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":52169,\"evidence\":[{\"end\":51374,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:51360:51374:sha256-cf4ae417d8281c48072a48750d2a58c3678e30cc403d581be91a252e93ff2139\",\"quote\":\"(1) In general\",\"start\":51360},{\"end\":51654,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:51375:51654:sha256-1ff456aebbdd31bfde1d560c0fd148ca3a61e07dc4ce5ab4a9f31227d959284a\",\"quote\":\"If any geographic area of a State is not, or ceases to be, served by an eligible entity under this chapter, and if the chief executive officer of the State decides to serve such area, the chief executive officer may solicit applications from, and designate as an eligible entity—\",\"start\":51375},{\"end\":52169,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:51656:52169:sha256-8438d0e0bc6aaf0d25eb143aadc74249369cfe55d494d1b77beff8fae58c04f5\",\"quote\":\"(A) a private nonprofit organization (which may include an eligible entity) that is geographically located in the unserved area, that is capable of providing a broad range of services designed to eliminate poverty and foster self-sufficiency, and that meets the requirements of this chapter; and\\n\\n(B) a private nonprofit eligible entity that is geographically located in an area contiguous to or within reasonable proximity of the unserved area and that is already providing related services in the unserved area.\",\"start\":51656},{\"end\":51530,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:51490:51530:sha256-ae37da72ec6c945fcc2b87618f96f1b627e8dc7caf21b2939583df04d11f0cef\",\"quote\":\"the chief executive officer of the State\",\"start\":51490},{\"end\":51374,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:51360:51374:sha256-cf4ae417d8281c48072a48750d2a58c3678e30cc403d581be91a252e93ff2139\",\"quote\":\"(1) In general\",\"start\":51360},{\"end\":51654,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:51375:51654:sha256-1ff456aebbdd31bfde1d560c0fd148ca3a61e07dc4ce5ab4a9f31227d959284a\",\"quote\":\"If any geographic area of a State is not, or ceases to be, served by an eligible entity under this chapter, and if the chief executive officer of the State decides to serve such area, the chief executive officer may solicit applications from, and designate as an eligible entity—\",\"start\":51375}],\"id\":\"urn:rulespec:document-understanding:revision:b16e429a920770f46b75fa5715cc3b44361a62ebc0ee4e59c4852acedf6f3ff9\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"permission\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:fd8f3da5ccab666901890a6ef6e19baf476656e7ed844f289a744c8c0763c4a0\",\"modality\":\"may\",\"modality_quote\":\"may\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:9315efbfb2e9672c9e3aad225b6388a6812c0ce06ea05fb7ac6a3da4f07443ef\",\"origin\":\"aiSuggested\",\"quote\":\"(1) In general If any geographic area of a State is not, or ceases to be, served by an eligible entity under this chapter, and if the chief executive officer of the State decides to serve such area, the chief executive officer may solicit applications from, and designate as an eligible entity—\\n\\n(A) a private nonprofit organization (which may include an eligible entity) that is geographically located in the unserved area, that is capable of providing a broad range of services designed to eliminate poverty and foster self-sufficiency, and that meets the requirements of this chapter; and\\n\\n(B) a private nonprofit eligible entity that is geographically located in an area contiguous to or within reasonable proximity of the unserved area and that is already providing related services in the unserved area.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:abad715a49a00ba64af05583809e0c8108a7b05feec208b34fa65d4edbfbcd38\",\"scope_quotes\":[\"(1) In general If any geographic area of a State is not, or ceases to be, served by an eligible entity under this chapter, and if the chief executive officer of the State decides to serve such area, the chief executive officer may solicit applications from, and designate as an eligible entity—\"],\"scope_text\":\"If any geographic area of a State is not, or ceases to be, served by an eligible entity under this chapter, and if the chief executive officer of the State decides to serve such area\",\"section_id\":\"urn:rulespec:document-understanding:section:b8000f1ee8341d7eccdb1b202ebee86bddd6c2a58344891bf3dfbc5b7909fb1a\",\"start\":51360,\"summary\":\"If any geographic area of a State is not, or ceases to be, served by an eligible entity under chapter 106 of title 42, and if the chief executive officer of the State decides to serve such area, the chief executive officer may solicit applications from, and designate as an eligible entity, either a private nonprofit organization (which may include an eligible entity) that is geographically located in the unserved area, that is capable of providing a broad range of services designed to eliminate poverty and foster self-sufficiency, and that meets the requirements of chapter 106, or a private nonprofit eligible entity that is geographically located in an area contiguous to or within reasonable proximity of the unserved area and that is already providing related services in the unserved area.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

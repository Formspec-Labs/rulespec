      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"eligible service provider\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:df77be19c7a47a04bce7da8ec55e41758a224f664eb2721f90aaf40a7332e5ba\",\"urn:rulespec:document-understanding:assertion:5801af78ec3be0fa948eec61a822ca110032498e4e852b3bf446ecf626e03698\",\"urn:rulespec:document-understanding:assertion:4ccc72789dd47c6bd9e002e5ff7405590f3b11c4d0301420aa3f4a27621a43d3\",\"urn:rulespec:document-understanding:assertion:56628ac0b1a940bbb9622cabdbe0c6880014ba09a0af425211e1388605e0555b\",\"urn:rulespec:document-understanding:assertion:ccb173daef46330a57e7014751fc6651c093b0af31bb568e5855208e009a00db\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":105709,\"evidence\":[{\"end\":104457,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:104433:104457:sha256-2886f1f4a0c8e4f5a4454f331cac3db1eed61025bec2e6541cdbdec28a4034b4\",\"quote\":\"(b) Program requirements\",\"start\":104433},{\"end\":104671,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:104458:104671:sha256-21991c51070fcc83a7dc1bd9a7c5bcb7fd9ced1b409e6a78be4cc6c3806defe8\",\"quote\":\"Any instructional activity carried out by an eligible service provider receiving a grant under this section shall be carried out on the campus of an institution of higher education (as defined in section 1141(a) 1\",\"start\":104458},{\"end\":104709,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:104673:104709:sha256-82a1f00ab9f241bcc5b63b8eff430fdb902e17c51a01d85e25a2659602172a39\",\"quote\":\"1 See References in Text note below.\",\"start\":104673},{\"end\":104743,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:104711:104743:sha256-aa1c30e07bc082cd004a9cb25fb3bba87c687e1455e3e43bc4b421f667128a54\",\"quote\":\" of title 20) and shall include—\",\"start\":104711},{\"end\":105709,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:104745:105709:sha256-ea557281d104f66326760c92bfb6c90b0e77374c91d29a33e14f63d98b506554\",\"quote\":\"(1) access to the facilities and resources of such an institution;\\n\\n(2) an initial medical examination and follow-up referral or treatment, without charge, for youth during their participation in such activity;\\n\\n(3) at least one nutritious meal daily, without charge, for participating youth during each day of participation;\\n\\n(4) high quality instruction in a variety of sports (that shall include swimming and that may include dance and any other high quality recreational activity) provided by coaches and teachers from institutions of higher education and from elementary and secondary schools (as defined in section 7801 of title 20); and\\n\\n(5) enrichment instruction and information on matters relating to the well-being of youth, to include educational opportunities and information on study practices, education for the prevention of drug and alcohol abuse, and information on health and nutrition, career opportunities, and family and job responsibilities.\",\"start\":104745},{\"end\":104565,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:104503:104565:sha256-a8db83f2f5ad73956a9687de4439e1225bfdb73a62926b65c0d9c75cc7ae27f2\",\"quote\":\"eligible service provider receiving a grant under this section\",\"start\":104503},{\"end\":104457,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:104433:104457:sha256-2886f1f4a0c8e4f5a4454f331cac3db1eed61025bec2e6541cdbdec28a4034b4\",\"quote\":\"(b) Program requirements\",\"start\":104433},{\"end\":104671,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:104458:104671:sha256-21991c51070fcc83a7dc1bd9a7c5bcb7fd9ced1b409e6a78be4cc6c3806defe8\",\"quote\":\"Any instructional activity carried out by an eligible service provider receiving a grant under this section shall be carried out on the campus of an institution of higher education (as defined in section 1141(a) 1\",\"start\":104458}],\"id\":\"urn:rulespec:document-understanding:revision:51e39729b1133d9fc0ca70dc880b945eeee69feab638eff478ccf1240bcb57a8\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:ccb173daef46330a57e7014751fc6651c093b0af31bb568e5855208e009a00db\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:8d81fa3b43d300a5ff81cc5aa8d0c0ba32e00aca474f026213e2d73b2cc29967\",\"origin\":\"aiSuggested\",\"quote\":\"(b) Program requirements Any instructional activity carried out by an eligible service provider receiving a grant under this section shall be carried out on the campus of an institution of higher education (as defined in section 1141(a) 1\\n\\n1 See References in Text note below.\\n\\n of title 20) and shall include—\\n\\n(1) access to the facilities and resources of such an institution;\\n\\n(2) an initial medical examination and follow-up referral or treatment, without charge, for youth during their participation in such activity;\\n\\n(3) at least one nutritious meal daily, without charge, for participating youth during each day of participation;\\n\\n(4) high quality instruction in a variety of sports (that shall include swimming and that may include dance and any other high quality recreational activity) provided by coaches and teachers from institutions of higher education and from elementary and secondary schools (as defined in section 7801 of title 20); and\\n\\n(5) enrichment instruction and information on matters relating to the well-being of youth, to include educational opportunities and information on study practices, education for the prevention of drug and alcohol abuse, and information on health and nutrition, career opportunities, and family and job responsibilities.\",\"references\":[\"20 U.S.C. 1141(a)\",\"20 U.S.C. 7801\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:e73b429892562bd53b6fae08db9f792a5bd1503f26e207388f609575cb034757\",\"scope_quotes\":[\"(b) Program requirements Any instructional activity carried out by an eligible service provider receiving a grant under this section shall be carried out on the campus of an institution of higher education (as defined in section 1141(a) 1\"],\"scope_text\":\"Applies to any instructional activity carried out by an eligible service provider receiving a grant under section 9923.\",\"section_id\":\"urn:rulespec:document-understanding:section:f3eea5347c895856895eee6edec328881bdec01acc0faf09e4d4dd77b2ba0a81\",\"start\":104433,\"summary\":\"Any instructional activity carried out by an eligible service provider receiving a grant under section 9923 must be carried out on the campus of an institution of higher education (as defined in section 1141(a) of title 20) and must include: (1) access to the facilities and resources of such an institution; (2) an initial medical examination and follow-up referral or treatment, without charge, for youth during their participation in such activity; (3) at least one nutritious meal daily, without charge, for participating youth during each day of participation; (4) high quality instruction in a variety of sports (which must include swimming and may include dance and any other high quality recreational activity) provided by coaches and teachers from institutions of higher education and from elementary and secondary schools (as defined in section 7801 of title 20); and (5) enrichment instruction and information on matters relating to the well-being of youth, including educational opportunities and information on study practices, education for the prevention of drug and alcohol abuse, and information on health and nutrition, career opportunities, and family and job responsibilities.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

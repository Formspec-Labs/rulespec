      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"the political subdivision\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:388c427fa6d72bbf1fb85fd4eb4aeefa2741d4cbbf87971dc62aa72f80e26aed\",\"urn:rulespec:document-understanding:assertion:941b1662193c2e36bfdbf500786f4837206ce930279c391467fda3f042788c37\",\"urn:rulespec:document-understanding:assertion:4525773298f3a581849323d2a27d954c9c4823a0d13943d50c746fa98bdbdab6\",\"urn:rulespec:document-understanding:assertion:af5c9ab55d5d9cd6985509cc02f406b15d14098907e333910465d98d97864c34\",\"urn:rulespec:document-understanding:assertion:ff5f6a5387ab3020fbb39be22261604f10cef40c38b9cb3ccd711542f8c3dd6b\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":53660,\"evidence\":[{\"end\":53660,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:53206:53660:sha256-ddb73ce1975e3100655a3d0112384d33e68535c9148ffc1c78d8f5179c67e1a1\",\"quote\":\"If no private, nonprofit organization is identified or determined to be qualified under subsection (a) to serve the unserved area as an eligible entity the chief executive officer may designate an appropriate political subdivision of the State to serve as an eligible entity for the area. In order to serve as the eligible entity for that area, the political subdivision shall have a board or other mechanism as required in section 9910(b) of this title.\",\"start\":53206},{\"end\":53576,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:53551:53576:sha256-dae92698511950d8a49507e6ebe47c8366d4c4145478fc5ea49212c8773f4d8e\",\"quote\":\"the political subdivision\",\"start\":53551},{\"end\":53582,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:53577:53582:sha256-56ee5b508706bf2de91712d85d6d1e11ddbff01949142ed6e8c22e3b1bed1c71\",\"quote\":\"shall\",\"start\":53577},{\"end\":53660,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:53206:53660:sha256-ddb73ce1975e3100655a3d0112384d33e68535c9148ffc1c78d8f5179c67e1a1\",\"quote\":\"If no private, nonprofit organization is identified or determined to be qualified under subsection (a) to serve the unserved area as an eligible entity the chief executive officer may designate an appropriate political subdivision of the State to serve as an eligible entity for the area. In order to serve as the eligible entity for that area, the political subdivision shall have a board or other mechanism as required in section 9910(b) of this title.\",\"start\":53206}],\"id\":\"urn:rulespec:document-understanding:revision:cf04c41f0697b319bd31bdaba546fe98d219b8c094c36adccd46411fef2ab750\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:ff5f6a5387ab3020fbb39be22261604f10cef40c38b9cb3ccd711542f8c3dd6b\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:4ff87c8f4e228eeba06adcf59b9cfc342a482df1c182475bec45c48f67b3c6d8\",\"origin\":\"aiSuggested\",\"quote\":\"If no private, nonprofit organization is identified or determined to be qualified under subsection (a) to serve the unserved area as an eligible entity the chief executive officer may designate an appropriate political subdivision of the State to serve as an eligible entity for the area. In order to serve as the eligible entity for that area, the political subdivision shall have a board or other mechanism as required in section 9910(b) of this title.\",\"references\":[\"section 9910(b)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:9cd2290d630dc84ac45ff37e1ae636fdf62d0002bbda9a0d684433df202ab7e7\",\"scope_quotes\":[\"If no private, nonprofit organization is identified or determined to be qualified under subsection (a) to serve the unserved area as an eligible entity the chief executive officer may designate an appropriate political subdivision of the State to serve as an eligible entity for the area. In order to serve as the eligible entity for that area, the political subdivision shall have a board or other mechanism as required in section 9910(b) of this title.\"],\"scope_text\":\"In order to serve as the eligible entity for that area\",\"section_id\":\"urn:rulespec:document-understanding:section:b8000f1ee8341d7eccdb1b202ebee86bddd6c2a58344891bf3dfbc5b7909fb1a\",\"start\":53206,\"summary\":\"In order to serve as the eligible entity for that area under 42 U.S.C. 9909(c), the political subdivision shall have a board or other mechanism as required in section 9910(b) of title 42.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

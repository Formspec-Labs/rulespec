      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"actor\":\"Secretary\",\"kind\":\"requirement\",\"modality\":\"must\",\"scope_text\":\"for each fiscal year that remains after the Secretary makes the reservations required in section 9903(b) of this title\",\"summary\":\"The Secretary shall, from the amount appropriated under section 9903(a) of title 42 for each fiscal year that remains after the Secretary makes the reservations required in section 9903(b) of title 42, allot to each State (subject to section 9911 of title 42) an amount bearing the same ratio to such remaining amount as the amount received by the State for fiscal year 1981 under section 2808 of title 42 bore to the total amount received by all States for fiscal year 1981 under such section, except that no State shall receive less than 1/4 of 1 percent of the amount appropriated under section 9903(a) for such fiscal year, and except as provided in subsection (b) of section 9906.\",\"term_refs\":[\"urn:rulespec:document-understanding:term:f4c9f84c522e2926470ee048e00856dd704855d4dcd8ecb6fa6c2d3ecf28658e\",\"urn:rulespec:document-understanding:term:737b4a835a77703334e5da03eb8fc1a624a2cb0dd700298e37ccafb980c36609\"]}",
        "@type": "xsd:string"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed",
      "rkaf:hasApplicability": "urn:rulespec:document-understanding:scope:e11f1990bdce416b66e66094b88cdf4af1586ed219eebc1690d44515b313e121"
    },

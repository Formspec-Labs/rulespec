      "rkaf:assertsValue": {
        "@value": "{\"actor\":\"Secretary\",\"kind\":\"requirement\",\"modality\":\"must\",\"scope_text\":\"When amounts appropriated for a fiscal year to carry out section 9922 are in excess of $6,000,000.\",\"summary\":\"If amounts appropriated for a fiscal year to carry out section 9922 exceed $6,000,000, the Secretary must use 40 percent of such excess to make grants under subsection (a) on a competitive basis to eligible agencies for local and statewide programs.\"}",
        "@type": "xsd:string"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed",

    {
      "@id": "urn:rulespec:document-understanding:revision:572b698c707aa58febdefc7bc2b4359b9dcdc2910863fd314ccf067f168d37ea",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:572b698c707aa58febdefc7bc2b4359b9dcdc2910863fd314ccf067f168d37ea",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:859dbeda20c14d28b6051952c8aeb9c8a60442be2cf7dbb0529c7bd4ccd7c289",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"The Secretary\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:6760c784c9eb65d9b059d08bcf9b776c830effef6c6d94bd9f86be45c03030e7\",\"urn:rulespec:document-understanding:assertion:71a5e5409922642bc5cc14a827cf7f00a74960f7af98bd3be8d0f483db4d5f55\",\"urn:rulespec:document-understanding:assertion:29f08ca51cd37b5e471ddf3c2bd71f750eacb0e3028c7615f857af53345c6617\",\"urn:rulespec:document-understanding:assertion:1490f9409129e9fcfe346d1249f1d1da53c24a0ba09132befc3131b71957cac1\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":67833,\"evidence\":[{\"end\":67833,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:66787:67833:sha256-6029fefdb7fae5c5b046e858a6ecbf3e689c9da8af5615d345e4ffce339968de\",\"quote\":\"The Secretary shall conduct in several States in each fiscal year evaluations (including investigations) of the use of funds received by the States under this chapter in order to evaluate compliance with the provisions of this chapter, and especially with respect to compliance with section 9908(b) of this title. The Secretary shall submit, to each State evaluated, a report containing the results of such evaluations, and recommendations of improvements designed to enhance the benefit and impact of the activities carried out with such funds for people in need. On receiving the report, the State shall submit to the Secretary a plan of action in response to the recommendations contained in the report. The results of the evaluations shall be submitted annually to the Chairperson of the Committee on Education and the Workforce of the House of Representatives and the Chairperson of the Committee on Labor and Human Resources of the Senate as part of the report submitted by the Secretary in accordance with section 9917(b)(2) of this title.\",\"start\":66787}],\"id\":\"urn:rulespec:document-understanding:revision:572b698c707aa58febdefc7bc2b4359b9dcdc2910863fd314ccf067f168d37ea\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:1490f9409129e9fcfe346d1249f1d1da53c24a0ba09132befc3131b71957cac1\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:e76b7f0fee8df38ef227aaf57cc13bb5e6f08eb67b1e23e5d3eb6eb16b93e72a\",\"origin\":\"aiSuggested\",\"quote\":\"The Secretary shall conduct in several States in each fiscal year evaluations (including investigations) of the use of funds received by the States under this chapter in order to evaluate compliance with the provisions of this chapter, and especially with respect to compliance with section 9908(b) of this title. The Secretary shall submit, to each State evaluated, a report containing the results of such evaluations, and recommendations of improvements designed to enhance the benefit and impact of the activities carried out with such funds for people in need. On receiving the report, the State shall submit to the Secretary a plan of action in response to the recommendations contained in the report. The results of the evaluations shall be submitted annually to the Chairperson of the Committee on Education and the Workforce of the House of Representatives and the Chairperson of the Committee on Labor and Human Resources of the Senate as part of the report submitted by the Secretary in accordance with section 9917(b)(2) of this title.\",\"references\":[\"section 9908(b)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:fbc4fced25c584079a90ce3bb1b070f243897dcd692582e99f35d9fd69e3aeb8\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"urn:rulespec:document-understanding:section:c0349af1123d989776fe253553df69642696cd32996dd791c280bdbf3d513641\",\"start\":66787,\"summary\":\"The Secretary shall conduct in several States in each fiscal year evaluations (including investigations) of the use of funds received by the States under chapter 106 of title 42 in order to evaluate compliance with the provisions of chapter 106, and especially with respect to compliance with section 9908(b) of title 42.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:46dc37b270d9b5fb00aa55eac7f3a8aa32b8dc073b1955c19cb10c5e5b7569fd\",\"urn:rulespec:document-understanding:assertion:736a52f4d6f93be797bf9516c0f1d04398408f8edeb3939ab2f8b38d712be78a\",\"urn:rulespec:document-understanding:assertion:4a8ac569644a9db7a133837df6ef1a32ca94ea2338a7760e02b531dff6d53b28\",\"urn:rulespec:document-understanding:assertion:5a867869d95e8ebfc94953d119691af85d75222468a6e8e778efaea616d4bb96\",\"urn:rulespec:document-understanding:assertion:f3f897e5b46a180df0282a1bbf580adbaca2a7adce2a501b354e5a3648fa8f40\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[{\"aliases\":[],\"id\":\"urn:rulespec:document-understanding:term:18197e44e9217e632771fc8cefe12121ae56acb89335f8400a39dbebe2f91f91\",\"label\":\"qualified charity\",\"quote\":\"(i) In general The term “qualified charity” means any organization—\\n\\n(I) that is—\\n\\n(aa) described in section 501(c)(3) of title 26 and exempt from tax under section 501(a) of such title;\\n\\n(bb) an eligible entity; or\\n\\n(cc) a public housing agency as defined in section 1437a(b)(6) of this title;\\n\\n\\n(II) that is certified by the appropriate State authority as meeting the requirements of clauses (iii) and (iv); and\\n\\n(III) if such organization is otherwise required to file a return under section 6033 of such title, that elects to treat the information required to be furnished by clause (v) as being specified in section 6033(b) of such title.\",\"source_quotes\":[\"(i) In general The term “qualified charity” means any organization—\",\"(I) that is—\",\"(aa) described in section 501(c)(3) of title 26 and exempt from tax under section 501(a) of such title;\",\"(bb) an eligible entity; or\",\"(cc) a public housing agency as defined in section 1437a(b)(6) of this title;\",\"(II) that is certified by the appropriate State authority as meeting the requirements of clauses (iii) and (iv); and\",\"(III) if such organization is otherwise required to file a return under section 6033 of such title, that elects to treat the information required to be furnished by clause (v) as being specified in section 6033(b) of such title.\"]}],\"effective_periods\":[],\"end\":30231,\"evidence\":[{\"end\":29602,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:29588:29602:sha256-5b7a5118168f01eb0c113c4a86fb8eaaf3152b12972bcf36b8bf52bf0f5a8c4f\",\"quote\":\"(i) In general\",\"start\":29588},{\"end\":29655,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:29603:29655:sha256-947a908ff611bf4a7f430a1379bde16cb4fe0df727943aaab8c2b2f6579d5e1f\",\"quote\":\"The term “qualified charity” means any organization—\",\"start\":29603},{\"end\":29669,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:29657:29669:sha256-d7b77f9839126bd88b3b4fc32031e3950006e7b20e147de8fcbc0ab8c4fc4f47\",\"quote\":\"(I) that is—\",\"start\":29657},{\"end\":30231,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:29671:30231:sha256-3f63541a313fcb71e1c1d47649398f75a1d9b0b64af1f53bbdf49fcf83df329f\",\"quote\":\"(aa) described in section 501(c)(3) of title 26 and exempt from tax under section 501(a) of such title;\\n\\n(bb) an eligible entity; or\\n\\n(cc) a public housing agency as defined in section 1437a(b)(6) of this title;\\n\\n\\n(II) that is certified by the appropriate State authority as meeting the requirements of clauses (iii) and (iv); and\\n\\n(III) if such organization is otherwise required to file a return under section 6033 of such title, that elects to treat the information required to be furnished by clause (v) as being specified in section 6033(b) of such title.\",\"start\":29671},{\"end\":29266,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:29241:29266:sha256-aea566b0f29d0189db01116b9bd6a1dbb8292c28864bce72d66471186cd8b70d\",\"quote\":\"(3) Definitions and rules\",\"start\":29241},{\"end\":29286,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:29267:29286:sha256-103364172e36659a4b1503f2ecc3d56d9fe9662da93756e0154f15470eb0b835\",\"quote\":\"In this subsection:\",\"start\":29267},{\"end\":29602,\"field\":\"defined_terms:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:29588:29602:sha256-5b7a5118168f01eb0c113c4a86fb8eaaf3152b12972bcf36b8bf52bf0f5a8c4f\",\"quote\":\"(i) In general\",\"start\":29588},{\"end\":29655,\"field\":\"defined_terms:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:29603:29655:sha256-947a908ff611bf4a7f430a1379bde16cb4fe0df727943aaab8c2b2f6579d5e1f\",\"quote\":\"The term “qualified charity” means any organization—\",\"start\":29603},{\"end\":29669,\"field\":\"defined_terms:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:29657:29669:sha256-d7b77f9839126bd88b3b4fc32031e3950006e7b20e147de8fcbc0ab8c4fc4f47\",\"quote\":\"(I) that is—\",\"start\":29657},{\"end\":30231,\"field\":\"defined_terms:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:29671:30231:sha256-3f63541a313fcb71e1c1d47649398f75a1d9b0b64af1f53bbdf49fcf83df329f\",\"quote\":\"(aa) described in section 501(c)(3) of title 26 and exempt from tax under section 501(a) of such title;\\n\\n(bb) an eligible entity; or\\n\\n(cc) a public housing agency as defined in section 1437a(b)(6) of this title;\\n\\n\\n(II) that is certified by the appropriate State authority as meeting the requirements of clauses (iii) and (iv); and\\n\\n(III) if such organization is otherwise required to file a return under section 6033 of such title, that elects to treat the information required to be furnished by clause (v) as being specified in section 6033(b) of such title.\",\"start\":29671},{\"end\":29602,\"field\":\"defined_terms:0:source:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:29588:29602:sha256-5b7a5118168f01eb0c113c4a86fb8eaaf3152b12972bcf36b8bf52bf0f5a8c4f\",\"quote\":\"(i) In general\",\"start\":29588},{\"end\":29655,\"field\":\"defined_terms:0:source:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:29603:29655:sha256-947a908ff611bf4a7f430a1379bde16cb4fe0df727943aaab8c2b2f6579d5e1f\",\"quote\":\"The term “qualified charity” means any organization—\",\"start\":29603},{\"end\":29669,\"field\":\"defined_terms:0:source:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:29657:29669:sha256-d7b77f9839126bd88b3b4fc32031e3950006e7b20e147de8fcbc0ab8c4fc4f47\",\"quote\":\"(I) that is—\",\"start\":29657},{\"end\":29774,\"field\":\"defined_terms:0:source:2\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:29671:29774:sha256-b5558da3f900d7591b2d5f17fa8675c01828fb875a2cf9324828a8f00b5c7f3a\",\"quote\":\"(aa) described in section 501(c)(3) of title 26 and exempt from tax under section 501(a) of such title;\",\"start\":29671},{\"end\":29803,\"field\":\"defined_terms:0:source:3\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:29776:29803:sha256-70e2d6cdf2553dd2fc4125f28a7d325dcfa81cfbfa531604507631307b13faf1\",\"quote\":\"(bb) an eligible entity; or\",\"start\":29776},{\"end\":29882,\"field\":\"defined_terms:0:source:4\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:29805:29882:sha256-6c50063cc85acc5f9ebec107c34ee4583ea70f9b51b567cfacc6d655ba271032\",\"quote\":\"(cc) a public housing agency as defined in section 1437a(b)(6) of this title;\",\"start\":29805},{\"end\":30001,\"field\":\"defined_terms:0:source:5\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:29885:30001:sha256-fa852bd805b007067d8800745004036000260667531fb9e53796a6fc5fbe695b\",\"quote\":\"(II) that is certified by the appropriate State authority as meeting the requirements of clauses (iii) and (iv); and\",\"start\":29885},{\"end\":30231,\"field\":\"defined_terms:0:source:6\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:30003:30231:sha256-942f59d112a0fd307e55122bd09c593836fa03bb00aa91d4164e823d1cba343a\",\"quote\":\"(III) if such organization is otherwise required to file a return under section 6033 of such title, that elects to treat the information required to be furnished by clause (v) as being specified in section 6033(b) of such title.\",\"start\":30003}],\"id\":\"urn:rulespec:document-understanding:revision:24f7f900979285c9f03fa6cfb4aa2a78efb04cf07551df7f43b8d1cb7b80a647\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"definition\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:5a867869d95e8ebfc94953d119691af85d75222468a6e8e778efaea616d4bb96\",\"modality\":\"not_stated\",\"modality_quote\":\"\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:f4e2a246f64e16fc7c452fb8ba5da162f0609f4146aff90f030baca306aa5cc7\",\"origin\":\"aiSuggested\",\"quote\":\"(i) In general The term “qualified charity” means any organization—\\n\\n(I) that is—\\n\\n(aa) described in section 501(c)(3) of title 26 and exempt from tax under section 501(a) of such title;\\n\\n(bb) an eligible entity; or\\n\\n(cc) a public housing agency as defined in section 1437a(b)(6) of this title;\\n\\n\\n(II) that is certified by the appropriate State authority as meeting the requirements of clauses (iii) and (iv); and\\n\\n(III) if such organization is otherwise required to file a return under section 6033 of such title, that elects to treat the information required to be furnished by clause (v) as being specified in section 6033(b) of such title.\",\"references\":[\"section 501(c)(3) of title 26\",\"section 501(a)\",\"section 1437a(b)(6) of this title\",\"clauses (iii) and (iv)\",\"section 6033\",\"clause (v)\",\"section 6033(b)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:258067c028d8c13f4a1562482db240587c77a625bcf0d3d3a13502bdac7987a4\",\"scope_quotes\":[\"(3) Definitions and rules In this subsection:\"],\"scope_text\":\"In this subsection\",\"section_id\":\"urn:rulespec:document-understanding:section:065d5bd1b1fd12e07012730aaa12714e330211d213042d09aad361bcfa67ebfa\",\"start\":29588,\"summary\":\"The term \\\"qualified charity\\\" means any organization: (I) that is (aa) described in section 501(c)(3) of title 26 and exempt from tax under section 501(a) of such title, (bb) an eligible entity, or (cc) a public housing agency as defined in section 1437a(b)(6) of this title; (II) that is certified by the appropriate State authority as meeting the requirements of clauses (iii) and (iv); and (III) if such organization is otherwise required to file a return under section 6033 of such title, that elects to treat the information required to be furnished by clause (v) as being specified in section 6033(b) of such title.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

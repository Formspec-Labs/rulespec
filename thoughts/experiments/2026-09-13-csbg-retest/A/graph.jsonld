      "rkaf:assertsValue": {
        "@value": "The Secretary shall conduct in several States in each fiscal year evaluations (including investigations) of the use of funds received by the States under chapter 106 of title 42 in order to evaluate compliance with the provisions of chapter 106, and especially with respect to compliance with section 9908(b) of title 42.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

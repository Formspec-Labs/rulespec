      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "(A) offer training and technical assistance, if appropriate, to help correct the deficiency, and prepare and submit to the Secretary a report describing the training and technical assistance offered; or\n\n(B) if the State determines that such training and technical assistance are not appropriate, prepare and submit to the Secretary a report stating the reasons for the determination;\n\n\n(4)"
        },

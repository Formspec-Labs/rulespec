      "rkaf:assertsValue": {
        "@value": "{\"defined_terms\":[{\"id\":\"urn:rulespec:document-understanding:term:39fc1f2d7fa4d6101a292b217e9ba3617c821bbdbad22a6e5c555d49a9f782e2\",\"label\":\"collection organization\",\"quote\":\"(II) Collection organization The term “collection organization” means an organization described in section 501(c)(3) of such title and exempt from tax under section 501(a) of such title—\\n\\n(aa) that solicits and collects gifts and grants that, by agreement, are distributed to qualified charities;\\n\\n(bb) that distributes to qualified charities at least 90 percent of the gifts and grants the organization receives that are designated for such qualified charities; and\\n\\n(cc) that meets the requirements of clause (vi).\",\"source_quotes\":[\"(II) Collection organization The term “collection organization” means an organization described in section 501(c)(3) of such title and exempt from tax under section 501(a) of such title—\",\"(aa) that solicits and collects gifts and grants that, by agreement, are distributed to qualified charities;\",\"(bb) that distributes to qualified charities at least 90 percent of the gifts and grants the organization receives that are designated for such qualified charities; and\",\"(cc) that meets the requirements of clause (vi).\"]}],\"kind\":\"definition\",\"modality\":\"not_stated\",\"scope_text\":\"In this subsection\",\"summary\":\"The term \\\"collection organization\\\" means an organization described in section 501(c)(3) of title 26 and exempt from tax under section 501(a) of such title that: solicits and collects gifts and grants that, by agreement, are distributed to qualified charities; distributes to qualified charities at least 90 percent of the gifts and grants the organization receives that are designated for such qualified charities; and meets the requirements of clause (vi).\",\"term_refs\":[\"urn:rulespec:document-understanding:term:18197e44e9217e632771fc8cefe12121ae56acb89335f8400a39dbebe2f91f91\"]}",

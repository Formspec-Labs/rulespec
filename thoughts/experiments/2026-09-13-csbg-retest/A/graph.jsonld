    {
      "@id": "urn:rulespec:document-understanding:revision:0ff0266829617bf034074d1c5f8db086f4f48e0b794f49be4ed0f86abc02eee0",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:0ff0266829617bf034074d1c5f8db086f4f48e0b794f49be4ed0f86abc02eee0",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:dde819ef1b515eb6cb0596470c1da30c5b4dc7b7b8f1bab6165025da66dc6daf",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"Secretary of Health and Human Services\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:72068c780a0c6102981bce1f1c59dd703e559f08a1c44b3f0cb4f6f52716b6ae\",\"urn:rulespec:document-understanding:assertion:d6f3a22b9c414c8c882f44edf38fc83f38aa54f321a33cbe92e59b24bc57c824\",\"urn:rulespec:document-understanding:assertion:eee587675100f07ad1b6bdd25ba2bba3be0e9479921d635600f310538f0abc42\",\"urn:rulespec:document-understanding:assertion:9a690d49ee86dbe0df88726612d99b6daf181890b1e795c37fcde3e23f5f12cd\",\"urn:rulespec:document-understanding:assertion:f64f7503aa143bba6d7d0d679be676f3a7cba9fd4cd8c6b7ed9823e26594f115\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":13695,\"evidence\":[{\"end\":13476,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:13045:13476:sha256-a2f5e94bcdbfe6d574f9a82b09fa97a44e74afb83c0b1a46fbf4e885748906dd\",\"quote\":\"Sec. 2. Providing Emergency Learning Scholarships for Students. The Secretary of Health and Human Services shall take steps, consistent with law, to allow funds available through the Community Services Block Grant program to be used by grantees and eligible entities to provide emergency learning scholarships to disadvantaged families for use by any child without access to in-person learning. These scholarships may be used for:\\n\",\"start\":13045},{\"end\":13533,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:13477:13533:sha256-b48c9ea9f4bb61e3ede3a4d33fc44f34e0caae3a31f7a94bb9971b9a8f551a6c\",\"quote\":\"(i) tuition and fees for a private or parochial school;\\n\",\"start\":13477},{\"end\":13587,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:13534:13587:sha256-b4c83e55d6db7683ce9a6b8c28c48f85530337afce2377f88d0aee9f7b54c034\",\"quote\":\"(ii) homeschool, microschool, or learning-pod costs;\\n\",\"start\":13534},{\"end\":13658,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:13588:13658:sha256-f8b35d5b6063cd6ac355f1060d632330225bd32b56b0283314368285c0d2e688\",\"quote\":\"(iii) special education and related services, including therapies; or\\n\",\"start\":13588},{\"end\":13695,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:13659:13695:sha256-4ac127865eef9f235251bc4c928ff4fac414f570357a08cb198f99fcddb800a0\",\"quote\":\"(iv) tutoring or remedial education.\",\"start\":13659},{\"end\":13151,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:13109:13151:sha256-9909ac202bb5f6ac8c4a048063bad563ab1b3b80bd082c3f71a7ebfca747062c\",\"quote\":\"The Secretary of Health and Human Services\",\"start\":13109},{\"end\":13157,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:13152:13157:sha256-56ee5b508706bf2de91712d85d6d1e11ddbff01949142ed6e8c22e3b1bed1c71\",\"quote\":\"shall\",\"start\":13152}],\"id\":\"urn:rulespec:document-understanding:revision:0ff0266829617bf034074d1c5f8db086f4f48e0b794f49be4ed0f86abc02eee0\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:9a690d49ee86dbe0df88726612d99b6daf181890b1e795c37fcde3e23f5f12cd\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:e42e5dcd5959ab0aca7d89526b6fbc059e0b403ee883ea0d5978e1fab1997d26\",\"origin\":\"aiSuggested\",\"quote\":\"Sec. 2. Providing Emergency Learning Scholarships for Students. The Secretary of Health and Human Services shall take steps, consistent with law, to allow funds available through the Community Services Block Grant program to be used by grantees and eligible entities to provide emergency learning scholarships to disadvantaged families for use by any child without access to in-person learning. These scholarships may be used for:\\n\\n(i) tuition and fees for a private or parochial school;\\n\\n(ii) homeschool, microschool, or learning-pod costs;\\n\\n(iii) special education and related services, including therapies; or\\n\\n(iv) tutoring or remedial education.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:8509889c253dbdd3162e97266212c190bf6d48ab38d7f3e586243a9c099ba248\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"urn:rulespec:document-understanding:section:7323930aa170deb28e8e4c58b97489268b7a6a77f0c9e944a4a0c1a4cb2ef66d\",\"start\":13045,\"summary\":\"The Secretary of Health and Human Services shall take steps, consistent with law, to allow funds available through the Community Services Block Grant program to be used by grantees and eligible entities to provide emergency learning scholarships to disadvantaged families for use by any child without access to in-person learning, which scholarships may be used for tuition and fees for a private or parochial school; homeschool, microschool, or learning-pod costs; special education and related services, including therapies; or tutoring or remedial education.\",\"target_ids\":[],\"term_refs\":[\"urn:rulespec:document-understanding:term:609da2cab4326e363e5f445c4b18a0b7dafa3403032088b82b5e79a3af703c4e\"],\"typed_values\":[]}",

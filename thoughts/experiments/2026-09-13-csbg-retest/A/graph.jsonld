      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"Secretary\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:3620c62cace5b50d01a9af20d9401ea1a421ee5651ba3194cde87f49e51cbe9d\",\"urn:rulespec:document-understanding:assertion:ed7c3fbd89284afbf34e69609b4707df5378bcc6d2a7084287c79089a2e8e515\",\"urn:rulespec:document-understanding:assertion:1b23c508e7189acbaa0538d5eb09536b950b219b6720ae93c816cacc749b5baf\",\"urn:rulespec:document-understanding:assertion:5d83946be5e5c795ad308f6918b91bb085e978169109157194e2c44587968417\",\"urn:rulespec:document-understanding:assertion:8a401fef3209bd71eee8070bc00ff6e8efa9c8d40121998434e800d7635fb010\",\"urn:rulespec:document-understanding:assertion:4401d5d7b6032e9968a268bf6251459b997da946a9572c8b48dd1ca5637b97f9\",\"urn:rulespec:document-understanding:assertion:2ae5a28ab23db9047de1a74f6ee2d7f27c66aa06456b29743669d928f01e3eb6\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":18271,\"evidence\":[{\"end\":17668,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:17652:17668:sha256-74fda605329d9b1ceb4fc23f202c17e0235b89f64f355a31862ab1a252852db2\",\"quote\":\"(b) Reservations\",\"start\":17652},{\"end\":17768,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:17669:17768:sha256-52e40889c206e95327235a9da3d28d4bc66f4b76274d478cbed27729f4c0dbe7\",\"quote\":\"Of the amounts appropriated under subsection (a) for each fiscal year, the Secretary shall reserve—\",\"start\":17669},{\"end\":17969,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:17770:17969:sha256-efae5c543dd8ff050e9e7b4135c1a0010d0f8390d462bedae86f6e571afdf702\",\"quote\":\"(1) ½ of 1 percent for carrying out section 9905 of this title (relating to payments for territories);\\n\\n(2) 1½ percent for activities authorized in sections 9913 through 9918 of this title, of which—\",\"start\":17770},{\"end\":18271,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:17971:18271:sha256-8f40cc397888479db650cbd2df25c31442c7cdbe2b7eeeeb52c561cc26b80ac7\",\"quote\":\"(A) not less than ½ of the amount reserved by the Secretary under this paragraph shall be distributed directly to eligible entities, organizations, or associations described in section 9913(c)(2) of this title for the purpose of carrying out activities described in section 9913(c) of this title; and\",\"start\":17971},{\"end\":17668,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:17652:17668:sha256-74fda605329d9b1ceb4fc23f202c17e0235b89f64f355a31862ab1a252852db2\",\"quote\":\"(b) Reservations\",\"start\":17652},{\"end\":17768,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:17669:17768:sha256-52e40889c206e95327235a9da3d28d4bc66f4b76274d478cbed27729f4c0dbe7\",\"quote\":\"Of the amounts appropriated under subsection (a) for each fiscal year, the Secretary shall reserve—\",\"start\":17669}],\"id\":\"urn:rulespec:document-understanding:revision:a6ff5c86c71604b1ca51b53644c782b6309bea1c41d6d128df4f308e892eba31\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:8a401fef3209bd71eee8070bc00ff6e8efa9c8d40121998434e800d7635fb010\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:0a5a8c09117e4b9f84f46860dfcc64b34abc326e0233be35bc55eb69af4363ef\",\"origin\":\"aiSuggested\",\"quote\":\"(b) Reservations Of the amounts appropriated under subsection (a) for each fiscal year, the Secretary shall reserve—\\n\\n(1) ½ of 1 percent for carrying out section 9905 of this title (relating to payments for territories);\\n\\n(2) 1½ percent for activities authorized in sections 9913 through 9918 of this title, of which—\\n\\n(A) not less than ½ of the amount reserved by the Secretary under this paragraph shall be distributed directly to eligible entities, organizations, or associations described in section 9913(c)(2) of this title for the purpose of carrying out activities described in section 9913(c) of this title; and\",\"references\":[\"section 9903(a)\",\"sections 9913 through 9918\",\"section 9913(c)(2)\",\"section 9913(c)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:a7de651dff586d3ad484c69cf681bb9154b80d470a1e49637fb88104c85adafe\",\"scope_quotes\":[\"(b) Reservations Of the amounts appropriated under subsection (a) for each fiscal year, the Secretary shall reserve—\"],\"scope_text\":\"for each fiscal year\",\"section_id\":\"urn:rulespec:document-understanding:section:12fca79c614e56d4c2834f93ce1a7d98eff6aeadfd069e9f4c6aeffa5285544c\",\"start\":17652,\"summary\":\"Of the amounts appropriated under section 9903(a) of title 42 for each fiscal year, the Secretary shall reserve 1 1/2 percent for activities authorized in sections 9913 through 9918 of title 42, of which not less than 1/2 of the amount reserved under paragraph (2) shall be distributed directly to eligible entities, organizations, or associations described in section 9913(c)(2) of title 42 for the purpose of carrying out activities described in section 9913(c) of title 42.\",\"target_ids\":[],\"term_refs\":[\"urn:rulespec:document-understanding:term:609da2cab4326e363e5f445c4b18a0b7dafa3403032088b82b5e79a3af703c4e\",\"urn:rulespec:document-understanding:term:f4c9f84c522e2926470ee048e00856dd704855d4dcd8ecb6fa6c2d3ecf28658e\"],\"typed_values\":[]}",

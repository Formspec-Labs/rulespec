      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:99c31cb620311dfa53edfcf2e18fd7df54521e71f88c8347e35b3acd52157fdb\",\"urn:rulespec:document-understanding:assertion:e669cb136fab481808c1a9ec957f8700408e738440ee63eca388d319a3764628\",\"urn:rulespec:document-understanding:assertion:4db77b9ba2e593057af7d6e3f74546bcc38b40547bc517a6b8230a48059b005e\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":70543,\"evidence\":[{\"end\":70543,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:70027:70543:sha256-91e604693d4c823d306166a3982ca7c6f673309ef90fea1a5da82f8a9f83ed3a\",\"quote\":\"A determination to terminate the designation or reduce the funding of an eligible entity is reviewable by the Secretary. The Secretary shall, upon request, review such a determination. The review shall be completed not later than 90 days after the Secretary receives from the State all necessary documentation relating to the determination to terminate the designation or reduce the funding. If the review is not completed within 90 days, the determination of the State shall become final at the end of the 90th day.\",\"start\":70027}],\"id\":\"urn:rulespec:document-understanding:revision:2fdcc5b8caaa818ff6420a26996197d0ab19076e70a57319c6717555fbf00598\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"statement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:4db77b9ba2e593057af7d6e3f74546bcc38b40547bc517a6b8230a48059b005e\",\"modality\":\"possible\",\"modality_quote\":\"\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:54a55904e34daab4f92ffcfcc77e8222158dc338b3c3b4889e8382a252f3ebbf\",\"origin\":\"aiSuggested\",\"quote\":\"A determination to terminate the designation or reduce the funding of an eligible entity is reviewable by the Secretary. The Secretary shall, upon request, review such a determination. The review shall be completed not later than 90 days after the Secretary receives from the State all necessary documentation relating to the determination to terminate the designation or reduce the funding. If the review is not completed within 90 days, the determination of the State shall become final at the end of the 90th day.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:c6f1bfe61785c7009a0dfbe4e9e28ed15ca35fccf5499f21484c75b470449d45\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"urn:rulespec:document-understanding:section:237b538fca368735fd9d07469584e65428d74fd94b694e39006074ead5c84559\",\"start\":70027,\"summary\":\"A determination to terminate the designation or reduce the funding of an eligible entity is reviewable by the Secretary.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

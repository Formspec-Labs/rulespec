      "@type": "rkaf:LocalConcept",
      "skos:prefLabel": {
        "en": "collection organization"
      },
      "skos:definition": {
        "en": "The term \"collection organization\" means an organization described in section 501(c)(3) of title 26 and exempt from tax under section 501(a) of such title that: solicits and collects gifts and grants that, by agreement, are distributed to qualified charities; distributes to qualified charities at least 90 percent of the gifts and grants the organization receives that are designated for such qualified charities; and meets the requirements of clause (vi)."
      },
      "skos:inScheme": "urn:rulespec:document-understanding:defined-term-scheme:26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023",

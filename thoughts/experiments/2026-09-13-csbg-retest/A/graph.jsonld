      "@id": "urn:rulespec:document-understanding:revision:cb1bde79598d2091fc1d793828c8661f6d57dc30390594d83b9b97e52aae35e2",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:cb1bde79598d2091fc1d793828c8661f6d57dc30390594d83b9b97e52aae35e2",

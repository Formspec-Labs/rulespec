      "dcterms:description": "{\"action\":\"\",\"actor\":\"the Secretary\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:bde3fac5b7eda1981c188d12842086d964ef3ba48e93b780223bce8714efd445\",\"urn:rulespec:document-understanding:assertion:8116c38756a5f5ef9feed1556c81dfa9ffbdc8b933717413a6b039e516cbd8c7\",\"urn:rulespec:document-understanding:assertion:c8100be7350cdf6a4846fa38d7f3e5576d3bd7edc4a47d2740f8bf8298de6f5d\",\"urn:rulespec:document-understanding:assertion:224d9eded9340e2a91d65df90390a7132b563a4f21b37edfee0a0cda1d4beb18\",\"urn:rulespec:document-understanding:assertion:46a0d5e3e3d601030b148eea466828fc7168bd2565d963a081bbbd19836ff8c4\",\"urn:rulespec:document-understanding:assertion:dd921f49dd7a73e90a97a63dd3bc42ea12af692c85f8c486af06d70b62d87e93\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":130317,\"evidence\":[{\"end\":130317,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:130011:130317:sha256-fb1526d6b8f9bc1670f48cd943bf9d1638b73b0b0f0e527e94662b0f1a386607\",\"quote\":\"(2) In approving applications under this section, the Secretary shall give priority to applications proposing to serve those areas containing the highest percentage of individuals receiving assistance under a State program funded under part A of title IV of the Social Security Act [42 U.S.C. 601 et seq.].\",\"start\":130011},{\"end\":130074,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:130061:130074:sha256-67afe9d5c4310238267da793c265a616f9e90d554f2458a8065b7bb971d853b5\",\"quote\":\"the Secretary\",\"start\":130061},{\"end\":130080,\"field\":\"modality\",\"fragment_id\":
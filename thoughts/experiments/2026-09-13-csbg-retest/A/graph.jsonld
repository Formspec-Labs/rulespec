      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:e5689511afb21f0a8a06ec2b1d445b42bc19d72ab218e1003ec594ce6fe5b449\",\"urn:rulespec:document-understanding:assertion:6726135426a61a0fa9a69ddaa2da7a2cdd0bd9efeaf12c790367fde9532e6e7f\",\"urn:rulespec:document-understanding:assertion:aeace83a9fb211714c69527b7bc7b0d0fe2d183a5e8a6eb222c8b8c407e827a4\",\"urn:rulespec:document-understanding:assertion:a8a18403754367c52bdea21b5a4ec6524d022c2c7446ca8e8d8a561dff54c3e2\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":35188,\"evidence\":[{\"end\":34529,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:34475:34529:sha256-02fd9ef07115b8b0d38fca7d531611e1378bb6d290502126ba5ca38125fa5e7e\",\"quote\":\"(vii) Special rule for States requiring tax uniformity\",\"start\":34475},{\"end\":34553,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:34530:34553:sha256-e952ba9b58a60fc1e0bf7031e30cb8004b7aa72944ce496282493e87f4ed85a6\",\"quote\":\"In the case of a State—\",\"start\":34530},{\"end\":34695,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:34555:34695:sha256-857ef718394bbcbc477c416bdeb788f253e0645fe067a5d77b2fb85c20ab1160\",\"quote\":\"(I) that has a constitutional requirement of tax uniformity; and\\n\\n(II) that, as of December 31, 1997, imposed a tax on personal income with—\",\"start\":34555},{\"end\":35188,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:34697:35188:sha256-28c66fedbb46552ad13a553bea01c6dcec2177f1aeef4d901b2bdc4a8a4afd5d\",\"quote\":\"(aa) a single flat rate applicable to all earned and unearned income (except insofar as any amount is not taxed pursuant to tax forgiveness provisions); and\\n\\n(bb) no generally available exemptions or deductions to individuals;\\n\\n\\n\\n\\n the requirement of paragraph (2) shall be treated as met if the amount of the credit described in paragraph (2) is limited to a uniform percentage (but not greater than 25 percent) of State personal income tax liability (determined without regard to credits).\",\"start\":34697},{\"end\":34978,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:34962:34978:sha256-619bfbe005ad8ea15862d069f2ec8d133cb1b3b4714bdc3cf456b12b1c6bf615\",\"quote\":\"shall be treated\",\"start\":34962},{\"end\":34529,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:34475:34529:sha256-02fd9ef07115b8b0d38fca7d531611e1378bb6d290502126ba5ca38125fa5e7e\",\"quote\":\"(vii) Special rule for States requiring tax uniformity\",\"start\":34475},{\"end\":34553,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:34530:34553:sha256-e952ba9b58a60fc1e0bf7031e30cb8004b7aa72944ce496282493e87f4ed85a6\",\"quote\":\"In the case of a State—\",\"start\":34530},{\"end\":34695,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:34555:34695:sha256-857ef718394bbcbc477c416bdeb788f253e0645fe067a5d77b2fb85c20ab1160\",\"quote\":\"(I) that has a constitutional requirement of tax uniformity; and\\n\\n(II) that, as of December 31, 1997, imposed a tax on personal income with—\",\"start\":34555},{\"end\":34923,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:34697:34923:sha256-a68b9587bb2ab8a0259228f12760feb4f55831841c5d04acb3ff34d488d627d0\",\"quote\":\"(aa) a single flat rate applicable to all earned and unearned income (except insofar as any amount is not taxed pursuant to tax forgiveness provisions); and\\n\\n(bb) no generally available exemptions or deductions to individuals;\",\"start\":34697}],\"id\":\"urn:rulespec:document-understanding:revision:9d65505d7b451169835a74a4f2d49128869380e4a6190e2429dc169817fcf843\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"statement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:a8a18403754367c52bdea21b5a4ec6524d022c2c7446ca8e8d8a561dff54c3e2\",\"modality\":\"not_stated\",\"modality_quote\":\"shall be treated\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:ca09b9a934e680c38288ea68d1447262b842e59b0a1891fbafd5e1f0e8eebabf\",\"origin\":\"aiSuggested\",\"quote\":\"(vii) Special rule for States requiring tax uniformity In the case of a State—\\n\\n(I) that has a constitutional requirement of tax uniformity; and\\n\\n(II) that, as of December 31, 1997, imposed a tax on personal income with—\\n\\n(aa) a single flat rate applicable to all earned and unearned income (except insofar as any amount is not taxed pursuant to tax forgiveness provisions); and\\n\\n(bb) no generally available exemptions or deductions to individuals;\\n\\n\\n\\n\\n the requirement of paragraph (2) shall be treated as met if the amount of the credit described in paragraph (2) is limited to a uniform percentage (but not greater than 25 percent) of State personal income tax liability (determined without regard to credits).\",\"references\":[\"paragraph (2)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:ec2f4f32e4b12ee67ec7a6dce48b4d86365e2627330b8564f51bce8887bac73b\",\"scope_quotes\":[\"(vii) Special rule for States requiring tax uniformity In the case of a State—\\n\\n(I) that has a constitutional requirement of tax uniformity; and\\n\\n(II) that, as of December 31, 1997, imposed a tax on personal income with—\\n\\n(aa) a single flat rate applicable to all earned and unearned income (except insofar as any amount is not taxed pursuant to tax forgiveness provisions); and\\n\\n(bb) no generally available exemptions or deductions to individuals;\"],\"scope_text\":\"In the case of a State that has a constitutional requirement of tax uniformity and that, as of December 31, 1997, imposed a tax on personal income with a single flat rate applicable to all earned and unearned income (except insofar as any amount is not taxed pursuant to tax forgiveness provisions) and no generally available exemptions or deductions to individuals\",\"section_id\":\"urn:rulespec:document-understanding:section:065d5bd1b1fd12e07012730aaa12714e330211d213042d09aad361bcfa67ebfa\",\"start\":34475,\"summary\":\"In the case of a State that has a constitutional requirement of tax uniformity and that, as of December 31, 1997, imposed a tax on personal income with a single flat rate applicable to all earned and unearned income (except insofar as any amount is not taxed pursuant to tax forgiveness provisions) and no generally available exemptions or deductions to individuals, the requirement of paragraph (2) shall be treated as met if the amount of the credit described in paragraph (2) is limited to a uniform percentage (but not greater than 25 percent) of State personal income tax liability (determined without regard to credits).\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

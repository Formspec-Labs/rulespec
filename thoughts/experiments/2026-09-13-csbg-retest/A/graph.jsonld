      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"defined_terms\":[{\"id\":\"urn:rulespec:document-understanding:term:609da2cab4326e363e5f445c4b18a0b7dafa3403032088b82b5e79a3af703c4e\",\"label\":\"eligible entity\",\"quote\":\"(A) Eligible entity The term “eligible entity” means an entity—\\n\\n(i) that is an eligible entity described in paragraph (1) (as in effect on the day before October 27, 1998) as of the day before October 27, 1998, or is designated by the process described in section 9909 of this title (including an organization serving migrant or seasonal farmworkers that is so described or designated); and\\n\\n(ii) that has a tripartite board or other mechanism described in subsection (a) or (b), as appropriate, of section 9910 of this title.\",\"source_quotes\":[\"(A) Eligible entity The term “eligible entity” means an entity—\\n\\n(i) that is an eligible entity described in paragraph (1) (as in effect on the day before October 27, 1998) as of the day before October 27, 1998, or is designated by the process described in section 9909 of this title (including an organization serving migrant or seasonal farmworkers that is so described or designated); and\\n\\n(ii) that has a tripartite board or other mechanism described in subsection (a) or (b), as appropriate, of section 9910 of this title.\"]}],\"kind\":\"definition\",\"modality\":\"not_stated\",\"scope_text\":\"In this chapter\",\"summary\":\"In chapter 106, \\\"eligible entity\\\" means an entity that is an eligible entity described in paragraph (1) (as in effect on the day before October 27, 1998) as of the day before October 27, 1998, or is designated by the process described in section 9909 of title 42 (including an organization serving migrant or seasonal farmworkers that is so described or designated), and that has a tripartite board or other mechanism described in subsection (a) or (b), as appropriate, of section 9910 of title 42.\"}",
        "@type": "xsd:string"
      },

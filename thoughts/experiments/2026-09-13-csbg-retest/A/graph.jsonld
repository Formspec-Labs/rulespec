      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:4633c72b9949e6d6951371bc0574fba50f8ba6a46700aec92d15b8c8b10c59fa",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:772912910f25c3b018f6b2b9d0d9f52575d2682e55f10e3ebc6f00b827dd5dfd",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:aa50e39fa701a347ff90727dba203082383209e4c223887660968cba17f051ad",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:states-requirement",
      "rkaf:assertsValue": {
        "@value": "In order to serve as the eligible entity for the area, a private nonprofit eligible entity that is geographically located in an area contiguous to or within reasonable proximity of the unserved area and that is already providing related services in the unserved area shall agree to add additional members to the board of the entity to ensure adequate representation in each of the three required categories described in section 9910(a)(2)(A), (B), and (C) of title 42 by members that reside in the community comprised by the unserved area, and in the category described in section 9910(a)(2)(B) of title 42 by members that reside in the neighborhood to be served.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:states-prohibition",
      "rkaf:assertsValue": {
        "@value": "The Secretary must not make grants under subsection (a) to an eligible agency in an aggregate amount exceeding $50,000 from funds made available under paragraphs (1)(B) and (2)(B) for any fiscal year, and must not make grants under subsection (a) to an eligible agency in an aggregate amount exceeding $300,000 from funds made available under paragraph (2)(C) for any fiscal year.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

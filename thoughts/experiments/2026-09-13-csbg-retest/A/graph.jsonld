    {
      "@id": "urn:rulespec:document-understanding:revision:ac81f26c95643ef906de99413a8958fa5e24bc4a287b8eaa085a7c1e350c7da7",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:ac81f26c95643ef906de99413a8958fa5e24bc4a287b8eaa085a7c1e350c7da7",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:aa9f1726b161f01493c0ff498739e9ea681570f2e1eebefa99684c63c54dbafc",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"eligible service provider\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:5b4893150fa26c7ccdac812d462a98bb4e71e1164bb17a3648d3fac409e05448\",\"urn:rulespec:document-understanding:assertion:de74d3b129668d23b8ae4c3a6660fb4a3298c694a3092feea87af82fc041b2a3\",\"urn:rulespec:document-understanding:assertion:a82bb93f3873e5dc2b8c0824d379a0cac1e5c4ec48aeec40ed221272d70b641d\",\"urn:rulespec:document-understanding:assertion:3b225aad5fe6cc8121e73ecedf4d959b0e6f627b3f63935d4f9691686c401807\",\"urn:rulespec:document-understanding:assertion:93e73a26716afee0ac722ea589819c3d5d814385ba4dcf5d6c68118d0d929205\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":106568,\"evidence\":[{\"end\":105748,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:105712:105748:sha256-f9b9c116fcd48bea70cb53ac79681f2811f993db70466fbab9239943517e0b6b\",\"quote\":\"(c) Advisory committee; partnerships\",\"start\":105712},{\"end\":105852,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:105749:105852:sha256-cb157ba9c97c251f44ee82b13ad864ea761fede60323da0c6d4b616e702286b9\",\"quote\":\"The eligible service provider shall, in each community in which a program is funded under this section—\",\"start\":105749},{\"end\":105870,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:105854:105870:sha256-95f73eccbcb87b56eb2ca1d56081911438cb01df0446a25b8738612b20ffe77d\",\"quote\":\"(1) ensure that—\",\"start\":105854},{\"end\":106568,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:105872:106568:sha256-7f9f276b1a56b2ae571279366007ae4db582db918da838bded373d45e0b6cae1\",\"quote\":\"(A) a community-based advisory committee is established, with representatives from local youth, family, and social service organizations, schools, entities providing park and recreation services, and other community-based organizations serving high-risk youth; or\\n\\n(B) an existing community-based advisory board, commission, or committee with similar membership is utilized to serve as the committee described in subparagraph (A); and\\n\\n\\n(2) enter into formal partnerships with youth-serving organizations or other appropriate social service entities in order to link program participants with year-round services in their home communities that support and continue the objectives of this chapter.\",\"start\":105872},{\"end\":105778,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:105753:105778:sha256-4e3196b2b4aa0cdda8d7052c46ef646ce3ac79982e9f3db9f7e86492ab410ad5\",\"quote\":\"eligible service provider\",\"start\":105753},{\"end\":105784,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:105779:105784:sha256-56ee5b508706bf2de91712d85d6d1e11ddbff01949142ed6e8c22e3b1bed1c71\",\"quote\":\"shall\",\"start\":105779},{\"end\":105748,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:105712:105748:sha256-f9b9c116fcd48bea70cb53ac79681f2811f993db70466fbab9239943517e0b6b\",\"quote\":\"(c) Advisory committee; partnerships\",\"start\":105712},{\"end\":105852,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:105749:105852:sha256-cb157ba9c97c251f44ee82b13ad864ea761fede60323da0c6d4b616e702286b9\",\"quote\":\"The eligible service provider shall, in each community in which a program is funded under this section—\",\"start\":105749}],\"id\":\"urn:rulespec:document-understanding:revision:ac81f26c95643ef906de99413a8958fa5e24bc4a287b8eaa085a7c1e350c7da7\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:93e73a26716afee0ac722ea589819c3d5d814385ba4dcf5d6c68118d0d929205\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:779b43307ff9c6a0afaabbbbccf1d2b45e7e8d152b2c0a799378bcc98449a7ee\",\"origin\":\"aiSuggested\",\"quote\":\"(c) Advisory committee; partnerships The eligible service provider shall, in each community in which a program is funded under this section—\\n\\n(1) ensure that—\\n\\n(A) a community-based advisory committee is established, with representatives from local youth, family, and social service organizations, schools, entities providing park and recreation services, and other community-based organizations serving high-risk youth; or\\n\\n(B) an existing community-based advisory board, commission, or committee with similar membership is utilized to serve as the committee described in subparagraph (A); and\\n\\n\\n(2) enter into formal partnerships with youth-serving organizations or other appropriate social service entities in order to link program participants with year-round services in their home communities that support and continue the objectives of this chapter.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:7c5abfbf7e9cc3c4b1d3e122642a370d3db0cb12eb7c6c9a3e4b5f9df2b7da74\",\"scope_quotes\":[\"(c) Advisory committee; partnerships The eligible service provider shall, in each community in which a program is funded under this section—\"],\"scope_text\":\"In each community in which a program is funded under section 9923.\",\"section_id\":\"urn:rulespec:document-understanding:section:f3eea5347c895856895eee6edec328881bdec01acc0faf09e4d4dd77b2ba0a81\",\"start\":105712,\"summary\":\"In each community in which a program is funded under section 9923, the eligible service provider must enter into formal partnerships with youth-serving organizations or other appropriate social service entities in order to link program participants with year-round services in their home communities that support and continue the objectives of chapter 106 of title 42.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

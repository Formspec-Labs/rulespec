      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"Secretary\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:bd2a54f26aca60acee27bf64c8b359973ef259744f78a0d3e8a07b12362adb9a\",\"urn:rulespec:document-understanding:assertion:a2b3ef7f7f5a40c69b2bb3bcf0dcc019ef8f59efdab2012707a6f2744490a0f2\",\"urn:rulespec:document-understanding:assertion:997554531d6bb1ac7b7378f1078abc27ed6b55db70c47ac21d0055853d69a36a\",\"urn:rulespec:document-understanding:assertion:b045b8222a7159b5eca25f7cf58cde84f5516459edddbff9fe216fe3122fe498\",\"urn:rulespec:document-understanding:assertion:88f8604749fbf23a783fcaf1edc05490c924d4711e41292bdecf9b022ea866d1\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":99854,\"evidence\":[{\"end\":99296,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:99250:99296:sha256-6f4ce65cb40c1b27bb630d4326b30f18dd7cd25e04a1cfde46dc7930cb924b1f\",\"quote\":\"(1) Not to exceed $6,000,000 in appropriations\",\"start\":99250},{\"end\":99480,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:99297:99480:sha256-ab20de0207ce633bb3642097e52e1c6c730fc64096c1fa1eda9080fb52fa0795\",\"quote\":\"Of the amount appropriated for a fiscal year to carry out this section (but not to exceed $6,000,000), the Secretary shall distribute funds for grants under subsection (a) as follows:\",\"start\":99297},{\"end\":99496,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:99482:99496:sha256-9c42fb46ddf93b999d39103000936dbcb7ffda46cd45642986088a12333f6098\",\"quote\":\"(A) Allotments\",\"start\":99482},{\"end\":99854,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:99498:99854:sha256-05525e3ffd062825cf0fe131f1a9733052d7de215ee33318b315cab5eeacd05f\",\"quote\":\"From a portion equal to 60 percent of such amount (but not to exceed $3,600,000), the Secretary shall allot for grants to eligible agencies for statewide programs in each State the amount that bears the same ratio to such portion as the low-income and unemployed population of such State bears to the low-income and unemployed population of all the States.\",\"start\":99498},{\"end\":99296,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:99250:99296:sha256-6f4ce65cb40c1b27bb630d4326b30f18dd7cd25e04a1cfde46dc7930cb924b1f\",\"quote\":\"(1) Not to exceed $6,000,000 in appropriations\",\"start\":99250},{\"end\":99480,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:99297:99480:sha256-ab20de0207ce633bb3642097e52e1c6c730fc64096c1fa1eda9080fb52fa0795\",\"quote\":\"Of the amount appropriated for a fiscal year to carry out this section (but not to exceed $6,000,000), the Secretary shall distribute funds for grants under subsection (a) as follows:\",\"start\":99297}],\"id\":\"urn:rulespec:document-understanding:revision:5260bb4a5de659f691849c876139e38a2970a98152d4455203e9d707bf90b9c9\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:88f8604749fbf23a783fcaf1edc05490c924d4711e41292bdecf9b022ea866d1\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:2d58d99dc81da95df0898f6c85d7d788abeaceaf3dd39a55cbf1491b0dd01e8b\",\"origin\":\"aiSuggested\",\"quote\":\"(1) Not to exceed $6,000,000 in appropriations Of the amount appropriated for a fiscal year to carry out this section (but not to exceed $6,000,000), the Secretary shall distribute funds for grants under subsection (a) as follows:\\n\\n(A) Allotments\\n\\nFrom a portion equal to 60 percent of such amount (but not to exceed $3,600,000), the Secretary shall allot for grants to eligible agencies for statewide programs in each State the amount that bears the same ratio to such portion as the low-income and unemployed population of such State bears to the low-income and unemployed population of all the States.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:e3f79f87fdf0e7fecffdf323d2e18f72e543ae5f923f7a93ccbc28c1d5e2cd52\",\"scope_quotes\":[\"(1) Not to exceed $6,000,000 in appropriations Of the amount appropriated for a fiscal year to carry out this section (but not to exceed $6,000,000), the Secretary shall distribute funds for grants under subsection (a) as follows:\"],\"scope_text\":\"Of the amount appropriated for a fiscal year to carry out section 9922, not to exceed $6,000,000.\",\"section_id\":\"urn:rulespec:document-understanding:section:cad1a9ce814f7bc8d23a6ff48e1865a684b16830bcf049a10118a7b6cab89b15\",\"start\":99250,\"summary\":\"Of the amount appropriated for a fiscal year to carry out section 9922 (but not to exceed $6,000,000), the Secretary must allot 60 percent of such amount (not to exceed $3,600,000) for grants to eligible agencies for statewide programs in each State in an amount that bears the same ratio to such portion as the low-income and unemployed population of such State bears to the low-income and unemployed population of all the States.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

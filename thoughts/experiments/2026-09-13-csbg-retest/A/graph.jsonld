      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:6d1745e5c288c771dbf9ce8f49df7f10f63ca05e006468d62cc97aefe69cbf53\",\"urn:rulespec:document-understanding:assertion:ed11309714178a9d1fe7ecc3f05c67d02fdafc582e46f11db6022eb6dabf58a9\",\"urn:rulespec:document-understanding:assertion:d50c90b42e43ebbd4737dd0c46470be980671c52845d1d7ef9aac488737d524b\",\"urn:rulespec:document-understanding:assertion:674d6dfbf0ee8e75bcecacb8b72c602d8db3a28589b71c911fe6337b3f5e89fc\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":32454,\"evidence\":[{\"end\":31952,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:31916:31952:sha256-e6983a96ebb6018aff4b27200e73642309ee0137a2e33fd97b52f827e83c2892\",\"quote\":\"(III) Food aid and homeless shelters\",\"start\":31916},{\"end\":32088,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:31953:32088:sha256-d6520738074301645c463603c61855a45f9fc98576de26d86198094872dd8ef4\",\"quote\":\"Except as otherwise provided by the appropriate State authority, for purposes of subclause (I), services to individuals in the form of—\",\"start\":31953},{\"end\":32454,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:32090:32454:sha256-9196c2455c9a8fbdc345b718a8f21ecaf35ececbdbf4806621f1094c1e1a9e60\",\"quote\":\"(aa) donations of food or meals; or\\n\\n(bb) temporary shelter to homeless individuals;\\n\\n\\n\\n  shall be treated as provided to individuals described in subclause (I) if the location and provision of such services are such that the service provider may reasonably conclude that the beneficiaries of such services are predominantly individuals described in subclause (I).\",\"start\":32090},{\"end\":32196,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:32180:32196:sha256-619bfbe005ad8ea15862d069f2ec8d133cb1b3b4714bdc3cf456b12b1c6bf615\",\"quote\":\"shall be treated\",\"start\":32180},{\"end\":31952,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:31916:31952:sha256-e6983a96ebb6018aff4b27200e73642309ee0137a2e33fd97b52f827e83c2892\",\"quote\":\"(III) Food aid and homeless shelters\",\"start\":31916},{\"end\":32088,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:31953:32088:sha256-d6520738074301645c463603c61855a45f9fc98576de26d86198094872dd8ef4\",\"quote\":\"Except as otherwise provided by the appropriate State authority, for purposes of subclause (I), services to individuals in the form of—\",\"start\":31953},{\"end\":32454,\"field\":\"scope_text:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:32180:32454:sha256-fce67b12d6b1701f6f7ace93504910ed4f2dce165d6f63883cba95430c5352b0\",\"quote\":\"shall be treated as provided to individuals described in subclause (I) if the location and provision of such services are such that the service provider may reasonably conclude that the beneficiaries of such services are predominantly individuals described in subclause (I).\",\"start\":32180}],\"id\":\"urn:rulespec:document-understanding:revision:0f3b578781487a630ed6fcaa95b489600a2181b6498b20df24123633f224b000\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"statement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:674d6dfbf0ee8e75bcecacb8b72c602d8db3a28589b71c911fe6337b3f5e89fc\",\"modality\":\"not_stated\",\"modality_quote\":\"shall be treated\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:e36fcf4f799a89a58b013babde7c3fd49988ac737841f2f0d800896cd50311c0\",\"origin\":\"aiSuggested\",\"quote\":\"(III) Food aid and homeless shelters Except as otherwise provided by the appropriate State authority, for purposes of subclause (I), services to individuals in the form of—\\n\\n(aa) donations of food or meals; or\\n\\n(bb) temporary shelter to homeless individuals;\\n\\n\\n\\n  shall be treated as provided to individuals described in subclause (I) if the location and provision of such services are such that the service provider may reasonably conclude that the beneficiaries of such services are predominantly individuals described in subclause (I).\",\"references\":[\"subclause (I)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:4c7f8c207fec7115f185ab7ba047bb716db3c69c035f82b138a5723ed9cf5bf3\",\"scope_quotes\":[\"(III) Food aid and homeless shelters Except as otherwise provided by the appropriate State authority, for purposes of subclause (I), services to individuals in the form of—\",\"shall be treated as provided to individuals described in subclause (I) if the location and provision of such services are such that the service provider may reasonably conclude that the beneficiaries of such services are predominantly individuals described in subclause (I).\"],\"scope_text\":\"Except as otherwise provided by the appropriate State authority, for purposes of subclause (I), if the location and provision of such services are such that the service provider may reasonably conclude that the beneficiaries of such services are predominantly individuals described in subclause (I)\",\"section_id\":\"urn:rulespec:document-understanding:section:065d5bd1b1fd12e07012730aaa12714e330211d213042d09aad361bcfa67ebfa\",\"start\":31916,\"summary\":\"Except as otherwise provided by the appropriate State authority, for purposes of subclause (I), services to individuals in the form of donations of food or meals, or temporary shelter to homeless individuals, shall be treated as provided to individuals described in subclause (I) if the location and provision of such services are such that the service provider may reasonably conclude that the beneficiaries of such services are predominantly individuals described in subclause (I).\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

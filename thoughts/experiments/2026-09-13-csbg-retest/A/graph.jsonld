    },
    {
      "@id": "urn:rulespec:document-understanding:assertion:ecf665b30189bd23b49daff3d8b1ddaeb2d2642112e16f7b91e8b777f9ca1a04",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:4633c72b9949e6d6951371bc0574fba50f8ba6a46700aec92d15b8c8b10c59fa",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:1ddeb6b4f93733a4c226fb5c5105c6676871030f792da9f04d6343c46af5d65d",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:5cc8828a02782de3bd4c7a74ef50079b41e4808e3107e92dedc8b8547189f8b0",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:states-definition",
      "rkaf:assertsValue": {
        "@value": "For purposes of making a determination in accordance with subsection (b)(8) with respect to a funding reduction, the term \"cause\" includes: (A) a statewide redistribution of funds provided through a community services block grant under this chapter to respond to (i) the results of the most recently available census or other appropriate data, (ii) the designation of a new eligible entity, or (iii) severe economic dislocation; or (B) the failure of an eligible entity to comply with the terms of an agreement or a State plan, or to meet a State requirement, as described in section 9915(a) of this title.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

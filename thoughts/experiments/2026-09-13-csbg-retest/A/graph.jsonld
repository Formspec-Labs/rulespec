      "rkaf:hasContentDigest": "sha256:9e89335dcc29ac3841beecb97515fc6a157043f9cc3031e6d3642f8f00eadbfc",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"the entity\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:c796a774bbbf64f7ba8f03c3e3ed6e63dab172f66b9ccab439cabbf78d4992ac\",\"urn:rulespec:document-understanding:assertion:05667a979d7fddbf86ebd5a0fec9d4e4e7cd15ff3c2d62cba10153eca7516f91\",\"urn:rulespec:document-understanding:assertion:da68d487cd6187527c65ef572a35defdc2b1405a97611b9a6b7012c1a0571613\",\"urn:rulespec:document-understanding:assertion:3297098d658c92bdb9b1053ec3b84026753e5130d291e5a1216cc0e7dbc591ea\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[\"In order for a private, nonprofit entity to be considered to be an eligible entity for purposes of section 9902(1) of this title, the entity shall administer the community services block grant program through a tripartite board described in paragraph (2) that fully participates in the development, planning, implementation, and evaluation of the program to serve low-income communities.\"],\"defined_terms\":[],\"effective_periods\":[],\"end\":56015,\"evidence\":[{\"end\":54827,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:54789:54827:sha256-6db0ab40f8cd296014e554511a051ad8a132e69f76c9fd36c168feb53115bbe3\",\"quote\":\"(2) Selection and composition of board\",\"start\":54789},{\"end\":54967,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:54828:54967:sha256-370aca08154e0847fc8b38b3b9b3f61ba76e90d0b0afdd266979fee9acdb74cf\",\"quote\":\"The members of the board referred to in paragraph (1) shall be selected by the entity and the board shall be composed so as to assure that—\",\"start\":54828},{\"end\":55384,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:54969:55384:sha256-cda433f67d8f3b607d9affecc9a429dde53af6459e82bc3e65db8cee13a0e26d\",\"quote\":\"(A) ⅓ of the members of the board are elected public officials, holding office on the date of selection, or their representatives, except that if the number of such elected officials reasonably available and willing to serve on the board is less than ⅓ of the membership of the board, membership on the board of appointive public officials or their representatives may be counted in meeting such ⅓ requirement;\\n\\n(B)\",\"start\":54969},{\"end\":56015,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:55386:56015:sha256-188345e3b9db32fb00744442d9f8e5d1ce43c1fc6fde6b59bf859d15854c5d7e\",\"quote\":\"(i) not fewer than ⅓ of the members are persons chosen in accordance with democratic selection procedures adequate to assure that these members are representative of low-income individuals and families in the neighborhood served; and\\n\\n(ii) each representative of low-income individuals and families selected to represent a specific neighborhood within a community under clause (i) resides in the neighborhood represented by the member; and\\n\\n\\n(C) the remainder of the members are officials or members of business, industry, labor, religious, law enforcement, education, or other major groups and interests in the community served.\",\"start\":55386},{\"end\":54913,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:54903:54913:sha256-607e0c7f5cf2a8a38ed6f7e5ed63d71442e20bef61cc9cc3e59c2ec8d4bb0545\",\"quote\":\"the entity\",\"start\":54903},{\"end\":54786,\"field\":\"context:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:54399:54786:sha256-3244dfeb207b7dcd9ddfdff6af8331fdaab7bc00cc9fc108e288baa36818a2dd\",\"quote\":\"In order for a private, nonprofit entity to be considered to be an eligible entity for purposes of section 9902(1) of this title, the entity shall administer the community services block grant program through a tripartite board described in paragraph (2) that fully participates in the development, planning, implementation, and evaluation of the program to serve low-income communities.\",\"start\":54399}],\"id\":\"urn:rulespec:document-understanding:revision:66896a4d6b445741409f00f342a00e31955df3b1f3aafb65ad58a89881794297\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:3297098d658c92bdb9b1053ec3b84026753e5130d291e5a1216cc0e7dbc591ea\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:97ac377ee65fec0cd80f052d64991f37a736a7c0cba1f0e5c95f397205b1104e\",\"origin\":\"aiSuggested\",\"quote\":\"(2) Selection and composition of board The members of the board referred to in paragraph (1) shall be selected by the entity and the board shall be composed so as to assure that—\\n\\n(A) ⅓ of the members of the board are elected public officials, holding office on the date of selection, or their representatives, except that if the number of such elected officials reasonably available and willing to serve on the board is less than ⅓ of the membership of the board, membership on the board of appointive public officials or their representatives may be counted in meeting such ⅓ requirement;\\n\\n(B)\\n\\n(i) not fewer than ⅓ of the members are persons chosen in accordance with democratic selection procedures adequate to assure that these members are representative of low-income individuals and families in the neighborhood served; and\\n\\n(ii) each representative of low-income individuals and families selected to represent a specific neighborhood within a community under clause (i) resides in the neighborhood represented by the member; and\\n\\n\\n(C) the remainder of the members are officials or members of business, industry, labor, religious, law enforcement, education, or other major groups and interests in the community served.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:0330d359dce0da1ffb6a7c6206a91e3eeee31f91f2d62c3158d812279f5ee95a\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"urn:rulespec:document-understanding:section:e86efa42546ebfabc5a45ab5fdacdad8192ede5d781723b46383a2f15e9b7f09\",\"start\":54789,\"summary\":\"The members of the tripartite board referred to in 42 U.S.C. 9910(a)(1) shall be selected by the entity and the board shall be composed so as to assure that: (A) ⅓ of the members of the board are elected public officials, holding office on the date of selection, or their representatives, except that if the number of such elected officials reasonably available and willing to serve on the board is less than ⅓ of the membership of the board, membership on the board of appointive public officials or their representatives may be counted in meeting such ⅓ requirement; (B)(i) not fewer than ⅓ of the members are persons chosen in accordance with democratic selection procedures adequate to assure that these members are representative of low-income individuals and families in the neighborhood served, and (ii) each representative of low-income individuals and families selected to represent a specific neighborhood within a community under clause (i) resides in the neighborhood represented by the member; and (C) the remainder of the members are officials or members of business, industry, labor, religious, law enforcement, education, or other major groups and interests in the community served.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

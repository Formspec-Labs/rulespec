    {
      "@id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:2186:2219:sha256-5a45b27d253b24474ba80e54cf27f862c1ba8eba5aa7c5025751f0b2f6334fcc",
      "@type": "rkaf:SourceFragment",
      "oa:hasSource": "urn:rulespec:document-understanding:document:26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023",
      "rkaf:fragmentIdentityScheme": "rkaf:carrier-local-fragment",
      "rkaf:sourceArtifactDigest": "sha256:26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023",
      "rkaf:fragmentContentDigest": "sha256:5a45b27d253b24474ba80e54cf27f862c1ba8eba5aa7c5025751f0b2f6334fcc",
      "rkaf:selectorKind": [
        "oa:TextQuoteSelector",
        "oa:TextPositionSelector"
      ],
      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "The purposes of this chapter are—"
        },
        {
          "@type": "oa:TextPositionSelector",
          "oa:start": 2186,
          "oa:end": 2219,
          "rkaf:coordinateSystem": "rkaf:unicode-codepoint"
        }
      ]
    },
    {
      "@id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:2221:2805:sha256-eb418852e3677a0d98902c7e4141a0fc5695300b5b38d3545ce4767f3af99a16",
      "@type": "rkaf:SourceFragment",
      "oa:hasSource": "urn:rulespec:document-understanding:document:26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023",
      "rkaf:fragmentIdentityScheme": "rkaf:carrier-local-fragment",
      "rkaf:sourceArtifactDigest": "sha256:26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023",
      "rkaf:fragmentContentDigest": "sha256:eb418852e3677a0d98902c7e4141a0fc5695300b5b38d3545ce4767f3af99a16",
      "rkaf:selectorKind": [
        "oa:TextQuoteSelector",
        "oa:TextPositionSelector"
      ],
      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "(1) to provide assistance to States and local communities, working through a network of community action agencies and other neighborhood-based organizations, for the reduction of poverty, the revitalization of low-income communities, and the empowerment of low-income families and individuals in rural and urban areas to become fully self-sufficient (particularly families who are attempting to transition off a State program carried out under part A of title IV of the Social Security Act (42 U.S.C. 601 et seq.)); and\n\n(2) to accomplish the goals described in paragraph (1) through—"
        },
        {
          "@type": "oa:TextPositionSelector",
          "oa:start": 2221,
          "oa:end": 2805,
          "rkaf:coordinateSystem": "rkaf:unicode-codepoint"
        }
      ]
    },
    {
      "@id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:2807:4009:sha256-9838e329389ba2c4d9a0150858fd0251acce28e55ffd919c3197b6f891ce90fd",
      "@type": "rkaf:SourceFragment",
      "oa:hasSource": "urn:rulespec:document-understanding:document:26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023",
      "rkaf:fragmentIdentityScheme": "rkaf:carrier-local-fragment",
      "rkaf:sourceArtifactDigest": "sha256:26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023",
      "rkaf:fragmentContentDigest": "sha256:9838e329389ba2c4d9a0150858fd0251acce28e55ffd919c3197b6f891ce90fd",
      "rkaf:selectorKind": [
        "oa:TextQuoteSelector",
        "oa:TextPositionSelector"
      ],
      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "(A) the strengthening of community capabilities for planning and coordinating the use of a broad range of Federal, State, local, and other assistance (including private resources) related to the elimination of poverty, so that this assistance can be used in a manner responsive to local needs and conditions;\n\n(B) the organization of a range of services related to the needs of low-income families and individuals, so that these services may have a measurable and potentially major impact on the causes of poverty in the community and may help the families and individuals to achieve self-sufficiency;\n\n(C) the greater use of innovative and effective community-based approaches to attacking the causes and effects of poverty and of community breakdown;\n\n(D) the maximum participation of residents of the low-income communities and members of the groups served by programs assisted through the block grants made under this chapter to empower such residents and members to respond to the unique problems and needs within their communities; and\n\n(E) the broadening of the resource base of programs directed to the elimination of poverty so as to secure a more active role in the provision of services for—"
        },
        {
          "@type": "oa:TextPositionSelector",
          "oa:start": 2807,
          "oa:end": 4009,
          "rkaf:coordinateSystem": "rkaf:unicode-codepoint"
        }
      ]
    },
    {
      "@id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:4011:4256:sha256-f485a858b2d7fd3556734066ce1c4dbdcedffd46d4d6c8ec4fe5f3ccda427b78",
      "@type": "rkaf:SourceFragment",
      "oa:hasSource": "urn:rulespec:document-understanding:document:26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023",
      "rkaf:fragmentIdentityScheme": "rkaf:carrier-local-fragment",
      "rkaf:sourceArtifactDigest": "sha256:26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023",
      "rkaf:fragmentContentDigest": "sha256:f485a858b2d7fd3556734066ce1c4dbdcedffd46d4d6c8ec4fe5f3ccda427b78",
      "rkaf:selectorKind": [
        "oa:TextQuoteSelector",
        "oa:TextPositionSelector"
      ],
      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "(i) private, religious, charitable, and neighborhood-based organizations; and\n\n(ii) individual citizens, and business, labor, and professional groups, who are able to influence the quantity and quality of opportunities and services for the poor."
        },
        {
          "@type": "oa:TextPositionSelector",
          "oa:start": 4011,
          "oa:end": 4256,
          "rkaf:coordinateSystem": "rkaf:unicode-codepoint"
        }
      ]
    },
    {
      "@id": "urn:rulespec:document-understanding:assertion:1899f2cad28d2956b4185a56e537b8a919e56773c9909b3d90e116a5eb830689",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:4633c72b9949e6d6951371bc0574fba50f8ba6a46700aec92d15b8c8b10c59fa",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:df5c9c33272f572be5ef6667e12aa9bfa633d43d9b64a49c8d8dec9dce4f0d97",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:f51916ecc93a086986d9d4fdbdd8f3ca77423e3d2ea587d9396f64d76bafa123",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:states-statement",
      "rkaf:assertsValue": {
        "@value": "The purposes of chapter 106 are (1) to provide assistance to States and local communities, working through a network of community action agencies and other neighborhood-based organizations, for the reduction of poverty, the revitalization of low-income communities, and the empowerment of low-income families and individuals in rural and urban areas to become fully self-sufficient (particularly families attempting to transition off a State program carried out under part A of title IV of the Social Security Act); and (2) to accomplish those goals through strengthening community capabilities for planning and coordinating broad assistance responsive to local needs; organizing services related to low-income family and individual needs to have measurable and potentially major impact on causes of poverty and help achieve self-sufficiency; greater use of innovative and effective community-based approaches to attacking poverty and community breakdown causes and effects; maximum participation of residents of low-income communities and members of groups served by block grant assisted programs to empower them to respond to unique community problems and needs; and broadening the resource base to secure a more active role in service provision for private, religious, charitable, and neighborhood-based organizations as well as individual citizens, business, labor, and professional groups.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

      "@id": "urn:rulespec:document-understanding:revision:8a851b2b86c15da67221f51c0151f8e8b8f9c6438ec427c61bc02ffbcb57767d",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:8a851b2b86c15da67221f51c0151f8e8b8f9c6438ec427c61bc02ffbcb57767d",

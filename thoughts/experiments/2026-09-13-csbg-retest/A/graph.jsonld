    {
      "@id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:34697:35188:sha256-28c66fedbb46552ad13a553bea01c6dcec2177f1aeef4d901b2bdc4a8a4afd5d",
      "@type": "rkaf:SourceFragment",
      "oa:hasSource": "urn:rulespec:document-understanding:document:26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023",
      "rkaf:fragmentIdentityScheme": "rkaf:carrier-local-fragment",
      "rkaf:sourceArtifactDigest": "sha256:26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023",
      "rkaf:fragmentContentDigest": "sha256:28c66fedbb46552ad13a553bea01c6dcec2177f1aeef4d901b2bdc4a8a4afd5d",
      "rkaf:selectorKind": [
        "oa:TextQuoteSelector",
        "oa:TextPositionSelector"
      ],
      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "(aa) a single flat rate applicable to all earned and unearned income (except insofar as any amount is not taxed pursuant to tax forgiveness provisions); and\n\n(bb) no generally available exemptions or deductions to individuals;\n\n\n\n\n the requirement of paragraph (2) shall be treated as met if the amount of the credit described in paragraph (2) is limited to a uniform percentage (but not greater than 25 percent) of State personal income tax liability (determined without regard to credits)."
        },
        {
          "@type": "oa:TextPositionSelector",
          "oa:start": 34697,
          "oa:end": 35188,
          "rkaf:coordinateSystem": "rkaf:unicode-codepoint"
        }
      ]

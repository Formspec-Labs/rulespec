      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:c4ba6ff0a90845a38e376d7b802a9aa239012835f751482e3cf9aef74e42b8c8\",\"urn:rulespec:document-understanding:assertion:3277333e9bd30b95b781f3860ae49b4676f07a289347c72c2fd311b5740ce683\",\"urn:rulespec:document-understanding:assertion:577ad53f9885ba91b790053571428d70eeabea8c8eab9b43ea34a0be4c010d37\",\"urn:rulespec:document-understanding:assertion:ceeeb8a4ea643d097f2e599abcb3d33a75fd0c9dcb3d36edabf4152cc33fba80\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":117807,\"evidence\":[{\"end\":117295,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:117268:117295:sha256-df9132c0bee3bced3d5b352bf2009aa7c20c0c1117094053dd043da1e3ee3fbe\",\"quote\":\"(e) Replication of programs\",\"start\":117268},{\"end\":117807,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:117297:117807:sha256-ded916b53ee7b6d6bd00797760108a3227ab58205a96b73e848b0aacffb22807\",\"quote\":\"(1) The Secretary shall annually identify programs that receive grants under this section that demonstrate a significant potential for dealing with particularly critical needs or problems of the poor that exist in a number of communities.\\n\\n(2) Not less than 10 percent, and not more than 25 percent, of the funds appropriated for each fiscal year to carry out this section shall be available to make grants under this section to replicate in additional geographic areas programs identified under paragraph (1).\",\"start\":117297},{\"end\":117688,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:117670:117688:sha256-e78359687b49cfb8569471876b76ef62abc9ebc60bc880671e8ee15368b596aa\",\"quote\":\"shall be available\",\"start\":117670},{\"end\":117807,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A26bf1a2bb4a435dfac4c95beee0b11ea78bab22ac670bb65754c9e2393e34023:117537:117807:sha256-fabb9c219825f77286df8df47a1258e55fb87471523336d1db0d50026c2bb10a\",\"quote\":\"(2) Not less than 10 percent, and not more than 25 percent, of the funds appropriated for each fiscal year to carry out this section shall be available to make grants under this section to replicate in additional geographic areas programs identified under paragraph (1).\",\"start\":117537}],\"id\":\"urn:rulespec:document-understanding:revision:7afe7b91bf9743dd9092290a768550439e7cd71306c0a56b9ad4b36fa1f1b587\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:ceeeb8a4ea643d097f2e599abcb3d33a75fd0c9dcb3d36edabf4152cc33fba80\",\"modality\":\"must\",\"modality_quote\":\"shall be available\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:f6ececfbac307762017726850590755ae7682c9836f1be4f99033af5af130844\",\"origin\":\"aiSuggested\",\"quote\":\"(e) Replication of programs\\n\\n(1) The Secretary shall annually identify programs that receive grants under this section that demonstrate a significant potential for dealing with particularly critical needs or problems of the poor that exist in a number of communities.\\n\\n(2) Not less than 10 percent, and not more than 25 percent, of the funds appropriated for each fiscal year to carry out this section shall be available to make grants under this section to replicate in additional geographic areas programs identified under paragraph (1).\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:4af4be79a8b06c2e67696a4b95be7a12def67ec16460c81dc1cc099714c853f0\",\"scope_quotes\":[\"(2) Not less than 10 percent, and not more than 25 percent, of the funds appropriated for each fiscal year to carry out this section shall be available to make grants under this section to replicate in additional geographic areas programs identified under paragraph (1).\"],\"scope_text\":\"For each fiscal year.\",\"section_id\":\"urn:rulespec:document-understanding:section:5fba676d6775544d7cae048a3634eb9fe091aa0a96f2f732b41f08ff944d6890\",\"start\":117268,\"summary\":\"Not less than 10 percent, and not more than 25 percent, of the funds appropriated for each fiscal year to carry out section 9925 must be available to make grants under this section to replicate in additional geographic areas programs identified under paragraph (1).\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

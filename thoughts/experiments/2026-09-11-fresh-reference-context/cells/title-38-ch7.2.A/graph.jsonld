      "@id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A7758bab494c5c470c455c930666012929ac66674ddcc65eb2ba02480648b2960:76143:76691:sha256-cda52a79053b7a742272fd5a945498e7651e2dbcf8518ff41c58e3453872a30b",
      "@type": "rkaf:SourceFragment",
      "oa:hasSource": "urn:rulespec:document-understanding:document:7758bab494c5c470c455c930666012929ac66674ddcc65eb2ba02480648b2960",
      "rkaf:fragmentIdentityScheme": "rkaf:carrier-local-fragment",

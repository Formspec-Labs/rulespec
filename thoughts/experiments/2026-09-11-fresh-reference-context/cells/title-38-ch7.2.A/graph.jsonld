      "rkaf:assertsValue": {
        "@value": "{\"actor\":\"the Secretary\",\"kind\":\"requirement\",\"modality\":\"must\",\"scope_text\":\"If the employee does not furnish any such evidence as described in clause (i) or if the Secretary determines that such evidence is not sufficient to reverse the determination to propose the adverse action\",\"summary\":\"If the employee does not furnish any evidence in support of the answer as described in clause (i) or if the Secretary determines that such evidence is not sufficient to reverse the determination to propose the adverse action, the Secretary shall carry out the adverse action following such 10-day period.\"}",

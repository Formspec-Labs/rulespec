    {
      "@id": "urn:rulespec:document-understanding:revision:e1a6e49023c3ac0338edca9cee5e3bbe0b4b0e562fc261ee04305d960dfbd5d5",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:e1a6e49023c3ac0338edca9cee5e3bbe0b4b0e562fc261ee04305d960dfbd5d5",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:f5470b4ef43a4009219952dc965ada6f0797a4b8ec7c5e46f779904328f5c742",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:8233ac1f206459350115d56a272c710f197b1a0d6e1e6a81aeb1268e47e8df25\",\"urn:rulespec:document-understanding:assertion:47da3c07a093bc26ab1976c1b6a4ff5212910fe8b6ad6f4448602ea6e3517ec5\",\"urn:rulespec:document-understanding:assertion:e46d2fb374ce7662862988c68fc41e76cfe1f6ded29597996dfc1c79ddf65fca\",\"urn:rulespec:document-understanding:assertion:d2d8be3792b39e75a5068f0583b4428506908c2224e3b1a2890207cb50f179a2\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":15175,\"evidence\":[{\"end\":15175,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ad0591b337fcaca14df1a92cb27aac8774b5c9537940c80b932d5894701336dc3:14279:15175:sha256-1b636c6a0a27b55cfd5fd996d9485194f46e829088bccebd9c5dfb226d9d48fe\",\"quote\":\"(2) The provisions of paragraph (1) shall not apply (A) when the Secretary and the State licensing agency determine that the number of people using the property is or will be insufficient to support a vending facility, or (B) to any privately owned building, any part of which is leased by any department, agency, or instrumentality of the United States and in which, (i) prior to the execution of such lease, the lessor or any of his tenants had in operation a restaurant or other food facility in a part of the building not included in such lease, and (ii) the operation of such a vending facility by a blind person would be in proximate and substantial direct competition with such restaurant or other food facility except that each such department, agency, and instrumentality shall make every effort to lease property in privately owned buildings capable of accommodating a vending facility.\",\"start\":14279},{\"end\":14330,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ad0591b337fcaca14df1a92cb27aac8774b5c9537940c80b932d5894701336dc3:14315:14330:sha256-7001dc18e4250cacd3b4c31ed3fe0df3af0a721931a03c64cc5478da04eb29bd\",\"quote\":\"shall not apply\",\"start\":14315},{\"end\":15175,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ad0591b337fcaca14df1a92cb27aac8774b5c9537940c80b932d5894701336dc3:14279:15175:sha256-1b636c6a0a27b55cfd5fd996d9485194f46e829088bccebd9c5dfb226d9d48fe\",\"quote\":\"(2) The provisions of paragraph (1) shall not apply (A) when the Secretary and the State licensing agency determine that the number of people using the property is or will be insufficient to support a vending facility, or (B) to any privately owned building, any part of which is leased by any department, agency, or instrumentality of the United States and in which, (i) prior to the execution of such lease, the lessor or any of his tenants had in operation a restaurant or other food facility in a part of the building not included in such lease, and (ii) the operation of such a vending facility by a blind person would be in proximate and substantial direct competition with such restaurant or other food facility except that each such department, agency, and instrumentality shall make every effort to lease property in privately owned buildings capable of accommodating a vending facility.\",\"start\":14279}],\"id\":\"urn:rulespec:document-understanding:revision:e1a6e49023c3ac0338edca9cee5e3bbe0b4b0e562fc261ee04305d960dfbd5d5\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"exemption\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:d2d8be3792b39e75a5068f0583b4428506908c2224e3b1a2890207cb50f179a2\",\"modality\":\"not_required\",\"modality_quote\":\"shall not apply\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:f5fa3877be65d0172ab66654286f71419611f54eb70255934559d21e16e95966\",\"origin\":\"aiSuggested\",\"quote\":\"(2) The provisions of paragraph (1) shall not apply (A) when the Secretary and the State licensing agency determine that the number of people using the property is or will be insufficient to support a vending facility, or (B) to any privately owned building, any part of which is leased by any department, agency, or instrumentality of the United States and in which, (i) prior to the execution of such lease, the lessor or any of his tenants had in operation a restaurant or other food facility in a part of the building not included in such lease, and (ii) the operation of such a vending facility by a blind person would be in proximate and substantial direct competition with such restaurant or other food facility except that each such department, agency, and instrumentality shall make every effort to lease property in privately owned buildings capable of accommodating a vending facility.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:937994553c000999dbbd52c21d80ecbd4d1ac8019bf5510e064bcdcc5d7c391a\",\"scope_quotes\":[\"(2) The provisions of paragraph (1) shall not apply (A) when the Secretary and the State licensing agency determine that the number of people using the property is or will be insufficient to support a vending facility, or (B) to any privately owned building, any part of which is leased by any department, agency, or instrumentality of the United States and in which, (i) prior to the execution of such lease, the lessor or any of his tenants had in operation a restaurant or other food facility in a part of the building not included in such lease, and (ii) the operation of such a vending facility by a blind person would be in proximate and substantial direct competition with such restaurant or other food facility except that each such department, agency, and instrumentality shall make every effort to lease property in privately owned buildings capable of accommodating a vending facility.\"],\"scope_text\":\"when the Secretary and the State licensing agency determine that the number of people using the property is or will be insufficient to support a vending facility\",\"section_id\":\"urn:rulespec:document-understanding:section:6415b0472035d4c8d20ed41d5d849f0036b3031b0207f9d7b07a2cf92ce20e70\",\"start\":14279,\"summary\":\"The provisions of 20 U.S.C. 107a(d)(1) shall not apply when the Secretary and the State licensing agency determine that the number of people using the property is or will be insufficient to support a vending facility.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

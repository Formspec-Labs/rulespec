    {
      "@id": "urn:rulespec:document-understanding:revision:996842456d7a1c94435dbb48aa41deba01c43f79c923b7de4191c57ea86ac50b",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:996842456d7a1c94435dbb48aa41deba01c43f79c923b7de4191c57ea86ac50b",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:fb395fdca841f2bbe3af80a74d233e2048031bf7eb2e67da7efec6714cf3a997",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"Each such department, agency, or instrumentality\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:aac9e2479d0ae731505d85971b54ca363171538e4b9d9a72a7cbfdef6a3bf788\",\"urn:rulespec:document-understanding:assertion:fc5c1da994b111e0c2be142e05fdecdeda1c08abc19bf581990a4fb1ecbe2ad8\",\"urn:rulespec:document-understanding:assertion:6c49a7421fe6c4b32cd7ea6a063b34259e6d832784deede432183422ac521e47\",\"urn:rulespec:document-understanding:assertion:aa21a45ce2452ac58833ce3c56ad4837cd052ac2fc99808e13e93d956dfddbfc\",\"urn:rulespec:document-understanding:assertion:a0e8540b77a2311c674ba392b37ac8cd459433cd9fd80d443cd009f6cc048526\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":14277,\"evidence\":[{\"end\":14277,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ad0591b337fcaca14df1a92cb27aac8774b5c9537940c80b932d5894701336dc3:12984:14277:sha256-3c4d020d620baf21dfd7daafca5f66cb69e23844ff45c437d6aea96d0353adf9\",\"quote\":\"(1) After January 1, 1975, no department, agency, or instrumentality of the United States shall undertake to acquire by ownership, rent, lease, or to otherwise occupy, in whole or in part, any building unless, after consultation with the head of such department, agency, or instrumentality and the State licensing agency, it is determined by the Secretary that (A) such building includes a satisfactory site or sites for the location and operation of a vending facility by a blind person, or (B) if a building is to be constructed, substantially altered, or renovated, or in the case of a building that is already occupied on such date by such department, agency, or instrumentality, is to be substantially altered or renovated for use by such department, agency, or instrumentality, the design for such construction, substantial alteration, or renovation includes a satisfactory site or sites for the location and operation of a vending facility by a blind person. Each such department, agency, or instrumentality shall provide notice to the appropriate State licensing agency of its plans for occupation, acquisition, renovation, or relocation of a building adequate to permit such State agency to determine whether such building includes a satisfactory site or sites for a vending facility.\",\"start\":12984},{\"end\":13998,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ad0591b337fcaca14df1a92cb27aac8774b5c9537940c80b932d5894701336dc3:13950:13998:sha256-d5d057861682cae8271cdb3aed33c003a90427d73a00f18fcaea614e6eb22b00\",\"quote\":\"Each such department, agency, or instrumentality\",\"start\":13950},{\"end\":14012,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ad0591b337fcaca14df1a92cb27aac8774b5c9537940c80b932d5894701336dc3:13999:14012:sha256-3feed17dc8dea28964481dad4d257995f717d86576982cd1f595043186b42e1d\",\"quote\":\"shall provide\",\"start\":13999}],\"id\":\"urn:rulespec:document-understanding:revision:996842456d7a1c94435dbb48aa41deba01c43f79c923b7de4191c57ea86ac50b\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:aa21a45ce2452ac58833ce3c56ad4837cd052ac2fc99808e13e93d956dfddbfc\",\"modality\":\"must\",\"modality_quote\":\"shall provide\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:92107043794cc772f746d03a6a91c950d15858778eae779a82fa86027f45e678\",\"origin\":\"aiSuggested\",\"quote\":\"(1) After January 1, 1975, no department, agency, or instrumentality of the United States shall undertake to acquire by ownership, rent, lease, or to otherwise occupy, in whole or in part, any building unless, after consultation with the head of such department, agency, or instrumentality and the State licensing agency, it is determined by the Secretary that (A) such building includes a satisfactory site or sites for the location and operation of a vending facility by a blind person, or (B) if a building is to be constructed, substantially altered, or renovated, or in the case of a building that is already occupied on such date by such department, agency, or instrumentality, is to be substantially altered or renovated for use by such department, agency, or instrumentality, the design for such construction, substantial alteration, or renovation includes a satisfactory site or sites for the location and operation of a vending facility by a blind person. Each such department, agency, or instrumentality shall provide notice to the appropriate State licensing agency of its plans for occupation, acquisition, renovation, or relocation of a building adequate to permit such State agency to determine whether such building includes a satisfactory site or sites for a vending facility.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:64cb5eddb82df6ba49c0009b40027ff6503bbd4eed12b4d72e6ba8e6ff1eb2df\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"urn:rulespec:document-understanding:section:6415b0472035d4c8d20ed41d5d849f0036b3031b0207f9d7b07a2cf92ce20e70\",\"start\":12984,\"summary\":\"Each department, agency, or instrumentality of the United States shall provide notice to the appropriate State licensing agency of its plans for occupation, acquisition, renovation, or relocation of a building adequate to permit such State agency to determine whether such building includes a satisfactory site or sites for a vending facility.\",\"target_ids\":[],\"term_refs\":[\"urn:rulespec:document-understanding:term:44b81463adcf8f46168f55ea26491c69ba9ac5ff3629abdc5ba8179e6f47bd34\"],\"typed_values\":[]}",
      "dcterms:references": [
        {
          "@id": "urn:rulespec:document-understanding:assertion:aac9e2479d0ae731505d85971b54ca363171538e4b9d9a72a7cbfdef6a3bf788"

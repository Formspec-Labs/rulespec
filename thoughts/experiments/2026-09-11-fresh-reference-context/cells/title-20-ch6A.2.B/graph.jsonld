    {
      "@id": "urn:rulespec:document-understanding:revision:e1c2b88f0993bdfd1bb0af846ab2441c3f80b9abf45129f920376175146c1d9e",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:e1c2b88f0993bdfd1bb0af846ab2441c3f80b9abf45129f920376175146c1d9e",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:42514c3c2996a0dc9a7a8d7dfd3419a7efe55f61cfb37fb89f9c0ea8b809f80a",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"the State licensing agency\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:eef34241b1c47134abd1d30a571841c75ea89c0e94a73ccc92c7c0db22e18127\",\"urn:rulespec:document-understanding:assertion:7bf2dedb44ce0db6f35b09db0f10dca23fe13f0682a6d78dd42fc51d5347df5a\",\"urn:rulespec:document-understanding:assertion:2a6086e0b9232c1aa12e33f07e2a1a552413e73d9b4c712ac78631b0d240fd81\",\"urn:rulespec:document-understanding:assertion:1825d129aeffb1820771991e16b306db9cc3eef385ff0408ecbf9061bc0ba24e\",\"urn:rulespec:document-understanding:assertion:8e1c77fdf7fa596cfc0c31f612695a22b441d0516baf6a4ddce0c1307c11db31\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":12387,\"evidence\":[{\"end\":12387,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ad0591b337fcaca14df1a92cb27aac8774b5c9537940c80b932d5894701336dc3:11855:12387:sha256-86f28fce773ea3f8a82ee0618487bc3ebb917cbcb18c012504389472dacabbe6\",\"quote\":\"The State licensing agency shall, in issuing each such license for the operation of a vending facility, give preference to blind persons who are in need of employment. Each such license shall be issued for an indefinite period but may be terminated by the State licensing agency if it is satisfied that the facility is not being operated in accordance with the rules and regulations prescribed by such licensing agency. Such licenses shall be issued only to applicants who are blind within the meaning of section 107e of this title.\",\"start\":11855},{\"end\":12133,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ad0591b337fcaca14df1a92cb27aac8774b5c9537940c80b932d5894701336dc3:12107:12133:sha256-896eb2d778bd637ed4e1bbd1d946f1116819db9f189780c06353042e604544cd\",\"quote\":\"the State licensing agency\",\"start\":12107},{\"end\":12103,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ad0591b337fcaca14df1a92cb27aac8774b5c9537940c80b932d5894701336dc3:12086:12103:sha256-0ea52f582823f4d4e370e99682e91a3bc49989958ca1965480b87e671ae501c2\",\"quote\":\"may be terminated\",\"start\":12086},{\"end\":12387,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ad0591b337fcaca14df1a92cb27aac8774b5c9537940c80b932d5894701336dc3:11855:12387:sha256-86f28fce773ea3f8a82ee0618487bc3ebb917cbcb18c012504389472dacabbe6\",\"quote\":\"The State licensing agency shall, in issuing each such license for the operation of a vending facility, give preference to blind persons who are in need of employment. Each such license shall be issued for an indefinite period but may be terminated by the State licensing agency if it is satisfied that the facility is not being operated in accordance with the rules and regulations prescribed by such licensing agency. Such licenses shall be issued only to applicants who are blind within the meaning of section 107e of this title.\",\"start\":11855}],\"id\":\"urn:rulespec:document-understanding:revision:e1c2b88f0993bdfd1bb0af846ab2441c3f80b9abf45129f920376175146c1d9e\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"permission\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:8e1c77fdf7fa596cfc0c31f612695a22b441d0516baf6a4ddce0c1307c11db31\",\"modality\":\"may\",\"modality_quote\":\"may be terminated\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:1afacf4b2001ea48b844058156a000e07aac972745edd0fb3afc6051b6703364\",\"origin\":\"aiSuggested\",\"quote\":\"The State licensing agency shall, in issuing each such license for the operation of a vending facility, give preference to blind persons who are in need of employment. Each such license shall be issued for an indefinite period but may be terminated by the State licensing agency if it is satisfied that the facility is not being operated in accordance with the rules and regulations prescribed by such licensing agency. Such licenses shall be issued only to applicants who are blind within the meaning of section 107e of this title.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:50cb797f977c490fc844f1517fa73b4e71a950e63fecd807a9bf14490ea0a493\",\"scope_quotes\":[\"The State licensing agency shall, in issuing each such license for the operation of a vending facility, give preference to blind persons who are in need of employment. Each such license shall be issued for an indefinite period but may be terminated by the State licensing agency if it is satisfied that the facility is not being operated in accordance with the rules and regulations prescribed by such licensing agency. Such licenses shall be issued only to applicants who are blind within the meaning of section 107e of this title.\"],\"scope_text\":\"if it is satisfied that the facility is not being operated in accordance with the rules and regulations prescribed by such licensing agency\",\"section_id\":\"urn:rulespec:document-understanding:section:6415b0472035d4c8d20ed41d5d849f0036b3031b0207f9d7b07a2cf92ce20e70\",\"start\":11855,\"summary\":\"Each license for the operation of a vending facility may be terminated by the State licensing agency if it is satisfied that the facility is not being operated in accordance with the rules and regulations prescribed by such licensing agency.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"The State licensing agency\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:5a01f0b66bc23435e511c1364864286c195944e889c5daecf1623eade33025f1\",\"urn:rulespec:document-understanding:assertion:360a666e908ce11d8b47c8db68f940cfb94afef9c0f04d69b1a0c9b0acb1eed7\",\"urn:rulespec:document-understanding:assertion:13b89e657c8cd63da07ce449e9127643d733a19dbec1012867b7e9c4d921f2cd\",\"urn:rulespec:document-understanding:assertion:73bd9cbeef01024d92e052694ad50dff22a6113ecc89e7de7406421da82d682e\",\"urn:rulespec:document-understanding:assertion:2c947c86ea0f3fb6721f5914546ecff57d577e75361c37401e052dc482e562bf\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":12387,\"evidence\":[{\"end\":12387,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ad0591b337fcaca14df1a92cb27aac8774b5c9537940c80b932d5894701336dc3:11855:12387:sha256-86f28fce773ea3f8a82ee0618487bc3ebb917cbcb18c012504389472dacabbe6\",\"quote\":\"The State licensing agency shall, in issuing each such license for the operation of a vending facility, give preference to blind persons who are in need of employment. Each such license shall be issued for an indefinite period but may be terminated by the State licensing agency if it is satisfied that the facility is not being operated in accordance with the rules and regulations prescribed by such licensing agency. Such licenses shall be issued only to applicants who are blind within the meaning of section 107e of this title.\",\"start\":11855},{\"end\":11881,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ad0591b337fcaca14df1a92cb27aac8774b5c9537940c80b932d5894701336dc3:11855:11881:sha256-eba569f6c461a8af0370907172c02e838c75126aa85582251185b3583b9f5588\",\"quote\":\"The State licensing agency\",\"start\":11855},{\"end\":12387,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ad0591b337fcaca14df1a92cb27aac8774b5c9537940c80b932d5894701336dc3:11855:12387:sha256-86f28fce773ea3f8a82ee0618487bc3ebb917cbcb18c012504389472dacabbe6\",\"quote\":\"The State licensing agency shall, in issuing each such license for the operation of a vending facility, give preference to blind persons who are in need of employment. Each such license shall be issued for an indefinite period but may be terminated by the State licensing agency if it is satisfied that the facility is not being operated in accordance with the rules and regulations prescribed by such licensing agency. Such licenses shall be issued only to applicants who are blind within the meaning of section 107e of this title.\",\"start\":11855}],\"id\":\"urn:rulespec:document-understanding:revision:657b5a6d29720be29b607c5f74f175e0db1b56195d2cc9eeec34dfdf575dd0c2\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:2c947c86ea0f3fb6721f5914546ecff57d577e75361c37401e052dc482e562bf\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:bace4c38640115b7bc4c1ffa2889b90bd48fae1ae4aaa5345dfd172189b86f5c\",\"origin\":\"aiSuggested\",\"quote\":\"The State licensing agency shall, in issuing each such license for the operation of a vending facility, give preference to blind persons who are in need of employment. Each such license shall be issued for an indefinite period but may be terminated by the State licensing agency if it is satisfied that the facility is not being operated in accordance with the rules and regulations prescribed by such licensing agency. Such licenses shall be issued only to applicants who are blind within the meaning of section 107e of this title.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:014199502a63e8f5afc6015378ad19b384f31193f03d14fc71c6cbbf6855bd68\",\"scope_quotes\":[\"The State licensing agency shall, in issuing each such license for the operation of a vending facility, give preference to blind persons who are in need of employment. Each such license shall be issued for an indefinite period but may be terminated by the State licensing agency if it is satisfied that the facility is not being operated in accordance with the rules and regulations prescribed by such licensing agency. Such licenses shall be issued only to applicants who are blind within the meaning of section 107e of this title.\"],\"scope_text\":\"in issuing each such license for the operation of a vending facility\",\"section_id\":\"urn:rulespec:document-understanding:section:6415b0472035d4c8d20ed41d5d849f0036b3031b0207f9d7b07a2cf92ce20e70\",\"start\":11855,\"summary\":\"The State licensing agency shall, in issuing each license for the operation of a vending facility, give preference to blind persons who are in need of employment.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

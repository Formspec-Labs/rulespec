      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:f9758c3872a52ff51f709a044492ee148f25db0ee543d07fa75799d8940a7041\",\"urn:rulespec:document-understanding:assertion:bb49c90b5d514fedf7b5da3f47f0239a15d5697d19b81a0beb0f2477116ce140\",\"urn:rulespec:document-understanding:assertion:8bc25603bb57b8106b263c70b98ed681e3a174f6bbf1dfc461615ff844bb6732\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":2724,\"evidence\":[{\"end\":2724,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ad0591b337fcaca14df1a92cb27aac8774b5c9537940c80b932d5894701336dc3:2145:2724:sha256-a193fad1b543ed0fcd6145e6d54bb8c3b669be45e93653e8fa7f683f3e0e71bc\",\"quote\":\"Any limitation on the placement or operation of a vending facility based on a finding that such placement or operation would adversely affect the interests of the United States shall be fully justified in writing to the Secretary, who shall determine whether such limitation is justified. A determination made by the Secretary pursuant to this provision shall be binding on any department, agency, or instrumentality of the United States affected by such determination. The Secretary shall publish such determination, along with supporting documentation, in the Federal Register.\",\"start\":2145}],\"id\":\"urn:rulespec:document-understanding:revision:4d583b2c97b471531eee3994c3b20277a800125caae693dd70ffc0a24be2edef\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"statement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:8bc25603bb57b8106b263c70b98ed681e3a174f6bbf1dfc461615ff844bb6732\",\"modality\":\"not_stated\",\"modality_quote\":\"\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:745492aaef9b2645413b43c87e115f1c183e0dfcd31978b8ef65d44ab4c38298\",\"origin\":\"aiSuggested\",\"quote\":\"Any limitation on the placement or operation of a vending facility based on a finding that such placement or operation would adversely affect the interests of the United States shall be fully justified in writing to the Secretary, who shall determine whether such limitation is justified. A determination made by the Secretary pursuant to this provision shall be binding on any department, agency, or instrumentality of the United States affected by such determination. The Secretary shall publish such determination, along with supporting documentation, in the Federal Register.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:235bb10bccf13918452e3d21c939a09fccdeecf1c918e8c336e416eea31e203e\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"urn:rulespec:document-understanding:section:0b77b7763a8a509356c532d1ebd94a378a61b60dc3ace6f9cd33abfeb2462a88\",\"start\":2145,\"summary\":\"A determination made by the Secretary regarding whether a limitation on the placement or operation of a vending facility is justified shall be binding on any department, agency, or instrumentality of the United States affected by such determination.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

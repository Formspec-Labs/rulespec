      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "Any limitation on the placement or operation of a vending facility based on a finding that such placement or operation would adversely affect the interests of the United States shall be fully justified in writing to the Secretary, who shall determine whether such limitation is justified. A determination made by the Secretary pursuant to this provision shall be binding on any department, agency, or instrumentality of the United States affected by such determination. The Secretary shall publish such determination, along with supporting documentation, in the Federal Register."
        },
        {
          "@type": "oa:TextPositionSelector",
          "oa:start": 2145,
          "oa:end": 2724,
          "rkaf:coordinateSystem": "rkaf:unicode-codepoint"
        }
      ]
    },

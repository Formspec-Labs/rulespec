    {
      "@id": "urn:rulespec:document-understanding:term:44b81463adcf8f46168f55ea26491c69ba9ac5ff3629abdc5ba8179e6f47bd34",
      "@type": "rkaf:LocalConcept",
      "skos:prefLabel": {
        "en": "satisfactory site"
      },
      "skos:definition": {
        "en": "For the purposes of 20 U.S.C. 107a(d), the term “satisfactory site” means an area determined by the Secretary to have sufficient space, electrical and plumbing outlets, and such other facilities as the Secretary may by regulation prescribe, for the location and operation of a vending facility by a blind person."
      },
      "skos:inScheme": "urn:rulespec:document-understanding:defined-term-scheme:d0591b337fcaca14df1a92cb27aac8774b5c9537940c80b932d5894701336dc3",

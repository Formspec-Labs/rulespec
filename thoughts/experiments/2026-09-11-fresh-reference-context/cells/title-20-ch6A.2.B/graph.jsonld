    {
      "@id": "urn:rulespec:document-understanding:revision:015c46a42116df164956523f2f98501c76ee79f93fca83a3d53d8ede5ac89091",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:015c46a42116df164956523f2f98501c76ee79f93fca83a3d53d8ede5ac89091",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:3a393919953819f8b47c195e5da967c73646721efa2ff44130ca927dfff66f4f",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:1a7e51895b19bd66d2dc7c90cdebdca645e60027dd4ce0722bcba822c06df926\",\"urn:rulespec:document-understanding:assertion:5daa8e82803e74c6ac9be25f6638ad5081b12ec7d6d99fc92f2a0d234030b838\",\"urn:rulespec:document-understanding:assertion:34960c55e8e32d408594483623b2c1635632c99680c99d422c8d3d2f510eb0e1\",\"urn:rulespec:document-understanding:assertion:469cdd0fe26f53e33c368fd70a9660d132b5b71cee07307c0eb071fc8b673694\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":2724,\"evidence\":[{\"end\":2724,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ad0591b337fcaca14df1a92cb27aac8774b5c9537940c80b932d5894701336dc3:2145:2724:sha256-a193fad1b543ed0fcd6145e6d54bb8c3b669be45e93653e8fa7f683f3e0e71bc\",\"quote\":\"Any limitation on the placement or operation of a vending facility based on a finding that such placement or operation would adversely affect the interests of the United States shall be fully justified in writing to the Secretary, who shall determine whether such limitation is justified. A determination made by the Secretary pursuant to this provision shall be binding on any department, agency, or instrumentality of the United States affected by such determination. The Secretary shall publish such determination, along with supporting documentation, in the Federal Register.\",\"start\":2145},{\"end\":2346,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ad0591b337fcaca14df1a92cb27aac8774b5c9537940c80b932d5894701336dc3:2322:2346:sha256-989334446d97b5880798d1cee495fabf7959ab86bfad2b0d1a1d54b54b5217f9\",\"quote\":\"shall be fully justified\",\"start\":2322},{\"end\":2724,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ad0591b337fcaca14df1a92cb27aac8774b5c9537940c80b932d5894701336dc3:2145:2724:sha256-a193fad1b543ed0fcd6145e6d54bb8c3b669be45e93653e8fa7f683f3e0e71bc\",\"quote\":\"Any limitation on the placement or operation of a vending facility based on a finding that such placement or operation would adversely affect the interests of the United States shall be fully justified in writing to the Secretary, who shall determine whether such limitation is justified. A determination made by the Secretary pursuant to this provision shall be binding on any department, agency, or instrumentality of the United States affected by such determination. The Secretary shall publish such determination, along with supporting documentation, in the Federal Register.\",\"start\":2145}],\"id\":\"urn:rulespec:document-understanding:revision:015c46a42116df164956523f2f98501c76ee79f93fca83a3d53d8ede5ac89091\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:469cdd0fe26f53e33c368fd70a9660d132b5b71cee07307c0eb071fc8b673694\",\"modality\":\"must\",\"modality_quote\":\"shall be fully justified\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:45a2cf58b3b6e8fbfc99303eb134aa969e1ac07c4a35185f68a83a7e8544be15\",\"origin\":\"aiSuggested\",\"quote\":\"Any limitation on the placement or operation of a vending facility based on a finding that such placement or operation would adversely affect the interests of the United States shall be fully justified in writing to the Secretary, who shall determine whether such limitation is justified. A determination made by the Secretary pursuant to this provision shall be binding on any department, agency, or instrumentality of the United States affected by such determination. The Secretary shall publish such determination, along with supporting documentation, in the Federal Register.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:ce68d53a098a75522a736b5c95c57b3b3d348d0d01af9f21958e2a3eba006eaf\",\"scope_quotes\":[\"Any limitation on the placement or operation of a vending facility based on a finding that such placement or operation would adversely affect the interests of the United States shall be fully justified in writing to the Secretary, who shall determine whether such limitation is justified. A determination made by the Secretary pursuant to this provision shall be binding on any department, agency, or instrumentality of the United States affected by such determination. The Secretary shall publish such determination, along with supporting documentation, in the Federal Register.\"],\"scope_text\":\"When a limitation on the placement or operation of a vending facility is based on a finding that such placement or operation would adversely affect the interests of the United States\",\"section_id\":\"urn:rulespec:document-understanding:section:0b77b7763a8a509356c532d1ebd94a378a61b60dc3ace6f9cd33abfeb2462a88\",\"start\":2145,\"summary\":\"Any limitation on the placement or operation of a vending facility based on a finding that such placement or operation would adversely affect the interests of the United States shall be fully justified in writing to the Secretary, who shall determine whether such limitation is justified.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

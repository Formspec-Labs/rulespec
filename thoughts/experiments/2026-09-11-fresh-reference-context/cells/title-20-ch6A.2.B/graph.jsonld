      "rkaf:assertsValue": {
        "@value": "{\"actor\":\"each such department, agency, and instrumentality\",\"kind\":\"requirement\",\"modality\":\"must\",\"summary\":\"Each department, agency, and instrumentality of the United States shall make every effort to lease property in privately owned buildings capable of accommodating a vending facility.\"}",
        "@type": "xsd:string"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

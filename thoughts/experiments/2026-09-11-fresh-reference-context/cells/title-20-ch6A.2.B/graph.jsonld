      "rkaf:assertsValue": {
        "@value": "to any privately owned building, any part of which is leased by any department, agency, or instrumentality of the United States and in which, (i) prior to the execution of such lease, the lessor or any of his tenants had in operation a restaurant or other food facility in a part of the building not included in such lease, and (ii) the operation of such a vending facility by a blind person would be in proximate and substantial direct competition with such restaurant or other food facility",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:1449fe436d08df150664d011bd15f1a1cf5f221fb95597492e03db0f1b161d81\",\"urn:rulespec:document-understanding:assertion:5e4b50c366482b98119a8a6a3c306b2a4eaa139f6bd7f468214025f8a37a393c\",\"urn:rulespec:document-understanding:assertion:de65747a1385008f04b78afcd2b0873e34ff06f3dfb2f6caeb2f5fe7212ffff1\",\"urn:rulespec:document-understanding:assertion:9a6c086ae04a339bde164eb1850934058fc709e625abd343eb0ee6c91dfed4cd\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":15175,\"evidence\":[{\"end\":15175,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ad0591b337fcaca14df1a92cb27aac8774b5c9537940c80b932d5894701336dc3:14279:15175:sha256-1b636c6a0a27b55cfd5fd996d9485194f46e829088bccebd9c5dfb226d9d48fe\",\"quote\":\"(2) The provisions of paragraph (1) shall not apply (A) when the Secretary and the State licensing agency determine that the number of people using the property is or will be insufficient to support a vending facility, or (B) to any privately owned building, any part of which is leased by any department, agency, or instrumentality of the United States and in which, (i) prior to the execution of such lease, the lessor or any of his tenants had in operation a restaurant or other food facility in a part of the building not included in such lease, and (ii) the operation of such a vending facility by a blind person would be in proximate and substantial direct competition with such restaurant or other food facility except that each such department, agency, and instrumentality shall make every effort to lease property in privately owned buildings capable of accommodating a vending facility.\",\"start\":14279},{\"end\":14330,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ad0591b337fcaca14df1a92cb27aac8774b5c9537940c80b932d5894701336dc3:14315:14330:sha256-7001dc18e4250cacd3b4c31ed3fe0df3af0a721931a03c64cc5478da04eb29bd\",\"quote\":\"shall not apply\",\"start\":14315},{\"end\":15175,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ad0591b337fcaca14df1a92cb27aac8774b5c9537940c80b932d5894701336dc3:14279:15175:sha256-1b636c6a0a27b55cfd5fd996d9485194f46e829088bccebd9c5dfb226d9d48fe\",\"quote\":\"(2) The provisions of paragraph (1) shall not apply (A) when the Secretary and the State licensing agency determine that the number of people using the property is or will be insufficient to support a vending facility, or (B) to any privately owned building, any part of which is leased by any department, agency, or instrumentality of the United States and in which, (i) prior to the execution of such lease, the lessor or any of his tenants had in operation a restaurant or other food facility in a part of the building not included in such lease, and (ii) the operation of such a vending facility by a blind person would be in proximate and substantial direct competition with such restaurant or other food facility except that each such department, agency, and instrumentality shall make every effort to lease property in privately owned buildings capable of accommodating a vending facility.\",\"start\":14279}],\"id\":\"urn:rulespec:document-understanding:revision:ce8c9d8683ddc42a8bfc092277d47b5720e18a40b792be0d938b3f1d3081c1bb\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"exemption\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:9a6c086ae04a339bde164eb1850934058fc709e625abd343eb0ee6c91dfed4cd\",\"modality\":\"not_required\",\"modality_quote\":\"shall not apply\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:0878457075ba710a2969933ff3c3a714f3fcfcb4ed02dd16a784c9d636f7a0eb\",\"origin\":\"aiSuggested\",\"quote\":\"(2) The provisions of paragraph (1) shall not apply (A) when the Secretary and the State licensing agency determine that the number of people using the property is or will be insufficient to support a vending facility, or (B) to any privately owned building, any part of which is leased by any department, agency, or instrumentality of the United States and in which, (i) prior to the execution of such lease, the lessor or any of his tenants had in operation a restaurant or other food facility in a part of the building not included in such lease, and (ii) the operation of such a vending facility by a blind person would be in proximate and substantial direct competition with such restaurant or other food facility except that each such department, agency, and instrumentality shall make every effort to lease property in privately owned buildings capable of accommodating a vending facility.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:70a1be33d909447245a16ca178b53aaa95ea540202e50a73126690ac80b2b3ce\",\"scope_quotes\":[\"(2) The provisions of paragraph (1) shall not apply (A) when the Secretary and the State licensing agency determine that the number of people using the property is or will be insufficient to support a vending facility, or (B) to any privately owned building, any part of which is leased by any department, agency, or instrumentality of the United States and in which, (i) prior to the execution of such lease, the lessor or any of his tenants had in operation a restaurant or other food facility in a part of the building not included in such lease, and (ii) the operation of such a vending facility by a blind person would be in proximate and substantial direct competition with such restaurant or other food facility except that each such department, agency, and instrumentality shall make every effort to lease property in privately owned buildings capable of accommodating a vending facility.\"],\"scope_text\":\"to any privately owned building, any part of which is leased by any department, agency, or instrumentality of the United States and in which, (i) prior to the execution of such lease, the lessor or any of his tenants had in operation a restaurant or other food facility in a part of the building not included in such lease, and (ii) the operation of such a vending facility by a blind person would be in proximate and substantial direct competition with such restaurant or other food facility\",\"section_id\":\"urn:rulespec:document-understanding:section:6415b0472035d4c8d20ed41d5d849f0036b3031b0207f9d7b07a2cf92ce20e70\",\"start\":14279,\"summary\":\"The provisions of 20 U.S.C. 107a(d)(1) shall not apply to any privately owned building, any part of which is leased by any department, agency, or instrumentality of the United States and in which (i) prior to the execution of such lease, the lessor or any of his tenants had in operation a restaurant or other food facility in a part of the building not included in such lease, and (ii) the operation of such a vending facility by a blind person would be in proximate and substantial direct competition with such restaurant or other food facility; except that each such department, agency, and instrumentality shall make every effort to lease property in privately owned buildings capable of accommodating a vending facility.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

    {
      "@id": "urn:rulespec:document-understanding:revision:21feb4621dea1ea11ac1e538c9c4e9b334e3354b703f53fdadb6e5095e84bef5",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:21feb4621dea1ea11ac1e538c9c4e9b334e3354b703f53fdadb6e5095e84bef5",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:d14d7f382a9f22defa3d25ad2631f91fac80c2d07891864db964ec1bf909627b",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"department, agency, or instrumentality of the United States\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:ed7a157f7e2d00d008e4594c80685fe6cdc0537994f20c367f89ca6afd1e0563\",\"urn:rulespec:document-understanding:assertion:1f26e63876fe58af17119516f9bd0e46a4b83ec24a02196a68c3705a88b61d9a\",\"urn:rulespec:document-understanding:assertion:e2fc7dc5d1df78b5eca69450b5c5f0c3a5f4080d48f67eecf943efd57effceb6\",\"urn:rulespec:document-understanding:assertion:678341d78f919e1d47819a00d7cb9c0d713dc3b2062681ecaabd3a4c0cdb856c\",\"urn:rulespec:document-understanding:assertion:4f051ac74a1963aede0729d4d5208465f1ec5be9f4d5e4e09114d5649a7d782d\",\"urn:rulespec:document-understanding:assertion:3961446f43997236d5d433c4fd8669b0e48cbbc0c4816d129625554226b0e889\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":14277,\"evidence\":[{\"end\":14277,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ad0591b337fcaca14df1a92cb27aac8774b5c9537940c80b932d5894701336dc3:12984:14277:sha256-3c4d020d620baf21dfd7daafca5f66cb69e23844ff45c437d6aea96d0353adf9\",\"quote\":\"(1) After January 1, 1975, no department, agency, or instrumentality of the United States shall undertake to acquire by ownership, rent, lease, or to otherwise occupy, in whole or in part, any building unless, after consultation with the head of such department, agency, or instrumentality and the State licensing agency, it is determined by the Secretary that (A) such building includes a satisfactory site or sites for the location and operation of a vending facility by a blind person, or (B) if a building is to be constructed, substantially altered, or renovated, or in the case of a building that is already occupied on such date by such department, agency, or instrumentality, is to be substantially altered or renovated for use by such department, agency, or instrumentality, the design for such construction, substantial alteration, or renovation includes a satisfactory site or sites for the location and operation of a vending facility by a blind person. Each such department, agency, or instrumentality shall provide notice to the appropriate State licensing agency of its plans for occupation, acquisition, renovation, or relocation of a building adequate to permit such State agency to determine whether such building includes a satisfactory site or sites for a vending facility.\",\"start\":12984},{\"end\":13073,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ad0591b337fcaca14df1a92cb27aac8774b5c9537940c80b932d5894701336dc3:13014:13073:sha256-33b098a461ffe5c0b5de76679cecb742df4ae5996fc2cccd628a7864b78dfb41\",\"quote\":\"department, agency, or instrumentality of the United States\",\"start\":13014},{\"end\":13089,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ad0591b337fcaca14df1a92cb27aac8774b5c9537940c80b932d5894701336dc3:13011:13089:sha256-2e856c930bfc7731613246a6edfca13f0f072b48e3225a67fef48514d28c5d46\",\"quote\":\"no department, agency, or instrumentality of the United States shall undertake\",\"start\":13011},{\"end\":14277,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ad0591b337fcaca14df1a92cb27aac8774b5c9537940c80b932d5894701336dc3:12984:14277:sha256-3c4d020d620baf21dfd7daafca5f66cb69e23844ff45c437d6aea96d0353adf9\",\"quote\":\"(1) After January 1, 1975, no department, agency, or instrumentality of the United States shall undertake to acquire by ownership, rent, lease, or to otherwise occupy, in whole or in part, any building unless, after consultation with the head of such department, agency, or instrumentality and the State licensing agency, it is determined by the Secretary that (A) such building includes a satisfactory site or sites for the location and operation of a vending facility by a blind person, or (B) if a building is to be constructed, substantially altered, or renovated, or in the case of a building that is already occupied on such date by such department, agency, or instrumentality, is to be substantially altered or renovated for use by such department, agency, or instrumentality, the design for such construction, substantial alteration, or renovation includes a satisfactory site or sites for the location and operation of a vending facility by a blind person. Each such department, agency, or instrumentality shall provide notice to the appropriate State licensing agency of its plans for occupation, acquisition, renovation, or relocation of a building adequate to permit such State agency to determine whether such building includes a satisfactory site or sites for a vending facility.\",\"start\":12984}],\"id\":\"urn:rulespec:document-understanding:revision:21feb4621dea1ea11ac1e538c9c4e9b334e3354b703f53fdadb6e5095e84bef5\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"prohibition\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:4f051ac74a1963aede0729d4d5208465f1ec5be9f4d5e4e09114d5649a7d782d\",\"modality\":\"must_not\",\"modality_quote\":\"no department, agency, or instrumentality of the United States shall undertake\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:9bc7f54eee2fc77049566daea9c97eb1ce80f48dafb61f188367c6efcfd0a694\",\"origin\":\"aiSuggested\",\"quote\":\"(1) After January 1, 1975, no department, agency, or instrumentality of the United States shall undertake to acquire by ownership, rent, lease, or to otherwise occupy, in whole or in part, any building unless, after consultation with the head of such department, agency, or instrumentality and the State licensing agency, it is determined by the Secretary that (A) such building includes a satisfactory site or sites for the location and operation of a vending facility by a blind person, or (B) if a building is to be constructed, substantially altered, or renovated, or in the case of a building that is already occupied on such date by such department, agency, or instrumentality, is to be substantially altered or renovated for use by such department, agency, or instrumentality, the design for such construction, substantial alteration, or renovation includes a satisfactory site or sites for the location and operation of a vending facility by a blind person. Each such department, agency, or instrumentality shall provide notice to the appropriate State licensing agency of its plans for occupation, acquisition, renovation, or relocation of a building adequate to permit such State agency to determine whether such building includes a satisfactory site or sites for a vending facility.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:0ae96df7c6bccbbf20e80e618d7a2efe387d05b1e64d7ca3605a18fc1cc4a635\",\"scope_quotes\":[\"(1) After January 1, 1975, no department, agency, or instrumentality of the United States shall undertake to acquire by ownership, rent, lease, or to otherwise occupy, in whole or in part, any building unless, after consultation with the head of such department, agency, or instrumentality and the State licensing agency, it is determined by the Secretary that (A) such building includes a satisfactory site or sites for the location and operation of a vending facility by a blind person, or (B) if a building is to be constructed, substantially altered, or renovated, or in the case of a building that is already occupied on such date by such department, agency, or instrumentality, is to be substantially altered or renovated for use by such department, agency, or instrumentality, the design for such construction, substantial alteration, or renovation includes a satisfactory site or sites for the location and operation of a vending facility by a blind person. Each such department, agency, or instrumentality shall provide notice to the appropriate State licensing agency of its plans for occupation, acquisition, renovation, or relocation of a building adequate to permit such State agency to determine whether such building includes a satisfactory site or sites for a vending facility.\"],\"scope_text\":\"After January 1, 1975, unless after consultation with the head of such department, agency, or instrumentality and the State licensing agency, it is determined by the Secretary that (A) such building includes a satisfactory site or sites for the location and operation of a vending facility by a blind person, or (B) if a building is to be constructed, substantially altered, or renovated, or in the case of a building that is already occupied on such date by such department, agency, or instrumentality, is to be substantially altered or renovated for use by such department, agency, or instrumentality, the design for such construction, substantial alteration, or renovation includes a satisfactory site or sites for the location and operation of a vending facility by a blind person\",\"section_id\":\"urn:rulespec:document-understanding:section:6415b0472035d4c8d20ed41d5d849f0036b3031b0207f9d7b07a2cf92ce20e70\",\"start\":12984,\"summary\":\"After January 1, 1975, no department, agency, or instrumentality of the United States shall undertake to acquire by ownership, rent, lease, or to otherwise occupy, in whole or in part, any building unless, after consultation with the head of such department, agency, or instrumentality and the State licensing agency, it is determined by the Secretary that (A) such building includes a satisfactory site or sites for the location and operation of a vending facility by a blind person, or (B) if a building is to be constructed, substantially altered, or renovated, or in the case of a building that is already occupied on such date by such department, agency, or instrumentality, is to be substantially altered or renovated for use by such department, agency, or instrumentality, the design for such construction, substantial alteration, or renovation includes a satisfactory site or sites for the location and operation of a vending facility by a blind person.\",\"target_ids\":[],\"term_refs\":[\"urn:rulespec:document-understanding:term:44b81463adcf8f46168f55ea26491c69ba9ac5ff3629abdc5ba8179e6f47bd34\"],\"typed_values\":[]}",

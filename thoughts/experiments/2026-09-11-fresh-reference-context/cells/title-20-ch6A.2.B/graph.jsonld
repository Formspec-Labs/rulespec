        "@value": "{\"actor\":\"Each such department, agency, or instrumentality\",\"kind\":\"requirement\",\"modality\":\"must\",\"summary\":\"Each department, agency, or instrumentality of the United States shall provide notice to the appropriate State licensing agency of its plans for occupation, acquisition, renovation, or relocation of a building adequate to permit such State agency to determine whether such building includes a satisfactory site or sites for a vending facility.\",\"term_refs\":[\"urn:rulespec:document-understanding:term:44b81463adcf8f46168f55ea26491c69ba9ac5ff3629abdc5ba8179e6f47bd34\"]}",

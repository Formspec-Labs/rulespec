    {
      "@id": "urn:rulespec:document-understanding:revision:9442aee14171eb9ecd9ca6c583f3446f4f4d6ef2efa1edd5d5c6643c48d56af0",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:9442aee14171eb9ecd9ca6c583f3446f4f4d6ef2efa1edd5d5c6643c48d56af0",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:2ee12b51f55c6c0f9bcce8b116a81bb74ae66e97f6565f148dfec016851b324a",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"each such department, agency, and instrumentality\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:13cf326eeeca7fddd5eb907f9095f811394af49126af4b8185c9df9aaa967a80\",\"urn:rulespec:document-understanding:assertion:6ea9d94d770ce37e7dc2ca49df5bda4ea38fac8a889866ef8ad47052cc2ef964\",\"urn:rulespec:document-understanding:assertion:ceb4d61f84c5a943760012246a03de1b7ea9327fdd16a55dfb838b69d08ef049\",\"urn:rulespec:document-understanding:assertion:4ac5f82f21a6d8ac1e0498afb90c4471d11035d8ae4f53eb581c43dcd9f7c2fe\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":15175,\"evidence\":[{\"end\":15175,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ad0591b337fcaca14df1a92cb27aac8774b5c9537940c80b932d5894701336dc3:14279:15175:sha256-1b636c6a0a27b55cfd5fd996d9485194f46e829088bccebd9c5dfb226d9d48fe\",\"quote\":\"(2) The provisions of paragraph (1) shall not apply (A) when the Secretary and the State licensing agency determine that the number of people using the property is or will be insufficient to support a vending facility, or (B) to any privately owned building, any part of which is leased by any department, agency, or instrumentality of the United States and in which, (i) prior to the execution of such lease, the lessor or any of his tenants had in operation a restaurant or other food facility in a part of the building not included in such lease, and (ii) the operation of such a vending facility by a blind person would be in proximate and substantial direct competition with such restaurant or other food facility except that each such department, agency, and instrumentality shall make every effort to lease property in privately owned buildings capable of accommodating a vending facility.\",\"start\":14279},{\"end\":15059,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ad0591b337fcaca14df1a92cb27aac8774b5c9537940c80b932d5894701336dc3:15010:15059:sha256-60f57095e17704d301971ded2207f1b81f46b1569b588b5c02d6e5808f7c4aed\",\"quote\":\"each such department, agency, and instrumentality\",\"start\":15010},{\"end\":15083,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ad0591b337fcaca14df1a92cb27aac8774b5c9537940c80b932d5894701336dc3:15060:15083:sha256-b3923a4136c15a8db72f37c9955dde6e42e3e0930f57ee76d47822bc4ef7946f\",\"quote\":\"shall make every effort\",\"start\":15060}],\"id\":\"urn:rulespec:document-understanding:revision:9442aee14171eb9ecd9ca6c583f3446f4f4d6ef2efa1edd5d5c6643c48d56af0\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:4ac5f82f21a6d8ac1e0498afb90c4471d11035d8ae4f53eb581c43dcd9f7c2fe\",\"modality\":\"must\",\"modality_quote\":\"shall make every effort\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:62185fe812e23b373761e66ced42a901b9569c416303e74e5fb731b8df7fb829\",\"origin\":\"aiSuggested\",\"quote\":\"(2) The provisions of paragraph (1) shall not apply (A) when the Secretary and the State licensing agency determine that the number of people using the property is or will be insufficient to support a vending facility, or (B) to any privately owned building, any part of which is leased by any department, agency, or instrumentality of the United States and in which, (i) prior to the execution of such lease, the lessor or any of his tenants had in operation a restaurant or other food facility in a part of the building not included in such lease, and (ii) the operation of such a vending facility by a blind person would be in proximate and substantial direct competition with such restaurant or other food facility except that each such department, agency, and instrumentality shall make every effort to lease property in privately owned buildings capable of accommodating a vending facility.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:ebd0495be2d264fce60c9e0eba56185a9a2913582946ddca2a6932d8f5744f26\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"urn:rulespec:document-understanding:section:6415b0472035d4c8d20ed41d5d849f0036b3031b0207f9d7b07a2cf92ce20e70\",\"start\":14279,\"summary\":\"Each department, agency, and instrumentality of the United States shall make every effort to lease property in privately owned buildings capable of accommodating a vending facility.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

    {
      "@id": "urn:rulespec:document-understanding:revision:0b571667d0c856dabcfa2ff172145d564cae83f8b7338413cfac9bf80471ef50",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:0b571667d0c856dabcfa2ff172145d564cae83f8b7338413cfac9bf80471ef50",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:8dd8300a0f434cfbd12bda8b3b630ba728dbc223de0fc6231309acc004f6182b",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:8a905c9f35c6cb68393c75484c9576b8f302a75458864f2d53b8b8a52ba4f6cc\",\"urn:rulespec:document-understanding:assertion:3987654cfd3e1bd2bba715ee710ac2630911bbc19aecc762e1bbe748851a97a4\",\"urn:rulespec:document-understanding:assertion:6d3b5309e255cc9bcc4e230756ce4177d23e355742048a80e16b5687552f57bc\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":12387,\"evidence\":[{\"end\":12387,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ad0591b337fcaca14df1a92cb27aac8774b5c9537940c80b932d5894701336dc3:11855:12387:sha256-86f28fce773ea3f8a82ee0618487bc3ebb917cbcb18c012504389472dacabbe6\",\"quote\":\"The State licensing agency shall, in issuing each such license for the operation of a vending facility, give preference to blind persons who are in need of employment. Each such license shall be issued for an indefinite period but may be terminated by the State licensing agency if it is satisfied that the facility is not being operated in accordance with the rules and regulations prescribed by such licensing agency. Such licenses shall be issued only to applicants who are blind within the meaning of section 107e of this title.\",\"start\":11855},{\"end\":12309,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ad0591b337fcaca14df1a92cb27aac8774b5c9537940c80b932d5894701336dc3:12289:12309:sha256-bff7465ef05208bb3531762882d4980f255a4fe5a63fe0e95a8ea14385c44efc\",\"quote\":\"shall be issued only\",\"start\":12289}],\"id\":\"urn:rulespec:document-understanding:revision:0b571667d0c856dabcfa2ff172145d564cae83f8b7338413cfac9bf80471ef50\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:6d3b5309e255cc9bcc4e230756ce4177d23e355742048a80e16b5687552f57bc\",\"modality\":\"must\",\"modality_quote\":\"shall be issued only\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:faf4dc98bb7a67424c4fab73bc7694398555cc8f258db4c7509bd805a11ab838\",\"origin\":\"aiSuggested\",\"quote\":\"The State licensing agency shall, in issuing each such license for the operation of a vending facility, give preference to blind persons who are in need of employment. Each such license shall be issued for an indefinite period but may be terminated by the State licensing agency if it is satisfied that the facility is not being operated in accordance with the rules and regulations prescribed by such licensing agency. Such licenses shall be issued only to applicants who are blind within the meaning of section 107e of this title.\",\"references\":[\"section 107e\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:12cea8ebe86fa707bbaf81035ddd096996d25b508737addbd811381720e2cdb5\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"urn:rulespec:document-understanding:section:6415b0472035d4c8d20ed41d5d849f0036b3031b0207f9d7b07a2cf92ce20e70\",\"start\":11855,\"summary\":\"Licenses for the operation of a vending facility shall be issued only to applicants who are blind within the meaning of section 107e of this title.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",
      "dcterms:references": [
        {
          "@id": "urn:rulespec:document-understanding:assertion:8a905c9f35c6cb68393c75484c9576b8f302a75458864f2d53b8b8a52ba4f6cc"
        },

      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"the Commissioner\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:f25363e8b5be82c7ddcdf7d5bae7deb49804e5bbcbdbb06e68318096a03fa5c9\",\"urn:rulespec:document-understanding:assertion:a55b83361a8e7fbcf13645e012aa68cc320bf949ca2201f8d9e44138331f0f94\",\"urn:rulespec:document-understanding:assertion:48028871cdae107e7f91e24be29bcf301b33224bb87f4b5f8a91afc0b9393ca7\",\"urn:rulespec:document-understanding:assertion:c079aabd60b2512ce7d2d9d20aeca0449bf03ae708516fbcbcd2782fa4c6fafe\",\"urn:rulespec:document-understanding:assertion:350066ae079f76f221c911171bf5e03e6f33a32c5ecf40552897e191a7ffdd90\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":9989,\"evidence\":[{\"end\":9989,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ad0591b337fcaca14df1a92cb27aac8774b5c9537940c80b932d5894701336dc3:9372:9989:sha256-00480ad27bf6252798ada953634d947aba5f990044d686d93e8a0f9b048080aa\",\"quote\":\"(1) Insure that the Rehabilitation Services Administration is the principal agency for carrying out this chapter; and the Commissioner shall, within one hundred and eighty days after enactment of the Randolph-Sheppard Act Amendments of 1974, establish requirements for the uniform application of this chapter by each State agency designated under paragraph (5) of this subsection, including appropriate accounting procedures, policies on the selection and establishment of new vending facilities, distribution of income to blind vendors, and the use and control of set-aside funds under section 107b(3) of this title;\",\"start\":9372},{\"end\":9506,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ad0591b337fcaca14df1a92cb27aac8774b5c9537940c80b932d5894701336dc3:9490:9506:sha256-6b80b360e46c1eeed5bdc6ff1c0a1a4887dc32ef35bbd0f9e12e4dc2230c24cb\",\"quote\":\"the Commissioner\",\"start\":9490},{\"end\":9512,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ad0591b337fcaca14df1a92cb27aac8774b5c9537940c80b932d5894701336dc3:9507:9512:sha256-56ee5b508706bf2de91712d85d6d1e11ddbff01949142ed6e8c22e3b1bed1c71\",\"quote\":\"shall\",\"start\":9507},{\"end\":9989,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ad0591b337fcaca14df1a92cb27aac8774b5c9537940c80b932d5894701336dc3:9372:9989:sha256-00480ad27bf6252798ada953634d947aba5f990044d686d93e8a0f9b048080aa\",\"quote\":\"(1) Insure that the Rehabilitation Services Administration is the principal agency for carrying out this chapter; and the Commissioner shall, within one hundred and eighty days after enactment of the Randolph-Sheppard Act Amendments of 1974, establish requirements for the uniform application of this chapter by each State agency designated under paragraph (5) of this subsection, including appropriate accounting procedures, policies on the selection and establishment of new vending facilities, distribution of income to blind vendors, and the use and control of set-aside funds under section 107b(3) of this title;\",\"start\":9372}],\"id\":\"urn:rulespec:document-understanding:revision:7a3982382d117e1c00847a92ddd56199a7db636ec0bce8005a6b9e8869617323\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:350066ae079f76f221c911171bf5e03e6f33a32c5ecf40552897e191a7ffdd90\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:ad75594a6fc836ee1a602fc72ff0d4a11b25885cda32a3177c3f1bb461968108\",\"origin\":\"aiSuggested\",\"quote\":\"(1) Insure that the Rehabilitation Services Administration is the principal agency for carrying out this chapter; and the Commissioner shall, within one hundred and eighty days after enactment of the Randolph-Sheppard Act Amendments of 1974, establish requirements for the uniform application of this chapter by each State agency designated under paragraph (5) of this subsection, including appropriate accounting procedures, policies on the selection and establishment of new vending facilities, distribution of income to blind vendors, and the use and control of set-aside funds under section 107b(3) of this title;\",\"references\":[\"section 107b(3)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:7ef4caa403d9ef01605b52efccbebc5722f70c647ddbc5052b7f930b71d8ae27\",\"scope_quotes\":[\"(1) Insure that the Rehabilitation Services Administration is the principal agency for carrying out this chapter; and the Commissioner shall, within one hundred and eighty days after enactment of the Randolph-Sheppard Act Amendments of 1974, establish requirements for the uniform application of this chapter by each State agency designated under paragraph (5) of this subsection, including appropriate accounting procedures, policies on the selection and establishment of new vending facilities, distribution of income to blind vendors, and the use and control of set-aside funds under section 107b(3) of this title;\"],\"scope_text\":\"within one hundred and eighty days after enactment of the Randolph-Sheppard Act Amendments of 1974\",\"section_id\":\"urn:rulespec:document-understanding:section:6415b0472035d4c8d20ed41d5d849f0036b3031b0207f9d7b07a2cf92ce20e70\",\"start\":9372,\"summary\":\"The Commissioner shall, within one hundred and eighty days after enactment of the Randolph-Sheppard Act Amendments of 1974, establish requirements for the uniform application of this chapter by each State agency designated under paragraph (5) of 20 U.S.C. 107a(a), including appropriate accounting procedures, policies on the selection and establishment of new vending facilities, distribution of income to blind vendors, and the use and control of set-aside funds under section 107b(3) of this title.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

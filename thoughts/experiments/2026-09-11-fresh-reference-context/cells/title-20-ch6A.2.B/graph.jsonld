    {
      "@id": "urn:rulespec:document-understanding:scope:3083cb4fcb3356d21f2c3a4bf3ea9ec80ec95eafb30cc6b06034a70f3942b122",
      "@type": "rkaf:ApplicabilityScope",
      "rkaf:appliesInJurisdiction": [],
      "rkaf:applicabilityCondition": "to any privately owned building, any part of which is leased by any department, agency, or instrumentality of the United States and in which, (i) prior to the execution of such lease, the lessor or any of his tenants had in operation a restaurant or other food facility in a part of the building not included in such lease, and (ii) the operation of such a vending facility by a blind person would be in proximate and substantial direct competition with such restaurant or other food facility"
    },
    {
      "@id": "urn:rulespec:document-understanding:assertion:1449fe436d08df150664d011bd15f1a1cf5f221fb95597492e03db0f1b161d81",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:290fedde659a0af241361e0bc2a64060df54edd36e78a4c6b9364018d5188e63",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:4a5875f2f46ce3cfdc7581c5673998553dc90d2a960ff7a6c4b0f06021c763d3",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:70a1be33d909447245a16ca178b53aaa95ea540202e50a73126690ac80b2b3ce",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:states-exemption",
      "rkaf:assertsValue": {
        "@value": "The provisions of 20 U.S.C. 107a(d)(1) shall not apply to any privately owned building, any part of which is leased by any department, agency, or instrumentality of the United States and in which (i) prior to the execution of such lease, the lessor or any of his tenants had in operation a restaurant or other food facility in a part of the building not included in such lease, and (ii) the operation of such a vending facility by a blind person would be in proximate and substantial direct competition with such restaurant or other food facility; except that each such department, agency, and instrumentality shall make every effort to lease property in privately owned buildings capable of accommodating a vending facility.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

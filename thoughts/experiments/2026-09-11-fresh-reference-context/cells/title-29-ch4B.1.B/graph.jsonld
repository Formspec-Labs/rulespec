    {
      "@id": "urn:rulespec:document-understanding:revision:2bd388333b82f3bf22d1e7ddcf67be2a0f0eef50e5b1c4cf4e50631e72b8599d",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:2bd388333b82f3bf22d1e7ddcf67be2a0f0eef50e5b1c4cf4e50631e72b8599d",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:2f99aa3c5489cd9019f02b69bb35b4ff05bbe1a02551ea6d75309d50cbc21d28",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"Secretary\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:5866b578f9e706db301a693d79702d401c620d008e93298c75f7ae62075bcd95\",\"urn:rulespec:document-understanding:assertion:e2ac74f90327f6b63f15afbbb39e742238f01f0f27d9ca1ce980bdef47b92eaa\",\"urn:rulespec:document-understanding:assertion:fc12d1f1b9a511022442a304ac9c0c04f60e3b0a12354bfe888d3c4bcf7634cf\",\"urn:rulespec:document-understanding:assertion:f5559880207d5d514104dc7121f2bab32bfc0c27d807f19a57df1b607a2be446\",\"urn:rulespec:document-understanding:assertion:42d1693d8ada3870009796ee10075895bf201ec5342ffdf782f92c7238d257ab\",\"urn:rulespec:document-understanding:assertion:bc668fc353f1083fe4f185c8bd13582641bca929ed187245f9589a726aa7dfa1\",\"urn:rulespec:document-understanding:assertion:3dedbb66082b58071fe1e81190974bdd836b44a7a1e6428df924fe6a831bcb49\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":16655,\"evidence\":[{\"end\":16655,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A034f7c0701641ac491c4788373a7cbb227323ee386a4483e5d3f3bbb6ac2d316:15306:16655:sha256-50290e1b765c281e548df63d4ae156ef0f89f4ac71d7fed402491154b2dfe35a\",\"quote\":\"It shall be the duty of the Secretary to assure that unemployment insurance and employment service offices in each State, as appropriate, upon request of a public agency administering or supervising the administration of a State program funded under part A of title IV of the Social Security Act [42 U.S.C. 601 et seq.], of a public agency charged with any duty or responsibility under any program or activity authorized or required under part D of title IV of such Act [42 U.S.C. 651 et seq.], or of a State agency charged with the administration of the supplemental nutrition assistance program in a State under the Food and Nutrition Act of 2008 (7 U.S.C. 2011 et seq.), shall (and, notwithstanding any other provision of law, is authorized to) furnish to such agency making the request, from any data contained in the files of any such office, information with respect to any individual specified in the request as to (1) whether such individual is receiving, has received, or has made application for, unemployment compensation, and the amount of any such compensation being received by such individual, (2) the current (or most recent) home address of such individual, and (3) whether such individual has refused an offer of employment and, if so, a description of the employment so offered and the terms, conditions, and rate of pay therefor.\",\"start\":15306},{\"end\":15343,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A034f7c0701641ac491c4788373a7cbb227323ee386a4483e5d3f3bbb6ac2d316:15334:15343:sha256-1395996a1068d26dcb8486df1e1db89b97a66f2ecf98d655defe059fcec4bd97\",\"quote\":\"Secretary\",\"start\":15334},{\"end\":15326,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A034f7c0701641ac491c4788373a7cbb227323ee386a4483e5d3f3bbb6ac2d316:15309:15326:sha256-9e09f1567f7f1ac882b178ea88b4149709851b6ead4e4f8e69769feb11091d55\",\"quote\":\"shall be the duty\",\"start\":15309},{\"end\":16655,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A034f7c0701641ac491c4788373a7cbb227323ee386a4483e5d3f3bbb6ac2d316:15306:16655:sha256-50290e1b765c281e548df63d4ae156ef0f89f4ac71d7fed402491154b2dfe35a\",\"quote\":\"It shall be the duty of the Secretary to assure that unemployment insurance and employment service offices in each State, as appropriate, upon request of a public agency administering or supervising the administration of a State program funded under part A of title IV of the Social Security Act [42 U.S.C. 601 et seq.], of a public agency charged with any duty or responsibility under any program or activity authorized or required under part D of title IV of such Act [42 U.S.C. 651 et seq.], or of a State agency charged with the administration of the supplemental nutrition assistance program in a State under the Food and Nutrition Act of 2008 (7 U.S.C. 2011 et seq.), shall (and, notwithstanding any other provision of law, is authorized to) furnish to such agency making the request, from any data contained in the files of any such office, information with respect to any individual specified in the request as to (1) whether such individual is receiving, has received, or has made application for, unemployment compensation, and the amount of any such compensation being received by such individual, (2) the current (or most recent) home address of such individual, and (3) whether such individual has refused an offer of employment and, if so, a description of the employment so offered and the terms, conditions, and rate of pay therefor.\",\"start\":15306}],\"id\":\"urn:rulespec:document-understanding:revision:2bd388333b82f3bf22d1e7ddcf67be2a0f0eef50e5b1c4cf4e50631e72b8599d\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:42d1693d8ada3870009796ee10075895bf201ec5342ffdf782f92c7238d257ab\",\"modality\":\"must\",\"modality_quote\":\"shall be the duty\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:86d06afe5253f19d9cb9bf6bae775c6935c67be99f4cd6ac833d84e1b5969d46\",\"origin\":\"aiSuggested\",\"quote\":\"It shall be the duty of the Secretary to assure that unemployment insurance and employment service offices in each State, as appropriate, upon request of a public agency administering or supervising the administration of a State program funded under part A of title IV of the Social Security Act [42 U.S.C. 601 et seq.], of a public agency charged with any duty or responsibility under any program or activity authorized or required under part D of title IV of such Act [42 U.S.C. 651 et seq.], or of a State agency charged with the administration of the supplemental nutrition assistance program in a State under the Food and Nutrition Act of 2008 (7 U.S.C. 2011 et seq.), shall (and, notwithstanding any other provision of law, is authorized to) furnish to such agency making the request, from any data contained in the files of any such office, information with respect to any individual specified in the request as to (1) whether such individual is receiving, has received, or has made application for, unemployment compensation, and the amount of any such compensation being received by such individual, (2) the current (or most recent) home address of such individual, and (3) whether such individual has refused an offer of employment and, if so, a description of the employment so offered and the terms, conditions, and rate of pay therefor.\",\"references\":[\"part A of title IV of the Social Security Act\",\"part D of title IV of such Act\",\"Food and Nutrition Act of 2008\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:4d6a5af8a0236e2293cb0e8f91aa27f4a7580db66b6563d0c1dc6e9378519892\",\"scope_quotes\":[\"It shall be the duty of the Secretary to assure that unemployment insurance and employment service offices in each State, as appropriate, upon request of a public agency administering or supervising the administration of a State program funded under part A of title IV of the Social Security Act [42 U.S.C. 601 et seq.], of a public agency charged with any duty or responsibility under any program or activity authorized or required under part D of title IV of such Act [42 U.S.C. 651 et seq.], or of a State agency charged with the administration of the supplemental nutrition assistance program in a State under the Food and Nutrition Act of 2008 (7 U.S.C. 2011 et seq.), shall (and, notwithstanding any other provision of law, is authorized to) furnish to such agency making the request, from any data contained in the files of any such office, information with respect to any individual specified in the request as to (1) whether such individual is receiving, has received, or has made application for, unemployment compensation, and the amount of any such compensation being received by such individual, (2) the current (or most recent) home address of such individual, and (3) whether such individual has refused an offer of employment and, if so, a description of the employment so offered and the terms, conditions, and rate of pay therefor.\"],\"scope_text\":\"upon request of a public agency administering or supervising the administration of a State program funded under part A of title IV of the Social Security Act [42 U.S.C. 601 et seq.], of a public agency charged with any duty or responsibility under any program or activity authorized or required under part D of title IV of such Act [42 U.S.C. 651 et seq.], or of a State agency charged with the administration of the supplemental nutrition assistance program in a State under the Food and Nutrition Act of 2008 (7 U.S.C. 2011 et seq.)\",\"section_id\":\"urn:rulespec:document-understanding:section:80835c86ea7dc4e3ace4a4479bf9d3e4ff2ffb6b59699984c4faaabf32ff5305\",\"start\":15306,\"summary\":\"It shall be the duty of the Secretary to assure that unemployment insurance and employment service offices in each State, as appropriate, upon request of a public agency administering or supervising the administration of a State program funded under part A of title IV of the Social Security Act, of a public agency charged with any duty or responsibility under any program or activity authorized or required under part D of title IV of such Act, or of a State agency charged with the administration of the supplemental nutrition assistance program in a State under the Food and Nutrition Act of 2008, shall furnish to such agency making the request, from any data contained in the files of any such office, information with respect to any individual specified in the request as to: (1) whether such individual is receiving, has received, or has made application for, unemployment compensation, and the amount of any such compensation being received by such individual; (2) the current (or most recent) home address of such individual; and (3) whether such individual has refused an offer of employment and, if so, a description of the employment so offered and the terms, conditions, and rate of pay therefor.\",\"target_ids\":[],\"term_refs\":[\"urn:rulespec:document-understanding:term:3ff3796b8912054a6894f47d3e304ec1b9a55216ea9731f88bb4f194eb79f88f\",\"urn:rulespec:document-understanding:term:7bc724f165b975ac4707905998f5a0868d16926cc0428bf5b125887d0d7b5847\"],\"typed_values\":[]}",

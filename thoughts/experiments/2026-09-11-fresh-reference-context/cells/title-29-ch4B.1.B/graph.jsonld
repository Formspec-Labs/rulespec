      "dcterms:description": "{\"action\":\"\",\"actor\":\"The Secretary\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:91aa28e33659c4fb6dda8fb304d833b4bdec8b214aa71be6ec8ccef1684d3b19\",\"urn:rulespec:document-understanding:assertion:e082070119164774b4dccbcdf46b928812ec82d4d441663580535863fca9383f\",\"urn:rulespec:document-understanding:assertion:1ccb0660b0ef02769909166f185621b6fe332831bedc7c8ac5bb4bdc5f253d46\",\"urn:rulespec:document-understanding:assertion:3e4a48f915b4ad716585bb59e73ffcf22870ed14bc151c3ec441ab6dee974ad7\",\"urn:rulespec:document-understanding:assertion:88b98b6d8fdef4a0a5da4dace43ae5a8a2b15652b471cfd965da05a41ac30e2c\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[\"(c) Public labor exchange services The Secretary shall—\"],\"defined_terms\":[],\"effective_periods\":[],\"end\":17184,\"evidence\":[{\"end\":17184,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A034f7c0701641ac491c4788373a7cbb227323ee386a4483e5d3f3bbb6ac2d316:16894:17184:sha256-0d8f988ddcb9f7a44a477b227d75c7b8c00cccb065e0cc9122524bacb4fdd44e\",\"quote\":\"(2) assist in the development of continuous improvement models for such nationwide system that ensure private sector satisfaction with the system and meet the demands of jobseekers relating to the system, and identify and disseminate information on best practices for such system; and and 1\",\"start\":16894}],\"id\":\"urn:rulespec:document-understanding:revision:34e07bc9b99c7ce1406cdffef7b740e1d80da1d7cc8785978f2b08da8fba3788\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:3e4a48f915b4ad716585bb59e73ffcf22870ed14bc151c3ec441ab6dee974ad7\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:ba0acb45f390449889c870127ae0da85532f7abb86505025a07add9fabb48ad8\",\"origin\":\"aiSuggested\",\"quote\":\"(2) assist in the development of continuous improvement models for such nationwide system that ensure private sector satisfaction with the system and meet the demands of jobseekers relating to the system, and identify and disseminate information on best practices for such system; and and 1\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:e85a426ce132307c2b34ff7c6729c0b1c94dfb16711b57aceeb14650fa202a1a\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"urn:rulespec:document-understanding:section:80835c86ea7dc4e3ace4a4479bf9d3e4ff2ffb6b59699984c4faaabf32ff5305\",\"start\":16894,\"summary\":\"The Secretary shall assist in the development of continuous improvement models for such nationwide system of public labor exchange services that ensure private sector satisfaction with the system and meet the demands of jobseekers relating to the system, and identify and disseminate information on best practices for such system.\",\"target_ids\":[],\"term_refs\":[\"urn:rulespec:document-understanding:term:3ff3796b8912054a6894f47d3e304ec1b9a55216ea9731f88bb4f194eb79f88f\"],\"typed_values\":[]}",

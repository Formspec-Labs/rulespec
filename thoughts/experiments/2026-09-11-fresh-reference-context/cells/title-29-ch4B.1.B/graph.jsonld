      "@id": "urn:rulespec:document-understanding:revision:2e78be9b37663ce58359be4f102442a471594e4321789f6d3a1abb271a11da3d",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:2e78be9b37663ce58359be4f102442a471594e4321789f6d3a1abb271a11da3d",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",

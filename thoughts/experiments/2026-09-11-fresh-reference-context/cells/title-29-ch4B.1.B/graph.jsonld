      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:53a5234795c14588188425de39d8b5439f66602d5288cd935bc94fe339d01e31\",\"urn:rulespec:document-understanding:assertion:c7d17dfd18f1ccdf81fafb87cc2e7ee21a4aaf03f9c67e49ca59655cbf21fbb1\",\"urn:rulespec:document-understanding:assertion:cda4315dd8e4001a78173b496c61d137b604346f6a95e72798e88870ed72489d\",\"urn:rulespec:document-understanding:assertion:b39b1179a3049afec5529cc9c57b40cfa807581227980e7fb0a5c130472d0f01\",\"urn:rulespec:document-understanding:assertion:7b74fa2e825b520f4b1c780b96db39008610fc4512b238d14b528f9680779f00\",\"urn:rulespec:document-understanding:assertion:128efa20f6243555f187a51c90590364b1fd3cac30b8ed007c26a25a3513762a\",\"urn:rulespec:document-understanding:assertion:c07da43c4599b106f9cf10730c5f9d882360a0f5eb53018c12c120ee30fa4efa\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":18609,\"evidence\":[{\"end\":18609,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A034f7c0701641ac491c4788373a7cbb227323ee386a4483e5d3f3bbb6ac2d316:18296:18609:sha256-b85414c2bef9897905d190372e83e2e7f35446b267ba11cf3b896fdca1210fb2\",\"quote\":\"In order to improve service delivery, avoid duplication of services, and enhance coordination of services, including location of staff to ensure access to services under section 49f(a) of this title statewide in underserved areas, employment service offices in each State shall be colocated with one-stop centers.\",\"start\":18296},{\"end\":18573,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A034f7c0701641ac491c4788373a7cbb227323ee386a4483e5d3f3bbb6ac2d316:18568:18573:sha256-56ee5b508706bf2de91712d85d6d1e11ddbff01949142ed6e8c22e3b1bed1c71\",\"quote\":\"shall\",\"start\":18568},{\"end\":18609,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A034f7c0701641ac491c4788373a7cbb227323ee386a4483e5d3f3bbb6ac2d316:18296:18609:sha256-b85414c2bef9897905d190372e83e2e7f35446b267ba11cf3b896fdca1210fb2\",\"quote\":\"In order to improve service delivery, avoid duplication of services, and enhance coordination of services, including location of staff to ensure access to services under section 49f(a) of this title statewide in underserved areas, employment service offices in each State shall be colocated with one-stop centers.\",\"start\":18296}],\"id\":\"urn:rulespec:document-understanding:revision:1be8836186e2f39b77b192e65aaadcbc8a89abca091d59b07033768a58469142\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:b39b1179a3049afec5529cc9c57b40cfa807581227980e7fb0a5c130472d0f01\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:dfa5503747a1859c755fd21b4eec0c22420503cc3f508a7147171c8fff526c14\",\"origin\":\"aiSuggested\",\"quote\":\"In order to improve service delivery, avoid duplication of services, and enhance coordination of services, including location of staff to ensure access to services under section 49f(a) of this title statewide in underserved areas, employment service offices in each State shall be colocated with one-stop centers.\",\"references\":[\"section 49f(a) of this title\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:a861c6a51206a1559fdfe0edfb7daa23877e8bb4e8b61a75a6e0922fd5d70c26\",\"scope_quotes\":[\"In order to improve service delivery, avoid duplication of services, and enhance coordination of services, including location of staff to ensure access to services under section 49f(a) of this title statewide in underserved areas, employment service offices in each State shall be colocated with one-stop centers.\"],\"scope_text\":\"In order to improve service delivery, avoid duplication of services, and enhance coordination of services, including location of staff to ensure access to services under section 49f(a) of this title statewide in underserved areas\",\"section_id\":\"urn:rulespec:document-understanding:section:80835c86ea7dc4e3ace4a4479bf9d3e4ff2ffb6b59699984c4faaabf32ff5305\",\"start\":18296,\"summary\":\"In order to improve service delivery, avoid duplication of services, and enhance coordination of services, including location of staff to ensure access to services under section 49f(a) of this title statewide in underserved areas, employment service offices in each State shall be colocated with one-stop centers.\",\"target_ids\":[],\"term_refs\":[\"urn:rulespec:document-understanding:term:9bab53fbeeece63c2a8eda7609dfbddef4dc32a1f2edcd727813fd9c61f4c727\",\"urn:rulespec:document-understanding:term:7bc724f165b975ac4707905998f5a0868d16926cc0428bf5b125887d0d7b5847\",\"urn:rulespec:document-understanding:term:fd164902d48b3ce41ef3709e14d7002f53cd5aea7446fa5a0231ef781283f3bf\"],\"typed_values\":[]}",

      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"unemployment insurance and employment service offices in each State\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:e7ef518c56312a2c203b33fbe2cef1ee170dd3e121190165eee265092a4521bd\",\"urn:rulespec:document-understanding:assertion:6c3247a7e030706755b21fe1cbf0bd8e0f878a475100d4c1a9966264f36987cb\",\"urn:rulespec:document-understanding:assertion:a52513f9b67988f14957e48797e68bee23f9f72f553a947c3830f9ff5f571b0c\",\"urn:rulespec:document-understanding:assertion:8316cc1f113aa4df79245749e08db7e84332d7e7e82214b9a267aea46cbebc0f\",\"urn:rulespec:document-understanding:assertion:8ca591f3835170eb15618a6f3790eaebff0c213528aa05f070583c667a6aaf91\",\"urn:rulespec:document-understanding:assertion:67c2c7b2e885b64cf377c33a351cd454e4ed46c40cd3523d15c774c8bbd34724\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":16655,\"evidence\":[{\"end\":16655,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A034f7c0701641ac491c4788373a7cbb227323ee386a4483e5d3f3bbb6ac2d316:15306:16655:sha256-50290e1b765c281e548df63d4ae156ef0f89f4ac71d7fed402491154b2dfe35a\",\"quote\":\"It shall be the duty of the Secretary to assure that unemployment insurance and employment service offices in each State, as appropriate, upon request of a public agency administering or supervising the administration of a State program funded under part A of title IV of the Social Security Act [42 U.S.C. 601 et seq.], of a public agency charged with any duty or responsibility under any program or activity authorized or required under part D of title IV of such Act [42 U.S.C. 651 et seq.], or of a State agency charged with the administration of the supplemental nutrition assistance program in a State under the Food and Nutrition Act of 2008 (7 U.S.C. 2011 et seq.), shall (and, notwithstanding any other provision of law, is authorized to) furnish to such agency making the request, from any data contained in the files of any such office, information with respect to any individual specified in the request as to (1) whether such individual is receiving, has received, or has made application for, unemployment compensation, and the amount of any such compensation being received by such individual, (2) the current (or most recent) home address of such individual, and (3) whether such individual has refused an offer of employment and, if so, a description of the employment so offered and the terms, conditions, and rate of pay therefor.\",\"start\":15306},{\"end\":15426,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A034f7c0701641ac491c4788373a7cbb227323ee386a4483e5d3f3bbb6ac2d316:15359:15426:sha256-84a53426ce3e015984ce68e5f7376989a8e465340cdbdcbbe7d167f248d8f28e\",\"quote\":\"unemployment insurance and employment service offices in each State\",\"start\":15359},{\"end\":16052,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A034f7c0701641ac491c4788373a7cbb227323ee386a4483e5d3f3bbb6ac2d316:16036:16052:sha256-99b99f6ee0f807e32b2a2c99f3ca55a3ef3c808479973e8823bffb6d64443f30\",\"quote\":\"is authorized to\",\"start\":16036},{\"end\":16655,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A034f7c0701641ac491c4788373a7cbb227323ee386a4483e5d3f3bbb6ac2d316:15306:16655:sha256-50290e1b765c281e548df63d4ae156ef0f89f4ac71d7fed402491154b2dfe35a\",\"quote\":\"It shall be the duty of the Secretary to assure that unemployment insurance and employment service offices in each State, as appropriate, upon request of a public agency administering or supervising the administration of a State program funded under part A of title IV of the Social Security Act [42 U.S.C. 601 et seq.], of a public agency charged with any duty or responsibility under any program or activity authorized or required under part D of title IV of such Act [42 U.S.C. 651 et seq.], or of a State agency charged with the administration of the supplemental nutrition assistance program in a State under the Food and Nutrition Act of 2008 (7 U.S.C. 2011 et seq.), shall (and, notwithstanding any other provision of law, is authorized to) furnish to such agency making the request, from any data contained in the files of any such office, information with respect to any individual specified in the request as to (1) whether such individual is receiving, has received, or has made application for, unemployment compensation, and the amount of any such compensation being received by such individual, (2) the current (or most recent) home address of such individual, and (3) whether such individual has refused an offer of employment and, if so, a description of the employment so offered and the terms, conditions, and rate of pay therefor.\",\"start\":15306}],\"id\":\"urn:rulespec:document-understanding:revision:2e78be9b37663ce58359be4f102442a471594e4321789f6d3a1abb271a11da3d\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"permission\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:8ca591f3835170eb15618a6f3790eaebff0c213528aa05f070583c667a6aaf91\",\"modality\":\"may\",\"modality_quote\":\"is authorized to\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:8ce49d3bce25bbc54c0d52d6e21ce6f5fd477d91f697673c9c499a66eed2e537\",\"origin\":\"aiSuggested\",\"quote\":\"It shall be the duty of the Secretary to assure that unemployment insurance and employment service offices in each State, as appropriate, upon request of a public agency administering or supervising the administration of a State program funded under part A of title IV of the Social Security Act [42 U.S.C. 601 et seq.], of a public agency charged with any duty or responsibility under any program or activity authorized or required under part D of title IV of such Act [42 U.S.C. 651 et seq.], or of a State agency charged with the administration of the supplemental nutrition assistance program in a State under the Food and Nutrition Act of 2008 (7 U.S.C. 2011 et seq.), shall (and, notwithstanding any other provision of law, is authorized to) furnish to such agency making the request, from any data contained in the files of any such office, information with respect to any individual specified in the request as to (1) whether such individual is receiving, has received, or has made application for, unemployment compensation, and the amount of any such compensation being received by such individual, (2) the current (or most recent) home address of such individual, and (3) whether such individual has refused an offer of employment and, if so, a description of the employment so offered and the terms, conditions, and rate of pay therefor.\",\"references\":[\"part A of title IV of the Social Security Act\",\"part D of title IV of such Act\",\"Food and Nutrition Act of 2008\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:953c6d6acabdd685f5ca6cb1cc3b0051d6248e001ebd96ad65872ed5f0a79cef\",\"scope_quotes\":[\"It shall be the duty of the Secretary to assure that unemployment insurance and employment service offices in each State, as appropriate, upon request of a public agency administering or supervising the administration of a State program funded under part A of title IV of the Social Security Act [42 U.S.C. 601 et seq.], of a public agency charged with any duty or responsibility under any program or activity authorized or required under part D of title IV of such Act [42 U.S.C. 651 et seq.], or of a State agency charged with the administration of the supplemental nutrition assistance program in a State under the Food and Nutrition Act of 2008 (7 U.S.C. 2011 et seq.), shall (and, notwithstanding any other provision of law, is authorized to) furnish to such agency making the request, from any data contained in the files of any such office, information with respect to any individual specified in the request as to (1) whether such individual is receiving, has received, or has made application for, unemployment compensation, and the amount of any such compensation being received by such individual, (2) the current (or most recent) home address of such individual, and (3) whether such individual has refused an offer of employment and, if so, a description of the employment so offered and the terms, conditions, and rate of pay therefor.\"],\"scope_text\":\"upon request of a public agency administering or supervising the administration of a State program funded under part A of title IV of the Social Security Act [42 U.S.C. 601 et seq.], of a public agency charged with any duty or responsibility under any program or activity authorized or required under part D of title IV of such Act [42 U.S.C. 651 et seq.], or of a State agency charged with the administration of the supplemental nutrition assistance program in a State under the Food and Nutrition Act of 2008 (7 U.S.C. 2011 et seq.)\",\"section_id\":\"urn:rulespec:document-understanding:section:80835c86ea7dc4e3ace4a4479bf9d3e4ff2ffb6b59699984c4faaabf32ff5305\",\"start\":15306,\"summary\":\"Notwithstanding any other provision of law, unemployment insurance and employment service offices in each State, as appropriate, are authorized, upon request of a public agency administering or supervising the administration of a State program funded under part A of title IV of the Social Security Act, of a public agency charged with any duty or responsibility under any program or activity authorized or required under part D of title IV of such Act, or of a State agency charged with the administration of the supplemental nutrition assistance program in a State under the Food and Nutrition Act of 2008, to furnish to such agency making the request, from any data contained in the files of any such office, information with respect to any individual specified in the request as to: (1) whether such individual is receiving, has received, or has made application for, unemployment compensation, and the amount of any such compensation being received by such individual; (2) the current (or most recent) home address of such individual; and (3) whether such individual has refused an offer of employment and, if so, a description of the employment so offered and the terms, conditions, and rate of pay therefor.\",\"target_ids\":[],\"term_refs\":[\"urn:rulespec:document-understanding:term:7bc724f165b975ac4707905998f5a0868d16926cc0428bf5b125887d0d7b5847\"],\"typed_values\":[]}",

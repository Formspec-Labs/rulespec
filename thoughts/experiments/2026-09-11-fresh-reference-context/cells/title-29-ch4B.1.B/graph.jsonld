      "dcterms:description": "{\"action\":\"\",\"actor\":\"The Secretary\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:479833cdbeebd58f74bd5689e5087224acc25d3e89b9cacc0a206acebefaebb6\",\"urn:rulespec:document-understanding:assertion:b671bef57f15be63b836e7923bdf6aa899126c3265553b861c14cf6b254eb160\",\"urn:rulespec:document-understanding:assertion:33191bec5cf40f6bb211120ba6c716404a4ce86c804dc240d9df0264ce1a6285\",\"urn:rulespec:document-understanding:assertion:9a1d44a4f008d998151b71e28aff097181a583367b839d975180019147304039\",\"urn:rulespec:document-understanding:assertion:cb50f7fdb75225537b17240bd63be4bd176e01d4676e0325ab93eac228128325\",\"urn:rulespec:document-understanding:assertion:51e5efa23654d5a2f3122fdc254e0b20bbadc0d008eeb4687a1e0a7ef99a9a1f\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[\"(c) Public labor exchange services The Secretary shall—\"],\"defined_terms\":[],\"effective_periods\":[],\"end\":17432,\"evidence\":[{\"end\":17432,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A034f7c0701641ac491c4788373a7cbb227323ee386a4483e5d3f3bbb6ac2d316:17205:17432:sha256-116e16b732bba412ac64a338c70436f6dca8e58947f6c0f635f4d017cf802685\",\"quote\":\"(3) ensure, for individuals otherwise eligible to receive unemployment compensation, the provision of reemployment services and other activities in which the individuals are required to participate to receive the compensation.2\",\"start\":17205},{\"end\":17432,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A034f7c0701641ac491c4788373a7cbb227323ee386a4483e5d3f3bbb6ac2d316:17205:17432:sha256-116e16b732bba412ac64a338c70436f6dca8e58947f6c0f635f4d017cf802685\",\"quote\":\"(3) ensure, for individuals otherwise eligible to receive unemployment compensation, the provision of reemployment services and other activities in which the individuals are required to participate to receive the compensation.2\",\"start\":17205}],\"id\":\"urn:rulespec:document-understanding:revision:cedf2e58207f6b20a8e5bb44cee9a0ee9b35ac3ac2b22617d9c3193accbec6df\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:cb50f7fdb75225537b17240bd63be4bd176e01d4676e0325ab93eac228128325\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:bffc0a85956df6e007ad43757edd6562799a07933daff8eb566326f6915f034b\",\"origin\":\"aiSuggested\",\"quote\":\"(3) ensure, for individuals otherwise eligible to receive unemployment compensation, the provision of reemployment services and other activities in which the individuals are required to participate to receive the compensation.2\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:501b2eddad0a643ff1e3702531b5ba2bd14a1640021b33dcbdb31d3cabfd61e8\",\"scope_quotes\":[\"(3) ensure, for individuals otherwise eligible to receive unemployment compensation, the provision of reemployment services and other activities in which the individuals are required to participate to receive the compensation.2\"],\"scope_text\":\"for individuals otherwise eligible to receive unemployment compensation\",\"section_id\":\"urn:rulespec:document-understanding:section:80835c86ea7dc4e3ace4a4479bf9d3e4ff2ffb6b59699984c4faaabf32ff5305\",\"start\":17205,\"summary\":\"The Secretary shall ensure, for individuals otherwise eligible to receive unemployment compensation, the provision of reemployment services and other activities in which the individuals are required to participate to receive the compensation.\",\"target_ids\":[],\"term_refs\":[\"urn:rulespec:document-understanding:term:3ff3796b8912054a6894f47d3e304ec1b9a55216ea9731f88bb4f
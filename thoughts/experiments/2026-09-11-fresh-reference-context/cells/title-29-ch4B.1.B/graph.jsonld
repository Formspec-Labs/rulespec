    {
      "@id": "urn:rulespec:document-understanding:assertion:42d1693d8ada3870009796ee10075895bf201ec5342ffdf782f92c7238d257ab",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:7883ae11cc97f7c3c2ec10e39f8a18fb4b5dc02ef519590f7aabb4cf490585df",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:e94684f886ede7f148884918f1aa8aef770846cfcff84ab912063cbbe835e4f5",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:4d6a5af8a0236e2293cb0e8f91aa27f4a7580db66b6563d0c1dc6e9378519892",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"actor\":\"Secretary\",\"kind\":\"requirement\",\"modality\":\"must\",\"scope_text\":\"upon request of a public agency administering or supervising the administration of a State program funded under part A of title IV of the Social Security Act [42 U.S.C. 601 et seq.], of a public agency charged with any duty or responsibility under any program or activity authorized or required under part D of title IV of such Act [42 U.S.C. 651 et seq.], or of a State agency charged with the administration of the supplemental nutrition assistance program in a State under the Food and Nutrition Act of 2008 (7 U.S.C. 2011 et seq.)\",\"summary\":\"It shall be the duty of the Secretary to assure that unemployment insurance and employment service offices in each State, as appropriate, upon request of a public agency administering or supervising the administration of a State program funded under part A of title IV of the Social Security Act, of a public agency charged with any duty or responsibility under any program or activity authorized or required under part D of title IV of such Act, or of a State agency charged with the administration of the supplemental nutrition assistance program in a State under the Food and Nutrition Act of 2008, shall furnish to such agency making the request, from any data contained in the files of any such office, information with respect to any individual specified in the request as to: (1) whether such individual is receiving, has received, or has made application for, unemployment compensation, and the amount of any such compensation being received by such individual; (2) the current (or most recent) home address of such individual; and (3) whether such individual has refused an offer of employment and, if so, a description of the employment so offered and the terms, conditions, and rate of pay therefor.\",\"term_refs\":[\"urn:rulespec:document-understanding:term:3ff3796b8912054a6894f47d3e304ec1b9a55216ea9731f88bb4f194eb79f88f\",\"urn:rulespec:document-understanding:term:7bc724f165b975ac4707905998f5a0868d16926cc0428bf5b125887d0d7b5847\"]}",
        "@type": "xsd:string"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed",
      "rkaf:hasApplicability": "urn:rulespec:document-understanding:scope:d9417166f3782c06a6221c55c32c0800bd07a78587c10a68f003c12202c93723"
    },

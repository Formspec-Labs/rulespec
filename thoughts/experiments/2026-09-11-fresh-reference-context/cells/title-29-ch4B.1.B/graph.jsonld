    {
      "@id": "urn:rulespec:document-understanding:revision:7d44decf999eb4ab4cf3edd59043ed159783d41a40932eba0a9b0eea86ca74df",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:7d44decf999eb4ab4cf3edd59043ed159783d41a40932eba0a9b0eea86ca74df",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:0793f8d7c0abe736b25efd2f75bd4e6490ec052884fc26e9e992fc1ee3e53862",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"The Secretary\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:981db0c6c34e4569e5e4fadd14b909b6abc8f62defd9eaf9af5c4ae7c5ed875b\",\"urn:rulespec:document-understanding:assertion:79f85819f49b7a4aa0935ef5667e7dca3b81e241936702c363e86cf52c404aeb\",\"urn:rulespec:document-understanding:assertion:a9b657aef92b4396fb0abc8570e29501f85b42385571818bd491ad54035888ad\",\"urn:rulespec:document-understanding:assertion:b047b7996da28dfd6a0690283ec4642b07039101b48a780bd7dca3dadd5f4e67\",\"urn:rulespec:document-understanding:assertion:e126ea195bfb9c83273c88a464fde2cd6aa6ec128e38e124c2500b4f9a506663\",\"urn:rulespec:document-understanding:assertion:785891c1f0822130369422269747a6fd40f9528c4a77228e96a9981620c4b674\",\"urn:rulespec:document-understanding:assertion:143717716c150b405d9b2868d582dd3f95424334f25ad6bd27c678ba676917a6\",\"urn:rulespec:document-understanding:assertion:6237017b6318ec37a5463bcae7e38c73404203e971caa4e079b53850cda4ec02\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[\"(c) Public labor exchange services The Secretary shall—\"],\"defined_terms\":[],\"effective_periods\":[],\"end\":18226,\"evidence\":[{\"end\":18226,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A034f7c0701641ac491c4788373a7cbb227323ee386a4483e5d3f3bbb6ac2d316:17492:18226:sha256-00dcb4609bc853704d1eb90db3eede35df6a0d69139ebd1709ae35477eafee1d\",\"quote\":\"(4) in coordination with the State agencies and the staff of such agencies, assist in the planning and implementation of activities to enhance the professional development and career advancement opportunities of such staff, in order to strengthen the provision of a broad range of career guidance services, the identification of job openings (including providing intensive outreach to small and medium-sized employers and enhanced employer services), the provision of technical assistance and training to other providers of workforce development activities (including workplace learning advisors) relating to counseling and employment-related services, and the development of new strategies for coordinating counseling and technology.\",\"start\":17492}],\"id\":\"urn:rulespec:document-understanding:revision:7d44decf999eb4ab4cf3edd59043ed159783d41a40932eba0a9b0eea86ca74df\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:b047b7996da28dfd6a0690283ec4642b07039101b48a780bd7dca3dadd5f4e67\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:5cf93225bfd32836d74b27bfa3aabb162745dd1a2303d246263d94897a60705f\",\"origin\":\"aiSuggested\",\"quote\":\"(4) in coordination with the State agencies and the staff of such agencies, assist in the planning and implementation of activities to enhance the professional development and career advancement opportunities of such staff, in order to strengthen the provision of a broad range of career guidance services, the identification of job openings (including providing intensive outreach to small and medium-sized employers and enhanced employer services), the provision of technical assistance and training to other providers of workforce development activities (including workplace learning advisors) relating to counseling and employment-related services, and the development of new strategies for coordinating counseling and technology.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:97ca8d88746139182202a9d7d4668d2b9cb1592622c633c3a024dce3ae9767d2\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"urn:rulespec:document-understanding:section:80835c86ea7dc4e3ace4a4479bf9d3e4ff2ffb6b59699984c4faaabf32ff5305\",\"start\":17492,\"summary\":\"The Secretary shall, in coordination with the State agencies and the staff of such agencies, assist in the planning and implementation of activities to enhance the professional development and career advancement opportunities of such staff, in order to strengthen the provision of a broad range of career guidance services, the identification of job openings (including providing intensive outreach to small and medium-sized employers and enhanced employer services), the provision of technical assistance and training to other providers of workforce development activities (including workplace learning advisors) relating to counseling and employment-related services, and the development of new strategies for coordinating counseling and technology.\",\"target_ids\":[],\"term_refs\":[\"urn:rulespec:document-understanding:term:3ff3796b8912054a6894f47d3e304ec1b9a55216ea9731f88bb4f194eb79f88f\",\"urn:rulespec:document-understanding:term:1022972358553398c51ea0a53a89df3cc945d4c057044fd3f3e7f5e6fb391fb6\",\"urn:rulespec:document-understanding:term:e5ad7bb0b99122e79e19996bfc271c912c2416925cbfdf83cc9c463786dacc46\",\"urn:rulespec:document-understanding:term:28c0cbe611f9c6490c40b1dde4560ce849a92de98f74f931359ed40d7d911e81\"],\"typed_values\":[]}",

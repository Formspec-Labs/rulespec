      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:d85749546a85494140ea8989fbff33492f15ed7890aa6e6d5d373f6da09e5bb9",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:0bd6984545c6a5747319d0260d607d010fc571b5b1d3e21b44056fee9568894d",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:7bfe424f4099cadbf029c204cabb8a714e5779ae370d15eb5b400802fd08dffe",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:states-authority",
      "rkaf:assertsValue": {
        "@value": "Notwithstanding any other provision of law, unemployment insurance and employment service offices in each State, as appropriate, are authorized to furnish to an agency making a request (being a public agency administering or supervising a State program funded under part A of title IV of the Social Security Act, a public agency charged with duty or responsibility under part D of title IV of such Act, or a State agency charged with administering the supplemental nutrition assistance program under the Food and Nutrition Act of 2008), from data in their files, specified information regarding an individual (unemployment compensation status and amount, address, and employment offer refusal details).",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

    {
      "@id": "urn:rulespec:document-understanding:revision:764cd60afd8298b4a73e3cb824a26455c73512d3caf88e9928f9824690ae31ba",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:764cd60afd8298b4a73e3cb824a26455c73512d3caf88e9928f9824690ae31ba",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:a9ad63b105c6d5cb93edf6d87ea167404d1232c067567b8e04b86485e2aa0b3a",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"Secretary\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:a73d730faf826d7efdb1eb1c7be97ffc351f4d96e00dc75918a65f0154161e93\",\"urn:rulespec:document-understanding:assertion:e2acfefd2f4b869acd2587eadef945e6cafdc0df6a2357afde58886677b0ab1b\",\"urn:rulespec:document-understanding:assertion:0ebbe4d25f6d6f718a1903f02c1c152da1f28bfa10dfbe880d25d31c22993eac\",\"urn:rulespec:document-understanding:assertion:5cd70279b0d969e98053613c99e689b291dca095e72e9882f9a29351d988cb8c\",\"urn:rulespec:document-understanding:assertion:e6303b895072b3db7a53a10361605ee14f7380b0ffdcd5a3d7854fc05940f4dc\",\"urn:rulespec:document-understanding:assertion:6c0f168b254a0383b3c0b1acc4960c685addff70c8ed27a9090f0805e819e281\",\"urn:rulespec:document-understanding:assertion:be8b11463f5c6bccba98381b129dfcbeb6c37403748f7e48685dbc247b2ec69d\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":3895,\"evidence\":[{\"end\":3895,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A034f7c0701641ac491c4788373a7cbb227323ee386a4483e5d3f3bbb6ac2d316:2871:3895:sha256-8aa56157e674de17f747126e2ed16fe546b5915a74e04b93a4e777f94d9638ee\",\"quote\":\"Pub. L. 93–198, title II, § 204(a), Dec. 24, 1973, 87 Stat. 783, provided that: “All functions of the Secretary of Labor (hereafter in this section referred to as the Secretary) under section 3 of the Act [section 49b of this title] entitled ‘An Act to provide for the establishment of a national employment system and for cooperation with the States in the promotion of such system, and for other purposes’, approved June 6, 1933 (29 U.S.C. 49–49k), with respect to the maintenance of a public employment service for the District [of Columbia], are transferred [effective July 1, 1974] to the Commissioner [of the District of Columbia established under Reorg. Plan No. 3 of 1967 (now the Mayor)]. After the effective date of this transfer [July 1, 1974], the Secretary shall maintain with the District the same relationship with respect to a public employment service in the District, including the financing of such service, as he has with the States (with respect to a public employment service in the States) generally.”\",\"start\":2871},{\"end\":3655,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A034f7c0701641ac491c4788373a7cbb227323ee386a4483e5d3f3bbb6ac2d316:3641:3655:sha256-ccbb638d410f763eefa8ec619b654b4932af01e8044d2ceab9031376c4a43267\",\"quote\":\"shall maintain\",\"start\":3641},{\"end\":3895,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A034f7c0701641ac491c4788373a7cbb227323ee386a4483e5d3f3bbb6ac2d316:2871:3895:sha256-8aa56157e674de17f747126e2ed16fe546b5915a74e04b93a4e777f94d9638ee\",\"quote\":\"Pub. L. 93–198, title II, § 204(a), Dec. 24, 1973, 87 Stat. 783, provided that: “All functions of the Secretary of Labor (hereafter in this section referred to as the Secretary) under section 3 of the Act [section 49b of this title] entitled ‘An Act to provide for the establishment of a national employment system and for cooperation with the States in the promotion of such system, and for other purposes’, approved June 6, 1933 (29 U.S.C. 49–49k), with respect to the maintenance of a public employment service for the District [of Columbia], are transferred [effective July 1, 1974] to the Commissioner [of the District of Columbia established under Reorg. Plan No. 3 of 1967 (now the Mayor)]. After the effective date of this transfer [July 1, 1974], the Secretary shall maintain with the District the same relationship with respect to a public employment service in the District, including the financing of such service, as he has with the States (with respect to a public employment service in the States) generally.”\",\"start\":2871}],\"id\":\"urn:rulespec:document-understanding:revision:764cd60afd8298b4a73e3cb824a26455c73512d3caf88e9928f9824690ae31ba\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:e6303b895072b3db7a53a10361605ee14f7380b0ffdcd5a3d7854fc05940f4dc\",\"modality\":\"must\",\"modality_quote\":\"shall maintain\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:b30c2999736b99b4c2a7de7d8a0794acedff3a924647357cfaadc3b0a042d34b\",\"origin\":\"aiSuggested\",\"quote\":\"Pub. L. 93–198, title II, § 204(a), Dec. 24, 1973, 87 Stat. 783, provided that: “All functions of the Secretary of Labor (hereafter in this section referred to as the Secretary) under section 3 of the Act [section 49b of this title] entitled ‘An Act to provide for the establishment of a national employment system and for cooperation with the States in the promotion of such system, and for other purposes’, approved June 6, 1933 (29 U.S.C. 49–49k), with respect to the maintenance of a public employment service for the District [of Columbia], are transferred [effective July 1, 1974] to the Commissioner [of the District of Columbia established under Reorg. Plan No. 3 of 1967 (now the Mayor)]. After the effective date of this transfer [July 1, 1974], the Secretary shall maintain with the District the same relationship with respect to a public employment service in the District, including the financing of such service, as he has with the States (with respect to a public employment service in the States) generally.”\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:8e59364abecea13da2b08307bb73ff53b8d9d5e57cd73dc35013cd7db6195326\",\"scope_quotes\":[\"Pub. L. 93–198, title II, § 204(a), Dec. 24, 1973, 87 Stat. 783, provided that: “All functions of the Secretary of Labor (hereafter in this section referred to as the Secretary) under section 3 of the Act [section 49b of this title] entitled ‘An Act to provide for the establishment of a national employment system and for cooperation with the States in the promotion of such system, and for other purposes’, approved June 6, 1933 (29 U.S.C. 49–49k), with respect to the maintenance of a public employment service for the District [of Columbia], are transferred [effective July 1, 1974] to the Commissioner [of the District of Columbia established under Reorg. Plan No. 3 of 1967 (now the Mayor)]. After the effective date of this transfer [July 1, 1974], the Secretary shall maintain with the District the same relationship with respect to a public employment service in the District, including the financing of such service, as he has with the States (with respect to a public employment service in the States) generally.”\"],\"scope_text\":\"After the effective date of this transfer [July 1, 1974]\",\"section_id\":\"urn:rulespec:document-understanding:section:9521dd0579bcf8c73c12c8c7a080ec40c372008e569012cef784adddf2c0be06\",\"start\":2871,\"summary\":\"After the effective date of the transfer (July 1, 1974), the Secretary shall maintain with the District of Columbia the same relationship with respect to a public employment service in the District, including the financing of such service, as the Secretary has with the States generally with respect to a public employment service in the States.\",\"target_ids\":[],\"term_refs\":[\"urn:rulespec:document-understanding:term:b69a4ae62effb6ca53097c50c82e49ea73287e27ee49eb4ac844abf75f709662\",\"urn:rulespec:document-understanding:term:5924a67b239770b2dfc6a4f0038b15a73ad5ae82e4f377348753d9aeff8eae4b\"],\"typed_values\":[]}",

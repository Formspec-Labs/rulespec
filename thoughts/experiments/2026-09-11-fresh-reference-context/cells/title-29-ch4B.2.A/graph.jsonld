    {
      "@id": "urn:rulespec:document-understanding:revision:55a909e79fe31fcf15314a699e76124c0f01b28d21e4d825c29f5bc3b0576284",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:55a909e79fe31fcf15314a699e76124c0f01b28d21e4d825c29f5bc3b0576284",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:0d214cf67f403fce843ca10cf953db921c67db6a577a65005d64e99d8b04cd20",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"Secretary\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:be516274640c5027a775bec76414124c43bbf93b45fcb688341c5c2121ece211\",\"urn:rulespec:document-understanding:assertion:b91fe80609b1ad189d0e78345fa37d42fc38fdd7284af071bbc177fc8b27308c\",\"urn:rulespec:document-understanding:assertion:8d586799042ec033dc3289a2bb49ab0f53b10d8fa25b688882d16cbfba89de99\",\"urn:rulespec:document-understanding:assertion:98e38fac81aa2d53e417ac1fb34f58cb5ba093d060dccd4de6d461bd7e09d2bb\",\"urn:rulespec:document-understanding:assertion:0a40570af154981bbc5a455cda6e1f3d0b8f61d4d53ba177ac33df6594bdd19b\",\"urn:rulespec:document-understanding:assertion:c4bb0e7c95bc0f2b8e80d0bacbc4f579b6044d923cd3d77b4f00adf0e68fa37a\",\"urn:rulespec:document-understanding:assertion:ea029128fdea2f92ee88c7e5971bb965505eb01576f9c83c8a3512a98991a6eb\",\"urn:rulespec:document-understanding:assertion:7ead84b88bb2ce9a5982928041f23c5fbc26ef4193134293dd01d087dce6c23e\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":16655,\"evidence\":[{\"end\":16655,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A034f7c0701641ac491c4788373a7cbb227323ee386a4483e5d3f3bbb6ac2d316:15306:16655:sha256-50290e1b765c281e548df63d4ae156ef0f89f4ac71d7fed402491154b2dfe35a\",\"quote\":\"It shall be the duty of the Secretary to assure that unemployment insurance and employment service offices in each State, as appropriate, upon request of a public agency administering or supervising the administration of a State program funded under part A of title IV of the Social Security Act [42 U.S.C. 601 et seq.], of a public agency charged with any duty or responsibility under any program or activity authorized or required under part D of title IV of such Act [42 U.S.C. 651 et seq.], or of a State agency charged with the administration of the supplemental nutrition assistance program in a State under the Food and Nutrition Act of 2008 (7 U.S.C. 2011 et seq.), shall (and, notwithstanding any other provision of law, is authorized to) furnish to such agency making the request, from any data contained in the files of any such office, information with respect to any individual specified in the request as to (1) whether such individual is receiving, has received, or has made application for, unemployment compensation, and the amount of any such compensation being received by such individual, (2) the current (or most recent) home address of such individual, and (3) whether such individual has refused an offer of employment and, if so, a description of the employment so offered and the terms, conditions, and rate of pay therefor.\",\"start\":15306},{\"end\":15343,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A034f7c0701641ac491c4788373a7cbb227323ee386a4483e5d3f3bbb6ac2d316:15330:15343:sha256-67afe9d5c4310238267da793c265a616f9e90d554f2458a8065b7bb971d853b5\",\"quote\":\"the Secretary\",\"start\":15330},{\"end\":15326,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A034f7c0701641ac491c4788373a7cbb227323ee386a4483e5d3f3bbb6ac2d316:15306:15326:sha256-5f15fc737d71cb9449e814c9eefbc88ea9e79d40be87109cbacc15e049428ff6\",\"quote\":\"It shall be the duty\",\"start\":15306},{\"end\":16655,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A034f7c0701641ac491c4788373a7cbb227323ee386a4483e5d3f3bbb6ac2d316:15306:16655:sha256-50290e1b765c281e548df63d4ae156ef0f89f4ac71d7fed402491154b2dfe35a\",\"quote\":\"It shall be the duty of the Secretary to assure that unemployment insurance and employment service offices in each State, as appropriate, upon request of a public agency administering or supervising the administration of a State program funded under part A of title IV of the Social Security Act [42 U.S.C. 601 et seq.], of a public agency charged with any duty or responsibility under any program or activity authorized or required under part D of title IV of such Act [42 U.S.C. 651 et seq.], or of a State agency charged with the administration of the supplemental nutrition assistance program in a State under the Food and Nutrition Act of 2008 (7 U.S.C. 2011 et seq.), shall (and, notwithstanding any other provision of law, is authorized to) furnish to such agency making the request, from any data contained in the files of any such office, information with respect to any individual specified in the request as to (1) whether such individual is receiving, has received, or has made application for, unemployment compensation, and the amount of any such compensation being received by such individual, (2) the current (or most recent) home address of such individual, and (3) whether such individual has refused an offer of employment and, if so, a description of the employment so offered and the terms, conditions, and rate of pay therefor.\",\"start\":15306}],\"id\":\"urn:rulespec:document-understanding:revision:55a909e79fe31fcf15314a699e76124c0f01b28d21e4d825c29f5bc3b0576284\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:0a40570af154981bbc5a455cda6e1f3d0b8f61d4d53ba177ac33df6594bdd19b\",\"modality\":\"must\",\"modality_quote\":\"It shall be the duty\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:5ac152163cf7cba281840fd80f8d188e714d146c24ac1467f2f4f62952b9c36b\",\"origin\":\"aiSuggested\",\"quote\":\"It shall be the duty of the Secretary to assure that unemployment insurance and employment service offices in each State, as appropriate, upon request of a public agency administering or supervising the administration of a State program funded under part A of title IV of the Social Security Act [42 U.S.C. 601 et seq.], of a public agency charged with any duty or responsibility under any program or activity authorized or required under part D of title IV of such Act [42 U.S.C. 651 et seq.], or of a State agency charged with the administration of the supplemental nutrition assistance program in a State under the Food and Nutrition Act of 2008 (7 U.S.C. 2011 et seq.), shall (and, notwithstanding any other provision of law, is authorized to) furnish to such agency making the request, from any data contained in the files of any such office, information with respect to any individual specified in the request as to (1) whether such individual is receiving, has received, or has made application for, unemployment compensation, and the amount of any such compensation being received by such individual, (2) the current (or most recent) home address of such individual, and (3) whether such individual has refused an offer of employment and, if so, a description of the employment so offered and the terms, conditions, and rate of pay therefor.\",\"references\":[\"part A of title IV of the Social Security Act [42 U.S.C. 601 et seq.]\",\"part D of title IV of such Act [42 U.S.C. 651 et seq.]\",\"Food and Nutrition Act of 2008 (7 U.S.C. 2011 et seq.)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:4837d78736e484b10dc49158e20441e1dfcc74870a5309a4af499660acef4ca2\",\"scope_quotes\":[\"It shall be the duty of the Secretary to assure that unemployment insurance and employment service offices in each State, as appropriate, upon request of a public agency administering or supervising the administration of a State program funded under part A of title IV of the Social Security Act [42 U.S.C. 601 et seq.], of a public agency charged with any duty or responsibility under any program or activity authorized or required under part D of title IV of such Act [42 U.S.C. 651 et seq.], or of a State agency charged with the administration of the supplemental nutrition assistance program in a State under the Food and Nutrition Act of 2008 (7 U.S.C. 2011 et seq.), shall (and, notwithstanding any other provision of law, is authorized to) furnish to such agency making the request, from any data contained in the files of any such office, information with respect to any individual specified in the request as to (1) whether such individual is receiving, has received, or has made application for, unemployment compensation, and the amount of any such compensation being received by such individual, (2) the current (or most recent) home address of such individual, and (3) whether such individual has refused an offer of employment and, if so, a description of the employment so offered and the terms, conditions, and rate of pay therefor.\"],\"scope_text\":\"upon request of a public agency administering or supervising the administration of a State program funded under part A of title IV of the Social Security Act [42 U.S.C. 601 et seq.], of a public agency charged with any duty or responsibility under any program or activity authorized or required under part D of title IV of such Act [42 U.S.C. 651 et seq.], or of a State agency charged with the administration of the supplemental nutrition assistance program in a State under the Food and Nutrition Act of 2008 (7 U.S.C. 2011 et seq.)\",\"section_id\":\"urn:rulespec:document-understanding:section:80835c86ea7dc4e3ace4a4479bf9d3e4ff2ffb6b59699984c4faaabf32ff5305\",\"start\":15306,\"summary\":\"It shall be the duty of the Secretary to assure that unemployment insurance and employment service offices in each State, as appropriate, upon request of a public agency administering or supervising the administration of a State program funded under part A of title IV of the Social Security Act, of a public agency charged with any duty or responsibility under any program or activity authorized or required under part D of title IV of such Act, or of a State agency charged with the administration of the supplemental nutrition assistance program in a State under the Food and Nutrition Act of 2008, shall furnish to such agency making the request, from any data contained in the files of any such office, information with respect to any individual specified in the request as to: (1) whether such individual is receiving, has received, or has made application for, unemployment compensation, and the amount of any such compensation being received by such individual; (2) the current (or most recent) home address of such individual; and (3) whether such individual has refused an offer of employment and, if so, a description of the employment so offered and the terms, conditions, and rate of pay therefor.\",\"target_ids\":[],\"term_refs\":[\"urn:rulespec:document-understanding:term:b69a4ae62effb6ca53097c50c82e49ea73287e27ee49eb4ac844abf75f709662\",\"urn:rulespec:document-understanding:term:5924a67b239770b2dfc6a4f0038b15a73ad5ae82e4f377348753d9aeff8eae4b\",\"urn:rulespec:document-understanding:term:9d646a54b074005d99977d034080b09fb7fb0ef7abe6fa67f894a28c1eb970b8\"],\"typed_values\":[]}",

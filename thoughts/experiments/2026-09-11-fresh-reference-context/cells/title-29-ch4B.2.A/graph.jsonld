      "rkaf:assertsValue": {
        "@value": "{\"actor\":\"unemployment insurance and employment service offices in each State\",\"kind\":\"authority\",\"modality\":\"may\",\"scope_text\":\"upon request of a public agency administering or supervising the administration of a State program funded under part A of title IV of the Social Security Act [42 U.S.C. 601 et seq.], of a public agency charged with any duty or responsibility under any program or activity authorized or required under part D of title IV of such Act [42 U.S.C. 651 et seq.], or of a State agency charged with the administration of the supplemental nutrition assistance program in a State under the Food and Nutrition Act of 2008 (7 U.S.C. 2011 et seq.)\",\"summary\":\"Notwithstanding any other provision of law, unemployment insurance and employment service offices in each State, as appropriate, are authorized to furnish to an agency making a request (being a public agency administering or supervising a State program funded under part A of title IV of the Social Security Act, a public agency charged with duty or responsibility under part D of title IV of such Act, or a State agency charged with administering the supplemental nutrition assistance program under the Food and Nutrition Act of 2008), from data in their files, specified information regarding an individual (unemployment compensation status and amount, address, and employment offer refusal details).\",\"term_refs\":[\"urn:rulespec:document-understanding:term:5924a67b239770b2dfc6a4f0038b15a73ad5ae82e4f377348753d9aeff8eae4b\",\"urn:rulespec:document-understanding:term:9d646a54b074005d99977d034080b09fb7fb0ef7abe6fa67f894a28c1eb970b8\"]}",

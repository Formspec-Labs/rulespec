      "dcterms:description": "{\"action\":\"\",\"actor\":\"Secretary\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:b35e2e81736568e3e7b75601b400485891fd6c279c15aed57926d21b71de995b\",\"urn:rulespec:document-understanding:assertion:d4d5ae0eb5df8fea9f39a7b330f4d32c9a7d368eeb7db3b73816eb242a943cb2\",\"urn:rulespec:document-understanding:assertion:6cd3ea190f96b0f862b6b15dc76a4613e970f6e42b23fca17831aa00fef27516\",\"urn:rulespec:document-understanding:assertion:6c24d0f99c62bfd028286e7f04843391bc45a55f69489c9fc335c2b165444df1\",\"urn:rulespec:document-understanding:assertion:fe502e7430f275a0dccd321e0d1f022b358e205196ced7648fc1c5d05beac824\",\"urn:rulespec:document-understanding:assertion:0095c9019c2844d8ed28190734b01de8d3083cf4f9d5e37f63a0ee0dc1fbe6cb\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":15247,\"evidence\":[{\"end\":15247,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A034f7c0701641ac491c4788373a7cbb227323ee386a4483e5d3f3bbb6ac2d316:14703:15247:sha256-131f15e85b35fb81c64fc8124d440f29ad86260280d3e2b5cdd20147898a3acf\",\"quote\":\"The Secretary shall assist in coordinating the State public employment service offices throughout the country and in increasing their usefulness by developing and prescribing minimum standards of efficiency, assisting them in meeting problems peculiar to their localities, promoting uniformity in their administrative and statistical procedure, furnishing and publishing information as to opportunities for employment and other information of value in the operation of the system, and maintaining a system for clearing labor between the States.\",\"start\":14703},{\"end\":14716,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A034f7c0701641ac491c4788373a7cbb227323ee386a4483e5d3f3bbb6ac2d316:14703:14716:sha256-d6dd2bb6d3c44b4545cc3f97cb6f8a38842ecd30d2c58ec3e1c53a8c1a0ac77c\",\"quote\":\"The Secretary\",\"start\":14703},{\"end\":14729,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A034f7c0701641ac491c4788373a7cbb227323ee386a4483e5d3f3bbb6ac2d316:14717:14729:sha256-80c5e074e3a172e33423dbd950781560a5ad30b10f4a0268478fab299d34580e\",\"quote\":\"shall assist\",\"start\":14717}],\"id\":\"urn:rulespec:document-understanding:revision:f9354f1e56e22ce1a5be30b0b6e7c5383f70b3be1e825b0d0603ccc06344db4f\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:6c24d0f99c62bfd028286e7f04843391bc45a55f69489c9fc335c2b165444df1\",\"modality\":\"must\",\"modality_quote\":\"shall assist\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:a58f88a68380c74c5e3483073b1b72ff9f661b2bed9322ed05e2b52b3f00eaa5\",\"origin\":\"aiSuggested\",\"quote\":\"The Secretary shall assist in coordinating the State public employment service offices throughout the country and in increasing their usefulness by developing and prescribing minimum standards of efficiency, assisting them in meeting problems peculiar to their localities, promoting uniformity in their administrative and statistical procedure, furnishing and publishing information as to opportunities for employment and other information of value in the operation of the system, and maintaining a system for clearing labor between the States.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:9ef1e9b5ac81e58139cd858e51741cb9cd568535ef8cb881108d476f0d4e9e57\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"urn:rulespec:document-understanding:section:80835c86ea7dc4e3ace4a4479bf9d3e4ff2ffb6b59699984c4faaabf32ff5305\",\"start\":14703,\"summary\":\"The Secretary shall assist in coordinating the State public employment service offices throughout the country and in increasing their usefulness by developing and prescribing minimum standards of efficiency, assisting them in meeting problems peculiar to their localities, promoting uniformity in their administrative and statistical procedure, furnishing and publishing information as to opportunities for employment and other information of value in the operation of the system, and maintaining a system for clearing labor between the States.\",\"target_ids\":[],\"term_refs\":[\"urn:rulespec:document-understanding:term:b69a4ae62effb6ca53097c50c82e49ea73287e27ee49eb4ac844abf75f709662\",\"urn:rulespec:document-understanding:term:5924a67b239770b2dfc6a4f0038b15a73ad5ae82e4f377348753d9aeff8eae4b\"],\"typed_values\":[]}",

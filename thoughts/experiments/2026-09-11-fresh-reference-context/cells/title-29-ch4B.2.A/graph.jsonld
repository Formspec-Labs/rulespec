      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"Secretary\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:88442753225ddca2d1a9e0d9cf5e61ab5e70d9c8b360a3333d33481455a306a2\",\"urn:rulespec:document-understanding:assertion:9d377e32da966e8be88716ce211673b89845d1fff72026cda4c9fa6db2de0a2b\",\"urn:rulespec:document-understanding:assertion:fb6e2c6bad81633c21fab2727a967fdbde42f44e7d74e60ebef31147e4d448b7\",\"urn:rulespec:document-understanding:assertion:399f28047b939b0024d07e3cf66ecddbee70843eccc2d73e03549d7ecb0ccbc6\",\"urn:rulespec:document-understanding:assertion:643376c4aef9c4fc97f4ec0a52e1e8458901bc78ad22b8bde7008a9c0cd93663\",\"urn:rulespec:document-understanding:assertion:d1f85e56e7bec60270a4e151d4e2abfc5090a2c9123ee66b003dfe420a1fc93f\",\"urn:rulespec:document-understanding:assertion:240b7e10122cf1bd25566f78f46c61514409bffc7fa534991c8b8e2058765207\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":18226,\"evidence\":[{\"end\":18226,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A034f7c0701641ac491c4788373a7cbb227323ee386a4483e5d3f3bbb6ac2d316:17492:18226:sha256-00dcb4609bc853704d1eb90db3eede35df6a0d69139ebd1709ae35477eafee1d\",\"quote\":\"(4) in coordination with the State agencies and the staff of such agencies, assist in the planning and implementation of activities to enhance the professional development and career advancement opportunities of such staff, in order to strengthen the provision of a broad range of career guidance services, the identification of job openings (including providing intensive outreach to small and medium-sized employers and enhanced employer services), the provision of technical assistance and training to other providers of workforce development activities (including workplace learning advisors) relating to counseling and employment-related services, and the development of new strategies for coordinating counseling and technology.\",\"start\":17492},{\"end\":18226,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A034f7c0701641ac491c4788373a7cbb227323ee386a4483e5d3f3bbb6ac2d316:17492:18226:sha256-00dcb4609bc853704d1eb90db3eede35df6a0d69139ebd1709ae35477eafee1d\",\"quote\":\"(4) in coordination with the State agencies and the staff of such agencies, assist in the planning and implementation of activities to enhance the professional development and career advancement opportunities of such staff, in order to strengthen the provision of a broad range of career guidance services, the identification of job openings (including providing intensive outreach to small and medium-sized employers and enhanced employer services), the provision of technical assistance and training to other providers of workforce development activities (including workplace learning advisors) relating to counseling and employment-related services, and the development of new strategies for coordinating counseling and technology.\",\"start\":17492}],\"id\":\"urn:rulespec:document-understanding:revision:ccd61c6eed8ae635a6caf4f611de1b48f80b2aa2385be2a9b68da2d7bf5027a0\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:643376c4aef9c4fc97f4ec0a52e1e8458901bc78ad22b8bde7008a9c0cd93663\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:b5ffce5e98cc6d523e76db4f16deec27b5e95eb200613653fa2de2cec513ec3a\",\"origin\":\"aiSuggested\",\"quote\":\"(4) in coordination with the State agencies and the staff of such agencies, assist in the planning and implementation of activities to enhance the professional development and career advancement opportunities of such staff, in order to strengthen the provision of a broad range of career guidance services, the identification of job openings (including providing intensive outreach to small and medium-sized employers and enhanced employer services), the provision of technical assistance and training to other providers of workforce development activities (including workplace learning advisors) relating to counseling and employment-related services, and the development of new strategies for coordinating counseling and technology.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:85afa76fd621310d9b99490bb9b9dfb4ef78ff1bf27f8a876dddac0ec6fcde9b\",\"scope_quotes\":[\"(4) in coordination with the State agencies and the staff of such agencies, assist in the planning and implementation of activities to enhance the professional development and career advancement opportunities of such staff, in order to strengthen the provision of a broad range of career guidance services, the identification of job openings (including providing intensive outreach to small and medium-sized employers and enhanced employer services), the provision of technical assistance and training to other providers of workforce development activities (including workplace learning advisors) relating to counseling and employment-related services, and the development of new strategies for coordinating counseling and technology.\"],\"scope_text\":\"in coordination with the State agencies and the staff of such agencies\",\"section_id\":\"urn:rulespec:document-understanding:section:80835c86ea7dc4e3ace4a4479bf9d3e4ff2ffb6b59699984c4faaabf32ff5305\",\"start\":17492,\"summary\":\"The Secretary shall, in coordination with the State agencies and the staff of such agencies, assist in the planning and implementation of activities to enhance the professional development and career advancement opportunities of such staff, in order to strengthen the provision of a broad range of career guidance services, the identification of job openings (including providing intensive outreach to small and medium-sized employers and enhanced employer services), the provision of technical assistance and training to other providers of workforce development activities (including workplace learning advisors) relating to counseling and employment-related services, and the development of new strategies for coordinating counseling and technology.\",\"target_ids\":[],\"term_refs\":[\"urn:rulespec:document-understanding:term:b69a4ae62effb6ca53097c50c82e49ea73287e27ee49eb4ac844abf75f709662\",\"urn:rulespec:document-understanding:term:9d646a54b074005d99977d034080b09fb7fb0ef7abe6fa67f894a28c1eb970b8\"],\"typed_values\":[]}",

      "dcterms:description": "{\"action\":\"\",\"actor\":\"unemployment insurance and employment service offices in each State\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:16ea530b622e05be6bbf6352e908869d95c859c44c30e8fce572b5d28c857fdf\",\"urn:rulespec:document-understanding:assertion:8652301689da535441c7a78b6f710d1e6bc5f172aa09fe1d9bc5daa186539cf6\",\"urn:rulespec:document-understanding:assertion:77f136cfc610f3960c57578e7acd67d9e916f39e21684e6341a04a5a090b249b\",\"urn:rulespec:document-understanding:assertion:5bb8c1ebc7d0874e87013ef914e8d51af0c636773285f80a8cfd50984442773d\",\"urn:rulespec:document-understanding:assertion:28a18580a92da44a6035b884d85d4a2286437d604037bdb81e122b1d30837e02\",\"urn:rulespec:document-understanding:assertion:e78b0e9ab22d79464943db4dde2f0395a9a7bfd6691f21d90b66089d0f907928\",\"urn:rulespec:document-understanding:assertion:9a155abd99e8ae20b22fef96e4d6c68fd91632def1b180ee3c10514c068de1fd\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":16655,\"evidence\":[{\"end\":16655,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A034f7c0701641ac491c4788373a7cbb227323ee386a4483e5d3f3bbb6ac2d316:15306:16655:sha256-50290e1b765c281e548df63d4ae156ef0f89f4ac71d7fed402491154b2dfe35a\",\"quote\":\"It shall be the duty of the Secretary to assure that unemployment insurance and employment service offices in each State, as appropriate, upon request of a public agency administering or supervising the administration of a State program funded under part A of title IV of the Social Security Act [42 U.S.C. 601 et seq.], of a public agency charged with any duty or responsibility under any program or activity authorized or required under part D of title IV of such Act [42 U.S.C. 651 et seq.], or of a State agency charged with the administration of the supplemental nutrition assistance program in a State under the Food and Nutrition Act of 2008 (7 U.S.C. 2011 et seq.), shall (and, notwithstanding any other provision of law, is authorized to) furnish to such agency making the request, from any data contained in the files of any such office, information with respect to any individual specified in the request as to (1) whether such individual is receiving, has received, or has made application for, unemployment compensation, and the amount of any such compensation being received by such individual, (2) the current (or most recent) home address of such individual, and (3) whether such individual has refused an offer of employment and, if so, a description of the employment so offered and the terms, conditions, and rate of pay therefor.\",\"start\":15306},{\"end\":15426,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A034f7c0701641ac491c4788373a7cbb227323ee386a4483e5d3f3bbb6ac2d316:15359:15426:sha256-84a53426ce3e015984ce68e5f7376989a8e465340cdbdcbbe7d167f248d8f28e\",\"quote\":\"unemployment insurance and employment service offices in each State\",\"start\":15359},{\"end\":16052,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A034f7c0701641ac491c4788373a7cbb227323ee386a4483e5d3f3bbb6ac2d316:16036:16052:sha256-99b99f6ee0f807e32b2a2c99f3ca55a3ef3c808479973e8823bffb6d64443f30\",\"quote\":\"is authorized to\",\"start\":16036},{\"end\":16655,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A034f7c0701641ac491c4788373a7cbb227323ee386a4483e5d3f3bbb6ac2d316:15306:16655:sha256-50290e1b765c281e548df63d4ae156ef0f89f4ac71d7fed402491154b2dfe35a\",\"quote\":\"It shall be the duty of the Secretary to assure that unemployment insurance and employment service offices in each State, as appropriate, upon request of a public agency administering or supervising the administration of a State program funded under part A of title IV of the Social Security Act [42 U.S.C. 601 et seq.], of a public agency charged with any duty or responsibility under any program or activity authorized or required under part D of title IV of such Act [42 U.S.C. 651 et seq.], or of a State agency charged with the administration of the supplemental nutrition assistance program in a State under the Food and Nutrition Act of 2008 (7 U.S.C. 2011 et seq.), shall (and, notwithstanding any other provision of law, is authorized to) furnish to such agency making the request, from any data contained in the files of any such office, information with respect to any individual specified in the request as to (1) whether such individual is receiving, has received, or has made application for, unemployment compensation, and the amount of any such compensation being received by such individual, (2) the current (or most recent) home address of such individual, and (3) whether such individual has refused an offer of employment and, if so, a description of the employment so offered and the terms, conditions, and rate of pay therefor.\",\"start\":15306}],\"id\":\"urn:rulespec:document-understanding:revision:89e9a76bc25bb01512961c7d0bb0e1447a1c4b63411d8154d5405b1da3bc092a\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"authority\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:28a18580a92da44a6035b884d85d4a2286437d604037bdb81e122b1d30837e02\",\"modality\":\"may\",\"modality_quote\":\"is authorized to\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:082e202c3d9d6285952bf93bd435c8a595c904ee09caa564b057dd6d4d294e4d\",\"origin\":\"aiSuggested\",\"quote\":\"It shall be the duty of the Secretary to assure that unemployment insurance and employment service offices in each State, as appropriate, upon request of a public agency administering or supervising the administration of a State program funded under part A of title IV of the Social Security Act [42 U.S.C. 601 et seq.], of a public agency charged with any duty or responsibility under any program or activity authorized or required under part D of title IV of such Act [42 U.S.C. 651 et seq.], or of a State agency charged with the administration of the supplemental nutrition assistance program in a State under the Food and Nutrition Act of 2008 (7 U.S.C. 2011 et seq.), shall (and, notwithstanding any other provision of law, is authorized to) furnish to such agency making the request, from any data contained in the files of any such office, information with respect to any individual specified in the request as to (1) whether such individual is receiving, has received, or has made application for, unemployment compensation, and the amount of any such compensation being received by such individual, (2) the current (or most recent) home address of such individual, and (3) whether such individual has refused an offer of employment and, if so, a description of the employment so offered and the terms, conditions, and rate of pay therefor.\",\"references\":[\"part A of title IV of the Social Security Act [42 U.S.C. 601 et seq.]\",\"part D of title IV of such Act [42 U.S.C. 651 et seq.]\",\"Food and Nutrition Act of 2008 (7 U.S.C. 2011 et seq.)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:7bfe424f4099cadbf029c204cabb8a714e5779ae370d15eb5b400802fd08dffe\",\"scope_quotes\":[\"It shall be the duty of the Secretary to assure that unemployment insurance and employment service offices in each State, as appropriate, upon request of a public agency administering or supervising the administration of a State program funded under part A of title IV of the Social Security Act [42 U.S.C. 601 et seq.], of a public agency charged with any duty or responsibility under any program or activity authorized or required under part D of title IV of such Act [42 U.S.C. 651 et seq.], or of a State agency charged with the administration of the supplemental nutrition assistance program in a State under the Food and Nutrition Act of 2008 (7 U.S.C. 2011 et seq.), shall (and, notwithstanding any other provision of law, is authorized to) furnish to such agency making the request, from any data contained in the files of any such office, information with respect to any individual specified in the request as to (1) whether such individual is receiving, has received, or has made application for, unemployment compensation, and the amount of any such compensation being received by such individual, (2) the current (or most recent) home address of such individual, and (3) whether such individual has refused an offer of employment and, if so, a description of the employment so offered and the terms, conditions, and rate of pay therefor.\"],\"scope_text\":\"upon request of a public agency administering or supervising the administration of a State program funded under part A of title IV of the Social Security Act [42 U.S.C. 601 et seq.], of a public agency charged with any duty or responsibility under any program or activity authorized or required under part D of title IV of such Act [42 U.S.C. 651 et seq.], or of a State agency charged with the administration of the supplemental nutrition assistance program in a State under the Food and Nutrition Act of 2008 (7 U.S.C. 2011 et seq.)\",\"section_id\":\"urn:rulespec:document-understanding:section:80835c86ea7dc4e3ace4a4479bf9d3e4ff2ffb6b59699984c4faaabf32ff5305\",\"start\":15306,\"summary\":\"Notwithstanding any other provision of law, unemployment insurance and employment service offices in each State, as appropriate, are authorized to furnish to an agency making a request (being a public agency administering or supervising a State program funded under part A of title IV of the Social Security Act, a public agency charged with duty or responsibility under part D of title IV of such Act, or a State agency charged with administering the supplemental nutrition assistance program under the Food and Nutrition Act of 2008), from data in their files, specified information regarding an individual (unemployment compensation status and amount, address, and employment offer refusal details).\",\"target_ids\":[],\"term_refs\":[\"urn:rulespec:document-understanding:term:5924a67b239770b2dfc6a4f0038b15a73ad5ae82e4f377348753d9aeff8eae4b\",\"urn:rulespec:document-understanding:term:9d646a54b074005d99977d034080b09fb7fb0ef7abe6fa67f894a28c1eb970b8\"],\"typed_values\":[]}",

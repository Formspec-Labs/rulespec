      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:b32cd4f8b2462ed1a08902e2d2d683612afc36bc2e93126071f354258b5db2ee\",\"urn:rulespec:document-understanding:assertion:5eb04c925eb58cf0b0050f6905b5f2ace295ca7899c2c02b1ef75eec042a3ab9\",\"urn:rulespec:document-understanding:assertion:c92e39a7c4ef8c53db2db4e171ea12d3d6e4cb92051b31dd7a69ef6bd396fc43\",\"urn:rulespec:document-understanding:assertion:a23e091e42077071d29d45f877e2ab9e4b0d48dfc71bfa305909eec8af58d329\",\"urn:rulespec:document-understanding:assertion:0b62a673e6ccff16f0c255b92ece30efb8e2a84480d25ead57ee477f92289cc9\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":18609,\"evidence\":[{\"end\":18609,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A034f7c0701641ac491c4788373a7cbb227323ee386a4483e5d3f3bbb6ac2d316:18296:18609:sha256-b85414c2bef9897905d190372e83e2e7f35446b267ba11cf3b896fdca1210fb2\",\"quote\":\"In order to improve service delivery, avoid duplication of services, and enhance coordination of services, including location of staff to ensure access to services under section 49f(a) of this title statewide in underserved areas, employment service offices in each State shall be colocated with one-stop centers.\",\"start\":18296},{\"end\":18586,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A034f7c0701641ac491c4788373a7cbb227323ee386a4483e5d3f3bbb6ac2d316:18568:18586:sha256-7866303d752b219ad83360ff4d95d0eddb1cc0fe41027cdaa7358f7ab365f0f9\",\"quote\":\"shall be colocated\",\"start\":18568}],\"id\":\"urn:rulespec:document-understanding:revision:30286ad0e9a106e5f3b3237fbf9acf7d14819d5a70a3b1df5c9b11586ebbfcfa\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kin
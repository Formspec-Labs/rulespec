      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:f81e587cb917093dd25fd74d9d7206918384b2ab55542bfb993b36553d48e7b9\",\"urn:rulespec:document-understanding:assertion:6df5bf0a3972c1b79ac636dd9653d5db42e1be173c077f2b3541ca0a4cf61a6c\",\"urn:rulespec:document-understanding:assertion:3f8dfcce21a5713dfc1e23dc21fc1eac6529169471e7f81a73307ebd5ccaee58\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":2816,\"evidence\":[{\"end\":2816,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A034f7c0701641ac491c4788373a7cbb227323ee386a4483e5d3f3bbb6ac2d316:2381:2816:sha256-abf9734aa04afdd8e131cc90b11c5be9e88205efab6ac897da82f96f15dc0e67\",\"quote\":\"Act June 6, 1933, ch. 49, § 16, formerly § 15, as added by Pub. L. 97–300, title VI, § 601(h), formerly title V, § 501(h), Oct. 13, 1982, 96 Stat. 1397; renumbered title VI, § 601(h), Pub. L. 100–628, title VII, § 712(a)(1), (2), Nov. 7, 1988, 102 Stat. 3248; renumbered § 16, Pub. L. 105–220, title III, § 309(1), Aug. 7, 1998, 112 Stat. 1082, provided that: “This Act [enacting this chapter] may be cited as the ‘Wagner-Peyser Act’.”\",\"start\":2381},{\"end\":2787,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A034f7c0701641ac491c4788373a7cbb227323ee386a4483e5d3f3bbb6ac2d316:2775:2787:sha256-a860fa2a483940fb7cab9ccb79fd9939545872ae81a9d430e006a7125292a6a4\",\"quote\":\"may be cited\",\"start\":2775}],\"id\":\"urn:rulespec:document-understanding:revision:10a48f2ca96918c6b0885751e5d8b41d86e39121e604aad1c9506b499c16692a\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"permission\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:3f8dfcce21a5713dfc1e23dc21fc1eac6529169471e7f81a73307ebd5ccaee58\",\"modality\":\"may\",\"modality_quote\":\"may be cited\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:e3c40b1acb4593325d3fea3499f49e1ed1c734fe1d8b3d9020757e0ccbc8b49a\",\"origin\":\"aiSuggested\",\"quote\":\"Act June 6, 1933, ch. 49, § 16, formerly § 15, as added by Pub. L. 97–300, title VI, § 601(h), formerly title V, § 501(h), Oct. 13, 1982, 96 Stat. 1397; renumbered title VI, § 601(h), Pub. L. 100–628, title VII, § 712(a)(1), (2), Nov. 7, 1988, 102 Stat. 3248; renumbered § 16, Pub. L. 105–220, title III, § 309(1), Aug. 7, 1998, 112 Stat. 1082, provided that: “This Act [enacting this chapter] may be cited as the ‘Wagner-Peyser Act’.”\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:e448f15c5e374a970d2e9f49e6d0a41bd7af7577805d526716b09bd97ea826c1\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"urn:rulespec:document-understanding:section:9521dd0579bcf8c73c12c8c7a080ec40c372008e569012cef784adddf2c0be06\",\"start\":2381,\"summary\":\"The Act of June 6, 1933, ch. 49, enacting this chapter, may be cited as the 'Wagner-Peyser Act'.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

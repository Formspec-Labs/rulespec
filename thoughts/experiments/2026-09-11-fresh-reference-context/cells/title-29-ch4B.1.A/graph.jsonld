    {
      "@id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A034f7c0701641ac491c4788373a7cbb227323ee386a4483e5d3f3bbb6ac2d316:2871:3895:sha256-8aa56157e674de17f747126e2ed16fe546b5915a74e04b93a4e777f94d9638ee",
      "@type": "rkaf:SourceFragment",
      "oa:hasSource": "urn:rulespec:document-understanding:document:034f7c0701641ac491c4788373a7cbb227323ee386a4483e5d3f3bbb6ac2d316",
      "rkaf:fragmentIdentityScheme": "rkaf:carrier-local-fragment",
      "rkaf:sourceArtifactDigest": "sha256:034f7c0701641ac491c4788373a7cbb227323ee386a4483e5d3f3bbb6ac2d316",
      "rkaf:fragmentContentDigest": "sha256:8aa56157e674de17f747126e2ed16fe546b5915a74e04b93a4e777f94d9638ee",
      "rkaf:selectorKind": [
        "oa:TextQuoteSelector",

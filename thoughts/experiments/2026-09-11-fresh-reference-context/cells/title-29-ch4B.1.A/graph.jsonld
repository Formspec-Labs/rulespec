    {
      "@id": "urn:rulespec:document-understanding:revision:9be670775786630a148f6c7dafcb71c3b1c0b59772258b90b95461a74ab520e3",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:9be670775786630a148f6c7dafcb71c3b1c0b59772258b90b95461a74ab520e3",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:83dc0af7d40df5637f81d03d2e3d16f1db97f25b40bcbc71b6362cbd73443915",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"the Secretary\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:09fd244c548c222185b30d5f964447da8d6a1223af5cd3bbbbac6f8726793e2d\",\"urn:rulespec:document-understanding:assertion:1beaaf2b7784bdea4703dfa325636ddaf3b16400f110a57c9757070a5a90232f\",\"urn:rulespec:document-understanding:assertion:d85d6bb66d2b6259d07564cf7f80ac34991c29d9185eaf5916b47acee7231e20\",\"urn:rulespec:document-understanding:assertion:44e8cf8f504958034a76181816dae3056755574e0fd350986ec7cba64772dfce\",\"urn:rulespec:document-understanding:assertion:d4dda47ec22dade08d84c1065e20a273e6ac52c1b20aee78eb86b50d649170f6\",\"urn:rulespec:document-understanding:assertion:a68c77b99ff91743c6161e619247c66d425bb9b2ebf27a216b5c166895c1cb37\",\"urn:rulespec:document-understanding:assertion:98c6507ccc72857219a165d8bc34b0dc8cb4293dbdca9d7975ac329ca5e8efa8\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":16655,\"evidence\":[{\"end\":16655,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A034f7c0701641ac491c4788373a7cbb227323ee386a4483e5d3f3bbb6ac2d316:15306:16655:sha256-50290e1b765c281e548df63d4ae156ef0f89f4ac71d7fed402491154b2dfe35a\",\"quote\":\"It shall be the duty of the Secretary to assure that unemployment insurance and employment service offices in each State, as appropriate, upon request of a public agency administering or supervising the administration of a State program funded under part A of title IV of the Social Security Act [42 U.S.C. 601 et seq.], of a public agency charged with any duty or responsibility under any program or activity authorized or required under part D of title IV of such Act [42 U.S.C. 651 et seq.], or of a State agency charged with the administration of the supplemental nutrition assistance program in a State under the Food and Nutrition Act of 2008 (7 U.S.C. 2011 et seq.), shall (and, notwithstanding any other provision of law, is authorized to) furnish to such agency making the request, from any data contained in the files of any such office, information with respect to any individual specified in the request as to (1) whether such individual is receiving, has received, or has made application for, unemployment compensation, and the amount of any such compensation being received by such individual, (2) the current (or most recent) home address of such individual, and (3) whether such individual has refused an offer of employment and, if so, a description of the employment so offered and the terms, conditions, and rate of pay therefor.\",\"start\":15306},{\"end\":15353,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A034f7c0701641ac491c4788373a7cbb227323ee386a4483e5d3f3bbb6ac2d316:15322:15353:sha256-2d4be50195cb0867af017a02a75ea6e6bcac450c60afa3828d2f4009afa440fc\",\"quote\":\"duty of the Secretary to assure\",\"start\":15322},{\"end\":15353,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A034f7c0701641ac491c4788373a7cbb227323ee386a4483e5d3f3bbb6ac2d316:15309:15353:sha256-519c3406f97a2cd54878d9998c2581b74d966f1e1d692065436636c4d52a768d\",\"quote\":\"shall be the duty of the Secretary to assure\",\"start\":15309}],\"id\":\"urn:rulespec:document-understanding:revision:9be670775786630a148f6c7dafcb71c3b1c0b59772258b90b95461a74ab520e3\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:44e8cf8f504958034a76181816dae3056755574e0fd350986ec7cba64772dfce\",\"modality\":\"must\",\"modality_quote\":\"shall be the duty of the Secretary to assure\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:51af5d3d798db30c6ad35b464f73cd24a0c02fb4ee91000c45a1441b9cd466ff\",\"origin\":\"aiSuggested\",\"quote\":\"It shall be the duty of the Secretary to assure that unemployment insurance and employment service offices in each State, as appropriate, upon request of a public agency administering or supervising the administration of a State program funded under part A of title IV of the Social Security Act [42 U.S.C. 601 et seq.], of a public agency charged with any duty or responsibility under any program or activity authorized or required under part D of title IV of such Act [42 U.S.C. 651 et seq.], or of a State agency charged with the administration of the supplemental nutrition assistance program in a State under the Food and Nutrition Act of 2008 (7 U.S.C. 2011 et seq.), shall (and, notwithstanding any other provision of law, is authorized to) furnish to such agency making the request, from any data contained in the files of any such office, information with respect to any individual specified in the request as to (1) whether such individual is receiving, has received, or has made application for, unemployment compensation, and the amount of any such compensation being received by such individual, (2) the current (or most recent) home address of such individual, and (3) whether such individual has refused an offer of employment and, if so, a description of the employment so offered and the terms, conditions, and rate of pay therefor.\",\"references\":[\"part A of title IV of the Social Security Act [42 U.S.C. 601 et seq.]\",\"part D of title IV of such Act [42 U.S.C. 651 et seq.]\",\"Food and Nutrition Act of 2008 (7 U.S.C. 2011 et seq.)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:b01f8708457fa9070041e2fac56613a82dba15ecf09d64589d64e573bdea7c68\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"urn:rulespec:document-understanding:section:80835c86ea7dc4e3ace4a4479bf9d3e4ff2ffb6b59699984c4faaabf32ff5305\",\"start\":15306,\"summary\":\"The Secretary must assure that unemployment insurance and employment service offices in each State, as appropriate, upon request of a public agency administering or supervising the administration of a State program funded under part A of title IV of the Social Security Act [42 U.S.C. 601 et seq.], of a public agency charged with any duty or responsibility under any program or activity authorized or required under part D of title IV of such Act [42 U.S.C. 651 et seq.], or of a State agency charged with the administration of the supplemental nutrition assistance program in a State under the Food and Nutrition Act of 2008 (7 U.S.C. 2011 et seq.), shall furnish to such requesting agency, from any data contained in the files of any such office, information with respect to any individual specified in the request as to: (1) whether such individual is receiving, has received, or has made application for, unemployment compensation, and the amount of any such compensation being received by such individual; (2) the current (or most recent) home address of such individual; and (3) whether such individual has refused an offer of employment and, if so, a description of the employment so offered and the terms, conditions, and rate of pay therefor.\",\"target_ids\":[],\"term_refs\":[\"urn:rulespec:document-understanding:term:9f55dbf62ef999dceebc8fdea7c3b7a55a3c2b5fcefed8cec38e526fa4b7febd\",\"urn:rulespec:document-understanding:term:b8e6b0f0233f5d80b1da19eccb1f6b74c1b83ebf7edda8c20b73fb20ef140726\",\"urn:rulespec:document-understanding:term:c3de40b27876a1d66bc4d930b3e555c3186e4373d8b69f575f7ea4e7dbe1ba49\"],\"typed_values\":[]}",

      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"The Secretary\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:3d509becbff71d1df262e9d0028d5738d372016e71d3cff9f662addaa1e48e61\",\"urn:rulespec:document-understanding:assertion:b4db9967d59b1d5de18312a68a2326e776503c655469e212e6d53ddda788e4ae\",\"urn:rulespec:document-understanding:assertion:3b8226e1718bcb2775bff79bcaaccc1eb3216e4666f15d09dc6cf16100c0c3cd\",\"urn:rulespec:document-understanding:assertion:bf87caf8f68f5d852df431602ff9a2236ced3792b2231a07ec89834e571b90bc\",\"urn:rulespec:document-understanding:assertion:c482aacb9a99cf7926bdbf9d2f75eaad5591577350e8cef62a59bf0fceca529b\",\"urn:rulespec:document-understanding:assertion:2bd1d31fb5d5edf148a6501238fe3d576e9bc7bb560944c56ad05781bd4e5235\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":17432,\"evidence\":[{\"end\":17432,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A034f7c0701641ac491c4788373a7cbb227323ee386a4483e5d3f3bbb6ac2d316:17205:17432:sha256-116e16b732bba412ac64a338c70436f6dca8e58947f6c0f635f4d017cf802685\",\"quote\":\"(3) ensure, for individuals otherwise eligible to receive unemployment compensation, the provision of reemployment services and other activities in which the individuals are required to participate to receive the compensation.2\",\"start\":17205},{\"end\":16713,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A034f7c0701641ac491c4788373a7cbb227323ee386a4483e5d3f3bbb6ac2d316:16693:16713:sha256-a72e102adc9c0194004ca68d3306d03c8f3b7e2a3556d897b85ed8018896eb97\",\"quote\":\"The Secretary shall—\",\"start\":16693},{\"end\":17432,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A034f7c0701641ac491c4788373a7cbb227323ee386a4483e5d3f3bbb6ac2d316:17205:17432:sha256-116e16b732bba412ac64a338c70436f6dca8e58947f6c0f635f4d017cf802685\",\"quote\":\"(3) ensure, for individuals otherwise eligible to receive unemployment compensation, the provision of reemployment services and other activities in which the individuals are required to participate to receive the compensation.2\",\"start\":17205}],\"id\":\"urn:rulespec:document-understanding:revision:51276217a21a272eb60c2557cd8a4844675b77cfdfde08acf9dc86acea998e1b\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:c482aacb9a99cf7926bdbf9d2f75eaad5591577350e8cef62a59bf0fceca529b\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:1f8d5a9ff3227dd896c102bd67840a5d2f7b5efa50c5734ef541a993bd8be1f7\",\"origin\":\"aiSuggested\",\"quote\":\"(3) ensure, for individuals otherwise eligible to receive unemployment compensation, the provision of reemployment services and other activities in which the individuals are required to participate to receive the compensation.2\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:abffec83125f4590a1357d6b8f750cf92ee848005b21dff3870165bd7825d80b\",\"scope_quotes\":[\"(3) ensure, for individuals otherwise eligible to receive unemployment compensation, the provision of reemployment services and other activities in which the individuals are required to participate to receive the compensation.2\"],\"scope_text\":\"for individuals otherwise eligible to receive unemployment compensation\",\"section_id\":\"urn:rulespec:document-understanding:section:80835c86ea7dc4e3ace4a4479bf9d3e4ff2ffb6b59699984c4faaabf32ff5305\",\"start\":17205,\"summary\":\"The Secretary must ensure, for individuals otherwise eligible to receive unemployment compensation, the provision of reemployment services and other activities in which the individuals are required to participate to receive the compensation.\",\"target_ids\":[],\"term_refs\":[\"urn:rulespec:document-understanding:term:9f55dbf62ef999dceebc8fdea7c3b7a55a3c2b5fcefed8cec38e526fa4b7febd\"],\"typed_values\":[]}",

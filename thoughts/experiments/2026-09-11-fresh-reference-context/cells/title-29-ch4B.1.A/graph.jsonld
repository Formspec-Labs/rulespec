      "dcterms:description": "{\"action\":\"\",\"actor\":\"the Secretary\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:a50d0ccd570f72d37d1b709b29c5ab52fb6b8e6549e8ecc1e7f8d608f7fb79ff\",\"urn:rulespec:document-understanding:assertion:a326d05c6c388703bea5a61c408595bff4288798f44000902bbfbcc1da7c0eba\",\"urn:rulespec:document-understanding:assertion:8508a735e4affd36eb1b69a8f51d5e09397c2fadecc0a7708c9ba58efc694391\",\"urn:rulespec:document-understanding:assertion:0ec19ac15a50cc882f706dfca518a033d034f24f20f375b0885636c51550d5a1\",\"urn:rulespec:document-understanding:assertion:88be9bafeaa22c208741407cde472cf1ef61df23d1ca7d0b7c04d4ebe71ea7b4\",\"urn:rulespec:document-understanding:assertion:e4a61f1840e1a342f46b440329f44dc8b293575b86c078641c2531f832d68252\",\"urn:rulespec:document-understanding:assertion:95eb95357c4ef88731b7430e4b2af6ddd5133fe8507c5f5e28e447cb4e559bd6\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":3895,\"evidence\":[{\"end\":3895,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A034f7c0701641ac491c4788373a7cbb227323ee386a4483e5d3f3bbb6ac2d316:2871:3895:sha256-8aa56157e674de17f747126e2ed16fe546b5915a74e04b93a4e777f94d9638ee\",\"quote\":\"Pub. L. 93–198, title II, § 204(a), Dec. 24, 1973, 87 Stat. 783, provided that: “All functions of the Secretary of Labor (hereafter in this section referred to as the Secretary) under section 3 of the Act [section 49b of this title] entitled ‘An Act to provide for the establishment of a national employment system and for cooperation with the States in the promotion of such system, and for other purposes’, approved June 6, 1933 (29 U.S.C. 49–49k), with respect to the maintenance of a public employment service for the District [of Columbia], are transferred [effective July 1, 1974] to the Commissioner [of the District of Columbia established under Reorg. Plan No. 3 of 1967 (now the Mayor)]. After the effective date of this transfer [July 1, 1974], the Secretary shall maintain with the District the same relationship with respect to a public employment service in the District, including the financing of such service, as he has with the States (with respect to a public employment service in the States) generally.”\",\"start\":2871},{\"end\":3673,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A034f7c0701641ac491c4788373a7cbb227323ee386a4483e5d3f3bbb6ac2d316:3627:3673:sha256-eecd48b2859a1f1990c22ecade44b3fd2b5a8dede66acaf9ca40c07ca67155d1\",\"quote\":\"the Secretary shall maintain with the District\",\"start\":3627},{\"end\":3655,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A034f7c0701641ac491c4788373a7cbb227323ee386a4483e5d3f3bbb6ac2d316:3641:3655:sha256-ccbb638d410f763eefa8ec619b654b4932af01e8044d2ceab9031376c4a43267\",\"quote\":\"shall maintain\",\"start\":3641},{\"end\":3895,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A034f7c0701641ac491c4788373a7cbb227323ee386a4483e5d3f3bbb6ac2d316:2871:3895:sha256-8aa56157e674de17f747126e2ed16fe546b5915a74e04b93a4e777f94d9638ee\",\"quote\":\"Pub. L. 93–198, title II, § 204(a), Dec. 24, 1973, 87 Stat. 783, provided that: “All functions of the Secretary of Labor (hereafter in this section referred to as the Secretary) under section 3 of the Act [section 49b of this title] entitled ‘An Act to provide for the establishment of a national employment system and for cooperation with the States in the promotion of such system, and for other purposes’, approved June 6, 1933 (29 U.S.C. 49–49k), with respect to the maintenance of a public employment service for the District [of Columbia], are transferred [effective July 1, 1974] to the Commissioner [of the District of Columbia established under Reorg. Plan No. 3 of 1967 (now the Mayor)]. After the effective date of this transfer [July 1, 1974], the Secretary shall maintain with the District the same relationship with respect to a public employment service in the District, including the financing of such service, as he has with the States (with respect to a public employment service in the States) generally.”\",\"start\":2871}],\"id\":\"urn:rulespec:document-understanding:revision:cc4712eb604535a5098f383bb95a609bf7cde3da009658ba31deaf40247c3e93\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:88be9bafeaa22c208741407cde472cf1ef61df23d1ca7d0b7c04d4ebe71ea7b4\",\"modality\":\"must\",\"modality_quote\":\"shall maintain\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:d2577d8a08159cb27688bbee9a3472837102fed6037f756284f511d96bf107ee\",\"origin\":\"aiSuggested\",\"quote\":\"Pub. L. 93–198, title II, § 204(a), Dec. 24, 1973, 87 Stat. 783, provided that: “All functions of the Secretary of Labor (hereafter in this section referred to as the Secretary) under section 3 of the Act [section 49b of this title] entitled ‘An Act to provide for the establishment of a national employment system and for cooperation with the States in the promotion of such system, and for other purposes’, approved June 6, 1933 (29 U.S.C. 49–49k), with respect to the maintenance of a public employment service for the District [of Columbia], are transferred [effective July 1, 1974] to the Commissioner [of the District of Columbia established under Reorg. Plan No. 3 of 1967 (now the Mayor)]. After the effective date of this transfer [July 1, 1974], the Secretary shall maintain with the District the same relationship with respect to a public employment service in the District, including the financing of such service, as he has with the States (with respect to a public employment service in the States) generally.”\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:f4e8af34b0a02ba0aa626edc340610b77138c0f02841e76b3f2f3623d14dd790\",\"scope_quotes\":[\"Pub. L. 93–198, title II, § 204(a), Dec. 24, 1973, 87 Stat. 783, provided that: “All functions of the Secretary of Labor (hereafter in this section referred to as the Secretary) under section 3 of the Act [section 49b of this title] entitled ‘An Act to provide for the establishment of a national employment system and for cooperation with the States in the promotion of such system, and for other purposes’, approved June 6, 1933 (29 U.S.C. 49–49k), with respect to the maintenance of a public employment service for the District [of Columbia], are transferred [effective July 1, 1974] to the Commissioner [of the District of Columbia established under Reorg. Plan No. 3 of 1967 (now the Mayor)]. After the effective date of this transfer [July 1, 1974], the Secretary shall maintain with the District the same relationship with respect to a public employment service in the District, including the financing of such service, as he has with the States (with respect to a public employment service in the States) generally.”\"],\"scope_text\":\"After the effective date of this transfer [July 1, 1974]\",\"section_id\":\"urn:rulespec:document-understanding:section:9521dd0579bcf8c73c12c8c7a080ec40c372008e569012cef784adddf2c0be06\",\"start\":2871,\"summary\":\"After the effective date of the transfer of functions (July 1, 1974), the Secretary must maintain with the District of Columbia the same relationship with respect to a public employment service in the District, including the financing of such service, as he has with the States (with respect to a public employment service in the States) generally.\",\"target_ids\":[],\"term_refs\":[\"urn:rulespec:document-understanding:term:9f55dbf62ef999dceebc8fdea7c3b7a55a3c2b5fcefed8cec38e526fa4b7febd\",\"urn:rulespec:document-understanding:term:b8e6b0f0233f5d80b1da19eccb1f6b74c1b83ebf7edda8c20b73fb20ef140726\"],\"typed_values\":[]}",

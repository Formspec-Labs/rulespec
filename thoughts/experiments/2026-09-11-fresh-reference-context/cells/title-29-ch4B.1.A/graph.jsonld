    {
      "@id": "urn:rulespec:document-understanding:revision:173afcc3cfe556690d1bb5b9b53e5ca6da127800e8c65fbad784dcafb18b0c98",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:173afcc3cfe556690d1bb5b9b53e5ca6da127800e8c65fbad784dcafb18b0c98",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:7ef35201b48b83b033a9ec64eb6bdb43576977104ab117d176ae8343037ced0d",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"The Secretary\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:ca3a502b4095e5ecac4c9bcb21c20f30bdbd55efd9d16e1014eea6f959365695\",\"urn:rulespec:document-understanding:assertion:3963ce61ab04a3fc4a795d9d06078b6382ea0d39b715b3b6e015545064059bc1\",\"urn:rulespec:document-understanding:assertion:9a34d0cb38f739b56a76486133ea945711bef113352c65c4d54d65a0914951ef\",\"urn:rulespec:document-understanding:assertion:9cac4d1455bacefc3bad1a2fd59e48101579829ef34b818409c1a5d36bfad3fd\",\"urn:rulespec:document-understanding:assertion:b2f8718b0ee152b7ef65fa5efebf8eece7978cf26805a9939efe395e48b721f1\",\"urn:rulespec:document-understanding:assertion:ed9eb3b1be153e358508e728d525b127d47e42e94aba443bc0cb5624a513c3d5\",\"urn:rulespec:document-understanding:assertion:c792015950e3ab5f5f8474e064766cede2ba9a3f4c2d05ff1d8f6b5700655a70\",\"urn:rulespec:document-understanding:assertion:055d6ebd71d4ef4c471de3aa702253f8ed8128f5a8d04314007be750ad55bcfa\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":18226,\"evidence\":[{\"end\":18226,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A034f7c0701641ac491c4788373a7cbb227323ee386a4483e5d3f3bbb6ac2d316:17492:18226:sha256-00dcb4609bc853704d1eb90db3eede35df6a0d69139ebd1709ae35477eafee1d\",\"quote\":\"(4) in coordination with the State agencies and the staff of such agencies, assist in the planning and implementation of activities to enhance the professional development and career advancement opportunities of such staff, in order to strengthen the provision of a broad range of career guidance services, the identification of job openings (including providing intensive outreach to small and medium-sized employers and enhanced employer services), the provision of technical assistance and training to other providers of workforce development activities (including workplace learning advisors) relating to counseling and employment-related services, and the development of new strategies for coordinating counseling and technology.\",\"start\":17492},{\"end\":16713,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A034f7c0701641ac491c4788373a7cbb227323ee386a4483e5d3f3bbb6ac2d316:16693:16713:sha256-a72e102adc9c0194004ca68d3306d03c8f3b7e2a3556d897b85ed8018896eb97\",\"quote\":\"The Secretary shall—\",\"start\":16693}],\"id\":\"urn:rulespec:document-understanding:revision:173afcc3cfe556690d1bb5b9b53e5ca6da127800e8c65fbad784dcafb18b0c98\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:9cac4d1455bacefc3bad1a2fd59e48101579829ef34b818409c1a5d36bfad3fd\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:3155b4b84ee8df85d6d6f5314ba95ff65ba2af697bed502dd052f0b568f1d761\",\"origin\":\"aiSuggested\",\"quote\":\"(4) in coordination with the State agencies and the staff of such agencies, assist in the planning and implementation of activities to enhance the professional development and career advancement opportunities of such staff, in order to strengthen the provision of a broad range of career guidance services, the identification of job openings (including providing intensive outreach to small and medium-sized employers and enhanced employer services), the provision of technical assistance and training to other providers of workforce development activities (including workplace learning advisors) relating to counseling and employment-related services, and the development of new strategies for coordinating counseling and technology.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:8cfb7a989428d7de44bc60994ab4e488d46b3e5d97d5b53ce19821927cba1dcb\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"urn:rulespec:document-understanding:section:80835c86ea7dc4e3ace4a4479bf9d3e4ff2ffb6b59699984c4faaabf32ff5305\",\"start\":17492,\"summary\":\"The Secretary must, in coordination with the State agencies and the staff of such agencies, assist in the planning and implementation of activities to enhance the professional development and career advancement opportunities of such staff, in order to strengthen the provision of a broad range of career guidance services, the identification of job openings (including providing intensive outreach to small and medium-sized employers and enhanced employer services), the provision of technical assistance and training to other providers of workforce development activities (including workplace learning advisors) relating to counseling and employment-related services, and the development of new strategies for coordinating counseling and technology.\",\"target_ids\":[],\"term_refs\":[\"urn:rulespec:document-understanding:term:9f55dbf62ef999dceebc8fdea7c3b7a55a3c2b5fcefed8cec38e526fa4b7febd\",\"urn:rulespec:document-understanding:term:c3de40b27876a1d66bc4d930b3e555c3186e4373d8b69f575f7ea4e7dbe1ba49\",\"urn:rulespec:document-understanding:term:2958da5131b6b9e4ca20c17a59e846a14cee1087f0a944c0478d6366743e4dbe\",\"urn:rulespec:document-understanding:term:7ae84bcf36dd10004820668a2fb642721fc682837eb3066deeb04a50d21bf0e9\"],\"typed_values\":[]}",

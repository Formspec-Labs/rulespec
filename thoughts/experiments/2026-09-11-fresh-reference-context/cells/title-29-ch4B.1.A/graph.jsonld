      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:a7bad088a0ae66f01d29b188866eec3c59e61b9bf0f4cd7964c8d36cc0aab015\",\"urn:rulespec:document-understanding:assertion:853c05528639448f3a6e3b1b64d0c156321a87f8cae61e1b6d017d132d76ebef\",\"urn:rulespec:document-understanding:assertion:c0bf7101aa2b66ce8fe1d60f9fa88ad7b9beb0daa342a18da1d2bc7e8a4653d3\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":2816,\"evidence\":[{\"end\":2816,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A034f7c0701641ac491c4788373a7cbb227323ee386a4483e5d3f3bbb6ac2d316:2381:2816:sha256-abf9734aa04afdd8e131cc90b11c5be9e88205efab6ac897da82f96f15dc0e67\",\"quote\":\"Act June 6, 1933, ch. 49, § 16, formerly § 15, as added by Pub. L. 97–300, title VI, § 601(h), formerly title V, § 501(h), Oct. 13, 1982, 96 Stat. 1397; renumbered title VI, § 601(h), Pub. L. 100–628, title VII, § 712(a)(1), (2), Nov. 7, 1988, 102 Stat. 3248; renumbered § 16, Pub. L. 105–220, title III, § 309(1), Aug. 7, 1998, 112 Stat. 1082, provided that: “This Act [enacting this chapter] may be cited as the ‘Wagner-Peyser Act’.”\",\"start\":2381},{\"end\":2787,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A034f7c0701641ac491c4788373a7cbb227323ee386a4483e5d3f3bbb6ac2d316:2775:2787:sha256-a860fa2a483940fb7cab9ccb79fd9939545872ae81a9d430e006a7125292a6a4\",\"quote\":\"may be cited\",\"start\":2775}],\"id\":\"urn:rulespec:document-understanding:revision:3ff63af77ca3d14b5429b09df87f3e8bc4db7c19b3c4e829ee0a68d9c5d59908\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"permission\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:c0bf7101aa2b66ce8fe1d60f9fa88ad7b9beb0daa342a18da1d2bc7e8a4653d3\",\"modality\":\"may\",\"modality_quote\":\"may be cited\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:f7dceeef7fab6de7399aae33831b6cd9faf4cec91e81bda636ffe454658b6e21\",\"origin\":\"aiSuggested\",\"quote\":\"Act June 6, 1933, ch. 49, § 16, formerly § 15, as added by Pub. L. 97–300, title VI, § 601(h), formerly title V, § 501(h), Oct. 13, 1982, 96 Stat. 1397; renumbered title VI, § 601(h), Pub. L. 100–628, title VII, § 712(a)(1), (2), Nov. 7, 1988, 102 Stat. 3248; renumbered § 16, Pub. L. 105–220, title III, § 309(1), Aug. 7, 1998, 112 Stat. 1082, provided that: “This Act [enacting this chapter] may be cited as the ‘Wagner-Peyser Act’.”\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:c02ecafb0fa9c84c2321797fe783c4a9ff530630aaae49da1371c1a2e932fd27\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"urn:rulespec:document-understanding:section:9521dd0579bcf8c73c12c8c7a080ec40c372008e569012cef784adddf2c0be06\",\"start\":2381,\"summary\":\"The Act of June 6, 1933, ch. 49 (enacting this chapter) may be cited as the 'Wagner-Peyser Act'.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

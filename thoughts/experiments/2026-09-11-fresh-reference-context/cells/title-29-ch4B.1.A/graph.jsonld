      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:50ceb0a1dffdae121f27d2c8c269b247e6860ce53f3541d7e68ed58ffeb0c746\",\"urn:rulespec:document-understanding:assertion:1e1b1343e894d6ab4241c746a811921cd04c5f0738bcb2b75abdaaf4425fb13a\",\"urn:rulespec:document-understanding:assertion:8f9d7b53fa1797acd39d79d721dfdc6796b2873977a2f61f3c52e8a4c0d96b3c\",\"urn:rulespec:document-understanding:assertion:f94fea22a4c05e5715831fe91769844de4e391cc8274c1984472d9346ef6442f\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":3895,\"evidence\":[{\"end\":3895,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A034f7c0701641ac491c4788373a7cbb227323ee386a4483e5d3f3bbb6ac2d316:2871:3895:sha256-8aa56157e674de17f747126e2ed16fe546b5915a74e04b93a4e777f94d9638ee\",\"quote\":\"Pub. L. 93–198, title II, § 204(a), Dec. 24, 1973, 87 Stat. 783, provided that: “All functions of the Secretary of Labor (hereafter in this section referred to as the Secretary) under section 3 of the Act [section 49b of this title] entitled ‘An Act to provide for the establishment of a national employment system and for cooperation with the States in the promotion of such system, and for other purposes’, approved June 6, 1933 (29 U.S.C. 49–49k), with respect to the maintenance of a public employment service for the District [of Columbia], are transferred [effective July 1, 1974] to the Commissioner [of the District of Columbia established under Reorg. Plan No. 3 of 1967 (now the Mayor)]. After the effective date of this transfer [July 1, 1974], the Secretary shall maintain with the District the same relationship with respect to a public employment service in the District, including the financing of such service, as he has with the States (with respect to a public employment service in the States) generally.”\",\"start\":2871}],\"id\":\"urn:rulespec:document-understanding:revision:17a0e8ebd1954e8c3827da4e8d3f2444b1214a4768f96fe3b274f2dd270fa3d1\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"statement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:8f9d7b53fa1797acd39d79d721dfdc6796b2873977a2f61f3c52e8a4c0d96b3c\",\"modality\":\"not_stated\",\"modality_quote\":\"\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:b510f4f973d997af93425835c69d2397656e041308b805184db7afc9e4e10f98\",\"origin\":\"aiSuggested\",\"quote\":\"Pub. L. 93–198, title II, § 204(a), Dec. 24, 1973, 87 Stat. 783, provided that: “All functions of the Secretary of Labor (hereafter in this section referred to as the Secretary) under section 3 of the Act [section 49b of this title] entitled ‘An Act to provide for the establishment of a national employment system and for cooperation with the States in the promotion of such system, and for other purposes’, approved June 6, 1933 (29 U.S.C. 49–49k), with respect to the maintenance of a public employment service for the District [of Columbia], are transferred [effective July 1, 1974] to the Commissioner [of the District of Columbia established under Reorg. Plan No. 3 of 1967 (now the Mayor)]. After the effective date of this transfer [July 1, 1974], the Secretary shall maintain with the District the same relationship with respect to a public employment service in the District, including the financing of such service, as he has with the States (with respect to a public employment service in the States) generally.”\",\"references\":[\"section 3 of the Act\",\"section 49b of this title\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:f4b224c5693b17f184942a4b8cfb1608ac7bbb9ac953b1fa63f904ed97d7cfe5\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"urn:rulespec:docum
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:8a48299278f5e226af297be57a3f3e0c789c4f05d1e1f37330f6f4350a3da51f\",\"urn:rulespec:document-understanding:assertion:83b310d2d42b0171ba6a41233a8db6023f3c66d518bfba2a5bbba35a2febb258\",\"urn:rulespec:document-understanding:assertion:9708b932e65beed6dcc5fb600713c7df025b5c2dfefa134e47e57b02a1bdc011\",\"urn:rulespec:document-understanding:assertion:3483c9a45ab591473bc71a3525dccd6319e4c02b2809b2bd35d2adfd6b92efac\",\"urn:rulespec:document-understanding:assertion:5d6638b6612b24805c9b0c5a025c6bff1074eca4a1489303dcc3151bc0f863de\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":16655,\"evidence\":[{\"end\":16655,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A034f7c0701641ac491c4788373a7cbb227323ee386a4483e5d3f3bbb6ac2d316:15306:16655:sha256-50290e1b765c281e548df63d4ae156ef0f89f4ac71d7fed402491154b2dfe35a\",\"quote\":\"It shall be the duty of the Secretary to assure that unemployment insurance and employment service offices in each State, as appropriate, upon request of a public agency administering or supervising the administration of a State program funded under part A of title IV of the Social Security Act [42 U.S.C. 601 et seq.], of a public agency charged with any duty or responsibility under any program or activity authorized or required under part D of title IV of such Act [42 U.S.C. 651 et seq.], or of a State agency charged with the administration of the supplemental nutrition assistance program in a State under the Food and Nutrition Act of 2008 (7 U.S.C. 2011 et seq.), shall (and, notwithstanding any other provision of law, is authorized to) furnish to such agency making the request, from any data contained in the files of any such office, information with respect to any individual specified in the request as to (1) whether such individual is receiving, has received, or has made application for, unemployment compensation, and the amount of any such compensation being received by such individual, (2) the current (or most recent) home address of such individual, and (3) whether such individual has refused an offer of employment and, if so, a description of the employment so offered and the terms, conditions, and rate of pay therefor.\",\"start\":15306},{\"end\":16052,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A034f7c0701641ac491c4788373a7cbb227323ee386a4483e5d3f3bbb6ac2d316:16036:16052:sha256-99b99f6ee0f807e32b2a2c99f3ca55a3ef3c808479973e8823bffb6d64443f30\",\"quote\":\"is authorized to\",\"start\":16036}],\"id\":\"urn:rulespec:document-understanding:revision:490fd98516427fb8d8cc3c9812885e7b5a0e7ee8f1c66e6cd5991119af93aaea\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"permission\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:9708b932e65beed6dcc5fb600713c7df025b5c2dfefa134e47e57b02a1bdc011\",\"modality\":\"may\",\"modality_quote\":\"is authorized to\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:3720c3f2ecf3feb5ee30be2ff3ccaf61b379508e81991bf0f7a5e71ac93fb759\",\"origin\":\"aiSuggested\",\"quote\":\"It shall be the duty of the Secretary to assure that unemployment insurance and employment service offices in each State, as appropriate, upon request of a public agency administering or supervising the administration of a State program funded under part A of title IV of the Social Security Act [42 U.S.C. 601 et seq.], of a public agency charged with any duty or responsibility under any program or activity authorized or required under part D of title IV of such Act [42 U.S.C. 651 et seq.], or of a State agency charged with the administration of the supplemental nutrition assistance program in a State under the Food and Nutrition Act of 2008 (7 U.S.C. 2011 et seq.), shall (and, notwithstanding any other provision of law, is authorized to) furnish to such agency making the request, from any data contained in the files of any such office, information with respect to any individual specified in the request as to (1) whether such individual is receiving, has received, or has made application for, unemployment compensation, and the amount of any such compensation being received by such individual, (2) the current (or most recent) home address of such individual, and (3) whether such individual has refused an offer of employment and, if so, a description of the employment so offered and the terms, conditions, and rate of pay therefor.\",\"references\":[\"part A of title IV of the Social Security Act [42 U.S.C. 601 et seq.]\",\"part D of title IV of such Act [42 U.S.C. 651 et seq.]\",\"Food and Nutrition Act of 2008 (7 U.S.C. 2011 et seq.)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:4c72899f4aa766c7abd6943295c42a52b5f393cf7e57f08235628f913cb917b5\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"urn:rulespec:document-understanding:section:80835c86ea7dc4e3ace4a4479bf9d3e4ff2ffb6b59699984c4faaabf32ff5305\",\"start\":15306,\"summary\":\"Notwithstanding any other provision of law, unemployment insurance and employment service offices in each State, as appropriate, are authorized, upon request of a public agency administering or supervising the administration of a State program funded under part A of title IV of the Social Security Act [42 U.S.C. 601 et seq.], of a public agency charged with any duty or responsibility under any program or activity authorized or required under part D of title IV of such Act [42 U.S.C. 651 et seq.], or of a State agency charged with the administration of the supplemental nutrition assistance program in a State under the Food and Nutrition Act of 2008 (7 U.S.C. 2011 et seq.), to furnish to such requesting agency, from any data contained in the files of any such office, information with respect to any individual specified in the request as to: (1) whether such individual is receiving, has received, or has made application for, unemployment compensation, and the amount of any such compensation being received by such individual; (2) the current (or most recent) home address of such individual; and (3) whether such individual has refused an offer of employment and, if so, a description of the employment so offered and the terms, conditions, and rate of pay therefor.\",\"target_ids\":[],\"term_refs\":[\"urn:rulespec:document-understanding:term:b8e6b0f0233f5d80b1da19eccb1f6b74c1b83ebf7edda8c20b73fb20ef140726\",\"urn:rulespec:document-understanding:term:c3de40b27876a1d66bc4d930b3e555c3186e4373d8b69f575f7ea4e7dbe1ba49\"],\"typed_values\":[]}",

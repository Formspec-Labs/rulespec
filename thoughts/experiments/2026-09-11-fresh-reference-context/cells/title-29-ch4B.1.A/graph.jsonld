      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"The Secretary\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:892bb46327e9966251adf8c5294c62b7f40e3467ed51dd21dbd329ab74c41ec7\",\"urn:rulespec:document-understanding:assertion:9b75f8b128cd85b716600d24f65b7306401d62f322ec78c33c4a994dfece4360\",\"urn:rulespec:document-understanding:assertion:abc9a1f33cc647538be37e84699b52f0d3150ffb6929e8c862a439c2e4a2125d\",\"urn:rulespec:document-understanding:assertion:ed39c5af19b87b42d52365e3fe64bdaa3909de6834054a050cab56989f935464\",\"urn:rulespec:document-understanding:assertion:0933869823246dfcdbd36f9258b8d9f9b1880194a750c235a7cfec4f15a2f2e3\",\"urn:rulespec:document-understanding:assertion:fa5e1c2f9830819dee03f2ceec7288400f7b47abe680dc609bd23a228ac447e5\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":15247,\"evidence\":[{\"end\":15247,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A034f7c0701641ac491c4788373a7cbb227323ee386a4483e5d3f3bbb6ac2d316:14703:15247:sha256-131f15e85b35fb81c64fc8124d440f29ad86260280d3e2b5cdd20147898a3acf\",\"quote\":\"The Secretary shall assist in coordinating the State public employment service offices throughout the country and in increasing their usefulness by developing and prescribing minimum standards of efficiency, assisting them in meeting problems peculiar to their localities, promoting uniformity in their administrative and statistical procedure, furnishing and publishing information as to opportunities for employment and other information of value in the operation of the system, and maintaining a system for clearing labor between the States.\",\"start\":14703},{\"end\":14729,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A034f7c0701641ac491c4788373a7cbb227323ee386a4483e5d3f3bbb6ac2d316:14703:14729:sha256-21d00ecdcc95233cfc18af8f73521fe6d47326522ab1699870b38460013c9d24\",\"quote\":\"The Secretary shall assist\",\"start\":14703},{\"end\":14729,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A034f7c0701641ac491c4788373a7cbb227323ee386a4483e5d3f3bbb6ac2d316:14717:14729:sha256-80c5e074e3a172e33423dbd950781560a5ad30b10f4a0268478fab299d34580e\",\"quote\":\"shall assist\",\"start\":14717}],\"id\":\"urn:rulespec:document-understanding:revision:d92760aeb3a934b041eeecbf080c8dfd9671421a2cacbfa3ab342d19b4611ec8\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:ed39c5af19b87b42d52365e3fe64bdaa3909de6834054a050cab56989f935464\",\"modality\":\"must\",\"modality_quote\":\"shall assist\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:105e375fe8bf2ca9c869745d0f2f87547f0007bbb2582949f24059c8f0b9920b\",\"origin\":\"aiSuggested\",\"quote\":\"The Secretary shall assist in coordinating the State public employment service offices throughout the country and in increasing their usefulness by developing and prescribing minimum standards of efficiency, assisting them in meeting problems peculiar to their localities, promoting uniformity in their administrative and statistical procedure, furnishing and publishing information as to opportunities for employment and other information of value in the operation of the system, and maintaining a system for clearing labor between the States.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:76518c352c499f1780d042ecbfa8e64a2b709f24122c283ae926fe4e19bb0051\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"urn:rulespec:document-understanding:section:80835c86ea7dc4e3ace4a4479bf9d3e4ff2ffb6b59699984c4faaabf32ff5305\",\"start\":14703,\"summary\":\"The Secretary must assist in coordinating the State public employment service offices throughout the country and in increasing their usefulness by developing and prescribing minimum standards of efficiency, assisting them in meeting problems peculiar to their localities, promoting uniformity in their administrative and statistical procedure, furnishing and publishing information as to opportunities for employment and other information of value in the operation of the system, and maintaining a system for clearing labor between the States.\",\"target_ids\":[],\"term_refs\":[\"urn:rulespec:document-understanding:term:9f55dbf62ef999dceebc8fdea7c3b7a55a3c2b5fcefed8cec38e526fa4b7febd\",\"urn:rulespec:document-understanding:term:b8e6b0f0233f5d80b1da19eccb1f6b74c1b83ebf7edda8c20b73fb20ef140726\"],\"typed_values\":[]}",

    {
      "@id": "urn:rulespec:document-understanding:revision:3586af36615a4b96143f0322e785ce1f2a3510156db5325eb37c63e7d883f398",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:3586af36615a4b96143f0322e785ce1f2a3510156db5325eb37c63e7d883f398",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:2ae4f4135b98edf0e6d29f735a24e4812ef8d9b24aa77f892a838c24b67a0f24",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"unemployment insurance and employment service offices in each State\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:4c35d5bc81f811a21e6ee0bab1b50504a97ab32d9007125572c66159576dc560\",\"urn:rulespec:document-understanding:assertion:fc3723e7d0db190f0482a8180c6becaf3a637cac06adb19d9fec606eaca9ec90\",\"urn:rulespec:document-understanding:assertion:c8fafe5860422ad0c3ec947c109a5256d7fbab0f459a75648a46e4c298a28889\",\"urn:rulespec:document-understanding:assertion:52aa2eab5d7ab0dfae95c238779d314e8cc94ce7ed9f2cbdc45befd08fde5579\",\"urn:rulespec:document-understanding:assertion:ec493289a684bf9f6301d57d8568a91743d0f476f918285091d369c848632833\",\"urn:rulespec:document-understanding:assertion:ecb65aa1f5527d16e09027489733c40ac23e52b5db814207473441bc32982871\",\"urn:rulespec:document-understanding:assertion:7d3c6900f4d4d556db034a7d428f58c5576b3a60dde29cb405e5a816399a94bb\",\"urn:rulespec:document-understanding:assertion:1343fe8717fce740df580ad3c32b3185f4ebb8085260de9e574a1eea4bdcf7c5\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":16655,\"evidence\":[{\"end\":16655,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A034f7c0701641ac491c4788373a7cbb227323ee386a4483e5d3f3bbb6ac2d316:15306:16655:sha256-50290e1b765c281e548df63d4ae156ef0f89f4ac71d7fed402491154b2dfe35a\",\"quote\":\"It shall be the duty of the Secretary to assure that unemployment insurance and employment service offices in each State, as appropriate, upon request of a public agency administering or supervising the administration of a State program funded under part A of title IV of the Social Security Act [42 U.S.C. 601 et seq.], of a public agency charged with any duty or responsibility under any program or activity authorized or required under part D of title IV of such Act [42 U.S.C. 651 et seq.], or of a State agency charged with the administration of the supplemental nutrition assistance program in a State under the Food and Nutrition Act of 2008 (7 U.S.C. 2011 et seq.), shall (and, notwithstanding any other provision of law, is authorized to) furnish to such agency making the request, from any data contained in the files of any such office, information with respect to any individual specified in the request as to (1) whether such individual is receiving, has received, or has made application for, unemployment compensation, and the amount of any such compensation being received by such individual, (2) the current (or most recent) home address of such individual, and (3) whether such individual has refused an offer of employment and, if so, a description of the employment so offered and the terms, conditions, and rate of pay therefor.\",\"start\":15306},{\"end\":15426,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A034f7c0701641ac491c4788373a7cbb227323ee386a4483e5d3f3bbb6ac2d316:15359:15426:sha256-84a53426ce3e015984ce68e5f7376989a8e465340cdbdcbbe7d167f248d8f28e\",\"quote\":\"unemployment insurance and employment service offices in each State\",\"start\":15359},{\"end\":16052,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A034f7c0701641ac491c4788373a7cbb227323ee386a4483e5d3f3bbb6ac2d316:16036:16052:sha256-99b99f6ee0f807e32b2a2c99f3ca55a3ef3c808479973e8823bffb6d64443f30\",\"quote\":\"is authorized to\",\"start\":16036},{\"end\":16655,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A034f7c0701641ac491c4788373a7cbb227323ee386a4483e5d3f3bbb6ac2d316:15306:16655:sha256-50290e1b765c281e548df63d4ae156ef0f89f4ac71d7fed402491154b2dfe35a\",\"quote\":\"It shall be the duty of the Secretary to assure that unemployment insurance and employment service offices in each State, as appropriate, upon request of a public agency administering or supervising the administration of a State program funded under part A of title IV of the Social Security Act [42 U.S.C. 601 et seq.], of a public agency charged with any duty or responsibility under any program or activity authorized or required under part D of title IV of such Act [42 U.S.C. 651 et seq.], or of a State agency charged with the administration of the supplemental nutrition assistance program in a State under the Food and Nutrition Act of 2008 (7 U.S.C. 2011 et seq.), shall (and, notwithstanding any other provision of law, is authorized to) furnish to such agency making the request, from any data contained in the files of any such office, information with respect to any individual specified in the request as to (1) whether such individual is receiving, has received, or has made application for, unemployment compensation, and the amount of any such compensation being received by such individual, (2) the current (or most recent) home address of such individual, and (3) whether such individual has refused an offer of employment and, if so, a description of the employment so offered and the terms, conditions, and rate of pay therefor.\",\"start\":15306}],\"id\":\"urn:rulespec:document-understanding:revision:3586af36615a4b96143f0322e785ce1f2a3510156db5325eb37c63e7d883f398\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"authority\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:ec493289a684bf9f6301d57d8568a91743d0f476f918285091d369c848632833\",\"modality\":\"may\",\"modality_quote\":\"is authorized to\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:ed8e2cc0d34f38cd6169964cef08e76b5721ac5bed943f5bffe34692e27f961a\",\"origin\":\"aiSuggested\",\"quote\":\"It shall be the duty of the Secretary to assure that unemployment insurance and employment service offices in each State, as appropriate, upon request of a public agency administering or supervising the administration of a State program funded under part A of title IV of the Social Security Act [42 U.S.C. 601 et seq.], of a public agency charged with any duty or responsibility under any program or activity authorized or required under part D of title IV of such Act [42 U.S.C. 651 et seq.], or of a State agency charged with the administration of the supplemental nutrition assistance program in a State under the Food and Nutrition Act of 2008 (7 U.S.C. 2011 et seq.), shall (and, notwithstanding any other provision of law, is authorized to) furnish to such agency making the request, from any data contained in the files of any such office, information with respect to any individual specified in the request as to (1) whether such individual is receiving, has received, or has made application for, unemployment compensation, and the amount of any such compensation being received by such individual, (2) the current (or most recent) home address of such individual, and (3) whether such individual has refused an offer of employment and, if so, a description of the employment so offered and the terms, conditions, and rate of pay therefor.\",\"references\":[\"42 U.S.C. 601 et seq.\",\"42 U.S.C. 651 et seq.\",\"7 U.S.C. 2011 et seq.\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:03a0557498b65628057485644df3e59d7d2eca970038bccacc39553e01082d60\",\"scope_quotes\":[\"It shall be the duty of the Secretary to assure that unemployment insurance and employment service offices in each State, as appropriate, upon request of a public agency administering or supervising the administration of a State program funded under part A of title IV of the Social Security Act [42 U.S.C. 601 et seq.], of a public agency charged with any duty or responsibility under any program or activity authorized or required under part D of title IV of such Act [42 U.S.C. 651 et seq.], or of a State agency charged with the administration of the supplemental nutrition assistance program in a State under the Food and Nutrition Act of 2008 (7 U.S.C. 2011 et seq.), shall (and, notwithstanding any other provision of law, is authorized to) furnish to such agency making the request, from any data contained in the files of any such office, information with respect to any individual specified in the request as to (1) whether such individual is receiving, has received, or has made application for, unemployment compensation, and the amount of any such compensation being received by such individual, (2) the current (or most recent) home address of such individual, and (3) whether such individual has refused an offer of employment and, if so, a description of the employment so offered and the terms, conditions, and rate of pay therefor.\"],\"scope_text\":\"upon request of a public agency administering or supervising the administration of a State program funded under part A of title IV of the Social Security Act [42 U.S.C. 601 et seq.], of a public agency charged with any duty or responsibility under any program or activity authorized or required under part D of title IV of such Act [42 U.S.C. 651 et seq.], or of a State agency charged with the administration of the supplemental nutrition assistance program in a State under the Food and Nutrition Act of 2008 (7 U.S.C. 2011 et seq.)\",\"section_id\":\"urn:rulespec:document-understanding:section:80835c86ea7dc4e3ace4a4479bf9d3e4ff2ffb6b59699984c4faaabf32ff5305\",\"start\":15306,\"summary\":\"Notwithstanding any other provision of law, unemployment insurance and employment service offices in each State, as appropriate, are authorized to furnish to a requesting qualifying agency—namely, a public agency administering or supervising the administration of a State program funded under part A of title IV of the Social Security Act, a public agency charged with any duty or responsibility under any program or activity authorized or required under part D of title IV of such Act, or a State agency charged with administering the supplemental nutrition assistance program under the Food and Nutrition Act of 2008—information from file data regarding an individual specified in the request as to whether the individual receives, received, or applied for unemployment compensation (and the amount), current or most recent home address, and whether the individual refused an offer of employment, with a description of the offered employment and its terms, conditions, and pay rate.\",\"target_ids\":[],\"term_refs\":[\"urn:rulespec:document-understanding:term:9d722194346bc5a9e5121599681c43b603ea94c6b4faa9756601595fbccf47b2\",\"urn:rulespec:document-understanding:term:c778a168b0e4dd532963758792ed5aa198fb382fae247a1db55657cbb4bb4a94\",\"urn:rulespec:document-understanding:term:13ff59a3d70a53283f7d6005838549d5a945ba3766a4984449f75988cadb846d\"],\"typed_values\":[]}",

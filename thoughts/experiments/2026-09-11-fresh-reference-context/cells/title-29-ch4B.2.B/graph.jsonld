      "rkaf:hasContentDigest": "sha256:670ce0de0f8d4cb68f246745838c1c02d50d68caaf7ae1e1a9a5bf180c0ee918",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"the Secretary\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:03f4ea01870fc3120168cd5b144a66a500c019ab62e53233563e1aabf5f7e7f9\",\"urn:rulespec:document-understanding:assertion:3ed88c750363fd7c3ca17d63851ecaaeb224a75e6418325c8a7e1122ed0bff49\",\"urn:rulespec:document-understanding:assertion:10cf690a4c3e841c01863246ffc4eaa094f404a1a493c6d95f4ea403ea4a327e\",\"urn:rulespec:document-understanding:assertion:2b338a8dbc7f60b2bdff899c0ed3af2e843bf058e61e21e21d30d0751eb3a796\",\"urn:rulespec:document-understanding:assertion:0c2bf15b2fb97183a73823b668cb23212c4bbd9cf5434a91b302f39140bc9c8b\",\"urn:rulespec:document-understanding:assertion:2995772ed4d341dfa42c1b6fb74f45abfe621eec03b469df98d519c922984178\",\"urn:rulespec:document-understanding:assertion:4a5b2ea19fe27c90012f97fdbd628aaa3a39293babe487547ba6401a4b8973ba\",\"urn:rulespec:document-understanding:assertion:56c5494ec3327bcf30a8f233ba596d375962c0aabf3e0d66ab5b0e78eb3ae74a\",\"urn:rulespec:document-understanding:assertion:0dd6735ed913d32d28743337c6b7ab339d15a7f3fd45880a913c5620becfe2ef\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":16655,\"evidence\":[{\"end\":16655,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A034f7c0701641ac491c4788373a7cbb227323ee386a4483e5d3f3bbb6ac2d316:15306:16655:sha256-50290e1b765c281e548df63d4ae156ef0f89f4ac71d7fed402491154b2dfe35a\",\"quote\":\"It shall be the duty of the Secretary to assure that unemployment insurance and employment service offices in each State, as appropriate, upon request of a public agency administering or supervising the administration of a State program funded under part A of title IV of the Social Security Act [42 U.S.C. 601 et seq.], of a public agency charged with any duty or responsibility under any program or activity authorized or required under part D of title IV of such Act [42 U.S.C. 651 et seq.], or of a State agency charged with the administration of the supplemental nutrition assistance program in a State under the Food and Nutrition Act of 2008 (7 U.S.C. 2011 et seq.), shall (and, notwithstanding any other provision of law, is authorized to) furnish to such agency making the request, from any data contained in the files of any such office, information with respect to any individual specified in the request as to (1) whether such individual is receiving, has received, or has made application for, unemployment compensation, and the amount of any such compensation being received by such individual, (2) the current (or most recent) home address of such individual, and (3) whether such individual has refused an offer of employment and, if so, a description of the employment so offered and the terms, conditions, and rate of pay therefor.\",\"start\":15306},{\"end\":15343,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A034f7c0701641ac491c4788373a7cbb227323ee386a4483e5d3f3bbb6ac2d316:15330:15343:sha256-67afe9d5c4310238267da793c265a616f9e90d554f2458a8065b7bb971d853b5\",\"quote\":\"the Secretary\",\"start\":15330},{\"end\":15326,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A034f7c0701641ac491c4788373a7cbb227323ee386a4483e5d3f3bbb6ac2d316:15309:15326:sha256-9e09f1567f7f1ac882b178ea88b4149709851b6ead4e4f8e69769feb11091d55\",\"quote\":\"shall be the duty\",\"start\":15309},{\"end\":16655,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A034f7c0701641ac491c4788373a7cbb227323ee386a4483e5d3f3bbb6ac2d316:15306:16655:sha256-50290e1b765c281e548df63d4ae156ef0f89f4ac71d7fed402491154b2dfe35a\",\"quote\":\"It shall be the duty of the Secretary to assure that unemployment insurance and employment service offices in each State, as appropriate, upon request of a public agency administering or supervising the administration of a State program funded under part A of title IV of the Social Security Act [42 U.S.C. 601 et seq.], of a public agency charged with any duty or responsibility under any program or activity authorized or required under part D of title IV of such Act [42 U.S.C. 651 et seq.], or of a State agency charged with the administration of the supplemental nutrition assistance program in a State under the Food and Nutrition Act of 2008 (7 U.S.C. 2011 et seq.), shall (and, notwithstanding any other provision of law, is authorized to) furnish to such agency making the request, from any data contained in the files of any such office, information with respect to any individual specified in the request as to (1) whether such individual is receiving, has received, or has made application for, unemployment compensation, and the amount of any such compensation being received by such individual, (2) the current (or most recent) home address of such individual, and (3) whether such individual has refused an offer of employment and, if so, a description of the employment so offered and the terms, conditions, and rate of pay therefor.\",\"start\":15306}],\"id\":\"urn:rulespec:document-understanding:revision:6d4e6d6a1699562d131300e88667127b4cf27547093557ad22734450581b79c5\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:0c2bf15b2fb97183a73823b668cb23212c4bbd9cf5434a91b302f39140bc9c8b\",\"modality\":\"must\",\"modality_quote\":\"shall be the duty\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:6dbb34e7c85972c2baa21f3eef974c5bca74ef04215640fb0f38da3a0d30933a\",\"origin\":\"aiSuggested\",\"quote\":\"It shall be the duty of the Secretary to assure that unemployment insurance and employment service offices in each State, as appropriate, upon request of a public agency administering or supervising the administration of a State program funded under part A of title IV of the Social Security Act [42 U.S.C. 601 et seq.], of a public agency charged with any duty or responsibility under any program or activity authorized or required under part D of title IV of such Act [42 U.S.C. 651 et seq.], or of a State agency charged with the administration of the supplemental nutrition assistance program in a State under the Food and Nutrition Act of 2008 (7 U.S.C. 2011 et seq.), shall (and, notwithstanding any other provision of law, is authorized to) furnish to such agency making the request, from any data contained in the files of any such office, information with respect to any individual specified in the request as to (1) whether such individual is receiving, has received, or has made application for, unemployment compensation, and the amount of any such compensation being received by such individual, (2) the current (or most recent) home address of such individual, and (3) whether such individual has refused an offer of employment and, if so, a description of the employment so offered and the terms, conditions, and rate of pay therefor.\",\"references\":[\"42 U.S.C. 601 et seq.\",\"42 U.S.C. 651 et seq.\",\"7 U.S.C. 2011 et seq.\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:faf97a4257a841a28f91236c9fdc4b57357ec7aedfde74205521f56bb891f7f6\",\"scope_quotes\":[\"It shall be the duty of the Secretary to assure that unemployment insurance and employment service offices in each State, as appropriate, upon request of a public agency administering or supervising the administration of a State program funded under part A of title IV of the Social Security Act [42 U.S.C. 601 et seq.], of a public agency charged with any duty or responsibility under any program or activity authorized or required under part D of title IV of such Act [42 U.S.C. 651 et seq.], or of a State agency charged with the administration of the supplemental nutrition assistance program in a State under the Food and Nutrition Act of 2008 (7 U.S.C. 2011 et seq.), shall (and, notwithstanding any other provision of law, is authorized to) furnish to such agency making the request, from any data contained in the files of any such office, information with respect to any individual specified in the request as to (1) whether such individual is receiving, has received, or has made application for, unemployment compensation, and the amount of any such compensation being received by such individual, (2) the current (or most recent) home address of such individual, and (3) whether such individual has refused an offer of employment and, if so, a description of the employment so offered and the terms, conditions, and rate of pay therefor.\"],\"scope_text\":\"upon request of a public agency administering or supervising the administration of a State program funded under part A of title IV of the Social Security Act [42 U.S.C. 601 et seq.], of a public agency charged with any duty or responsibility under any program or activity authorized or required under part D of title IV of such Act [42 U.S.C. 651 et seq.], or of a State agency charged with the administration of the supplemental nutrition assistance program in a State under the Food and Nutrition Act of 2008 (7 U.S.C. 2011 et seq.)\",\"section_id\":\"urn:rulespec:document-understanding:section:80835c86ea7dc4e3ace4a4479bf9d3e4ff2ffb6b59699984c4faaabf32ff5305\",\"start\":15306,\"summary\":\"The Secretary has a duty to assure that unemployment insurance and employment service offices in each State, as appropriate, upon request of a public agency administering or supervising the administration of a State program funded under part A of title IV of the Social Security Act, of a public agency charged with any duty or responsibility under any program or activity authorized or required under part D of title IV of such Act, or of a State agency charged with the administration of the supplemental nutrition assistance program in a State under the Food and Nutrition Act of 2008, furnish to such requesting agency, from data contained in their files, specified information regarding any individual specified in the request as to: (1) whether the individual is receiving, has received, or has applied for unemployment compensation, and the amount received; (2) the individual's current (or most recent) home address; and (3) whether the individual has refused an offer of employment and, if so, a description of the employment offered and the terms, conditions, and rate of pay.\",\"target_ids\":[],\"term_refs\":[\"urn:rulespec:document-understanding:term:31deebad2933ba66b0019eb6b68305e4db704bcda5041fec1ff917dc228f19d0\",\"urn:rulespec:document-understanding:term:9d722194346bc5a9e5121599681c43b603ea94c6b4faa9756601595fbccf47b2\",\"urn:rulespec:document-understanding:term:c778a168b0e4dd532963758792ed5aa198fb382fae247a1db55657cbb4bb4a94\",\"urn:rulespec:document-understanding:term:13ff59a3d70a53283f7d6005838549d5a945ba3766a4984449f75988cadb846d\"],\"typed_values\":[]}",

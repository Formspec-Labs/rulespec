      "@id": "urn:rulespec:document-understanding:revision:6d4e6d6a1699562d131300e88667127b4cf27547093557ad22734450581b79c5",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:6d4e6d6a1699562d131300e88667127b4cf27547093557ad22734450581b79c5",

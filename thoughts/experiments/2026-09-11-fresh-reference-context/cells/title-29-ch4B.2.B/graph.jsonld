      "dcterms:description": "{\"action\":\"\",\"actor\":\"The Secretary\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:2ecc7f03287215a2f96ec78732ea7746c5db0c50dbfc259643d91fac11f17a93\",\"urn:rulespec:document-understanding:assertion:e4b060c9638e934abb86e76080d996f71508c7f36fa505d6916d74ee3d4e617d\",\"urn:rulespec:document-understanding:assertion:3d0d6ce4635338dd57dc7cc48783b0cbb1703abb51ebfa78cddb6deebd0b998f\",\"urn:rulespec:document-understanding:assertion:e735e7b4fe0f2163b735e185772f8bfdbf307a8ecccffdcb86a780a4ca05ceb3\",\"urn:rulespec:document-understanding:assertion:e0635feaf2c6c053643dbecc94f9b2476676caac9a12c170026c4b053a94d235\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":15247,\"evidence\":[{\"end\":15247,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A034f7c0701641ac491c4788373a7cbb227323ee386a4483e5d3f3bbb6ac2d316:14703:15247:sha256-131f15e85b35fb81c64fc8124d440f29ad86260280d3e2b5cdd20147898a3acf\",\"quote\":\"The Secretary shall assist in coordinating the State public employment service offices throughout the country and in increasing their usefulness by developing and prescribing minimum standards of efficiency, assisting them in meeting problems peculiar to their localities, promoting uniformity in their administrative and statistical procedure, furnishing and publishing information as to opportunities for employment and other information of value in the operation of the system, and maintaining a system for clearing labor between the States.\",\"start\":14703},{\"end\":14716,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A034f7c0701641ac491c4788373a7cbb227323ee386a4483e5d3f3bbb6ac2d316:14703:14716:sha256-d6dd2bb6d3c44b4545cc3f97cb6f8a38842ecd30d2c58ec3e1c53a8c1a0ac77c\",\"quote\":\"The Secretary\",\"start\":14703},{\"end\":14722,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A034f7c0701641ac491c4788373a7cbb227323ee386a4483e5d3f3bbb6ac2d316:14717:14722:sha256-56ee5b508706bf2de91712d85d6d1e11ddbff01949142ed6e8c22e3b1bed1c71\",\"quote\":\"shall\",\"start\":14717}],\"id\":\"urn:rulespec:document-understanding:revision:9bb84d63e8a33f5e9e890aec58f7aa3ad8e74729c70f65994089acda25f15761\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:e735e7b4fe0f2163b735e185772f8bfdbf307a8ecccffdcb86a780a4ca05ceb3\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:f9fbe991257b5ce8fd080ffe9cf790b02c894ced33b6388dd65577a7ee43bade\",\"origin\":\"aiSuggested\",\"quote\":\"The Secretary shall assist in coordinating the State public employment service offices throughout the country and in increasing their usefulness by developing and prescribing minimum standards of efficiency, assisting them in meeting problems peculiar to their localities, promoting uniformity in their administrative and statistical procedure, furnishing and publishing information as to opportunities for employment and other information of value in the operation of the system, and maintaining a system for clearing labor between the States.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:32ab3bc0b967e5ef7fc903be8f510116e6969a1888abe1c7a98893c913c0354e\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"urn:rulespec:document-understanding:section:80835c86ea7dc4e3ace4a4479bf9d3e4ff2ffb6b59699984c4faaabf32ff5305\",\"start\":14703,\"summary\":\"The Secretary must assist in coordinating the State public employment service offices throughout the country and in increasing their usefulness by developing and prescribing minimum standards of efficiency, assisting them in meeting problems peculiar to their localities, promoting uniformity in their administrative and statistical procedure, furnishing and publishing information as to opportunities for employment and other information of value in the operation of the system, and maintaining a system for clearing labor between the States.\",\"target_ids\":[],\"term_refs\":[\"urn:rulespec:document-understanding:term:31deebad2933ba66b0019eb6b68305e4db704bcda5041fec1ff917dc228f19d0\"],\"typed_values\":[]}",

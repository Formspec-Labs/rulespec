    {
      "@id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A034f7c0701641ac491c4788373a7cbb227323ee386a4483e5d3f3bbb6ac2d316:18296:18609:sha256-b85414c2bef9897905d190372e83e2e7f35446b267ba11cf3b896fdca1210fb2",
      "@type": "rkaf:SourceFragment",
      "oa:hasSource": "urn:rulespec:document-understanding:document:034f7c0701641ac491c4788373a7cbb227323ee386a4483e5d3f3bbb6ac2d316",
      "rkaf:fragmentIdentityScheme": "rkaf:carrier-local-fragment",
      "rkaf:sourceArtifactDigest": "sha256:034f7c0701641ac491c4788373a7cbb227323ee386a4483e5d3f3bbb6ac2d316",
      "rkaf:fragmentContentDigest": "sha256:b85414c2bef9897905d190372e83e2e7f35446b267ba11cf3b896fdca1210fb2",
      "rkaf:selectorKind": [
        "oa:TextQuoteSelector",
        "oa:TextPositionSelector"
      ],
      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "In order to improve service delivery, avoid duplication of services, and enhance coordination of services, including location of staff to ensure access to services under section 49f(a) of this title statewide in underserved areas, employment service offices in each State shall be colocated with one-stop centers."
        },
        {
          "@type": "oa:TextPositionSelector",

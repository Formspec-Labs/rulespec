        "@value": "{\"actor\":\"The Secretary\",\"kind\":\"requirement\",\"modality\":\"must\",\"summary\":\"The Secretary must assist in the coordination and development of a nationwide system of public labor exchange services, provided as part of the one-stop customer service systems of the States.\",\"term_refs\":[\"urn:rulespec:document-understanding:term:31deebad2933ba66b0019eb6b68305e4db704bcda5041fec1ff917dc228f19d0\",\"urn:rulespec:document-understanding:term:c778a168b0e4dd532963758792ed5aa198fb382fae247a1db55657cbb4bb4a94\"]}",

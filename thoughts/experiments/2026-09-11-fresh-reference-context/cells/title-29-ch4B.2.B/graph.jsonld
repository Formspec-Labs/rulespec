      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:830917a207535c1625df34e1fbeb8d0f996dcf0c1a0e4f8c81606393399f4548",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:fcd7e7576bc2b76a29ca473a61de7d01316d1e35ef7cd5d9dd7aee7db93bea75",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:03a0557498b65628057485644df3e59d7d2eca970038bccacc39553e01082d60",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:states-authority",
      "rkaf:assertsValue": {
        "@value": "Notwithstanding any other provision of law, unemployment insurance and employment service offices in each State, as appropriate, are authorized to furnish to a requesting qualifying agency—namely, a public agency administering or supervising the administration of a State program funded under part A of title IV of the Social Security Act, a public agency charged with any duty or responsibility under any program or activity authorized or required under part D of title IV of such Act, or a State agency charged with administering the supplemental nutrition assistance program under the Food and Nutrition Act of 2008—information from file data regarding an individual specified in the request as to whether the individual receives, received, or applied for unemployment compensation (and the amount), current or most recent home address, and whether the individual refused an offer of employment, with a description of the offered employment and its terms, conditions, and pay rate.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

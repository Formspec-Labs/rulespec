      "@id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A34ab00d74d098e7a97f5e36e70fbb24ca8a0b1a16f5e62c6c64a1050011d93b3:4893:5288:sha256-fedd34b1ac283d02e99ef26bfe74241496982e0e2dc2d4a2f18f1f40bdf2fb1c",

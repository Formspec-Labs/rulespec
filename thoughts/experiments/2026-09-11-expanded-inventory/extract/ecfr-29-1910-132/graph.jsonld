      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "(4) The employer is not required to pay for:\n\n(i) The logging boots required by 29 CFR 1910.266(d)(1)(v);\n\n(ii) Everyday clothing, such as long-sleeve shirts, long pants, street shoes, and normal work boots; or\n\n(iii) Ordinary clothing, skin creams, or other items, used solely for protection from weather, such as winter coats, jackets, gloves, parkas, rubber boots, hats, raincoats, ordinary sunglasses, and sunscreen."
        },
        {
          "@type": "oa:TextPositionSelector",
          "oa:start": 4355,
          "oa:end": 4775,
          "rkaf:coordinateSystem": "rkaf:unicode-codepoint"
        }

      "rkaf:hasContentDigest": "sha256:ac6b82effa8316cb9b12f585184a5e8f9d5f530281ba7acc2d52fec8c709b242",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"the employer\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:8dea409d572eb342e54f07ec59c7bbd2409516957dff2eae4536cd0babbd985e\",\"urn:rulespec:document-understanding:assertion:6c1685e0c887ffc303a5360df1710ff671d83d9d1b6d703d9dc39e4ea163087c\",\"urn:rulespec:document-understanding:assertion:0e67178b24fa2dea98a610073517a2d4b49db861139c4d3249669776094f16b6\",\"urn:rulespec:document-understanding:assertion:b5fa4b259744b0d23b2788cae4a3a7c1ec0c8c6fa729fcf45a61da3a4cfbb73d\",\"urn:rulespec:document-understanding:assertion:08cd9248a6f1fdcd07b95beb230f214daea022566cafb62ea2cf5d6620259963\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":3384,\"evidence\":[{\"end\":3384,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A34ab00d74d098e7a97f5e36e70fbb24ca8a0b1a16f5e62c6c64a1050011d93b3:2744:3384:sha256-40a7f5ccad8199ce4a97e9f4c1f616e00d950c8108de11b136e4c588681c6250\",\"quote\":\"(3) When the employer has reason to believe that any affected employee who has already been trained does not have the understanding and skill required by paragraph (f)(2) of this section, the employer shall retrain each such employee. Circumstances where retraining is required include, but are not limited to, situations where:\\n\\n(i) Changes in the workplace render previous training obsolete; or\\n\\n(ii) Changes in the types of PPE to be used render previous training obsolete; or\\n\\n(iii) Inadequacies in an affected employee's knowledge or use of assigned PPE indicate that the employee has not retained the requisite understanding or skill.\",\"start\":2744},{\"end\":2958,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A34ab00d74d098e7a97f5e36e70fbb24ca8a0b1a16f5e62c6c64a1050011d93b3:2945:2958:sha256-ba841f56d30cd20aa8da184e6da6b9748b97da5c7de11cabf91f78cba501fb2f\",\"quote\":\"shall retrain\",\"start\":2945},{\"end\":3072,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A34ab00d74d098e7a97f5e36e70fbb24ca8a0b1a16f5e62c6c64a1050011d93b3:2744:3072:sha256-c4c0266a6f7322e60a0631f127bf9aea329a8e7d2003314e047014b13cc566d2\",\"quote\":\"(3) When the employer has reason to believe that any affected employee who has already been trained does not have the understanding and skill required by paragraph (f)(2) of this section, the employer shall retrain each such employee. Circumstances where retraining is required include, but are not limited to, situations where:\",\"start\":2744}],\"id\":\"urn:rulespec:document-understanding:revision:b472b09f0e9b6fe2608e17a50fcb6f910a590cce72570081c281b0876add40e5\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:08cd9248a6f1fdcd07b95beb230f214daea022566cafb62ea2cf5d6620259963\",\"modality\":\"must\",\"modality_quote\":\"shall retrain\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:667a908509d7bccb12253a3b6f500a3dc06b6cb3dd6d4dc4152e1551a1804026\",\"origin\":\"aiSuggested\",\"quote\":\"(3) When the employer has reason to believe that any affected employee who has already been trained does not have the understanding and skill required by paragraph (f)(2) of this section, the employer shall retrain each such employee. Circumstances where retraining is required include, but are not limited to, situations where:\\n\\n(i) Changes in the workplace render previous training obsolete; or\\n\\n(ii) Changes in the types of PPE to be used render previous training obsolete; or\\n\\n(iii) Inadequacies in an affected employee's knowledge or use of assigned PPE indicate that the employee has not retained the requisite understanding or skill.\",\"references\":[\"(f)(2)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:37bdd41d509421e34e13ac7fb521c4c169f92a625515c1eecdc95f9572a4d03e\",\"scope_quotes\":[\"(3) When the employer has reason to believe that any affected employee who has already been trained does not have the understanding and skill required by paragraph (f)(2) of this section, the employer shall retrain each such employee. Circumstances where retraining is required include, but are not limited to, situations where:\"],\"scope_text\":\"When the employer has reason to believe that any affected employee who has already been trained does not have the understanding and skill required by paragraph (f)(2) of this section\",\"section_id\":\"urn:rulespec:document-understanding:section:87c1a2c85baf7201b9a8fbaa89b09346664233b009ba47bdf620475e2e24013c\",\"start\":2744,\"summary\":\"When the employer has reason to believe that any affected employee who has already been trained does not have the understanding and skill required by paragraph (f)(2) of § 1910.132, the employer shall retrain each such employee; circumstances where retraining is required include, but are not limited to, situations where changes in the workplace render previous training obsolete, changes in the types of PPE to be used render previous training obsolete, or inadequacies in an affected employee's knowledge or use of assigned PPE indicate that the employee has not retained the requisite understanding or skill.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

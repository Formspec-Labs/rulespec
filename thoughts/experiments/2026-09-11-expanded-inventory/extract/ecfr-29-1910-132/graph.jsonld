      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"Each such employee\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:f8836c2e5dc7ce74a9bd331333a517289c80cd46059cdee9502e5ba83aa6bca7\",\"urn:rulespec:document-understanding:assertion:d02b6c73ad38503fb15838288c7418592bb9a2fe3dbb81ea7d7883ddc9a51c89\",\"urn:rulespec:document-understanding:assertion:0aae59383da2f96d45110319908a41e383fafe067aa620fa03487dd0b8a015df\",\"urn:rulespec:document-understanding:assertion:eb329ace2b96764035dbfca12992cea98cdffd313e7e04ed550e53323370d84b\",\"urn:rulespec:document-understanding:assertion:9228738e8da1760e2cf6ccf4c021d77b3499049577b6ebb41898d4ca9fe48baa\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":2516,\"evidence\":[{\"end\":2516,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A34ab00d74d098e7a97f5e36e70fbb24ca8a0b1a16f5e62c6c64a1050011d93b3:2110:2516:sha256-70ab0e664f8dbb05fc6b0439f445eadb6cdc3a94f0cdb4799e6cf95984596a60\",\"quote\":\"(f) Training. (1) The employer shall provide training to each employee who is required by this section to use PPE. Each such employee shall be trained to know at least the following:\\n\\n(i) When PPE is necessary;\\n\\n(ii) What PPE is necessary;\\n\\n(iii) How to properly don, doff, adjust, and wear PPE;\\n\\n(iv) The limitations of the PPE; and,\\n\\n(v) The proper care, maintenance, useful life and disposal of the PPE.\",\"start\":2110},{\"end\":2243,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A34ab00d74d098e7a97f5e36e70fbb24ca8a0b1a16f5e62c6c64a1050011d93b3:2225:2243:sha256-3da9df27877814acb693638cff60826adb30d38f70d1333f415e40b4d87ef495\",\"quote\":\"Each such employee\",\"start\":2225},{\"end\":2260,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A34ab00d74d098e7a97f5e36e70fbb24ca8a0b1a16f5e62c6c64a1050011d93b3:2244:2260:sha256-1ad154495f1799319ccfe30a4b5a05c0f12ff93fc584b5b5a524bf4312008508\",\"quote\":\"shall be trained\",\"start\":2244},{\"end\":2292,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A34ab00d74d098e7a97f5e36e70fbb24ca8a0b1a16f5e62c6c64a1050011d93b3:2110:2292:sha256-6555e10680b9bcd05fffdcdace88162040314c87bf98adcd4a2301e42704b099\",\"quote\":\"(f) Training. (1) The employer shall provide training to each employee who is required by this section to use PPE. Each such employee shall be trained to know at least the following:\",\"start\":2110}],\"id\":\"urn:rulespec:document-understanding:revision:dae45c1a583597effaaf9f1ee1bcf72310c426a31cef3adec7ba765182ed50ac\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:9228738e8da1760e2cf6ccf4c021d77b3499049577b6ebb41898d4ca9fe48baa\",\"modality\":\"must\",\"modality_quote\":\"shall be trained\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:c5f90a00faceb32a9fb34205635f16ba5d2be50c3b2415294755f1a152f396db\",\"origin\":\"aiSuggested\",\"quote\":\"(f) Training. (1) The employer shall provide training to each employee who is required by this section to use PPE. Each such employee shall be trained to know at least the following:\\n\\n(i) When PPE is necessary;\\n\\n(ii) What PPE is necessary;\\n\\n(iii) How to properly don, doff, adjust, and wear PPE;\\n\\n(iv) The limitations of the PPE; and,\\n\\n(v) The proper care, maintenance, useful life and disposal of the PPE.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:9dc38673d56e7143b1cbef8826da6494c3adaf0556aa51e489cf457ae7ba1f1e\",\"scope_quotes\":[\"(f) Training. (1) The employer shall provide training to each employee who is required by this section to use PPE. Each such employee shall be trained to know at least the following:\"],\"scope_text\":\"Each employee who is required by this section to use PPE\",\"section_id\":\"urn:rulespec:document-understanding:section:87c1a2c85baf7201b9a8fbaa89b09346664233b009ba47bdf620475e2e24013c\",\"start\":2110,\"summary\":\"Each employee required by § 1910.132 to use PPE shall be trained to know at least: when PPE is necessary; what PPE is necessary; how to properly don, doff, adjust, and wear PPE; the limitations of the PPE; and the proper care, maintenance, useful life and disposal of the PPE.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

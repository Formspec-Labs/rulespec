      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"The employer\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:455ccdb873ff5a1a72fdc5cb1a2e222e746837adfca9e3d48b187301ad48cf34\",\"urn:rulespec:document-understanding:assertion:4e29e06fe6b2951c1be3499ea0c594659e9d43693ca15f9e8e0ae7ba6665df19\",\"urn:rulespec:document-understanding:assertion:fe1a8255aeae06ec689569c847b92db8411479657bc275599cdecb73e1eaafe6\",\"urn:rulespec:document-understanding:assertion:6175f6f49daa30570449031a46c9d9bc1efaa34e23b056f25609330062d57664\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":1231,\"evidence\":[{\"end\":1231,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A34ab00d74d098e7a97f5e36e70fbb24ca8a0b1a16f5e62c6c64a1050011d93b3:935:1231:sha256-fd2b5c1045c9e2707385b0b5e62d7ca6c1522e59e97a09eb84ca6a69ad56f395\",\"quote\":\"(d) Hazard assessment and equipment selection. (1) The employer shall assess the workplace to determine if hazards are present, or are likely to be present, which necessitate the use of personal protective equipment (PPE). If such hazards are present, or likely to be present, the employer shall:\",\"start\":935},{\"end\":998,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A34ab00d74d098e7a97f5e36e70fbb24ca8a0b1a16f5e62c6c64a1050011d93b3:986:998:sha256-eefbd88d5db7591f0fba1d7815d52329849e45a6af060ed107f64c722ed6245e\",\"quote\":\"The employer\",\"start\":986}],\"id\":\"urn:rulespec:document-understanding:revision:27d9161e89613e3df30b0739ecfaed3614bb86b72220ccba1250633a339985e5\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:6175f6f49daa30570449031a46c9d9b
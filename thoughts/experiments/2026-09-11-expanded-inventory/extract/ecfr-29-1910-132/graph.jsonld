      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"The employer\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:cc88e7a858a50165b00ff4dd665951fd136a0b097ffea70c6c02498a26213f15\",\"urn:rulespec:document-understanding:assertion:0b7591853dd41b47b5998ff1c70a4c5c6d58f3742082640c5ffb8a711a3de3ab\",\"urn:rulespec:document-understanding:assertion:cc1a7981e80afdb5a1231cae3722bd29b3d21404d31fe3d60a7ab79fb0dee1bf\",\"urn:rulespec:document-understanding:assertion:fbed6a6655a5977a74922712d92e3ea20d41152e40305796b08fb11e59a85a57\",\"urn:rulespec:document-understanding:assertion:ac7793985dbb02d32e7e78f9434638e7e364a48178f5436c648ac5447a27b3cc\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":5288,\"evidence\":[{\"end\":5288,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A34ab00d74d098e7a97f5e36e70fbb24ca8a0b1a16f5e62c6c64a1050011d93b3:4893:5288:sha256-fedd34b1ac283d02e99ef26bfe74241496982e0e2dc2d4a2f18f1f40bdf2fb1c\",\"quote\":\"(6) Where an employee provides adequate protective equipment he or she owns pursuant to paragraph (b) of this section, the employer may allow the employee to use it and is not required to reimburse the employee for that equipment. The employer shall not require an employee to provide or pay for his or her own PPE, unless the PPE is excepted by paragraphs (h)(2) through (h)(5) of this section.\",\"start\":4893},{\"end\":5136,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A34ab00d74d098e7a97f5e36e70fbb24ca8a0b1a16f5e62c6c64a1050011d93b3:5124:5136:sha256-eefbd88d5db7591f0fba1d7815d52329849e45a6af060ed107f64c722ed6245e\",\"quote\":\"The employer\",\"start\":5124},{\"end\":5154,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A34ab00d74d098e7a97f5e36e70fbb24ca8a0b1a16f5e62c6c64a1050011d93b3:5137:5154:sha256-3e44d1dac31939ee338eec11f0460bc0efe5eb4c980bea4716ad51444d5bcf6b\",\"quote\":\"shall not require\",\"start\":5137},{\"end\":5288,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A34ab00d74d098e7a97f5e36e70fbb24ca8a0b1a16f5e62c6c64a1050011d93b3:4893:5288:sha256-fedd34b1ac283d02e99ef26bfe74241496982e0e2dc2d4a2f18f1f40bdf2fb1c\",\"quote\":\"(6) Where an employee provides adequate protective equipment he or she owns pursuant to paragraph (b) of this section, the employer may allow the employee to use it and is not required to reimburse the employee for that equipment. The employer shall not require an employee to provide or pay for his or her own PPE, unless the PPE is excepted by paragraphs (h)(2) through (h)(5) of this section.\",\"start\":4893}],\"id\":\"urn:rulespec:document-understanding:revision:7250d82662f9edb1ca5ca2a2ce7dd6752c22a66d79745f79c6cd71a8d7280f11\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"prohibition\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:ac7793985dbb02d32e7e78f9434638e7e364a48178f5436c648ac5447a27b3cc\",\"modality\":\"must_not\",\"modality_quote\":\"shall not require\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:cf3734156c9ae9e982c0d5fb2e04475f539a0f70ffed65b4571eece86df08cff\",\"origin\":\"aiSuggested\",\"quote\":\"(6) Where an employee provides adequate protective equipment he or she owns pursuant to paragraph (b) of this section, the employer may allow the employee to use it and is not required to reimburse the employee for that equipment. The employer shall not require an employee to provide or pay for his or her own PPE, unless the PPE is excepted by paragraphs (h)(2) through (h)(5) of this section.\",\"references\":[\"(h)(2)\",\"(h)(5)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:ea5757a0e58b95ced73f8f0672a21243370aa02e0f91e8e04eba813a06722c81\",\"scope_quotes\":[\"(6) Where an employee provides adequate protective equipment he or she owns pursuant to paragraph (b) of this section, the employer may allow the employee to use it and is not required to reimburse the employee for that equipment. The employer shall not require an employee to provide or pay for his or her own PPE, unless the PPE is excepted by paragraphs (h)(2) through (h)(5) of this section.\"],\"scope_text\":\"unless the PPE is excepted by paragraphs (h)(2) through (h)(5) of this section\",\"section_id\":\"urn:rulespec:document-understanding:section:87c1a2c85baf7201b9a8fbaa89b09346664233b009ba47bdf620475e2e24013c\",\"start\":4893,\"summary\":\"The employer shall not require an employee to provide or pay for his or her own PPE, unless the PPE is excepted by paragraphs (h)(2) through (h)(5) of § 1910.132.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

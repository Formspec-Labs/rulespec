gment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A34ab00d74d098e7a97f5e36e70fbb24ca8a0b1a16f5e62c6c64a1050011d93b3:38:606:sha256-fa2860b981f9a40914994e37db4806b9e598522c1291b4cc29d454b6fc8d3730\",\"quote\":\"(a) Application. Protective equipment, including personal protective equipment for eyes, face, head, and extremities, protective clothing, respiratory devices, and protective shields and barriers, shall be provided, used, and maintained in a sanitary and reliable condition wherever it is necessary by reason of hazards of processes or environment, chemical hazards, radiological hazards, or mechanical irritants encountered in a manner capable of causing injury or impairment in the function of any part of the body through absorption, inhalation or physical contact.\",\"start\":38}],\"id\":\"urn:rulespec:document-understanding:revision:4491fd9a413d2e3bb30384706a65ce725efe57d152b14f0a814396894de0750c\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:b6344cd95262fa7ae202b32d57c886c646acc0e199ca79c9ad2e7f17552aff36\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:b0a8cfd4886a057a6bb439dc042a693c1c991d19894e36d4dc43949956f4d847\",\"origin\":\"aiSuggested\",\"quote\":\"(a) Application. Protective equipment, including personal protective equipment for eyes, face, head, and extremities, protective clothing, respiratory devices, and protective shields and barriers, shall be provided, used, and maintained in a sanitary and reliable condition wherever it is necessary by reason of hazards of processes or environment, chemical hazards, radiological hazards, or mechanical irritants encountered in a manner capable of causing injury or impairment in the function of any part of the body through absorption, inhalation or physical contact.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:033a8adc97741860484ca61d470d6ceee0d314c63f66a7a3e3f2495258c97b8e\",\"scope_quotes\":[\"(a) Application. Protective equipment, including personal protective equipment for eyes, face, head, and extremities, protective clothing, respiratory devices, and protective shields and barriers, shall be provided, used, and maintained in a sanitary and reliable condition wherever it is necessary by reason of hazards of processes or environment, chemical hazards, radiological hazards, or mechanical irritants encountered in a manner capable of causing injury or impairment in the function of any part of the body through absorption, inhalation or physical contact.\"],\"scope_text\":\"wherever it is necessary by reason of hazards of processes or environment, chemical hazards, radiological hazards, or mechanical irritants encountered in a manner capable of causing injury or impairment in the function of any part of the body through absorption, inhalation or physical contact\",\"section_id\":\"urn:rulespec:document-understanding:section:87c1a2c85baf7201b9a8fbaa89b09346664233b009ba47bdf620475e2e24013c\",\"start\":38,\"summary\":\"Protective equipment, including personal protective equipment for eyes, face, head, and extremities, protective clothing, respiratory devices, and protective shields and barriers, shall be provided, used, and maintained in a sanitary and reliable condition wherever it is necessary by reason of hazards of processes or environment, chemical hazards, radiological hazards, or mechanical irritants encountered in a manner capable of causing injury or impairment in the function of any part of the body through absorption, inhalation or physical contact.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

risdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:36d9bcf6caada5a25ba2923ac92f96b5c89e2031aa6e8f3196cefb224116f20b\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:81c9cc1e767bd79fd6ab63ca6acfd30c4f31e3de05edb181678a44dd1cabcaf9\",\"origin\":\"aiSuggested\",\"quote\":\"(iii) Select PPE that properly fits each affected employee.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:399b30f23e9b52b88aba03c5677227bbc056452707462c630d8829b78771b6e7\",\"scope_quotes\":[\"(d) Hazard assessment and equipment selection. (1) The employer shall assess the workplace to determine if hazards are present, or are likely to be present, which necessitate the use of personal protective equipment (PPE). If such hazards are present, or likely to be present, the employer shall:\"],\"scope_text\":\"If such hazards are present, or likely to be present\",\"section_id\":\"urn:rulespec:document-understanding:section:87c1a2c85baf7201b9a8fbaa89b09346664233b009ba47bdf620475e2e24013c\",\"start\":1464,\"summary\":\"If hazards necessitating the use of personal protective equipment (PPE) are present, or likely to be present, in the workplace, the employer shall select PPE that properly fits each affected employee.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

    {
      "@id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ad3da814254fdb3eef2724f44356a286098a93655960b5fe2dd8580f5f1516a11:2294:2853:sha256-73d7cc0423182e90ad47ab7785511652911f637c0c021d093c744037c6935677",
      "@type": "rkaf:SourceFragment",
      "oa:hasSource": "urn:rulespec:document-understanding:document:d3da814254fdb3eef2724f44356a286098a93655960b5fe2dd8580f5f1516a11",
      "rkaf:fragmentIdentityScheme": "rkaf:carrier-local-fragment",
      "rkaf:sourceArtifactDigest": "sha256:d3da814254fdb3eef2724f44356a286098a93655960b5fe2dd8580f5f1516a11",
      "rkaf:fragmentContentDigest": "sha256:73d7cc0423182e90ad47ab7785511652911f637c0c021d093c744037c6935677",
      "rkaf:selectorKind": [
        "oa:TextQuoteSelector",
        "oa:TextPositionSelector"
      ],
      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "(f) A person who holds a flight instructor certificate need not accomplish the one hour of ground training specified in paragraph (a) of this section if that person has, within the period specified in paragraph (c) of this section, met one of the following requirements—\n\n(1) Satisfactorily completed the recent experience requirements for a flight instructor certificate under § 61.197; or\n\n(2) Reinstated the person's flight instructor privileges by satisfactorily completing an approved flight instructor refresher course in accordance with § 61.199(a)(1)."
        },
        {
          "@type": "oa:TextPositionSelector",
          "oa:start": 2294,
          "oa:end": 2853,
          "rkaf:coordinateSystem": "rkaf:unicode-codepoint"
        }
      ]
    },

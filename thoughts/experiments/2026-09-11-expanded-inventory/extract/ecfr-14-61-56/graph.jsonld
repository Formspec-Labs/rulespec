      ],
      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "(c) Except as provided in paragraphs (d), (e), and (g) of this section, no person may act as pilot in command of an aircraft unless, since the beginning of the 24th calendar month before the month in which that pilot acts as pilot in command, that person has—\n\n(1) Accomplished a flight review given in an aircraft for which that pilot is rated by an authorized instructor and \n\n(2) A logbook endorsed from an authorized instructor who gave the review certifying that the person has satisfactorily completed the review."
        },
        {
          "@type": "oa:TextPositionSelector",
          "oa:start": 761,
          "oa:end": 1280,
          "rkaf:coordinateSystem": "rkaf:unicode-codepoint"

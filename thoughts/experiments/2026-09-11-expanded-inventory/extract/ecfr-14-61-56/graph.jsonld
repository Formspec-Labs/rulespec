    {
      "@id": "urn:rulespec:document-understanding:revision:686a72cdb24a917b9fc179ee26c335004fa04c96c3219c4c2574214320f1a8ac",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:686a72cdb24a917b9fc179ee26c335004fa04c96c3219c4c2574214320f1a8ac",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:53b0859d5c48ad9347a85499f37ab1ea2d0e310370d54244211ed654784c6708",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"A person who has, within the period specified in paragraph (c) of this section, passed any of the following\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:65324311a7f37228a47e41cfe33da035a24daa97c9a57367ed9cd16e5558fd39\",\"urn:rulespec:document-understanding:assertion:4850ea10889ad8461b6468dce6c01c584493dc7596f3623b980a38b48ba31b47\",\"urn:rulespec:document-understanding:assertion:991dd9805da3c5769cf6f06cb11bf6a089cd7edbb62f9c2f8e79af19c38a66d4\",\"urn:rulespec:document-understanding:assertion:91fa08f33a235c63160eb6216cb5e19567d2e3f16f093032db248dab0bcbe529\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":2050,\"evidence\":[{\"end\":2050,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ad3da814254fdb3eef2724f44356a286098a93655960b5fe2dd8580f5f1516a11:1283:2050:sha256-388af05d451fd407cb25f7c9684ee3af473c3610d0c83689ed21e14167cb9f37\",\"quote\":\"(d) A person who has, within the period specified in paragraph (c) of this section, passed any of the following need not accomplish the flight review required by this section:\\n\\n(1) A pilot proficiency check or practical test conducted by an examiner, an approved pilot check airman, or a U.S. Armed Force, for a pilot certificate, rating, or operating privilege.\\n\\n(2) A practical test conducted by an examiner for one of the following:\\n\\n(i) The issuance of a flight instructor certificate,\\n\\n(ii) An additional rating on a flight instructor certificate,\\n\\n(iii) To meet the recent experience requirements for a flight instructor certificate in accordance with § 61.197(b)(1); or\\n\\n(iv) The reinstatement of flight instructor privileges in accordance with § 61.199(b)(2).\",\"start\":1283},{\"end\":1394,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ad3da814254fdb3eef2724f44356a286098a93655960b5fe2dd8580f5f1516a11:1287:1394:sha256-1b34c2832ef67742b2084a162b004684e8cd99c3464d94b27eed688efbe4e8df\",\"quote\":\"A person who has, within the period specified in paragraph (c) of this section, passed any of the following\",\"start\":1287},{\"end\":1403,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ad3da814254fdb3eef2724f44356a286098a93655960b5fe2dd8580f5f1516a11:1395:1403:sha256-b00eebc92fbf41e3d233b28a918c7b90de96d6a15c0daebb94dde8af457529df\",\"quote\":\"need not\",\"start\":1395}],\"id\":\"urn:rulespec:document-understanding:revision:686a72cdb24a917b9fc179ee26c335004fa04c96c3219c4c2574214320f1a8ac\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"exemption\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:91fa08f33a235c63160eb6216cb5e19567d2e3f16f093032db248dab0bcbe529\",\"modality\":\"not_required\",\"modality_quote\":\"need not\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:624bd3864a3d4f20d46f586fcae743df30b6053bd5a3afdd7e21c2b10493215d\",\"origin\":\"aiSuggested\",\"quote\":\"(d) A person who has, within the period specified in paragraph (c) of this section, passed any of the following need not accomplish the flight review required by this section:\\n\\n(1) A pilot proficiency check or practical test conducted by an examiner, an approved pilot check airman, or a U.S. Armed Force, for a pilot certificate, rating, or operating privilege.\\n\\n(2) A practical test conducted by an examiner for one of the following:\\n\\n(i) The issuance of a flight instructor certificate,\\n\\n(ii) An additional rating on a flight instructor certificate,\\n\\n(iii) To meet the recent experience requirements for a flight instructor certificate in accordance with § 61.197(b)(1); or\\n\\n(iv) The reinstatement of flight instructor privileges in accordance with § 61.199(b)(2).\",\"references\":[\"paragraph (c)\",\"§ 61.197(b)(1)\",\"§ 61.199(b)(2)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:7e767182d7ffcf5ebd3a3b29631b510bca0e23a4534e076f16af443876cb9762\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"urn:rulespec:document-understanding:section:42cb40bbcfd59390046da4f309e7efe3db131d3392ea1d046ffdd5be5af1d0b2\",\"start\":1283,\"summary\":\"A person who has, within the period specified in paragraph (c) of 14 CFR § 61.56, passed a practical test conducted by an examiner for the issuance of a flight instructor certificate, an additional rating on a flight instructor certificate, meeting recent experience requirements for a flight instructor certificate in accordance with § 61.197(b)(1), or the reinstatement of flight instructor privileges in accordance with § 61.199(b)(2), need not accomplish the flight review required by this section.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

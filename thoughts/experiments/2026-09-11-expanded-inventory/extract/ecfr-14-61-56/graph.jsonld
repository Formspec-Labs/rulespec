":\"urn:rulespec:document-understanding:rule:e8315e28e4ceb67c597138789abd6f90be50fbdc21ffb6b9ee5c683d4cf334d7\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"urn:rulespec:document-understanding:section:42cb40bbcfd59390046da4f309e7efe3db131d3392ea1d046ffdd5be5af1d0b2\",\"start\":28,\"summary\":\"Except as provided in paragraphs (b) and (f) of 14 CFR § 61.56, a flight review consists of a minimum of 1 hour of flight training and 1 hour of ground training.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

      "dcterms:description": "{\"action\":\"\",\"actor\":\"A person who holds a flight instructor certificate\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:a6c2a7629eebe80ed7d95ff7fd4fb3e08c9eb8dd3c26c65d3a41ce1e569bbf05\",\"urn:rulespec:document-understanding:assertion:4ac6369d021c412ebcb604f6ce38f7373a079fe11407891e5f4a12ef66206c0e\",\"urn:rulespec:document-understanding:assertion:90cf67e0d111c0fcd9b48d28b029a5db6493caa617832513021c06c149fae6f9\",\"urn:rulespec:document-understanding:assertion:8c05bfd090701fa0ba4498edc1691ea5314b1dd4e10ec3d71e7ddd9f54173755\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":2853,\"evidence\":[{\"end\":2853,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ad3da814254fdb3eef2724f44356a286098a93655960b5fe2dd8580f5f1516a11:2294:2853:sha256-73d7cc0423182e90ad47ab7785511652911f637c0c021d093c744037c6935677\",\"quote\":\"(f) A person who holds a flight instructor certificate need not accomplish the one hour of ground training specified in paragraph (a) of this section if that person has, within the period specified in paragraph (c) of this section, met one of the following requirements—\\n\\n(1) Satisfactorily completed the recent experience requirements for a flight instructor certificate under § 61.197; or\\n\\n(2) Reinstated the person's flight instructor privileges by satisfactorily completing an approved flight instructor refresher course in accordance with § 61.199(a)(1).\",\"start\":2294},{\"end\":2348,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ad3da814254fdb3eef2724f44356a286098a93655960b5fe2dd8580f5f1516a11:2298:2348:sha256-f91dc077a15c7aa09e03e2b58901d77212cb08f6f3de63c39cb12dd493daf0d6\",\"quote\":\"A person who holds a flight instructor certificate\",\"start\":2298},{\"end\":2357,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ad3da814254fdb3eef2724f44356a286098a93655960b5fe2dd8580f5f1516a11:2349:2357:sha256-b00eebc92fbf41e3d233b28a918c7b90de96d6a15c0daebb94dde8af457529df\",\"quote\":\"need not\",\"start\":2349}],\"id\":\"urn:rulespec:document-understanding:revision:c8fe17a9b9fba52708c3e694d877c0700f771efb99a776a23c03bd08f672aa74\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"exemption\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:8c05bfd090701fa0ba4498edc1691ea5314b1dd4e10ec3d71e7ddd9f54173755\",\"modality\":\"not_required\",\"modality_quote\":\"need not\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:97ed99f21bab7d5cee6431720ef20643a42e1ce4cee6569d82c2f07e4306a316\",\"origin\":\"aiSuggested\",\"quote\":\"(f) A person who holds a flight instructor certificate need not accomplish the one hour of ground training specified in paragraph (a) of this section if that person has, within the period specified in paragraph (c) of this section, met one of the following requirements—\\n\\n(1) Satisfactorily completed the recent experience requirements for a flight instructor certificate under § 61.197; or\\n\\n(2) Reinstated the person's flight instructor privileges by satisfactorily completing an approved flight instructor refresher course in accordance with § 61.199(a)(1).\",\"references\":[\"paragraph (a)\",\"paragraph (c)\",\"§ 61.197\",\"§ 61.199(a)(1)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:0543288c93fea9154b02349ef606095af8693cbd197a9fb1196c732c00706529\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"urn:rulespec:document-understanding:section:42cb40bbcfd59390046da4f309e7efe3db131d3392ea1d046ffdd5be5af1d0b2\",\"start\":2294,\"summary\":\"A person who holds a flight instructor certificate need not accomplish the one hour of ground training specified in paragraph (a) of 14 CFR § 61.56 if that person has, within the period specified in paragraph (c) of this section, satisfactorily completed the recent experience requirements for a flight instructor certificate under § 61.197, or reinstated the person's flight instructor privileges by satisfactorily completing an approved flight instructor refresher course in accordance with § 61.199(a)(1).\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

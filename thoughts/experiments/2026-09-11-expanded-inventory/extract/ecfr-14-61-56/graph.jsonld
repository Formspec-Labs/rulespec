      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:f9b1bde40e60e0d5c5eb32221d3cd473fcb3405865413de9f7db1897cfe8b61d\",\"urn:rulespec:document-understanding:assertion:a3cff1b4ea4bc1dac8a76e4d2a9bb959983189edc12c92e5e0b1392ae55cd7e6\",\"urn:rulespec:document-understanding:assertion:0c005059d0e19306093133eef609e6fbb5a5b357818c9a28645925a0010f1171\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":524,\"evidence\":[{\"end\":524,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ad3da814254fdb3eef2724f44356a286098a93655960b5fe2dd8580f5f1516a11:28:524:sha256-74ec306434f933b3a161c44e0942e53c9844b9bee1b89ed90d5676f7f3b7298c\",\"quote\":\"(a) Except as provided in paragraphs (b) and (f) of this section, a flight review consists of a minimum of 1 hour of flight training and 1 hour of ground training. The review must include: \\n\\n(1) A review of the current general operating and flight rules of part 91 of this chapter; and \\n\\n(2) A review of those maneuvers and procedures that, at the discretion of the person giving the review, are necessary for the pilot to demonstrate the safe exercise of the privileges of the pilot certificate.\",\"start\":28},{\"end\":207,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ad3da814254fdb3eef2724f44356a286098a93655960b5fe2dd8580f5f1516a11:203:207:sha256-4137b01e139589b7a1d3b3fc4da031d8ce5bb415808734e970c3a58ea0e98f0f\",\"quote\":\"must\",\"start\":203}],\"id\":\"urn:rulespec:document-understanding:revision:6b70bfa5d3debaaf0b761021080f8c2db35427db921953375158417252337cfe\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:0c005059d0e19306093133eef609e6fbb5a5b357818c9a28645925a0010f1171\",\"modality\":\"must\",\"modality_quote\":\"must\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:f3e53855755c2e1876f464ddc176c75d16a2742ca9f781bf025247615c72cf86\",\"origin\":\"aiSuggested\",\"quote\":\"(a) Except as provided in paragraphs (b) and (f) of this section, a flight review consists of a minimum of 1 hour of flight training and 1 hour of ground training. The review must include: \\n\\n(1) A review of the current general operating and flight rules of part 91 of this chapter; and \\n\\n(2) A review of those maneuvers and procedures that, at the discretion of the person giving the review, are necessary for the pilot to demonstrate the safe exercise of the privileges of the pilot certificate.\",\"references\":[\"part 91\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:c65d6779979788675173057e625baf3780a892b31e84cd2ec9d742ca7ef26fe3\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"urn:rulespec:document-understanding:section:42cb40bbcfd59390046da4f309e7efe3db131d3392ea1d046ffdd5be5af1d0b2\",\"start\":28,\"summary\":\"The flight review must include a review of the current general operating and flight rules of part 91 of this chapter, and a review of those maneuvers and procedures that, at the discretion of the person giving the review, are necessary for the pilot to demonstrate the safe exercise of the privileges of the pilot certificate.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

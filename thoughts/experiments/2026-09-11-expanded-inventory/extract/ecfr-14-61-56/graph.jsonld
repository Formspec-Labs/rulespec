      "rkaf:assertsValue": {
        "@value": "A person who has, within the period specified in paragraph (c) of 14 CFR § 61.56, passed a practical test conducted by an examiner for the issuance of a flight instructor certificate, an additional rating on a flight instructor certificate, meeting recent experience requirements for a flight instructor certificate in accordance with § 61.197(b)(1), or the reinstatement of flight instructor privileges in accordance with § 61.199(b)(2), need not accomplish the flight review required by this section.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

    {
      "@id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ad3da814254fdb3eef2724f44356a286098a93655960b5fe2dd8580f5f1516a11:1283:2050:sha256-388af05d451fd407cb25f7c9684ee3af473c3610d0c83689ed21e14167cb9f37",
      "@type": "rkaf:SourceFragment",
      "oa:hasSource": "urn:rulespec:document-understanding:document:d3da814254fdb3eef2724f44356a286098a93655960b5fe2dd8580f5f1516a11",
      "rkaf:fragmentIdentityScheme": "rkaf:carrier-local-fragment",
      "rkaf:sourceArtifactDigest": "sha256:d3da814254fdb3eef2724f44356a286098a93655960b5fe2dd8580f5f1516a11",
      "rkaf:fragmentContentDigest": "sha256:388af05d451fd407cb25f7c9684ee3af473c3610d0c83689ed21e14167cb9f37",
      "rkaf:selectorKind": [
        "oa:TextQuoteSelector",
        "oa:TextPositionSelector"
      ],
      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "(d) A person who has, within the period specified in paragraph (c) of this section, passed any of the following need not accomplish the flight review required by this section:\n\n(1) A pilot proficiency check or practical test conducted by an examiner, an approved pilot check airman, or a U.S. Armed Force, for a pilot certificate, rating, or operating privilege.\n\n(2) A practical test conducted by an examiner for one of the following:\n\n(i) The issuance of a flight instructor certificate,\n\n(ii) An additional rating on a flight instructor certificate,\n\n(iii) To meet the recent experience requirements for a flight instructor certificate in accordance with § 61.197(b)(1); or\n\n(iv) The reinstatement of flight instructor privileges in accordance with § 61.199(b)(2)."
        },
        {
          "@type": "oa:TextPositionSelector",
          "oa:start": 1283,
          "oa:end": 2050,
          "rkaf:coordinateSystem": "rkaf:unicode-codepoint"
        }
      ]
    },

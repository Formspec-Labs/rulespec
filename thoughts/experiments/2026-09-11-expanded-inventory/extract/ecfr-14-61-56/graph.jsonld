    {
      "@id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ad3da814254fdb3eef2724f44356a286098a93655960b5fe2dd8580f5f1516a11:28:524:sha256-74ec306434f933b3a161c44e0942e53c9844b9bee1b89ed90d5676f7f3b7298c",
      "@type": "rkaf:SourceFragment",
      "oa:hasSource": "urn:rulespec:document-understanding:document:d3da814254fdb3eef2724f44356a286098a93655960b5fe2dd8580f5f1516a11",
      "rkaf:fragmentIdentityScheme": "rkaf:carrier-local-fragment",
      "rkaf:sourceArtifactDigest": "sha256:d3da814254fdb3eef2724f44356a286098a93655960b5fe2dd8580f5f1516a11",
      "rkaf:fragmentContentDigest": "sha256:74ec306434f933b3a161c44e0942e53c9844b9bee1b89ed90d5676f7f3b7298c",
      "rkaf:selectorKind": [
        "oa:TextQuoteSelector",
        "oa:TextPositionSelector"
      ],
      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "(a) Except as provided in paragraphs (b) and (f) of this section, a flight review consists of a minimum of 1 hour of flight training and 1 hour of ground training. The review must include: \n\n(1) A review of the current general operating and flight rules of part 91 of this chapter; and \n\n(2) A review of those maneuvers and procedures that, at the discretion of the person giving the review, are necessary for the pilot to demonstrate the safe exercise of the privileges of the pilot certificate."
        },
        {
          "@type": "oa:TextPositionSelector",
          "oa:start": 28,
          "oa:end": 524,
          "rkaf:coordinateSystem": "rkaf:unicode-codepoint"
        }
      ]
    },

                    "unknown"
                  ]
                },
                "effectivity": {
                  "type": "string",
                  "enum": [
                    "correct",
                    "error",
                    "not_applicable",
                    "unknown"
                  ]
                }
              },
              "required": [
                "summary",
                "actor",
                "support",
                "scope",
                "links",
                "boundary",
                "modality",
                "action",
                "object",
                "alternatives",
                "thresholds",
                "concepts",
                "source_attribution",
                "effectivity"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "claim_id",
            "unit_ids",
            "source_refs",
            "rationale",
            "dimensions"
          ],
          "additionalProperties": false
        }
      },
      "unit_judgments": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "unit_id": {
              "type": "string",
              "minLength": 1
            },
            "claim_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "status": {
              "type": "string",
              "enum": [
                "covered",
                "missing",
                "partial",
                "unknown"
              ]
            },
            "rationale": {
              "type": "string",
              "minLength": 1
            },
            "source_refs": {
              "type": "array",
              "items": {
                "type": "string",
                "description": "Select a supplied source alias and its passage or contiguous range, for example S0/F003 or S0/F003:F006. Never combine sources or focus/context prefixes in one range.",
                "title": "Source passage reference"
              }
            }
          },
          "required": [
            "unit_id",
            "claim_ids",
            "status",
            "rationale",
            "source_refs"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "claim_judgments",
      "unit_judgments"
    ],
    "additionalProperties": false
  }
}

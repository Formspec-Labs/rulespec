            "text": "{\n  \"judgments\": [\n    {\n      \"proposal_id\": \"P0002\",\n      \"source_refs\": [\n        \"F000:F004\"\n      ],\n      \"rationale\": \"Leaving C0000 unchanged is unsupported because the summary omits the governing statutory prerequisites set forth in paragraphs (1) through (4). Under the source text, the agency head may collect by administrative offset only after giving the debtor written notice and the specified opportunities for record inspection, agency review, and written repayment agreement.\",\n      \"verdict\": \"unsupported\"\n    },\n    {\n      \"proposal_id\": \"P0001\",\n      \"source_refs\": [\n        \"F004\"\n      ],\n      \"rationale\": \"The proposed edit is unsupported because it introduces an inaccurate substantive requirement: it states that administrative offset requires 'execution by the debtor of a written agreement', whereas paragraph (4) requires only giving the debtor 'an opportunity to make a written agreement'.\",\n      \"verdict\": \"unsupported\"\n    },\n    {\n      \"proposal_id\": \"P0000\",\n      \"source_refs\": [\n        \"F000:F004\"\n      ],\n      \"rationale\": \"The edit is supported because it makes C0000 complete and independently usable by incorporating the four statutory prerequisites that govern the agency head's authority to collect by administrative offset, accurately preserving that paragraph (4) requires providing an opportunity to make a written agreement rather than requiring an executed agreement.\",\n      \"verdict\": \"supported\"\n    }\n  ]\n}",

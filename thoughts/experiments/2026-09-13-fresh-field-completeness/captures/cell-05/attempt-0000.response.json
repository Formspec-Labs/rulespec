            "text": "{\n  \"judgments\": [\n    {\n      \"proposal_id\": \"P0001\",\n      \"source_refs\": [\"F007\"],\n      \"rationale\": \"The proposal modifies the exception in the summary to state that reporting is excused if the party 'reasonably believes' the Commission has been adequately informed. However, the source text in F007 explicitly requires 'actual knowledge that the Commission has been adequately informed', making the proposed lower standard of reasonable belief legally inaccurate and unsupported by the source.\",\n      \"verdict\": \"unsupported\"\n    },\n    {\n      \"proposal_id\": \"P0002\",\n      \"source_refs\": [\"F000:F007\"],\n      \"rationale\": \"The proposal populates the action and action_quote fields with 'inform', accurately capturing the core duty under subsection (b) ('shall immediately inform the Commission') supported by F007, while preserving the governing conditions across F000 through F007 without unnecessary churn.\",\n      \"verdict\": \"supported\"\n    },\n    {\n      \"proposal_id\": \"P0003\",\n      \"source_refs\": [\"F007\"],\n      \"rationale\": \"In addition to structuring the action, this proposal edits the summary to replace the statutory phrasing 'shall immediately inform' with 'must immediately inform'. The existing summary faithfully tracks the source phrasing, so this modification constitutes an unnecessary paraphrase duplicate rather than fixing a defect.\",\n      \"verdict\": \"unsupported\"\n    }\n  ]\n}",

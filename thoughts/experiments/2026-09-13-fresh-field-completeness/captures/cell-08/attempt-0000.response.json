  "parsed": {
    "judgments": [
      {
        "proposal_id": "P0000",
        "source_refs": [
          "F004",
          "F006"
        ],
        "rationale": "Under subsection (e)(2), the provision specifies 'Duties of employee' and establishes that 'the employee— ... (B) shall provide the employer with not less than 30 days’ notice'. The actor bearing the requirement is the employee, not the employer. Changing the actor from 'the employer' to 'the employee' fixes an inaccurate assignment in C0002.",
        "verdict": "supported"
      },
      {
        "proposal_id": "P0001",
        "source_refs": [
          "F004",
          "F006"
        ],
        "rationale": "Subsection (e)(2)(B) establishes that the employee must provide notice to the employer. The health care provider is not the actor obligated to provide notice under this provision.",
        "verdict": "unsupported"
      },
      {
        "proposal_id": "P0002",
        "source_refs": [
          "F004",
          "F006"
        ],
        "rationale": "The exception in C0004 provides that if the date of treatment requires leave to begin in less than 30 days, the employee shall provide practicable notice. This directly qualifies the 30-day notice requirement set forth in paragraph (2)(B) (represented by C0002). Adding the qualification relationship to C0002 accurately links the exception to its governing baseline duty.",
        "verdict": "supported"
      },
      {
        "proposal_id": "P0003",
        "source_refs": [
          "F004:F006"
        ],
        "rationale": "C0001 represents the duty under paragraph (2)(A) to make a reasonable effort to schedule treatment so as not to disrupt operations unduly. The exception in C0004 relaxes the 30-day advance notice requirement in paragraph (2)(B) (C0002), not the scheduling requirement in (A). Therefore, C0001 is an incorrect target.",
        "verdict": "unsupported"
      }
    ]
  }

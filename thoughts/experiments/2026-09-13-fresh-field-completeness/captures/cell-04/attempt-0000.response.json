            "text": "{\n  \"judgments\": [\n    {\n      \"proposal_id\": \"P0001\",\n      \"source_refs\": [\n        \"F000:F004\"\n      ],\n      \"rationale\": \"The proposed summary misstates the condition in paragraph (4). The statute requires giving the debtor 'an opportunity to make a written agreement with the head of the agency to repay the amount of the claim', not actual 'execution by the debtor of a written agreement'. Imposing execution as a prerequisite mischaracterizes the statutory requirement.\",\n      \"verdict\": \"unsupported\"\n    },\n    {\n      \"proposal_id\": \"P0002\",\n      \"source_refs\": [\n        \"F000:F004\"\n      ],\n      \"rationale\": \"The unchanged summary for C0000 is incomplete because it omits the governing statutory conditions precedent to collecting by administrative offset set out in the same subsection: giving the debtor the required written notice, opportunity to inspect/copy records, opportunity for agency review, and opportunity to make a written repayment agreement.\",\n      \"verdict\": \"unsupported\"\n    },\n    {\n      \"proposal_id\": \"P0000\",\n      \"source_refs\": [\n        \"F000:F004\"\n      ],\n      \"rationale\": \"The edit properly completes the summary by incorporating all four governing conditions that must be satisfied before the agency head may collect by administrative offset, accurately preserving the statutory text that only an opportunity to make a written agreement is required.\",\n      \"verdict\": \"supported\"\n    }\n  ]\n}",

      "dcterms:description": "{\"action\":\"\",\"actor\":\"the employee\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:17f7aa6bb4df8d628118c732ecfbf71933c3f93aa5cd58c587a9df68bb5f418e\",\"urn:rulespec:document-understanding:assertion:816258c4f44e66a18ac8523febc3740aeda9f7229858b6d6a2d2cfa74c1f33e3\",\"urn:rulespec:document-understanding:assertion:4de076b15c157a8ed374107081abda74fa5d7552d52af1d55236ad36a15882e6\",\"urn:rulespec:document-understanding:assertion:477655d37d49f5c2c3379ec14f7d62cdcf27d2598ae05f94605bf374fc67be8e\",\"urn:rulespec:document-understanding:assertion:17ff29fd6fbaeefdb872755b4427029260208ce5381b9df355d596621ae7144f\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":1815,\"evidence\":[{\"end\":1815,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A2e5b270e686bb3327402e202d3299c5c114eef4d01f4a80313c4cf601ee912c4:1456:1815:sha256-d154f354db024bc6785e5b9b4c80696066fffbdc95ff536290c7cd808e25408e\",\"quote\":\"In any case in which the necessity for leave under subsection (a)(1)(E) is foreseeable, whether because the spouse, or a son, daughter, or parent, of the employee is on covered active duty, or because of notification of an impending call or order to covered active duty, the employee shall provide such notice to the employer as is reasonable and practicable.\",\"start\":1456},{\"end\":1745,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A2e5b270e686bb3327402e202d3299c5c114eef4d01f4a80313c4cf601ee912c4:1740:1745:sha256-56ee5b508706bf2de91712d85d6d1e11ddbff01949142ed6e8c22e3b1bed1c71\",\"quote\":\"shall\",\"start\":1740},{\"end\":1815,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A2e5b270e686
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:bc371f3b0eb5188f1e2dde9bffa5dd9d82d33c57c46fb992fc233c475826c49c\",\"urn:rulespec:document-understanding:assertion:ee9bd073b50e2bc077f03c3cd35af67f0a38dc410f915e9374a97cdb8b3d30c1\",\"urn:rulespec:document-understanding:assertion:1a6622cf8c2de2bb213e9860d7abc893a043849bb10c75d2719dcfab8e174bea\",\"urn:rulespec:document-understanding:assertion:a5c7388d55b04884d39f29d5ebc18d8ca9deebb874506d3407c83d185cd99dc1\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":318,\"evidence\":[{\"end\":318,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A22a75fed6e73024fb4533433be054521b11ab78f46a9d1f12ea9e351323fa2d6:5:318:sha256-83bc2e75e99ec58c06aa90a82bcd2b8a6797ecc40a812d6c571f3d3fd7a71fa0\",\"quote\":\"(1) A juror shall be paid an attendance fee of $50 per day for actual attendance at the place of trial or hearing. A juror shall also be paid the attendance fee for the time necessarily occupied in going to and returning from such place at the beginning and end of such service or at any time during such service.\",\"start\":5},{\"end\":318,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A22a75fed6e73024fb4533433be054521b11ab78f46a9d1f12ea9e351323fa2d6:5:318:sha256-83bc2e75e99ec58c06aa90a82bcd2b8a6797ecc40a812d6c571f3d3fd7a71fa0\",\"quote\":\"(1) A juror shall be paid an attendance fee of $50 per day for actual attendance at the place of trial or hearing. A juror shall also be paid the attendance fee for the time necessarily occupied in going to and returning from such place at the beginning and end of such service or at any time during such service.\",\"start\":5}],\"id\":\"urn:rulespec:document-understanding:revision:1208967ea115ffc4d00009ea2e86a4dcbcaaa624ed8ff15170f210ff5df376b8\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:a5c7388d55b04884d39f29d5ebc18d8ca9deebb874506d3407c83d185cd99dc1\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:5d84e86e4d4aa1e1ba1c6fc634f9a2ef698b6102cb6076ef5350e1f2753e3cdd\",\"origin\":\"aiSuggested\",\"quote\":\"(1) A juror shall be paid an attendance fee of $50 per day for actual attendance at the place of trial or hearing. A juror shall also be paid the attendance fee for the time necessarily occupied in going to and returning from such place at the beginning and end of such service or at any time during such service.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:27568ad4c034ddf266bcf79ac56ef4150fe55b9d782c468abc90640684b0edc5\",\"scope_quotes\":[\"(1) A juror shall be paid an attendance fee of $50 per day for actual attendance at the place of trial or hearing. A juror shall also be paid the attendance fee for the time necessarily occupied in going to and returning from such place at the beginning and end of such service or at any time during such service.\"],\"scope_text\":\"for actual attendance at the place of trial or hearing\",\"section_id\":\"section-1\",\"start\":5,\"summary\":\"A juror shall be paid an attendance fee of $50 per day for actual attendance at the place of trial or hearing.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

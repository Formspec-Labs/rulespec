      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"actor\":\"creditor\",\"kind\":\"requirement\",\"modality\":\"must\",\"scope_text\":\"If a creditor, within sixty days after having transmitted to an obligor a statement of the obligor’s account in connection with an extension of consumer credit, receives at the address disclosed under section 1637(b)(10) of this title a written notice (other than notice on a payment stub or other payment medium supplied by the creditor if the creditor so stipulates with the disclosure required under section 1637(a)(7) of this title) from the obligor meeting paragraphs (1)-(3), unless the obligor has, after giving such written notice and before the expiration of the time limits herein specified, agreed that the statement was correct.\",\"summary\":\"If a creditor, within 60 days after having transmitted to an obligor a statement of the obligor's account in connection with an extension of consumer credit, receives at the address disclosed under section 1637(b)(10) of this title a written notice (other than notice on a payment stub or other payment medium supplied by the creditor if the creditor so stipulates with the disclosure required under section 1637(a)(7) of this title) from the obligor setting forth or enabling identification of the obligor's name and account number (if any), indicating the obligor's belief that the statement contains a billing error and the amount thereof, and setting forth reasons for that belief (to the extent applicable), the creditor must, not later than 30 days after receipt of the notice, send a written acknowledgment thereof to the obligor, unless the obligor has, after giving such notice and before the expiration of the specified time limits, agreed that the statement was correct, or unless the action required in subparagraph (B) is taken within such 30-day period.\"}",
        "@type": "xsd:string"
      },

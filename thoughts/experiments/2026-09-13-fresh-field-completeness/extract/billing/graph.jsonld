    {
      "@id": "urn:rulespec:document-understanding:revision:3ae73b24495cddc5c3c3b754e4566599b230e623c55bcc99768a7b2c91a5dc21",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:3ae73b24495cddc5c3c3b754e4566599b230e623c55bcc99768a7b2c91a5dc21",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:1d59ff9af5250a0e171e059c132fd1d47dd00928705e48413033b8ed48389eb8",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"creditor\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:4b49bb7cfbdf49fd5f49d3f27bc5a5c73aebf1e5df33f028444e9321ff0d642e\",\"urn:rulespec:document-understanding:assertion:881344c94b1113ca4d684cd168331ad09aaaf09e4f3016dfedc9fdeed0c32012\",\"urn:rulespec:document-understanding:assertion:949539b15ddf09372b2491d616573cdeeb988e3baf9e07b3fc6a3c47b76aa5c3\",\"urn:rulespec:document-understanding:assertion:b2c1b51f5491dcb47c37f37ac9718b351543fd78d24d4fbdb805cab623032e53\",\"urn:rulespec:document-understanding:assertion:b8bdcf66edf4941fc10ccf53d8f913768d8a2bf908a8c519039aa5d1dfbe94d6\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":2853,\"evidence\":[{\"end\":2853,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ac97479fb155e2b95bcee63f73803745d8e3c96327ebc44b8158d9a6caa3b16ca:2048:2853:sha256-b41956e23df9e8ceee7dd13a0cbd69965d5a1a10aba7e0732413933ea93b00c5\",\"quote\":\"(ii) send a written explanation or clarification to the obligor, after having conducted an investigation, setting forth to the extent applicable the reasons why the creditor believes the account of the obligor was correctly shown in the statement and, upon request of the obligor, provide copies of documentary evidence of the obligor’s indebtedness. In the case of a billing error where the obligor alleges that the creditor’s billing statement reflects goods not delivered to the obligor or his designee in accordance with the agreement made at the time of the transaction, a creditor may not construe such amount to be correctly shown unless he determines that such goods were actually delivered, mailed, or otherwise sent to the obligor and provides the obligor with a statement of such determination.\",\"start\":2048},{\"end\":979,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ac97479fb155e2b95bcee63f73803745d8e3c96327ebc44b8158d9a6caa3b16ca:974:979:sha256-56ee5b508706bf2de91712d85d6d1e11ddbff01949142ed6e8c22e3b1bed1c71\",\"quote\":\"shall\",\"start\":974},{\"end\":120,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ac97479fb155e2b95bcee63f73803745d8e3c96327ebc44b8158d9a6caa3b16ca:0:120:sha256-94690f2e3be8744ae6a0b2cfae2299dcced9c50594aac2bf127809b3bbab4a2b\",\"quote\":\"(a) Written notice by obligor to creditor; time for and contents of notice; procedure upon receipt of notice by creditor\",\"start\":0},{\"end\":596,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ac97479fb155e2b95bcee63f73803745d8e3c96327ebc44b8158d9a6caa3b16ca:121:596:sha256-32ca7f47c2b5627f4216d1830bc012c51be6435ef8c8b65d49eae591b8264053\",\"quote\":\"If a creditor, within sixty days after having transmitted to an obligor a statement of the obligor’s account in connection with an extension of consumer credit, receives at the address disclosed under section 1637(b)(10) of this title a written notice (other than notice on a payment stub or other payment medium supplied by the creditor if the creditor so stipulates with the disclosure required under section 1637(a)(7) of this title) from the obligor in which the obligor—\",\"start\":121},{\"end\":1139,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ac97479fb155e2b95bcee63f73803745d8e3c96327ebc44b8158d9a6caa3b16ca:598:1139:sha256-34cc48e965a8e36336edefc1d137663adc099e16504e1e7ce48139fbde20fdee\",\"quote\":\"(1) sets forth or otherwise enables the creditor to identify the name and account number (if any) of the obligor,\\n\\n(2) indicates the obligor’s belief that the statement contains a billing error and the amount of such billing error, and\\n\\n(3) sets forth the reasons for the obligor’s belief (to the extent applicable) that the statement contains a billing error,\\n\\n\\nthe creditor shall, unless the obligor has, after giving such written notice and before the expiration of the time limits herein specified, agreed that the statement was correct—\",\"start\":598},{\"end\":1610,\"field\":\"scope_text:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ac97479fb155e2b95bcee63f73803745d8e3c96327ebc44b8158d9a6caa3b16ca:1351:1610:sha256-2865546c410dce3d09bc433c596258d74daad18f44d89cc790e876ee70a7fa0a\",\"quote\":\"(B) not later than two complete billing cycles of the creditor (in no event later than ninety days) after the receipt of the notice and prior to taking any action to collect the amount, or any part thereof, indicated by the obligor under paragraph (2) either—\",\"start\":1351}],\"id\":\"urn:rulespec:document-understanding:revision:3ae73b24495cddc5c3c3b754e4566599b230e623c55bcc99768a7b2c91a5dc21\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:b8bdcf66edf4941fc10ccf53d8f913768d8a2bf908a8c519039aa5d1dfbe94d6\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:f8100e95d4772698247bb4175f11e353c72dbe22cd5a2da4eb030fb08910ce0d\",\"origin\":\"aiSuggested\",\"quote\":\"(ii) send a written explanation or clarification to the obligor, after having conducted an investigation, setting forth to the extent applicable the reasons why the creditor believes the account of the obligor was correctly shown in the statement and, upon request of the obligor, provide copies of documentary evidence of the obligor’s indebtedness. In the case of a billing error where the obligor alleges that the creditor’s billing statement reflects goods not delivered to the obligor or his designee in accordance with the agreement made at the time of the transaction, a creditor may not construe such amount to be correctly shown unless he determines that such goods were actually delivered, mailed, or otherwise sent to the obligor and provides the obligor with a statement of such determination.\",\"references\":[\"paragraph (2)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:301e5b5be35a55f2fbedbd882c61987a14ac1a3b8c3261f0332d6a4f01a0ac1d\",\"scope_quotes\":[\"(a) Written notice by obligor to creditor; time for and contents of notice; procedure upon receipt of notice by creditor If a creditor, within sixty days after having transmitted to an obligor a statement of the obligor’s account in connection with an extension of consumer credit, receives at the address disclosed under section 1637(b)(10) of this title a written notice (other than notice on a payment stub or other payment medium supplied by the creditor if the creditor so stipulates with the disclosure required under section 1637(a)(7) of this title) from the obligor in which the obligor—\\n\\n(1) sets forth or otherwise enables the creditor to identify the name and account number (if any) of the obligor,\\n\\n(2) indicates the obligor’s belief that the statement contains a billing error and the amount of such billing error, and\\n\\n(3) sets forth the reasons for the obligor’s belief (to the extent applicable) that the statement contains a billing error,\\n\\n\\nthe creditor shall, unless the obligor has, after giving such written notice and before the expiration of the time limits herein specified, agreed that the statement was correct—\",\"(B) not later than two complete billing cycles of the creditor (in no event later than ninety days) after the receipt of the notice and prior to taking any action to collect the amount, or any part thereof, indicated by the obligor under paragraph (2) either—\"],\"scope_text\":\"When a creditor has received qualifying written notice of a billing error and does not make corrections under clause (i), unless the obligor has agreed the statement was correct.\",\"section_id\":\"section-1\",\"start\":2048,\"summary\":\"Under the procedure upon receipt of a qualifying billing error notice, as an alternative to making corrections under clause (i), the creditor must, not later than two complete billing cycles of the creditor (and in no event later than 90 days) after receipt of notice and prior to taking collection action, send a written explanation or clarification to the obligor, after having conducted an investigation, setting forth to the extent applicable the reasons why the creditor believes the account was correctly shown in the statement and, upon request of the obligor, provide copies of documentary evidence of the obligor’s indebtedness.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",
      "dcterms:references": [

      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:71394c07c20db793a77c92447fad901679ee96a63c1347e41b84978e29a5fd0e",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:abd14761f9101901594f801b8c22aa7cb4d1d57f38d65861080755e31eb8fc75",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:15963d31330152f823b3e9e9b61d6659c3c424d59e23ab3423d42c5d2f7ad5f0",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:states-prohibition",
      "rkaf:assertsValue": {
        "@value": "In the case of a billing error where the obligor alleges that the creditor's billing statement reflects goods not delivered to the obligor or his designee in accordance with the agreement made at the time of the transaction, a creditor must not construe such amount to be correctly shown unless he determines that such goods were actually delivered, mailed, or otherwise sent to the obligor and provides the obligor with a statement of such determination.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

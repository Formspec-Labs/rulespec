    {
      "@id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ac97479fb155e2b95bcee63f73803745d8e3c96327ebc44b8158d9a6caa3b16ca:2048:2853:sha256-b41956e23df9e8ceee7dd13a0cbd69965d5a1a10aba7e0732413933ea93b00c5",
      "@type": "rkaf:SourceFragment",
      "oa:hasSource": "urn:rulespec:document-understanding:document:c97479fb155e2b95bcee63f73803745d8e3c96327ebc44b8158d9a6caa3b16ca",
      "rkaf:fragmentIdentityScheme": "rkaf:carrier-local-fragment",
      "rkaf:sourceArtifactDigest": "sha256:c97479fb155e2b95bcee63f73803745d8e3c96327ebc44b8158d9a6caa3b16ca",
      "rkaf:fragmentContentDigest": "sha256:b41956e23df9e8ceee7dd13a0cbd69965d5a1a10aba7e0732413933ea93b00c5",
      "rkaf:selectorKind": [
        "oa:TextQuoteSelector",
        "oa:TextPositionSelector"
      ],
      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "(ii) send a written explanation or clarification to the obligor, after having conducted an investigation, setting forth to the extent applicable the reasons why the creditor believes the account of the obligor was correctly shown in the statement and, upon request of the obligor, provide copies of documentary evidence of the obligor’s indebtedness. In the case of a billing error where the obligor alleges that the creditor’s billing statement reflects goods not delivered to the obligor or his designee in accordance with the agreement made at the time of the transaction, a creditor may not construe such amount to be correctly shown unless he determines that such goods were actually delivered, mailed, or otherwise sent to the obligor and provides the obligor with a statement of such determination."
        },
        {
          "@type": "oa:TextPositionSelector",
          "oa:start": 2048,
          "oa:end": 2853,
          "rkaf:coordinateSystem": "rkaf:unicode-codepoint"
        }
      ]
    },
    {
      "@id": "urn:rulespec:document-understanding:scope:1de9cd8e4a005cf51cdbe45747c7535400810e6ed76deb0a53fef94e2b24e121",
      "@type": "rkaf:ApplicabilityScope",
      "rkaf:appliesInJurisdiction": [],
      "rkaf:applicabilityCondition": "When a creditor has received qualifying written notice of a billing error and does not make corrections under clause (i), unless the obligor has agreed the statement was correct."
    },
    {
      "@id": "urn:rulespec:document-understanding:assertion:4b49bb7cfbdf49fd5f49d3f27bc5a5c73aebf1e5df33f028444e9321ff0d642e",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:71394c07c20db793a77c92447fad901679ee96a63c1347e41b84978e29a5fd0e",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:abd14761f9101901594f801b8c22aa7cb4d1d57f38d65861080755e31eb8fc75",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:301e5b5be35a55f2fbedbd882c61987a14ac1a3b8c3261f0332d6a4f01a0ac1d",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:states-requirement",
      "rkaf:assertsValue": {
        "@value": "Under the procedure upon receipt of a qualifying billing error notice, as an alternative to making corrections under clause (i), the creditor must, not later than two complete billing cycles of the creditor (and in no event later than 90 days) after receipt of notice and prior to taking collection action, send a written explanation or clarification to the obligor, after having conducted an investigation, setting forth to the extent applicable the reasons why the creditor believes the account was correctly shown in the statement and, upon request of the obligor, provide copies of documentary evidence of the obligor’s indebtedness.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

      "rkaf:hasContentDigest": "sha256:c574a112fbb7529a330c402ca6c3b6c76a6ec4df9bae0c3331c5a70a7ec9e155",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"creditor\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:e556bf5d0f4cde35e789a9c7f948d7f1d5e29353c5dc4081c469da28448f3fb5\",\"urn:rulespec:document-understanding:assertion:7c7711df4af6527c675be301de4e7256de386769826e37443332a0fe503ef238\",\"urn:rulespec:document-understanding:assertion:8beacdaa3860d10a32e772e5ee03c28386cbada7531acbfa90db209690532c22\",\"urn:rulespec:document-understanding:assertion:9b473bdc58f43fdab8db0d56b57943f199456133567d1aa6dd3a234ed6aec987\",\"urn:rulespec:document-understanding:assertion:fbff32f98f7f4a86c160b9a2a4dc1b46d99558851a5992b200a42b39a72e9378\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":1349,\"evidence\":[{\"end\":1349,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ac97479fb155e2b95bcee63f73803745d8e3c96327ebc44b8158d9a6caa3b16ca:1141:1349:sha256-81c62f15ef68cd0e304057b243852a7e8a5d9d9ad594fb9c672bc9d92269d270\",\"quote\":\"(A) not later than thirty days after the receipt of the notice, send a written acknowledgment thereof to the obligor, unless the action required in subparagraph (B) is taken within such thirty-day period, and\",\"start\":1141},{\"end\":979,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ac97479fb155e2b95bcee63f73803745d8e3c96327ebc44b8158d9a6caa3b16ca:974:979:sha256-56ee5b508706bf2de91712d85d6d1e11ddbff01949142ed6e8c22e3b1bed1c71\",\"quote\":\"shall\",\"start\":974},{\"end\":120,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ac97479fb155e2b95bcee63f73803745d8e3c96327ebc44b8158d9a6caa3b16ca:0:120:sha256-94690f2e3be8744ae6a0b2cfae2299dcced9c50594aac2bf127809b3bbab4a2b\",\"quote\":\"(a) Written notice by obligor to creditor; time for and contents of notice; procedure upon receipt of notice by creditor\",\"start\":0},{\"end\":596,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ac97479fb155e2b95bcee63f73803745d8e3c96327ebc44b8158d9a6caa3b16ca:121:596:sha256-32ca7f47c2b5627f4216d1830bc012c51be6435ef8c8b65d49eae591b8264053\",\"quote\":\"If a creditor, within sixty days after having transmitted to an obligor a statement of the obligor’s account in connection with an extension of consumer credit, receives at the address disclosed under section 1637(b)(10) of this title a written notice (other than notice on a payment stub or other payment medium supplied by the creditor if the creditor so stipulates with the disclosure required under section 1637(a)(7) of this title) from the obligor in which the obligor—\",\"start\":121},{\"end\":1139,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ac97479fb155e2b95bcee63f73803745d8e3c96327ebc44b8158d9a6caa3b16ca:598:1139:sha256-34cc48e965a8e36336edefc1d137663adc099e16504e1e7ce48139fbde20fdee\",\"quote\":\"(1) sets forth or otherwise enables the creditor to identify the name and account number (if any) of the obligor,\\n\\n(2) indicates the obligor’s belief that the statement contains a billing error and the amount of such billing error, and\\n\\n(3) sets forth the reasons for the obligor’s belief (to the extent applicable) that the statement contains a billing error,\\n\\n\\nthe creditor shall, unless the obligor has, after giving such written notice and before the expiration of the time limits herein specified, agreed that the statement was correct—\",\"start\":598}],\"id\":\"urn:rulespec:document-understanding:revision:a47a5539fcad1c8ebc5848a0b9c9d2107fdc8fa2bcb3585315290ae0d2f2466b\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:fbff32f98f7f4a86c160b9a2a4dc1b46d99558851a5992b200a42b39a72e9378\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:bd093163113d7759c6690f51d2f2035140b5f5aaa48de236844d72f5dc07eb5a\",\"origin\":\"aiSuggested\",\"quote\":\"(A) not later than thirty days after the receipt of the notice, send a written acknowledgment thereof to the obligor, unless the action required in subparagraph (B) is taken within such thirty-day period, and\",\"references\":[\"section 1637(b)(10)\",\"section 1637(a)(7)\",\"subparagraph (B)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:68368add45283bc18006da020017f5af39c899f30aa422173d77a1fca1039bc8\",\"scope_quotes\":[\"(a) Written notice by obligor to creditor; time for and contents of notice; procedure upon receipt of notice by creditor If a creditor, within sixty days after having transmitted to an obligor a statement of the obligor’s account in connection with an extension of consumer credit, receives at the address disclosed under section 1637(b)(10) of this title a written notice (other than notice on a payment stub or other payment medium supplied by the creditor if the creditor so stipulates with the disclosure required under section 1637(a)(7) of this title) from the obligor in which the obligor—\\n\\n(1) sets forth or otherwise enables the creditor to identify the name and account number (if any) of the obligor,\\n\\n(2) indicates the obligor’s belief that the statement contains a billing error and the amount of such billing error, and\\n\\n(3) sets forth the reasons for the obligor’s belief (to the extent applicable) that the statement contains a billing error,\\n\\n\\nthe creditor shall, unless the obligor has, after giving such written notice and before the expiration of the time limits herein specified, agreed that the statement was correct—\"],\"scope_text\":\"If a creditor, within sixty days after having transmitted to an obligor a statement of the obligor’s account in connection with an extension of consumer credit, receives at the address disclosed under section 1637(b)(10) of this title a written notice (other than notice on a payment stub or other payment medium supplied by the creditor if the creditor so stipulates with the disclosure required under section 1637(a)(7) of this title) from the obligor meeting paragraphs (1)-(3), unless the obligor has, after giving such written notice and before the expiration of the time limits herein specified, agreed that the statement was correct.\",\"section_id\":\"section-1\",\"start\":1141,\"summary\":\"If a creditor, within 60 days after having transmitted to an obligor a statement of the obligor's account in connection with an extension of consumer credit, receives at the address disclosed under section 1637(b)(10) of this title a written notice (other than notice on a payment stub or other payment medium supplied by the creditor if the creditor so stipulates with the disclosure required under section 1637(a)(7) of this title) from the obligor setting forth or enabling identification of the obligor's name and account number (if any), indicating the obligor's belief that the statement contains a billing error and the amount thereof, and setting forth reasons for that belief (to the extent applicable), the creditor must, not later than 30 days after receipt of the notice, send a written acknowledgment thereof to the obligor, unless the obligor has, after giving such notice and before the expiration of the specified time limits, agreed that the statement was correct, or unless the action required in subparagraph (B) is taken within such 30-day period.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

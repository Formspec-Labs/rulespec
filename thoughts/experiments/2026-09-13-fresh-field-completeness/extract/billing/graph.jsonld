    {
      "@id": "urn:rulespec:document-understanding:revision:8f9f57dac10815d5b39e6e05d6b266e362609c71a247a3edff1b974f928764a4",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:8f9f57dac10815d5b39e6e05d6b266e362609c71a247a3edff1b974f928764a4",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",

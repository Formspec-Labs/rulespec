    {
      "@id": "urn:rulespec:document-understanding:scope:e801c32c85ea15c978350eb688d086c1596f60b45838394fe32975596f279a36",
      "@type": "rkaf:ApplicabilityScope",
      "rkaf:appliesInJurisdiction": [],
      "rkaf:applicabilityCondition": "If a creditor, within sixty days after having transmitted to an obligor a statement of the obligor’s account in connection with an extension of consumer credit, receives at the address disclosed under section 1637(b)(10) of this title a written notice (other than notice on a payment stub or other payment medium supplied by the creditor if the creditor so stipulates with the disclosure required under section 1637(a)(7) of this title) from the obligor meeting paragraphs (1)-(3), unless the obligor has, after giving such written notice and before the expiration of the time limits herein specified, agreed that the statement was correct."
    },
    {
      "@id": "urn:rulespec:document-understanding:assertion:e556bf5d0f4cde35e789a9c7f948d7f1d5e29353c5dc4081c469da28448f3fb5",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:71394c07c20db793a77c92447fad901679ee96a63c1347e41b84978e29a5fd0e",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:abd14761f9101901594f801b8c22aa7cb4d1d57f38d65861080755e31eb8fc75",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:68368add45283bc18006da020017f5af39c899f30aa422173d77a1fca1039bc8",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:states-requirement",
      "rkaf:assertsValue": {
        "@value": "If a creditor, within 60 days after having transmitted to an obligor a statement of the obligor's account in connection with an extension of consumer credit, receives at the address disclosed under section 1637(b)(10) of this title a written notice (other than notice on a payment stub or other payment medium supplied by the creditor if the creditor so stipulates with the disclosure required under section 1637(a)(7) of this title) from the obligor setting forth or enabling identification of the obligor's name and account number (if any), indicating the obligor's belief that the statement contains a billing error and the amount thereof, and setting forth reasons for that belief (to the extent applicable), the creditor must, not later than 30 days after receipt of the notice, send a written acknowledgment thereof to the obligor, unless the obligor has, after giving such notice and before the expiration of the specified time limits, agreed that the statement was correct, or unless the action required in subparagraph (B) is taken within such 30-day period.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

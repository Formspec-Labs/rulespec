    {
      "@id": "urn:rulespec:document-understanding:scope:e52a360b1d9e6b80cbd6526a161fe9444128c37256dd5f8eecf2b83303aede09",
      "@type": "rkaf:ApplicabilityScope",
      "rkaf:appliesInJurisdiction": [],
      "rkaf:applicabilityCondition": "If a creditor receives qualifying notice from an obligor within sixty days after transmitting an account statement in connection with consumer credit, and the obligor has not agreed the statement was correct."
    },
    {
      "@id": "urn:rulespec:document-understanding:assertion:eba9e8cb6dcdb7d4bdffc6c1a7ccb13ce0d551a3da9560d9bc31fa4d4e2d863b",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:71394c07c20db793a77c92447fad901679ee96a63c1347e41b84978e29a5fd0e",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:abd14761f9101901594f801b8c22aa7cb4d1d57f38d65861080755e31eb8fc75",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:bbeb7c021458dc4a25b113cb71ad3470271b84b4bb820ed39b4554cb97b96022",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:states-requirement",
      "rkaf:assertsValue": {
        "@value": "If a creditor, within 60 days after having transmitted to an obligor a statement of the obligor's account in connection with an extension of consumer credit, receives at the address disclosed under section 1637(b)(10) of this title a qualifying written billing error notice from the obligor, the creditor must, unless the obligor has agreed the statement was correct, not later than two complete billing cycles of the creditor (in no event later than 90 days) after receipt of the notice and prior to taking any action to collect the amount or any part thereof indicated by the obligor under paragraph (2), either: (i) make appropriate corrections in the obligor's account (including crediting any finance charges on amounts erroneously billed), transmit to the obligor a notification of such corrections and an explanation of any change in the amount indicated, and, if any such change is made and the obligor so requests, provide copies of documentary evidence of indebtedness; or (ii) satisfy the requirements of clause (ii).",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },
    {

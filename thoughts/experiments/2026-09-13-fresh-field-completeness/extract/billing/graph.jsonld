      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"creditor\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:eba9e8cb6dcdb7d4bdffc6c1a7ccb13ce0d551a3da9560d9bc31fa4d4e2d863b\",\"urn:rulespec:document-understanding:assertion:0b6c7713021955c6d583f51182abd3ed3b1a13269b55dc8ec928a9f4a864b94f\",\"urn:rulespec:document-understanding:assertion:c2f351df1459601dcd7a479b968d805cf676288523e1ddecb8c33815c7978bdb\",\"urn:rulespec:document-understanding:assertion:1a0d1b47a206988f9ada818778ca9599e3f5e2aba5e1061b5fd3831d0fabb086\",\"urn:rulespec:document-understanding:assertion:d019bc9356addb7c32a27be1c02d9786324be58e05427430505d1401bb956b4d\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":2046,\"evidence\":[{\"end\":1610,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ac97479fb155e2b95bcee63f73803745d8e3c96327ebc44b8158d9a6caa3b16ca:1351:1610:sha256-2865546c410dce3d09bc433c596258d74daad18f44d89cc790e876ee70a7fa0a\",\"quote\":\"(B) not later than two complete billing cycles of the creditor (in no event later than ninety days) after the receipt of the notice and prior to taking any action to collect the amount, or any part thereof, indicated by the obligor under paragraph (2) either—\",\"start\":1351},{\"end\":2046,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ac97479fb155e2b95bcee63f73803745d8e3c96327ebc44b8158d9a6caa3b16ca:1612:2046:sha256-3e3e936cc97d86a0ae56622f79463a5b06d86a1b080da94b23da724078064f18\",\"quote\":\"(i) make appropriate corrections in the account of the obligor, including the crediting of any finance charges on amounts erroneously billed, and transmit to the obligor a notification of such corrections and the creditor’s explanation of any change in the amount indicated by the obligor under paragraph (2) and, if any such change is made and the obligor so requests, copies of documentary evidence of the obligor’s indebtedness; or\",\"start\":1612},{\"end\":979,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ac97479fb155e2b95bcee63f73803745d8e3c96327ebc44b8158d9a6caa3b16ca:974:979:sha256-56ee5b508706bf2de91712d85d6d1e11ddbff01949142ed6e8c22e3b1bed1c71\",\"quote\":\"shall\",\"start\":974},{\"end\":120,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ac97479fb155e2b95bcee63f73803745d8e3c96327ebc44b8158d9a6caa3b16ca:0:120:sha256-94690f2e3be8744ae6a0b2cfae2299dcced9c50594aac2bf127809b3bbab4a2b\",\"quote\":\"(a) Written notice by obligor to creditor; time for and contents of notice; procedure upon receipt of notice by creditor\",\"start\":0},{\"end\":596,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ac97479fb155e2b95bcee63f73803745d8e3c96327ebc44b8158d9a6caa3b16ca:121:596:sha256-32ca7f47c2b5627f4216d1830bc012c51be6435ef8c8b65d49eae591b8264053\",\"quote\":\"If a creditor, within sixty days after having transmitted to an obligor a statement of the obligor’s account in connection with an extension of consumer credit, receives at the address disclosed under section 1637(b)(10) of this title a written notice (other than notice on a payment stub or other payment medium supplied by the creditor if the creditor so stipulates with the disclosure required under section 1637(a)(7) of this title) from the obligor in which the obligor—\",\"start\":121},{\"end\":1139,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ac97479fb155e2b95bcee63f73803745d8e3c96327ebc44b8158d9a6caa3b16ca:598:1139:sha256-34cc48e965a8e36336edefc1d137663adc099e16504e1e7ce48139fbde20fdee\",\"quote\":\"(1) sets forth or otherwise enables the creditor to identify the name and account number (if any) of the obligor,\\n\\n(2) indicates the obligor’s belief that the statement contains a billing error and the amount of such billing error, and\\n\\n(3) sets forth the reasons for the obligor’s belief (to the extent applicable) that the statement contains a billing error,\\n\\n\\nthe creditor shall, unless the obligor has, after giving such written notice and before the expiration of the time limits herein specified, agreed that the statement was correct—\",\"start\":598}],\"id\":\"urn:rulespec:document-understanding:revision:8f9f57dac10815d5b39e6e05d6b266e362609c71a247a3edff1b974f928764a4\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:d019bc9356addb7c32a27be1c02d9786324be58e05427430505d1401bb956b4d\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:22b3ae528e67d1e4fe7d39daa72047be3927367028dac19c61e4d5e8a79c6140\",\"origin\":\"aiSuggested\",\"quote\":\"(B) not later than two complete billing cycles of the creditor (in no event later than ninety days) after the receipt of the notice and prior to taking any action to collect the amount, or any part thereof, indicated by the obligor under paragraph (2) either—\\n\\n(i) make appropriate corrections in the account of the obligor, including the crediting of any finance charges on amounts erroneously billed, and transmit to the obligor a notification of such corrections and the creditor’s explanation of any change in the amount indicated by the obligor under paragraph (2) and, if any such change is made and the obligor so requests, copies of documentary evidence of the obligor’s indebtedness; or\",\"references\":[\"section 1637(b)(10)\",\"section 1637(a)(7)\",\"paragraph (2)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:bbeb7c021458dc4a25b113cb71ad3470271b84b4bb820ed39b4554cb97b96022\",\"scope_quotes\":[\"(a) Written notice by obligor to creditor; time for and contents of notice; procedure upon receipt of notice by creditor If a creditor, within sixty days after having transmitted to an obligor a statement of the obligor’s account in connection with an extension of consumer credit, receives at the address disclosed under section 1637(b)(10) of this title a written notice (other than notice on a payment stub or other payment medium supplied by the creditor if the creditor so stipulates with the disclosure required under section 1637(a)(7) of this title) from the obligor in which the obligor—\\n\\n(1) sets forth or otherwise enables the creditor to identify the name and account number (if any) of the obligor,\\n\\n(2) indicates the obligor’s belief that the statement contains a billing error and the amount of such billing error, and\\n\\n(3) sets forth the reasons for the obligor’s belief (to the extent applicable) that the statement contains a billing error,\\n\\n\\nthe creditor shall, unless the obligor has, after giving such written notice and before the expiration of the time limits herein specified, agreed that the statement was correct—\"],\"scope_text\":\"If a creditor receives qualifying notice from an obligor within sixty days after transmitting an account statement in connection with consumer credit, and the obligor has not agreed the statement was correct.\",\"section_id\":\"section-1\",\"start\":1351,\"summary\":\"If a creditor, within 60 days after having transmitted to an obligor a statement of the obligor's account in connection with an extension of consumer credit, receives at the address disclosed under section 1637(b)(10) of this title a qualifying written billing error notice from the obligor, the creditor must, unless the obligor has agreed the statement was correct, not later than two complete billing cycles of the creditor (in no event later than 90 days) after receipt of the notice and prior to taking any action to collect the amount or any part thereof indicated by the obligor under paragraph (2), either: (i) make appropriate corrections in the obligor's account (including crediting any finance charges on amounts erroneously billed), transmit to the obligor a notification of such corrections and an explanation of any change in the amount indicated, and, if any such change is made and the obligor so requests, provide copies of documentary evidence of indebtedness; or (ii) satisfy the requirements of clause (ii).\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",
      "dcterms:references": [
        {
          "@id": "urn:rulespec:document-understanding:assertion:eba9e8cb6dcdb7d4bdffc6c1a7ccb13ce0d551a3da9560d9bc31fa4d4e2d863b"
        },

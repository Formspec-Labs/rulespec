      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:71394c07c20db793a77c92447fad901679ee96a63c1347e41b84978e29a5fd0e",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:abd14761f9101901594f801b8c22aa7cb4d1d57f38d65861080755e31eb8fc75",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:301e5b5be35a55f2fbedbd882c61987a14ac1a3b8c3261f0332d6a4f01a0ac1d",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"actor\":\"creditor\",\"kind\":\"requirement\",\"modality\":\"must\",\"scope_text\":\"When a creditor has received qualifying written notice of a billing error and does not make corrections under clause (i), unless the obligor has agreed the statement was correct.\",\"summary\":\"Under the procedure upon receipt of a qualifying billing error notice, as an alternative to making corrections under clause (i), the creditor must, not later than two complete billing cycles of the creditor (and in no event later than 90 days) after receipt of notice and prior to taking collection action, send a written explanation or clarification to the obligor, after having conducted an investigation, setting forth to the extent applicable the reasons why the creditor believes the account was correctly shown in the statement and, upon request of the obligor, provide copies of documentary evidence of the obligor’s indebtedness.\"}",
        "@type": "xsd:string"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed",
      "rkaf:hasApplicability": "urn:rulespec:document-understanding:scope:1de9cd8e4a005cf51cdbe45747c7535400810e6ed76deb0a53fef94e2b24e121"
    },

      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"creditor\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:92289486e38d65e2960d5e685b9a343f18ef70708e49ba91f2e3ad6d5a28c96f\",\"urn:rulespec:document-understanding:assertion:82ad9f5879fa607d0a5e34f494d67de55313be96a200e7435a4ab354af7d1bbf\",\"urn:rulespec:document-understanding:assertion:56e1d1e4574432196ec1fc2fb3b0f7139b50634715a858f0642b2ee9b21cb9d1\",\"urn:rulespec:document-understanding:assertion:bc30a0ff8553f351738553ae10ddc6558318a5ef403d7f0528af43fc735d5d38\",\"urn:rulespec:document-understanding:assertion:ed29a139cfc1e4933cb9d0533ac79d1bc5b9066d3484c8e8f093c3a436dd3594\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":2853,\"evidence\":[{\"end\":2853,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ac97479fb155e2b95bcee63f73803745d8e3c96327ebc44b8158d9a6caa3b16ca:2048:2853:sha256-b41956e23df9e8ceee7dd13a0cbd69965d5a1a10aba7e0732413933ea93b00c5\",\"quote\":\"(ii) send a written explanation or clarification to the obligor, after having conducted an investigation, setting forth to the extent applicable the reasons why the creditor believes the account of the obligor was correctly shown in the statement and, upon request of the obligor, provide copies of documentary evidence of the obligor’s indebtedness. In the case of a billing error where the obligor alleges that the creditor’s billing statement reflects goods not delivered to the obligor or his designee in accordance with the agreement made at the time of the transaction, a creditor may not construe such amount to be correctly shown unless he determines that such goods were actually delivered, mailed, or otherwise sent to the obligor and provides the obligor with a statement of such determination.\",\"start\":2048},{\"end\":2642,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ac97479fb155e2b95bcee63f73803745d8e3c96327ebc44b8158d9a6caa3b16ca:2635:2642:sha256-0007a8bea4dcd3f6b1490fc7199650f1046713dd92d9314e1f2ede6946fcd999\",\"quote\":\"may not\",\"start\":2635},{\"end\":2853,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ac97479fb155e2b95bcee63f73803745d8e3c96327ebc44b8158d9a6caa3b16ca:2048:2853:sha256-b41956e23df9e8ceee7dd13a0cbd69965d5a1a10aba7e0732413933ea93b00c5\",\"quote\":\"(ii) send a written explanation or clarification to the obligor, after having conducted an investigation, setting forth to the extent applicable the reasons why the creditor believes the account of the obligor was correctly shown in the statement and, upon request of the obligor, provide copies of documentary evidence of the obligor’s indebtedness. In the case of a billing error where the obligor alleges that the creditor’s billing statement reflects goods not delivered to the obligor or his designee in accordance with the agreement made at the time of the transaction, a creditor may not construe such amount to be correctly shown unless he determines that such goods were actually delivered, mailed, or otherwise sent to the obligor and provides the obligor with a statement of such determination.\",\"start\":2048}],\"id\":\"urn:rulespec:document-understanding:revision:a88a607c60654d0a411150d7a37f45dab27e9dfa54d5bc3f49eb0fcb21c057c2\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"prohibition\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:ed29a139cfc1e4933cb9d0533ac79d1bc5b9066d3484c8e8f093c3a436dd3594\",\"modality\":\"must_not\",\"modality_quote\":\"may not\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:d962f8a554db9e644c211f9b274ef6c4af3e546d225507ce90422a4b9b52b8a0\",\"origin\":\"aiSuggested\",\"quote\":\"(ii) send a written explanation or clarification to the obligor, after having conducted an investigation, setting forth to the extent applicable the reasons why the creditor believes the account of the obligor was correctly shown in the statement and, upon request of the obligor, provide copies of documentary evidence of the obligor’s indebtedness. In the case of a billing error where the obligor alleges that the creditor’s billing statement reflects goods not delivered to the obligor or his designee in accordance with the agreement made at the time of the transaction, a creditor may not construe such amount to be correctly shown unless he determines that such goods were actually delivered, mailed, or otherwise sent to the obligor and provides the obligor with a statement of such determination.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:15963d31330152f823b3e9e9b61d6659c3c424d59e23ab3423d42c5d2f7ad5f0\",\"scope_quotes\":[\"(ii) send a written explanation or clarification to the obligor, after having conducted an investigation, setting forth to the extent applicable the reasons why the creditor believes the account of the obligor was correctly shown in the statement and, upon request of the obligor, provide copies of documentary evidence of the obligor’s indebtedness. In the case of a billing error where the obligor alleges that the creditor’s billing statement reflects goods not delivered to the obligor or his designee in accordance with the agreement made at the time of the transaction, a creditor may not construe such amount to be correctly shown unless he determines that such goods were actually delivered, mailed, or otherwise sent to the obligor and provides the obligor with a statement of such determination.\"],\"scope_text\":\"In the case of a billing error where the obligor alleges that the creditor’s billing statement reflects goods not delivered to the obligor or his designee in accordance with the agreement made at the time of the transaction\",\"section_id\":\"section-1\",\"start\":2048,\"summary\":\"In the case of a billing error where the obligor alleges that the creditor's billing statement reflects goods not delivered to the obligor or his designee in accordance with the agreement made at the time of the transaction, a creditor must not construe such amount to be correctly shown unless he determines that such goods were actually delivered, mailed, or otherwise sent to the obligor and provides the obligor with a statement of such determination.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

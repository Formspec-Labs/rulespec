      "@type": "rkaf:SourceFragment",
      "oa:hasSource": "urn:rulespec:document-understanding:document:c97479fb155e2b95bcee63f73803745d8e3c96327ebc44b8158d9a6caa3b16ca",
      "rkaf:fragmentIdentityScheme": "rkaf:carrier-local-fragment",
      "rkaf:sourceArtifactDigest": "sha256:c97479fb155e2b95bcee63f73803745d8e3c96327ebc44b8158d9a6caa3b16ca",
      "rkaf:fragmentContentDigest": "sha256:34cc48e965a8e36336edefc1d137663adc099e16504e1e7ce48139fbde20fdee",
      "rkaf:selectorKind": [
        "oa:TextQuoteSelector",
        "oa:TextPositionSelector"
      ],
      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "(1) sets forth or otherwise enables the creditor to identify the name and account number (if any) of the obligor,\n\n(2) indicates the obligor’s belief that the statement contains a billing error and the amount of such billing error, and\n\n(3) sets forth the reasons for the obligor’s belief (to the extent applicable) that the statement contains a billing error,\n\n\nthe creditor shall, unless the obligor has, after giving such written notice and before the expiration of the time limits herein specified, agreed that the statement was correct—"
        },
        {
          "@type": "oa:TextPositionSelector",
          "oa:start": 598,
          "oa:end": 1139,

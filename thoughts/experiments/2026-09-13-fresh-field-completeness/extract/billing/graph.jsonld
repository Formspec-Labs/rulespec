      "@id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ac97479fb155e2b95bcee63f73803745d8e3c96327ebc44b8158d9a6caa3b16ca:1612:2046:sha256-3e3e936cc97d86a0ae56622f79463a5b06d86a1b080da94b23da724078064f18",

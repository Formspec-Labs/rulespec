      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:76ac6bc342e0f1d6995390124c3c2f1274f3bbae080e364f6bedc2ea8b524e1b\",\"urn:rulespec:document-understanding:assertion:f8157fdd381a2f844c2aee081269558983c2a7fa62fd0cca3182554877350041\",\"urn:rulespec:document-understanding:assertion:f088e3d65900bb8f3d3f1b15f18783bfdd84a2a8f174852c4ec75af9584b8df0\",\"urn:rulespec:document-understanding:assertion:3349a1b27086f72c2b15e735c9c0125e3aff5cd9518b4ccd5af287d8804d5d4d\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":1588,\"evidence\":[{\"end\":1588,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A64645e90d82d1bd7fa23ad18b9d7343d17ca1e632621d7c5f4c80fb4ec32ce3f:1092:1588:sha256-4d9646bace5c8b1d4428d6d1861499b0e9d351652f605ac68051d3406a9175b5\",\"quote\":\"shall immediately inform the Commission of such failure to comply, of such defect, or of such risk, unless such manufacturer, distributor, or retailer has actual knowledge that the Commission has been adequately informed of such defect, failure to comply, or such risk. A report provided under paragraph (2) may not be used as the basis for criminal prosecution of the reporting person under section 1264 of this title, except for offenses which require a showing of intent to defraud or mislead.\",\"start\":1092},{\"end\":1407,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A64645e90d82d1bd7fa23ad18b9d7343d17ca1e632621d7c5f4c80fb4ec32ce3f:1400:1407:sha256-0007a8bea4dcd3f6b1490fc7199650f1046713dd92d9314e1f2ede6946fcd999\",\"quote\":\"may not\",\"start\":1400},{\"end\":1588,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A64645e90d82d1bd7fa23ad18b9d7343d17ca1e632621d7c5f4c80fb4ec32ce3f:1092:1588:sha256-4d9646bace5c8b1d4428d6d1861499b0e9d351652f605ac68051d3406a9175b5\",\"quote\":\"shall immediately inform the Commission of such failure to comply, of such defect, or of such risk, unless such manufacturer, distributor, or retailer has actual knowledge that the Commission has been adequately informed of such defect, failure to comply, or such risk. A report provided under paragraph (2) may not be used as the basis for criminal prosecution of the reporting person under section 1264 of this title, except for offenses which require a showing of intent to defraud or mislead.\",\"start\":1092}],\"id\":\"urn:rulespec:document-understanding:revision:d71521b211f73254e84f2a8c6b8b20a8c3c3fd801b7fc4d19963ca9c308d4cc0\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"prohibition\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:3349a1b27086f72c2b15e735c9c0125e3aff5cd9518b4ccd5af287d8804d5d4d\",\"modality\":\"must_not\",\"modality_quote\":\"may not\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:5bf164627e333c571d4788ab762cd264f244c2f633f60650c57295316981e175\",\"origin\":\"aiSuggested\",\"quote\":\"shall immediately inform the Commission of such failure to comply, of such defect, or of such risk, unless such manufacturer, distributor, or retailer has actual knowledge that the Commission has been adequately informed of such defect, failure to comply, or such risk. A report provided under paragraph (2) may not be used as the basis for criminal prosecution of the reporting person under section 1264 of this title, except for offenses which require a showing of intent to defraud or mislead.\",\"references\":[\"paragraph (2)\",\"section 1264 of this title\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:a0101ca68f2c60727ddb6491fca08f2e067a9b765815d1eab0cbb6a07d8b988b\",\"scope_quotes\":[\"shall immediately inform the Commission of such failure to comply, of such defect, or of such risk, unless such manufacturer, distributor, or retailer has actual knowledge that the Commission has been adequately informed of such defect, failure to comply, or such risk. A report provided under paragraph (2) may not be used as the basis for criminal prosecution of the reporting person under section 1264 of this title, except for offenses which require a showing of intent to defraud or mislead.\"],\"scope_text\":\"Applies to a report provided under paragraph (2), except for offenses requiring a showing of intent to defraud or mislead.\",\"section_id\":\"section-1\",\"start\":1092,\"summary\":\"A report provided under paragraph (2) may not be used as the basis for criminal prosecution of the reporting person under section 1264 of this title, except for offenses which require a showing of intent to defraud or mislead.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

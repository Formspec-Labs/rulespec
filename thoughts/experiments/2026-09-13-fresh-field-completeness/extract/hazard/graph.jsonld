    {
      "@id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A64645e90d82d1bd7fa23ad18b9d7343d17ca1e632621d7c5f4c80fb4ec32ce3f:595:1089:sha256-4fc1baddea14cca1794a607d422fbacdd516e1a01596f6718878756678bf7e1e",
      "@type": "rkaf:SourceFragment",
      "oa:hasSource": "urn:rulespec:document-understanding:document:64645e90d82d1bd7fa23ad18b9d7343d17ca1e632621d7c5f4c80fb4ec32ce3f",
      "rkaf:fragmentIdentityScheme": "rkaf:carrier-local-fragment",
      "rkaf:sourceArtifactDigest": "sha256:64645e90d82d1bd7fa23ad18b9d7343d17ca1e632621d7c5f4c80fb4ec32ce3f",
      "rkaf:fragmentContentDigest": "sha256:4fc1baddea14cca1794a607d422fbacdd516e1a01596f6718878756678bf7e1e",
      "rkaf:selectorKind": [
        "oa:TextQuoteSelector",
        "oa:TextPositionSelector"
      ],
      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "(1) fails to comply with an applicable consumer product safety rule or with a voluntary consumer product safety standard upon which the Commission has relied under section 2058 of this title;\n\n(2) fails to comply with any other rule, regulation, standard, or ban under this chapter or any other Act enforced by the Commission;\n\n(3) contains a defect which could create a substantial product hazard described in subsection (a)(2); or\n\n(4) creates an unreasonable risk of serious injury or death,"
        },
        {
          "@type": "oa:TextPositionSelector",
          "oa:start": 595,
          "oa:end": 1089,

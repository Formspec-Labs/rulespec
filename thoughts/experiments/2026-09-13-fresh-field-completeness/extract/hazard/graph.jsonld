      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:scope_text",
      "rkaf:assertsValue": {
        "@value": "When a manufacturer of a consumer product or other jurisdictional product/substance (other than motor vehicle equipment as defined in section 30102(a)(7) of title 49) distributed in commerce, or a distributor or retailer of such product, obtains information reasonably supporting the conclusion that such product (1) fails to comply with an applicable consumer product safety rule or relied-upon voluntary standard under section 2058, (2) fails to comply with any other rule, regulation, standard, or ban under this chapter or any other Act enforced by the Commission, (3) contains a defect which could create a substantial product hazard described in subsection (a)(2), or (4) creates an unreasonable risk of serious injury or death, and unless the manufacturer, distributor, or retailer has actual knowledge that the Commission has been adequately informed of such defect, failure to comply, or risk.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

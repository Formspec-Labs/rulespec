    {
      "@id": "urn:rulespec:document-understanding:revision:d2ebfec3a1b9757160710f18e0a6c50cbd2feaa9e04ba92e1d55fea64b470444",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:d2ebfec3a1b9757160710f18e0a6c50cbd2feaa9e04ba92e1d55fea64b470444",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:cff40008920753c65ffd897e8c3e1299451bbdcf40c4c51fa21242507a4e0dd5",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:e157504a899b5b239814b9851344490065e77b411e355a58daea668db9abb000\",\"urn:rulespec:document-understanding:assertion:6af1f3e530ea340147d80af480fb17e34857a8307a9d858688efcecf9d63b4b4\",\"urn:rulespec:document-understanding:assertion:1197bdeac09419d456d73c721fc338b79c50796e051f978e243adb711dbafe63\",\"urn:rulespec:document-understanding:assertion:69baacf8c9ddd0978974bde2878030ea6675873de1dfad6d324e221c8f32ad69\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":1588,\"evidence\":[{\"end\":1588,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A64645e90d82d1bd7fa23ad18b9d7343d17ca1e632621d7c5f4c80fb4ec32ce3f:1092:1588:sha256-4d9646bace5c8b1d4428d6d1861499b0e9d351652f605ac68051d3406a9175b5\",\"quote\":\"shall immediately inform the Commission of such failure to comply, of such defect, or of such risk, unless such manufacturer, distributor, or retailer has actual knowledge that the Commission has been adequately informed of such defect, failure to comply, or such risk. A report provided under paragraph (2) may not be used as the basis for criminal prosecution of the reporting person under section 1264 of this title, except for offenses which require a showing of intent to defraud or mislead.\",\"start\":1092},{\"end\":1097,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A64645e90d82d1bd7fa23ad18b9d7343d17ca1e632621d7c5f4c80fb4ec32ce3f:1092:1097:sha256-56ee5b508706bf2de91712d85d6d1e11ddbff01949142ed6e8c22e3b1bed1c71\",\"quote\":\"shall\",\"start\":1092},{\"end\":144,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A64645e90d82d1bd7fa23ad18b9d7343d17ca1e632621d7c5f4c80fb4ec32ce3f:0:144:sha256-806fced2fec9ca63f6331d02e6d12064de075dcbeb33165f45e2968c66950df7\",\"quote\":\"(b) Noncompliance with applicable consumer product safety rules; product defects; notice to Commission by manufacturer, distributor, or retailer\",\"start\":0},{\"end\":390,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A64645e90d82d1bd7fa23ad18b9d7343d17ca1e632621d7c5f4c80fb4ec32ce3f:145:390:sha256-40cc4bd5978bec111ee7f6ef7bcac0e6e250ded0fc3e0cb76a14f5e09383c260\",\"quote\":\"Every manufacturer of a consumer product, or other product or substance over which the Commission has jurisdiction under any other Act enforced by the Commission (other than motor vehicle equipment as defined in section 30102(a)(7) of title 49 1\",\"start\":145},{\"end\":593,\"field\":\"scope_text:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A64645e90d82d1bd7fa23ad18b9d7343d17ca1e632621d7c5f4c80fb4ec32ce3f:430:593:sha256-eab970eda2f8aa4008e5b92275cd82f1545a0957a9afe524643098213168f4a5\",\"quote\":\"), distributed in commerce, and every distributor and retailer of such product, who obtains information which reasonably supports the conclusion that such product—\",\"start\":430},{\"end\":1089,\"field\":\"scope_text:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A64645e90d82d1bd7fa23ad18b9d7343d17ca1e632621d7c5f4c80fb4ec32ce3f:595:1089:sha256-4fc1baddea14cca1794a607d422fbacdd516e1a01596f6718878756678bf7e1e\",\"quote\":\"(1) fails to comply with an applicable consumer product safety rule or with a voluntary consumer product safety standard upon which the Commission has relied under section 2058 of this title;\\n\\n(2) fails to comply with any other rule, regulation, standard, or ban under this chapter or any other Act enforced by the Commission;\\n\\n(3) contains a defect which could create a substantial product hazard described in subsection (a)(2); or\\n\\n(4) creates an unreasonable risk of serious injury or death,\",\"start\":595},{\"end\":1588,\"field\":\"scope_text:2\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A64645e90d82d1bd7fa23ad18b9d7343d17ca1e632621d7c5f4c80fb4ec32ce3f:1092:1588:sha256-4d9646bace5c8b1d4428d6d1861499b0e9d351652f605ac68051d3406a9175b5\",\"quote\":\"shall immediately inform the Commission of such failure to comply, of such defect, or of such risk, unless such manufacturer, distributor, or retailer has actual knowledge that the Commission has been adequately informed of such defect, failure to comply, or such risk. A report provided under paragraph (2) may not be used as the basis for criminal prosecution of the reporting person under section 1264 of this title, except for offenses which require a showing of intent to defraud or mislead.\",\"start\":1092}],\"id\":\"urn:rulespec:document-understanding:revision:d2ebfec3a1b9757160710f18e0a6c50cbd2feaa9e04ba92e1d55fea64b470444\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:69baacf8c9ddd0978974bde2878030ea6675873de1dfad6d324e221c8f32ad69\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:76cf2fca7738fb09e19afd6e8f78f03594b452aa8c0a9f56aa86cf726a5ff390\",\"origin\":\"aiSuggested\",\"quote\":\"shall immediately inform the Commission of such failure to comply, of such defect, or of such risk, unless such manufacturer, distributor, or retailer has actual knowledge that the Commission has been adequately informed of such defect, failure to comply, or such risk. A report provided under paragraph (2) may not be used as the basis for criminal prosecution of the reporting person under section 1264 of this title, except for offenses which require a showing of intent to defraud or mislead.\",\"references\":[\"section 30102(a)(7) of title 49\",\"section 2058 of this title\",\"subsection (a)(2)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:f74535b706df14f4ccd55c688423f516805396ed953b8e14fc9a57c603ce548d\",\"scope_quotes\":[\"(b) Noncompliance with applicable consumer product safety rules; product defects; notice to Commission by manufacturer, distributor, or retailer Every manufacturer of a consumer product, or other product or substance over which the Commission has jurisdiction under any other Act enforced by the Commission (other than motor vehicle equipment as defined in section 30102(a)(7) of title 49 1\",\"), distributed in commerce, and every distributor and retailer of such product, who obtains information which reasonably supports the conclusion that such product—\\n\\n(1) fails to comply with an applicable consumer product safety rule or with a voluntary consumer product safety standard upon which the Commission has relied under section 2058 of this title;\\n\\n(2) fails to comply with any other rule, regulation, standard, or ban under this chapter or any other Act enforced by the Commission;\\n\\n(3) contains a defect which could create a substantial product hazard described in subsection (a)(2); or\\n\\n(4) creates an unreasonable risk of serious injury or death,\",\"shall immediately inform the Commission of such failure to comply, of such defect, or of such risk, unless such manufacturer, distributor, or retailer has actual knowledge that the Commission has been adequately informed of such defect, failure to comply, or such risk. A report provided under paragraph (2) may not be used as the basis for criminal prosecution of the reporting person under section 1264 of this title, except for offenses which require a showing of intent to defraud or mislead.\"],\"scope_text\":\"When a manufacturer of a consumer product or other jurisdictional product/substance (other than motor vehicle equipment as defined in section 30102(a)(7) of title 49) distributed in commerce, or a distributor or retailer of such product, obtains information reasonably supporting the conclusion that such product (1) fails to comply with an applicable consumer product safety rule or relied-upon voluntary standard under section 2058, (2) fails to comply with any other rule, regulation, standard, or ban under this chapter or any other Act enforced by the Commission, (3) contains a defect which could create a substantial product hazard described in subsection (a)(2), or (4) creates an unreasonable risk of serious injury or death, and unless the manufacturer, distributor, or retailer has actual knowledge that the Commission has been adequately informed of such defect, failure to comply, or risk.\",\"section_id\":\"section-1\",\"start\":1092,\"summary\":\"Every manufacturer of a consumer product, or other product or substance over which the Commission has jurisdiction under any other Act enforced by the Commission (other than motor vehicle equipment as defined in section 30102(a)(7) of title 49), distributed in commerce, and every distributor and retailer of such product, who obtains information which reasonably supports the conclusion that such product fails to comply with an applicable consumer product safety rule or with a voluntary consumer product safety standard upon which the Commission has relied under section 2058 of this title, fails to comply with any other rule, regulation, standard, or ban under this chapter or any other Act enforced by the Commission, contains a defect which could create a substantial product hazard described in subsection (a)(2), or creates an unreasonable risk of serious injury or death, shall immediately inform the Commission of such failure to comply, of such defect, or of such risk, unless such manufacturer, distributor, or retailer has actual knowledge that the Commission has been adequately informed of such defect, failure to comply, or such risk.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

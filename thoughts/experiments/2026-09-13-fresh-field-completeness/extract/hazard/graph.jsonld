      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:21a9ce070450df2d7d45e3c1e553299fb99b1321101e139f4d7937a21944aae5",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:20e33a16d6f784af88583959f2fd40d57d959d0f7dde40b3f54a0abe5d7ce24e",

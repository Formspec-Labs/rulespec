    {
      "@id": "urn:rulespec:document-understanding:scope:8690cdc05e29dda6e71ded71559e9d0bb6fb8976bfd3ea261f670f91908cd52e",
      "@type": "rkaf:ApplicabilityScope",
      "rkaf:appliesInJurisdiction": [],
      "rkaf:applicabilityCondition": "Within five days after the initial communication with a consumer in connection with the collection of any debt, unless the following information is contained in the initial communication or the consumer has paid the debt."
    },
    {
      "@id": "urn:rulespec:document-understanding:assertion:6654e58494d772c1f4139455697977ee8c5da564134d2f0f3f5fd53eb3b997de",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:a50b7332c87701ed69ae6cb105960c2f039dff4a0e6217f7ffec67c10bc21689",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:fe83c5e6847b7ebad59d77eb421a7d5ad119cec7748a1329d6d2dbf7adc64667",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:c16b0eca87ff62f02bb9f31f633ad73973e63088aa0ac70ee4a8f9a552e18ba9",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:states-requirement",
      "rkaf:assertsValue": {
        "@value": "Within five days after the initial communication with a consumer in connection with the collection of any debt, a debt collector must send the consumer a written notice containing: (1) the amount of the debt; (2) the name of the creditor to whom the debt is owed; (3) a statement that unless the consumer, within thirty days after receipt of the notice, disputes the validity of the debt, or any portion thereof, the debt will be assumed to be valid by the debt collector; (4) a statement that if the consumer notifies the debt collector in writing within the thirty-day period that the debt, or any portion thereof, is disputed, the debt collector will obtain verification of the debt or a copy of a judgment against the consumer and a copy of such verification or judgment will be mailed to the consumer by the debt collector; and (5) a statement that, upon the consumer’s written request within the thirty-day period, the debt collector will provide the consumer with the name and address of the original creditor, if different from the current creditor, unless the information is contained in the initial communication or the consumer has paid the debt.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

      "@id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A3f80396a7bf7aa3a0eff8515ce0f34124cb1f57c6872b69219928e0fe235e700:323:1203:sha256-b449fde61d98880be0b1d07f23c82738ad146eb95804620fa20316fab4012f5f",
      "@type": "rkaf:SourceFragment",
      "oa:hasSource": "urn:rulespec:document-understanding:document:3f80396a7bf7aa3a0eff8515ce0f34124cb1f57c6872b69219928e0fe235e700",
      "rkaf:fragmentIdentityScheme": "rkaf:carrier-local-fragment",
      "rkaf:sourceArtifactDigest": "sha256:3f80396a7bf7aa3a0eff8515ce0f34124cb1f57c6872b69219928e0fe235e700",
      "rkaf:fragmentContentDigest": "sha256:b449fde61d98880be0b1d07f23c82738ad146eb95804620fa20316fab4012f5f",
      "rkaf:selectorKind": [
        "oa:TextQuoteSelector",
        "oa:TextPositionSelector"
      ],
      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "(1) the amount of the debt;\n\n(2) the name of the creditor to whom the debt is owed;\n\n(3) a statement that unless the consumer, within thirty days after receipt of the notice, disputes the validity of the debt, or any portion thereof, the debt will be assumed to be valid by the debt collector;\n\n(4) a statement that if the consumer notifies the debt collector in writing within the thirty-day period that the debt, or any portion thereof, is disputed, the debt collector will obtain verification of the debt or a copy of a judgment against the consumer and a copy of such verification or judgment will be mailed to the consumer by the debt collector; and\n\n(5) a statement that, upon the consumer’s written request within the thirty-day period, the debt collector will provide the consumer with the name and address of the original creditor, if different from the current creditor."
        },
        {
          "@type": "oa:TextPositionSelector",
          "oa:start": 323,
          "oa:end": 1203,
          "rkaf:coordinateSystem": "rkaf:unicode-codepoint"
        }
      ]

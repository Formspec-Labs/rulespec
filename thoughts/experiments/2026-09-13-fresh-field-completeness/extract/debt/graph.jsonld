      "dcterms:description": "{\"action\":\"\",\"actor\":\"a debt collector\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:6654e58494d772c1f4139455697977ee8c5da564134d2f0f3f5fd53eb3b997de\",\"urn:rulespec:document-understanding:assertion:b9364219edabff85b1acca987e6da50b82ab0bc73afd5afc9454604677779cee\",\"urn:rulespec:document-understanding:assertion:f861fd3500b502fe9324e72be16029644e1b8307a1b0cd702abb111dbdeb741e\",\"urn:rulespec:document-understanding:assertion:bc6bd9139a550b9f8f125c86ad5dd0cdb932b8a66ce37b9866be8099d0e1be94\",\"urn:rulespec:document-understanding:assertion:6b16549e10eae8edcaf017afbbe053062305bb8ae6012cdd8b16f6399e05a816\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":1203,\"evidence\":[{\"end\":28,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A3f80396a7bf7aa3a0eff8515ce0f34124cb1f57c6872b69219928e0fe235e700:0:28:sha256-68c8012f829bd19f0d191366d91e6643d91761f61d9dc12acffa1da7bdc5842d\",\"quote\":\"(a) Notice of debt; contents\",\"start\":0},{\"end\":321,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A3f80396a7bf7aa3a0eff8515ce0f34124cb1f57c6872b69219928e0fe235e700:29:321:sha256-a74ebf2c3ee1236b046ad2de4a870b22b22bf0fb61784c19b7b8b51a09da58cb\",\"quote\":\"Within five days after the initial communication with a consumer in connection with the collection of any debt, a debt collector shall, unless the following information is contained in the initial communication or the consumer has paid the debt, send the consumer a written notice containing—\",\"start\":29},{\"end\":1203,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A3f80396a7bf7aa3a0eff8515ce0f34124cb1f57c6872b69219928e0fe235e700:323:1203:sha256-b449fde61d98880be0b1d07f23c82738ad146eb95804620fa20316fab4012f5f\",\"quote\":\"(1) the amount of the debt;\\n\\n(2) the name of the creditor to whom the debt is owed;\\n\\n(3) a statement that unless the consumer, within thirty days after receipt of the notice, disputes the validity of the debt, or any portion thereof, the debt will be assumed to be valid by the debt collector;\\n\\n(4) a statement that if the consumer notifies the debt collector in writing within the thirty-day period that the debt, or any portion thereof, is disputed, the debt collector will obtain verification of the debt or a copy of a judgment against the consumer and a copy of such verification or judgment will be mailed to the consumer by the debt collector; and\\n\\n(5) a statement that, upon the consumer’s written request within the thirty-day period, the debt collector will provide the consumer with the name and address of the original creditor, if different from the current creditor.\",\"start\":323},{\"end\":157,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A3f80396a7bf7aa3a0eff8515ce0f34124cb1f57c6872b69219928e0fe235e700:141:157:sha256-b4cbe1b583fcf24a6caf1c895410a726209420d3f7e305177e6f4a6c1cac7b77\",\"quote\":\"a debt collector\",\"start\":141},{\"end\":163,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A3f80396a7bf7aa3a0eff8515ce0f34124cb1f57c6872b69219928e0fe235e700:158:163:sha256-56ee5b508706bf2de91712d85d6d1e11ddbff01949142ed6e8c22e3b1bed1c71\",\"quote\":\"shall\",\"start\":158},{\"end\":28,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A3f80396a7bf7aa3a0eff8515ce0f34124cb1f57c6872b69219928e0fe235e700:0:28:sha256-68c8012f829bd19f0d191366d91e6643d91761f61d9dc12acffa1da7bdc5842d\",\"quote\":\"(a) Notice of debt; contents\",\"start\":0},{\"end\":321,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A3f80396a7bf7aa3a0eff8515ce0f34124cb1f57c6872b69219928e0fe235e700:29:321:sha256-a74ebf2c3ee1236b046ad2de4a870b22b22bf0fb61784c19b7b8b51a09da58cb\",\"quote\":\"Within five days after the initial communication with a consumer in connection with the collection of any debt, a debt collector shall, unless the following information is contained in the initial communication or the consumer has paid the debt, send the consumer a written notice containing—\",\"start\":29}],\"id\":\"urn:rulespec:document-understanding:revision:3d79b0ceac3725c6e974dab815dc657ba51d8c56f3e1511ff5f5111e6b8eb3ba\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:6b16549e10eae8edcaf017afbbe053062305bb8ae6012cdd8b16f6399e05a816\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:a25b16b0a1c65a5a9563d5bd448400edce27f165d9f95f11f7cfe2f445c5ff2b\",\"origin\":\"aiSuggested\",\"quote\":\"(a) Notice of debt; contents Within five days after the initial communication with a consumer in connection with the collection of any debt, a debt collector shall, unless the following information is contained in the initial communication or the consumer has paid the debt, send the consumer a written notice containing—\\n\\n(1) the amount of the debt;\\n\\n(2) the name of the creditor to whom the debt is owed;\\n\\n(3) a statement that unless the consumer, within thirty days after receipt of the notice, disputes the validity of the debt, or any portion thereof, the debt will be assumed to be valid by the debt collector;\\n\\n(4) a statement that if the consumer notifies the debt collector in writing within the thirty-day period that the debt, or any portion thereof, is disputed, the debt collector will obtain verification of the debt or a copy of a judgment against the consumer and a copy of such verification or judgment will be mailed to the consumer by the debt collector; and\\n\\n(5) a statement that, upon the consumer’s written request within the thirty-day period, the debt collector will provide the consumer with the name and address of the original creditor, if different from the current creditor.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:c16b0eca87ff62f02bb9f31f633ad73973e63088aa0ac70ee4a8f9a552e18ba9\",\"scope_quotes\":[\"(a) Notice of debt; contents Within five days after the initial communication with a consumer in connection with the collection of any debt, a debt collector shall, unless the following information is contained in the initial communication or the consumer has paid the debt, send the consumer a written notice containing—\"],\"scope_text\":\"Within five days after the initial communication with a consumer in connection with the collection of any debt, unless the following information is contained in the initial communication or the consumer has paid the debt.\",\"section_id\":\"section-1\",\"start\":0,\"summary\":\"Within five days after the initial communication with a consumer in connection with the collection of any debt, a debt collector must send the consumer a written notice containing: (1) the amount of the debt; (2) the name of the creditor to whom the debt is owed; (3) a statement that unless the consumer, within thirty days after receipt of the notice, disputes the validity of the debt, or any portion thereof, the debt will be assumed to be valid by the debt collector; (4) a statement that if the consumer notifies the debt collector in writing within the thirty-day period that the debt, or any portion thereof, is disputed, the debt collector will obtain verification of the debt or a copy of a judgment against the consumer and a copy of such verification or judgment will be mailed to the consumer by the debt collector; and (5) a statement that, upon the consumer’s written request within the thirty-day period, the debt collector will provide the consumer with the name and address of the original creditor, if different from the current creditor, unless the information is contained in the initial communication or the consumer has paid the debt.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

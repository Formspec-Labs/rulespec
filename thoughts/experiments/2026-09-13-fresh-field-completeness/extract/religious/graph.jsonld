      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:d6cf51fa34fba66066f5221c32344b8e27661e5410f98f6fc606d6ac293f8ddc",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:ec71a0f66187b85731cc2949a5e669e249f7af2055a1247a42cd873e7f317dfd",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:f9a083c3e291f03adb0f0c4c7f7f1e494d06e14c21bdd92161880dcf640393b7",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:states-exemption",
      "rkaf:assertsValue": {
        "@value": "Notwithstanding any other provision of this subchapter, it shall not be an unlawful employment practice for an employer to hire and employ employees, for an employment agency to classify, or refer for employment any individual, for a labor organization to classify its membership or to classify or refer for employment any individual, or for an employer, labor organization, or joint labor-management committee controlling apprenticeship or other training or retraining programs to admit or employ any individual in any such program, on the basis of his religion, sex, or national origin in those certain instances where religion, sex, or national origin is a bona fide occupational qualification reasonably necessary to the normal operation of that particular business or enterprise.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

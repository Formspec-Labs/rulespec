      "rkaf:hasContentDigest": "sha256:295d15dd9c22bda668abf1d8de8a7a247b2ee3639989e9f8e8cf65953920c979",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"an employer, employment agency, labor organization, or joint labor-management committee controlling apprenticeship or other training or retraining programs\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:0dad8cef6bb5f4b074eea859a4c77df7050b125679d181126d071d1a696930f9\",\"urn:rulespec:document-understanding:assertion:0410af9f2e34bfe336343750bb939b996e1cae80fad11958e4072417eaa774d3\",\"urn:rulespec:document-understanding:assertion:bf1ad5b66c6f2e48700bf045f8d267cfaba4ddfd0d1f988ccc1759a6fd632b92\",\"urn:rulespec:document-understanding:assertion:b3f1d52bb1bb60907fa907ae4bf0f5f6f34e384cdce86bf8fee609d9f45c582e\",\"urn:rulespec:document-understanding:assertion:3ea1fa9682444d56af280f3989ba13d8fd89170648766b362ba7c67d098f5669\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":1605,\"evidence\":[{\"end\":1605,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A96527f08034b6bc5461a30388e1223a12e3cee067dd28855065389b8e17cac68:166:1605:sha256-5d4d1743caa89a9e97616a785190a58f91b03e61cacf58ac2d4eb94ccf56ddb8\",\"quote\":\"Notwithstanding any other provision of this subchapter, (1) it shall not be an unlawful employment practice for an employer to hire and employ employees, for an employment agency to classify, or refer for employment any individual, for a labor organization to classify its membership or to classify or refer for employment any individual, or for an employer, labor organization, or joint labor-management committee controlling apprenticeship or other training or retraining programs to admit or employ any individual in any such program, on the basis of his religion, sex, or national origin in those certain instances where religion, sex, or national origin is a bona fide occupational qualification reasonably necessary to the normal operation of that particular business or enterprise, and (2) it shall not be an unlawful employment practice for a school, college, university, or other educational institution or institution of learning to hire and employ employees of a particular religion if such school, college, university, or other educational institution or institution of learning is, in whole or in substantial part, owned, supported, controlled, or managed by a particular religion or by a particular religious corporation, association, or society, or if the curriculum of such school, college, university, or other educational institution or institution of learning is directed toward the propagation of a particular religion.\",\"start\":166},{\"end\":648,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A96527f08034b6bc5461a30388e1223a12e3cee067dd28855065389b8e17cac68:278:648:sha256-4fdac62fbf1968a4c25b3bedad7bb6d6d003e917ef67e50bd35a94ba8936f5fb\",\"quote\":\"an employer to hire and employ employees, for an employment agency to classify, or refer for employment any individual, for a labor organization to classify its membership or to classify or refer for employment any individual, or for an employer, labor organization, or joint labor-management committee controlling apprenticeship or other training or retraining programs\",\"start\":278},{\"end\":1605,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A96527f08034b6bc5461a30388e1223a12e3cee067dd28855065389b8e17cac68:166:1605:sha256-5d4d1743caa89a9e97616a785190a58f91b03e61cacf58ac2d4eb94ccf56ddb8\",\"quote\":\"Notwithstanding any other provision of this subchapter, (1) it shall not be an unlawful employment practice for an employer to hire and employ employees, for an employment agency to classify, or refer for employment any individual, for a labor organization to classify its membership or to classify or refer for employment any individual, or for an employer, labor organization, or joint labor-management committee controlling apprenticeship or other training or retraining programs to admit or employ any individual in any such program, on the basis of his religion, sex, or national origin in those certain instances where religion, sex, or national origin is a bona fide occupational qualification reasonably necessary to the normal operation of that particular business or enterprise, and (2) it shall not be an unlawful employment practice for a school, college, university, or other educational institution or institution of learning to hire and employ employees of a particular religion if such school, college, university, or other educational institution or institution of learning is, in whole or in substantial part, owned, supported, controlled, or managed by a particular religion or by a particular religious corporation, association, or society, or if the curriculum of such school, college, university, or other educational institution or institution of learning is directed toward the propagation of a particular religion.\",\"start\":166}],\"id\":\"urn:rulespec:document-understanding:revision:e9676ae191a04d0bb7fee973dc58dceca8aaed4ef85de6781a6bcfe7944cbcfe\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"exemption\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:3ea1fa9682444d56af280f3989ba13d8fd89170648766b362ba7c67d098f5669\",\"modality\":\"not_required\",\"modality_quote\":\"shall not be an unlawful employment practice\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:bd443555f97c4b74eeedce12d7bd62905c35fab78d5599084a6d1a78422a66fd\",\"origin\":\"aiSuggested\",\"quote\":\"Notwithstanding any other provision of this subchapter, (1) it shall not be an unlawful employment practice for an employer to hire and employ employees, for an employment agency to classify, or refer for employment any individual, for a labor organization to classify its membership or to classify or refer for employment any individual, or for an employer, labor organization, or joint labor-management committee controlling apprenticeship or other training or retraining programs to admit or employ any individual in any such program, on the basis of his religion, sex, or national origin in those certain instances where religion, sex, or national origin is a bona fide occupational qualification reasonably necessary to the normal operation of that particular business or enterprise, and (2) it shall not be an unlawful employment practice for a school, college, university, or other educational institution or institution of learning to hire and employ employees of a particular religion if such school, college, university, or other educational institution or institution of learning is, in whole or in substantial part, owned, supported, controlled, or managed by a particular religion or by a particular religious corporation, association, or society, or if the curriculum of such school, college, university, or other educational institution or institution of learning is directed toward the propagation of a particular religion.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:f9a083c3e291f03adb0f0c4c7f7f1e494d06e14c21bdd92161880dcf640393b7\",\"scope_quotes\":[\"Notwithstanding any other provision of this subchapter, (1) it shall not be an unlawful employment practice for an employer to hire and employ employees, for an employment agency to classify, or refer for employment any individual, for a labor organization to classify its membership or to classify or refer for employment any individual, or for an employer, labor organization, or joint labor-management committee controlling apprenticeship or other training or retraining programs to admit or employ any individual in any such program, on the basis of his religion, sex, or national origin in those certain instances where religion, sex, or national origin is a bona fide occupational qualification reasonably necessary to the normal operation of that particular business or enterprise, and (2) it shall not be an unlawful employment practice for a school, college, university, or other educational institution or institution of learning to hire and employ employees of a particular religion if such school, college, university, or other educational institution or institution of learning is, in whole or in substantial part, owned, supported, controlled, or managed by a particular religion or by a particular religious corporation, association, or society, or if the curriculum of such school, college, university, or other educational institution or institution of learning is directed toward the propagation of a particular religion.\"],\"scope_text\":\"in those certain instances where religion, sex, or national origin is a bona fide occupational qualification reasonably necessary to the normal operation of that particular business or enterprise\",\"section_id\":\"section-1\",\"start\":166,\"summary\":\"Notwithstanding any other provision of this subchapter, it shall not be an unlawful employment practice for an employer to hire and employ employees, for an employment agency to classify, or refer for employment any individual, for a labor organization to classify its membership or to classify or refer for employment any individual, or for an employer, labor organization, or joint labor-management committee controlling apprenticeship or other training or retraining programs to admit or employ any individual in any such program, on the basis of his religion, sex, or national origin in those certain instances where religion, sex, or national origin is a bona fide occupational qualification reasonably necessary to the normal operation of that particular business or enterprise.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

      "dcterms:description": "{\"action\":\"\",\"actor\":\"a school, college, university, or other educational institution or institution of learning\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:ac4e065f302315c24b5f2dda8f0e131c432539379f829786d15af4a86d42a6b6\",\"urn:rulespec:document-understanding:assertion:764e867458e4c858780f9f5d1fb417e75f38663f9990841c893ab816f369d5b3\",\"urn:rulespec:document-understanding:assertion:989bdd4218b505bb45fcc7a67de97b5f17f53123d488eb046aa8a378bd66ca82\",\"urn:rulespec:document-understanding:assertion:85d75746765751a48752774839cd93a542fc53543768b8bf68e15c03fa5c1105\",\"urn:rulespec:document-understanding:assertion:543b8007712edf5bc167c0ba9946f416add39c6e9ea0a27d9199f0ea20fdb02b\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":1605,\"evidence\":[{\"end\":1605,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A96527f08034b6bc5461a30388e1223a12e3cee067dd28855065389b8e17cac68:166:1605:sha256-5d4d1743caa89a9e97616a785190a58f91b03e61cacf58ac2d4eb94ccf56ddb8\",\"quote\":\"Notwithstanding any other provision of this subchapter, (1) it shall not be an unlawful employment practice for an employer to hire and employ employees, for an employment agency to classify, or refer for employment any individual, for a labor organization to classify its membership or to classify or refer for employment any individual, or for an employer, labor organization, or joint labor-management committee controlling apprenticeship or other training or retraining programs to admit or employ any individual in any such program, on the basis of his religion, sex, or national origin in those certain instances where religion, sex, or national origin is a bona fide occupational qualification reasonably necessary to the normal operation of that particular business or enterprise, and (2) it shall not be an unlawful employment practice for a school, college, university, or other educational institution or institution of learning to hire and employ employees of a particular religion if such school, college, university, or other educational institution or institution of learning is, in whole or in substantial part, owned, supported, controlled, or managed by a particular religion or by a particular religious corporation, association, or society, or if the curriculum of such school, college, university, or other educational institution or institution of learning is directed toward the propagation of a particular religion.\",\"start\":166},{\"end\":1105,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A96527f08034b6bc5461a30388e1223a12e3cee067dd28855065389b8e17cac68:1015:1105:sha256-0b0cbf0fa96ce1b05e2d7f2b6646eac105871f0e49f78b40caf2a269ced4a7ba\",\"quote\":\"a school, college, university, or other educational institution or institution of learning\",\"start\":1015},{\"end\":1605,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A96527f08034b6bc5461a30388e1223a12e3cee067dd28855065389b8e17cac68:166:1605:sha256-5d4d1743caa89a9e97616a785190a58f91b03e61cacf58ac2d4eb94ccf56ddb8\",\"quote\":\"Notwithstanding any other provision of this subchapter, (1) it shall not be an unlawful employment practice for an employer to hire and employ employees, for an employment agency to classify, or refer for employment any individual, for a labor organization to classify its membership or to classify or refer for employment any individual, or for an employer, labor organization, or joint labor-management committee controlling apprenticeship or other training or retraining programs to admit or employ any individual in any such program, on the basis of his religion, sex, or national origin in those certain instances where religion, sex, or national origin is a bona fide occupational qualification reasonably necessary to the normal operation of that particular business or enterprise, and (2) it shall not be an unlawful employment practice for a school, college, university, or other educational institution or institution of learning to hire and employ employees of a particular religion if such school, college, university, or other educational institution or institution of learning is, in whole or in substantial part, owned, supported, controlled, or managed by a particular religion or by a particular religious corporation, association, or society, or if the curriculum of such school, college, university, or other educational institution or institution of learning is directed toward the propagation of a particular religion.\",\"start\":166}],\"id\":\"urn:rulespec:document-understanding:revision:9020b104005f654a3a8800f640f753fba1f47a203853a2bebccd8e55fc6c10d5\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"exemption\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:543b8007712edf5bc167c0ba9946f416add39c6e9ea0a27d9199f0ea20fdb02b\",\"modality\":\"not_required\",\"modality_quote\":\"shall not be an unlawful employment practice\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:273bfded618252516b44bd9d909e643c44ee7086be75238d330592fe7947ca66\",\"origin\":\"aiSuggested\",\"quote\":\"Notwithstanding any other provision of this subchapter, (1) it shall not be an unlawful employment practice for an employer to hire and employ employees, for an employment agency to classify, or refer for employment any individual, for a labor organization to classify its membership or to classify or refer for employment any individual, or for an employer, labor organization, or joint labor-management committee controlling apprenticeship or other training or retraining programs to admit or employ any individual in any such program, on the basis of his religion, sex, or national origin in those certain instances where religion, sex, or national origin is a bona fide occupational qualification reasonably necessary to the normal operation of that particular business or enterprise, and (2) it shall not be an unlawful employment practice for a school, college, university, or other educational institution or institution of learning to hire and employ employees of a particular religion if such school, college, university, or other educational institution or institution of learning is, in whole or in substantial part, owned, supported, controlled, or managed by a particular religion or by a particular religious corporation, association, or society, or if the curriculum of such school, college, university, or other educational institution or institution of learning is directed toward the propagation of a particular religion.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:9a592b8ea4a3c5c44e325d0f83d7b68b7a7e0c44d756f8bc0ef5eb3bbd3bec97\",\"scope_quotes\":[\"Notwithstanding any other provision of this subchapter, (1) it shall not be an unlawful employment practice for an employer to hire and employ employees, for an employment agency to classify, or refer for employment any individual, for a labor organization to classify its membership or to classify or refer for employment any individual, or for an employer, labor organization, or joint labor-management committee controlling apprenticeship or other training or retraining programs to admit or employ any individual in any such program, on the basis of his religion, sex, or national origin in those certain instances where religion, sex, or national origin is a bona fide occupational qualification reasonably necessary to the normal operation of that particular business or enterprise, and (2) it shall not be an unlawful employment practice for a school, college, university, or other educational institution or institution of learning to hire and employ employees of a particular religion if such school, college, university, or other educational institution or institution of learning is, in whole or in substantial part, owned, supported, controlled, or managed by a particular religion or by a particular religious corporation, association, or society, or if the curriculum of such school, college, university, or other educational institution or institution of learning is directed toward the propagation of a particular religion.\"],\"scope_text\":\"if such school, college, university, or other educational institution or institution of learning is, in whole or in substantial part, owned, supported, controlled, or managed by a particular religion or by a particular religious corporation, association, or society, or if the curriculum of such school, college, university, or other educational institution or institution of learning is directed toward the propagation of a particular religion\",\"section_id\":\"section-1\",\"start\":166,\"summary\":\"Notwithstanding any other provision of this subchapter, it shall not be an unlawful employment practice for a school, college, university, or other educational institution or institution of learning to hire and employ employees of a particular religion if such school, college, university, or other educational institution or institution of learning is, in whole or in substantial part, owned, supported, controlled, or managed by a particular religion or by a particular religious corporation, association, or society, or if the curriculum of such school, college, university, or other educational institution or institution of learning is directed toward the propagation of a particular religion.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

    {
      "@id": "urn:rulespec:document-understanding:assertion:7ba874304cfcb5dbd4114665672356a4b81c0fe9651f31fa2a5d9dce442fa4e8",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:a1a21c3b59d6623fdcaba484751182375d1ae409744e116db50dd0a762baef51",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:35f0515aaa701b15779d5ea90646d95138d5659d55213001a9ebf9a1f9cbe766",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:b40c04e45538cb335fd61f806922a49c12362c877c0515ff9008b465ca611a81",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"actor\":\"The head of the agency\",\"alternative_quotes\":[\"(1) written notice of the type and amount of the claim, the intention of the head of the agency to collect the claim by administrative offset, and an explanation of the rights of the debtor under this section;\",\"(2) an opportunity to inspect and copy the records of the agency related to the claim;\",\"(3) an opportunity for a review within the agency of the decision of the agency related to the claim; and\",\"(4) an opportunity to make a written agreement with the head of the agency to repay the amount of the claim.\"],\"choice_text\":\"All four items are required before collecting by administrative offset: (1) written notice including type, amount, intention to collect, and explanation of rights; (2) opportunity to inspect and copy records; (3) opportunity for review of the decision within the agency; and (4) opportunity to make a written repayment agreement.\",\"kind\":\"requirement\",\"logic_text\":\"(a) After trying to collect a claim from a person under section 3711(a) of this title, the head of an executive, judicial, or legislative agency may collect the claim by administrative offset. The head of the agency may collect by administrative offset only after giving the debtor—\\n\\n(1) written notice of the type and amount of the claim, the intention of the head of the agency to collect the claim by administrative offset, and an explanation of the rights of the debtor under this section;\\n\\n(2) an opportunity to inspect and copy the records of the agency related to the claim;\\n\\n(3) an opportunity for a review within the agency of the decision of the agency related to the claim; and\\n\\n(4) an opportunity to make a written agreement with the head of the agency to repay the amount of the claim.\",\"modality\":\"must\",\"summary\":\"The head of the agency may collect by administrative offset only after giving the debtor: (1) written notice of the type and amount of the claim, the intention of the head of the agency to collect the claim by administrative offset, and an explanation of the rights of the debtor under this section; (2) an opportunity to inspect and copy the records of the agency related to the claim; (3) an opportunity for a review within the agency of the decision of the agency related to the claim; and (4) an opportunity to make a written agreement with the head of the agency to repay the amount of the claim.\"}",
        "@type": "xsd:string"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

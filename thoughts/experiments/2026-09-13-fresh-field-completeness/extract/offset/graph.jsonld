      "dcterms:description": "{\"action\":\"\",\"actor\":\"the head of an executive, judicial, or legislative agency\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:71cf5d7d5cf1a0a856211f2efc6d52e143c315a646abbe248a9b9db61524a384\",\"urn:rulespec:document-understanding:assertion:9bcafe5136c532c41c445f4f9b7f915a669decd4eed2156a19e8361260ef2993\",\"urn:rulespec:document-understanding:assertion:2384818393359b811df1ac788b2872acea2f832b58ab5e9c94adbb68ac9d7dcb\",\"urn:rulespec:document-understanding:assertion:72abfb36ae7ffa7d1a508c1198065918ca9d5a1ac3aa033138eb416b73893e24\",\"urn:rulespec:document-understanding:assertion:17ab1a923f654cc3f36d8c4a943a267e42543ce48385db29b69370e0757a2c9a\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":282,\"evidence\":[{\"end\":282,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A41748376b36a34f5c4dccd5eb6c41ec287df67929051d8aa16327ed2e4590736:0:282:sha256-de79d8d280175330b8fbe97b4920e408da018b99552a7eaf646a7b7e01cdc7d8\",\"quote\":\"(a) After trying to collect a claim from a person under section 3711(a) of this title, the head of an executive, judicial, or legislative agency may collect the claim by administrative offset. The head of the agency may collect by administrative offset only after giving the debtor—\",\"start\":0},{\"end\":144,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A41748376b36a34f5c4dccd5eb6c41ec287df67929051d8aa16327ed2e4590736:87:144:sha256-bea0cd8029a40ef6f23da68eaecd24f1fbcea4f7e5be068d1d0f82770f84e1c6\",\"quote\":\"the head of an executive, judicial, or legislative agency\",\"start\":87},{\"end\":282,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A41748376b3
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:choice_text",
      "rkaf:assertsValue": {
        "@value": "All four items are required before collecting by administrative offset: (1) written notice including type, amount, intention to collect, and explanation of rights; (2) opportunity to inspect and copy records; (3) opportunity for review of the decision within the agency; and (4) opportunity to make a written repayment agreement.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

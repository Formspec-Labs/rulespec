    {
      "@id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A41748376b36a34f5c4dccd5eb6c41ec287df67929051d8aa16327ed2e4590736:284:798:sha256-7322d4d22c306e4ee997e454d8b76cc732c7829ecc04d67b1f2e0d50f650c6a9",
      "@type": "rkaf:SourceFragment",
      "oa:hasSource": "urn:rulespec:document-understanding:document:41748376b36a34f5c4dccd5eb6c41ec287df67929051d8aa16327ed2e4590736",
      "rkaf:fragmentIdentityScheme": "rkaf:carrier-local-fragment",
      "rkaf:sourceArtifactDigest": "sha256:41748376b36a34f5c4dccd5eb6c41ec287df67929051d8aa16327ed2e4590736",
      "rkaf:fragmentContentDigest": "sha256:7322d4d22c306e4ee997e454d8b76cc732c7829ecc04d67b1f2e0d50f650c6a9",
      "rkaf:selectorKind": [
        "oa:TextQuoteSelector",
        "oa:TextPositionSelector"
      ],
      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "(1) written notice of the type and amount of the claim, the intention of the head of the agency to collect the claim by administrative offset, and an explanation of the rights of the debtor under this section;\n\n(2) an opportunity to inspect and copy the records of the agency related to the claim;\n\n(3) an opportunity for a review within the agency of the decision of the agency related to the claim; and\n\n(4) an opportunity to make a written agreement with the head of the agency to repay the amount of the claim."
        },
        {
          "@type": "oa:TextPositionSelector",
          "oa:start": 284,
          "oa:end": 798,
          "rkaf:coordinateSystem": "rkaf:unicode-codepoint"
        }

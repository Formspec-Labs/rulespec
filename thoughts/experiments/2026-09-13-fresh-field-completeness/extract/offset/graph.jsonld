        "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A41748376b36a34f5c4dccd5eb6c41ec287df67929051d8aa16327ed2e4590736:583:688:sha256-4b3f5ee934eba0752ad7a51d0a0fda61907a2433f16f5fe46f4f2b3d223a5a5c",

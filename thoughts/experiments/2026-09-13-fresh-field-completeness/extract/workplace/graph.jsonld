\"start\":251},{\"end\":99,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A39d03c54ec0f1b3a07c59ee633503737d7714c40682c31b89963523b898d1745:0:99:sha256-38b164e3abe87d7e607cd6ed0e32ac60d88a181cd3748a8e536c3051340cb5af\",\"quote\":\"(a) Authority of Secretary to enter, inspect, and investigate places of employment; time and manner\",\"start\":0},{\"end\":265,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A39d03c54ec0f1b3a07c59ee633503737d7714c40682c31b89963523b898d1745:100:265:sha256-9b97900227a6f99fc0d87b74d84994a9c5f9281ae6891738746552a6aaf664d9\",\"quote\":\"In order to carry out the purposes of this chapter, the Secretary, upon presenting appropriate credentials to the owner, operator, or agent in charge, is authorized—\",\"start\":100}],\"id\":\"urn:rulespec:document-understanding:revision:0aa54141dffad2fe8cee197be9448242e7609dc0220bb3719391fa847e330e95\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"authority\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:0913df67ada6976e416e40c892d6bacf1997a81f334aa7d137b3d8aa21c33d48\",\"modality\":\"may\",\"modality_quote\":\"is authorized\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:2356f61e3b6b641f1b9e3c88106d7f37d82be400b7e2a539fd18ed6fc11660c6\",\"origin\":\"aiSuggested\",\"quote\":\"(1) to enter without delay and at reasonable times any factory, plant, establishment, construction site, or other area, workplace or environment where work is performed by an employee of an employer; and\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:7bf0bff98438483c3df17ac0fae405c7409a6a2c0c1bbcc2076eebfc2e8a7add\",\"scope_quotes\":[\"(a) Authority of Secretary to enter, inspect, and investigate places of employment; time and manner In order to carry out the purposes of this chapter, the Secretary, upon presenting appropriate credentials to the owner, operator, or agent in charge, is authorized—\"],\"scope_text\":\"In order to carry out the purposes of this chapter, upon presenting appropriate credentials to the owner, operator, or agent in charge\",\"section_id\":\"section-1\",\"start\":267,\"summary\":\"In order to carry out the purposes of this chapter, the Secretary, upon presenting appropriate credentials to the owner, operator, or agent in charge, is authorized to enter without delay and at reasonable times any factory, plant, establishment, construction site, or other area, workplace or environment where work is performed by an employee of an employer.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

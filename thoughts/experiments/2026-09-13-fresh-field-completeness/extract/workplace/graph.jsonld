      "dcterms:description": "{\"action\":\"\",\"actor\":\"the Secretary\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:7780ca8d5b22cdd2c260b82dd749a0df790fb4483cae8db02e5fd3ffe4dd6fc0\",\"urn:rulespec:document-understanding:assertion:e1d3e7af8cd83c7d48f70c2277add4c467ea48e2366a6f825913828baffe2b00\",\"urn:rulespec:document-understanding:assertion:ed0dd3f7450e4685f978d878fecfd8308e2f30dc8d451e32ff5cb254aefcf7b7\",\"urn:rulespec:document-understanding:assertion:2557123a4d3d136e74b1b3ba0c4cb447dd3aa2e6d51aa311eb4f1b7de0c1cc56\",\"urn:rulespec:document-understanding:assertion:2a5a25b4195666e17649310483454878ba2fba6f3dd7abe52502607f7cbeaa94\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":836,\"evidence\":[{\"end\":836,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A39d03c54ec0f1b3a07c59ee633503737d7714c40682c31b89963523b898d1745:472:836:sha256-c9439c76962b0f45c2d61d1d0e3a4222229bdd6939b6efe5006206f2f1754d99\",\"quote\":\"(2) to inspect and investigate during regular working hours and at other reasonable times, and within reasonable limits and in a reasonable manner, any such place of employment and all pertinent conditions, structures, machines, apparatus, devices, equipment, and materials therein, and to question privately any such employer, owner, operator, agent, or employee.\",\"start\":472},{\"end\":165,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A39d03c54ec0f1b3a07c59ee633503737d7714c40682c31b89963523b898d1745:152:165:sha256-67afe9d5c4310238267da793c265a616f9e90d554f2458a8065b7bb971d853b5\",\"quote\":\"the Secretary\",\"start\":152},{\"end\":264,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A39d03c54ec0f1b3a07c59ee633503737d7714c40682c31b89963523b898d1745:251:264:sha256-d94ee30ad09952c2291cc4b9c90ea8913bd5aa95378aeed99dffff5a5cff0b49\",\"quote\":\"is authorized\",\"start\":251},{\"end\":99,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A39d03c54ec0f1b3a07c59ee633503737d7714c40682c31b89963523b898d1745:0:99:sha256-38b164e3abe87d7e607cd6ed0e32ac60d88a181cd3748a8e536c3051340cb5af\",\"quote\":\"(a) Authority of Secretary to enter, inspect, and investigate places of employment; time and manner\",\"start\":0},{\"end\":265,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A39d03c54ec0f1b3a07c59ee633503737d7714c40682c31b89963523b898d1745:100:265:sha256-9b97900227a6f99fc0d87b74d84994a9c5f9281ae6891738746552a6aaf664d9\",\"quote\":\"In order to carry out the purposes of this chapter, the Secretary, upon presenting appropriate credentials to the owner, operator, or agent in charge, is authorized—\",\"start\":100}],\"id\":\"urn:rulespec:document-understanding:revision:55741cfee203b6ea47b10d15980d83a421d71d568b3db5a3304c7d62b54aac40\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"authority\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:2a5a25b4195666e17649310483454878ba2fba6f3dd7abe52502607f7cbeaa94\",\"modality\":\"may\",\"modality_quote\":\"is authorized\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:18a69fb3f4e1ba3c347906f4ad505c7e270561f8d7a1d0e33f07b7f204d60c38\",\"origin\":\"aiSuggested\",\"quote\":\"(2) to inspect and investigate during regular working hours and at other reasonable times, and within reasonable limits and in a reasonable manner, any such place of employment and all pertinent conditions, structures, machines, apparatus, devices, equipment, and materials therein, and to question privately any such employer, owner, operator, agent, or employee.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:6d9f7c3725f5dcf63c277c1186fa42475c93b9a865d845e5c20e38b73986e7fa\",\"scope_quotes\":[\"(a) Authority of Secretary to enter, inspect, and investigate places of employment; time and manner In order to carry out the purposes of this chapter, the Secretary, upon presenting appropriate credentials to the owner, operator, or agent in charge, is authorized—\"],\"scope_text\":\"In order to carry out the purposes of this chapter, upon presenting appropriate credentials to the owner, operator, or agent in charge\",\"section_id\":\"section-1\",\"start\":472,\"summary\":\"In order to carry out the purposes of this chapter, the Secretary, upon presenting appropriate credentials to the owner, operator, or agent in charge, is authorized to question privately any such employer, owner, operator, agent, or employee.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

      "dcterms:description": "{\"action\":\"\",\"actor\":\"the Secretary\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:32db475415b09ec0b58533416bb60b1fa26b83439f5a2b918ae029086759dfb0\",\"urn:rulespec:document-understanding:assertion:a37ab2b1838af9c12455eb178db6b3bd9c7a46f96a1f29ad61452bdb34075b14\",\"urn:rulespec:document-understanding:assertion:ed25c874ee96f3a0ecc01c7c653b4c283f7ed49b27256d065e4a655b50a6bf49\",\"urn:rulespec:document-understanding:assertion:74dbdf11ea3f30d96858cadc184dbab403d1f8606aa23f5e2658d136a860cb72\",\"urn:rulespec:document-understanding:assertion:bb49ab1af5a2ff3c2d4cc4b1f7b215288a47eb1c12c27ccd81c2f78352650bd0\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":836,\"evidence\":[{\"end\":836,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A39d03c54ec0f1b3a07c59ee633503737d7714c40682c31b89963523b898d1745:472:836:sha256-c9439c76962b0f45c2d61d1d0e3a4222229bdd6939b6efe5006206f2f1754d99\",\"quote\":\"(2) to inspect and investigate during regular working hours and at other reasonable times, and within reasonable limits and in a reasonable manner, any such place of employment and all pertinent conditions, structures, machines, apparatus, devices, equipment, and materials therein, and to question privately any such employer, owner, operator, agent, or employee.\",\"start\":472},{\"end\":165,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A39d03c54ec0f1b3a07c59ee633503737d7714c40682c31b89963523b898d1745:152:165:sha256-67afe9d5c4310238267da793c265a616f9e90d554f2458a8065b7bb971d853b5\",\"quote\":\"the Secretary\",\"start\":152},{\"end\":264,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A39d03c54ec0f1b3a07c59ee633503737d7714c40682c31b89963523b898d1745:251:264:sha256-d94ee30ad09952c2291cc4b9c90ea8913bd5aa95378aeed99dffff5a5cff0b49\",\"quote\":\"is authorized\",\"start\":251},{\"end\":99,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A39d03c54ec0f1b3a07c59ee633503737d7714c40682c31b89963523b898d1745:0:99:sha256-38b164e3abe87d7e607cd6ed0e32ac60d88a181cd3748a8e536c3051340cb5af\",\"quote\":\"(a) Authority of Secretary to enter, inspect, and investigate places of employment; time and manner\",\"start\":0},{\"end\":265,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A39d03c54ec0f1b3a07c59ee633503737d7714c40682c31b89963523b898d1745:100:265:sha256-9b97900227a6f99fc0d87b74d84994a9c5f9281ae6891738746552a6aaf664d9\",\"quote\":\"In order to carry out the purposes of this chapter, the Secretary, upon presenting appropriate credentials to the owner, operator, or agent in charge, is authorized—\",\"start\":100}],\"id\":\"urn:rulespec:document-understanding:revision:0029145d4c95322dacdbd57d207bf7a8bc83d53d5652359f3f3117f55a055c29\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"authority\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:bb49ab1af5a2ff3c2d4cc4b1f7b215288a47eb1c12c27ccd81c2f78352650bd0\",\"modality\":\"may\",\"modality_quote\":\"is authorized\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:7ec8eb1aab6052c5dc6f3c8e07c85a05e955529ceb3b87d9957d9cca29cd0ea1\",\"origin\":\"aiSuggested\",\"quote\":\"(2) to inspect and investigate during regular working hours and at other reasonable times, and within reasonable limits and in a reasonable manner, any such place of employment and all pertinent conditions, structures, machines, apparatus, devices, equipment, and materials therein, and to question privately any such employer, owner, operator, agent, or employee.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:742a98fc51e4c4f06ae16be3f5febf65e72842db0d0332c7d10edc9fe388ccf2\",\"scope_quotes\":[\"(a) Authority of Secretary to enter, inspect, and investigate places of employment; time and manner In order to carry out the purposes of this chapter, the Secretary, upon presenting appropriate credentials to the owner, operator, or agent in charge, is authorized—\"],\"scope_text\":\"In order to carry out the purposes of this chapter, upon presenting appropriate credentials to the owner, operator, or agent in charge\",\"section_id\":\"section-1\",\"start\":472,\"summary\":\"In order to carry out the purposes of this chapter, the Secretary, upon presenting appropriate credentials to the owner, operator, or agent in charge, is authorized to inspect and investigate during regular working hours and at other reasonable times, and within reasonable limits and in a reasonable manner, any such place of employment and all pertinent conditions, structures, machines, apparatus, devices, equipment, and materials therein.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

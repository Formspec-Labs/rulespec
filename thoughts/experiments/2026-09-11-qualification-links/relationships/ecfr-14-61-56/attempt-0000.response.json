            "text": "{\n  \"proposals\": [\n    {\n      \"rationale\": \"Paragraph (d)(1) explicitly exempts persons who passed a pilot proficiency check or practical test from the flight review required under paragraph (c) to act as pilot in command.\",\n      \"operation\": \"link\",\n      \"target\": \"C0004\",\n      \"qualifies\": [\"C0003\"]\n    },\n    {\n      \"rationale\": \"Paragraph (d)(2) explicitly exempts persons who passed specified practical tests from the flight review required under paragraph (c) to act as pilot in command.\",\n      \"operation\": \"link\",\n      \"target\": \"C0005\",\n      \"qualifies\": [\"C0003\"]\n    },\n    {\n      \"rationale\": \"Paragraph (e) explicitly exempts persons who satisfactorily accomplished one or more phases of an FAA-sponsored pilot proficiency program from the flight review required under paragraph (c) to act as pilot in command.\",\n      \"operation\": \"link\",\n      \"target\": \"C0006\",\n      \"qualifies\": [\"C0003\"]\n    },\n    {\n      \"rationale\": \"Paragraph (f) explicitly exempts flight instructors meeting recent experience or refresher requirements from the 1 hour of ground training baseline required under paragraph (a).\",\n      \"operation\": \"link\",\n      \"target\": \"C0007\",\n      \"qualifies\": [\"C0000\"]\n    },\n    {\n      \"rationale\": \"Paragraph (g) explicitly exempts student pilots undergoing training for a certificate with a current solo endorsement from the flight review required under paragraph (c) to act as pilot in command.\",\n      \"operation\": \"link\",\n      \"target\": \"C0008\",\n      \"qualifies\": [\"C0003\"]\n    }\n  ],\n  \"observations\": []\n}",

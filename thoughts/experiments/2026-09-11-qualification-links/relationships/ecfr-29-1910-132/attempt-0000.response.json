            "text": "{\n  \"proposals\": [\n    {\n      \"rationale\": \"Paragraph (h)(2) provides an exemption from employer payment for non-specialty safety-toe protective footwear and non-specialty prescription safety eyewear, qualifying both the general PPE payment duty in paragraph (h)(1) (C0015) and the prohibition against requiring employee payment in paragraph (h)(6) (C0023).\",\n      \"operation\": \"link\",\n      \"target\": \"C0016\",\n      \"qualifies\": [\"C0015\", \"C0023\"]\n    },\n    {\n      \"rationale\": \"Paragraph (h)(3) provides an exemption from employer reimbursement for shoes or boots with built-in metatarsal protection, qualifying both the general PPE payment duty in paragraph (h)(1) (C0015) and the prohibition against requiring employee payment in paragraph (h)(6) (C0023).\",\n      \"operation\": \"link\",\n      \"target\": \"C0017\",\n      \"qualifies\": [\"C0015\", \"C0023\"]\n    },\n    {\n      \"rationale\": \"Paragraph (h)(4)(i) provides an exemption from employer payment for logging boots required by 29 CFR 1910.266(d)(1)(v), qualifying both the general PPE payment duty in paragraph (h)(1) (C0015) and the prohibition against requiring employee payment in paragraph (h)(6) (C0023).\",\n      \"operation\": \"link\",\n      \"target\": \"C0018\",\n      \"qualifies\": [\"C0015\", \"C0023\"]\n    },\n    {\n      \"rationale\": \"Paragraph (h)(4)(ii) provides an exemption from employer payment for everyday clothing, qualifying both the general PPE payment duty in paragraph (h)(1) (C0015) and the prohibition against requiring employee payment in paragraph (h)(6) (C0023).\",\n      \"operation\": \"link\",\n      \"target\": \"C0019\",\n      \"qualifies\": [\"C0015\", \"C0023\"]\n    },\n    {\n      \"rationale\": \"Paragraph (h)(4)(iii) provides an exemption from employer payment for ordinary clothing, skin creams, or items used solely for protection from weather, qualifying both the general PPE payment duty in paragraph (h)(1) (C0015) and the prohibition against requiring employee payment in paragraph (h)(6) (C0023).\",\n      \"operation\": \"link\",\n      \"target\": \"C0020\",\n      \"qualifies\": [\"C0015\", \"C0023\"]\n    },\n    {\n      \"rationale\": \"Paragraph (h)(5) contains an explicit exception relieving the employer of the obligation to pay for replacement PPE when the employee has lost or intentionally damaged the PPE, qualifying the baseline replacement requirement in C0021.\",\n      \"operation\": \"add\",\n      \"target\": \"\",\n      \"qualifies\": [\"C0021\"],\n      \"quote\": \"except when the employee has lost or intentionally damaged the PPE.\",\n      \"fields\": {\n        \"concepts\": [],\n        \"claimants\": [],\n        \"typed_values\": [],\n        \"effective_periods\": [],\n        \"defined_terms\": [],\n        \"term_refs\": [],\n        \"kind\": \"exception\",\n        \"scope_quotes\": [\n          \"(5) The employer must pay for replacement PPE, except when the employee has lost or intentionally damaged the PPE.\"\n        ],\n        \"scope_text\": \"when the employee has lost or intentionally damaged the PPE\",\n        \"context_quotes\": [],\n        \"modality_quote\": \"\",\n        \"modality\": \"not_stated\",\n        \"alternative_quotes\": [],\n        \"choice_quote\": \"\",\n        \"choice_text\": \"\",\n        \"logic_text\": \"except when the employee has lost or intentionally damaged the PPE\",\n        \"actor_quote\": \"the employee\",\n        \"actor\": \"the employee\",\n        \"action_quote\": \"has lost or intentionally damaged\",\n        \"action\": \"has lost or intentionally damaged\",\n        \"object_quote\": \"the PPE\",\n        \"object\": \"the PPE\",\n        \"jurisdiction_quote\": \"\",\n        \"jurisdiction\": \"\",\n        \"relation\": \"exception\",\n        \"references\": [],\n        \"summary\": \"The employer is excepted from the obligation to pay for replacement PPE when the employee has lost or intentionally damaged the PPE.\"\n      }\n    }\n  ],\n  \"observations\": [\n    {\n      \"quote\": \"When the provisions of another OSHA standard specify whether or not the employer must pay for specific equipment, the payment provisions of that standard shall prevail.\",\n      \"rationale\": \"The note to § 1910.132(h) specifies a rule of priority between this section and other OSHA standards, which is already represented in baseline claim C0025.\",\n      \"disposition\": \"already_represented\"\n    },\n    {\n      \"quote\": \"(g) Paragraphs (d) and (f) of this section apply only to §§ 1910.133, 1910.135, 1910.136, 1910.138, and 1910.140. Paragraphs (d) and (f) of this section do not apply to §§ 1910.134 and 1910.137.\",\n      \"rationale\": \"The applicability boundaries established in paragraph (g) for paragraphs (d) and (f) are already represented as a distinct standalone rule in C0014 and incorporated into the meaning of relevant rules.\",\n      \"disposition\": \"already_represented\"\n    }\n  ]\n}",

            "text": "{\n  \"units\": [\n    {\n      \"quote_ref\": \"F000\",\n      \"scope_refs\": [],\n      \"kind\": \"background\",\n      \"meaning\": \"Section title for section 9915, providing document structure and editorial context with no independent substantive requirement or legal command.\"\n    },\n    {\n      \"quote_ref\": \"F002\",\n      \"scope_refs\": [\"F001\"],\n      \"kind\": \"requirement\",\n      \"meaning\": \"If the State determines, on the basis of a final decision in a review under section 9914, that an eligible entity fails to comply with the terms of an agreement or the State plan to provide services under this chapter, or fails to meet appropriate standards, goals, and other requirements established by the State (including performance objectives), the State must inform the entity of the deficiency to be corrected.\"\n    },\n    {\n      \"quote_ref\": \"F003\",\n      \"scope_refs\": [\"F001\"],\n      \"kind\": \"requirement\",\n      \"meaning\": \"If the State determines, on the basis of a final decision in a review under section 9914, that an eligible entity fails to comply with the terms of an agreement or the State plan to provide services under this chapter, or fails to meet appropriate standards, goals, and other requirements established by the State (including performance objectives), the State must require the entity to correct the deficiency.\"\n    },\n    {\n      \"quote_ref\": \"F005\",\n      \"scope_refs\": [\"F001\"],\n      \"kind\": \"alternative\",\n      \"meaning\": \"If the State determines under subsection (a) that an eligible entity has a deficiency, the State must, as one alternative, offer training and technical assistance if appropriate to help correct the deficiency, and prepare and submit to the Secretary a report describing the training and technical assistance offered.\"\n    },\n    {\n      \"quote_ref\": \"F006\",\n      \"scope_refs\": [\"F001\"],\n      \"kind\": \"alternative\",\n      \"meaning\": \"If the State determines under subsection (a) that an eligible entity has a deficiency, the State must, as an alternative if it determines that training and technical assistance are not appropriate, prepare and submit to the Secretary a report stating the reasons for that determination.\"\n    },\n    {\n      \"quote_ref\": \"F008\",\n      \"scope_refs\": [\"F001\"],\n      \"kind\": \"permission\",\n      \"meaning\": \"If the State determines under subsection (a) that an eligible entity has a deficiency, the State is authorized, at its discretion (taking into account the seriousness of the deficiency and the time reasonably required to correct it), to allow the entity to develop and implement, within 60 days after being informed of the deficiency, a quality improvement plan to correct the deficiency within a reasonable period of time as determined by the State.\"\n    },\n    {\n      \"quote_ref\": \"F009\",\n      \"scope_refs\": [\"F001\", \"F008\"],\n      \"kind\": \"requirement\",\n      \"meaning\": \"Not later than 30 days after receiving a proposed quality improvement plan from an eligible entity pursuant to subparagraph (A), the State must either approve the proposed plan or specify the reasons why it cannot be approved.\"\n    },\n    {\n      \"quote_ref\": \"F011\",\n      \"scope_refs\": [\"F001\"],\n      \"kind\": \"requirement\",\n      \"meaning\": \"If the State determines under subsection (a) that an eligible entity has a deficiency, the State must, after providing adequate notice and an opportunity for a hearing, initiate proceedings to terminate the designation of or reduce the funding under this chapter of the eligible entity unless the entity corrects the deficiency.\"\n    },\n    {\n      \"quote_ref\": \"F014\",\n      \"scope_refs\": [],\n      \"kind\": \"requirement\",\n      \"meaning\": \"A State determination to terminate the designation or reduce the funding of an eligible entity is reviewable by the Secretary, and the Secretary must review such a determination upon request.\"\n    },\n    {\n      \"quote_ref\": \"F014\",\n      \"scope_refs\": [],\n      \"kind\": \"requirement\",\n      \"meaning\": \"The Secretary's review of a determination to terminate designation or reduce funding must be completed not later than 90 days after the Secretary receives from the State all necessary documentation relating to the determination.\"\n    },\n    {\n      \"quote_ref\": \"F014\",\n      \"scope_refs\": [],\n      \"kind\": \"statement\",\n      \"meaning\": \"If the Secretary's review is not completed within 90 days after receiving all necessary documentation from the State, the determination of the State becomes final at the end of the 90th day.\"\n    },\n    {\n      \"quote_ref\": \"F017\",\n      \"scope_refs\": [],\n      \"kind\": \"permission\",\n      \"meaning\": \"Whenever a State violates the assurances contained in section 9908(b)(8) of this title and terminates or reduces the funding of an eligible entity prior to the completion of the State hearing described in that section and the Secretary’s review as required in subsection (b), the Secretary is authorized to provide financial assistance under this chapter to the affected eligible entity until the violation is corrected.\"\n    },\n    {\n      \"quote_ref\": \"F017\",\n      \"scope_refs\": [],\n      \"kind\": \"requirement\",\n      \"meaning\": \"Whenever the Secretary provides direct assistance under subsection (c) because a State prematurely terminated or reduced funding in violation of section 9908(b)(8) assurances, the State's grant or allotment under section 9905 or 9906 for the earliest appropriate fiscal year must be reduced by an amount equal to the funds provided under subsection (c) to the eligible entity.\"\n    },\n    {\n      \"quote_ref\": \"F018\",\n      \"scope_refs\": [],\n      \"kind\": \"background\",\n      \"meaning\": \"Statutory history and enactment citation for section 9915, containing historical tracing details rather than substantive legal directives or operational rules.\"\n    }\n  ]\n}",

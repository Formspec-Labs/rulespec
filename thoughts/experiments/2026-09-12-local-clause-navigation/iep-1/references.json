      "value": "/us/usc/t20/s1414/d/1/C/i",
      "start": 5574,
      "end": 5948,
      "xml_evidence_refs": [
        "urn:rulespec:document-understanding:xml-fragment:a7bd090faa91cdafb3f777fc99640c40fe555ce764c267fe9b853d9ee6caac44"
      ],
      "evidence": [
        {
          "field": "reference_target",
          "quote": "(i) Attendance not necessary",
          "start": 5574,
          "end": 5602,
          "fragment_id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Adf83a189da3bcf757923be2b59f664531586049d05e4de102f73c6e815be2602:5574:5602:sha256-946514ae879423cc5a218fef310969ef96ca4d04f83b403282b5bac71f606a65"
        },
        {
          "field": "reference_target",
          "quote": "A member of the IEP Team shall not be required to attend an IEP meeting, in whole or in part, if the parent of a child with a disability and the local educational agency agree that the attendance of such member is not necessary because the member’s area of the curriculum or related services is not being modified or discussed in the meeting.\n\n",
          "start": 5604,
          "end": 5948,
          "fragment_id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Adf83a189da3bcf757923be2b59f664531586049d05e4de102f73c6e815be2602:5604:5948:sha256-5b3f7e7583463d08e0d53de352cb2c71236dfa18ba9ee992afbb39af4480fd3a"
        }
      ],
      "text_status": "available"
    },
    "urn:rulespec:document-understanding:reference-target:d8ec00ba3ea45de4432a15406295f88028ca20b4ae1bcd9a0af2e56dcfb5dcbe": {
      "id": "urn:rulespec:document-understanding:reference-target:d8ec00ba3ea45de4432a15406295f88028ca20b4ae1bcd9a0af2e56dcfb5dcbe",
      "value": "/us/usc/t20/s1414/d/1/C/ii",
      "start": 5949,
      "end": 6383,
      "xml_evidence_refs": [
        "urn:rulespec:document-understanding:xml-fragment:d8ec00ba3ea45de4432a15406295f88028ca20b4ae1bcd9a0af2e56dcfb5dcbe"
      ],
      "evidence": [
        {
          "field": "reference_target",
          "quote": "(ii) Excusal",
          "start": 5949,
          "end": 5961,
          "fragment_id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Adf83a189da3bcf757923be2b59f664531586049d05e4de102f73c6e815be2602:5949:5961:sha256-4e9cd596664ada9a5511b0268819d845b5979e1d93bda42db56079c479d85862"
        },
        {
          "field": "reference_target",
          "quote": "A member of the IEP Team may be excused from attending an IEP meeting, in whole or in part, when the meeting involves a modification to or discussion of the member’s area of the curriculum or related services, if—",
          "start": 5962,
          "end": 6175,
          "fragment_id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Adf83a189da3bcf757923be2b59f664531586049d05e4de102f73c6e815be2602:5962:6175:sha256-d5e0187a89d6636f0dfcb65efe58c4e3e2f7d6553147acdc63b8cffb2ef8717e"
        },
        {
          "field": "reference_target",
          "quote": "(I) the parent and the local educational agency consent to the excusal; and\n\n(II) the member submits, in writing to the parent and the IEP Team, input into the development of the IEP prior to the meeting.\n\n",
          "start": 6177,
          "end": 6383,
          "fragment_id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Adf83a189da3bcf757923be2b59f664531586049d05e4de102f73c6e815be2602:6177:6383:sha256-93343eba4a5ca380a411a2ebad2b59259d674943708f50a8dffcb18cb2c3c10d"
        }
      ],
      "text_status": "available"
    }
  },

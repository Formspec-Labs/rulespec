  "records": [
    {
      "id": "urn:rulespec:document-understanding:passage:5fa7c748c18f10c94f3eea5c74320447ace42943e9acad13a42aa843d0009731",
      "source": "urn:rulespec:document-understanding:document:fc425889c1301250a736652ec4e95ee500c1e2dd89c10726cfc4ed5bfc8a304d",
      "text": "Each building or part of a building that is constructed or altered by, on behalf of, or for the use of the agency shall be designed, constructed, or altered so as to be readily accessible to and usable by handicapped persons. The definitions, requirements, and standards of the Architectural Barriers Act (42 U.S.C. 4151-4157), as established in 41 CFR 101-19.600 to 101-19.607, apply to buildings covered by this section.\n\n",
      "claim_ids": [],
      "evidence_refs": [
        {
          "id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Afc425889c1301250a736652ec4e95ee500c1e2dd89c10726cfc4ed5bfc8a304d:0:424:sha256-1d69a4a09bbb2bb53682232bec225c8dc216b3b3837ffa9f33b611116580901f",

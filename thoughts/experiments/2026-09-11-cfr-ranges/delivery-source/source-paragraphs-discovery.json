      "text": "For information on records and standard and optional forms, see FMR parts 102-193 and 102-194 (41 CFR parts 102-193 and 102-194).\n\n",
      "claim_ids": [],
      "evidence_refs": [
        {
          "id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Afc425889c1301250a736652ec4e95ee500c1e2dd89c10726cfc4ed5bfc8a304d:442:573:sha256-a8487c72c13d4db5dd07eb38797c3d745936dada4a3e1ca7faa99b14cdebaadc",

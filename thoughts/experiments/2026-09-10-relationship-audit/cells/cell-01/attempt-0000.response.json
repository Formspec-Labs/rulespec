            "text": "{\n  \"claim_judgments\": [\n    {\n      \"claim_id\": \"C0000\",\n      \"unit_ids\": [\"U0011\"],\n      \"source_refs\": [\"F015\"],\n      \"rationale\": \"C0000 accurately conveys the statutory requirement under 29 CFR 1910.157(d)(2) that employers distribute portable fire extinguishers for use on Class A fires so that employee travel distance to any extinguisher is 75 feet (22.9 m) or less.\",\n      \"dimensions\": {\n        \"summary\": \"correct\",\n        \"actor\": \"correct\",\n        \"support\": \"correct\",\n        \"scope\": \"correct\",\n        \"links\": \"correct\",\n        \"boundary\": \"correct\",\n        \"modality\": \"correct\",\n        \"action\": \"correct\",\n        \"object\": \"correct\",\n        \"alternatives\": \"correct\",\n        \"thresholds\": \"correct\",\n        \"concepts\": \"correct\",\n        \"source_attribution\": \"correct\",\n        \"effectivity\": \"correct\"\n      }\n    },\n    {\n      \"claim_id\": \"C0001\",\n      \"unit_ids\": [\"U0008\"],\n      \"source_refs\": [\"F002\", \"F004:F005\", \"F011\"],\n      \"rationale\": \"C0001 incorporates relevant background scopes from paragraphs (a) and (b)(1), but omits the explicit boundary exception 'except during use' from paragraph (c)(4). By stating that extinguishers must be kept in designated places at all times without exception, it creates an overbroad and legally inaccurate duty that would prohibit removing extinguishers for actual fire fighting.\",\n      \"dimensions\": {\n        \"summary\": \"error\",\n        \"actor\": \"correct\",\n        \"support\": \"correct\",\n        \"scope\": \"error\",\n        \"links\": \"correct\",\n        \"boundary\": \"error\",\n        \"modality\": \"correct\",\n        \"action\": \"correct\",\n        \"object\": \"correct\",\n        \"alternatives\": \"correct\",\n        \"thresholds\": \"correct\",\n        \"concepts\": \"correct\",\n        \"source_attribution\": \"correct\",\n        \"effectivity\": \"correct\"\n      }\n    },\n    {\n      \"claim_id\": \"C0002\",\n      \"unit_ids\": [\"U0004\"],\n      \"source_refs\": [\"F006\"],\n      \"rationale\": \"C0002 faithfully reproduces the exemption in 29 CFR 1910.157(b)(2), correctly capturing all qualifying conditions concerning the emergency action plan, authorized users, immediate evacuation of other employees, and the resulting exemption from paragraph (d) distribution requirements.\",\n      \"dimensions\": {\n        \"summary\": \"correct\",\n        \"actor\": \"correct\",\n        \"support\": \"correct\",\n        \"scope\": \"correct\",\n        \"links\": \"correct\",\n        \"boundary\": \"correct\",\n        \"modality\": \"correct\",\n        \"action\": \"correct\",\n        \"object\": \"correct\",\n        \"alternatives\": \"correct\",\n        \"thresholds\": \"correct\",\n        \"concepts\": \"correct\",\n        \"source_attribution\": \"correct\",\n        \"effectivity\": \"correct\"\n      }\n    },\n    {\n      \"claim_id\": \"C0003\",\n      \"unit_ids\": [\"U0001\"],\n      \"source_refs\": [\"F002\"],\n      \"rationale\": \"C0003 faithfully captures the exception in 29 CFR 1910.157(a) specifying that paragraph (d) does not apply to extinguishers provided for employee use on the outside of workplace buildings or structures.\",\n      \"dimensions\": {\n        \"summary\": \"correct\",\n        \"actor\": \"not_applicable\",\n        \"support\": \"correct\",\n        \"scope\": \"correct\",\n        \"links\": \"correct\",\n        \"boundary\": \"correct\",\n        \"modality\": \"correct\",\n        \"action\": \"not_applicable\",\n        \"object\": \"correct\",\n        \"alternatives\": \"correct\",\n        \"thresholds\": \"correct\",\n        \"concepts\": \"correct\",\n        \"source_attribution\": \"correct\",\n        \"effectivity\": \"correct\"\n      }\n    }\n  ],\n  \"unit_judgments\": [\n    {\n      \"unit_id\": \"U0000\",\n      \"claim_ids\": [],\n      \"status\": \"missing\",\n      \"rationale\": \"The general statement of scope and application of § 1910.157 from paragraph (a) is not represented in any claim.\",\n      \"source_refs\": [\"F002\"]\n    },\n    {\n      \"unit_id\": \"U0001\",\n      \"claim_ids\": [\"C0003\"],\n      \"status\": \"covered\",\n      \"rationale\": \"C0003 fully and accurately captures the exclusion of outdoor workplace extinguishers from paragraph (d).\",\n      \"source_refs\": [\"F002\"]\n    },\n    {\n      \"unit_id\": \"U0002\",\n      \"claim_ids\": [],\n      \"status\": \"missing\",\n      \"rationale\": \"The partial exemption in paragraph (a) for workplaces providing extinguishers not intended for employee use is not extracted.\",\n      \"source_refs\": [\"F002\"]\n    },\n    {\n      \"unit_id\": \"U0003\",\n      \"claim_ids\": [],\n      \"status\": \"missing\",\n      \"rationale\": \"The complete exemption under paragraph (b)(1) for workplaces with total evacuation policies and no available extinguishers is not extracted.\",\n      \"source_refs\": [\"F004:F005\"]\n    },\n    {\n      \"unit_id\": \"U0004\",\n      \"claim_ids\": [\"C0002\"],\n      \"status\": \"covered\",\n      \"rationale\": \"C0002 completely and accurately captures the exemption from distribution requirements under paragraph (b)(2).\",\n      \"source_refs\": [\"F006\"]\n    },\n    {\n      \"unit_id\": \"U0005\",\n      \"claim_ids\": [],\n      \"status\": \"missing\",\n      \"rationale\": \"The duty under paragraph (c)(1) to provide, mount, locate, and identify extinguishers for safe accessibility is unextracted.\",\n      \"source_refs\": [\"F008\"]\n    },\n    {\n      \"unit_id\": \"U0006\",\n      \"claim_ids\": [],\n      \"status\": \"missing\",\n      \"rationale\": \"The requirement in paragraph (c)(2) that only approved portable fire extinguishers be used is unextracted.\",\n      \"source_refs\": [\"F009\"]\n    },\n    {\n      \"unit_id\": \"U0007\",\n      \"claim_ids\": [],\n      \"status\": \"missing\",\n      \"rationale\": \"The prohibition in paragraph (c)(3) against carbon tetrachloride and chlorobromomethane extinguishing agents is unextracted.\",\n      \"source_refs\": [\"F010\"]\n    },\n    {\n      \"unit_id\": \"U0008\",\n      \"claim_ids\": [\"C0001\"],\n      \"status\": \"partial\",\n      \"rationale\": \"C0001 covers maintenance and placement in designated places, but omits the necessary exception 'except during use'.\",\n      \"source_refs\": [\"F011\"]\n    },\n    {\n      \"unit_id\": \"U0009\",\n      \"claim_ids\": [],\n      \"status\": \"missing\",\n      \"rationale\": \"The requirement in paragraph (c)(5) to remove soldered or riveted shell inversion-type extinguishers is unextracted.\",\n      \"source_refs\": [\"F012\"]\n    },\n    {\n      \"unit_id\": \"U0010\",\n      \"claim_ids\": [],\n      \"status\": \"missing\",\n      \"rationale\": \"The general selection and distribution requirement based on fire classes and hazard degrees under paragraph (d)(1) is unextracted.\",\n      \"source_refs\": [\"F014\"]\n    },\n    {\n      \"unit_id\": \"U0011\",\n      \"claim_ids\": [\"C0000\"],\n      \"status\": \"covered\",\n      \"rationale\": \"C0000 fully captures the 75-foot travel distance distribution requirement for Class A fires under paragraph (d)(2).\",\n      \"source_refs\": [\"F015\"]\n    },\n    {\n      \"unit_id\": \"U0012\",\n      \"claim_ids\": [],\n      \"status\": \"missing\",\n      \"rationale\": \"The alternative in paragraph (d)(3) permitting standpipe systems or hose stations in lieu of Class A extinguishers is unextracted.\",\n      \"source_refs\": [\"F016\"]\n    },\n    {\n      \"unit_id\": \"U0013\",\n      \"claim_ids\": [],\n      \"status\": \"missing\",\n      \"rationale\": \"The 50-foot travel distance distribution requirement for Class B fires under paragraph (d)(4) is unextracted.\",\n      \"source_refs\": [\"F017\"]\n    },\n    {\n      \"unit_id\": \"U0014\",\n      \"claim_ids\": [],\n      \"status\": \"missing\",\n      \"rationale\": \"The requirement under paragraph (d)(5) to distribute extinguishers for Class C hazards based on Class A or B patterns is unextracted.\",\n      \"source_refs\": [\"F018\"]\n    },\n    {\n      \"unit_id\": \"U0015\",\n      \"claim_ids\": [],\n      \"status\": \"missing\",\n      \"rationale\": \"The 75-foot travel distance requirement for Class D extinguishing agents under paragraph (d)(6) is unextracted.\",\n      \"source_refs\": [\"F019\"]\n    },\n    {\n      \"unit_id\": \"U0016\",\n      \"claim_ids\": [],\n      \"status\": \"missing\",\n      \"rationale\": \"The duty to provide Class D extinguishers in areas generating combustible metal products at least once every two weeks is unextracted.\",\n      \"source_refs\": [\"F019\"]\n    }\n  ]\n}",

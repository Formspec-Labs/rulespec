            "text": "{\n  \"claim_judgments\": [\n    {\n      \"claim_id\": \"C0000\",\n      \"unit_ids\": [\"U0011\"],\n      \"source_refs\": [\"F015\"],\n      \"rationale\": \"The claim accurately captures the Class A travel distance requirement of 75 feet (22.9 m) or less under 29 CFR 1910.157(d)(2) with proper modality, actor, and thresholds.\",\n      \"dimensions\": {\n        \"summary\": \"correct\",\n        \"actor\": \"correct\",\n        \"support\": \"correct\",\n        \"scope\": \"correct\",\n        \"links\": \"correct\",\n        \"boundary\": \"correct\",\n        \"modality\": \"correct\",\n        \"action\": \"correct\",\n        \"object\": \"correct\",\n        \"alternatives\": \"correct\",\n        \"thresholds\": \"correct\",\n        \"concepts\": \"correct\",\n        \"source_attribution\": \"correct\",\n        \"effectivity\": \"correct\"\n      }\n    },\n    {\n      \"claim_id\": \"C0001\",\n      \"unit_ids\": [\"U0008\"],\n      \"source_refs\": [\"F002\", \"F004:F005\", \"F011\"],\n      \"rationale\": \"While the claim captures general maintenance and scope qualifications, its summary and boundary omit the explicit statutory exception 'except during use', incorrectly imposing a continuous requirement to keep extinguishers in designated places even while actively using them.\",\n      \"dimensions\": {\n        \"summary\": \"error\",\n        \"actor\": \"correct\",\n        \"support\": \"correct\",\n        \"scope\": \"correct\",\n        \"links\": \"correct\",\n        \"boundary\": \"error\",\n        \"modality\": \"correct\",\n        \"action\": \"correct\",\n        \"object\": \"correct\",\n        \"alternatives\": \"correct\",\n        \"thresholds\": \"correct\",\n        \"concepts\": \"correct\",\n        \"source_attribution\": \"correct\",\n        \"effectivity\": \"correct\"\n      }\n    },\n    {\n      \"claim_id\": \"C0002\",\n      \"unit_ids\": [\"U0004\"],\n      \"source_refs\": [\"F006\"],\n      \"rationale\": \"The claim accurately represents the exemption in 1910.157(b)(2) from paragraph (d) distribution requirements where an employer has an emergency action plan designating specific employees for extinguisher use and mandating immediate evacuation for others.\",\n      \"dimensions\": {\n        \"summary\": \"correct\",\n        \"actor\": \"correct\",\n        \"support\": \"correct\",\n        \"scope\": \"correct\",\n        \"links\": \"correct\",\n        \"boundary\": \"correct\",\n        \"modality\": \"correct\",\n        \"action\": \"correct\",\n        \"object\": \"correct\",\n        \"alternatives\": \"correct\",\n        \"thresholds\": \"correct\",\n        \"concepts\": \"correct\",\n        \"source_attribution\": \"correct\",\n        \"effectivity\": \"correct\"\n      }\n    },\n    {\n      \"claim_id\": \"C0003\",\n      \"unit_ids\": [\"U0001\"],\n      \"source_refs\": [\"F002\"],\n      \"rationale\": \"The claim accurately captures the exception from paragraph (d) for extinguishers provided for employee use on the outside of workplace buildings or structures.\",\n      \"dimensions\": {\n        \"summary\": \"correct\",\n        \"actor\": \"not_applicable\",\n        \"support\": \"correct\",\n        \"scope\": \"correct\",\n        \"links\": \"correct\",\n        \"boundary\": \"correct\",\n        \"modality\": \"correct\",\n        \"action\": \"correct\",\n        \"object\": \"correct\",\n        \"alternatives\": \"correct\",\n        \"thresholds\": \"correct\",\n        \"concepts\": \"correct\",\n        \"source_attribution\": \"correct\",\n        \"effectivity\": \"correct\"\n      }\n    }\n  ],\n  \"unit_judgments\": [\n    {\n      \"unit_id\": \"U0000\",\n      \"claim_ids\": [],\n      \"status\": \"missing\",\n      \"rationale\": \"The general scope statement regarding placement, use, maintenance, and testing under § 1910.157(a) is not covered by any focus claim.\",\n      \"source_refs\": [\"F002\"]\n    },\n    {\n      \"unit_id\": \"U0001\",\n      \"claim_ids\": [\"C0003\"],\n      \"status\": \"covered\",\n      \"rationale\": \"Fully covered by claim C0003.\",\n      \"source_refs\": [\"F002\"]\n    },\n    {\n      \"unit_id\": \"U0002\",\n      \"claim_ids\": [],\n      \"status\": \"missing\",\n      \"rationale\": \"The exemption under § 1910.157(a) for non-employee-use extinguishers when emergency and fire prevention plans are present is not extracted as an independent claim.\",\n      \"source_refs\": [\"F002\"]\n    },\n    {\n      \"unit_id\": \"U0003\",\n      \"claim_ids\": [],\n      \"status\": \"missing\",\n      \"rationale\": \"The full workplace evacuation exemption under § 1910.157(b)(1) is not extracted as an independent claim.\",\n      \"source_refs\": [\"F004:F005\"]\n    },\n    {\n      \"unit_id\": \"U0004\",\n      \"claim_ids\": [\"C0002\"],\n      \"status\": \"covered\",\n      \"rationale\": \"Fully covered by claim C0002.\",\n      \"source_refs\": [\"F006\"]\n    },\n    {\n      \"unit_id\": \"U0005\",\n      \"claim_ids\": [],\n      \"status\": \"missing\",\n      \"rationale\": \"The requirement in § 1910.157(c)(1) to mount, locate, and identify extinguishers without employee injury is unrepresented in the draft.\",\n      \"source_refs\": [\"F008\"]\n    },\n    {\n      \"unit_id\": \"U0006\",\n      \"claim_ids\": [],\n      \"status\": \"missing\",\n      \"rationale\": \"The requirement in § 1910.157(c)(2) to use only approved extinguishers is unrepresented in the draft.\",\n      \"source_refs\": [\"F009\"]\n    },\n    {\n      \"unit_id\": \"U0007\",\n      \"claim_ids\": [],\n      \"status\": \"missing\",\n      \"rationale\": \"The prohibition against carbon tetrachloride and chlorobromomethane agents under § 1910.157(c)(3) is unrepresented in the draft.\",\n      \"source_refs\": [\"F010\"]\n    },\n    {\n      \"unit_id\": \"U0008\",\n      \"claim_ids\": [\"C0001\"],\n      \"status\": \"partial\",\n      \"rationale\": \"Claim C0001 extracts the duty to keep extinguishers charged, operable, and in place, but drops the exception 'except during use'.\",\n      \"source_refs\": [\"F011\"]\n    },\n    {\n      \"unit_id\": \"U0009\",\n      \"claim_ids\": [],\n      \"status\": \"missing\",\n      \"rationale\": \"The requirement in § 1910.157(c)(5) to remove soldered/riveted shell self-generating acid/foam/gas cartridge water extinguishers is unrepresented in the draft.\",\n      \"source_refs\": [\"F012\"]\n    },\n    {\n      \"unit_id\": \"U0010\",\n      \"claim_ids\": [],\n      \"status\": \"missing\",\n      \"rationale\": \"The general selection and distribution requirement based on hazard class and size under § 1910.157(d)(1) is unrepresented in the draft.\",\n      \"source_refs\": [\"F014\"]\n    },\n    {\n      \"unit_id\": \"U0011\",\n      \"claim_ids\": [\"C0000\"],\n      \"status\": \"covered\",\n      \"rationale\": \"Fully covered by claim C0000.\",\n      \"source_refs\": [\"F015\"]\n    },\n    {\n      \"unit_id\": \"U0012\",\n      \"claim_ids\": [],\n      \"status\": \"missing\",\n      \"rationale\": \"The alternative allowing standpipe or sprinkler hose stations under § 1910.157(d)(3) is unrepresented in the draft.\",\n      \"source_refs\": [\"F016\"]\n    },\n    {\n      \"unit_id\": \"U0013\",\n      \"claim_ids\": [],\n      \"status\": \"missing\",\n      \"rationale\": \"The Class B extinguisher travel distance requirement under § 1910.157(d)(4) is unrepresented in the draft.\",\n      \"source_refs\": [\"F017\"]\n    },\n    {\n      \"unit_id\": \"U0014\",\n      \"claim_ids\": [],\n      \"status\": \"missing\",\n      \"rationale\": \"The Class C distribution pattern requirement under § 1910.157(d)(5) is unrepresented in the draft.\",\n      \"source_refs\": [\"F018\"]\n    },\n    {\n      \"unit_id\": \"U0015\",\n      \"claim_ids\": [],\n      \"status\": \"missing\",\n      \"rationale\": \"The Class D travel distance requirement of 75 feet under § 1910.157(d)(6) is unrepresented in the draft.\",\n      \"source_refs\": [\"F019\"]\n    },\n    {\n      \"unit_id\": \"U0016\",\n      \"claim_ids\": [],\n      \"status\": \"missing\",\n      \"rationale\": \"The requirement for Class D extinguishers in areas generating combustible metal products every two weeks under § 1910.157(d)(6) is unrepresented in the draft.\",\n      \"source_refs\": [\"F019\"]\n    }\n  ]\n}",

      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:5decbe70137a6c4d1a326d37293389629c0b458c08b8a7b49a53b69eaf905db8\",\"urn:rulespec:document-understanding:assertion:422a2e2c9e37d8ea5ba765129f5369c229977b48832cbb6482213a84556b8bb1\",\"urn:rulespec:document-understanding:assertion:8fbbc9651ab0a722a8f0486dfbe108cb77f2adca0202bc0783b4b8e2717a5936\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":724,\"evidence\":[{\"end\":441,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A13d6b0d321413b1bfe663dcfc7713011d9d5edf131aaad494593c927a606ba24:386:441:sha256-d52d956fc817daa9e239f373bf8cb34e732cfa6358f60f40e6c631b0b9fd18ef\",\"quote\":\"(ii) Plans maintaining funding standard account in 2007\",\"start\":386},{\"end\":489,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A13d6b0d321413b1bfe663dcfc7713011d9d5edf131aaad494593c927a606ba24:442:489:sha256-09536c1bc14e120ad046af9d6bc07adf403921e67d4e5d6b5e062b34ad87b9de\",\"quote\":\"A plan is described in this clause if the plan—\",\"start\":442},{\"end\":724,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A13d6b0d321413b1bfe663dcfc7713011d9d5edf131aaad494593c927a606ba24:491:724:sha256-22ba18874af375003f69a580f2df09fc08709ffe16783f9493ac0e60acc88b74\",\"quote\":\"(I) was in effect for a plan year beginning in 2007, and\\n\\n(II) had a positive balance in the funding standard account under section 1082(b) of this title as in effect for such plan year and determined as of the end of such plan year.\",\"start\":491}],\"id\":\"urn:rulespec:document-understanding:revision:ef9fcac4db4e35cd52123a60dbdae9d7b317876a9dc9b73336a87f0d470ad811\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"statement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:8fbbc9651ab0a722a8f0486dfbe108cb77f2adca0202bc0783b4b8e2717a5936\",\"modality\":\"not_stated\",\"modality_quote\":\"\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:3a583dd03533dc935ce3500e9f75f3214a0786187137bb07339c54e2173e5d3f\",\"origin\":\"aiSuggested\",\"quote\":\"(ii) Plans maintaining funding standard account in 2007 A plan is described in this clause if the plan—\\n\\n(I) was in effect for a plan year beginning in 2007, and\\n\\n(II) had a positive balance in the funding standard account under section 1082(b) of this title as in effect for such plan year and determined as of the end of such plan year.\",\"references\":[\"section 1082(b)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:9d7e502d6756d89a145e760199a4e815dfe79ad6c65e6b152d4f4f9f226055dd\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":386,\"summary\":\"A plan is described in clause (ii) if the plan was in effect for a plan year beginning in 2007, and had a positive balance in the funding standard account under section 1082(b) of this title as in effect for such plan year and determined as of the end of such plan year.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

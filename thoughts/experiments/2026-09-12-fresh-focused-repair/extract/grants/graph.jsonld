      "dcterms:description": "{\"action\":\"\",\"actor\":\"An eligible person or entity\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:5b9ea399c0bac3916378f90bf132fd7047351dd7ecf8b164b532bba33aca10b9\",\"urn:rulespec:document-understanding:assertion:05e7d0cc41745a74aad532a409f239d211de9577341c747b998b81428fb52452\",\"urn:rulespec:document-understanding:assertion:bafa70008f24f2426b9eefbbf67224af09ca53bca5ecc21f22e1dfaea2d02db8\",\"urn:rulespec:document-understanding:assertion:220baa3d6db80eb8c260f924bf4e0223014dbe21d07eba7a76a3edc5bc851c4b\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":3645,\"evidence\":[{\"end\":3201,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A427f216f1ff15f6b01489fa72671755ecd3fb66e09902d193d3f552577bbabc9:3178:3201:sha256-fc49ccec52e97a9490020cab444e0f47e519b3d4069eb9a266ecfdfa465ac4cb\",\"quote\":\"(3) Prohibited expenses\",\"start\":3178},{\"end\":3293,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A427f216f1ff15f6b01489fa72671755ecd3fb66e09902d193d3f552577bbabc9:3202:3293:sha256-d7fd3e282b91a47b4b795daf4067abf9a4e01828e6d02b7bc329b2ea3d790dcb\",\"quote\":\"An eligible person or entity may not use amounts received under a grant under this section—\",\"start\":3202},{\"end\":3645,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A427f216f1ff15f6b01489fa72671755ecd3fb66e09902d193d3f552577bbabc9:3295:3645:sha256-b4362608e228ecd64e2be1518433bb340302f1ec93f3770ec5b5e31c9448a094\",\"quote\":\"(A) to purchase real estate;\\n\\n(B) for payments of interest or principal on loans originated after February 15, 2020;\\n\\n(C) to invest or re-lend funds;\\n\\n(D) for contributions or expenditures to, or on behalf of, any political party, party committee, or candidate for elective office; or\\n\\n(E) for any other use as may be prohibited by the Administrator.\",\"start\":3295},{\"end\":3230,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A427f216f1ff15f6b01489fa72671755ecd3fb66e09902d193d3f552577bbabc9:3202:3230:sha256-9668448f322949182790d296ee0ae5acba0276d0827296af77ddf63353ad43d8\",\"quote\":\"An eligible person or entity\",\"start\":3202},{\"end\":3238,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A427f216f1ff15f6b01489fa72671755ecd3fb66e09902d193d3f552577bbabc9:3231:3238:sha256-0007a8bea4dcd3f6b1490fc7199650f1046713dd92d9314e1f2ede6946fcd999\",\"quote\":\"may not\",\"start\":3231}],\"id\":\"urn:rulespec:document-understanding:revision:378dbfa9023e6eec3e0db4de7ddbf08200f2a58be23899ca5b110b6f0a45e598\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"prohibition\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:220baa3d6db80eb8c260f924bf4e0223014dbe21d07eba7a76a3edc5bc851c4b\",\"modality\":\"must_not\",\"modality_quote\":\"may not\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:4840d2ff5b64f1147589c6635e6464305cddcd436ce09071ea4118925979a6be\",\"origin\":\"aiSuggested\",\"quote\":\"(3) Prohibited expenses An eligible person or entity may not use amounts received under a grant under this section—\\n\\n(A) to purchase real estate;\\n\\n(B) for payments of interest or principal on loans originated after February 15, 2020;\\n\\n(C) to invest or re-lend funds;\\n\\n(D) for contributions or expenditures to, or on behalf of, any political party, party committee, or candidate for elective office; or\\n\\n(E) for any other use as may be prohibited by the Administrator.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:5ce1ea9325966fd169bbe6eaddde8e1f262e8e7f08578ab153553f5967236a8a\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":3178,\"summary\":\"An eligible person or entity must not use amounts received under a grant under this section: (A) to purchase real estate; (B) for payments of interest or principal on loans originated after February 15, 2020; (C) to invest or re-lend funds; (D) for contributions or expenditures to, or on behalf of, any political party, party committee, or candidate for elective office; or (E) for any other use as may be prohibited by the Administrator.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

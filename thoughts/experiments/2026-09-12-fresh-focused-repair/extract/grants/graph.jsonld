    {
      "@id": "urn:rulespec:document-understanding:revision:44a45b9f73116178994e991072221abfcdf251642748a4e531969c1c00f54211",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:44a45b9f73116178994e991072221abfcdf251642748a4e531969c1c00f54211",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:9674adc16d4e6887bbe713585d15e08c90678a8312ae92dbeac872b636b5cb65",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"An eligible person or entity\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:37c7cd0003a8223b17dd29f17da0ebcfc0c16a40888ea2663e145d70957d0af0\",\"urn:rulespec:document-understanding:assertion:37c80881e397f6485c8d242dfaea26e5c4b96efbd66024e37aa17137948be544\",\"urn:rulespec:document-understanding:assertion:c2c7c31ba76a56b93f5dd4780713b5a412599a3a658dc4f33d9532f672b86fd8\",\"urn:rulespec:document-understanding:assertion:2d37506f3c1e45ee1e7e63474b081a57bcf4b6d9e48728845028cc40f1a0867d\",\"urn:rulespec:document-understanding:assertion:c86f32f46bc2036d256fb4972e16084a1de220d667d4b67368eddd8722c968b8\",\"urn:rulespec:document-understanding:assertion:483a746fd524b459cd132116c8a0bc0dbb6f3af7e6bfdc2c3961c677efe42459\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":3173,\"evidence\":[{\"end\":1689,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A427f216f1ff15f6b01489fa72671755ecd3fb66e09902d193d3f552577bbabc9:1677:1689:sha256-6cbbf2fcd8215e7039ef0f88b6587678b671ca245efc0884a17b871ed20ed3bb\",\"quote\":\"(B) Expenses\",\"start\":1677},{\"end\":1781,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A427f216f1ff15f6b01489fa72671755ecd3fb66e09902d193d3f552577bbabc9:1690:1781:sha256-8f97e91ebaa94d13d4998204727d06ea1a36391f4df8359cbdf70af331672786\",\"quote\":\"An eligible person or entity may use amounts received under a grant under this section for—\",\"start\":1690},{\"end\":2653,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A427f216f1ff15f6b01489fa72671755ecd3fb66e09902d193d3f552577bbabc9:1783:2653:sha256-d8b5fcbeebe34f78414eb487246454397fc7a6fea5e874ad31e3ecad0577b95f\",\"quote\":\"(i) payroll costs;\\n\\n(ii) payments on any covered rent obligation;\\n\\n(iii) any covered utility payment;\\n\\n(iv) scheduled payments of interest or principal on any covered mortgage obligation (which shall not include any prepayment of principal on a covered mortgage obligation);\\n\\n(v) scheduled payments of interest or principal on any indebtedness or debt instrument (which shall not include any prepayment of principal) incurred in the ordinary course of business that is a liability of the eligible person or entity and was incurred prior to February 15, 2020;\\n\\n(vi) covered worker protection expenditures;\\n\\n(vii) payments made to independent contractors, as reported on Form–1099 MISC, not to exceed a total of $100,000 in annual compensation for any individual employee of an independent contractor; and\\n\\n(viii) other ordinary and necessary business expenses, including—\",\"start\":1783},{\"end\":3173,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A427f216f1ff15f6b01489fa72671755ecd3fb66e09902d193d3f552577bbabc9:2655:3173:sha256-098cef2d7d648c9f87f7d9080029dec97899a869723ee3828eef07912b30b886\",\"quote\":\"(I) maintenance expenses;\\n\\n(II) administrative costs, including fees and licensing costs;\\n\\n(III) State and local taxes and fees;\\n\\n(IV) operating leases in effect as of February 15, 2020;\\n\\n(V) payments required for insurance on any insurance policy; and\\n\\n(VI) advertising, production transportation, and capital expenditures related to producing a theatrical or live performing arts production, concert, exhibition, or comedy show, except that a grant under this section may not be used primarily for such expenditures.\",\"start\":2655},{\"end\":1718,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A427f216f1ff15f6b01489fa72671755ecd3fb66e09902d193d3f552577bbabc9:1690:1718:sha256-9668448f322949182790d296ee0ae5acba0276d0827296af77ddf63353ad43d8\",\"quote\":\"An eligible person or entity\",\"start\":1690}],\"id\":\"urn:rulespec:document-understanding:revision:44a45b9f73116178994e991072221abfcdf251642748a4e531969c1c00f54211\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"permission\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:2d37506f3c1e45ee1e7e63474b081a57bcf4b6d9e48728845028cc40f1a0867d\",\"modality\":\"may\",\"modality_quote\":\"may\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:937f27376927c09d44226c4568f7e3e60d6e80cf976ed80d4cc55fd52ffc806f\",\"origin\":\"aiSuggested\",\"quote\":\"(B) Expenses An eligible person or entity may use amounts received under a grant under this section for—\\n\\n(i) payroll costs;\\n\\n(ii) payments on any covered rent obligation;\\n\\n(iii) any covered utility payment;\\n\\n(iv) scheduled payments of interest or principal on any covered mortgage obligation (which shall not include any prepayment of principal on a covered mortgage obligation);\\n\\n(v) scheduled payments of interest or principal on any indebtedness or debt instrument (which shall not include any prepayment of principal) incurred in the ordinary course of business that is a liability of the eligible person or entity and was incurred prior to February 15, 2020;\\n\\n(vi) covered worker protection expenditures;\\n\\n(vii) payments made to independent contractors, as reported on Form–1099 MISC, not to exceed a total of $100,000 in annual compensation for any individual employee of an independent contractor; and\\n\\n(viii) other ordinary and necessary business expenses, including—\\n\\n(I) maintenance expenses;\\n\\n(II) administrative costs, including fees and licensing costs;\\n\\n(III) State and local taxes and fees;\\n\\n(IV) operating leases in effect as of February 15, 2020;\\n\\n(V) payments required for insurance on any insurance policy; and\\n\\n(VI) advertising, production transportation, and capital expenditures related to producing a theatrical or live performing arts production, concert, exhibition, or comedy show, except that a grant under this section may not be used primarily for such expenditures.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:00cb2457663090c2ba528a73163b51a0c062aea80a6184d9c28748394e6b411b\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":1677,\"summary\":\"An eligible person or entity may use amounts received under a grant under this section for: (i) payroll costs; (ii) payments on any covered rent obligation; (iii) any covered utility payment; (iv) scheduled payments of interest or principal on any covered mortgage obligation (which shall not include any prepayment of principal on a covered mortgage obligation); (v) scheduled payments of interest or principal on any indebtedness or debt instrument (which shall not include any prepayment of principal) incurred in the ordinary course of business that is a liability of the eligible person or entity and was incurred prior to February 15, 2020; (vi) covered worker protection expenditures; (vii) payments made to independent contractors, as reported on Form–1099 MISC, not to exceed a total of $100,000 in annual compensation for any individual employee of an independent contractor; and (viii) other ordinary and necessary business expenses, including maintenance expenses, administrative costs (including fees and licensing costs), State and local taxes and fees, operating leases in effect as of February 15, 2020, payments required for insurance on any insurance policy, and advertising, production transportation, and capital expenditures related to producing a theatrical or live performing arts production, concert, exhibition, or comedy show, except that a grant under this section may not be used primarily for such expenditures.\",\"target_ids\":[],\"term_refs\":[\"urn:rulespec:document-understanding:term:2da65be5147a91561b68142ce4ae88b0e4d7ca3fc571b49c52c26c2ae690902a\",\"urn:rulespec:document-understanding:term:c72033f2e66a6e6be1228ec7b938fb130561c26a9bac73d57f6b3f6dd7328ce9\"],\"typed_values\":[]}",

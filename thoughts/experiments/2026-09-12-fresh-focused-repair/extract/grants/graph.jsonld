    {
      "@id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A427f216f1ff15f6b01489fa72671755ecd3fb66e09902d193d3f552577bbabc9:1783:2653:sha256-d8b5fcbeebe34f78414eb487246454397fc7a6fea5e874ad31e3ecad0577b95f",
      "@type": "rkaf:SourceFragment",
      "oa:hasSource": "urn:rulespec:document-understanding:document:427f216f1ff15f6b01489fa72671755ecd3fb66e09902d193d3f552577bbabc9",
      "rkaf:fragmentIdentityScheme": "rkaf:carrier-local-fragment",
      "rkaf:sourceArtifactDigest": "sha256:427f216f1ff15f6b01489fa72671755ecd3fb66e09902d193d3f552577bbabc9",
      "rkaf:fragmentContentDigest": "sha256:d8b5fcbeebe34f78414eb487246454397fc7a6fea5e874ad31e3ecad0577b95f",
      "rkaf:selectorKind": [
        "oa:TextQuoteSelector",
        "oa:TextPositionSelector"
      ],
      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "(i) payroll costs;\n\n(ii) payments on any covered rent obligation;\n\n(iii) any covered utility payment;\n\n(iv) scheduled payments of interest or principal on any covered mortgage obligation (which shall not include any prepayment of principal on a covered mortgage obligation);\n\n(v) scheduled payments of interest or principal on any indebtedness or debt instrument (which shall not include any prepayment of principal) incurred in the ordinary course of business that is a liability of the eligible person or entity and was incurred prior to February 15, 2020;\n\n(vi) covered worker protection expenditures;\n\n(vii) payments made to independent contractors, as reported on Form–1099 MISC, not to exceed a total of $100,000 in annual compensation for any individual employee of an independent contractor; and\n\n(viii) other ordinary and necessary business expenses, including—"
        },
        {
          "@type": "oa:TextPositionSelector",
          "oa:start": 1783,
          "oa:end": 2653,
          "rkaf:coordinateSystem": "rkaf:unicode-codepoint"
        }
      ]
    },
    {
      "@id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A427f216f1ff15f6b01489fa72671755ecd3fb66e09902d193d3f552577bbabc9:2655:3173:sha256-098cef2d7d648c9f87f7d9080029dec97899a869723ee3828eef07912b30b886",
      "@type": "rkaf:SourceFragment",
      "oa:hasSource": "urn:rulespec:document-understanding:document:427f216f1ff15f6b01489fa72671755ecd3fb66e09902d193d3f552577bbabc9",
      "rkaf:fragmentIdentityScheme": "rkaf:carrier-local-fragment",
      "rkaf:sourceArtifactDigest": "sha256:427f216f1ff15f6b01489fa72671755ecd3fb66e09902d193d3f552577bbabc9",
      "rkaf:fragmentContentDigest": "sha256:098cef2d7d648c9f87f7d9080029dec97899a869723ee3828eef07912b30b886",
      "rkaf:selectorKind": [
        "oa:TextQuoteSelector",
        "oa:TextPositionSelector"
      ],
      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "(I) maintenance expenses;\n\n(II) administrative costs, including fees and licensing costs;\n\n(III) State and local taxes and fees;\n\n(IV) operating leases in effect as of February 15, 2020;\n\n(V) payments required for insurance on any insurance policy; and\n\n(VI) advertising, production transportation, and capital expenditures related to producing a theatrical or live performing arts production, concert, exhibition, or comedy show, except that a grant under this section may not be used primarily for such expenditures."
        },
        {
          "@type": "oa:TextPositionSelector",
          "oa:start": 2655,
          "oa:end": 3173,
          "rkaf:coordinateSystem": "rkaf:unicode-codepoint"
        }
      ]
    },

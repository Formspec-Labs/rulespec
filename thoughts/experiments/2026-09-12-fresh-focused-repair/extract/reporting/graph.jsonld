      "dcterms:description": "{\"action\":\"\",\"actor\":\"prime contractor\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:6692472e501ac3a0b9c28e3055486f6931132f0a4e10ab5713110bd021585598\",\"urn:rulespec:document-understanding:assertion:bfe171cc612c5e2abde92a819553e93f169996935d3f711bf8c6adcd1ea388cf\",\"urn:rulespec:document-understanding:assertion:d646af301eb8cfa5d389cdaecc17cc01814fd9ed2ded4bb5b2d02a802e36118b\",\"urn:rulespec:document-understanding:assertion:f451bd0a63cbd288c8fbfef08879e2873dea46c9160d982de1a00312db68648b\",\"urn:rulespec:document-understanding:assertion:995722e455c85c523fe0832ed89808b637aaeba3cdaae4c975e70b2107c1f94b\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":621,\"evidence\":[{\"end\":621,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ada51036a061b529f2659f2e88d4489faeb17e04c33aded955b4dfbf56be27629:207:621:sha256-d9adba2c171127a3c21ebbe087fc151fca252c6416affca75551ba601187d717\",\"quote\":\"(i) if the subcontracting goals pertain only to a single contract with a Federal agency, the prime contractor may elect to receive credit for small business concerns performing as first tier subcontractors or subcontractors at any tier pursuant to the subcontracting plans required under paragraph (6)(D) in an amount equal to the total dollar value of any subcontracts awarded to such small business concerns; and\",\"start\":207},{\"end\":316,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ada51036a061b529f2659f2e88d4489faeb17e04c33aded955b4dfbf56be27629:300:316:sha256-b75611f273a5b0cd6851804efb816ae9cdceb492df826bf1f26f95ac9edfcda2\",\"quote\":\"prime contractor\",\"start\":300},{\"end\":326,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ada51036a061b529f2659f2e88d4489faeb17e04c33aded955b4dfbf56be27629:317:326:sha256-b478fafb20bc2258b84640c40fbb5142386bbdc32caa156f1a1a06a99729dbc9\",\"quote\":\"may elect\",\"start\":317},{\"end\":81,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ada51036a061b529f2659f2e88d4489faeb17e04c33aded955b4dfbf56be27629:65:81:sha256-b67ed427ed2ffb66dc130dc5cef35c2a0310e96e5715860ab9d13d924059bde9\",\"quote\":\"(A) In general.—\",\"start\":65},{\"end\":205,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ada51036a061b529f2659f2e88d4489faeb17e04c33aded955b4dfbf56be27629:82:205:sha256-9ca0d032313c67620c9fadea21be43f372f8301e6585b73b55d3f803c8a63164\",\"quote\":\"For purposes of determining whether or not a prime contractor has attained the percentage goals specified in paragraph (6)—\",\"start\":82},{\"end\":621,\"field\":\"scope_text:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ada51036a061b529f2659f2e88d4489faeb17e04c33aded955b4dfbf56be27629:207:621:sha256-d9adba2c171127a3c21ebbe087fc151fca252c6416affca75551ba601187d717\",\"quote\":\"(i) if the subcontracting goals pertain only to a single contract with a Federal agency, the prime contractor may elect to receive credit for small business concerns performing as first tier subcontractors or subcontractors at any tier pursuant to the subcontracting plans required under paragraph (6)(D) in an amount equal to the total dollar value of any subcontracts awarded to such small business concerns; and\",\"start\":207}],\"id\":\"urn:rulespec:document-understanding:revision:8ca8366af1d682fafaa9eb5abf0a41e9f8f6d2c0d1187d19f62110457f11a34e\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"permission\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:995722e455c85c523fe0832ed89808b637aaeba3cdaae4c975e70b2107c1f94b\",\"modality\":\"may\",\"modality_quote\":\"may elect\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:3a453fc82f768cafd5546cd80d5ca3afa46357ded2a7caf84fb733e08e730096\",\"origin\":\"aiSuggested\",\"quote\":\"(i) if the subcontracting goals pertain only to a single contract with a Federal agency, the prime contractor may elect to receive credit for small business concerns performing as first tier subcontractors or subcontractors at any tier pursuant to the subcontracting plans required under paragraph (6)(D) in an amount equal to the total dollar value of any subcontracts awarded to such small business concerns; and\",\"references\":[\"paragraph (6)\",\"paragraph (6)(D)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:f3a68066c928d0738b2f28882039b56caa9fba61ae8c77254a3c32157ca56252\",\"scope_quotes\":[\"(A) In general.— For purposes of determining whether or not a prime contractor has attained the percentage goals specified in paragraph (6)—\",\"(i) if the subcontracting goals pertain only to a single contract with a Federal agency, the prime contractor may elect to receive credit for small business concerns performing as first tier subcontractors or subcontractors at any tier pursuant to the subcontracting plans required under paragraph (6)(D) in an amount equal to the total dollar value of any subcontracts awarded to such small business concerns; and\"],\"scope_text\":\"For purposes of determining whether or not a prime contractor has attained the percentage goals specified in paragraph (6), if the subcontracting goals pertain only to a single contract with a Federal agency\",\"section_id\":\"section-1\",\"start\":207,\"summary\":\"For purposes of determining whether or not a prime contractor has attained the percentage goals specified in paragraph (6), if the subcontracting goals pertain only to a single contract with a Federal agency, the prime contractor may elect to receive credit for small business concerns performing as first tier subcontractors or subcontractors at any tier pursuant to the subcontracting plans required under paragraph (6)(D) in an amount equal to the total dollar value of any subcontracts awarded to such small business concerns.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

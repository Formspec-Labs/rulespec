            "text": "{\n  \"proposals\": [\n    {\n      \"rationale\": \"C0003 represents the exception in § 1904.1(a)(2) that relieves an establishment from the recordkeeping mandate of C0000 if it is classified as a partially exempt industry under § 1904.2. In this relationship pass, reclassify C0003 as kind exception with relation exception, set its modality to not_stated, and connect it to target rule C0000 via qualifies.\",\n      \"operation\": \"edit\",\n      \"target\": \"C0003\",\n      \"qualifies\": [\"C0000\"],\n      \"quote\": \"unless your establishment is classified as a partially exempt industry under § 1904.2.\",\n      \"fields\": {\n        \"concepts\": [],\n        \"claimants\": [],\n        \"typed_values\": [],\n        \"effective_periods\": [],\n        \"defined_terms\": [],\n        \"term_refs\": [],\n        \"kind\": \"exception\",\n        \"scope_quotes\": [\n          \"If your company had more than ten (10) employees at any time during the last calendar year,\"\n        ],\n        \"scope_text\": \"Applies when the company had more than 10 employees at any time during the last calendar year.\",\n        \"context_quotes\": [],\n        \"modality_quote\": \"\",\n        \"modality\": \"not_stated\",\n        \"alternative_quotes\": [],\n        \"choice_quote\": \"\",\n        \"choice_text\": \"\",\n        \"logic_text\": \"unless your establishment is classified as a partially exempt industry under § 1904.2.\",\n        \"actor_quote\": \"your establishment\",\n        \"actor\": \"establishment\",\n        \"action_quote\": \"is classified as a partially exempt industry\",\n        \"action\": \"classified as a partially exempt industry\",\n        \"object_quote\": \"partially exempt industry\",\n        \"object\": \"partially exempt industry\",\n        \"jurisdiction_quote\": \"\",\n        \"jurisdiction\": \"\",\n        \"relation\": \"exception\",\n        \"references\": [\"§ 1904.2\"],\n        \"summary\": \"An establishment is excepted from the recordkeeping requirement for companies with more than 10 employees if the establishment is classified as a partially exempt industry under § 1904.2.\"\n      }\n    }\n  ],\n  \"observations\": [\n    {\n      \"quote\": \"unless OSHA or the Bureau of Labor Statistics informs you in writing that you must keep records under § 1904.41 or § 1904.42.\",\n      \"rationale\": \"The qualification regarding written notice from OSHA or BLS is already fully integrated into the baseline exemption claim C0002; creating a separate modifier is unnecessary.\",\n      \"disposition\": \"already_represented\"\n    },\n    {\n      \"quote\": \"However, as required by § 1904.39, all employers covered by the OSH Act must report to OSHA any work-related incident that results in a fatality, the in-patient hospitalization of one or more employees, an employee amputation, or an employee loss of an eye.\",\n      \"rationale\": \"The reporting mandate is an independent baseline requirement already represented in C0001 rather than a condition or exception modifying C0002.\",\n      \"disposition\": \"already_represented\"\n    }\n  ]\n}",

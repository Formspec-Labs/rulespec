      "dcterms:description": "{\"action\":\"\",\"actor\":\"driver\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:2c004cffd9d1276aa3ef5537173beb73a5218a67856541b0b72c620c13dfecbc\",\"urn:rulespec:document-understanding:assertion:4f003312aef49121fb59882c442514798bb9ffe45ac15740d02f182c38ab70e1\",\"urn:rulespec:document-understanding:assertion:bbc9afe90bdaa3bb4c3be9055096494353f6e973c61d11d5e2a453f06233ed16\",\"urn:rulespec:document-understanding:assertion:4efdb026c88453efd3e5167f0a35d3c56b8580e0bf79e3bfa3118961a22f70e9\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":447,\"evidence\":[{\"end\":447,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A0f5fb366fc64c36dc5650518066eba26d9e2c825f6c6ad199a47b128cb863077:234:447:sha256-9bd80287b272a17c626f4647a1fadaff270c9918c2a845d2a63381669c1a6222\",\"quote\":\"(2) Use alcohol, be under the influence of alcohol, or have any measured alcohol concentration or detected presence of alcohol, while on duty, or operating, or in physical control of a commercial motor vehicle; or\",\"start\":234}],\"id\":\"urn:rulespec:document-understanding:revision:ed0800f22013ce61abf1284aba327e427085c7755ffd8d1a87656909e80d12bf\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"prohibition\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:4efdb026c88453efd3e5167f0a35d3c56b8580e0bf79e3bfa3118961a22f70e9\",\"modality\":\"must_not\",\"modality_quote\":\"No driver shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:b5a2ba24e83ed0a37aba754b9fa250d27eabbf66f4b145e7b1492a91c393309a\",\"origin\":\"aiSuggested\",\"quote\":\"(2) Use alcohol, be under the influence of alcohol, or have any measured alcohol concentration or detected presence of alcohol, while on duty, or operating, or in physical control of a commercial motor vehicle; or\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:5742f0c4541f004c5cb66628331a5aeebffdf4ae4cac38601de2911c9d6e8eed\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":234,\"summary\":\"No driver shall use alcohol, be under the influence of alcohol, or have any measured alcohol concentration or detected presence of alcohol, while on duty, or operating, or in physical control of a commercial motor vehicle.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

            "text": "{\n  \"proposals\": [\n    {\n      \"rationale\": \"Add an explicit exception claim for alcohol manifested and transported as part of a shipment, qualifying baseline prohibition C0002 as required when rules contain locally stated exceptions.\",\n      \"operation\": \"add\",\n      \"target\": \"\",\n      \"qualifies\": [\"C0002\"],\n      \"quote\": \"(i) Manifested and transported as part of a shipment; or\",\n      \"fields\": {\n        \"concepts\": [\n          {\n            \"label\": \"Shipment Manifestation Exception\",\n            \"definition\": \"An exception to the prohibition on possessing alcohol while on duty or operating a commercial motor vehicle for alcohol manifested and transported as part of a shipment.\",\n            \"quote\": \"Manifested and transported as part of a shipment\",\n            \"role\": \"rkaf:assignmentPrimary\"\n          }\n        ],\n        \"claimants\": [],\n        \"typed_values\": [],\n        \"effective_periods\": [],\n        \"defined_terms\": [],\n        \"term_refs\": [],\n        \"kind\": \"exception\",\n        \"scope_quotes\": [\n          \"(a) No driver shall—\",\n          \"(3) Be on duty or operate a commercial motor vehicle while the driver possesses wine of not less than one-half of one per centum of alcohol by volume, beer as defined in 26 U.S.C. 5052(a), of the Internal Revenue Code of 1954, or distilled spirits as defined in section 5002(a)(8), of such Code. However, this does not apply to possession of wine, beer, or distilled spirits which are:\"\n        ],\n        \"scope_text\": \"Governs a driver on duty or operating a commercial motor vehicle with respect to possession of wine, beer, or distilled spirits.\",\n        \"context_quotes\": [],\n        \"modality_quote\": \"\",\n        \"modality\": \"not_stated\",\n        \"alternative_quotes\": [],\n        \"choice_quote\": \"\",\n        \"choice_text\": \"\",\n        \"logic_text\": \"\",\n        \"actor_quote\": \"driver\",\n        \"actor\": \"driver\",\n        \"action_quote\": \"possesses\",\n        \"action\": \"possesses wine, beer, or distilled spirits\",\n        \"object_quote\": \"wine, beer, or distilled spirits which are:\\n\\n(i) Manifested and transported as part of a shipment\",\n        \"object\": \"wine, beer, or distilled spirits manifested and transported as part of a shipment\",\n        \"jurisdiction_quote\": \"\",\n        \"jurisdiction\": \"\",\n        \"relation\": \"exception\",\n        \"references\": [],\n        \"summary\": \"The prohibition barring a driver from being on duty or operating a commercial motor vehicle while possessing wine, beer, or distilled spirits does not apply to possession of wine, beer, or distilled spirits that are manifested and transported as part of a shipment.\"\n      }\n    },\n    {\n      \"rationale\": \"Add an explicit exception claim for alcohol possessed or used by bus passengers, qualifying baseline prohibition C0002 as required when rules contain locally stated exceptions.\",\n      \"operation\": \"add\",\n      \"target\": \"\",\n      \"qualifies\": [\"C0002\"],\n      \"quote\": \"(ii) Possessed or used by bus passengers.\",\n      \"fields\": {\n        \"concepts\": [\n          {\n            \"label\": \"Bus Passenger Possession or Use Exception\",\n            \"definition\": \"An exception to the prohibition on possessing alcohol while on duty or operating a commercial motor vehicle for alcohol possessed or used by bus passengers.\",\n            \"quote\": \"Possessed or used by bus passengers\",\n            \"role\": \"rkaf:assignmentPrimary\"\n          }\n        ],\n        \"claimants\": [],\n        \"typed_values\": [],\n        \"effective_periods\": [],\n        \"defined_terms\": [],\n        \"term_refs\": [],\n        \"kind\": \"exception\",\n        \"scope_quotes\": [\n          \"(a) No driver shall—\",\n          \"(3) Be on duty or operate a commercial motor vehicle while the driver possesses wine of not less than one-half of one per centum of alcohol by volume, beer as defined in 26 U.S.C. 5052(a), of the Internal Revenue Code of 1954, or distilled spirits as defined in section 5002(a)(8), of such Code. However, this does not apply to possession of wine, beer, or distilled spirits which are:\"\n        ],\n        \"scope_text\": \"Governs a driver on duty or operating a commercial motor vehicle with respect to possession of wine, beer, or distilled spirits.\",\n        \"context_quotes\": [],\n        \"modality_quote\": \"\",\n        \"modality\": \"not_stated\",\n        \"alternative_quotes\": [],\n        \"choice_quote\": \"\",\n        \"choice_text\": \"\",\n        \"logic_text\": \"\",\n        \"actor_quote\": \"driver\",\n        \"actor\": \"driver\",\n        \"action_quote\": \"possesses\",\n        \"action\": \"possesses wine, beer, or distilled spirits\",\n        \"object_quote\": \"wine, beer, or distilled spirits which are:\\n\\n(i) Manifested and transported as part of a shipment; or\\n\\n(ii) Possessed or used by bus passengers.\",\n        \"object\": \"wine, beer, or distilled spirits possessed or used by bus passengers\",\n        \"jurisdiction_quote\": \"\",\n        \"jurisdiction\": \"\",\n        \"relation\": \"exception\",\n        \"references\": [],\n        \"summary\": \"The prohibition barring a driver from being on duty or operating a commercial motor vehicle while possessing wine, beer, or distilled spirits does not apply to possession of wine, beer, or distilled spirits that are possessed or used by bus passengers.\"\n      }\n    }\n  ],\n  \"observations\": [\n    {\n      \"quote\": \"unless the driver chooses to request a review of the order. In this case, the driver shall report the order to the State official within 30 days of an affirmation of the order by either the Division Administrator or State Director for the geographical area or the Administrator.\",\n      \"rationale\": \"The conditional reporting timeframe and review-request exception for reporting an out-of-service order to a State licensing official are already fully represented within claim C0009.\",\n      \"disposition\": \"already_represented\"\n    }\n  ]\n}",

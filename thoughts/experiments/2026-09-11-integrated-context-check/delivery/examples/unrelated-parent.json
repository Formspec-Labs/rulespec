          "title": "Constructed structural-parent counterexample",
          "source_url": ""
        },
        "passages": {
          "F000": {
            "start": 0,
            "end": 125,
            "text": "(a) Staff entering the laboratory must hold a laboratory permit. The permit condition applies only to staff laboratory entry."
          },
          "F001": {
            "start": 127,
            "end": 172,
            "text": "(1) Staff must sign the laboratory entry log."
          },
          "F002": {
            "start": 174,
            "end": 326,
            "text": "(2) Visitors may use the public waiting room whether or not they have a laboratory permit. This permission is independent of the staff entry conditions."
          },
          "F003": {
            "start": 328,
            "end": 365,
            "text": "(b) The waiting room closes at 18:00."
          }
        }
      }
    },

  "material": {
    "statement": "Visitors may use the public waiting room whether or not they have a laboratory permit.",
    "sources": {
      "S0": {
        "source_id": "urn:rulespec:document-understanding:document:1f1ec58d3cfad6b0cabc221929e2c05d14127c651490bd979386092b968d4370",
        "document": {

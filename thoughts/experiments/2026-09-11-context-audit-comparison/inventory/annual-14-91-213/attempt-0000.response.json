        "scope_refs": [],
        "kind": "prohibition",
        "meaning": "Except as provided in paragraph (d) of § 91.213, no person may take off an aircraft with inoperative instruments or equipment installed unless the conditions set forth in paragraphs (a)(1) through (a)(5) are met."
      },
      {
        "quote_ref": "F014",
        "scope_refs": [
          "F013"
        ],
        "kind": "condition",
        "meaning": "As a condition for takeoff with inoperative instruments or equipment installed under paragraph (a), an approved Minimum Equipment List must exist for that aircraft."
      },
      {
        "quote_ref": "F015",
        "scope_refs": [
          "F013"
        ],
        "kind": "condition",
        "meaning": "As a condition for takeoff with inoperative instruments or equipment installed under paragraph (a), the aircraft must have within it a letter of authorization, issued by the responsible Flight Standards office, authorizing operation of the aircraft under the Minimum Equipment List."
      },
      {
        "quote_ref": "F015",
        "scope_refs": [],
        "kind": "permission",
        "meaning": "The letter of authorization authorizing operation under the Minimum Equipment List may be obtained by written request of the airworthiness certificate holder."
      },
      {
        "quote_ref": "F015",
        "scope_refs": [],
        "kind": "statement",
        "meaning": "The Minimum Equipment List and the letter of authorization constitute a supplemental type certificate for the aircraft."
      },
      {
        "quote_ref": "F017",
        "scope_refs": [
          "F013",
          "F016"
        ],
        "kind": "condition",
        "meaning": "As a condition for takeoff with inoperative instruments or equipment installed under paragraph (a), the approved Minimum Equipment List must be prepared in accordance with the limitations specified in paragraph (b) of § 91.213."
      },
      {
        "quote_ref": "F018",
        "scope_refs": [
          "F013",
          "F016"
        ],
        "kind": "condition",
        "meaning": "As a condition for takeoff with inoperative instruments or equipment installed under paragraph (a), the approved Minimum Equipment List must provide for the operation of the aircraft with the instruments and equipment in an inoperable condition."
      },
      {
        "quote_ref": "F019",
        "scope_refs": [
          "F013"
        ],
        "kind": "condition",
        "meaning": "As a condition for takeoff with inoperative instruments or equipment installed under paragraph (a), the aircraft records available to the pilot must include an entry describing the inoperable instruments and equipment."
      },
      {
        "quote_ref": "F020",
        "scope_refs": [
          "F013"
        ],
        "kind": "condition",
        "meaning": "As a condition for takeoff with inoperative instruments or equipment installed under paragraph (a), the aircraft must be operated under all applicable conditions and limitations contained in the Minimum Equipment List and the letter authorizing the use of the list."
      },
      {
        "quote_ref": "F022",
        "scope_refs": [
          "F021"
        ],
        "kind": "prohibition",
        "meaning": "Instruments and equipment that are either specifically or otherwise required by the airworthiness requirements under which the aircraft is type certificated, and which are essential for safe operations under all operating conditions, may not be included in a Minimum Equipment List."
      },

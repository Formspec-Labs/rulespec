      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:d3163834297de6117b286add2ee4caddd9960f591ef59bd36aca8012285bbf73",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:fcb2b26e641e7e175565ae98ffcbb0cbbbe85f4676c273ea2946a29324a00a6d",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:b5801f6589a32512c5bf75b4ede36d902bcd7011b8cef69efb0243a8ef000569",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:states-requirement",
      "rkaf:assertsValue": {
        "@value": "The records supporting hazardous waste determinations must include, but are not limited to, the results of any tests, sampling, waste analyses, or other determinations made in accordance with 40 CFR 262.11; records documenting the tests, sampling, and analytical methods used to demonstrate the validity and relevance of such tests; records consulted in order to determine the process by which the waste was generated, the composition of the waste, and the properties of the waste; and records which explain the knowledge basis for the generator's determination, as described at paragraph (d)(1) of 40 CFR 262.11.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

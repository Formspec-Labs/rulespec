      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"The person\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:3abee87821b120e6bfdd98f916e4c6c0f173a7b46d4b3d5253067b46a09f28cf\",\"urn:rulespec:document-understanding:assertion:5966b43c520cb61f33983e49fa7df14f48976e9a3c4ab42f94918bf8fd3e3980\",\"urn:rulespec:document-understanding:assertion:39a4509064e06fe5ea27148c21e28abc93486d949db96e56651ceea3a46cd6ef\",\"urn:rulespec:document-understanding:assertion:6ba66a1d3b13a27d5b6a297355b2832e435b38e2e2bb67e1aeb624287c7e6c86\",\"urn:rulespec:document-understanding:assertion:fc2f63d153cccb8ebf6f54b62131daffd21ef31b33f32664ee45dc771dd2a107\"],\"choice_quote\":\"(d) The person then must also determine whether the waste exhibits one or more hazardous characteristics as identified in subpart C of 40 CFR part 261 by following the procedures in paragraph (d)(1) or (2) of this section, or a combination of both.\",\"choice_text\":\"Following the procedures in paragraph (d)(1), paragraph (d)(2), or a combination of both paragraph (d)(1) and (d)(2).\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":2036,\"evidence\":[{\"end\":2036,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A5c379a4fd8236d71d58ef3bb692ffb0a541a03554c94a5f55d85d3262b9e7e16:1788:2036:sha256-a3e6c85eb05f63397a3389dd6b8fa751a229bdaeacd5c69efb9c0416e2235760\",\"quote\":\"(d) The person then must also determine whether the waste exhibits one or more hazardous characteristics as identified in subpart C of 40 CFR part 261 by following the procedures in paragraph (d)(1) or (2) of this section, or a combination of both.\",\"start\":1788},{\"end\":1802,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A5c379a4fd8236d71d58ef3bb692ffb0a541a03554c94a5f55d85d3262b9e7e16:1792:1802:sh
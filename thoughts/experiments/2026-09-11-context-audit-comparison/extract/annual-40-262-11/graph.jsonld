    {
      "@id": "urn:rulespec:document-understanding:revision:5c0ce30f62f6dd70118984c245d58bb7eefb409916f271dc7bea2e6b679bdd29",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:5c0ce30f62f6dd70118984c245d58bb7eefb409916f271dc7bea2e6b679bdd29",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:410d9864e059aa817ad60c472f7fcf2bb2129503569a2964b7217aec9db49269",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"Persons testing their waste\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:b7bf6858598ea36ec251d296158d138cae464ed73e58b6c901cb59800e43444f\",\"urn:rulespec:document-understanding:assertion:3c5ed1328e6c768ccb8b1312fe60ab4d44130dd1dcbba500eabdbc121f4d1c64\",\"urn:rulespec:document-understanding:assertion:b2d3e90c22a2a2c3d2b0f297186a51f8b127bdd89168c3b8eec1417812559130\",\"urn:rulespec:document-understanding:assertion:87e3a1335453621b34fdab0c47c56ac99d9dd7a6f5e1b10ef831f4e9fba6c6e5\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":3234,\"evidence\":[{\"end\":3234,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A5c379a4fd8236d71d58ef3bb692ffb0a541a03554c94a5f55d85d3262b9e7e16:2038:3234:sha256-74337c5018a7bb475143cb911bb5d620354447cdb752ec235107d0c40a47e34f\",\"quote\":\"(1) The person must apply knowledge of the hazard characteristic of the waste in light of the materials or the processes used to generate the waste. Acceptable knowledge may include process knowledge ( e.g., information about chemical feedstocks and other inputs to the production process); knowledge of products, by-products, and intermediates produced by the manufacturing process; chemical or physical characterization of wastes; information on the chemical and physical properties of the chemicals used or produced by the process or otherwise contained in the waste; testing that illustrates the properties of the waste; or other reliable and relevant information about the properties of the waste or its constituents. A test other than a test method set forth in subpart C of 40 CFR part 261, or an equivalent test method approved by the Administrator under 40 CFR 260.21, may be used as part of a person's knowledge to determine whether a solid waste exhibits a characteristic of hazardous waste. However, such tests do not, by themselves, provide definitive results. Persons testing their waste must obtain a representative sample of the waste for the testing, as defined at 40 CFR 260.10.\",\"start\":2038},{\"end\":3139,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A5c379a4fd8236d71d58ef3bb692ffb0a541a03554c94a5f55d85d3262b9e7e16:3112:3139:sha256-2307fdcbbcf7fbe8c0e0f5ebbe1b8331b89cd0bfbec757ed81820fc38b36070e\",\"quote\":\"Persons testing their waste\",\"start\":3112}],\"id\":\"urn:rulespec:document-understanding:revision:5c0ce30f62f6dd70118984c245d58bb7eefb409916f271dc7bea2e6b679bdd29\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:87e3a1335453621b34fdab0c47c56ac99d9dd7a6f5e1b10ef831f4e9fba6c6e5\",\"modality\":\"must\",\"modality_quote\":\"must\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:83d41681649aa5b96ce1763048bc7b29ccc204d3fe7dbf7260efd4572072883c\",\"origin\":\"aiSuggested\",\"quote\":\"(1) The person must apply knowledge of the hazard characteristic of the waste in light of the materials or the processes used to generate the waste. Acceptable knowledge may include process knowledge ( e.g., information about chemical feedstocks and other inputs to the production process); knowledge of products, by-products, and intermediates produced by the manufacturing process; chemical or physical characterization of wastes; information on the chemical and physical properties of the chemicals used or produced by the process or otherwise contained in the waste; testing that illustrates the properties of the waste; or other reliable and relevant information about the properties of the waste or its constituents. A test other than a test method set forth in subpart C of 40 CFR part 261, or an equivalent test method approved by the Administrator under 40 CFR 260.21, may be used as part of a person's knowledge to determine whether a solid waste exhibits a characteristic of hazardous waste. However, such tests do not, by themselves, provide definitive results. Persons testing their waste must obtain a representative sample of the waste for the testing, as defined at 40 CFR 260.10.\",\"references\":[\"40 CFR 260.10\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:0df3e679462cfda1839d4fd8e0ccfb80610c0c1edf44537e12b06d3228ad3742\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":2038,\"summary\":\"Persons testing their waste under paragraph (d)(1) of 40 CFR 262.11 must obtain a representative sample of the waste for the testing, as defined at 40 CFR 260.10.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

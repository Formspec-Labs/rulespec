      "rkaf:assertsValue": {
        "@value": "{\"kind\":\"requirement\",\"modality\":\"must\",\"summary\":\"The records supporting hazardous waste determinations must comprise the generator's knowledge of the waste and support the generator's determination, as described at paragraphs (c) and (d) of 40 CFR 262.11.\"}",
        "@type": "xsd:string"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },
    {
      "@id": "urn:rulespec:document-understanding:binding:8f0c70f578159525a95c69b69fdb49b54daa613c7d5b1715f1efd47c7b5ea43a",
      "@type": "rkaf:EvidenceBinding",
      "rkaf:bindsAssertion": "urn:rulespec:document-understanding:assertion:b4f7b16eddd1ae1b6e99f441dfa2a016157493554ea074b9c9b973420203ef7d",
      "rkaf:evidenceRole": "rkaf:textualEvidence",
      "rkaf:evidentiaryFunction": "rkaf:supports",
      "rkaf:bindsSourceFragment": [
        "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A5c379a4fd8236d71d58ef3bb692ffb0a541a03554c94a5f55d85d3262b9e7e16:4108:5511:sha256-fc3d30c1f6eef2f90798702798e9186041f8904b3b756a0687fc915051d7656b"
      ]
    },
    {
      "@id": "urn:rulespec:document-understanding:revision:64bfeb38063a244132676286efcf831f6d2241c1e5ea015e2bfb792643189f31",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:64bfeb38063a244132676286efcf831f6d2241c1e5ea015e2bfb792643189f31",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:20fc859b51f3fba1ded1a275e36b27b44e7497f21b2ddfdd8daf5f32cfe00a2d",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:6a3e552d5cff6d6dcfc9cb722715c2e341aa92f6472359af3a440eb2613664cc\",\"urn:rulespec:document-understanding:assertion:09ee0f699adc49bed5290198a6103244cfacd86426a99b7275cd508c612eb540\",\"urn:rulespec:document-understanding:assertion:b4f7b16eddd1ae1b6e99f441dfa2a016157493554ea074b9c9b973420203ef7d\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":5511,\"evidence\":[{\"end\":5511,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A5c379a4fd8236d71d58ef3bb692ffb0a541a03554c94a5f55d85d3262b9e7e16:4108:5511:sha256-fc3d30c1f6eef2f90798702798e9186041f8904b3b756a0687fc915051d7656b\",\"quote\":\"(f) Recordkeeping for small and large quantity generators. A small or large quantity generator must maintain records supporting its hazardous waste determinations, including records that identify whether a solid waste is a hazardous waste, as defined by 40 CFR 261.3. Records must be maintained for at least three years from the date that the waste was last sent to on-site or off-site treatment, storage, or disposal. These records must comprise the generator's knowledge of the waste and support the generator's determination, as described at paragraphs (c) and (d) of this section. The records must include, but are not limited to, the following types of information: The results of any tests, sampling, waste analyses, or other determinations made in accordance with this section; records documenting the tests, sampling, and analytical methods used to demonstrate the validity and relevance of such tests; records consulted in order to determine the process by which the waste was generated, the composition of the waste, and the properties of the waste; and records which explain the knowledge basis for the generator's determination, as described at paragraph (d)(1) of this section. The periods of record retention referred to in this section are extended automatically during the course of any unresolved enforcement action regarding the regulated activity or as requested by the Administrator.\",\"start\":4108}],\"id\":\"urn:rulespec:document-understanding:revision:64bfeb38063a244132676286efcf831f6d2241c1e5ea015e2bfb792643189f31\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:b4f7b16eddd1ae1b6e99f441dfa2a016157493554ea074b9c9b973420203ef7d\",\"modality\":\"must\",\"modality_quote\":\"must\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:b7459921b7310bd92d8865e13b1b0b5e3b635f67e305a2e5e3a09c3900fe207d\",\"origin\":\"aiSuggested\",\"quote\":\"(f) Recordkeeping for small and large quantity generators. A small or large quantity generator must maintain records supporting its hazardous waste determinations, including records that identify whether a solid waste is a hazardous waste, as defined by 40 CFR 261.3. Records must be maintained for at least three years from the date that the waste was last sent to on-site or off-site treatment, storage, or disposal. These records must comprise the generator's knowledge of the waste and support the generator's determination, as described at paragraphs (c) and (d) of this section. The records must include, but are not limited to, the following types of information: The results of any tests, sampling, waste analyses, or other determinations made in accordance with this section; records documenting the tests, sampling, and analytical methods used to demonstrate the validity and relevance of such tests; records consulted in order to determine the process by which the waste was generated, the composition of the waste, and the properties of the waste; and records which explain the knowledge basis for the generator's determination, as described at paragraph (d)(1) of this section. The periods of record retention referred to in this section are extended automatically during the course of any unresolved enforcement action regarding the regulated activity or as requested by the Administrator.\",\"references\":[\"paragraphs (c) and (d) of this section\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:859fdc75cd4d08c01429e9edb8107fbdd9846e87f37c5fcb637c09a2122e1ee0\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":4108,\"summary\":\"The records supporting hazardous waste determinations must comprise the generator's knowledge of the waste and support the generator's determination, as described at paragraphs (c) and (d) of 40 CFR 262.11.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

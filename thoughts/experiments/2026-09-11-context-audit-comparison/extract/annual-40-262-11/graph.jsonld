      "rkaf:assertsValue": {
        "@value": "{\"actor\":\"The person\",\"kind\":\"requirement\",\"modality\":\"must\",\"summary\":\"Under paragraph (d)(1) of 40 CFR 262.11, the person must apply knowledge of the hazard characteristic of the waste in light of the materials or the processes used to generate the waste.\"}",
        "@type": "xsd:string"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },
    {
      "@id": "urn:rulespec:document-understanding:binding:e297068e7a48540b0aa63a060dac3a7f20b35b1f8bd6a3bb54190d2dd5e867aa",

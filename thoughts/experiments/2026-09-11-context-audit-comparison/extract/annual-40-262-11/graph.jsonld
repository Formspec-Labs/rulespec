      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:d3163834297de6117b286add2ee4caddd9960f591ef59bd36aca8012285bbf73",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:fcb2b26e641e7e175565ae98ffcbb0cbbbe85f4676c273ea2946a29324a00a6d",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:859fdc75cd4d08c01429e9edb8107fbdd9846e87f37c5fcb637c09a2122e1ee0",

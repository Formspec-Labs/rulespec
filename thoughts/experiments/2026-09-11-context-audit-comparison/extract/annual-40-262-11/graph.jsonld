      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:d3163834297de6117b286add2ee4caddd9960f591ef59bd36aca8012285bbf73",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:fcb2b26e641e7e175565ae98ffcbb0cbbbe85f4676c273ea2946a29324a00a6d",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:a3557f6146fb387ca2bd9576a0ca844ac75f21fb4527c584c4f5124e399ae331",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"kind\":\"permission\",\"modality\":\"may\",\"summary\":\"A test other than a test method set forth in subpart C of 40 CFR part 261, or an equivalent test method approved by the Administrator under 40 CFR 260.21, may be used as part of a person's knowledge to determine whether a solid waste exhibits a characteristic of hazardous waste.\"}",
        "@type": "xsd:string"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },
    {
      "@id": "urn:rulespec:document-understanding:binding:238e1cbfa8f23df4944474f64285496a1605f238ba6717065c9d941e8f551a69",
      "@type": "rkaf:EvidenceBinding",
      "rkaf:bindsAssertion": "urn:rulespec:document-understanding:assertion:8100fa7234955801814ef72f191985b204f0e32a3b2d5a0c5794501af7c4b564",

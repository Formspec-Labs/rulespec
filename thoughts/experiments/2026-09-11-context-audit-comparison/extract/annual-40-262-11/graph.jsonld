      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:7b8f830943e9ea75125ff1c04eaf6614fd8cdad4a163f9677bbaea6700804d70",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"actor\":\"A small or large quantity generator\",\"kind\":\"requirement\",\"modality\":\"must\",\"summary\":\"A small or large quantity generator must maintain records supporting its hazardous waste determinations, including records that identify whether a solid waste is a hazardous waste, as defined by 40 CFR 261.3.\"}",
        "@type": "xsd:string"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },
    {
      "@id": "urn:rulespec:document-understanding:binding:c7456bbd3ebcd413f6cdb4fb0ff37629d46b02282d8aa9c77cb0348a4f331a7b",
      "@type": "rkaf:EvidenceBinding",
      "rkaf:bindsAssertion": "urn:rulespec:document-understanding:assertion:a1f7b751488fbc6d187ba297aa9dfdc5277e490e54e05b40672d4a68875fa6cf",
      "rkaf:evidenceRole": "rkaf:textualEvidence",

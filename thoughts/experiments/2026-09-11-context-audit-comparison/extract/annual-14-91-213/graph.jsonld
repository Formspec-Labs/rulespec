      "rkaf:assertsValue": {
        "@value": "{\"kind\":\"requirement\",\"modality\":\"must\",\"scope_text\":\"Except as provided in paragraph (d) of this section, when taking off an aircraft with inoperative instruments or equipment installed\",\"summary\":\"Except as provided in paragraph (d) of 14 CFR § 91.213, for a person to take off an aircraft with inoperative instruments or equipment installed under paragraph (a), the aircraft must have within it a letter of authorization, issued by the responsible Flight Standards office, authorizing operation of the aircraft under the Minimum Equipment List.\"}",
        "@type": "xsd:string"
      },

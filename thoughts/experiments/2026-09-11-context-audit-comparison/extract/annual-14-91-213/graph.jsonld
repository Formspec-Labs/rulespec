ent:urn%3Arulespec%3Adocument-understanding%3Adocument%3A96a73c39ca907bf11c7fea28a9620736513a1fbfb20fe40e84c76a11d83dc5bd:2275:2279:sha256-4137b01e139589b7a1d3b3fc4da031d8ce5bb415808734e970c3a58ea0e98f0f\",\"quote\":\"must\",\"start\":2275}],\"id\":\"urn:rulespec:document-understanding:revision:2ac8699b32c23e45262b9327061440d734b36d86a9120c7eabccfc4a205f5322\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:46980367a689bc75630ef65ec430675fefe953e96f87ab0db0d0f7017ba68374\",\"modality\":\"must\",\"modality_quote\":\"must\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:53af392bdf5e2ba0668f78df8b65422c6870dc48657b5ec265a4614d952ed935\",\"origin\":\"aiSuggested\",\"quote\":\"(c) A person authorized to use an approved Minimum Equipment List issued for a specific aircraft under subpart K of this part, part 121, 125, or 135 of this chapter must use that Minimum Equipment List to comply with the requirements in this section.\",\"references\":[\"subpart K of this part\",\"part 121\",\"part 125\",\"part 135 of this chapter\",\"this section\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:b40cc2de0143596580e8b0014fff905c34e04d71e773263f42c2e5d27aac7077\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":2110,\"summary\":\"A person authorized to use an approved Minimum Equipment List issued for a specific aircraft under subpart K of this part, part 121, 125, or 135 of this chapter must use that Minimum Equipment List to comply with the requirements in 14 CFR § 91.213.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

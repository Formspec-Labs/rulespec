      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:93144505ece62ac1e32128b9dfc6dfe9d8bb09a59604018d5a53d93af2355d6f\",\"urn:rulespec:document-understanding:assertion:d54db4ac50801896a3fc3b7ce6b831acf695af2c1a4fe892f56941b3900f37d8\",\"urn:rulespec:document-understanding:assertion:f817a4129dd62770f4aa7d6cb3ba9697f6aa2e91fe6943c3cad79b22805d29f9\",\"urn:rulespec:document-understanding:assertion:f1a317913789fd05b98b4d46f6fc2f06fe952aa68634befc091a2960fb9c46ea\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[\"(d) Except for operations conducted in accordance with paragraph (a) or (c) of this section, a person may takeoff an aircraft in operations conducted under this part with inoperative instruments and equipment without an approved Minimum Equipment List provided—\",\"(3) The inoperative instruments and equipment are—\"],\"defined_terms\":[],\"effective_periods\":[],\"end\":4012,\"evidence\":[{\"end\":4012,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A96a73c39ca907bf11c7fea28a9620736513a1fbfb20fe40e84c76a11d83dc5bd:3801:4012:sha256-67c047adf831db3c6341f1def8aa7113f1786b8ac5aca3176e69078158b8b982\",\"quote\":\"(ii) Deactivated and placarded “Inoperative.” If deactivation of the inoperative instrument or equipment involves maintenance, it must be accomplished and recorded in accordance with part 43 of this chapter; and\",\"start\":3801},{\"end\":3935,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A96a73c39ca907bf11c7fea28a9620736513a1fbfb20fe40e84c76a11d83dc5bd:3931:3935:sha256-4137b01e139589b7a1d3b3fc4da031d8ce5bb415808734e970c3a58ea0e98f0f\",\"quote\":\"must\",\"start\":3931},{\"end\":4012,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A96a73c39ca907bf11c7fea28a9620736513a1fbfb20fe40e84c76a11d83dc5bd:3801:4012:sha256-67c047adf831db3c6341f1def8aa7113f1786b8ac5aca3176e69078158b8b982\",\"quote\":\"(ii) Deactivated and placarded “Inoperative.” If deactivation of the inoperative instrument or equipment involves maintenance, it must be accomplished and recorded in accordance with part 43 of this chapter; and\",\"start\":3801},{\"end\":2623,\"field\":\"context:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A96a73c39ca907bf11c7fea28a9620736513a1fbfb20fe40e84c76a11d83dc5bd:2362:2623:sha256-75033198ce3b775e26f9e0522d8afba363c75a258caf843b2e4a59c04b320c11\",\"quote\":\"(d) Except for operations conducted in accordance with paragraph (a) or (c) of this section, a person may takeoff an aircraft in operations conducted under this part with inoperative instruments and equipment without an approved Minimum Equipment List provided—\",\"start\":2362},{\"end\":3661,\"field\":\"context:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A96a73c39ca907bf11c7fea28a9620736513a1fbfb20fe40e84c76a11d83dc5bd:3611:3661:sha256-2c78dad90181619f89e7e01736bb55ddbb85ff4d47f5c71ae23f8282aebe60ec\",\"quote\":\"(3) The inoperative instruments and equipment are—\",\"start\":3611}],\"id\":\"urn:rulespec:document-understanding:revision:26f7842e493c56e0cc001db57b2f12a732c57edcd5c5fd185937f3f3786ed151\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:f1a317913789fd05b98b4d46f6fc2f06fe952aa68634befc091a2960fb9c46ea\",\"modality\":\"must\",\"modality_quote\":\"must\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:9177a683513f97f98b2c96608514ece2955cad262a26528a255aa2aeea3088e0\",\"origin\":\"aiSuggested\",\"quote\":\"(ii) Deactivated and placarded “Inoperative.” If deactivation of the inoperative instrument or equipment involves maintenance, it must be accomplished and recorded in accordance with part 43 of this chapter; and\",\"references\":[\"part 43 of this chapter\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:a7fd378d806f5fcb56fbd80c6014a1cee83e6e4791cb54eb4eac8de550e9b9ca\",\"scope_quotes\":[\"(ii) Deactivated and placarded “Inoperative.” If deactivation of the inoperative instrument or equipment involves maintenance, it must be accomplished and recorded in accordance with part 43 of this chapter; and\"],\"scope_text\":\"If deactivation of the inoperative instrument or equipment involves maintenance\",\"section_id\":\"section-1\",\"start\":3801,\"summary\":\"When inoperative instruments and equipment are deactivated and placarded 'Inoperative' under paragraph (d)(3)(ii) of 14 CFR § 91.213, if deactivation of the inoperative instrument or equipment involves maintenance, it must be accomplished and recorded in accordance with part 43 of this chapter.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

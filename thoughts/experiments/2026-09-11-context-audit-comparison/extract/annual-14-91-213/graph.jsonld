      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:ae3bd75761db9053abac3a59a37f55094fad2b40e0f082a7d62f10845cae0b2a\",\"urn:rulespec:document-understanding:assertion:08c810b27bd591b55eb25b8435fffebaa05bb6fb0a4c7ca31e200c5d88223676\",\"urn:rulespec:document-understanding:assertion:6355a1615707686c2fe981677afe3f478585061efa3697cb7c627c34518b5fc2\",\"urn:rulespec:document-understanding:assertion:19c098b2fbd75d9e2a4d9c37fac97c31828b703fac82e9a6e34d0aa2d1df165c\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":997,\"evidence\":[{\"end\":997,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A96a73c39ca907bf11c7fea28a9620736513a1fbfb20fe40e84c76a11d83dc5bd:593:997:sha256-69b330280be0abc9816c0f68d412a870ba9dea545c3c1b336c587ea6ee431655\",\"quote\":\"(2) The aircraft has within it a letter of authorization, issued by the responsible Flight Standards office, authorizing operation of the aircraft under the Minimum Equipment List. The letter of authorization may be obtained by written request of the airworthiness certificate holder. The Minimum Equipment List and the letter of authorization constitute a supplemental type certificate for the aircraft.\",\"start\":593},{\"end\":524,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A96a73c39ca907bf11c7fea28a9620736513a1fbfb20fe40e84c76a11d83dc5bd:485:524:sha256-cca9aeaa3bce93ebae9743f848d5b9bdb4a02afb6707fe012fc316134c0c70fb\",\"quote\":\"unless the following conditions are met\",\"start\":485},{\"end\":525,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A96a73c39ca907bf11c7fea28a9620736513a1fbfb20fe40e84c76a11d83dc5bd:341:525:sha256-9ad9ba26b25608f46054b7f6773aa3cbc1dd18e250c578279445b79357a33342\",\"quote\":\"(a) Except as provided in paragraph (d) of this section, no person may take off an aircraft with inoperative instruments or equipment installed unless the following conditions are met:\",\"start\":341}],\"id\":\"urn:rulespec:document-understanding:revision:864988f1b5f1e56cb23810955e62f0e47bce96389565c11bad1db148edef75ae\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:19c098b2fbd75d9e2a4d9c37fac97c31828b703fac82e9a6e34d0aa2d1df165c\",\"modality\":\"must\",\"modality_quote\":\"unless the following conditions are met\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:7157f2c784c72c722d731029647b2b2fb6ae2304da3a56822083cf8200414a9f\",\"origin\":\"aiSuggested\",\"quote\":\"(2) The aircraft has within it a letter of authorization, issued by the responsible Flight Standards office, authorizing operation of the aircraft under the Minimum Equipment List. The letter of authorization may be obtained by written request of the airworthiness certificate holder. The Minimum Equipment List and the letter of authorization constitute a supplemental type certificate for the aircraft.\",\"references\":[\"paragraph (d) of this section\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:397670d594b5c75c2691314542059940e689487e1cb3695f612ac2f306a23892\",\"scope_quotes\":[\"(a) Except as provided in paragraph (d) of this section, no person may take off an aircraft with inoperative instruments or equipment installed unless the following conditions are met:\"],\"scope_text\":\"Except as provided in paragraph (d) of this section, when taking off an aircraft with inoperative instruments or equipment installed\",\"section_id\":\"section-1\",\"start\":593,\"summary\":\"Except as provided in paragraph (d) of 14 CFR § 91.213, for a person to take off an aircraft with inoperative instruments or equipment installed under paragraph (a), the aircraft must have within it a letter of authorization, issued by the responsible Flight Standards office, authorizing operation of the aircraft under the Minimum Equipment List.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

      "@id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A96a73c39ca907bf11c7fea28a9620736513a1fbfb20fe40e84c76a11d83dc5bd:1547:2108:sha256-770e61938600734e562258177c8d7bf00512af34e95a4e080220bea3faef6312",

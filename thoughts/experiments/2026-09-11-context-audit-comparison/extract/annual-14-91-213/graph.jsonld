    {
      "@id": "urn:rulespec:document-understanding:revision:b8c5fe4b2aef75e33c2fa8a61c7b76adac501578fe0043acfebfcaf81407b188",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:b8c5fe4b2aef75e33c2fa8a61c7b76adac501578fe0043acfebfcaf81407b188",

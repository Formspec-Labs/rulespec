      ],
      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "(b) The following instruments and equipment may not be included in a Minimum Equipment List:\n\n(1) Instruments and equipment that are either specifically or otherwise required by the airworthiness requirements under which the aircraft is type certificated and which are essential for safe operations under all operating conditions.\n\n(2) Instruments and equipment required by an airworthiness directive to be in operable condition unless the airworthiness directive provides otherwise.\n\n(3) Instruments and equipment required for specific operations by this part."
        },
        {
          "@type": "oa:TextPositionSelector",
          "oa:start": 1547,
          "oa:end": 2108,
          "rkaf:coordinateSystem": "rkaf:unicode-codepoint"
        }
      ]

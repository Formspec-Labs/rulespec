      "rkaf:assertsValue": {
        "@value": "{\"kind\":\"requirement\",\"modality\":\"must\",\"scope_text\":\"Except as provided in paragraph (d) of this section, when taking off an aircraft with inoperative instruments or equipment installed\",\"summary\":\"Except as provided in paragraph (d) of 14 CFR § 91.213, for a person to take off an aircraft with inoperative instruments or equipment installed under paragraph (a), the approved Minimum Equipment List must be prepared in accordance with the limitations specified in paragraph (b) of this section and must provide for the operation of the aircraft with the instruments and equipment in an inoperable condition.\"}",
        "@type": "xsd:string"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed",

    {
      "@id": "urn:rulespec:document-understanding:assertion:cdad9ea8510f720db9ec40b37fbe095ef6c9eaa62b776032dc3b48f5f6564139",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:9fd82af26064e7d91aa4a60a8400875c87602988ffef5fbe12864f52ee71d39a",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:b9ed6ae97f33b0582e434284761cbae4fd685e63e67a36353a42d999ea704f4f",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:d4f6a5b0a6ea7f75a18829f48505e88af565e224943c8a400c7f55ca0da49f3f",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:states-requirement",
      "rkaf:assertsValue": {
        "@value": "Except as provided in paragraph (d) of 14 CFR § 91.213, for a person to take off an aircraft with inoperative instruments or equipment installed under paragraph (a), the approved Minimum Equipment List must be prepared in accordance with the limitations specified in paragraph (b) of this section and must provide for the operation of the aircraft with the instruments and equipment in an inoperable condition.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

      ],
      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "(2) The aircraft has within it a letter of authorization, issued by the responsible Flight Standards office, authorizing operation of the aircraft under the Minimum Equipment List. The letter of authorization may be obtained by written request of the airworthiness certificate holder. The Minimum Equipment List and the letter of authorization constitute a supplemental type certificate for the aircraft."
        },
        {
          "@type": "oa:TextPositionSelector",
          "oa:start": 593,
          "oa:end": 997,
          "rkaf:coordinateSystem": "rkaf:unicode-codepoint"
        }

      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:974aeccc64658942437b33d39b1cf606e43f223249d55a8118401d039cfd8da8\",\"urn:rulespec:document-understanding:assertion:9c684b049e6e1dd08ca6f98f66f5586ce6cc8eb3f1f4f2bde977d3d9807ee101\",\"urn:rulespec:document-understanding:assertion:c5865c17d5969321e8a35b7c7932cfcfe341b8dbc97a9a2dfaf2922e20483bf5\",\"urn:rulespec:document-understanding:assertion:1d244ee0904ffb07b57c4aa00a282b0520dad2617a9485b8a429be7283581347\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":1545,\"evidence\":[{\"end\":1545,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A96a73c39ca907bf11c7fea28a9620736513a1fbfb20fe40e84c76a11d83dc5bd:1381:1545:sha256-4912c7ebf944799302fcffe2daa73afbad9f9346d79749e4c7f8078e072d16fe\",\"quote\":\"(5) The aircraft is operated under all applicable conditions and limitations contained in the Minimum Equipment List and the letter authorizing the use of the list.\",\"start\":1381},{\"end\":524,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A96a73c39ca907bf11c7fea28a9620736513a1fbfb20fe40e84c76a11d83dc5bd:485:524:sha256-cca9aeaa3bce93ebae9743f848d5b9bdb4a02afb6707fe012fc316134c0c70fb\",\"quote\":\"unless the following conditions are met\",\"start\":485},{\"end\":525,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A96a73c39ca907bf11c7fea28a9620736513a1fbfb20fe40e84c76a11d83dc5bd:341:525:sha256-9ad9ba26b25608f46054b7f6773aa3cbc1dd18e250c578279445b79357a33342\",\"quote\":\"(a) Except as provided in paragraph (d) of this section, no person may take off an aircraft with inoperative instruments or equipment installed unless the following conditions are met:\",\"start\":341}],\"id\":\"urn:rulespec:document-understanding:revision:2e2f6c240843a716a12a5b4aeb9b58f4ee4db6da707bb249a1cf639c663264a3\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:1d244ee0904ffb07b57c4aa00a282b0520dad2617a9485b8a429be7283581347\",\"modality\":\"must\",\"modality_quote\":\"unless the following conditions are met\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:9e26ca6b62eaf016e71121b4b2edd102fab3bd547d8288bfd429e22a6ac91534\",\"origin\":\"aiSuggested\",\"quote\":\"(5) The aircraft is operated under all applicable conditions and limitations contained in the Minimum Equipment List and the letter authorizing the use of the list.\",\"references\":[\"paragraph (d) of this section\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:2d5b707d7071682d2327310671c58bd29c9448231f6b021249eabb20ac16b1e2\",\"scope_quotes\":[\"(a) Except as provided in paragraph (d) of this section, no person may take off an aircraft with inoperative instruments or equipment installed unless the following conditions are met:\"],\"scope_text\":\"Except as provided in paragraph (d) of this section, when taking off an aircraft with inoperative instruments or equipment installed\",\"section_id\":\"section-1\",\"start\":1381,\"summary\":\"Except as provided in paragraph (d) of 14 CFR § 91.213, for a person to take off an aircraft with inoperative instruments or equipment installed under paragraph (a), the aircraft must be operated under all applicable conditions and limitations contained in the Minimum Equipment List and the letter authorizing the use of the list.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

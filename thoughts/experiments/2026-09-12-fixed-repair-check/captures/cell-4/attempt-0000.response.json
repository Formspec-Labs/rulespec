            "text": "{\n  \"judgments\": [\n    {\n      \"proposal_id\": \"P0000\",\n      \"source_refs\": [\"F001\", \"F003\"],\n      \"rationale\": \"Clause (ii) in F001 imposes the requirement to include the applicant's name and reference number specifically on electronic requests under clause (i) of that section (F000). It does not apply to inspecting public records under clause (i) of the subsequent section (F003). Imposing this condition on public record inspections is entirely ungrounded.\",\n      \"verdict\": \"unsupported\"\n    },\n    {\n      \"proposal_id\": \"P0001\",\n      \"source_refs\": [\"F000\", \"F002\"],\n      \"rationale\": \"F002 requires the agency to publish annual statistics on requests submitted under clause (i). It does not make agency publication of statistics a prerequisite condition for applicants submitting a request.\",\n      \"verdict\": \"unsupported\"\n    },\n    {\n      \"proposal_id\": \"P0002\",\n      \"source_refs\": [\"F000\", \"F002\"],\n      \"rationale\": \"F002 mandates that the agency publish annual statistics on requests submitted under clause (i). Attributing the obligation to publish statistics to the applicants contradicts the source text.\",\n      \"verdict\": \"unsupported\"\n    },\n    {\n      \"proposal_id\": \"P0003\",\n      \"source_refs\": [\"F000\", \"F001\"],\n      \"rationale\": \"F000 grants applicants a permission to submit requests electronically, while F001 establishes an independent requirement already captured by claim C0001. Embedding the mandatory content of F001 into C0000 conflates distinct provisions with different modal forces, introduces a duplicate duty, and does not fix an actual defect in C0000.\",\n      \"verdict\": \"unsupported\"\n    }\n  ]\n}",

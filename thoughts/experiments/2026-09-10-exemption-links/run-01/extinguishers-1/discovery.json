      "claim_ids": [],
      "evidence_refs": [
        {
          "id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A5d3d4365a7e56c25fd7ccacb7f4fe63129f97cd8ab4523042c0ce9159b1b2afa:2133:2303:sha256-4272a7296b0c99bcb2c6be3df5c397182dbe1fe40726e2d676f211f0307f3c03",

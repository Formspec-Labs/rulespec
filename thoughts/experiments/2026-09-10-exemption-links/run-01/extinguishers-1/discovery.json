    {
      "id": "urn:rulespec:document-understanding:passage:69cd3e3acea11c69f6f02c109591cfc7525f3bff436cb36f43854ef966cb5de6",
      "source": "urn:rulespec:document-understanding:document:5d3d4365a7e56c25fd7ccacb7f4fe63129f97cd8ab4523042c0ce9159b1b2afa",
      "text": "             (1) Portable fire extinguishers shall be provided for employee use and selected and distributed based on the classes of anticipated workplace fires and on the size and degree of hazard which would affect their use.\n\n",
      "claim_ids": [],
      "evidence_refs": [
        {
          "id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A5d3d4365a7e56c25fd7ccacb7f4fe63129f97cd8ab4523042c0ce9159b1b2afa:2882:3111:sha256-1ea7c841b024b682b38b8e20df930f298db67c14f82b2bf43de1c28e0772d03b",
          "roles": [

          "id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A5d3d4365a7e56c25fd7ccacb7f4fe63129f97cd8ab4523042c0ce9159b1b2afa:3923:4096:sha256-ffba60aa97d1397ae9a27f1273197225b5b1ad146caf99d46c9777564b167269",

      "source": "urn:rulespec:document-understanding:document:5d3d4365a7e56c25fd7ccacb7f4fe63129f97cd8ab4523042c0ce9159b1b2afa",
      "text": "             (1) The employer shall provide portable fire extinguishers and shall mount, locate and identify them so that they are readily accessible to employees without subjecting the employees to possible injury.\n\n",
      "claim_ids": [],
      "evidence_refs": [
        {
          "id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A5d3d4365a7e56c25fd7ccacb7f4fe63129f97cd8ab4523042c0ce9159b1b2afa:1813:2030:sha256-bb35ecdbab2b12be573428c22676f4784c6da955d95c5d7dce89c97a3278eab0",

      "claim_ids": [],
      "evidence_refs": [
        {
          "id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A5d3d4365a7e56c25fd7ccacb7f4fe63129f97cd8ab4523042c0ce9159b1b2afa:2030:2133:sha256-ac91f87ac1901199f8898e5383ba699e5be85e61827382f360a3e42ab9f66de9",

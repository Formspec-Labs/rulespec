      "parent_id": "urn:rulespec:document-understanding:passage:10d74fc90f259f021dad4663fd556e8dcb5d947b13119bc2dfa347ed312a649b",
      "kind": "list_item",
      "structure_method": "text-paragraphs-and-list-markers/2",
      "window_ids": [],
      "processing": "not_recorded"
    },
    {
      "id": "urn:rulespec:document-understanding:passage:22ac1b42bbd49d0afd291ccf56fe0eae20a7d1c753a23d8e48518770908787b2",

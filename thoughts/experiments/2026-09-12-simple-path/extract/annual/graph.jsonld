    {
      "@id": "urn:rulespec:document-understanding:revision:cb534a62536655e58b785fbe62f9f1cf6b48f654649c45391e816e94df22fe83",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:cb534a62536655e58b785fbe62f9f1cf6b48f654649c45391e816e94df22fe83",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:965080037a69a386bc193e19c19d006b675c209d8a003b162dff2985d959c8f7",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:00089798b1f2bf6edf45b5303e25d6bcb04dd2a72bffc0f4e82f98a15d90010b\",\"urn:rulespec:document-understanding:assertion:2944de8eced19ae961bb338c007d925b5f788246ccbf785d26849f2ea1e7855f\",\"urn:rulespec:document-understanding:assertion:5708933d441aa800b5ec45e2a302cc1e10f16a20f94a3baba1e7aa21a96c7bf9\",\"urn:rulespec:document-understanding:assertion:b78162a6334b9d9ebcfc374facda64eb5f3a393de2b79d981a111b1e566df7b9\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[\"(a) A generator may accumulate as much as 55 gallons of non-acute hazardous waste and/or either one quart of liquid acute hazardous waste listed in § 261.31 or § 261.33(e) of this chapter or 1 kg (2.2 lbs) of solid acute hazardous waste listed in § 261.31 or § 261.33(e) of this chapter in containers at or near any point of generation where wastes initially accumulate which is under the control of the operator of the process generating the waste, without a permit or interim status and without complying with the requirements of parts 124, 264 through 267, and 270 of this chapter, provided that all of the conditions for exemption in this section are met. A generator may comply with the conditions for exemption in this section instead of complying with the conditions for exemption in § 262.16(b) or § 262.17(a), except as required in § 262.15(a)(7) and (8). The conditions for exemption for satellite accumulation are:\",\"(3) Special standards for incompatible wastes.\"],\"defined_terms\":[],\"effective_periods\":[],\"end\":2110,\"evidence\":[{\"end\":2110,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ae83b7297b741d59fb878775fd631eeb28a5aa35359e885bf29ca58f62f120732:1911:2110:sha256-43dd43a14f7f7dc5e43ce8a9dfe8457e8486b5e8c91a2114d9f458f15ff31362\",\"quote\":\"(i) Incompatible wastes, or incompatible wastes and materials, (see appendix V of part 265 for examples) must not be placed in the same container, unless § 265.17(b) of this chapter is complied with.\",\"start\":1911},{\"end\":2024,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ae83b7297b741d59fb878775fd631eeb28a5aa35359e885bf29ca58f62f120732:2016:2024:sha256-df0465d9a394078860d809a83f39f74c2e1040a44d5115401199c3e4374d2729\",\"quote\":\"must not\",\"start\":2016},{\"end\":2110,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ae83b7297b741d59fb878775fd631eeb28a5aa35359e885bf29ca58f62f120732:1911:2110:sha256-43dd43a14f7f7dc5e43ce8a9dfe8457e8486b5e8c91a2114d9f458f15ff31362\",\"quote\":\"(i) Incompatible wastes, or incompatible wastes and materials, (see appendix V of part 265 for examples) must not be placed in the same container, unless § 265.17(b) of this chapter is complied with.\",\"start\":1911},{\"end\":1247,\"field\":\"context:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ae83b7297b741d59fb878775fd631eeb28a5aa35359e885bf29ca58f62f120732:322:1247:sha256-9d5462ca5acb5b64b79b4fb6c7300dcb44210d3f68fcb2c26e7ecdffde248bd6\",\"quote\":\"(a) A generator may accumulate as much as 55 gallons of non-acute hazardous waste and/or either one quart of liquid acute hazardous waste listed in § 261.31 or § 261.33(e) of this chapter or 1 kg (2.2 lbs) of solid acute hazardous waste listed in § 261.31 or § 261.33(e) of this chapter in containers at or near any point of generation where wastes initially accumulate which is under the control of the operator of the process generating the waste, without a permit or interim status and without complying with the requirements of parts 124, 264 through 267, and 270 of this chapter, provided that all of the conditions for exemption in this section are met. A generator may comply with the conditions for exemption in this section instead of complying with the conditions for exemption in § 262.16(b) or § 262.17(a), except as required in § 262.15(a)(7) and (8). The conditions for exemption for satellite accumulation are:\",\"start\":322},{\"end\":1909,\"field\":\"context:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ae83b7297b741d59fb878775fd631eeb28a5aa35359e885bf29ca58f62f120732:1863:1909:sha256-9918d7cef1092abb07f2e8c97c89319993cd89bca8b7d58305617877fb0fe4bc\",\"quote\":\"(3) Special standards for incompatible wastes.\",\"start\":1863}],\"id\":\"urn:rulespec:document-understanding:revision:cb534a62536655e58b785fbe62f9f1cf6b48f654649c45391e816e94df22fe83\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"prohibition\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:b78162a6334b9d9ebcfc374facda64eb5f3a393de2b79d981a111b1e566df7b9\",\"modality\":\"must_not\",\"modality_quote\":\"must not\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:36951c64991ebb7e29891179c0cf71e985349859399ff8ea95c7ab8f70628d51\",\"origin\":\"aiSuggested\",\"quote\":\"(i) Incompatible wastes, or incompatible wastes and materials, (see appendix V of part 265 for examples) must not be placed in the same container, unless § 265.17(b) of this chapter is complied with.\",\"references\":[\"appendix V of part 265\",\"§ 265.17(b)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:1a8210371f678aa7696c3e8fd03920290836b6c91ec4e1509ac7771f6c5ccc52\",\"scope_quotes\":[\"(i) Incompatible wastes, or incompatible wastes and materials, (see appendix V of part 265 for examples) must not be placed in the same container, unless § 265.17(b) of this chapter is complied with.\"],\"scope_text\":\"unless § 265.17(b) of this chapter is complied with\",\"section_id\":\"section-1\",\"start\":1911,\"summary\":\"Under the special standards for incompatible wastes in satellite accumulation areas, incompatible wastes, or incompatible wastes and materials, (see appendix V of part 265 for examples) must not be placed in the same container, unless § 265.17(b) of this chapter is complied with.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

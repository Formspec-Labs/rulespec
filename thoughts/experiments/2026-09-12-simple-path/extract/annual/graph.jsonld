      "rkaf:selectorKind": [
        "oa:TextQuoteSelector",
        "oa:TextPositionSelector"
      ],
      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "(4) A container holding hazardous waste must be closed at all times during accumulation, except:\n\n(i) When adding, removing, or consolidating waste; or\n\n(ii) When temporary venting of a container is necessary\n\n(A) For the proper operation of equipment, or\n\n(B) To prevent dangerous situations, such as build-up of extreme pressure."
        },
        {
          "@type": "oa:TextPositionSelector",
          "oa:start": 2558,
          "oa:end": 2889,
          "rkaf:coordinateSystem": "rkaf:unicode-codepoint"
        }
      ]
    },

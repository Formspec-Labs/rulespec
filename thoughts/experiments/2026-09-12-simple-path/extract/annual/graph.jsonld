      "rkaf:assertsValue": {
        "@value": "{\"kind\":\"prohibition\",\"modality\":\"must_not\",\"scope_text\":\"unless § 265.17(b) of this chapter is complied with\",\"summary\":\"Under the special standards for incompatible wastes in satellite accumulation areas, hazardous waste must not be placed in an unwashed container that previously held an incompatible waste or material (see appendix V of part 265 for examples), unless § 265.17(b) of this chapter is complied with.\"}",

    {
      "@id": "urn:rulespec:document-understanding:revision:8f36f5e462d8866d7ec1ca47bd57644041ac3929e003ec503b683689c96adf4b",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:8f36f5e462d8866d7ec1ca47bd57644041ac3929e003ec503b683689c96adf4b",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:a5e13d84465206eee641b5e205fc2c79ed019cd9b261af862935ef12d4c447ca",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:962e86480e770dbe6fd613fee9828160edd1a059eab8c2dd202b1cd35997cdc3\",\"urn:rulespec:document-understanding:assertion:6c97e650bbae21c281dd5b87d9be3e2eac22e558be57629a72a11795ea0cf433\",\"urn:rulespec:document-understanding:assertion:fafb2dc10bcbde8af3b3af8e4e8c620f8ad5938b45534afe5aa9850691d45187\",\"urn:rulespec:document-understanding:assertion:d986b597cb88440c2c04507413e5f7937677bd3ea9fc33f094fdb33e7b8e4a51\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[\"(a) A generator may accumulate as much as 55 gallons of non-acute hazardous waste and/or either one quart of liquid acute hazardous waste listed in § 261.31 or § 261.33(e) of this chapter or 1 kg (2.2 lbs) of solid acute hazardous waste listed in § 261.31 or § 261.33(e) of this chapter in containers at or near any point of generation where wastes initially accumulate which is under the control of the operator of the process generating the waste, without a permit or interim status and without complying with the requirements of parts 124, 264 through 267, and 270 of this chapter, provided that all of the conditions for exemption in this section are met. A generator may comply with the conditions for exemption in this section instead of complying with the conditions for exemption in § 262.16(b) or § 262.17(a), except as required in § 262.15(a)(7) and (8). The conditions for exemption for satellite accumulation are:\",\"(3) Special standards for incompatible wastes.\"],\"defined_terms\":[],\"effective_periods\":[],\"end\":2327,\"evidence\":[{\"end\":2327,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ae83b7297b741d59fb878775fd631eeb28a5aa35359e885bf29ca58f62f120732:2112:2327:sha256-47d277533d321dd50e3c8490f09453d0b8dc3b9223429baffb38cc9cf566a0aa\",\"quote\":\"(ii) Hazardous waste must not be placed in an unwashed container that previously held an incompatible waste or material (see appendix V of part 265 for examples), unless § 265.17(b) of this chapter is complied with.\",\"start\":2112},{\"end\":2141,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ae83b7297b741d59fb878775fd631eeb28a5aa35359e885bf29ca58f62f120732:2133:2141:sha256-df0465d9a394078860d809a83f39f74c2e1040a44d5115401199c3e4374d2729\",\"quote\":\"must not\",\"start\":2133},{\"end\":2327,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ae83b7297b741d59fb878775fd631eeb28a5aa35359e885bf29ca58f62f120732:2112:2327:sha256-47d277533d321dd50e3c8490f09453d0b8dc3b9223429baffb38cc9cf566a0aa\",\"quote\":\"(ii) Hazardous waste must not be placed in an unwashed container that previously held an incompatible waste or material (see appendix V of part 265 for examples), unless § 265.17(b) of this chapter is complied with.\",\"start\":2112},{\"end\":1247,\"field\":\"context:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ae83b7297b741d59fb878775fd631eeb28a5aa35359e885bf29ca58f62f120732:322:1247:sha256-9d5462ca5acb5b64b79b4fb6c7300dcb44210d3f68fcb2c26e7ecdffde248bd6\",\"quote\":\"(a) A generator may accumulate as much as 55 gallons of non-acute hazardous waste and/or either one quart of liquid acute hazardous waste listed in § 261.31 or § 261.33(e) of this chapter or 1 kg (2.2 lbs) of solid acute hazardous waste listed in § 261.31 or § 261.33(e) of this chapter in containers at or near any point of generation where wastes initially accumulate which is under the control of the operator of the process generating the waste, without a permit or interim status and without complying with the requirements of parts 124, 264 through 267, and 270 of this chapter, provided that all of the conditions for exemption in this section are met. A generator may comply with the conditions for exemption in this section instead of complying with the conditions for exemption in § 262.16(b) or § 262.17(a), except as required in § 262.15(a)(7) and (8). The conditions for exemption for satellite accumulation are:\",\"start\":322},{\"end\":1909,\"field\":\"context:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ae83b7297b741d59fb878775fd631eeb28a5aa35359e885bf29ca58f62f120732:1863:1909:sha256-9918d7cef1092abb07f2e8c97c89319993cd89bca8b7d58305617877fb0fe4bc\",\"quote\":\"(3) Special standards for incompatible wastes.\",\"start\":1863}],\"id\":\"urn:rulespec:document-understanding:revision:8f36f5e462d8866d7ec1ca47bd57644041ac3929e003ec503b683689c96adf4b\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"prohibition\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:d986b597cb88440c2c04507413e5f7937677bd3ea9fc33f094fdb33e7b8e4a51\",\"modality\":\"must_not\",\"modality_quote\":\"must not\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:9306bb4fff4e8d3812d11c444adc6a26878dd7c60230916002857816be934a89\",\"origin\":\"aiSuggested\",\"quote\":\"(ii) Hazardous waste must not be placed in an unwashed container that previously held an incompatible waste or material (see appendix V of part 265 for examples), unless § 265.17(b) of this chapter is complied with.\",\"references\":[\"appendix V of part 265\",\"§ 265.17(b)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:236184b30bcd4d65820fe95d96bf5252f2acacfc6cb119bd6d975ade96d2cef6\",\"scope_quotes\":[\"(ii) Hazardous waste must not be placed in an unwashed container that previously held an incompatible waste or material (see appendix V of part 265 for examples), unless § 265.17(b) of this chapter is complied with.\"],\"scope_text\":\"unless § 265.17(b) of this chapter is complied with\",\"section_id\":\"section-1\",\"start\":2112,\"summary\":\"Under the special standards for incompatible wastes in satellite accumulation areas, hazardous waste must not be placed in an unwashed container that previously held an incompatible waste or material (see appendix V of part 265 for examples), unless § 265.17(b) of this chapter is complied with.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

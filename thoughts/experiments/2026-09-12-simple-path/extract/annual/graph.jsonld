    {
      "@id": "urn:rulespec:document-understanding:revision:77fdb0106d9b5d9fed09d75e79206e7c5d9960a3ec6b151b10f0c833769628fd",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:77fdb0106d9b5d9fed09d75e79206e7c5d9960a3ec6b151b10f0c833769628fd",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:3b8226f67bd3a8e3c9fcd4ca76834b0caee050a09778f5a56685fcf514395210",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"A generator\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:5880cdc2dbcf65aa921d6f0e2dd8b1de059bd272664720ed1d1efb348acf784f\",\"urn:rulespec:document-understanding:assertion:8574fc99c96bbd90b533f16887a203e7be20d283c74714c256316821a5b04395\",\"urn:rulespec:document-understanding:assertion:68a1ba0182438130ff441ce69e92aaa43e7c950f7fb4c89471af69d85ba863ce\",\"urn:rulespec:document-understanding:assertion:d9e1dc88b38ed94dc756ad6a1bd8a8cd8cdbf0a0cf3d05277ba87e48c0843555\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[\"(a) A generator may accumulate as much as 55 gallons of non-acute hazardous waste and/or either one quart of liquid acute hazardous waste listed in § 261.31 or § 261.33(e) of this chapter or 1 kg (2.2 lbs) of solid acute hazardous waste listed in § 261.31 or § 261.33(e) of this chapter in containers at or near any point of generation where wastes initially accumulate which is under the control of the operator of the process generating the waste, without a permit or interim status and without complying with the requirements of parts 124, 264 through 267, and 270 of this chapter, provided that all of the conditions for exemption in this section are met. A generator may comply with the conditions for exemption in this section instead of complying with the conditions for exemption in § 262.16(b) or § 262.17(a), except as required in § 262.15(a)(7) and (8). The conditions for exemption for satellite accumulation are:\"],\"defined_terms\":[],\"effective_periods\":[],\"end\":3581,\"evidence\":[{\"end\":3581,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ae83b7297b741d59fb878775fd631eeb28a5aa35359e885bf29ca58f62f120732:2891:3581:sha256-55164c4b6693ac5e832aafee2759daa6a43aa5041c071430e0165c7107655bfc\",\"quote\":\"(5) A generator must mark or label its container with the following:\\n\\n(i) The words “Hazardous Waste” and\\n\\n(ii) An indication of the hazards of the contents (examples include, but are not limited to, the applicable hazardous waste characteristic(s) ( i.e., ignitable, corrosive, reactive, toxic); hazard communication consistent with the Department of Transportation requirements at 49 CFR part 172 subpart E (labeling) or subpart F (placarding); a hazard statement or pictogram consistent with the Occupational Safety and Health Administration Hazard Communication Standard at 29 CFR 1910.1200; or a chemical hazard label consistent with the National Fire Protection Association code 704).\",\"start\":2891},{\"end\":2906,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ae83b7297b741d59fb878775fd631eeb28a5aa35359e885bf29ca58f62f120732:2895:2906:sha256-0683b95ac50ca3fcb430ffbbbf40a1d6a9a1a54c20fe6f8e23b9d3b3f77d8aa4\",\"quote\":\"A generator\",\"start\":2895},{\"end\":2911,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ae83b7297b741d59fb878775fd631eeb28a5aa35359e885bf29ca58f62f120732:2907:2911:sha256-4137b01e139589b7a1d3b3fc4da031d8ce5bb415808734e970c3a58ea0e98f0f\",\"quote\":\"must\",\"start\":2907},{\"end\":1247,\"field\":\"context:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ae83b7297b741d59fb878775fd631eeb28a5aa35359e885bf29ca58f62f120732:322:1247:sha256-9d5462ca5acb5b64b79b4fb6c7300dcb44210d3f68fcb2c26e7ecdffde248bd6\",\"quote\":\"(a) A generator may accumulate as much as 55 gallons of non-acute hazardous waste and/or either one quart of liquid acute hazardous waste listed in § 261.31 or § 261.33(e) of this chapter or 1 kg (2.2 lbs) of solid acute hazardous waste listed in § 261.31 or § 261.33(e) of this chapter in containers at or near any point of generation where wastes initially accumulate which is under the control of the operator of the process generating the waste, without a permit or interim status and without complying with the requirements of parts 124, 264 through 267, and 270 of this chapter, provided that all of the conditions for exemption in this section are met. A generator may comply with the conditions for exemption in this section instead of complying with the conditions for exemption in § 262.16(b) or § 262.17(a), except as required in § 262.15(a)(7) and (8). The conditions for exemption for satellite accumulation are:\",\"start\":322}],\"id\":\"urn:rulespec:document-understanding:revision:77fdb0106d9b5d9fed09d75e79206e7c5d9960a3ec6b151b10f0c833769628fd\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:d9e1dc88b38ed94dc756ad6a1bd8a8cd8cdbf0a0cf3d05277ba87e48c0843555\",\"modality\":\"must\",\"modality_quote\":\"must\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:e6a64420aea4262a7610f72c8452af9cedfdaad5f296d186da68cf33ebf9b90e\",\"origin\":\"aiSuggested\",\"quote\":\"(5) A generator must mark or label its container with the following:\\n\\n(i) The words “Hazardous Waste” and\\n\\n(ii) An indication of the hazards of the contents (examples include, but are not limited to, the applicable hazardous waste characteristic(s) ( i.e., ignitable, corrosive, reactive, toxic); hazard communication consistent with the Department of Transportation requirements at 49 CFR part 172 subpart E (labeling) or subpart F (placarding); a hazard statement or pictogram consistent with the Occupational Safety and Health Administration Hazard Communication Standard at 29 CFR 1910.1200; or a chemical hazard label consistent with the National Fire Protection Association code 704).\",\"references\":[\"49 CFR part 172 subpart E\",\"49 CFR part 172 subpart F\",\"29 CFR 1910.1200\",\"NFPA code 704\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:786b0217745f9c742cd9e6f4a698431e65654f9db07c2ad69e43382850f3191c\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":2891,\"summary\":\"Under the conditions for exemption for satellite accumulation, a generator must mark or label its container with both: (i) the words “Hazardous Waste” and (ii) an indication of the hazards of the contents (examples include, but are not limited to, the applicable hazardous waste characteristic(s) (i.e., ignitable, corrosive, reactive, toxic); hazard communication consistent with DOT requirements at 49 CFR part 172 subpart E (labeling) or subpart F (placarding); a hazard statement or pictogram consistent with OSHA Hazard Communication Standard at 29 CFR 1910.1200; or a chemical hazard label consistent with NFPA code 704).\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

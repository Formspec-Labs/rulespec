      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"choice_text\":\"The container must be closed at all times except during: (1) adding, removing, or consolidating waste; or (2) temporary venting when necessary either (a) for proper operation of equipment or (b) to prevent dangerous situations such as build-up of extreme pressure.\",\"kind\":\"requirement\",\"modality\":\"must\",\"scope_text\":\"except: (i) When adding, removing, or consolidating waste; or (ii) When temporary venting of a container is necessary (A) For the proper operation of equipment, or (B) To prevent dangerous situations, such as build-up of extreme pressure.\",\"summary\":\"Under the conditions for exemption for satellite accumulation, a container holding hazardous waste must be closed at all times during accumulation, except: (i) when adding, removing, or consolidating waste; or (ii) when temporary venting of a container is necessary (A) for the proper operation of equipment, or (B) to prevent dangerous situations, such as build-up of extreme pressure.\"}",
        "@type": "xsd:string"
      },

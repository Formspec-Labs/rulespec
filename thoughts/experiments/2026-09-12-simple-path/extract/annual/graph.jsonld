    {
      "@id": "urn:rulespec:document-understanding:revision:842c74ba797e1d0e005d6bb9c258c107ea543caaaa33274f3c4feb9e89b5bc5b",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:842c74ba797e1d0e005d6bb9c258c107ea543caaaa33274f3c4feb9e89b5bc5b",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:f01baca523fd4eccd0a8c35c9b453f7c0e9738c7cba7074e5470352bf97ba675",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:c93759a69d438afc619e51dcb089737e3ac785ea0dfddaea6cc9cf1173965206\",\"urn:rulespec:document-understanding:assertion:c0c6ae9c0d3da930718099a7067e974032cd014402e39e41d3539fab95e69f03\",\"urn:rulespec:document-understanding:assertion:65291819b43acd732f03d9135f47c47c080af0f90ea6e142f45b49a40a44d8eb\",\"urn:rulespec:document-understanding:assertion:c8236fcc72353319a9d291095e980375397e8f792b759f5e508b3c5286577b33\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[\"(a) A generator may accumulate as much as 55 gallons of non-acute hazardous waste and/or either one quart of liquid acute hazardous waste listed in § 261.31 or § 261.33(e) of this chapter or 1 kg (2.2 lbs) of solid acute hazardous waste listed in § 261.31 or § 261.33(e) of this chapter in containers at or near any point of generation where wastes initially accumulate which is under the control of the operator of the process generating the waste, without a permit or interim status and without complying with the requirements of parts 124, 264 through 267, and 270 of this chapter, provided that all of the conditions for exemption in this section are met. A generator may comply with the conditions for exemption in this section instead of complying with the conditions for exemption in § 262.16(b) or § 262.17(a), except as required in § 262.15(a)(7) and (8). The conditions for exemption for satellite accumulation are:\",\"(3) Special standards for incompatible wastes.\"],\"defined_terms\":[],\"effective_periods\":[],\"end\":2556,\"evidence\":[{\"end\":2556,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ae83b7297b741d59fb878775fd631eeb28a5aa35359e885bf29ca58f62f120732:2329:2556:sha256-52a15dd5b9024d445a8441b374178b51367e1d36c5f9d3c4aa029ea5532e24c7\",\"quote\":\"(iii) A container holding a hazardous waste that is incompatible with any waste or other materials accumulated nearby in other containers must be separated from the other materials or protected from them by any practical means.\",\"start\":2329},{\"end\":2471,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ae83b7297b741d59fb878775fd631eeb28a5aa35359e885bf29ca58f62f120732:2467:2471:sha256-4137b01e139589b7a1d3b3fc4da031d8ce5bb415808734e970c3a58ea0e98f0f\",\"quote\":\"must\",\"start\":2467},{\"end\":2556,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ae83b7297b741d59fb878775fd631eeb28a5aa35359e885bf29ca58f62f120732:2329:2556:sha256-52a15dd5b9024d445a8441b374178b51367e1d36c5f9d3c4aa029ea5532e24c7\",\"quote\":\"(iii) A container holding a hazardous waste that is incompatible with any waste or other materials accumulated nearby in other containers must be separated from the other materials or protected from them by any practical means.\",\"start\":2329},{\"end\":1247,\"field\":\"context:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ae83b7297b741d59fb878775fd631eeb28a5aa35359e885bf29ca58f62f120732:322:1247:sha256-9d5462ca5acb5b64b79b4fb6c7300dcb44210d3f68fcb2c26e7ecdffde248bd6\",\"quote\":\"(a) A generator may accumulate as much as 55 gallons of non-acute hazardous waste and/or either one quart of liquid acute hazardous waste listed in § 261.31 or § 261.33(e) of this chapter or 1 kg (2.2 lbs) of solid acute hazardous waste listed in § 261.31 or § 261.33(e) of this chapter in containers at or near any point of generation where wastes initially accumulate which is under the control of the operator of the process generating the waste, without a permit or interim status and without complying with the requirements of parts 124, 264 through 267, and 270 of this chapter, provided that all of the conditions for exemption in this section are met. A generator may comply with the conditions for exemption in this section instead of complying with the conditions for exemption in § 262.16(b) or § 262.17(a), except as required in § 262.15(a)(7) and (8). The conditions for exemption for satellite accumulation are:\",\"start\":322},{\"end\":1909,\"field\":\"context:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ae83b7297b741d59fb878775fd631eeb28a5aa35359e885bf29ca58f62f120732:1863:1909:sha256-9918d7cef1092abb07f2e8c97c89319993cd89bca8b7d58305617877fb0fe4bc\",\"quote\":\"(3) Special standards for incompatible wastes.\",\"start\":1863}],\"id\":\"urn:rulespec:document-understanding:revision:842c74ba797e1d0e005d6bb9c258c107ea543caaaa33274f3c4feb9e89b5bc5b\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:c8236fcc72353319a9d291095e980375397e8f792b759f5e508b3c5286577b33\",\"modality\":\"must\",\"modality_quote\":\"must\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:f1ed17efb76de1de16139c3a77ed562c110fb64bf0b9dfd16dcef3b99cec6515\",\"origin\":\"aiSuggested\",\"quote\":\"(iii) A container holding a hazardous waste that is incompatible with any waste or other materials accumulated nearby in other containers must be separated from the other materials or protected from them by any practical means.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:7ced5446985c8075be69c435468de59baea07fa97d645e4e9ebeb92fe5b56e52\",\"scope_quotes\":[\"(iii) A container holding a hazardous waste that is incompatible with any waste or other materials accumulated nearby in other containers must be separated from the other materials or protected from them by any practical means.\"],\"scope_text\":\"holding a hazardous waste that is incompatible with any waste or other materials accumulated nearby in other containers\",\"section_id\":\"section-1\",\"start\":2329,\"summary\":\"Under the special standards for incompatible wastes in satellite accumulation areas, a container holding a hazardous waste that is incompatible with any waste or other materials accumulated nearby in other containers must be separated from the other materials or protected from them by any practical means.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

    {
      "@id": "urn:rulespec:document-understanding:revision:d65d7576cf49c85fbd3c79e99b6e0cee4b776d003c31d9f50ac49a438e6ecf48",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:d65d7576cf49c85fbd3c79e99b6e0cee4b776d003c31d9f50ac49a438e6ecf48",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:5b60d71ea71be8815c96a43c761cbaf31a2b76d1831dc09f50d6f761d305d529",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"The generator\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:b8198c043107ddbdea24f012c72c4ccda0ad14faf3159d0cd4cb260894f37f37\",\"urn:rulespec:document-understanding:assertion:af7ff0276c175a398e909c73cf17849f3d32b7085fba13e4f972a3edf796a764\",\"urn:rulespec:document-understanding:assertion:0b122bb3ac26f90ce2631c97d239a2a08943041b66a9d2c9ebbb4c0d75cd560f\",\"urn:rulespec:document-understanding:assertion:45f87831674bd2c079f95b951d309f9e3fe214848cc032905725c59acb147df7\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[\"(a) A generator may accumulate as much as 55 gallons of non-acute hazardous waste and/or either one quart of liquid acute hazardous waste listed in § 261.31 or § 261.33(e) of this chapter or 1 kg (2.2 lbs) of solid acute hazardous waste listed in § 261.31 or § 261.33(e) of this chapter in containers at or near any point of generation where wastes initially accumulate which is under the control of the operator of the process generating the waste, without a permit or interim status and without complying with the requirements of parts 124, 264 through 267, and 270 of this chapter, provided that all of the conditions for exemption in this section are met. A generator may comply with the conditions for exemption in this section instead of complying with the conditions for exemption in § 262.16(b) or § 262.17(a), except as required in § 262.15(a)(7) and (8). The conditions for exemption for satellite accumulation are:\"],\"defined_terms\":[],\"effective_periods\":[],\"end\":1861,\"evidence\":[{\"end\":1861,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ae83b7297b741d59fb878775fd631eeb28a5aa35359e885bf29ca58f62f120732:1616:1861:sha256-b92d81a3d148b454bbb671310b0aecb697505882136e33030afa68efc672d0d7\",\"quote\":\"(2) The generator must use a container made of or lined with materials that will not react with, and are otherwise compatible with, the hazardous waste to be accumulated, so that the ability of the container to contain the waste is not impaired.\",\"start\":1616},{\"end\":1633,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ae83b7297b741d59fb878775fd631eeb28a5aa35359e885bf29ca58f62f120732:1620:1633:sha256-91a23b8e2e1ccbee893728a484dad3798931830a3e56984a461cdbb1ec9a745b\",\"quote\":\"The generator\",\"start\":1620},{\"end\":1638,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ae83b7297b741d59fb878775fd631eeb28a5aa35359e885bf29ca58f62f120732:1634:1638:sha256-4137b01e139589b7a1d3b3fc4da031d8ce5bb415808734e970c3a58ea0e98f0f\",\"quote\":\"must\",\"start\":1634},{\"end\":1247,\"field\":\"context:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ae83b7297b741d59fb878775fd631eeb28a5aa35359e885bf29ca58f62f120732:322:1247:sha256-9d5462ca5acb5b64b79b4fb6c7300dcb44210d3f68fcb2c26e7ecdffde248bd6\",\"quote\":\"(a) A generator may accumulate as much as 55 gallons of non-acute hazardous waste and/or either one quart of liquid acute hazardous waste listed in § 261.31 or § 261.33(e) of this chapter or 1 kg (2.2 lbs) of solid acute hazardous waste listed in § 261.31 or § 261.33(e) of this chapter in containers at or near any point of generation where wastes initially accumulate which is under the control of the operator of the process generating the waste, without a permit or interim status and without complying with the requirements of parts 124, 264 through 267, and 270 of this chapter, provided that all of the conditions for exemption in this section are met. A generator may comply with the conditions for exemption in this section instead of complying with the conditions for exemption in § 262.16(b) or § 262.17(a), except as required in § 262.15(a)(7) and (8). The conditions for exemption for satellite accumulation are:\",\"start\":322}],\"id\":\"urn:rulespec:document-understanding:revision:d65d7576cf49c85fbd3c79e99b6e0cee4b776d003c31d9f50ac49a438e6ecf48\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:45f87831674bd2c079f95b951d309f9e3fe214848cc032905725c59acb147df7\",\"modality\":\"must\",\"modality_quote\":\"must\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:b35fb2d6e9437322819240f48edfcd2b065e114d4786097d5e47dc31d625ae89\",\"origin\":\"aiSuggested\",\"quote\":\"(2) The generator must use a container made of or lined with materials that will not react with, and are otherwise compatible with, the hazardous waste to be accumulated, so that the ability of the container to contain the waste is not impaired.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:ca5d4f95b9fb438df0ad22ab0e32d5260f7b79d50ea92fd40ac331b737db4399\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":1616,\"summary\":\"Under the conditions for exemption for satellite accumulation, the generator must use a container made of or lined with materials that will not react with, and are otherwise compatible with, the hazardous waste to be accumulated, so that the ability of the container to contain the waste is not impaired.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

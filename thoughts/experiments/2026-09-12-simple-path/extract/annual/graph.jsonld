      "rkaf:assertsValue": {
        "@value": "{\"actor\":\"The generator\",\"kind\":\"requirement\",\"modality\":\"must\",\"scope_text\":\"holding the excess accumulation of hazardous waste\",\"summary\":\"When a generator accumulates acute hazardous waste listed in § 261.31 or § 261.33(e) or non-acute hazardous waste in excess of the amounts listed in § 262.15(a) at or near any point of generation, the generator must mark or label the container(s) holding the excess accumulation of hazardous waste with the date the excess amount began accumulating.\"}",
        "@type": "xsd:string"
      },

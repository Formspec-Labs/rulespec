      "rkaf:assertsValue": {
        "@value": "{\"kind\":\"requirement\",\"modality\":\"must\",\"scope_text\":\"holding a hazardous waste that is incompatible with any waste or other materials accumulated nearby in other containers\",\"summary\":\"Under the special standards for incompatible wastes in satellite accumulation areas, a container holding a hazardous waste that is incompatible with any waste or other materials accumulated nearby in other containers must be separated from the other materials or protected from them by any practical means.\"}",

    {
      "@id": "urn:rulespec:document-understanding:revision:c9daac110274c55d0b15a341be5b302ee38321a2b7da5deb8561fa4834129693",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:c9daac110274c55d0b15a341be5b302ee38321a2b7da5deb8561fa4834129693",

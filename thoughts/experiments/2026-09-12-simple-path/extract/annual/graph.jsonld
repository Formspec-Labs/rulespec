    {
      "@id": "urn:rulespec:document-understanding:revision:323bf0008167cd52fc3afca86e51c200680f8637c4c258daf425a4346f2a1208",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:323bf0008167cd52fc3afca86e51c200680f8637c4c258daf425a4346f2a1208",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:4fe62a4b2d5241c8b3ae290d852708d8944e2b187cfd6653ec4f0316bff5fb25",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"a large quantity generator\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:617ba7cea9d75ab5470678ffd3d22bc055476f654155e6e97a37507083c1305b\",\"urn:rulespec:document-understanding:assertion:716b95fee91cb590d8dc5b1be97e731680d41ac7b42df5b915b475f606d36773\",\"urn:rulespec:document-understanding:assertion:a132a97cf9c4d8061c1c84a35971f25ee5c270760b3d5588b1511f0de32e6ded\",\"urn:rulespec:document-understanding:assertion:dacfcbcee33001f75eca42dfcccefe110d602b4aa1edb193d75425b754ab2b0f\",\"urn:rulespec:document-understanding:assertion:209cbc23d0f79c2b3004c56fbf85f6c50f5b93ae7cb2ef693b7c76939b56fe0e\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[\"(a) A generator may accumulate as much as 55 gallons of non-acute hazardous waste and/or either one quart of liquid acute hazardous waste listed in § 261.31 or § 261.33(e) of this chapter or 1 kg (2.2 lbs) of solid acute hazardous waste listed in § 261.31 or § 261.33(e) of this chapter in containers at or near any point of generation where wastes initially accumulate which is under the control of the operator of the process generating the waste, without a permit or interim status and without complying with the requirements of parts 124, 264 through 267, and 270 of this chapter, provided that all of the conditions for exemption in this section are met. A generator may comply with the conditions for exemption in this section instead of complying with the conditions for exemption in § 262.16(b) or § 262.17(a), except as required in § 262.15(a)(7) and (8). The conditions for exemption for satellite accumulation are:\"],\"defined_terms\":[],\"effective_periods\":[],\"end\":5009,\"evidence\":[{\"end\":5009,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ae83b7297b741d59fb878775fd631eeb28a5aa35359e885bf29ca58f62f120732:4843:5009:sha256-864285dbfc9bdce22f549faf4f5147debbb0869aa95db073efe94f1903643235\",\"quote\":\"(8) All satellite accumulation areas operated by a large quantity generator must meet the Preparedness, Prevention and Emergency Procedures in subpart M of this part.\",\"start\":4843},{\"end\":4918,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ae83b7297b741d59fb878775fd631eeb28a5aa35359e885bf29ca58f62f120732:4892:4918:sha256-cc8c0e816950c7e43828f39adb59a6c210f15253aa5fd2d31c47186341fc7f89\",\"quote\":\"a large quantity generator\",\"start\":4892},{\"end\":4923,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ae83b7297b741d59fb878775fd631eeb28a5aa35359e885bf29ca58f62f120732:4919:4923:sha256-4137b01e139589b7a1d3b3fc4da031d8ce5bb415808734e970c3a58ea0e98f0f\",\"quote\":\"must\",\"start\":4919},{\"end\":5009,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ae83b7297b741d59fb878775fd631eeb28a5aa35359e885bf29ca58f62f120732:4843:5009:sha256-864285dbfc9bdce22f549faf4f5147debbb0869aa95db073efe94f1903643235\",\"quote\":\"(8) All satellite accumulation areas operated by a large quantity generator must meet the Preparedness, Prevention and Emergency Procedures in subpart M of this part.\",\"start\":4843},{\"end\":1247,\"field\":\"context:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ae83b7297b741d59fb878775fd631eeb28a5aa35359e885bf29ca58f62f120732:322:1247:sha256-9d5462ca5acb5b64b79b4fb6c7300dcb44210d3f68fcb2c26e7ecdffde248bd6\",\"quote\":\"(a) A generator may accumulate as much as 55 gallons of non-acute hazardous waste and/or either one quart of liquid acute hazardous waste listed in § 261.31 or § 261.33(e) of this chapter or 1 kg (2.2 lbs) of solid acute hazardous waste listed in § 261.31 or § 261.33(e) of this chapter in containers at or near any point of generation where wastes initially accumulate which is under the control of the operator of the process generating the waste, without a permit or interim status and without complying with the requirements of parts 124, 264 through 267, and 270 of this chapter, provided that all of the conditions for exemption in this section are met. A generator may comply with the conditions for exemption in this section instead of complying with the conditions for exemption in § 262.16(b) or § 262.17(a), except as required in § 262.15(a)(7) and (8). The conditions for exemption for satellite accumulation are:\",\"start\":322}],\"id\":\"urn:rulespec:document-understanding:revision:323bf0008167cd52fc3afca86e51c200680f8637c4c258daf425a4346f2a1208\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:209cbc23d0f79c2b3004c56fbf85f6c50f5b93ae7cb2ef693b7c76939b56fe0e\",\"modality\":\"must\",\"modality_quote\":\"must\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:18c4e7105fc1e93310f46935a932635fec36c09617df3805e4cc309ab496dafc\",\"origin\":\"aiSuggested\",\"quote\":\"(8) All satellite accumulation areas operated by a large quantity generator must meet the Preparedness, Prevention and Emergency Procedures in subpart M of this part.\",\"references\":[\"subpart M of this part\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:2f6c11a76fc4d41ab3380ce531a7a5408c56fdbb65d31e062fb2abfb2aad4855\",\"scope_quotes\":[\"(8) All satellite accumulation areas operated by a large quantity generator must meet the Preparedness, Prevention and Emergency Procedures in subpart M of this part.\"],\"scope_text\":\"All satellite accumulation areas operated by a large quantity generator\",\"section_id\":\"section-1\",\"start\":4843,\"summary\":\"All satellite accumulation areas operated by a large quantity generator must meet the Preparedness, Prevention and Emergency Procedures in subpart M of 40 CFR part 262.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

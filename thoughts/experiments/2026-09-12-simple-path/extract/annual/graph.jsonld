    {
      "@id": "urn:rulespec:document-understanding:revision:622f73dfda5a5a953fefa9d097c5bf15ed4630680d31317f6a9660d93dfb4c53",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:622f73dfda5a5a953fefa9d097c5bf15ed4630680d31317f6a9660d93dfb4c53",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:dd97957e9e9c6c6c6a05316063e57746e7e22feea2948a7d3c22e28fd217f990",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"a small quantity generator\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:864b2c7b12cc6536c77b3e0c245c57cede876fd1fb514c99cd7f5e8a52b074b0\",\"urn:rulespec:document-understanding:assertion:633ef166be073cfe87cc885620e9882e0217cb0cc0ab0afa331b7f5585611720\",\"urn:rulespec:document-understanding:assertion:3680af3be936393e922c4b7fc466ab698ab6b189fb59c485bdb2dd50a1991d29\",\"urn:rulespec:document-understanding:assertion:7ec8ffaab538913645d33c63108fea15f35d27dd974c73837c26d70d971c350a\",\"urn:rulespec:document-understanding:assertion:e49b712d24298b6de88a5af9a562f554586ab7d6f9c4028af64061a12d4a15ef\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[\"(a) A generator may accumulate as much as 55 gallons of non-acute hazardous waste and/or either one quart of liquid acute hazardous waste listed in § 261.31 or § 261.33(e) of this chapter or 1 kg (2.2 lbs) of solid acute hazardous waste listed in § 261.31 or § 261.33(e) of this chapter in containers at or near any point of generation where wastes initially accumulate which is under the control of the operator of the process generating the waste, without a permit or interim status and without complying with the requirements of parts 124, 264 through 267, and 270 of this chapter, provided that all of the conditions for exemption in this section are met. A generator may comply with the conditions for exemption in this section instead of complying with the conditions for exemption in § 262.16(b) or § 262.17(a), except as required in § 262.15(a)(7) and (8). The conditions for exemption for satellite accumulation are:\"],\"defined_terms\":[],\"effective_periods\":[],\"end\":4841,\"evidence\":[{\"end\":4841,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ae83b7297b741d59fb878775fd631eeb28a5aa35359e885bf29ca58f62f120732:4650:4841:sha256-be854eb186b99faa4c7d04ca927b68237aa3eaefb953c7931ed8209a496a8041\",\"quote\":\"(7) All satellite accumulation areas operated by a small quantity generator must meet the preparedness and prevention regulations of § 262.16(b)(8) and emergency procedures at § 262.16(b)(9).\",\"start\":4650},{\"end\":4725,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ae83b7297b741d59fb878775fd631eeb28a5aa35359e885bf29ca58f62f120732:4699:4725:sha256-4d3eab72bf0e1ad334ff2218c078b52a28c8a2b68eb0413fe41fc4ed3a5b2b71\",\"quote\":\"a small quantity generator\",\"start\":4699},{\"end\":4730,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ae83b7297b741d59fb878775fd631eeb28a5aa35359e885bf29ca58f62f120732:4726:4730:sha256-4137b01e139589b7a1d3b3fc4da031d8ce5bb415808734e970c3a58ea0e98f0f\",\"quote\":\"must\",\"start\":4726},{\"end\":4841,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ae83b7297b741d59fb878775fd631eeb28a5aa35359e885bf29ca58f62f120732:4650:4841:sha256-be854eb186b99faa4c7d04ca927b68237aa3eaefb953c7931ed8209a496a8041\",\"quote\":\"(7) All satellite accumulation areas operated by a small quantity generator must meet the preparedness and prevention regulations of § 262.16(b)(8) and emergency procedures at § 262.16(b)(9).\",\"start\":4650},{\"end\":1247,\"field\":\"context:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ae83b7297b741d59fb878775fd631eeb28a5aa35359e885bf29ca58f62f120732:322:1247:sha256-9d5462ca5acb5b64b79b4fb6c7300dcb44210d3f68fcb2c26e7ecdffde248bd6\",\"quote\":\"(a) A generator may accumulate as much as 55 gallons of non-acute hazardous waste and/or either one quart of liquid acute hazardous waste listed in § 261.31 or § 261.33(e) of this chapter or 1 kg (2.2 lbs) of solid acute hazardous waste listed in § 261.31 or § 261.33(e) of this chapter in containers at or near any point of generation where wastes initially accumulate which is under the control of the operator of the process generating the waste, without a permit or interim status and without complying with the requirements of parts 124, 264 through 267, and 270 of this chapter, provided that all of the conditions for exemption in this section are met. A generator may comply with the conditions for exemption in this section instead of complying with the conditions for exemption in § 262.16(b) or § 262.17(a), except as required in § 262.15(a)(7) and (8). The conditions for exemption for satellite accumulation are:\",\"start\":322}],\"id\":\"urn:rulespec:document-understanding:revision:622f73dfda5a5a953fefa9d097c5bf15ed4630680d31317f6a9660d93dfb4c53\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:e49b712d24298b6de88a5af9a562f554586ab7d6f9c4028af64061a12d4a15ef\",\"modality\":\"must\",\"modality_quote\":\"must\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:1e0b80bf3b981c8ee6488b727a27e1058ac8651286be321553a07a0bdbe90267\",\"origin\":\"aiSuggested\",\"quote\":\"(7) All satellite accumulation areas operated by a small quantity generator must meet the preparedness and prevention regulations of § 262.16(b)(8) and emergency procedures at § 262.16(b)(9).\",\"references\":[\"§ 262.16(b)(8)\",\"§ 262.16(b)(9)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:80fa46d08e5cfc0ec1b4bbf19352953b84bc009ae93abb5c724bf7b88742dee9\",\"scope_quotes\":[\"(7) All satellite accumulation areas operated by a small quantity generator must meet the preparedness and prevention regulations of § 262.16(b)(8) and emergency procedures at § 262.16(b)(9).\"],\"scope_text\":\"All satellite accumulation areas operated by a small quantity generator\",\"section_id\":\"section-1\",\"start\":4650,\"summary\":\"All satellite accumulation areas operated by a small quantity generator must meet the preparedness and prevention regulations of § 262.16(b)(8) and emergency procedures at § 262.16(b)(9).\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

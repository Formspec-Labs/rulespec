      "rkaf:hasContentDigest": "sha256:f5c3c0566b1e190d1fc46dcd21d977a25e61d56fe0832420e30b6bec0588fc80",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"the generator\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:c7fa3c13274ee39a17d59d8f10f1f62adcb234a9d41f30824b233290b014eea7\",\"urn:rulespec:document-understanding:assertion:ac6266116d8ac4ce72522fb68ccefe48e515ad479042d714b8d4ed2b39200a64\",\"urn:rulespec:document-understanding:assertion:74cb769e15276f9a1ce7f6f099a6ae8f7e6defd879501847388830c1bb3e45d0\",\"urn:rulespec:document-understanding:assertion:d3df7ed6403787b35c4085dd1b8057b2c8e76acba96419aaa9879cd1be68c550\",\"urn:rulespec:document-understanding:assertion:af0b76ff0bdfc2e7e23bd0682bb374a593ebbe0fc7c3911101b0c7c19d054645\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":4648,\"evidence\":[{\"end\":4648,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ae83b7297b741d59fb878775fd631eeb28a5aa35359e885bf29ca58f62f120732:4351:4648:sha256-01c6ed3b7a204678a029a38a2fd07447e3a11ed250ae75d98d7c00f2daefe972\",\"quote\":\"(iii) During the three-consecutive-calendar-day period the generator must continue to comply with paragraphs (a)(1) through (5) of this section. The generator must mark or label the container(s) holding the excess accumulation of hazardous waste with the date the excess amount began accumulating.\",\"start\":4351},{\"end\":4419,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ae83b7297b741d59fb878775fd631eeb28a5aa35359e885bf29ca58f62f120732:4406:4419:sha256-f6b092ed2afc325805e09d578763e58caaaa697b8049773bb2a1e13b1a80ab28\",\"quote\":\"the generator\",\"start\":4406},{\"end\":3845,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ae83b7297b741d59fb878775fd631eeb28a5aa35359e885bf29ca58f62f120732:3583:3845:sha256-004bfacd70f49688c10c41107890341ecd181de2a1a742ac361b585c6cb09683\",\"quote\":\"(6) A generator who accumulates either acute hazardous waste listed in § 261.31 or § 261.33(e) of this chapter or non-acute hazardous waste in excess of the amounts listed in paragraph (a) of this section at or near any point of generation must do the following:\",\"start\":3583},{\"end\":4648,\"field\":\"scope_text:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ae83b7297b741d59fb878775fd631eeb28a5aa35359e885bf29ca58f62f120732:4351:4648:sha256-01c6ed3b7a204678a029a38a2fd07447e3a11ed250ae75d98d7c00f2daefe972\",\"quote\":\"(iii) During the three-consecutive-calendar-day period the generator must continue to comply with paragraphs (a)(1) through (5) of this section. The generator must mark or label the container(s) holding the excess accumulation of hazardous waste with the date the excess amount began accumulating.\",\"start\":4351}],\"id\":\"urn:rulespec:document-understanding:revision:06f2d49b1d188e0bdd236bc5554fcfa2a2d39092d7708b8d39322566c7715a90\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:af0b76ff0bdfc2e7e23bd0682bb374a593ebbe0fc7c3911101b0c7c19d054645\",\"modality\":\"must\",\"modality_quote\":\"must\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:30e77de54da613dbd5b0328f910a0eda711451958f1b684226745e8ddce7c9a8\",\"origin\":\"aiSuggested\",\"quote\":\"(iii) During the three-consecutive-calendar-day period the generator must continue to comply with paragraphs (a)(1) through (5) of this section. The generator must mark or label the container(s) holding the excess accumulation of hazardous waste with the date the excess amount began accumulating.\",\"references\":[\"paragraphs (a)(1) through (5) of this section\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:b18b42b310925ecde023d2818ae518ba38fe19866fa7fa68f4df0c5e9402ff00\",\"scope_quotes\":[\"(6) A generator who accumulates either acute hazardous waste listed in § 261.31 or § 261.33(e) of this chapter or non-acute hazardous waste in excess of the amounts listed in paragraph (a) of this section at or near any point of generation must do the following:\",\"(iii) During the three-consecutive-calendar-day period the generator must continue to comply with paragraphs (a)(1) through (5) of this section. The generator must mark or label the container(s) holding the excess accumulation of hazardous waste with the date the excess amount began accumulating.\"],\"scope_text\":\"During the three-consecutive-calendar-day period when accumulating acute or non-acute hazardous waste in excess of the amounts listed in paragraph (a)\",\"section_id\":\"section-1\",\"start\":4351,\"summary\":\"When a generator accumulates acute hazardous waste listed in § 261.31 or § 261.33(e) or non-acute hazardous waste in excess of the amounts listed in § 262.15(a) at or near any point of generation, during the three-consecutive-calendar-day period the generator must continue to comply with paragraphs (a)(1) through (5) of § 262.15.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

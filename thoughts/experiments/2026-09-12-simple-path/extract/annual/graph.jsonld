      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"The generator\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:7d694d5732464b5d78093ff3db36feef73ca61da06e8acab8f2b969c37d7a1c6\",\"urn:rulespec:document-understanding:assertion:bad36f40a449922fa0c027ece37cea6eaa7e339406525ac8e94e8086028ad94f\",\"urn:rulespec:document-understanding:assertion:2b682b3a09f4cc36b0d9598f5a4822d27bc98ed1f428ef9849264ec359642e6c\",\"urn:rulespec:document-understanding:assertion:0b9a481142bb2f82cfbbe99c90219916d4c8fe70ddfaf934e05d7f8123bf240c\",\"urn:rulespec:document-understanding:assertion:855b1f088a1e6c51304a45b2e86785b2943222491a23b31cc343126b5687ea45\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":4648,\"evidence\":[{\"end\":4648,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ae83b7297b741d59fb878775fd631eeb28a5aa35359e885bf29ca58f62f120732:4351:4648:sha256-01c6ed3b7a204678a029a38a2fd07447e3a11ed250ae75d98d7c00f2daefe972\",\"quote\":\"(iii) During the three-consecutive-calendar-day period the generator must continue to comply with paragraphs (a)(1) through (5) of this section. The generator must mark or label the container(s) holding the excess accumulation of hazardous waste with the date the excess amount began accumulating.\",\"start\":4351},{\"end\":4509,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ae83b7297b741d59fb878775fd631eeb28a5aa35359e885bf29ca58f62f120732:4496:4509:sha256-91a23b8e2e1ccbee893728a484dad3798931830a3e56984a461cdbb1ec9a745b\",\"quote\":\"The generator\",\"start\":4496},{\"end\":3845,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ae83b7297b741d59fb878775fd631eeb28a5aa35359e885bf29ca58f62f120732:3583:3845:sha256-004bfacd70f49688c10c41107890341ecd181de2a1a742ac361b585c6cb09683\",\"quote\":\"(6) A generator who accumulates either acute hazardous waste listed in § 261.31 or § 261.33(e) of this chapter or non-acute hazardous waste in excess of the amounts listed in paragraph (a) of this section at or near any point of generation must do the following:\",\"start\":3583},{\"end\":4648,\"field\":\"scope_text:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ae83b7297b741d59fb878775fd631eeb28a5aa35359e885bf29ca58f62f120732:4351:4648:sha256-01c6ed3b7a204678a029a38a2fd07447e3a11ed250ae75d98d7c00f2daefe972\",\"quote\":\"(iii) During the three-consecutive-calendar-day period the generator must continue to comply with paragraphs (a)(1) through (5) of this section. The generator must mark or label the container(s) holding the excess accumulation of hazardous waste with the date the excess amount began accumulating.\",\"start\":4351}],\"id\":\"urn:rulespec:document-understanding:revision:e3d28db3316fca248eb3d035c9bfca9511046d51ec6a46070de58aea856669bd\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:855b1f088a1e6c51304a45b2e86785b2943222491a23b31cc343126b5687ea45\",\"modality\":\"must\",\"modality_quote\":\"must\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:c05dd756e6e48eb7874da3f5f1b96a3db214d88b4ecefb0be87a852842e5d6e7\",\"origin\":\"aiSuggested\",\"quote\":\"(iii) During the three-consecutive-calendar-day period the generator must continue to comply with paragraphs (a)(1) through (5) of this section. The generator must mark or label the container(s) holding the excess accumulation of hazardous waste with the date the excess amount began accumulating.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:2f30afe8c1cab0364035658247e943be5deed2bf4e0a0235c71ec0ec1b3a00c3\",\"scope_quotes\":[\"(6) A generator who accumulates either acute hazardous waste listed in § 261.31 or § 261.33(e) of this chapter or non-acute hazardous waste in excess of the amounts listed in paragraph (a) of this section at or near any point of generation must do the following:\",\"(iii) During the three-consecutive-calendar-day period the generator must continue to comply with paragraphs (a)(1) through (5) of this section. The generator must mark or label the container(s) holding the excess accumulation of hazardous waste with the date the excess amount began accumulating.\"],\"scope_text\":\"holding the excess accumulation of hazardous waste\",\"section_id\":\"section-1\",\"start\":4351,\"summary\":\"When a generator accumulates acute hazardous waste listed in § 261.31 or § 261.33(e) or non-acute hazardous waste in excess of the amounts listed in § 262.15(a) at or near any point of generation, the generator must mark or label the container(s) holding the excess accumulation of hazardous waste with the date the excess amount began accumulating.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

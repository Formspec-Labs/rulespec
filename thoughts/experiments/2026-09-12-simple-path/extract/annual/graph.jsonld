    {
      "@id": "urn:rulespec:document-understanding:revision:0745f74a6c2ad16083feb6554594542ccf7505f8bcd502ec638c9534237197a0",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:0745f74a6c2ad16083feb6554594542ccf7505f8bcd502ec638c9534237197a0",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:8d5e1f0ce74304ddf421ed493f11164352791e975146446ff0a3fab11915f5cb",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"A generator who accumulates either acute hazardous waste listed in § 261.31 or § 261.33(e) of this chapter or non-acute hazardous waste in excess of the amounts listed in paragraph (a) of this section at or near any point of generation\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:6fe5e39a493e861f12edcf531aa4ce5b85db1f49e40005ff517e1e4e4172fc5b\",\"urn:rulespec:document-understanding:assertion:18341fe25a63280a3ec9a5220e55586b91160185ab6b391862557e4c0db880fb\",\"urn:rulespec:document-understanding:assertion:0c973595728f386291924d2721f9004504b289371629c7bbcbc465fd9610c2ed\",\"urn:rulespec:document-understanding:assertion:5d2665d7cfccc4f62f37e1e7b0ab52a537ba6b3b0de55d3d6af6cd7ad7246df7\",\"urn:rulespec:document-understanding:assertion:f3f20954a89ff13fe9129752e0b00ea6883b2e1a9357ff187af5c802003e0db1\",\"urn:rulespec:document-understanding:assertion:0a43b8e0ebee1c570d3f6e9173cc8eab4223238480c3fe1d5508753a55725fb0\"],\"choice_quote\":\"(i) Comply within three consecutive calendar days with the applicable central accumulation area regulations in § 262.16(b) or § 262.17(a), or\\n\\n(ii) Remove the excess from the satellite accumulation area within three consecutive calendar days to either:\\n\\n(A) A central accumulation area operated in accordance with the applicable regulations in § 262.16(b) or § 262.17(a);\\n\\n(B) An on-site interim status or permitted treatment, storage, or disposal facility, or\\n\\n(C) An off-site designated facility; and\",\"choice_text\":\"The generator must within three consecutive calendar days do either: (1) comply with applicable central accumulation area regulations in § 262.16(b) or § 262.17(a); or (2) remove the excess from the satellite accumulation area to either (A) a central accumulation area operated in accordance with § 262.16(b) or § 262.17(a), (B) an on-site interim status or permitted treatment, storage, or disposal facility, or (C) an off-site designated facility.\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[\"(a) A generator may accumulate as much as 55 gallons of non-acute hazardous waste and/or either one quart of liquid acute hazardous waste listed in § 261.31 or § 261.33(e) of this chapter or 1 kg (2.2 lbs) of solid acute hazardous waste listed in § 261.31 or § 261.33(e) of this chapter in containers at or near any point of generation where wastes initially accumulate which is under the control of the operator of the process generating the waste, without a permit or interim status and without complying with the requirements of parts 124, 264 through 267, and 270 of this chapter, provided that all of the conditions for exemption in this section are met. A generator may comply with the conditions for exemption in this section instead of complying with the conditions for exemption in § 262.16(b) or § 262.17(a), except as required in § 262.15(a)(7) and (8). The conditions for exemption for satellite accumulation are:\"],\"defined_terms\":[],\"effective_periods\":[],\"end\":4349,\"evidence\":[{\"end\":4349,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ae83b7297b741d59fb878775fd631eeb28a5aa35359e885bf29ca58f62f120732:3583:4349:sha256-550107a789a39b05daf6d654b4cc71a83fd2335b6be4bc16f0ec073961eb9a9b\",\"quote\":\"(6) A generator who accumulates either acute hazardous waste listed in § 261.31 or § 261.33(e) of this chapter or non-acute hazardous waste in excess of the amounts listed in paragraph (a) of this section at or near any point of generation must do the following:\\n\\n(i) Comply within three consecutive calendar days with the applicable central accumulation area regulations in § 262.16(b) or § 262.17(a), or\\n\\n(ii) Remove the excess from the satellite accumulation area within three consecutive calendar days to either:\\n\\n(A) A central accumulation area operated in accordance with the applicable regulations in § 262.16(b) or § 262.17(a);\\n\\n(B) An on-site interim status or permitted treatment, storage, or disposal facility, or\\n\\n(C) An off-site designated facility; and\",\"start\":3583},{\"end\":3822,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ae83b7297b741d59fb878775fd631eeb28a5aa35359e885bf29ca58f62f120732:3587:3822:sha256-5c6befaa885eca65f98e8c366aef0f0de6561ea94d6108b6ee60b867e3015c0a\",\"quote\":\"A generator who accumulates either acute hazardous waste listed in § 261.31 or § 261.33(e) of this chapter or non-acute hazardous waste in excess of the amounts listed in paragraph (a) of this section at or near any point of generation\",\"start\":3587},{\"end\":3827,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ae83b7297b741d59fb878775fd631eeb28a5aa35359e885bf29ca58f62f120732:3823:3827:sha256-4137b01e139589b7a1d3b3fc4da031d8ce5bb415808734e970c3a58ea0e98f0f\",\"quote\":\"must\",\"start\":3823},{\"end\":4349,\"field\":\"choice_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ae83b7297b741d59fb878775fd631eeb28a5aa35359e885bf29ca58f62f120732:3847:4349:sha256-83644cc73636a0f2784853f0dd210389bb56b458c93a47e53bf0b27d38db0366\",\"quote\":\"(i) Comply within three consecutive calendar days with the applicable central accumulation area regulations in § 262.16(b) or § 262.17(a), or\\n\\n(ii) Remove the excess from the satellite accumulation area within three consecutive calendar days to either:\\n\\n(A) A central accumulation area operated in accordance with the applicable regulations in § 262.16(b) or § 262.17(a);\\n\\n(B) An on-site interim status or permitted treatment, storage, or disposal facility, or\\n\\n(C) An off-site designated facility; and\",\"start\":3847},{\"end\":3845,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ae83b7297b741d59fb878775fd631eeb28a5aa35359e885bf29ca58f62f120732:3583:3845:sha256-004bfacd70f49688c10c41107890341ecd181de2a1a742ac361b585c6cb09683\",\"quote\":\"(6) A generator who accumulates either acute hazardous waste listed in § 261.31 or § 261.33(e) of this chapter or non-acute hazardous waste in excess of the amounts listed in paragraph (a) of this section at or near any point of generation must do the following:\",\"start\":3583},{\"end\":1247,\"field\":\"context:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ae83b7297b741d59fb878775fd631eeb28a5aa35359e885bf29ca58f62f120732:322:1247:sha256-9d5462ca5acb5b64b79b4fb6c7300dcb44210d3f68fcb2c26e7ecdffde248bd6\",\"quote\":\"(a) A generator may accumulate as much as 55 gallons of non-acute hazardous waste and/or either one quart of liquid acute hazardous waste listed in § 261.31 or § 261.33(e) of this chapter or 1 kg (2.2 lbs) of solid acute hazardous waste listed in § 261.31 or § 261.33(e) of this chapter in containers at or near any point of generation where wastes initially accumulate which is under the control of the operator of the process generating the waste, without a permit or interim status and without complying with the requirements of parts 124, 264 through 267, and 270 of this chapter, provided that all of the conditions for exemption in this section are met. A generator may comply with the conditions for exemption in this section instead of complying with the conditions for exemption in § 262.16(b) or § 262.17(a), except as required in § 262.15(a)(7) and (8). The conditions for exemption for satellite accumulation are:\",\"start\":322}],\"id\":\"urn:rulespec:document-understanding:revision:0745f74a6c2ad16083feb6554594542ccf7505f8bcd502ec638c9534237197a0\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:0a43b8e0ebee1c570d3f6e9173cc8eab4223238480c3fe1d5508753a55725fb0\",\"modality\":\"must\",\"modality_quote\":\"must\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:dc9eb4259d91cbd0cb8adc0981639ac7b3fb1365d79ddb1b94d63766a6fa9c32\",\"origin\":\"aiSuggested\",\"quote\":\"(6) A generator who accumulates either acute hazardous waste listed in § 261.31 or § 261.33(e) of this chapter or non-acute hazardous waste in excess of the amounts listed in paragraph (a) of this section at or near any point of generation must do the following:\\n\\n(i) Comply within three consecutive calendar days with the applicable central accumulation area regulations in § 262.16(b) or § 262.17(a), or\\n\\n(ii) Remove the excess from the satellite accumulation area within three consecutive calendar days to either:\\n\\n(A) A central accumulation area operated in accordance with the applicable regulations in § 262.16(b) or § 262.17(a);\\n\\n(B) An on-site interim status or permitted treatment, storage, or disposal facility, or\\n\\n(C) An off-site designated facility; and\",\"references\":[\"§ 261.31\",\"§ 261.33(e)\",\"§ 262.16(b)\",\"§ 262.17(a)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:485db1f156ca0d8dc3e72698ab65d61dfa7c1b07fef13cdb5282412052970709\",\"scope_quotes\":[\"(6) A generator who accumulates either acute hazardous waste listed in § 261.31 or § 261.33(e) of this chapter or non-acute hazardous waste in excess of the amounts listed in paragraph (a) of this section at or near any point of generation must do the following:\"],\"scope_text\":\"A generator who accumulates either acute hazardous waste listed in § 261.31 or § 261.33(e) of this chapter or non-acute hazardous waste in excess of the amounts listed in paragraph (a) of this section at or near any point of generation\",\"section_id\":\"section-1\",\"start\":3583,\"summary\":\"A generator who accumulates either acute hazardous waste listed in § 261.31 or § 261.33(e) of this chapter or non-acute hazardous waste in excess of the amounts listed in § 262.15(a) at or near any point of generation must either: (i) comply within three consecutive calendar days with the applicable central accumulation area regulations in § 262.16(b) or § 262.17(a), or (ii) remove the excess from the satellite accumulation area within three consecutive calendar days to either (A) a central accumulation area operated in accordance with the applicable regulations in § 262.16(b) or § 262.17(a), (B) an on-site interim status or permitted treatment, storage, or disposal facility, or (C) an off-site designated facility.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",
      "dcterms:references": [

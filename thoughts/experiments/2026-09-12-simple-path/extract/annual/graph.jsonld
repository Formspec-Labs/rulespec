      "rkaf:hasContentDigest": "sha256:a70817458bf66ca66bb6aa3e81c6e5631629cb6befd184b82fd0989ce6391ff0",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:780c71b7253242290d560709db58a519958b2379fb96acf0e3fe78e40ba39313\",\"urn:rulespec:document-understanding:assertion:5f1f94d0cbe719b05509b4a58234b51b18a9b953de20d1e6db85eba292628574\",\"urn:rulespec:document-understanding:assertion:4255eaf428e651db7b297b60bf1a146d279921cc99b7ed63a74f4f369770c147\",\"urn:rulespec:document-understanding:assertion:7406c53508b3c855b4364915ad1e244706fad7b293d7f714b8a39b3003dd8403\",\"urn:rulespec:document-understanding:assertion:320519626de7717f33ba2c8464d5b86331980271887efc6ba2f35cadfaf7f98a\"],\"choice_quote\":\"(4) A container holding hazardous waste must be closed at all times during accumulation, except:\\n\\n(i) When adding, removing, or consolidating waste; or\\n\\n(ii) When temporary venting of a container is necessary\\n\\n(A) For the proper operation of equipment, or\\n\\n(B) To prevent dangerous situations, such as build-up of extreme pressure.\",\"choice_text\":\"The container must be closed at all times except during: (1) adding, removing, or consolidating waste; or (2) temporary venting when necessary either (a) for proper operation of equipment or (b) to prevent dangerous situations such as build-up of extreme pressure.\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[\"(a) A generator may accumulate as much as 55 gallons of non-acute hazardous waste and/or either one quart of liquid acute hazardous waste listed in § 261.31 or § 261.33(e) of this chapter or 1 kg (2.2 lbs) of solid acute hazardous waste listed in § 261.31 or § 261.33(e) of this chapter in containers at or near any point of generation where wastes initially accumulate which is under the control of the operator of the process generating the waste, without a permit or interim status and without complying with the requirements of parts 124, 264 through 267, and 270 of this chapter, provided that all of the conditions for exemption in this section are met. A generator may comply with the conditions for exemption in this section instead of complying with the conditions for exemption in § 262.16(b) or § 262.17(a), except as required in § 262.15(a)(7) and (8). The conditions for exemption for satellite accumulation are:\"],\"defined_terms\":[],\"effective_periods\":[],\"end\":2889,\"evidence\":[{\"end\":2889,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ae83b7297b741d59fb878775fd631eeb28a5aa35359e885bf29ca58f62f120732:2558:2889:sha256-3e218b59307d549f0554f596965fd2e35e085144741127ca8d380bfd46c6d6a2\",\"quote\":\"(4) A container holding hazardous waste must be closed at all times during accumulation, except:\\n\\n(i) When adding, removing, or consolidating waste; or\\n\\n(ii) When temporary venting of a container is necessary\\n\\n(A) For the proper operation of equipment, or\\n\\n(B) To prevent dangerous situations, such as build-up of extreme pressure.\",\"start\":2558},{\"end\":2602,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ae83b7297b741d59fb878775fd631eeb28a5aa35359e885bf29ca58f62f120732:2598:2602:sha256-4137b01e139589b7a1d3b3fc4da031d8ce5bb415808734e970c3a58ea0e98f0f\",\"quote\":\"must\",\"start\":2598},{\"end\":2889,\"field\":\"choice_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ae83b7297b741d59fb878775fd631eeb28a5aa35359e885bf29ca58f62f120732:2558:2889:sha256-3e218b59307d549f0554f596965fd2e35e085144741127ca8d380bfd46c6d6a2\",\"quote\":\"(4) A container holding hazardous waste must be closed at all times during accumulation, except:\\n\\n(i) When adding, removing, or consolidating waste; or\\n\\n(ii) When temporary venting of a container is necessary\\n\\n(A) For the proper operation of equipment, or\\n\\n(B) To prevent dangerous situations, such as build-up of extreme pressure.\",\"start\":2558},{\"end\":2889,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ae83b7297b741d59fb878775fd631eeb28a5aa35359e885bf29ca58f62f120732:2558:2889:sha256-3e218b59307d549f0554f596965fd2e35e085144741127ca8d380bfd46c6d6a2\",\"quote\":\"(4) A container holding hazardous waste must be closed at all times during accumulation, except:\\n\\n(i) When adding, removing, or consolidating waste; or\\n\\n(ii) When temporary venting of a container is necessary\\n\\n(A) For the proper operation of equipment, or\\n\\n(B) To prevent dangerous situations, such as build-up of extreme pressure.\",\"start\":2558},{\"end\":1247,\"field\":\"context:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ae83b7297b741d59fb878775fd631eeb28a5aa35359e885bf29ca58f62f120732:322:1247:sha256-9d5462ca5acb5b64b79b4fb6c7300dcb44210d3f68fcb2c26e7ecdffde248bd6\",\"quote\":\"(a) A generator may accumulate as much as 55 gallons of non-acute hazardous waste and/or either one quart of liquid acute hazardous waste listed in § 261.31 or § 261.33(e) of this chapter or 1 kg (2.2 lbs) of solid acute hazardous waste listed in § 261.31 or § 261.33(e) of this chapter in containers at or near any point of generation where wastes initially accumulate which is under the control of the operator of the process generating the waste, without a permit or interim status and without complying with the requirements of parts 124, 264 through 267, and 270 of this chapter, provided that all of the conditions for exemption in this section are met. A generator may comply with the conditions for exemption in this section instead of complying with the conditions for exemption in § 262.16(b) or § 262.17(a), except as required in § 262.15(a)(7) and (8). The conditions for exemption for satellite accumulation are:\",\"start\":322}],\"id\":\"urn:rulespec:document-understanding:revision:c9daac110274c55d0b15a341be5b302ee38321a2b7da5deb8561fa4834129693\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:320519626de7717f33ba2c8464d5b86331980271887efc6ba2f35cadfaf7f98a\",\"modality\":\"must\",\"modality_quote\":\"must\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:95ad1c1d8ebf1e839ea32c4d5d62f881383dc63f9291ed213240dfb0a49cd61a\",\"origin\":\"aiSuggested\",\"quote\":\"(4) A container holding hazardous waste must be closed at all times during accumulation, except:\\n\\n(i) When adding, removing, or consolidating waste; or\\n\\n(ii) When temporary venting of a container is necessary\\n\\n(A) For the proper operation of equipment, or\\n\\n(B) To prevent dangerous situations, such as build-up of extreme pressure.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:a8a6bc8913ffc3eb91558822e9f67c64c0432951e0364e35bdd42b932831a1e9\",\"scope_quotes\":[\"(4) A container holding hazardous waste must be closed at all times during accumulation, except:\\n\\n(i) When adding, removing, or consolidating waste; or\\n\\n(ii) When temporary venting of a container is necessary\\n\\n(A) For the proper operation of equipment, or\\n\\n(B) To prevent dangerous situations, such as build-up of extreme pressure.\"],\"scope_text\":\"except: (i) When adding, removing, or consolidating waste; or (ii) When temporary venting of a container is necessary (A) For the proper operation of equipment, or (B) To prevent dangerous situations, such as build-up of extreme pressure.\",\"section_id\":\"section-1\",\"start\":2558,\"summary\":\"Under the conditions for exemption for satellite accumulation, a container holding hazardous waste must be closed at all times during accumulation, except: (i) when adding, removing, or consolidating waste; or (ii) when temporary venting of a container is necessary (A) for the proper operation of equipment, or (B) to prevent dangerous situations, such as build-up of extreme pressure.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

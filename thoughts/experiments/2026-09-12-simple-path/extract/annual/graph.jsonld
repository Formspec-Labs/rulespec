    {
      "@id": "urn:rulespec:document-understanding:assertion:5880cdc2dbcf65aa921d6f0e2dd8b1de059bd272664720ed1d1efb348acf784f",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:9f38eede9287300b007f7d290305923e22f0067dcac542da368888b072877171",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:63537b449fa619edeb102a4fba9eacf8288dc09d02088122008aa22d283e4824",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:786b0217745f9c742cd9e6f4a698431e65654f9db07c2ad69e43382850f3191c",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:states-requirement",
      "rkaf:assertsValue": {
        "@value": "Under the conditions for exemption for satellite accumulation, a generator must mark or label its container with both: (i) the words “Hazardous Waste” and (ii) an indication of the hazards of the contents (examples include, but are not limited to, the applicable hazardous waste characteristic(s) (i.e., ignitable, corrosive, reactive, toxic); hazard communication consistent with DOT requirements at 49 CFR part 172 subpart E (labeling) or subpart F (placarding); a hazard statement or pictogram consistent with OSHA Hazard Communication Standard at 29 CFR 1910.1200; or a chemical hazard label consistent with NFPA code 704).",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

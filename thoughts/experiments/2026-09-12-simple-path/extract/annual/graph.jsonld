      "@id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ae83b7297b741d59fb878775fd631eeb28a5aa35359e885bf29ca58f62f120732:1249:1614:sha256-819bb8cb1be80d00df9bdaa53929b892a7691e2f01bf10b41014a12c30c6c770",
      "@type": "rkaf:SourceFragment",
      "oa:hasSource": "urn:rulespec:document-understanding:document:e83b7297b741d59fb878775fd631eeb28a5aa35359e885bf29ca58f62f120732",
      "rkaf:fragmentIdentityScheme": "rkaf:carrier-local-fragment",
      "rkaf:sourceArtifactDigest": "sha256:e83b7297b741d59fb878775fd631eeb28a5aa35359e885bf29ca58f62f120732",
      "rkaf:fragmentContentDigest": "sha256:819bb8cb1be80d00df9bdaa53929b892a7691e2f01bf10b41014a12c30c6c770",
      "rkaf:selectorKind": [
        "oa:TextQuoteSelector",
        "oa:TextPositionSelector"
      ],
      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "(1) If a container holding hazardous waste is not in good condition, or if it begins to leak, the generator must immediately transfer the hazardous waste from this container to a container that is in good condition and does not leak, or immediately transfer and manage the waste in a central accumulation area operated in compliance with § 262.16(b) or § 262.17(a)."
        },

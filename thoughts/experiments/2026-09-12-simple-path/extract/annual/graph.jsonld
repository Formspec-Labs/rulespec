      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:choice_text",
      "rkaf:assertsValue": {
        "@value": "The container must be closed at all times except during: (1) adding, removing, or consolidating waste; or (2) temporary venting when necessary either (a) for proper operation of equipment or (b) to prevent dangerous situations such as build-up of extreme pressure.",

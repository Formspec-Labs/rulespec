    {
      "@id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A954afb164b0087d7b402ec321589cfcb8ad9ce1bcb8381ed8e67a21327e85a01:2557:3604:sha256-8c347783710d2fba89faf1f40e8e77aca8ea89b09710f8ac699940a928e4e335",
      "@type": "rkaf:SourceFragment",
      "oa:hasSource": "urn:rulespec:document-understanding:document:954afb164b0087d7b402ec321589cfcb8ad9ce1bcb8381ed8e67a21327e85a01",
      "rkaf:fragmentIdentityScheme": "rkaf:carrier-local-fragment",
      "rkaf:sourceArtifactDigest": "sha256:954afb164b0087d7b402ec321589cfcb8ad9ce1bcb8381ed8e67a21327e85a01",
      "rkaf:fragmentContentDigest": "sha256:8c347783710d2fba89faf1f40e8e77aca8ea89b09710f8ac699940a928e4e335",
      "rkaf:selectorKind": [
        "oa:TextQuoteSelector",
        "oa:TextPositionSelector"
      ],
      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": " or 12406 of title 10, or other provision of law, as applicable, or\n\n(ii) full-time military service for his State, the District of Columbia, the Commonwealth of Puerto Rico, or a territory of the United States; or\n\n\n(B) performs full-time military service as a result of a call or order to active duty in support of a contingency operation as defined in section 101(a)(13) of title 10;\n\n\n\nis entitled, during and because of such service, to leave without loss of, or reduction in, pay, leave to which he otherwise is entitled, credit for time or service, or performance or efficiency rating. Leave granted by this subsection shall not exceed 22 workdays in a calendar year. Upon the request of an employee, the period for which an employee is absent to perform service described in paragraph (2) may be charged to the employee’s accrued annual leave or to compensatory time available to the employee instead of being charged as leave to which the employee is entitled under this subsection. The period of absence may not be charged to sick leave."
        },
        {
          "@type": "oa:TextPositionSelector",
          "oa:start": 2557,
          "oa:end": 3604,
          "rkaf:coordinateSystem": "rkaf:unicode-codepoint"
        }
      ]
    },
    {
      "@id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A954afb164b0087d7b402ec321589cfcb8ad9ce1bcb8381ed8e67a21327e85a01:1741:1900:sha256-1b50db66224b09a206302c638a49ab9a9f5b63e0f52b35b05b27d8b0df4edf79",

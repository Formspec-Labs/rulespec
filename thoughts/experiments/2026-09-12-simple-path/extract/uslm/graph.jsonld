      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:ba31332a730bbc2ddf3f84680ecf4e87b20c5da759bc32ff4c5eef60c61f9ed3\",\"urn:rulespec:document-understanding:assertion:2c9812c31bf2d3d87520f950c80c3f4610a6daed685e65d7fb11bbf5a3ac40e8\",\"urn:rulespec:document-understanding:assertion:a992300b83c6aa11f36418b9f77f79260a34db9a28439033b575618e1d798397\",\"urn:rulespec:document-understanding:assertion:12d2f61a1fab3988e53dec26a44fb127f18ba046199f0cf3ddcf199c2948aab6\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":1566,\"evidence\":[{\"end\":1566,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A954afb164b0087d7b402ec321589cfcb8ad9ce1bcb8381ed8e67a21327e85a01:1156:1566:sha256-9ef0217718fffb99ea6047f3c530f1c7f52adaaa6dda07cfdb5cbf12865c82a8\",\"quote\":\"(2) In the case of an employee or individual employed on a part-time career employment basis (as defined in section 3401(2) of this title), the rate at which leave accrues under this subsection shall be a percentage of the rate prescribed under paragraph (1) which is determined by dividing 40 into the number of hours in the regularly scheduled workweek of that employee or individual during that fiscal year.\",\"start\":1156},{\"end\":1355,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A954afb164b0087d7b402ec321589cfcb8ad9ce1bcb8381ed8e67a21327e85a01:1350:1355:sha256-56ee5b508706bf2de91712d85d6d1e11ddbff01949142ed6e8c22e3b1bed1c71\",\"quote\":\"shall\",\"start\":1350},{\"end\":1566,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A954afb164b0087d7b402ec321589cfcb8ad9ce1bcb8381ed8e67a21327e85a01:1156:1566:sha256-9ef0217718fffb99ea6047f3c530f1c7f52adaaa6dda07cfdb5cbf12865c82a8\",\"quote\":\"(2) In the case of an employee or individual employed on a part-time career employment basis (as defined in section 3401(2) of this title), the rate at which leave accrues under this subsection shall be a percentage of the rate prescribed under paragraph (1) which is determined by dividing 40 into the number of hours in the regularly scheduled workweek of that employee or individual during that fiscal year.\",\"start\":1156}],\"id\":\"urn:rulespec:document-understanding:revision:48c08b1a56a3d59f55870c9851f36fb5e28b741f6ebd596e67d16e1e2232be3c\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:12d2f61a1fab3988e53dec26a44fb127f18ba046199f0cf3ddcf199c2948aab6\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:31f2395490b649417f0fd0480d6b4bda4795ef5647e87c9fb7a92c0cac3e7691\",\"origin\":\"aiSuggested\",\"quote\":\"(2) In the case of an employee or individual employed on a part-time career employment basis (as defined in section 3401(2) of this title), the rate at which leave accrues under this subsection shall be a percentage of the rate prescribed under paragraph (1) which is determined by dividing 40 into the number of hours in the regularly scheduled workweek of that employee or individual during that fiscal year.\",\"references\":[\"section 3401(2) of this title\",\"paragraph (1)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:53c7ec1c41918e24e3081b56bf29866d03672784dec4f75bef98ba385cc31eb6\",\"scope_quotes\":[\"(2) In the case of an employee or individual employed on a part-time career employment basis (as defined in section 3401(2) of this title), the rate at which leave accrues under this subsection shall be a percentage of the rate prescribed under paragraph (1) which is determined by dividing 40 into the number of hours in the regularly scheduled workweek of that employee or individual during that fiscal year.\"],\"scope_text\":\"In the case of an employee or individual employed on a part-time career employment basis (as defined in section 3401(2) of this title)\",\"section_id\":\"urn:rulespec:document-understanding:section:c52d8ba2222add6089873e5d381a4224a0305581afa5496b81a8478da280bbd2\",\"start\":1156,\"summary\":\"In the case of an employee or individual employed on a part-time career employment basis (as defined in section 3401(2) of this title), the rate at which leave accrues under 5 U.S.C. 6323(a) shall be a percentage of the rate prescribed under paragraph (1) which is determined by dividing 40 into the number of hours in the regularly scheduled workweek of that employee or individual during that fiscal year.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

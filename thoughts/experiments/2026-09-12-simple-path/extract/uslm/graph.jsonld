      "@id": "urn:rulespec:document-understanding:revision:d746cc85bd3f6f795eb6684b3cd04ed0e364bb15a41b0b35a5b5c52e4f55bd22",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:d746cc85bd3f6f795eb6684b3cd04ed0e364bb15a41b0b35a5b5c52e4f55bd22",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:7deb55eec2f80c6514e84f21d2e2d09845626454c965afda32b3ba90999d3d6b",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:c5cce9ffba067e73275efc5347f12e4c27621bc2e08c916c2fe48ffd62457d15\",\"urn:rulespec:document-understanding:assertion:d50c63bf27c57a02a4969615f949f8a8e7b06bd917e08740adec8048b9be7342\",\"urn:rulespec:document-understanding:assertion:1f444ae3506e188686c1dd3a4b1bbd374c48bfdecdaa5874e8c5b7997b2a0c86\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":3604,\"evidence\":[{\"end\":3604,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A954afb164b0087d7b402ec321589cfcb8ad9ce1bcb8381ed8e67a21327e85a01:2947:3604:sha256-c8d2ddbc7beefeadc576ddf0ab4ecf7827b7dac3363df59d97aa6da9d10443aa\",\"quote\":\"is entitled, during and because of such service, to leave without loss of, or reduction in, pay, leave to which he otherwise is entitled, credit for time or service, or performance or efficiency rating. Leave granted by this subsection shall not exceed 22 workdays in a calendar year. Upon the request of an employee, the period for which an employee is absent to perform service described in paragraph (2) may be charged to the employee’s accrued annual leave or to compensatory time available to the employee instead of being charged as leave to which the employee is entitled under this subsection. The period of absence may not be charged to sick leave.\",\"start\":2947},{\"end\":3578,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A954afb164b0087d7b402ec321589cfcb8ad9ce1bcb8381ed8e67a21327e85a01:3571:3578:sha256-0007a8bea4dcd3f6b1490fc7199650f1046713dd92d9314e1f2ede6946fcd999\",\"quote\":\"may not\",\"start\":3571}],\"id\":\"urn:rulespec:document-understanding:revision:d746cc85bd3f6f795eb6684b3cd04ed0e364bb15a41b0b35a5b5c52e4f55bd22\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"prohibition\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:1f444ae3506e188686c1dd3a4b1bbd374c48bfdecdaa5874e8c5b7997b2a0c86\",\"modality\":\"must_not\",\"modality_quote\":\"may not\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:7b342e0e1880e4e861dae4c13059699292d3ccb923a0639a66fec5df2b3bf430\",\"origin\":\"aiSuggested\",\"quote\":\"is entitled, during and because of such service, to leave without loss of, or reduction in, pay, leave to which he otherwise is entitled, credit for time or service, or performance or efficiency rating. Leave granted by this subsection shall not exceed 22 workdays in a calendar year. Upon the request of an employee, the period for which an employee is absent to perform service described in paragraph (2) may be charged to the employee’s accrued annual leave or to compensatory time available to the employee instead of being charged as leave to which the employee is entitled under this subsection. The period of absence may not be charged to sick leave.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:f20283a23d79937383fa7771391acdc4cb407ed02be9999f9333e51ed611d9bd\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"urn:rulespec:document-understanding:section:c52d8ba2222add6089873e5d381a4224a0305581afa5496b81a8478da280bbd2\",\"start\":2947,\"summary\":\"The period of absence to perform service described in 5 U.S.C. 6323(b)(2) may not be charged to sick leave.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

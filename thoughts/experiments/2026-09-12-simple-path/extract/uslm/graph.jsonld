      "rkaf:hasContentDigest": "sha256:f9aa343bf03e947b97ac4e586b0c66274e38929face8ef9ab69ddcf3fa8b0fa3",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:b9be0d5e91d3cc13502149a08bd6d0e6df18ad8c0916034ff68c1f4873e4f686\",\"urn:rulespec:document-understanding:assertion:fa4cf46a724bf94ae595bf2538aeb12d2d7f2a6ebe794d847e0d4f72b15c909d\",\"urn:rulespec:document-understanding:assertion:9b13d67b2139a7369c203de1f9eb4c42dd2e2fccc97245c5e68379a5a83c0fd5\",\"urn:rulespec:document-understanding:assertion:aa0be4c32241c4c8e216fcb10f60aaa22141f3b234f09c666abe367cc544635a\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":3604,\"evidence\":[{\"end\":3604,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A954afb164b0087d7b402ec321589cfcb8ad9ce1bcb8381ed8e67a21327e85a01:2947:3604:sha256-c8d2ddbc7beefeadc576ddf0ab4ecf7827b7dac3363df59d97aa6da9d10443aa\",\"quote\":\"is entitled, during and because of such service, to leave without loss of, or reduction in, pay, leave to which he otherwise is entitled, credit for time or service, or performance or efficiency rating. Leave granted by this subsection shall not exceed 22 workdays in a calendar year. Upon the request of an employee, the period for which an employee is absent to perform service described in paragraph (2) may be charged to the employee’s accrued annual leave or to compensatory time available to the employee instead of being charged as leave to which the employee is entitled under this subsection. The period of absence may not be charged to sick leave.\",\"start\":2947},{\"end\":3604,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A954afb164b0087d7b402ec321589cfcb8ad9ce1bcb8381ed8e67a21327e85a01:2947:3604:sha256-c8d2ddbc7beefeadc576ddf0ab4ecf7827b7dac3363df59d97aa6da9d10443aa\",\"quote\":\"is entitled, during and because of such service, to leave without loss of, or reduction in, pay, leave to which he otherwise is entitled, credit for time or service, or performance or efficiency rating. Leave granted by this subsection shall not exceed 22 workdays in a calendar year. Upon the request of an employee, the period for which an employee is absent to perform service described in paragraph (2) may be charged to the employee’s accrued annual leave or to compensatory time available to the employee instead of being charged as leave to which the employee is entitled under this subsection. The period of absence may not be charged to sick leave.\",\"start\":2947}],\"id\":\"urn:rulespec:document-understanding:revision:31828d25d45f0804df7e6682b5497159cb3af5bfe3b542cfc1c4b6d9e1958b9d\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"permission\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:aa0be4c32241c4c8e216fcb10f60aaa22141f3b234f09c666abe367cc544635a\",\"modality\":\"may\",\"modality_quote\":\"may\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:7e33502bb5295bb37f8b49222b312eeb7864c6edeeb50005313cc526efff2887\",\"origin\":\"aiSuggested\",\"quote\":\"is entitled, during and because of such service, to leave without loss of, or reduction in, pay, leave to which he otherwise is entitled, credit for time or service, or performance or efficiency rating. Leave granted by this subsection shall not exceed 22 workdays in a calendar year. Upon the request of an employee, the period for which an employee is absent to perform service described in paragraph (2) may be charged to the employee’s accrued annual leave or to compensatory time available to the employee instead of being charged as leave to which the employee is entitled under this subsection. The period of absence may not be charged to sick leave.\",\"references\":[\"paragraph (2)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:a3ab936efb446c087e251102fee8d0d143524199cddd077428ea6d21dd10724b\",\"scope_quotes\":[\"is entitled, during and because of such service, to leave without loss of, or reduction in, pay, leave to which he otherwise is entitled, credit for time or service, or performance or efficiency rating. Leave granted by this subsection shall not exceed 22 workdays in a calendar year. Upon the request of an employee, the period for which an employee is absent to perform service described in paragraph (2) may be charged to the employee’s accrued annual leave or to compensatory time available to the employee instead of being charged as leave to which the employee is entitled under this subsection. The period of absence may not be charged to sick leave.\"],\"scope_text\":\"Upon the request of an employee, the period for which an employee is absent to perform service described in paragraph (2)\",\"section_id\":\"urn:rulespec:document-understanding:section:c52d8ba2222add6089873e5d381a4224a0305581afa5496b81a8478da280bbd2\",\"start\":2947,\"summary\":\"Upon the request of an employee, the period for which an employee is absent to perform service described in paragraph (2) of 5 U.S.C. 6323(b) may be charged to the employee’s accrued annual leave or to compensatory time available to the employee instead of being charged as leave to which the employee is entitled under this subsection.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

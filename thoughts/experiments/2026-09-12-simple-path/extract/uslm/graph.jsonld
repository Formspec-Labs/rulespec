      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:2fcf0238302831be6ab8a04e5aa01eee33921fe3953903cadaf4f69f2f21d696\",\"urn:rulespec:document-understanding:assertion:5393ce2edea6f07c6d5a60e3e38ec9cb441c020cb9209740ddcaed149dc5938d\",\"urn:rulespec:document-understanding:assertion:f15a8cc9f97608071234bf05050c97ec9bdd145414fdc2a7a1b1cb67f5f34771\",\"urn:rulespec:document-understanding:assertion:df399268a8588e6dcc4d38a97aa0f1e50c89a6d43a7458cf796dbc7bcc71937c\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":4984,\"evidence\":[{\"end\":4984,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A954afb164b0087d7b402ec321589cfcb8ad9ce1bcb8381ed8e67a21327e85a01:4666:4984:sha256-381950c25a306e04afbf84cec10ddb40d1f29a2eab450800b406dd980f337438\",\"quote\":\"(2) An employee who requests annual leave or compensatory time to which the employee is otherwise entitled, for a period during which the employee would have been entitled upon request to leave under this subsection, may be granted such annual leave or compensatory time without regard to this section or section 5519.\",\"start\":4666},{\"end\":4886,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A954afb164b0087d7b402ec321589cfcb8ad9ce1bcb8381ed8e67a21327e85a01:4883:4886:sha256-ee4d988c65de860fabbfbcd27f73d50bbebe3fba37fe419284f4811389c30bdc\",\"quote\":\"may\",\"start\":4883},{\"end\":4984,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A954afb164b0087d7b402ec321589cfcb8ad9ce1bcb8381ed8e67a21327e85a01:4666:4984:sha256-381950c25a306e04afbf84cec10ddb40d1f29a2eab450800b406dd980f337438\",\"quote\":\"(2) An employee who requests annual leave or compensatory time to which the employee is otherwise entitled, for a period during which the employee would have been entitled upon request to leave under this subsection, may be granted such annual leave or compensatory time without regard to this section or section 5519.\",\"start\":4666}],\"id\":\"urn:rulespec:document-understanding:revision:56f5f9fd666c723b086486886a2844ebc56130cc2a1317308322126e1d899b85\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"permission\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:df399268a8588e6dcc4d38a97aa0f1e50c89a6d43a7458cf796dbc7bcc71937c\",\"modality\":\"may\",\"modality_quote\":\"may\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:3462e1dc26916718e228b183917e8f54894dbc7ee8f79f95dea6f13b7d84227f\",\"origin\":\"aiSuggested\",\"quote\":\"(2) An employee who requests annual leave or compensatory time to which the employee is otherwise entitled, for a period during which the employee would have been entitled upon request to leave under this subsection, may be granted such annual leave or compensatory time without regard to this section or section 5519.\",\"references\":[\"section 5519\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:532c9fbe65c2048843e7837c94e5e1d5fa126ba42ab276f93072f71923149762\",\"scope_quotes\":[\"(2) An employee who requests annual leave or compensatory time to which the employee is otherwise entitled, for a period during which the employee would have been entitled upon request to leave under this subsection, may be granted such annual leave or compensatory time without regard to this section or section 5519.\"],\"scope_text\":\"for a period during which the employee would have been entitled upon request to leave under this subsection\",\"section_id\":\"urn:rulespec:document-understanding:section:c52d8ba2222add6089873e5d381a4224a0305581afa5496b81a8478da280bbd2\",\"start\":4666,\"summary\":\"An employee who requests annual leave or compensatory time to which the employee is otherwise entitled, for a period during which the employee would have been entitled upon request to leave under 5 U.S.C. 6323(d), may be granted such annual leave or compensatory time without regard to this section or section 5519.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

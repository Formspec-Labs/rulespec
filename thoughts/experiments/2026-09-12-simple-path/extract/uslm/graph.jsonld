      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"an employee as defined by section 2105 of this title or an individual employed by the government of the District of Columbia, permanent or temporary indefinite\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:b347ff2aa9e586a031163e12198848c23d0cb86d2ad6331073ff7c80b30805aa\",\"urn:rulespec:document-understanding:assertion:4cd204dd7c76f3d46f0a210bebeeb70fc9f5c4edcc0b27368f1e639b981d6235\",\"urn:rulespec:document-understanding:assertion:9b33cf63b54dd9827e51726eecba4eb41f82f98f0253de6170beeb3ae64f2f00\",\"urn:rulespec:document-understanding:assertion:a92c59fdff5a43df660c34f1900544beb498d0ca8f101b189e03d1fe6955ea04\",\"urn:rulespec:document-understanding:assertion:9b86c5ecf792c95539088706b07719511332c19154cf10f305e1de0a3d5ba534\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":3604,\"evidence\":[{\"end\":1906,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A954afb164b0087d7b402ec321589cfcb8ad9ce1bcb8381ed8e67a21327e85a01:1687:1906:sha256-1534979be7be65144185ac22d3aad6e7cabdcf7f3545737e273b2f316e1e726e\",\"quote\":\"(b) Except as provided by section 5519 of this title, an employee as defined by section 2105 of this title or an individual employed by the government of the District of Columbia, permanent or temporary indefinite, who—\",\"start\":1687},{\"end\":2250,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A954afb164b0087d7b402ec321589cfcb8ad9ce1bcb8381ed8e67a21327e85a01:1908:2250:sha256-22500de55901038f12993b25e83b9ab4ed8c8205d308acf31356ed3c69dbcd4a\",\"quote\":\"(1) is a member of a Reserve component of the Armed Forces, as described in section 10101 of title 10, or the National Guard, as described in section 101 of title 32 or is a member of the Space Force in space force active status (as defined in section 101(e)(1) of title 10) and not on sustained duty under section 20105 of title 10; and\\n\\n(2)\",\"start\":1908},{\"end\":2467,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A954afb164b0087d7b402ec321589cfcb8ad9ce1bcb8381ed8e67a21327e85a01:2252:2467:sha256-2715eedc6bd9d681f9780fab42b5f6fa018dafe4669aebe7d436f897efedda06\",\"quote\":\"(A) performs, for the purpose of providing military aid to enforce the law or for the purpose of providing assistance to civil authorities in the protection or saving of life or property or the prevention of injury—\",\"start\":2252},{\"end\":2518,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A954afb164b0087d7b402ec321589cfcb8ad9ce1bcb8381ed8e67a21327e85a01:2469:2518:sha256-72737f503a9256df963131be5a063d8d9fd77b83c9ab4cf199bbc1544ae5b07e\",\"quote\":\"(i) Federal service under section 331, 332, 333,1\",\"start\":2469},{\"end\":2555,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A954afb164b0087d7b402ec321589cfcb8ad9ce1bcb8381ed8e67a21327e85a01:2520:2555:sha256-5176640c2f5566d6f61e5dddbc3dfed526e063505b3ff50764648710028d55a5\",\"quote\":\"1 See References in Text note below\",\"start\":2520},{\"end\":3604,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A954afb164b0087d7b402ec321589cfcb8ad9ce1bcb8381ed8e67a21327e85a01:2557:3604:sha256-8c347783710d2fba89faf1f40e8e77aca8ea89b09710f8ac699940a928e4e335\",\"quote\":\" or 12406 of title 10, or other provision of law, as applicable, or\\n\\n(ii) full-time military service for his State, the District of Columbia, the Commonwealth of Puerto Rico, or a territory of the United States; or\\n\\n\\n(B) performs full-time military service as a result of a call or order to active duty in support of a contingency operation as defined in section 101(a)(13) of title 10;\\n\\n\\n\\nis entitled, during and because of such service, to leave without loss of, or reduction in, pay, leave to which he otherwise is entitled, credit for time or service, or performance or efficiency rating. Leave granted by this subsection shall not exceed 22 workdays in a calendar year. Upon the request of an employee, the period for which an employee is absent to perform service described in paragraph (2) may be charged to the employee’s accrued annual leave or to compensatory time available to the employee instead of being charged as leave to which the employee is entitled under this subsection. The period of absence may not be charged to sick leave.\",\"start\":2557},{\"end\":1900,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A954afb164b0087d7b402ec321589cfcb8ad9ce1bcb8381ed8e67a21327e85a01:1741:1900:sha256-1b50db66224b09a206302c638a49ab9a9f5b63e0f52b35b05b27d8b0df4edf79\",\"quote\":\"an employee as defined by section 2105 of this title or an individual employed by the government of the District of Columbia, permanent or temporary indefinite\",\"start\":1741},{\"end\":1906,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A954afb164b0087d7b402ec321589cfcb8ad9ce1bcb8381ed8e67a21327e85a01:1687:1906:sha256-1534979be7be65144185ac22d3aad6e7cabdcf7f3545737e273b2f316e1e726e\",\"quote\":\"(b) Except as provided by section 5519 of this title, an employee as defined by section 2105 of this title or an individual employed by the government of the District of Columbia, permanent or temporary indefinite, who—\",\"start\":1687},{\"end\":2250,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A954afb164b0087d7b402ec321589cfcb8ad9ce1bcb8381ed8e67a21327e85a01:1908:2250:sha256-22500de55901038f12993b25e83b9ab4ed8c8205d308acf31356ed3c69dbcd4a\",\"quote\":\"(1) is a member of a Reserve component of the Armed Forces, as described in section 10101 of title 10, or the National Guard, as described in section 101 of title 32 or is a member of the Space Force in space force active status (as defined in section 101(e)(1) of title 10) and not on sustained duty under section 20105 of title 10; and\\n\\n(2)\",\"start\":1908},{\"end\":2467,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A954afb164b0087d7b402ec321589cfcb8ad9ce1bcb8381ed8e67a21327e85a01:2252:2467:sha256-2715eedc6bd9d681f9780fab42b5f6fa018dafe4669aebe7d436f897efedda06\",\"quote\":\"(A) performs, for the purpose of providing military aid to enforce the law or for the purpose of providing assistance to civil authorities in the protection or saving of life or property or the prevention of injury—\",\"start\":2252},{\"end\":2518,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A954afb164b0087d7b402ec321589cfcb8ad9ce1bcb8381ed8e67a21327e85a01:2469:2518:sha256-72737f503a9256df963131be5a063d8d9fd77b83c9ab4cf199bbc1544ae5b07e\",\"quote\":\"(i) Federal service under section 331, 332, 333,1\",\"start\":2469},{\"end\":2555,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A954afb164b0087d7b402ec321589cfcb8ad9ce1bcb8381ed8e67a21327e85a01:2520:2555:sha256-5176640c2f5566d6f61e5dddbc3dfed526e063505b3ff50764648710028d55a5\",\"quote\":\"1 See References in Text note below\",\"start\":2520},{\"end\":2943,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A954afb164b0087d7b402ec321589cfcb8ad9ce1bcb8381ed8e67a21327e85a01:2557:2943:sha256-99a5c4a4267386f7cc1a0502ede5b46fbdba3d8c1ba268841f8d888bac5a3e62\",\"quote\":\" or 12406 of title 10, or other provision of law, as applicable, or\\n\\n(ii) full-time military service for his State, the District of Columbia, the Commonwealth of Puerto Rico, or a territory of the United States; or\\n\\n\\n(B) performs full-time military service as a result of a call or order to active duty in support of a contingency operation as defined in section 101(a)(13) of title 10;\",\"start\":2557}],\"id\":\"urn:rulespec:document-understanding:revision:e5f05f435d52a339a8af786d00c7fb1fa3cbde6a479a73b9455ee939ceaf8e6c\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:9b86c5ecf792c95539088706b07719511332c19154cf10f305e1de0a3d5ba534\",\"modality\":\"must\",\"modality_quote\":\"is entitled\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:a9fdd04b7b3cc865c4c05b8f4db893920c3fcfc3e918b874cf89793dc5a93dee\",\"origin\":\"aiSuggested\",\"quote\":\"(b) Except as provided by section 5519 of this title, an employee as defined by section 2105 of this title or an individual employed by the government of the District of Columbia, permanent or temporary indefinite, who—\\n\\n(1) is a member of a Reserve component of the Armed Forces, as described in section 10101 of title 10, or the National Guard, as described in section 101 of title 32 or is a member of the Space Force in space force active status (as defined in section 101(e)(1) of title 10) and not on sustained duty under section 20105 of title 10; and\\n\\n(2)\\n\\n(A) performs, for the purpose of providing military aid to enforce the law or for the purpose of providing assistance to civil authorities in the protection or saving of life or property or the prevention of injury—\\n\\n(i) Federal service under section 331, 332, 333,1\\n\\n1 See References in Text note below\\n\\n or 12406 of title 10, or other provision of law, as applicable, or\\n\\n(ii) full-time military service for his State, the District of Columbia, the Commonwealth of Puerto Rico, or a territory of the United States; or\\n\\n\\n(B) performs full-time military service as a result of a call or order to active duty in support of a contingency operation as defined in section 101(a)(13) of title 10;\\n\\n\\n\\nis entitled, during and because of such service, to leave without loss of, or reduction in, pay, leave to which he otherwise is entitled, credit for time or service, or performance or efficiency rating. Leave granted by this subsection shall not exceed 22 workdays in a calendar year. Upon the request of an employee, the period for which an employee is absent to perform service described in paragraph (2) may be charged to the employee’s accrued annual leave or to compensatory time available to the employee instead of being charged as leave to which the employee is entitled under this subsection. The period of absence may not be charged to sick leave.\",\"references\":[\"section 5519 of this title\",\"section 2105 of this title\",\"section 10101 of title 10\",\"section 101 of title 32\",\"section 101(e)(1) of title 10\",\"section 20105 of title 10\",\"section 331, 332, 333\",\"12406 of title 10\",\"section 101(a)(13) of title 10\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:6ec994ed97c67c425af3410ca8bc5f4048f3a1cba730747961273569299734c0\",\"scope_quotes\":[\"(b) Except as provided by section 5519 of this title, an employee as defined by section 2105 of this title or an individual employed by the government of the District of Columbia, permanent or temporary indefinite, who—\\n\\n(1) is a member of a Reserve component of the Armed Forces, as described in section 10101 of title 10, or the National Guard, as described in section 101 of title 32 or is a member of the Space Force in space force active status (as defined in section 101(e)(1) of title 10) and not on sustained duty under section 20105 of title 10; and\\n\\n(2)\\n\\n(A) performs, for the purpose of providing military aid to enforce the law or for the purpose of providing assistance to civil authorities in the protection or saving of life or property or the prevention of injury—\\n\\n(i) Federal service under section 331, 332, 333,1\\n\\n1 See References in Text note below\\n\\n or 12406 of title 10, or other provision of law, as applicable, or\\n\\n(ii) full-time military service for his State, the District of Columbia, the Commonwealth of Puerto Rico, or a territory of the United States; or\\n\\n\\n(B) performs full-time military service as a result of a call or order to active duty in support of a contingency operation as defined in section 101(a)(13) of title 10;\"],\"scope_text\":\"Except as provided by section 5519 of this title, an employee as defined by section 2105 of this title or an individual employed by the government of the District of Columbia, permanent or temporary indefinite, who— (1) is a member of a Reserve component of the Armed Forces, as described in section 10101 of title 10, or the National Guard, as described in section 101 of title 32 or is a member of the Space Force in space force active status (as defined in section 101(e)(1) of title 10) and not on sustained duty under section 20105 of title 10; and (2) (A) performs, for the purpose of providing military aid to enforce the law or for the purpose of providing assistance to civil authorities in the protection or saving of life or property or the prevention of injury— (i) Federal service under section 331, 332, 333, or 12406 of title 10, or other provision of law, as applicable, or (ii) full-time military service for his State, the District of Columbia, the Commonwealth of Puerto Rico, or a territory of the United States; or (B) performs full-time military service as a result of a call or order to active duty in support of a contingency operation as defined in section 101(a)(13) of title 10\",\"section_id\":\"urn:rulespec:document-understanding:section:c52d8ba2222add6089873e5d381a4224a0305581afa5496b81a8478da280bbd2\",\"start\":1687,\"summary\":\"Except as provided by section 5519 of this title, an employee as defined by section 2105 of this title or an individual employed by the government of the District of Columbia, permanent or temporary indefinite, who is a member of a Reserve component of the Armed Forces, as described in section 10101 of title 10, or the National Guard, as described in section 101 of title 32 or is a member of the Space Force in space force active status (as defined in section 101(e)(1) of title 10) and not on sustained duty under section 20105 of title 10; and who performs, for the purpose of providing military aid to enforce the law or for the purpose of providing assistance to civil authorities in the protection or saving of life or property or the prevention of injury, Federal service under section 331, 332, 333, or 12406 of title 10, or other provision of law, as applicable, or full-time military service for his State, the District of Columbia, the Commonwealth of Puerto Rico, or a territory of the United States, or performs full-time military service as a result of a call or order to active duty in support of a contingency operation as defined in section 101(a)(13) of title 10, is entitled, during and because of such service, to leave without loss of, or reduction in, pay, leave to which he otherwise is entitled, credit for time or service, or performance or efficiency rating.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",
      "dcterms:references": [

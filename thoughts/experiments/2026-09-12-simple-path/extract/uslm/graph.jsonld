    {
      "@id": "urn:rulespec:document-understanding:revision:8c2cc5afd49038b6f6fe3b3857572fc161cde02fff6257318ea4de12760f4817",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:8c2cc5afd49038b6f6fe3b3857572fc161cde02fff6257318ea4de12760f4817",

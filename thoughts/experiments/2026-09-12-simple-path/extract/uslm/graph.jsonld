      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"A military reserve technician described in section 8401(30)\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:c6a4d8c6fd5a047225ebc582082673982e91087538a995819f0f785437f2ae5a\",\"urn:rulespec:document-understanding:assertion:b3941d9ef799c677674634c61eddbce0859876794e1264f5bffee9715d1e5934\",\"urn:rulespec:document-understanding:assertion:9aaabaea624970d87e9827e4987a8f435fc5a3ef522a8f58b542da9864753d21\",\"urn:rulespec:document-understanding:assertion:15e1951cf73a82c387be41881c5b073267f59c36d4795e0344cdace8887e4e43\",\"urn:rulespec:document-understanding:assertion:b010ec07b1df6a1ad2080cb7bad4f2ee673bf30e562482995fe390696ab22b85\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":4664,\"evidence\":[{\"end\":4664,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A954afb164b0087d7b402ec321589cfcb8ad9ce1bcb8381ed8e67a21327e85a01:4096:4664:sha256-42f023dd0a0e22531535547cc51fb10b16a9d6bb24d8833e4c1d6a02cd6df875\",\"quote\":\"(1) A military reserve technician described in section 8401(30) 1 is entitled at such person’s request to leave without loss of, or reduction in, pay, leave to which such person is otherwise entitled, credit for time or service, or performance or efficiency rating for each day, not to exceed 44 workdays in a calendar year, in which such person is on active duty without pay, as authorized pursuant to section 12315 of title 10, under section 12301(b) or 12301(d) of title 10 for participation in operations outside the United States, its territories and possessions.\",\"start\":4096},{\"end\":4159,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A954afb164b0087d7b402ec321589cfcb8ad9ce1bcb8381ed8e67a21327e85a01:4100:4159:sha256-b98d993c0abcf3f8542ba36384519dc9546a8650d70c4096478da6af8aa4fe4c\",\"quote\":\"A military reserve technician described in section 8401(30)\",\"start\":4100},{\"end\":4173,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A954afb164b0087d7b402ec321589cfcb8ad9ce1bcb8381ed8e67a21327e85a01:4162:4173:sha256-856584827ada6694e69d87f4f642d43687f1f2e1904979dc357cdd7b19a76aac\",\"quote\":\"is entitled\",\"start\":4162},{\"end\":4664,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A954afb164b0087d7b402ec321589cfcb8ad9ce1bcb8381ed8e67a21327e85a01:4096:4664:sha256-42f023dd0a0e22531535547cc51fb10b16a9d6bb24d8833e4c1d6a02cd6df875\",\"quote\":\"(1) A military reserve technician described in section 8401(30) 1 is entitled at such person’s request to leave without loss of, or reduction in, pay, leave to which such person is otherwise entitled, credit for time or service, or performance or efficiency rating for each day, not to exceed 44 workdays in a calendar year, in which such person is on active duty without pay, as authorized pursuant to section 12315 of title 10, under section 12301(b) or 12301(d) of title 10 for participation in operations outside the United States, its territories and possessions.\",\"start\":4096}],\"id\":\"urn:rulespec:document-understanding:revision:956788019a8c74e778541243684997972b15dc98870f75479b5838bb36086453\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:b010ec07b1df6a1ad2080cb7bad4f2ee673bf30e562482995fe390696ab22b85\",\"modality\":\"must\",\"modality_quote\":\"is entitled\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:285132104f72a369827946c6682c9dac94c3625b41cb9df93718ae72e2fab2b4\",\"origin\":\"aiSuggested\",\"quote\":\"(1) A military reserve technician described in section 8401(30) 1 is entitled at such person’s request to leave without loss of, or reduction in, pay, leave to which such person is otherwise entitled, credit for time or service, or performance or efficiency rating for each day, not to exceed 44 workdays in a calendar year, in which such person is on active duty without pay, as authorized pursuant to section 12315 of title 10, under section 12301(b) or 12301(d) of title 10 for participation in operations outside the United States, its territories and possessions.\",\"references\":[\"section 8401(30)\",\"section 12315 of title 10\",\"section 12301(b) or 12301(d) of title 10\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:a0d19c3aa96601dde7ca55132cde2b0d036ad77d94ed0835be4e36c89c75e4b5\",\"scope_quotes\":[\"(1) A military reserve technician described in section 8401(30) 1 is entitled at such person’s request to leave without loss of, or reduction in, pay, leave to which such person is otherwise entitled, credit for time or service, or performance or efficiency rating for each day, not to exceed 44 workdays in a calendar year, in which such person is on active duty without pay, as authorized pursuant to section 12315 of title 10, under section 12301(b) or 12301(d) of title 10 for participation in operations outside the United States, its territories and possessions.\"],\"scope_text\":\"for each day, not to exceed 44 workdays in a calendar year, in which such person is on active duty without pay, as authorized pursuant to section 12315 of title 10, under section 12301(b) or 12301(d) of title 10 for participation in operations outside the United States, its territories and possessions\",\"section_id\":\"urn:rulespec:document-understanding:section:c52d8ba2222add6089873e5d381a4224a0305581afa5496b81a8478da280bbd2\",\"start\":4096,\"summary\":\"A military reserve technician described in section 8401(30) is entitled at such person’s request to leave without loss of, or reduction in, pay, leave to which such person is otherwise entitled, credit for time or service, or performance or efficiency rating for each day, not to exceed 44 workdays in a calendar year, in which such person is on active duty without pay, as authorized pursuant to section 12315 of title 10, under section 12301(b) or 12301(d) of title 10 for participation in operations outside the United States, its territories and possessions.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

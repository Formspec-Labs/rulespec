    {
      "@id": "urn:rulespec:document-understanding:revision:7ff705a71068de6e5bc0f4e42d0b9777b884d7d2cec3e7cb1d03ad9fc5d72a6a",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:7ff705a71068de6e5bc0f4e42d0b9777b884d7d2cec3e7cb1d03ad9fc5d72a6a",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:49353db54c49bacff49fc15fb78d607a98c88784864efeb9f7def201bc1ee6ac",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:e888f0c17e4785b9cc3c67896b69b5d5d26961746b2bc9cc2823775825e0b3e7\",\"urn:rulespec:document-understanding:assertion:39f975f839a7f5e2960199fb4f394a857e169985ae7284ef72f579af16033279\",\"urn:rulespec:document-understanding:assertion:dd1170eda61bbc3b4a7408c41aa3377d0b8254dfd236d2794c914b5253597ca3\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":1154,\"evidence\":[{\"end\":1154,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A954afb164b0087d7b402ec321589cfcb8ad9ce1bcb8381ed8e67a21327e85a01:103:1154:sha256-8ad34c5ffc397877f4c10c6401157e885c1e5bdd8637f1346a869338c2272f9f\",\"quote\":\"(1) Subject to paragraph (2) of this subsection, an employee as defined by section 2105 of this title or an individual employed by the government of the District of Columbia, permanent or temporary indefinite, is entitled to leave without loss in pay, time, or performance or efficiency rating for active duty, inactive-duty training (as defined in section 101 of title 37), funeral honors duty (as described in section 12503 of title 10 and section 115 of title 32), or engaging in field or coast defense training under sections 502–505 of title 32 as a Reserve of the armed forces, a member of the National Guard, or a member of the Space Force in space force active status (as defined in section 101(e)(1) of title 10) and not on sustained duty under section 20105 of title 10. Leave under this subsection accrues for an employee or individual at the rate of 20 days per fiscal year and, to the extent that it is not used in a fiscal year, accumulates for use in the succeeding fiscal year until it totals 20 days at the beginning of a fiscal year.\",\"start\":103}],\"id\":\"urn:rulespec:document-understanding:revision:7ff705a71068de6e5bc0f4e42d0b9777b884d7d2cec3e7cb1d03ad9fc5d72a6a\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"statement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:dd1170eda61bbc3b4a7408c41aa3377d0b8254dfd236d2794c914b5253597ca3\",\"modality\":\"not_stated\",\"modality_quote\":\"\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:7959aaa938379b86c0c45bbc25d3f287e29c6d5148d261bf19dbe44c6a3a4fa7\",\"origin\":\"aiSuggested\",\"quote\":\"(1) Subject to paragraph (2) of this subsection, an employee as defined by section 2105 of this title or an individual employed by the government of the District of Columbia, permanent or temporary indefinite, is entitled to leave without loss in pay, time, or performance or efficiency rating for active duty, inactive-duty training (as defined in section 101 of title 37), funeral honors duty (as described in section 12503 of title 10 and section 115 of title 32), or engaging in field or coast defense training under sections 502–505 of title 32 as a Reserve of the armed forces, a member of the National Guard, or a member of the Space Force in space force active status (as defined in section 101(e)(1) of title 10) and not on sustained duty under section 20105 of title 10. Leave under this subsection accrues for an employee or individual at the rate of 20 days per fiscal year and, to the extent that it is not used in a fiscal year, accumulates for use in the succeeding fiscal year until it totals 20 days at the beginning of a fiscal year.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:153d95553bb3bcc4acd847e7a2380ea40f2f05837e7e934c09fcc3bcc718ca46\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"urn:rulespec:document-understanding:section:c52d8ba2222add6089873e5d381a4224a0305581afa5496b81a8478da280bbd2\",\"start\":103,\"summary\":\"Leave under 5 U.S.C. 6323(a) accrues for an employee or individual at the rate of 20 days per fiscal year and, to the extent that it is not used in a fiscal year, accumulates for use in the succeeding fiscal year until it totals 20 days at the beginning of a fiscal year.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

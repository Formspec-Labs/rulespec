      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:5b3b8dfa10de7135500ba3b235fa9cd01384468da5557ed3a84432d3bbfddb43",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:6ec994ed97c67c425af3410ca8bc5f4048f3a1cba730747961273569299734c0",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"actor\":\"an employee as defined by section 2105 of this title or an individual employed by the government of the District of Columbia, permanent or temporary indefinite\",\"kind\":\"requirement\",\"modality\":\"must\",\"scope_text\":\"Except as provided by section 5519 of this title, an employee as defined by section 2105 of this title or an individual employed by the government of the District of Columbia, permanent or temporary indefinite, who— (1) is a member of a Reserve component of the Armed Forces, as described in section 10101 of title 10, or the National Guard, as described in section 101 of title 32 or is a member of the Space Force in space force active status (as defined in section 101(e)(1) of title 10) and not on sustained duty under section 20105 of title 10; and (2) (A) performs, for the purpose of providing military aid to enforce the law or for the purpose of providing assistance to civil authorities in the protection or saving of life or property or the prevention of injury— (i) Federal service under section 331, 332, 333, or 12406 of title 10, or other provision of law, as applicable, or (ii) full-time military service for his State, the District of Columbia, the Commonwealth of Puerto Rico, or a territory of the United States; or (B) performs full-time military service as a result of a call or order to active duty in support of a contingency operation as defined in section 101(a)(13) of title 10\",\"summary\":\"Except as provided by section 5519 of this title, an employee as defined by section 2105 of this title or an individual employed by the government of the District of Columbia, permanent or temporary indefinite, who is a member of a Reserve component of the Armed Forces, as described in section 10101 of title 10, or the National Guard, as described in section 101 of title 32 or is a member of the Space Force in space force active status (as defined in section 101(e)(1) of title 10) and not on sustained duty under section 20105 of title 10; and who performs, for the purpose of providing military aid to enforce the law or for the purpose of providing assistance to civil authorities in the protection or saving of life or property or the prevention of injury, Federal service under section 331, 332, 333, or 12406 of title 10, or other provision of law, as applicable, or full-time military service for his State, the District of Columbia, the Commonwealth of Puerto Rico, or a territory of the United States, or performs full-time military service as a result of a call or order to active duty in support of a contingency operation as defined in section 101(a)(13) of title 10, is entitled, during and because of such service, to leave without loss of, or reduction in, pay, leave to which he otherwise is entitled, credit for time or service, or performance or efficiency rating.\"}",
        "@type": "xsd:string"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed",
      "rkaf:hasApplicability": "urn:rulespec:document-understanding:scope:4936d53757ec06f75bfb2b22f32ef8dc167310fbc359273a309cdeb7fac311f0"
    },

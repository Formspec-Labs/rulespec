      "rkaf:assertsValue": {
        "@value": "{\"kind\":\"statement\",\"modality\":\"not_stated\",\"summary\":\"Leave under 5 U.S.C. 6323(a) accrues for an employee or individual at the rate of 20 days per fiscal year and, to the extent that it is not used in a fiscal year, accumulates for use in the succeeding fiscal year until it totals 20 days at the beginning of a fiscal year.\"}",
        "@type": "xsd:string"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },
    {
      "@id": "urn:rulespec:document-understanding:binding:beaa6e6c09a2f37728c245f9f03a34326991d9d1ff99bd3cee6ca64bfb742d16",

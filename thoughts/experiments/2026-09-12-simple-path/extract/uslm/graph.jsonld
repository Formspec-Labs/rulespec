      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"an employee as defined by section 2105 of this title or an individual employed by the government of the District of Columbia, permanent or temporary indefinite\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:4c201ecb5870adf7e22b706bf57bbab07cc2a969fa7a52c4defce2cf9fbd2906\",\"urn:rulespec:document-understanding:assertion:d1ae25ce94655b4cf04302d7224e2795802a4bc362f04ce8850e3053c9cd96d8\",\"urn:rulespec:document-understanding:assertion:11f1c9b9114c2488be9c3713aa7cc068bdad0fdd042beb8b816a51d81b00298a\",\"urn:rulespec:document-understanding:assertion:d0ad71f6b0a03703c3dc3cb9c7bc902911c70e0f5ece689d8d3346122326d41d\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":1154,\"evidence\":[{\"end\":1154,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A954afb164b0087d7b402ec321589cfcb8ad9ce1bcb8381ed8e67a21327e85a01:103:1154:sha256-8ad34c5ffc397877f4c10c6401157e885c1e5bdd8637f1346a869338c2272f9f\",\"quote\":\"(1) Subject to paragraph (2) of this subsection, an employee as defined by section 2105 of this title or an individual employed by the government of the District of Columbia, permanent or temporary indefinite, is entitled to leave without loss in pay, time, or performance or efficiency rating for active duty, inactive-duty training (as defined in section 101 of title 37), funeral honors duty (as described in section 12503 of title 10 and section 115 of title 32), or engaging in field or coast defense training under sections 502–505 of title 32 as a Reserve of the armed forces, a member of the National Guard, or a member of the Space Force in space force active status (as defined in section 101(e)(1) of title 10) and not on sustained duty under section 20105 of title 10. Leave under this subsection accrues for an employee or individual at the rate of 20 days per fiscal year and, to the extent that it is not used in a fiscal year, accumulates for use in the succeeding fiscal year until it totals 20 days at the beginning of a fiscal year.\",\"start\":103},{\"end\":311,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A954afb164b0087d7b402ec321589cfcb8ad9ce1bcb8381ed8e67a21327e85a01:152:311:sha256-1b50db66224b09a206302c638a49ab9a9f5b63e0f52b35b05b27d8b0df4edf79\",\"quote\":\"an employee as defined by section 2105 of this title or an individual employed by the government of the District of Columbia, permanent or temporary indefinite\",\"start\":152},{\"end\":324,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A954afb164b0087d7b402ec321589cfcb8ad9ce1bcb8381ed8e67a21327e85a01:313:324:sha256-856584827ada6694e69d87f4f642d43687f1f2e1904979dc357cdd7b19a76aac\",\"quote\":\"is entitled\",\"start\":313}],\"id\":\"urn:rulespec:document-understanding:revision:8c2cc5afd49038b6f6fe3b3857572fc161cde02fff6257318ea4de12760f4817\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:d0ad71f6b0a03703c3dc3cb9c7bc902911c70e0f5ece689d8d3346122326d41d\",\"modality\":\"must\",\"modality_quote\":\"is entitled\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:88bc725902c1a9f3f2192fe626369511216ee73013e42d04287152e1c53af6b0\",\"origin\":\"aiSuggested\",\"quote\":\"(1) Subject to paragraph (2) of this subsection, an employee as defined by section 2105 of this title or an individual employed by the government of the District of Columbia, permanent or temporary indefinite, is entitled to leave without loss in pay, time, or performance or efficiency rating for active duty, inactive-duty training (as defined in section 101 of title 37), funeral honors duty (as described in section 12503 of title 10 and section 115 of title 32), or engaging in field or coast defense training under sections 502–505 of title 32 as a Reserve of the armed forces, a member of the National Guard, or a member of the Space Force in space force active status (as defined in section 101(e)(1) of title 10) and not on sustained duty under section 20105 of title 10. Leave under this subsection accrues for an employee or individual at the rate of 20 days per fiscal year and, to the extent that it is not used in a fiscal year, accumulates for use in the succeeding fiscal year until it totals 20 days at the beginning of a fiscal year.\",\"references\":[\"section 2105 of this title\",\"paragraph (2) of this subsection\",\"section 101 of title 37\",\"section 12503 of title 10\",\"section 115 of title 32\",\"sections 502–505 of title 32\",\"section 101(e)(1) of title 10\",\"section 20105 of title 10\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:7cc05dca672e62bad6ad51b72bf83895d3c7e862e105f1ea31a6a9a37a9ea025\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"urn:rulespec:document-understanding:section:c52d8ba2222add6089873e5d381a4224a0305581afa5496b81a8478da280bbd2\",\"start\":103,\"summary\":\"Subject to paragraph (2) of this subsection, an employee as defined by section 2105 of this title or an individual employed by the government of the District of Columbia, permanent or temporary indefinite, is entitled to leave without loss in pay, time, or performance or efficiency rating for active duty, inactive-duty training (as defined in section 101 of title 37), funeral honors duty (as described in section 12503 of title 10 and section 115 of title 32), or engaging in field or coast defense training under sections 502–505 of title 32 as a Reserve of the armed forces, a member of the National Guard, or a member of the Space Force in space force active status (as defined in section 101(e)(1) of title 10) and not on sustained duty under section 20105 of title 10.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

      "dcterms:description": "{\"action\":\"\",\"actor\":\"An employee as defined by section 2105 of this title or an individual employed by the government of the District of Columbia, who is a member of the National Guard of the District of Columbia\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:e342eb44830efdd020658e62e4ee3f60c2017c416fd7969fe9dd0ee7b787f7be\",\"urn:rulespec:document-understanding:assertion:5c7eb87edcf18b494b29b1b67e958f6bfc41ea6707721e1eb4a48cbc64385004\",\"urn:rulespec:document-understanding:assertion:dc974bd1265c743f56a247286d99e2e9025670b9068bfe4894781bde2f4edcf1\",\"urn:rulespec:document-understanding:assertion:f9c1ce11a7d68e7c290a26c911b42e1bb198cc2a692436c15494aaf92659424f\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":4089,\"evidence\":[{\"end\":4089,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A954afb164b0087d7b402ec321589cfcb8ad9ce1bcb8381ed8e67a21327e85a01:3606:4089:sha256-d6665fb2301fee693517bd9e2a244ac48f71eedefd4b49529aa8f142e68d6d08\",\"quote\":\"(c) An employee as defined by section 2105 of this title or an individual employed by the government of the District of Columbia, who is a member of the National Guard of the District of Columbia, is entitled to leave without loss in pay or time for each day of a parade or encampment ordered or authorized under title 39, District of Columbia Code. This subsection covers each day of service the National Guard, or a portion thereof, is ordered to perform by the commanding general.\",\"start\":3606},{\"end\":3801,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A954afb164b0087d7b402ec321589cfcb8ad9ce1bcb8381ed8e67a21327e85a01:3610:3801:sha256-db3ad17b6bcc5d3a4f05053a4278d537564b7393e197313fd98b523b45b65596\",\"quote\":\"An employee as defined by section 2105 of this title or an individual employed by the government of the District of Columbia, who is a member of the National Guard of the District of Columbia\",\"start\":3610},{\"end\":3814,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A954afb164b0087d7b402ec321589cfcb8ad9ce1bcb8381ed8e67a21327e85a01:3803:3814:sha256-856584827ada6694e69d87f4f642d43687f1f2e1904979dc357cdd7b19a76aac\",\"quote\":\"is entitled\",\"start\":3803}],\"id\":\"urn:rulespec:document-understanding:revision:9b47fbe4fe742614686f50a61ee4496b57fa95cb7015de39ceda6a5fd7f848db\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:f9c1ce11a7d68e7c290a26c911b42e1bb198cc2a692436c15494aaf92659424f\",\"modality\":\"must\",\"modality_quote\":\"is entitled\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:f82230464ec9fef9befdd66ab22232323156bf8268896650f5a393d65a4eba56\",\"origin\":\"aiSuggested\",\"quote\":\"(c) An employee as defined by section 2105 of this title or an individual employed by the government of the District of Columbia, who is a member of the National Guard of the District of Columbia, is entitled to leave without loss in pay or time for each day of a parade or encampment ordered or authorized under title 39, District of Columbia Code. This subsection covers each day of service the National Guard, or a portion thereof, is ordered to perform by the commanding general.\",\"references\":[\"section 2105 of this title\",\"title 39, District of Columbia Code\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:47186da449cc3eab2a3646c7a8173cb3845c437f534206e7fcaa478eb8e9e66a\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"urn:rulespec:document-understanding:section:c52d8ba2222add6089873e5d381a4224a0305581afa5496b81a8478da280bbd2\",\"start\":3606,\"summary\":\"An employee as defined by section 2105 of this title or an individual employed by the government of the District of Columbia, who is a member of the National Guard of the District of Columbia, is entitled to leave without loss in pay or time for each day of a parade or encampment ordered or authorized under title 39, District of Columbia Code, and this subsection covers each day of service the National Guard, or a portion thereof, is ordered to perform by the commanding general.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

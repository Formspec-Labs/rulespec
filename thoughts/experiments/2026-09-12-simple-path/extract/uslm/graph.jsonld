      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:74de5c3ff28e111c324fbbd53492be3de315d80d3e5c685dcf8b43bc8acc6b18\",\"urn:rulespec:document-understanding:assertion:8d68c569961e1ebb965bc47d5d7166fe428fe5bb0b608802e50c7cbb4eee63d9\",\"urn:rulespec:document-understanding:assertion:c511c479d3a6e2528eb68464545ab12ac5683d9450be32033fe4132cc3fc7324\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":3604,\"evidence\":[{\"end\":3604,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A954afb164b0087d7b402ec321589cfcb8ad9ce1bcb8381ed8e67a21327e85a01:2947:3604:sha256-c8d2ddbc7beefeadc576ddf0ab4ecf7827b7dac3363df59d97aa6da9d10443aa\",\"quote\":\"is entitled, during and because of such service, to leave without loss of, or reduction in, pay, leave to which he otherwise is entitled, credit for time or service, or performance or efficiency rating. Leave granted by this subsection shall not exceed 22 workdays in a calendar year. Upon the request of an employee, the period for which an employee is absent to perform service described in paragraph (2) may be charged to the employee’s accrued annual leave or to compensatory time available to the employee instead of being charged as leave to which the employee is entitled under this subsection. The period of absence may not be charged to sick leave.\",\"start\":2947},{\"end\":3199,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A954afb164b0087d7b402ec321589cfcb8ad9ce1bcb8381ed8e67a21327e85a01:3183:3199:sha256-8673aba0dc71ad16eaa78e8dd739e144c4b9158a858e307708d2186cd5cd8ffe\",\"quote\":\"shall not exceed\",\"start\":3183}],\"id\":\"urn:rulespec:document-understanding:revision:dfda77775db816bef2af7e183244c38ef3133e5e85d6e2986b3f2631b3793c0d\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"prohibition\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:c511c479d3a6e2528eb68464545ab12ac5683d9450be32033fe4132cc3fc7324\",\"modality\":\"must_not\",\"modality_quote\":\"shall not exceed\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:f56f7c988096a5c6b06326ac8303bc1defbefde213e3dbcee1ca6542c08de577\",\"origin\":\"aiSuggested\",\"quote\":\"is entitled, during and because of such service, to leave without loss of, or reduction in, pay, leave to which he otherwise is entitled, credit for time or service, or performance or efficiency rating. Leave granted by this subsection shall not exceed 22 workdays in a calendar year. Upon the request of an employee, the period for which an employee is absent to perform service described in paragraph (2) may be charged to the employee’s accrued annual leave or to compensatory time available to the employee instead of being charged as leave to which the employee is entitled under this subsection. The period of absence may not be charged to sick leave.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:2e061e523da1e0fbba7c6bbabc0e95844ad901b36cf804fee7ad552368d45be3\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"urn:rulespec:document-understanding:section:c52d8ba2222add6089873e5d381a4224a0305581afa5496b81a8478da280bbd2\",\"start\":2947,\"summary\":\"Leave granted by 5 U.S.C. 6323(b) shall not exceed 22 workdays in a calendar year.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

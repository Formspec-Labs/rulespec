      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:4c08edc0e577e084ca740c6a19410e90547155aec4a984db68d4959a6ac3e9d4\",\"urn:rulespec:document-understanding:assertion:851132436307c8df4a2c08a22578a302d97faae4bfe3093d196e07f9a8230c0a\",\"urn:rulespec:document-understanding:assertion:be25cff3d7ec86824bfb3e36fcea82d7e326bf0f3344c5eae972cc726fc9a5b0\",\"urn:rulespec:document-understanding:assertion:6cb360483b0372e50aad2366c5a081549d71c56a3607352f274432145860eb08\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":17061,\"evidence\":[{\"end\":16053,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A954afb164b0087d7b402ec321589cfcb8ad9ce1bcb8381ed8e67a21327e85a01:15641:16053:sha256-37b89edfedff2c43fa9d309aa9f5d0a206808bb6c8b1e8e98098ef837f3d9fbf\",\"quote\":\"“During the current fiscal year and hereafter, funds appropriated or otherwise available for any Federal agency, the Congress, the judicial branch, or the District of Columbia may be used for the pay, allowances, and benefits of an employee as defined by section 2105 of title 5, United States Code, or an individual employed by the government of the District of Columbia, permanent or temporary indefinite, who—\",\"start\":15641},{\"end\":16457,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A954afb164b0087d7b402ec321589cfcb8ad9ce1bcb8381ed8e67a21327e85a01:16055:16457:sha256-ea096babe5d6a63ac684be56405db134d66f4e392bc2fcd4ba79e0c1cd831dd0\",\"quote\":\"“(1) is a member of a Reserve component of the Armed Forces, as described in section 10101 of title 10, United States Code, or the National Guard, as described in section 101 of title 32, United States Code;\\n\\n“(2) performs, for the purpose of providing military aid to enforce the law or providing assistance to civil authorities in the protection or saving of life or property or prevention of injury—\",\"start\":16055},{\"end\":16813,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A954afb164b0087d7b402ec321589cfcb8ad9ce1bcb8381ed8e67a21327e85a01:16459:16813:sha256-80f217d9883644c681562d2391acb625ad0a4426ce4932d0dc3dd6d847e4bbf8\",\"quote\":\"“(A) Federal service under sections 331 [now 251], 332 [now 252], 333 [now 253], or 12406 of title 10, United States Code, or other provision of law, as applicable; or\\n\\n“(B) full-time military service for his or her State, the District of Columbia, the Commonwealth of Puerto Rico, or a territory of the United States; and\\n\\n\\n“(3) requests and is granted—\",\"start\":16459},{\"end\":17061,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A954afb164b0087d7b402ec321589cfcb8ad9ce1bcb8381ed8e67a21327e85a01:16815:17061:sha256-6931c18b814a7932ccf11aa68ed113017946f2f77106574717e20c4fe66f80f4\",\"quote\":\"“(A) leave under the authority of this section; or\\n\\n“(B) annual leave, which may be granted without regard to the provisions of sections 5519 and 6323(b) of title 5, United States Code, if such employee is otherwise entitled to such annual leave:\",\"start\":16815},{\"end\":15828,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A954afb164b0087d7b402ec321589cfcb8ad9ce1bcb8381ed8e67a21327e85a01:15817:15828:sha256-ca5866098808a8879ceb3baed334e902f9a80be4f1f6225aa7a9794031a6536c\",\"quote\":\"may be used\",\"start\":15817},{\"end\":16053,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A954afb164b0087d7b402ec321589cfcb8ad9ce1bcb8381ed8e67a21327e85a01:15641:16053:sha256-37b89edfedff2c43fa9d309aa9f5d0a206808bb6c8b1e8e98098ef837f3d9fbf\",\"quote\":\"“During the current fiscal year and hereafter, funds appropriated or otherwise available for any Federal agency, the Congress, the judicial branch, or the District of Columbia may be used for the pay, allowances, and benefits of an employee as defined by section 2105 of title 5, United States Code, or an individual employed by the government of the District of Columbia, permanent or temporary indefinite, who—\",\"start\":15641},{\"end\":16457,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A954afb164b0087d7b402ec321589cfcb8ad9ce1bcb8381ed8e67a21327e85a01:16055:16457:sha256-ea096babe5d6a63ac684be56405db134d66f4e392bc2fcd4ba79e0c1cd831dd0\",\"quote\":\"“(1) is a member of a Reserve component of the Armed Forces, as described in section 10101 of title 10, United States Code, or the National Guard, as described in section 101 of title 32, United States Code;\\n\\n“(2) performs, for the purpose of providing military aid to enforce the law or providing assistance to civil authorities in the protection or saving of life or property or prevention of injury—\",\"start\":16055},{\"end\":16813,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A954afb164b0087d7b402ec321589cfcb8ad9ce1bcb8381ed8e67a21327e85a01:16459:16813:sha256-80f217d9883644c681562d2391acb625ad0a4426ce4932d0dc3dd6d847e4bbf8\",\"quote\":\"“(A) Federal service under sections 331 [now 251], 332 [now 252], 333 [now 253], or 12406 of title 10, United States Code, or other provision of law, as applicable; or\\n\\n“(B) full-time military service for his or her State, the District of Columbia, the Commonwealth of Puerto Rico, or a territory of the United States; and\\n\\n\\n“(3) requests and is granted—\",\"start\":16459},{\"end\":17061,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A954afb164b0087d7b402ec321589cfcb8ad9ce1bcb8381ed8e67a21327e85a01:16815:17061:sha256-6931c18b814a7932ccf11aa68ed113017946f2f77106574717e20c4fe66f80f4\",\"quote\":\"“(A) leave under the authority of this section; or\\n\\n“(B) annual leave, which may be granted without regard to the provisions of sections 5519 and 6323(b) of title 5, United States Code, if such employee is otherwise entitled to such annual leave:\",\"start\":16815}],\"id\":\"urn:rulespec:document-understanding:revision:8d34eda42e8a1e76f44d0312c9a99587a6caeb12c1e722da3faa9db5910f1372\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"permission\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:6cb360483b0372e50aad2366c5a081549d71c56a3607352f274432145860eb08\",\"modality\":\"may\",\"modality_quote\":\"may be used\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:cb81c318b4a48c730753a3638e6e47ec03aa33801a2f516efa216c63608411d3\",\"origin\":\"aiSuggested\",\"quote\":\"“During the current fiscal year and hereafter, funds appropriated or otherwise available for any Federal agency, the Congress, the judicial branch, or the District of Columbia may be used for the pay, allowances, and benefits of an employee as defined by section 2105 of title 5, United States Code, or an individual employed by the government of the District of Columbia, permanent or temporary indefinite, who—\\n\\n“(1) is a member of a Reserve component of the Armed Forces, as described in section 10101 of title 10, United States Code, or the National Guard, as described in section 101 of title 32, United States Code;\\n\\n“(2) performs, for the purpose of providing military aid to enforce the law or providing assistance to civil authorities in the protection or saving of life or property or prevention of injury—\\n\\n“(A) Federal service under sections 331 [now 251], 332 [now 252], 333 [now 253], or 12406 of title 10, United States Code, or other provision of law, as applicable; or\\n\\n“(B) full-time military service for his or her State, the District of Columbia, the Commonwealth of Puerto Rico, or a territory of the United States; and\\n\\n\\n“(3) requests and is granted—\\n\\n“(A) leave under the authority of this section; or\\n\\n“(B) annual leave, which may be granted without regard to the provisions of sections 5519 and 6323(b) of title 5, United States Code, if such employee is otherwise entitled to such annual leave:\",\"references\":[\"section 2105 of title 5, United States Code\",\"section 10101 of title 10, United States Code\",\"section 101 of title 32, United States Code\",\"sections 331 [now 251], 332 [now 252], 333 [now 253], or 12406 of title 10, United States Code\",\"sections 5519 and 6323(b) of title 5, United States Code\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:4e5e7468788112158780c614092b5860db9f65d9bcaabba8444e1b601ccdd1af\",\"scope_quotes\":[\"“During the current fiscal year and hereafter, funds appropriated or otherwise available for any Federal agency, the Congress, the judicial branch, or the District of Columbia may be used for the pay, allowances, and benefits of an employee as defined by section 2105 of title 5, United States Code, or an individual employed by the government of the District of Columbia, permanent or temporary indefinite, who—\\n\\n“(1) is a member of a Reserve component of the Armed Forces, as described in section 10101 of title 10, United States Code, or the National Guard, as described in section 101 of title 32, United States Code;\\n\\n“(2) performs, for the purpose of providing military aid to enforce the law or providing assistance to civil authorities in the protection or saving of life or property or prevention of injury—\\n\\n“(A) Federal service under sections 331 [now 251], 332 [now 252], 333 [now 253], or 12406 of title 10, United States Code, or other provision of law, as applicable; or\\n\\n“(B) full-time military service for his or her State, the District of Columbia, the Commonwealth of Puerto Rico, or a territory of the United States; and\\n\\n\\n“(3) requests and is granted—\\n\\n“(A) leave under the authority of this section; or\\n\\n“(B) annual leave, which may be granted without regard to the provisions of sections 5519 and 6323(b) of title 5, United States Code, if such employee is otherwise entitled to such annual leave:\"],\"scope_text\":\"During the current fiscal year and hereafter, for an employee as defined by section 2105 of title 5, United States Code, or an individual employed by the government of the District of Columbia, permanent or temporary indefinite, who— (1) is a member of a Reserve component of the Armed Forces, as described in section 10101 of title 10, United States Code, or the National Guard, as described in section 101 of title 32, United States Code; (2) performs, for the purpose of providing military aid to enforce the law or providing assistance to civil authorities in the protection or saving of life or property or prevention of injury— (A) Federal service under sections 331 [now 251], 332 [now 252], 333 [now 253], or 12406 of title 10, United States Code, or other provision of law, as applicable; or (B) full-time military service for his or her State, the District of Columbia, the Commonwealth of Puerto Rico, or a territory of the United States; and (3) requests and is granted— (A) leave under the authority of this section; or (B) annual leave, which may be granted without regard to the provisions of sections 5519 and 6323(b) of title 5, United States Code, if such employee is otherwise entitled to such annual leave\",\"section_id\":\"urn:rulespec:document-understanding:section:5d11b498a26782414f6a880ee33e0d7de40f12c55ab75e39cacb31ab4eb93ebc\",\"start\":15641,\"summary\":\"During the current fiscal year and hereafter, funds appropriated or otherwise available for any Federal agency, the Congress, the judicial branch, or the District of Columbia may be used for the pay, allowances, and benefits of an employee as defined by section 2105 of title 5, United States Code, or an individual employed by the government of the District of Columbia, permanent or temporary indefinite, who is a member of a Reserve component of the Armed Forces, as described in section 10101 of title 10, United States Code, or the National Guard, as described in section 101 of title 32, United States Code; performs, for the purpose of providing military aid to enforce the law or providing assistance to civil authorities in the protection or saving of life or property or prevention of injury, Federal service under sections 331 [now 251], 332 [now 252], 333 [now 253], or 12406 of title 10, United States Code, or other provision of law, as applicable, or full-time military service for his or her State, the District of Columbia, the Commonwealth of Puerto Rico, or a territory of the United States; and requests and is granted leave under the authority of section 8023 of Pub. L. 107–117, or annual leave, which may be granted without regard to the provisions of sections 5519 and 6323(b) of title 5, United States Code, if such employee is otherwise entitled to such annual leave.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

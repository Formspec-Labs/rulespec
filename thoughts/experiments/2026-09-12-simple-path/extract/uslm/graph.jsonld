      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:e8a8011a491cd099a46a95903b938ebe7a0b46603624b536aa499d820b2d2116",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:5b3b8dfa10de7135500ba3b235fa9cd01384468da5557ed3a84432d3bbfddb43",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:4e5e7468788112158780c614092b5860db9f65d9bcaabba8444e1b601ccdd1af",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:scope_text",
      "rkaf:assertsValue": {
        "@value": "During the current fiscal year and hereafter, for an employee as defined by section 2105 of title 5, United States Code, or an individual employed by the government of the District of Columbia, permanent or temporary indefinite, who— (1) is a member of a Reserve component of the Armed Forces, as described in section 10101 of title 10, United States Code, or the National Guard, as described in section 101 of title 32, United States Code; (2) performs, for the purpose of providing military aid to enforce the law or providing assistance to civil authorities in the protection or saving of life or property or prevention of injury— (A) Federal service under sections 331 [now 251], 332 [now 252], 333 [now 253], or 12406 of title 10, United States Code, or other provision of law, as applicable; or (B) full-time military service for his or her State, the District of Columbia, the Commonwealth of Puerto Rico, or a territory of the United States; and (3) requests and is granted— (A) leave under the authority of this section; or (B) annual leave, which may be granted without regard to the provisions of sections 5519 and 6323(b) of title 5, United States Code, if such employee is otherwise entitled to such annual leave",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

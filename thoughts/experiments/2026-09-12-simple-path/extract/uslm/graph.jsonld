      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:cc4faf42dddf78f522baa8d007a358b1883dd4619f66387b34ed53cab0bf199a\",\"urn:rulespec:document-understanding:assertion:b8cbeceee82650cef700bd9737236a18717877221c71f750e76515970c4f2da2\",\"urn:rulespec:document-understanding:assertion:abc930d4e7e3cbae90d0ef60668c8c807095b3bb83211140a1366a7e14cef3f9\",\"urn:rulespec:document-understanding:assertion:0ae53f556eabb851168f0320951c1d00e2688e2324e42b30d947ffbb903b3371\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":17432,\"evidence\":[{\"end\":17432,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A954afb164b0087d7b402ec321589cfcb8ad9ce1bcb8381ed8e67a21327e85a01:17065:17432:sha256-de2a9beab87bcca49d0b8a4631da827a7df4065b85f2c1b82ca61c7a67d53548\",\"quote\":\"Provided, That any employee who requests leave under subsection (3)(A) for service described in subsection (2) of this section is entitled to such leave, subject to the provisions of this section and of the last sentence of section 6323(b) of title 5, United States Code, and such leave shall be considered leave under section 6323(b) of title 5, United States Code.”\",\"start\":17065},{\"end\":17203,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A954afb164b0087d7b402ec321589cfcb8ad9ce1bcb8381ed8e67a21327e85a01:17192:17203:sha256-856584827ada6694e69d87f4f642d43687f1f2e1904979dc357cdd7b19a76aac\",\"quote\":\"is entitled\",\"start\":17192},{\"end\":17432,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A954afb164b0087d7b402ec321589cfcb8ad9ce1bcb8381ed8e67a21327e85a01:17065:17432:sha256-de2a9beab87bcca49d0b8a4631da827a7df4065b85f2c1b82ca61c7a67d53548\",\"quote\":\"Provided, That any employee who requests leave under subsection (3)(A) for service described in subsection (2) of this section is entitled to such leave, subject to the provisions of this section and of the last sentence of section 6323(b) of title 5, United States Code, and such leave shall be considered leave under section 6323(b) of title 5, United States Code.”\",\"start\":17065}],\"id\":\"urn:rulespec:document-understanding:revision:13b5eb820225cb03791cfeae7856238ee0bfee326f1896de962e34ef77aacb27\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:0ae53f556eabb851168f0320951c1d00e2688e2324e42b30d947ffbb903b3371\",\"modality\":\"must\",\"modality_quote\":\"is entitled\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:013607ba55f3156bf767fa58ee4c8868ca309c8d94faba0cdfa2dd3f1fd55589\",\"origin\":\"aiSuggested\",\"quote\":\"Provided, That any employee who requests leave under subsection (3)(A) for service described in subsection (2) of this section is entitled to such leave, subject to the provisions of this section and of the last sentence of section 6323(b) of title 5, United States Code, and such leave shall be considered leave under section 6323(b) of title 5, United States Code.”\",\"references\":[\"subsection (3)(A)\",\"subsection (2)\",\"section 6323(b) of title 5, United States Code\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:3c350628d1ce3494db777447d246262a6e4d2327741a34392d8269a0e0828415\",\"scope_quotes\":[\"Provided, That any employee who requests leave under subsection (3)(A) for service described in subsection (2) of this section is entitled to such leave, subject to the provisions of this section and of the last sentence of section 6323(b) of title 5, United States Code, and such leave shall be considered leave under section 6323(b) of title 5, United States Code.”\"],\"scope_text\":\"subject to the provisions of this section and of the last sentence of section 6323(b) of title 5, United States Code\",\"section_id\":\"urn:rulespec:document-understanding:section:5d11b498a26782414f6a880ee33e0d7de40f12c55ab75e39cacb31ab4eb93ebc\",\"start\":17065,\"summary\":\"Any employee who requests leave under subsection (3)(A) of section 8023 of Pub. L. 107–117 for service described in subsection (2) of that section is entitled to such leave, subject to the provisions of that section and of the last sentence of section 6323(b) of title 5, United States Code, and such leave shall be considered leave under section 6323(b) of title 5, United States Code.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

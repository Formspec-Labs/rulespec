      "dcterms:description": "{\"action\":\"\",\"actor\":\"consular officer\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:1254caa97babd459de095dd9762d8b5b20bf34599357d9291230916dd32c2673\",\"urn:rulespec:document-understanding:assertion:f8d9e194e8b34e3fb67288d7e247a009f4f1c72b7d329fe4f257717162875aff\",\"urn:rulespec:document-understanding:assertion:b59a5f1a8e9a0473ace7c9de4a139a531667d7fb4d2774618cd88df0cd857aa9\",\"urn:rulespec:document-understanding:assertion:213a0ecc6a2c2137d17573a5a11388caf56743a4cc628aa7484463a96a1d2832\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":309,\"evidence\":[{\"end\":309,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A2f1b8c8b8a8e5f20335289c9791b49c29e25931f2eb629b02018723fe3ee8008:111:309:sha256-90372037d467b8c8b97f79569497158fdb8a43155888650a40ea9d0a98ae26b9\",\"quote\":\"a. The role of the consular officer is now limited to\\r\\nproviding information obtained from foreign officials on requirements for local\\r\\nmarriages and performing notarial and authentication services.\",\"start\":111},{\"end\":146,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A2f1b8c8b8a8e5f20335289c9791b49c29e25931f2eb629b02018723fe3ee8008:130:146:sha256-20f2bb468d9b8c53147b6f54a279a73fd6cc1ced1612cce8d0928f7646c143db\",\"quote\":\"consular officer\",\"start\":130}],\"id\":\"urn:rulespec:document-understanding:revision:1c83ba7430543c804ec7c99b50b9fe28a6f95e6a90336bb2ce0a26ab430b01de\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"statement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:213a0ecc6a2c2137d17573a5a11388caf56743a4cc628aa7484463a96a1d2832\",\"modality\":\"not_stated\",\"modality_quote\":\"\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:1db237041372e597fab31fac708e689a0c01213fb2c5e6f85e551dc5472b5c4c\",\"origin\":\"aiSuggested\",\"quote\":\"a. The role of the consular officer is now limited to\\r\\nproviding information obtained from foreign officials on requirements for local\\r\\nmarriages and performing notarial and authentication services.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:caef12578078388f2b6ffa98a3e8d97f15ef53d9121e4a73ee2d446e6582379d\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":111,\"summary\":\"The role of the consular officer is limited to providing information obtained from foreign officials on requirements for local marriages and performing notarial and authentication services.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

        "window-16b20beddb05a62e20ff"
      ],
      "processing": "processed"
    },
    {
      "id": "urn:rulespec:document-understanding:passage:86e30a0972d576750740fe86f2245b0a8b3c9981bd27d6d67c22ac531d319374",
      "source": "urn:rulespec:document-understanding:document:2f1b8c8b8a8e5f20335289c9791b49c29e25931f2eb629b02018723fe3ee8008",
      "text": "a. Diplomatic and Consular officers and U.S. Ambassadors cannot conduct marriage ceremonies.  \n\n",
      "claim_ids": [
        "urn:rulespec:document-understanding:revision:68456fbc9ac08dba4a60c6b0ac9a5e0bf9f844e7ab580843f9869fc58a8d842e"
      ],
      "evidence_refs": [
        {
          "id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A2f1b8c8b8a8e5f20335289c9791b49c29e25931f2eb629b02018723fe3ee8008:1278:1374:sha256-d70695a1c1ab7aca38700896a04f9c4fe33443771222cd6b434aca0d99b8423c",
          "roles": [
            "source"
          ]
        },
        {
          "id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A2f1b8c8b8a8e5f20335289c9791b49c29e25931f2eb629b02018723fe3ee8008:1278:1370:sha256-f8791586e9dd637fcdbec0b78a09db1c111c2fdc7999a3f93178b7409a3533d2",
          "roles": [
            "summary"
          ]
        }
      ],
      "start": 1278,
      "end": 1374,
      "parent_id": null,
      "kind": "list_item",
      "structure_method": "text-paragraphs-and-list-markers/2",
      "window_ids": [
        "window-16b20beddb05a62e20ff"
      ],
      "processing": "processed"
    },
    {
      "id": "urn:rulespec:document-understanding:passage:be915858f8f85ef20a2b6a43ecd4b8180f3245873fc4e2df4ee2d45bb9b6c22c",
      "source": "urn:rulespec:document-understanding:document:2f1b8c8b8a8e5f20335289c9791b49c29e25931f2eb629b02018723fe3ee8008",
      "text": "b. You cannot issue any official certificate with\r\nrespect to marriage laws, even if knowledgeable about the laws of marriage of the receiving state (22 CFR 92.4(a)).\n\n",
      "claim_ids": [
        "urn:rulespec:document-understanding:revision:dccc111dd6b236479316c73ec5e03f3aa42e83a662d47adfae22793df11f118b"
      ],
      "evidence_refs": [
        {
          "id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A2f1b8c8b8a8e5f20335289c9791b49c29e25931f2eb629b02018723fe3ee8008:1374:1542:sha256-b426a894cb5e717f64733121f6764ba68aadc1e282e90fd4593d0fdc6658ce0b",
          "roles": [
            "source"
          ]
        },
        {
          "id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A2f1b8c8b8a8e5f20335289c9791b49c29e25931f2eb629b02018723fe3ee8008:1374:1540:sha256-8a8d330b1204246da3c1c5ab6a099763e592ff7c456c17e1f9ad31f2c63bd720",
          "roles": [
            "summary",
            "scope_text:0"
          ]
        }
      ],
      "start": 1374,
      "end": 1542,
      "parent_id": null,
      "kind": "list_item",
      "structure_method": "text-paragraphs-and-list-markers/2",
      "window_ids": [
        "window-16b20beddb05a62e20ff"
      ],
      "processing": "processed"
    },
    {
      "id": "urn:rulespec:document-understanding:passage:0e9380b0acbdcce314c3a4cf98e2ac0e1381f48d620017446c7675e39f9a8c03",
      "source": "urn:rulespec:document-understanding:document:2f1b8c8b8a8e5f20335289c9791b49c29e25931f2eb629b02018723fe3ee8008",
      "text": "c.  You cannot make any official certification about\r\nthe status or eligibility to marry of persons residing in the United States who\r\npropose to be married abroad, or about the laws of the United States or of any\r\nof the fifty States or Territories about eligibility for marriage or the\r\nsolemnization of a marriage.\n\n",
      "claim_ids": [
        "urn:rulespec:document-understanding:revision:4f42dde4da07a9b9a1b985340d9ff8be1a9dc7161f074553345ebd263e713a21"
      ],
      "evidence_refs": [
        {
          "id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A2f1b8c8b8a8e5f20335289c9791b49c29e25931f2eb629b02018723fe3ee8008:1542:1861:sha256-ebca5665f29266fa37aff884bbf68cd70aea2c856b687435cf9c8bcda77afbf1",
          "roles": [
            "source"
          ]
        },
        {
          "id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A2f1b8c8b8a8e5f20335289c9791b49c29e25931f2eb629b02018723fe3ee8008:1542:1859:sha256-798111cffb1bbd28cf99e8baf31915fedf63c03624a002e0103195edf6ca3184",
          "roles": [
            "summary"
          ]
        }
      ],
      "start": 1542,
      "end": 1861,
      "parent_id": null,
      "kind": "list_item",
      "structure_method": "text-paragraphs-and-list-markers/2",
      "window_ids": [
        "window-16b20beddb05a62e20ff"
      ],
      "processing": "processed"
    },
    {
      "id": "urn:rulespec:document-understanding:passage:64469123dda550f0e603581d187cb52993a1f3a5e6360899821917aaca413d6e",
      "source": "urn:rulespec:document-understanding:document:2f1b8c8b8a8e5f20335289c9791b49c29e25931f2eb629b02018723fe3ee8008",
      "text": "d. You cannot give an official or authoritative opinion\r\non matters of local (receiving state) law\r\nand practices to parties proposing to be married abroad.\n\n",
      "claim_ids": [
        "urn:rulespec:document-understanding:revision:d7a3fde7639f6b53324c39d98f3c991eeb5bdb4efa05386b9f0806a4ae0631a6"

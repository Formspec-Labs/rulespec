    {
      "id": "urn:rulespec:document-understanding:passage:14245ca6fbdddbdfb6e590072aa13bc9a110d3750f7d9e5eccdd31d57e0f3473",
      "source": "urn:rulespec:document-understanding:document:2f1b8c8b8a8e5f20335289c9791b49c29e25931f2eb629b02018723fe3ee8008",
      "text": "(CT:CON-119;   12-01-2005)\n\n",
      "claim_ids": [],
      "evidence_refs": [
        {
          "id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A2f1b8c8b8a8e5f20335289c9791b49c29e25931f2eb629b02018723fe3ee8008:83:111:sha256-e586dadbb759cd80418ec6a0a0a535b04d0d5616866a7a65019c969fe757a6e0",

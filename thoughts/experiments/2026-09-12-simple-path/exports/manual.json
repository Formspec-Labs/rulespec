      "text": "7 FAM 1453.2  What Consular Officers Can’t Do\n\n",
      "claim_ids": [],
      "evidence_refs": [
        {
          "id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A2f1b8c8b8a8e5f20335289c9791b49c29e25931f2eb629b02018723fe3ee8008:1202:1249:sha256-13fb5455ffd08d4d3da55ab7c204d0b06b4779eb8ec03b91e7ba70484f866ce1",

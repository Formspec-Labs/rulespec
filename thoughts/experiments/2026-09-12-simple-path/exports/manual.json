    {
      "id": "urn:rulespec:document-understanding:revision:204d486e4dabc1efea8ab46177c7b46111c98edbd9e8d31785fb869ff0b1ceea",
      "rule_id": "urn:rulespec:document-understanding:rule:f6a6337514e55112db3dd6262fb2a2a2cbaa83d575b06a35dff2db6ebf7a36a3",
      "statement": "Prior to November 9, 1989, consular officers, when requested to do so, could make certain that foreign marriages were effective for purposes of U.S. law by acting as official witnesses to the marriage when one of the contracting parties was a U.S. citizen, pursuant to the authority of Section 31 of the Act of June 22, 1860 (12 Stat. 79; 22 U.S.C. 4192), which also provided for issuance of an official certificate of witness to such marriage.",
      "kind": "authority",
      "actor": "consular officers",
      "modality": "may",
      "scope_text": "Prior to November 9, 1989, when requested to do so, and when one of the contracting parties was a U.S. citizen",
      "references": [
        "Section 31 of the Act of June 22, 1860",
        "12 Stat. 79",
        "22 U.S.C. 4192"
      ],
      "evidence_refs": [
        {

      "text": "(CT:CON-1061;   04-04-2025)\n\n",
      "claim_ids": [],
      "evidence_refs": [
        {
          "id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A2f1b8c8b8a8e5f20335289c9791b49c29e25931f2eb629b02018723fe3ee8008:1249:1278:sha256-c77d30588686c4025299aa981e1209ae97675703a758ebf5c031d56ea32ea868",

      "text": "7 FAM 1453.1  What Consular Officers Can Do\n\n",
      "claim_ids": [],
      "evidence_refs": [
        {
          "id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A2f1b8c8b8a8e5f20335289c9791b49c29e25931f2eb629b02018723fe3ee8008:38:83:sha256-ff58f5f806ffe803110b2da1012434b9c648e9001babf8dadcb9b39b3e3feb6b",

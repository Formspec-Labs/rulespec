  "statements": [
    {
      "id": "urn:rulespec:document-understanding:revision:1c83ba7430543c804ec7c99b50b9fe28a6f95e6a90336bb2ce0a26ab430b01de",
      "rule_id": "urn:rulespec:document-understanding:rule:caef12578078388f2b6ffa98a3e8d97f15ef53d9121e4a73ee2d446e6582379d",
      "statement": "The role of the consular officer is limited to providing information obtained from foreign officials on requirements for local marriages and performing notarial and authentication services.",
      "kind": "statement",
      "actor": "consular officer",
      "modality": "not_stated",

            "text": "{\n  \"extractions\": [\n    {\n      \"unit\": \"P000\",\n      \"unit_attributes\": {\n        \"kind\": \"statement\",\n        \"scope_quotes\": [\"P000\"],\n        \"scope_text\": \"When photographing infants.\",\n        \"context_quotes\": [],\n        \"modality_quote\": \"\",\n        \"modality\": \"not_stated\",\n        \"alternative_quotes\": [],\n        \"choice_quote\": \"\",\n        \"choice_text\": \"\",\n        \"logic_text\": \"\",\n        \"references\": [],\n        \"statement\": \"Infants pose a particular challenge, and the goal is the best likeness that can reasonably be obtained.\"\n      }\n    },\n    {\n      \"unit\": \"P001\",\n      \"unit_attributes\": {\n        \"kind\": \"permission\",\n        \"scope_quotes\": [\"P000\", \"P001\"],\n        \"scope_text\": \"In photographs of infants, particularly newborns.\",\n        \"context_quotes\": [\"P000\"],\n        \"modality_quote\": \"is acceptable\",\n        \"modality\": \"may\",\n        \"alternative_quotes\": [],\n        \"choice_quote\": \"\",\n        \"choice_text\": \"\",\n        \"logic_text\": \"partially or completely\",\n        \"references\": [],\n        \"statement\": \"It is acceptable if the infant's eyes, particularly a newborn's, are partially or completely closed.\"\n      }\n    },\n    {\n      \"unit\": \"P002\",\n      \"unit_attributes\": {\n        \"kind\": \"permission\",\n        \"scope_quotes\": [\"P000\", \"P002\"],\n        \"scope_text\": \"For infant photographs.\",\n        \"context_quotes\": [\"P000\"],\n        \"modality_quote\": \"may\",\n        \"modality\": \"may\",\n        \"alternative_quotes\": [],\n        \"choice_quote\": \"\",\n        \"choice_text\": \"\",\n        \"logic_text\": \"white or off-white\",\n        \"references\": [],\n        \"statement\": \"The infant's head may be discreetly supported, such as with a car seat with a white or off-white blanket behind the child.\"\n      }\n    },\n    {\n      \"unit\": \"P002\",\n      \"unit_attributes\": {\n        \"kind\": \"permission\",\n        \"scope_quotes\": [\"P000\", \"P002\"],\n        \"scope_text\": \"For infant photographs.\",\n        \"context_quotes\": [\"P000\"],\n        \"modality_quote\": \"is acceptable\",\n        \"modality\": \"may\",\n        \"alternative_quotes\": [],\n        \"choice_quote\": \"\",\n        \"choice_text\": \"\",\n        \"logic_text\": \"\",\n        \"references\": [],\n        \"statement\": \"Head tilt is acceptable for infants in photographs.\"\n      }\n    },\n    {\n      \"unit\": \"P003\",\n      \"unit_attributes\": {\n        \"kind\": \"prohibition\",\n        \"scope_quotes\": [\"P000\", \"P003\"],\n        \"scope_text\": \"In the photograph of an infant.\",\n        \"context_quotes\": [],\n        \"modality_quote\": \"cannot\",\n        \"modality\": \"must_not\",\n        \"alternative_quotes\": [],\n        \"choice_quote\": \"\",\n        \"choice_text\": \"\",\n        \"logic_text\": \"cannot\",\n        \"references\": [],\n        \"statement\": \"A parent’s face cannot be in the photograph of the infant.\"\n      }\n    },\n    {\n      \"unit\": \"P004\",\n      \"unit_attributes\": {\n        \"kind\": \"requirement\",\n        \"scope_quotes\": [\"P004\"],\n        \"scope_text\": \"If the photograph submitted does not meet the specified requirements.\",\n        \"context_quotes\": [],\n        \"modality_quote\": \"must\",\n        \"modality\": \"must\",\n        \"alternative_quotes\": [],\n        \"choice_quote\": \"\",\n        \"choice_text\": \"\",\n        \"logic_text\": \"if the photograph submitted does not meet the following requirements\",\n        \"references\": [],\n        \"statement\": \"You must request a new photograph if the photograph submitted does not meet the specified requirements.\"\n      }\n    },\n    {\n      \"unit\": \"P005\",\n      \"unit_attributes\": {\n        \"kind\": \"requirement\",\n        \"scope_quotes\": [\"P004\", \"P005\"],\n        \"scope_text\": \"For submitted photographs.\",\n        \"context_quotes\": [],\n        \"modality_quote\": \"must\",\n        \"modality\": \"must\",\n        \"alternative_quotes\": [],\n        \"choice_quote\": \"\",\n        \"choice_text\": \"\",\n        \"logic_text\": \"\",\n        \"references\": [],\n        \"statement\": \"The photograph must be in color.\"\n      }\n    },\n    {\n      \"unit\": \"P006\",\n      \"unit_attributes\": {\n        \"kind\": \"recommendation\",\n        \"scope_quotes\": [\"P004\", \"P006\"],\n        \"scope_text\": \"For submitted photographs.\",\n        \"context_quotes\": [],\n        \"modality_quote\": \"should\",\n        \"modality\": \"should\",\n        \"alternative_quotes\": [],\n        \"choice_quote\": \"\",\n        \"choice_text\": \"\",\n        \"logic_text\": \"within six months of submitting the application\",\n        \"references\": [\"22 CFR 51.26\"],\n        \"statement\": \"The photograph should be taken within six months of submitting the application, be a good likeness of and satisfactorily identify the applicant at the time of the application (see 22 CFR 51.26).\"\n      }\n    },\n    {\n      \"unit\": \"P006\",\n      \"unit_attributes\": {\n        \"kind\": \"permission\",\n        \"scope_quotes\": [\"P006\"],\n        \"scope_text\": \"When a photograph shows a change in hairstyle or facial hair from the identification document submitted, provided it still is a good likeness of the applicant.\",\n        \"context_quotes\": [],\n        \"modality_quote\": \"is acceptable\",\n        \"modality\": \"may\",\n        \"alternative_quotes\": [],\n        \"choice_quote\": \"\",\n        \"choice_text\": \"\",\n        \"logic_text\": \"hairstyle or facial hair\",\n        \"references\": [],\n        \"statement\": \"A photograph showing a change in hairstyle or facial hair from the identification document submitted is acceptable if it still is a good likeness of the applicant.\"\n      }\n    },\n    {\n      \"unit\": \"P007\",\n      \"unit_attributes\": {\n        \"kind\": \"statement\",\n        \"scope_quotes\": [\"P007\"],\n        \"scope_text\": \"When applicants submit a U.S. Certificate of Citizenship or Certificate of Naturalization.\",\n        \"context_quotes\": [],\n        \"modality_quote\": \"may\",\n        \"modality\": \"possible\",\n        \"alternative_quotes\": [],\n        \"choice_quote\": \"\",\n        \"choice_text\": \"\",\n        \"logic_text\": \"Certificate of Citizenship or Certificate of Naturalization\",\n        \"references\": [],\n        \"statement\": \"Applicants may wish to re-use a passport photograph that is depicted on their submitted U.S Certificate of Citizenship or Certificate of Naturalization.\"\n      }\n    },\n    {\n      \"unit\": \"P007\",\n      \"unit_attributes\": {\n        \"kind\": \"statement\",\n        \"scope_quotes\": [\"P007\"],\n        \"scope_text\": \"Even if the submitted U.S. Certificate of Citizenship or Certificate of Naturalization itself was recently issued.\",\n        \"context_quotes\": [],\n        \"modality_quote\": \"may not\",\n        \"modality\": \"possible\",\n        \"alternative_quotes\": [],\n        \"choice_quote\": \"\",\n        \"choice_text\": \"\",\n        \"logic_text\": \"even if the certificate itself was recently issued, because of U.S. Citizenship and Immigration Services processing times, the photograph may not have been taken within six months of submitting the application\",\n        \"references\": [],\n        \"statement\": \"Even if the certificate itself was recently issued, because of U.S. Citizenship and Immigration Services processing times, the photograph may not have been taken within six months of submitting the application.\"\n      }\n    }\n  ]\n}",

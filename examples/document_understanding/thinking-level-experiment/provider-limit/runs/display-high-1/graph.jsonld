        "oa:TextQuoteSelector",
        "oa:TextPositionSelector"
      ],
      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "(3) The organizer must appoint an adult steward who remains on site throughout the time the display remains open. This appointment duty does not apply when an agency employee is assigned to supervise the display for that entire period."
        },
        {
          "@type": "oa:TextPositionSelector",
          "oa:start": 519,
          "oa:end": 754,
          "rkaf:coordinateSystem": "rkaf:unicode-codepoint"
        }
      ]
    },
    {
      "@id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Acd1d2d681c56417058e5883c90b99d7d8c562af40621c5b8e3d3b614540154d5:756:1032:sha256-3934718a22f833f138629ffb5bab45a2b2f01847a57e012596d11a7b70c44c19",
      "@type": "rkaf:SourceFragment",
      "oa:hasSource": "urn:rulespec:document-understanding:document:cd1d2d681c56417058e5883c90b99d7d8c562af40621c5b8e3d3b614540154d5",

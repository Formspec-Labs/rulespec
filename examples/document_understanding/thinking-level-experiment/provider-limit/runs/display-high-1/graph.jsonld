      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:102a6e4c263812d8e9a3401e2bd0a66e957b9a96065d34f6cce424012b768b5a\",\"urn:rulespec:document-understanding:assertion:c2830ac188202377b9f9b873cc936e3c34434e1eb90e9bd84d41fd3119a5314b\",\"urn:rulespec:document-understanding:assertion:97e06d53bd5be15342d95084ee9ea145385fda344d4a706109870f5e5a6d3aae\",\"urn:rulespec:document-understanding:assertion:583afaf35ee42e11d810d0f0cd307e85a03902549af1463034106fb8cf98ef07\",\"urn:rulespec:document-understanding:assertion:0386838f5bbc0720d62837cf6bc1d6ac836079bff0c7f61a1f0753aaff204d3a\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"effective_periods\":[],\"end\":754,\"evidence\":[{\"end\":754,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Acd1d2d681c56417058e5883c90b99d7d8c562af40621c5b8e3d3b614540154d5:519:754:sha256-dbea7b17f13efc5648bf55eebcb9aff4b968bd00d90301ecde3f87fb84c14234\",\"quote\":\"(3) The organizer must appoint an adult steward who remains on site throughout the time the display remains open. This appointment duty does not apply when an agency employee is assigned to supervise the display for that entire period.\",\"start\":519},{\"end\":754,\"field\":\"logic_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Acd1d2d681c56417058e5883c90b99d7d8c562af40621c5b8e3d3b614540154d5:519:754:sha256-dbea7b17f13efc5648bf55eebcb9aff4b968bd00d90301ecde3f87fb84c14234\",\"quote\":\"(3) The organizer must appoint an adult steward who remains on site throughout the time the display remains open. This appointment duty does not apply when an agency employee is assigned to supervise the display for that entire period.\",\"start\":519},{\"end\":541,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Acd1d2d681c56417058e5883c90b99d7d8c562af40621c5b8e3d3b614540154d5:537:541:sha256-4137b01e139589b7a1d3b3fc4da031d8ce5bb415808734e970c3a58ea0e98f0f\",\"quote\":\"must\",\"start\":537},{\"end\":230,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Acd1d2d681c56417058e5883c90b99d7d8c562af40621c5b8e3d3b614540154d5:91:230:sha256-b6abd80d117b4b566300972de823d7857c2472c21cbd8866fece15a96eef055f\",\"quote\":\"(a) For a temporary display open to the public after sunset on agency premises, the organizer must satisfy all of the following conditions:\",\"start\":91},{\"end\":754,\"field\":\"scope_text:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Acd1d2d681c56417058e5883c90b99d7d8c562af40621c5b8e3d3b614540154d5:519:754:sha256-dbea7b17f13efc5648bf55eebcb9aff4b968bd00d90301ecde3f87fb84c14234\",\"quote\":\"(3) The organizer must appoint an adult steward who remains on site throughout the time the display remains open. This appointment duty does not apply when an agency employee is assigned to supervise the display for that entire period.\",\"start\":519}],\"id\":\"urn:rulespec:document-understanding:revision:b69015c47da00f0327c5dcfac145319be84f33ffa02188b27cddd6d2fb6f1d0c\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"(3) The organizer must appoint an adult steward who remains on site throughout the time the display remains open. This appointment duty does not apply when an agency employee is assigned to supervise the display for that entire period.\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:0386838f5bbc0720d62837cf6bc1d6ac836079bff0c7f61a1f0753aaff204d3a\",\"modality\":\"must\",\"modality_quote\":\"must\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:6f541d13f4dce3e277f9ee1e10abc432ef25719fc24b1f32537b85d774cf7110\",\"origin\":\"aiSuggested\",\"quote\":\"(3) The organizer must appoint an adult steward who remains on site throughout the time the display remains open. This appointment duty does not apply when an agency employee is assigned to supervise the display for that entire period.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:6bb16733947aa057ad3af404cc63aa6cb431cf8bb46a41ccba096c8c2a9d9d3d\",\"scope_quotes\":[\"(a) For a temporary display open to the public after sunset on agency premises, the organizer must satisfy all of the following conditions:\",\"(3) The organizer must appoint an adult steward who remains on site throughout the time the display remains open. This appointment duty does not apply when an agency employee is assigned to supervise the display for that entire period.\"],\"scope_text\":\"For a temporary display open to the public after sunset on agency premises, unless an agency employee is assigned to supervise the display for that entire period.\",\"section_id\":\"section-1\",\"start\":519,\"summary\":\"For a temporary display open to the public after sunset on agency premises, the organizer must appoint an adult steward who remains on site throughout the time the display remains open, except that this appointment duty does not apply when an agency employee is assigned to supervise the display for that entire period.\",\"target_ids\":[],\"typed_values\":[]}",

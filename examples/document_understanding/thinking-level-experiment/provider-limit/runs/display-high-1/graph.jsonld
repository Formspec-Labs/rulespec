      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[\"(1) The organizer must illuminate every public exit throughout the time the display remains open.\",\"(2) The organizer must keep every public exit clear throughout the time the display remains open. Equipment stored behind a locked staff-only door is not an obstruction of a public exit.\",\"(3) The organizer must appoint an adult steward who remains on site throughout the time the display remains open. This appointment duty does not apply when an agency employee is assigned to supervise the display for that entire period.\",\"(4) Before admitting the first visitor, the organizer must give the agency either a signed paper inspection record or an electronic inspection record signed by the inspecting officer. Each record must identify the display, the inspection date, and every public exit inspected.\"],\"choice_text\":\"All of the following conditions: (1) illuminate every public exit throughout the time the display remains open; (2) keep every public exit clear throughout the time the display remains open; (3) appoint an adult steward who remains on site throughout the time the display remains open (unless an agency employee is assigned to supervise for that entire period); and (4) before admitting the first visitor, give the agency either a signed paper inspection record or an electronic inspection record signed by the inspecting officer, with each record identifying the display, the inspection date, and every public exit inspected.\",\"claimants\":[],\"concepts\":[],\"effective_periods\":[],\"jurisdiction\":\"\",\"kind\":\"requirement\",\"logic_text\":\"(a) For a temporary display open to the public after sunset on agency premises, the organizer must satisfy all of the following conditions:\",\"modality\":\"must\",\"object\":\"\",\"scope_text\":\"For a temporary display open to the public after sunset on agency premises.\",\"summary\":\"For a temporary display open to the public after sunset on agency premises, the organizer must satisfy all of the following conditions: illuminate every public exit throughout the time the display remains open; keep every public exit clear throughout the time the display remains open; appoint an adult steward who remains on site throughout the time the display remains open (unless an agency employee is assigned to supervise the display for that entire period); and, before admitting the first visitor, give the agency either a signed paper inspection record or an electronic inspection record signed by the inspecting officer, identifying the display, the inspection date, and every public exit inspected.\",\"typed_values\":[]}",
        "@type": "xsd:string"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed",
      "rkaf:hasApplicability": "urn:rulespec:document-understanding:scope:012ba47d7ca02315f14cb645b8a688ac188ce622fb4efd44b837832cdff1d34b"
    },

      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:8334d825e1282e3cca4a94eb5854a69762a95203dd21ff0ca339b5094e140b47\",\"urn:rulespec:document-understanding:assertion:441dd7fc1f86f3f217cf4b72cb15aa903ffa772e3c4e0a183bd0ad0ffb9e783b\",\"urn:rulespec:document-understanding:assertion:876a1039c1146c3eb4bf765980366656ddb4f73d7bf9e256358f0de9a411b0c3\",\"urn:rulespec:document-understanding:assertion:d2a209e27896167bbb4f1212617453609177d6f6baa553b358a01f8279d6c16d\",\"urn:rulespec:document-understanding:assertion:2df51435007786cfc8febde328c4aa4294153a6def3cbdbe35377f2bfed8e8ca\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"effective_periods\":[],\"end\":1555,\"evidence\":[{\"end\":1555,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Acd1d2d681c56417058e5883c90b99d7d8c562af40621c5b8e3d3b614540154d5:1354:1555:sha256-76f262896325f8478b95b626857500a006e07a2d4c8aadb8f712cb7a7c69a7c9\",\"quote\":\"(3) An agency officer authorizes the demonstration for the duration of the current warning. The authorization expires when that warning ends; it does not authorize demonstrations under a later warning.\",\"start\":1354},{\"end\":1555,\"field\":\"logic_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Acd1d2d681c56417058e5883c90b99d7d8c562af40621c5b8e3d3b614540154d5:1354:1555:sha256-76f262896325f8478b95b626857500a006e07a2d4c8aadb8f712cb7a7c69a7c9\",\"quote\":\"(3) An agency officer authorizes the demonstration for the duration of the current warning. The authorization expires when that warning ends; it does not authorize demonstrations under a later warning.\",\"start\":1354},{\"end\":1167,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Acd1d2d681c56417058e5883c90b99d7d8c562af40621c5b8e3d3b614540154d5:1034:1167:sha256-e9b094caa665823399068cbaa95843ab925afb1fd087cd1d36da3154a6090129\",\"quote\":\"(b) When a storm warning is active, the organizer must suspend outdoor demonstrations unless all of the following conditions are met:\",\"start\":1034},{\"end\":1555,\"field\":\"scope_text:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Acd1d2d681c56417058e5883c90b99d7d8c562af40621c5b8e3d3b614540154d5:1354:1555:sha256-76f262896325f8478b95b626857500a006e07a2d4c8aadb8f712cb7a7c69a7c9\",\"quote\":\"(3) An agency officer authorizes the demonstration for the duration of the current warning. The authorization expires when that warning ends; it does not authorize demonstrations under a later warning.\",\"start\":1354}],\"id\":\"urn:rulespec:document-understanding:revision:06361b5b86aa13a3c3a2c2d6412858cafe47c8467fcc977cadff7b89b83157d4\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"statement\",\"logic_text\":\"(3) An agency officer authorizes the demonstration for the duration of the current warning. The authorization expires when that warning ends; it does not authorize demonstrations under a later warning.\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:2df51435007786cfc8febde328c4aa4294153a6def3cbdbe35377f2bfed8e8ca\",\"modality\":\"not_stated\",\"modality_quote\":\"\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:17992e4544fb610cc38b7c94077bbb48d84a50540ccf7339be302a9e4df761e0\",\"origin\":\"aiSuggested\",\"quote\":\"(3) An agency officer authorizes the demonstration for the duration of the current warning. The authorization expires when that warning ends; it does not authorize demonstrations under a later warning.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:34e2b2ef6ba595410e8db1f94fb493f4447487591d35f749c3a7a37820770ac4\",\"scope_quotes\":[\"(b) When a storm warning is active, the organizer must suspend outdoor demonstrations unless all of the following conditions are met:\",\"(3) An agency officer authorizes the demonstration for the duration of the current warning. The authorization expires when that warning ends; it does not authorize demonstrations under a later warning.\"],\"scope_text\":\"When an agency officer authorizes an outdoor demonstration for the duration of an active storm warning.\",\"section_id\":\"section-1\",\"start\":1354,\"summary\":\"An authorization granted by an agency officer for an outdoor demonstration during a storm warning expires when that warning ends, and it does not authorize demonstrations under a later warning.\",\"target_ids\":[],\"typed_values\":[]}",

      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "(2) The organizer must keep every public exit clear throughout the time the display remains open. Equipment stored behind a locked staff-only door is not an obstruction of a public exit."
        },
        {
          "@type": "oa:TextPositionSelector",
          "oa:start": 331,
          "oa:end": 517,
          "rkaf:coordinateSystem": "rkaf:unicode-codepoint"
        }
      ]
    },
    {
      "@id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Acd1d2d681c56417058e5883c90b99d7d8c562af40621c5b8e3d3b614540154d5:519:754:sha256-dbea7b17f13efc5648bf55eebcb9aff4b968bd00d90301ecde3f87fb84c14234",
      "@type": "rkaf:SourceFragment",
      "oa:hasSource": "urn:rulespec:document-understanding:document:cd1d2d681c56417058e5883c90b99d7d8c562af40621c5b8e3d3b614540154d5",
      "rkaf:fragmentIdentityScheme": "rkaf:carrier-local-fragment",
      "rkaf:sourceArtifactDigest": "sha256:cd1d2d681c56417058e5883c90b99d7d8c562af40621c5b8e3d3b614540154d5",
      "rkaf:fragmentContentDigest": "sha256:dbea7b17f13efc5648bf55eebcb9aff4b968bd00d90301ecde3f87fb84c14234",

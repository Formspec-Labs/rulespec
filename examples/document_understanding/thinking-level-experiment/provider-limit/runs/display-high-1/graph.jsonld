    {
      "@id": "urn:rulespec:document-understanding:assertion:7cdd1359bc3f2bc6907d1b6117067017068315f29f2deef0c5eec39329e59bfa",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:25df06faf61b81fbd5834618985f445d1050ca9b440dce155e822e9afc8d29f0",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:2c980de7f78990881e5f08631671d2db0aea958c1fcd0fd36c5daf07d56f5bec",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:e9ddc3df509da4838517365b9886f553fcd2acac8bf88f3196f510b865a85c43",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:choice_text",
      "rkaf:assertsValue": {
        "@value": "All of the following conditions: (1) illuminate every public exit throughout the time the display remains open; (2) keep every public exit clear throughout the time the display remains open; (3) appoint an adult steward who remains on site throughout the time the display remains open (unless an agency employee is assigned to supervise for that entire period); and (4) before admitting the first visitor, give the agency either a signed paper inspection record or an electronic inspection record signed by the inspecting officer, with each record identifying the display, the inspection date, and every public exit inspected.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

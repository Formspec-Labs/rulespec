    {
      "@id": "urn:rulespec:document-understanding:revision:01af5e02b8442981f01a15a4b8ef469b7b36a33257383a1b6e9577a5db53a0c7",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:01af5e02b8442981f01a15a4b8ef469b7b36a33257383a1b6e9577a5db53a0c7",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",

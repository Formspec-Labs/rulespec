      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:6f962bdaaf44f5984d93c8d1fd78cd14d4d8abd440a0ba1f5e8cd5149748b3c6\",\"urn:rulespec:document-understanding:assertion:00cf87a130819c98cb2ebc7061d6a308f8e917ec065ccd48533a7d22950b1d1f\",\"urn:rulespec:document-understanding:assertion:e64df07c046e8ac3e68d5f762c400c33624ed472bdfb1a44474e222017e65622\",\"urn:rulespec:document-understanding:assertion:6240cfd7836e645a89d2fc734a69c755ce36f0b01708b4656f71d029ffe05b6a\",\"urn:rulespec:document-understanding:assertion:a8085825d2291f430da99bde0286231088a1d871bfbbd5933ea03fb254f26ff8\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[\"(1) The organizer must illuminate every public exit throughout the time the display remains open.\"],\"effective_periods\":[],\"end\":1740,\"evidence\":[{\"end\":1740,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Acd1d2d681c56417058e5883c90b99d7d8c562af40621c5b8e3d3b614540154d5:1557:1740:sha256-790b8c74af5f59d2bc58d9383788c0a7e1ed84629ef0907b749b0bb47b54d41f\",\"quote\":\"(c) For displays held entirely before sunset, the organizer should place a readable map near the entrance. This recommendation does not create a duty to illuminate exits after sunset.\",\"start\":1557},{\"end\":1740,\"field\":\"logic_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Acd1d2d681c56417058e5883c90b99d7d8c562af40621c5b8e3d3b614540154d5:1557:1740:sha256-790b8c74af5f59d2bc58d9383788c0a7e1ed84629ef0907b749b0bb47b54d41f\",\"quote\":\"(c) For displays held entirely before sunset, the organizer should place a readable map near the entrance. This recommendation does not create a duty to illuminate exits after sunset.\",\"start\":1557},{\"end\":1740,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Acd1d2d681c56417058e5883c90b99d7d8c562af40621c5b8e3d3b614540154d5:1557:1740:sha256-790b8c74af5f59d2bc58d9383788c0a7e1ed84629ef0907b749b0bb47b54d41f\",\"quote\":\"(c) For displays held entirely before sunset, the organizer should place a readable map near the entrance. This recommendation does not create a duty to illuminate exits after sunset.\",\"start\":1557},{\"end\":329,\"field\":\"context:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Acd1d2d681c56417058e5883c90b99d7d8c562af40621c5b8e3d3b614540154d5:232:329:sha256-6f1dc530568b5342fa4fc5234ed13d611424fd61ddcf591059be099366682769\",\"quote\":\"(1) The organizer must illuminate every public exit throughout the time the display remains open.\",\"start\":232}],\"id\":\"urn:rulespec:document-understanding:revision:6d11cf3d6a8ddb23adfbbb9d6e2e102b75e4745f3d7119b94c12499914139b5d\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"statement\",\"logic_text\":\"(c) For displays held entirely before sunset, the organizer should place a readable map near the entrance. This recommendation does not create a duty to illuminate exits after sunset.\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:a8085825d2291f430da99bde0286231088a1d871bfbbd5933ea03fb254f26ff8\",\"modality\":\"not_stated\",\"modality_quote\":\"\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:b76712fc16fcf7a215b4eccea44e8180bbb26e47febd02e69f641681a7947cec\",\"origin\":\"aiSuggested\",\"quote\":\"(c) For displays held entirely before sunset, the organizer should place a readable map near the entrance. This recommendation does not create a duty to illuminate exits after sunset.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:55a8c75d5cbffbc403fe44a599bad16b416c5ad5ebac70fcb7bb06fa264f97b1\",\"scope_quotes\":[\"(c) For displays held entirely before sunset, the organizer should place a readable map near the entrance. This recommendation does not create a duty to illuminate exits after sunset.\"],\"scope_text\":\"For displays held entirely before sunset.\",\"section_id\":\"section-1\",\"start\":1557,\"summary\":\"The recommendation to place a readable map near the entrance for displays held entirely before sunset does not create a duty to illuminate exits after sunset.\",\"target_ids\":[],\"typed_values\":[]}",

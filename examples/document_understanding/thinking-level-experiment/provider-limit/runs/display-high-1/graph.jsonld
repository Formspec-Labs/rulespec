      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:7c657913deb66a595d7acae8f3210cbb4c81eaf93f9168a5e3d8fce21ff4e38b\",\"urn:rulespec:document-understanding:assertion:451818805c93bb6a61f6804c5a2ecedecbd8d2c79d840c181d51b70898f11188\",\"urn:rulespec:document-understanding:assertion:720e1b3c7c3e627082a36219a4ee25c3dea454fe060f393ebb512dcc9e598dad\",\"urn:rulespec:document-understanding:assertion:69b94c16d6117b2680d3591f8a31c81012481021e36a317d4b33964b7a377baf\",\"urn:rulespec:document-understanding:assertion:5c11af19439b7412a9d4a0c54fbc5c85829f0556d6838e629fe7ecefc41424a9\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"effective_periods\":[],\"end\":1032,\"evidence\":[{\"end\":1032,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Acd1d2d681c56417058e5883c90b99d7d8c562af40621c5b8e3d3b614540154d5:756:1032:sha256-3934718a22f833f138629ffb5bab45a2b2f01847a57e012596d11a7b70c44c19\",\"quote\":\"(4) Before admitting the first visitor, the organizer must give the agency either a signed paper inspection record or an electronic inspection record signed by the inspecting officer. Each record must identify the display, the inspection date, and every public exit inspected.\",\"start\":756},{\"end\":1032,\"field\":\"logic_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Acd1d2d681c56417058e5883c90b99d7d8c562af40621c5b8e3d3b614540154d5:756:1032:sha256-3934718a22f833f138629ffb5bab45a2b2f01847a57e012596d11a7b70c44c19\",\"quote\":\"(4) Before admitting the first visitor, the organizer must give the agency either a signed paper inspection record or an electronic inspection record signed by the inspecting officer. Each record must identify the display, the inspection date, and every public exit inspected.\",\"start\":756},{\"end\":230,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Acd1d2d681c56417058e5883c90b99d7d8c562af40621c5b8e3d3b614540154d5:91:230:sha256-b6abd80d117b4b566300972de823d7857c2472c21cbd8866fece15a96eef055f\",\"quote\":\"(a) For a temporary display open to the public after sunset on agency premises, the organizer must satisfy all of the following conditions:\",\"start\":91},{\"end\":1032,\"field\":\"scope_text:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Acd1d2d681c56417058e5883c90b99d7d8c562af40621c5b8e3d3b614540154d5:756:1032:sha256-3934718a22f833f138629ffb5bab45a2b2f01847a57e012596d11a7b70c44c19\",\"quote\":\"(4) Before admitting the first visitor, the organizer must give the agency either a signed paper inspection record or an electronic inspection record signed by the inspecting officer. Each record must identify the display, the inspection date, and every public exit inspected.\",\"start\":756}],\"id\":\"urn:rulespec:document-understanding:revision:2040f19472ebf14999aa6b07ab138e8b8bbddb2b9c70d6b4591e35c68ac71a62\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"(4) Before admitting the first visitor, the organizer must give the agency either a signed paper inspection record or an electronic inspection record signed by the inspecting officer. Each record must identify the display, the inspection date, and every public exit inspected.\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:5c11af19439b7412a9d4a0c54fbc5c85829f0556d6838e629fe7ecefc41424a9\",\"modality\":\"must\",\"modality_quote\":\"must\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:03cdf87ad901f495c599a3e4997d8d5a123dbd659f97a18cd3300615933ff09d\",\"origin\":\"aiSuggested\",\"quote\":\"(4) Before admitting the first visitor, the organizer must give the agency either a signed paper inspection record or an electronic inspection record signed by the inspecting officer. Each record must identify the display, the inspection date, and every public exit inspected.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:895110b8b0ebd79c67331c8b450038fa74ed4efeee8eaf80f5dd0b207374137f\",\"scope_quotes\":[\"(a) For a temporary display open to the public after sunset on agency premises, the organizer must satisfy all of the following conditions:\",\"(4) Before admitting the first visitor, the organizer must give the agency either a signed paper inspection record or an electronic inspection record signed by the inspecting officer. Each record must identify the display, the inspection date, and every public exit inspected.\"],\"scope_text\":\"For a temporary display open to the public after sunset on agency premises.\",\"section_id\":\"section-1\",\"start\":756,\"summary\":\"For a temporary display open to the public after sunset on agency premises, each inspection record given to the agency must identify the display, the inspection date, and every public exit inspected.\",\"target_ids\":[],\"typed_values\":[]}",

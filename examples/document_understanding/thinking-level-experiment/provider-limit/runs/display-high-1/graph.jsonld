      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:580f2111721d896efcf16a17883c92bb217d8182c4782315f152a658c39a6704\",\"urn:rulespec:document-understanding:assertion:af3961461e1ff49eb1a89ecd4bebb1406c9a1e852d917dcbf5719e36d74b52f0\",\"urn:rulespec:document-understanding:assertion:ebb563a3f55708feb0240ed79cf4b709a225fcac299c7dafb7d711bbb9e01b07\",\"urn:rulespec:document-understanding:assertion:cbbf33cc21f831b5dd125540b69304904e64d55651a1beea33972048791ab404\",\"urn:rulespec:document-understanding:assertion:d05f85fd5a181f6e1c511dc97bf19b1634d3d0bbd84283d8536471e4b97ecf42\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"effective_periods\":[],\"end\":2029,\"evidence\":[{\"end\":2029,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Acd1d2d681c56417058e5883c90b99d7d8c562af40621c5b8e3d3b614540154d5:1742:2029:sha256-7103367673d0bf063011ffb987e1452cfbb156651058333a98ee69febabca7fb\",\"quote\":\"(d) The organizer must retain each inspection record for at least 30 calendar days after the display closes. Weekends and holidays count toward the 30 days. If an investigation is open when that period ends, the organizer must retain the record until the agency closes the investigation.\",\"start\":1742},{\"end\":2029,\"field\":\"logic_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Acd1d2d681c56417058e5883c90b99d7d8c562af40621c5b8e3d3b614540154d5:1742:2029:sha256-7103367673d0bf063011ffb987e1452cfbb156651058333a98ee69febabca7fb\",\"quote\":\"(d) The organizer must retain each inspection record for at least 30 calendar days after the display closes. Weekends and holidays count toward the 30 days. If an investigation is open when that period ends, the organizer must retain the record until the agency closes the investigation.\",\"start\":1742},{\"end\":2029,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Acd1d2d681c56417058e5883c90b99d7d8c562af40621c5b8e3d3b614540154d5:1742:2029:sha256-7103367673d0bf063011ffb987e1452cfbb156651058333a98ee69febabca7fb\",\"quote\":\"(d) The organizer must retain each inspection record for at least 30 calendar days after the display closes. Weekends and holidays count toward the 30 days. If an investigation is open when that period ends, the organizer must retain the record until the agency closes the investigation.\",\"start\":1742}],\"id\":\"urn:rulespec:document-understanding:revision:6250e841b7f61eb0efe198e71e236abc88cc4d9387381691fcf256af1b507536\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"(d) The organizer must retain each inspection record for at least 30 calendar days after the display closes. Weekends and holidays count toward the 30 days. If an investigation is open when that period ends, the organizer must retain the record until the agency closes the investigation.\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:d05f85fd5a181f6e1c511dc97bf19b1634d3d0bbd84283d8536471e4b97ecf42\",\"modality\":\"must\",\"modality_quote\":\"must\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:6d277f3b16a002fc109d60583174e3a81dc1367004e1ebd22b62facb729f3bab\",\"origin\":\"aiSuggested\",\"quote\":\"(d) The organizer must retain each inspection record for at least 30 calendar days after the display closes. Weekends and holidays count toward the 30 days. If an investigation is open when that period ends, the organizer must retain the record until the agency closes the investigation.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:a7043fb25372f0bcde2877b446d786f6b18fc211acca0fe0f6257b877ac348a4\",\"scope_quotes\":[\"(d) The organizer must retain each inspection record for at least 30 calendar days after the display closes. Weekends and holidays count toward the 30 days. If an investigation is open when that period ends, the organizer must retain the record until the agency closes the investigation.\"],\"scope_text\":\"After a display closes.\",\"section_id\":\"section-1\",\"start\":1742,\"summary\":\"The organizer must retain each inspection record for at least 30 calendar days after the display closes, and weekends and holidays count toward the 30 days.\",\"target_ids\":[],\"typed_values\":[]}",

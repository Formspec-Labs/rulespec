    {
      "@id": "urn:rulespec:document-understanding:assertion:069d950ff2f70ff3809d9afee9a9edc143ccb039e70fa3f87f3857fef495db1b",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:25df06faf61b81fbd5834618985f445d1050ca9b440dce155e822e9afc8d29f0",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:2c980de7f78990881e5f08631671d2db0aea958c1fcd0fd36c5daf07d56f5bec",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:e9ddc3df509da4838517365b9886f553fcd2acac8bf88f3196f510b865a85c43",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:states-requirement",
      "rkaf:assertsValue": {
        "@value": "For a temporary display open to the public after sunset on agency premises, the organizer must satisfy all of the following conditions: illuminate every public exit throughout the time the display remains open; keep every public exit clear throughout the time the display remains open; appoint an adult steward who remains on site throughout the time the display remains open (unless an agency employee is assigned to supervise the display for that entire period); and, before admitting the first visitor, give the agency either a signed paper inspection record or an electronic inspection record signed by the inspecting officer, identifying the display, the inspection date, and every public exit inspected.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

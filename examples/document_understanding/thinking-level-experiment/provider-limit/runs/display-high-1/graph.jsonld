        "oa:TextQuoteSelector",
        "oa:TextPositionSelector"
      ],
      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "(4) Before admitting the first visitor, the organizer must give the agency either a signed paper inspection record or an electronic inspection record signed by the inspecting officer. Each record must identify the display, the inspection date, and every public exit inspected."
        },
        {
          "@type": "oa:TextPositionSelector",
          "oa:start": 756,
          "oa:end": 1032,
          "rkaf:coordinateSystem": "rkaf:unicode-codepoint"
        }
      ]

      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:063c4f876d5c262a5076bb313fea2c76906a904b658650ac9069f71b8b4cb7f5\",\"urn:rulespec:document-understanding:assertion:57079bbab66c6ce96d2f7173e7f528f3ca6856b5d8ada448c7f9fca1c7e8e17d\",\"urn:rulespec:document-understanding:assertion:f80f974678cb1acb127e2d7ac71874b37514be396ce24615013a134872a19a87\",\"urn:rulespec:document-understanding:assertion:13304bc7d65ae7bfdde86ca40f3d661bcb0d1c9b7358552dce29121003b08086\",\"urn:rulespec:document-understanding:assertion:7b60d20387592ed32edbd5cd34ffcf0485a23d44d9808f91c94ee29a75501b20\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"effective_periods\":[],\"end\":1555,\"evidence\":[{\"end\":1555,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Acd1d2d681c56417058e5883c90b99d7d8c562af40621c5b8e3d3b614540154d5:1354:1555:sha256-76f262896325f8478b95b626857500a006e07a2d4c8aadb8f712cb7a7c69a7c9\",\"quote\":\"(3) An agency officer authorizes the demonstration for the duration of the current warning. The authorization expires when that warning ends; it does not authorize demonstrations under a later warning.\",\"start\":1354},{\"end\":1555,\"field\":\"logic_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Acd1d2d681c56417058e5883c90b99d7d8c562af40621c5b8e3d3b614540154d5:1354:1555:sha256-76f262896325f8478b95b626857500a006e07a2d4c8aadb8f712cb7a7c69a7c9\",\"quote\":\"(3) An agency officer authorizes the demonstration for the duration of the current warning. The authorization expires when that warning ends; it does not authorize demonstrations under a later warning.\",\"start\":1354},{\"end\":1167,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Acd1d2d681c56417058e5883c90b99d7d8c562af40621c5b8e3d3b614540154d5:1034:1167:sha256-e9b094caa665823399068cbaa95843ab925afb1fd087cd1d36da3154a6090129\",\"quote\":\"(b) When a storm warning is active, the organizer must suspend outdoor demonstrations unless all of the following conditions are met:\",\"start\":1034},{\"end\":1555,\"field\":\"scope_text:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Acd1d2d681c56417058e5883c90b99d7d8c562af40621c5b8e3d3b614540154d5:1354:1555:sha256-76f262896325f8478b95b626857500a006e07a2d4c8aadb8f712cb7a7c69a7c9\",\"quote\":\"(3) An agency officer authorizes the demonstration for the duration of the current warning. The authorization expires when that warning ends; it does not authorize demonstrations under a later warning.\",\"start\":1354}],\"id\":\"urn:rulespec:document-understanding:revision:0fbe9276e925e2ce5b5fe4d29033240b901a273a7109751320771eeb6cec0878\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"statement\",\"logic_text\":\"(3) An agency officer authorizes the demonstration for the duration of the current warning. The authorization expires when that warning ends; it does not authorize demonstrations under a later warning.\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:7b60d20387592ed32edbd5cd34ffcf0485a23d44d9808f91c94ee29a75501b20\",\"modality\":\"not_stated\",\"modality_quote\":\"\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:d0f08aac246df332c1b07df760d8e059a9c9bbfc73f440b48e06d65cba6d42fb\",\"origin\":\"aiSuggested\",\"quote\":\"(3) An agency officer authorizes the demonstration for the duration of the current warning. The authorization expires when that warning ends; it does not authorize demonstrations under a later warning.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:2fd036bbc53ccdbfe5ce677468cada84b7c5f1af387bbd98c42bc18dacfd1cb6\",\"scope_quotes\":[\"(b) When a storm warning is active, the organizer must suspend outdoor demonstrations unless all of the following conditions are met:\",\"(3) An agency officer authorizes the demonstration for the duration of the current warning. The authorization expires when that warning ends; it does not authorize demonstrations under a later warning.\"],\"scope_text\":\"When an agency officer authorizes an outdoor demonstration for the duration of an active storm warning.\",\"section_id\":\"section-1\",\"start\":1354,\"summary\":\"An authorization granted by an agency officer for an outdoor demonstration during a storm warning expires when that warning ends, and it does not authorize demonstrations under a later warning.\",\"target_ids\":[],\"typed_values\":[]}",

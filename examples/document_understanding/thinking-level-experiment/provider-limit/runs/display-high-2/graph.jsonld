      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:b5792cf2b74fb01964bd03147fe0e7bbd6cf609df53e4af2511af3bc455ab511",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:637c52dc747bbdfcfe2a9b0d02cb47afc2a168595bc69b068e05ad381868f393",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:c185ce3933f3711246223219c980094fb1cdad851c6e34e518eef7e04e247da2",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:states-requirement",
      "rkaf:assertsValue": {
        "@value": "For a temporary display open to the public after sunset on agency premises, the organizer must satisfy all of the following conditions: illuminate every public exit throughout the time the display remains open, keep every public exit clear throughout the time the display remains open, appoint an adult steward who remains on site throughout the time the display remains open (except when an agency employee is assigned to supervise the display for that entire period), and before admitting the first visitor, give the agency either a signed paper inspection record or an electronic inspection record signed by the inspecting officer.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },
    {

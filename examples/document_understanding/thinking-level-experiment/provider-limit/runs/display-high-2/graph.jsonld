      "rkaf:assertsValue": {
        "@value": "For a temporary display open to the public after sunset on agency premises, the organizer must appoint an adult steward who remains on site throughout the time the display remains open; this appointment duty does not apply when an agency employee is assigned to supervise the display for that entire period.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

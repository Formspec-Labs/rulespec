0621c5b8e3d3b614540154d5:1557:1740:sha256-790b8c74af5f59d2bc58d9383788c0a7e1ed84629ef0907b749b0bb47b54d41f\",\"quote\":\"(c) For displays held entirely before sunset, the organizer should place a readable map near the entrance. This recommendation does not create a duty to illuminate exits after sunset.\",\"start\":1557}],\"id\":\"urn:rulespec:document-understanding:revision:81da8338e7bd9e246ebd6deae410b3347c4cf649eebd6fb06058b9cd3aceeabd\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"statement\",\"logic_text\":\"(c) For displays held entirely before sunset, the organizer should place a readable map near the entrance. This recommendation does not create a duty to illuminate exits after sunset.\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:a45938a2dde14d5c8033091343b24e7c1eb6679d8d7b5d1ae628347d0dafcf9c\",\"modality\":\"not_stated\",\"modality_quote\":\"\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:09ffa0111903980772a36709e9f7b7b1aeabd1dc5d783346de43e4d57a45b169\",\"origin\":\"aiSuggested\",\"quote\":\"(c) For displays held entirely before sunset, the organizer should place a readable map near the entrance. This recommendation does not create a duty to illuminate exits after sunset.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:21b427dcbdfa9d6ef0a25d3610cf5be67f0f0523e16598ba6a3dd720c144e614\",\"scope_quotes\":[\"(c) For displays held entirely before sunset, the organizer should place a readable map near the entrance. This recommendation does not create a duty to illuminate exits after sunset.\"],\"scope_text\":\"For displays held entirely before sunset where the organizer is recommended to place a readable map near the entrance.\",\"section_id\":\"section-1\",\"start\":1557,\"summary\":\"The recommendation to place a readable map near the entrance for displays held entirely before sunset does not create a duty to illuminate exits after sunset.\",\"target_ids\":[],\"typed_values\":[]}",

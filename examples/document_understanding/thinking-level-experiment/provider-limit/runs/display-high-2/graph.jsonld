    {
      "@id": "urn:rulespec:document-understanding:assertion:97608fc8ef9aaf839a94603eae936a1d76ec4a2c7be515af7cae49a15e76d046",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:b5792cf2b74fb01964bd03147fe0e7bbd6cf609df53e4af2511af3bc455ab511",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:637c52dc747bbdfcfe2a9b0d02cb47afc2a168595bc69b068e05ad381868f393",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:c2359077ab09ee8ef83f2092779c47418df07a4b8351b81e8b207407a64aa46d",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[\"(1) The demonstration takes place beneath a fixed roof.\",\"(2) The agency has measured wind speed below 20 kilometers per hour at the demonstration site within the preceding 10 minutes.\",\"(3) An agency officer authorizes the demonstration for the duration of the current warning. The authorization expires when that warning ends; it does not authorize demonstrations under a later warning.\"],\"choice_text\":\"All of the following conditions must be met: (1) the demonstration takes place beneath a fixed roof; (2) the agency has measured wind speed below 20 kilometers per hour at the demonstration site within the preceding 10 minutes; and (3) an agency officer authorizes the demonstration for the duration of the current warning.\",\"claimants\":[],\"concepts\":[],\"effective_periods\":[],\"jurisdiction\":\"\",\"kind\":\"requirement\",\"logic_text\":\"(b) When a storm warning is active, the organizer must suspend outdoor demonstrations unless all of the following conditions are met:\\n\\n(1) The demonstration takes place beneath a fixed roof.\\n\\n(2) The agency has measured wind speed below 20 kilometers per hour at the demonstration site within the preceding 10 minutes.\\n\\n(3) An agency officer authorizes the demonstration for the duration of the current warning. The authorization expires when that warning ends; it does not authorize demonstrations under a later warning.\",\"modality\":\"must\",\"object\":\"\",\"scope_text\":\"When a storm warning is active, unless all of the following conditions are met: (1) the demonstration takes place beneath a fixed roof; (2) the agency has measured wind speed below 20 kilometers per hour at the demonstration site within the preceding 10 minutes; and (3) an agency officer authorizes the demonstration for the duration of the current warning.\",\"summary\":\"When a storm warning is active, the organizer must suspend outdoor demonstrations unless all of the following conditions are met: the demonstration takes place beneath a fixed roof, the agency has measured wind speed below 20 kilometers per hour at the demonstration site within the preceding 10 minutes, and an agency officer authorizes the demonstration for the duration of the current warning.\",\"typed_values\":[]}",
        "@type": "xsd:string"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed",
      "rkaf:hasApplicability": "urn:rulespec:document-understanding:scope:8008e01cb3bc9c29ff5246b6c739c79e5f8890b415ee996c1af6f2a7508eef62"
    },

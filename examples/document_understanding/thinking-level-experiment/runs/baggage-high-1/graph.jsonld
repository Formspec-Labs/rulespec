    {
      "@id": "urn:rulespec:document-understanding:assertion:aa8d6764eb4d53cc51c5f80d08774127512a59ee14a3d7c723a12644d99931d3",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:262a1d1ed1d9f3c24435f3acf3be6725f9b4615111a63ba3639bca348e424ac4",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:b44c8bb7e2042ca93bb18dcf3226d5285e90983811292b110f4bd7661df4fa8e",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:dfc13898857cd2190d741bcbab6c37c0f22e275339a1921b7a3e07e4333423ce",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:logic_text",
      "rkaf:assertsValue": {
        "@value": "(2) Any unloaded firearm(s) unless—\n\n(i) The passenger declares to the aircraft operator, either orally or in writing, before checking the baggage, that the passenger has a firearm in his or her bag and that it is unloaded;\n\n(ii) The firearm is unloaded;\n\n(iii) The firearm is carried in a hard-sided container; and\n\n(iv) The container in which it is carried is locked, and only the passenger retains the key or combination.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

    {
      "@id": "urn:rulespec:document-understanding:assertion:783b4d3fe414d1207312c8201ec32e7b641ec3d19112e5bcffce12d74000a764",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:262a1d1ed1d9f3c24435f3acf3be6725f9b4615111a63ba3639bca348e424ac4",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:b44c8bb7e2042ca93bb18dcf3226d5285e90983811292b110f4bd7661df4fa8e",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:c30c9f5fc7e3c242d7bfdd1e44e7dce68ce9f946cca40d3015ec5b27d75932a2",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[\"(1) When performance has begun of the inspection of the individual's person or accessible property before entering a sterile area, or before boarding an aircraft for which screening is conducted under this subchapter;\",\"(2) When the individual is entering or in a sterile area; or\",\"(3) When the individual is attempting to board or onboard an aircraft for which screening is conducted under §§ 1544.201, 1546.201, or 1562.23 of this chapter.\"],\"choice_text\":\"The prohibition applies in any of three alternative situations: (1) when performance of inspection has begun before entering a sterile area or boarding an aircraft screened under this subchapter; (2) when entering or in a sterile area; or (3) when attempting to board or onboard an aircraft screened under §§ 1544.201, 1546.201, or 1562.23.\",\"claimants\":[],\"concepts\":[],\"effective_periods\":[],\"jurisdiction\":\"\",\"kind\":\"prohibition\",\"logic_text\":\"(a) On an individual's person or accessible property—prohibitions. Except as provided in paragraph (b) of this section, an individual may not have a weapon, explosive, or incendiary, on or about the individual's person or accessible property—\\n\\n(1) When performance has begun of the inspection of the individual's person or accessible property before entering a sterile area, or before boarding an aircraft for which screening is conducted under this subchapter;\\n\\n(2) When the individual is entering or in a sterile area; or\\n\\n(3) When the individual is attempting to board or onboard an aircraft for which screening is conducted under §§ 1544.201, 1546.201, or 1562.23 of this chapter.\",\"modality\":\"must_not\",\"object\":\"\",\"scope_text\":\"Applies except as provided in paragraph (b) of this section: (1) when performance has begun of the inspection of the individual's person or accessible property before entering a sterile area, or before boarding an aircraft for which screening is conducted under this subchapter; (2) when the individual is entering or in a sterile area; or (3) when the individual is attempting to board or onboard an aircraft for which screening is conducted under §§ 1544.201, 1546.201, or 1562.23 of this chapter.\",\"summary\":\"Except as provided in paragraph (b) of this section, an individual may not have a weapon, explosive, or incendiary on or about the individual's person or accessible property when performance has begun of the inspection of the individual's person or accessible property before entering a sterile area or before boarding an aircraft for which screening is conducted under this subchapter, when entering or in a sterile area, or when attempting to board or onboard an aircraft for which screening is conducted under §§ 1544.201, 1546.201, or 1562.23 of this chapter.\",\"typed_values\":[]}",
        "@type": "xsd:string"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed",
      "rkaf:hasApplicability": "urn:rulespec:document-understanding:scope:d85638abc8e156a1a2e562f388659d2a8df26155e176116bf7100f9b271348ca"
    },

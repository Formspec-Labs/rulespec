    {
      "@id": "urn:rulespec:document-understanding:revision:da6280da0dc629c6093c60ae80d7bcd964a575bc03ee9005480a8e6ada9be5a6",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:da6280da0dc629c6093c60ae80d7bcd964a575bc03ee9005480a8e6ada9be5a6",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:15616c77ce6f1ada0265b3bc0db7c84ae9b822cb9b534f4798d42082f55a9b41",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[\"(i) The passenger declares to the aircraft operator, either orally or in writing, before checking the baggage, that the passenger has a firearm in his or her bag and that it is unloaded;\",\"(ii) The firearm is unloaded;\",\"(iii) The firearm is carried in a hard-sided container; and\",\"(iv) The container in which it is carried is locked, and only the passenger retains the key or combination.\"],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:075ea8cd7eca9efe262ec6a0766f853da328df684b1b55daf21fc098effe06b3\",\"urn:rulespec:document-understanding:assertion:aa8d6764eb4d53cc51c5f80d08774127512a59ee14a3d7c723a12644d99931d3\",\"urn:rulespec:document-understanding:assertion:dbb36e1304d21455d14828e544fe816b92c66b97179abc10a069a8b0ce4b02cb\",\"urn:rulespec:document-understanding:assertion:2e96fefca18485389f12c0c801d7ec710698c5f275ed7add98a416f0a49eb64a\",\"urn:rulespec:document-understanding:assertion:36d5d47e9af5736de8a2b116007d4e5fe6fc47398b68bada1d441efcbf42c40b\",\"urn:rulespec:document-understanding:assertion:da497a31fd97493dc0a237030853528698b8cdda43b675f265a486ebe78c2b8f\",\"urn:rulespec:document-understanding:assertion:b7936503f017cb0ac7db45eeaff2c56c071ea9281c66e8e3346c96e6f1dff9d6\",\"urn:rulespec:document-understanding:assertion:9cf6988298d972186513df1ef2a6d2452ff9a573c9ef9b19be5af321735868e8\",\"urn:rulespec:document-understanding:assertion:53d4fa2a6d7028cdce6efe952c6e9b3d29bcbe140228d05b81ce6b14686505e2\",\"urn:rulespec:document-understanding:assertion:aeadf3c18bd17b846589f4fcb1a04b6faab0e190eff109cb5b7eb71fc9924cd7\"],\"choice_quote\":\"(i) The passenger declares to the aircraft operator, either orally or in writing, before checking the baggage, that the passenger has a firearm in his or her bag and that it is unloaded;\",\"choice_text\":\"The declaration to the aircraft operator may be made either orally or in writing.\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"effective_periods\":[],\"end\":1621,\"evidence\":[{\"end\":1621,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aab45ff8a7d213a548ba64b9bd9efdd9202dcd2f94cc0c1045a1b5fb69fe86460:1586:1621:sha256-a03b234b39a7e3d902b46246302bd2c0d5986a277e51dcd12feeb18f5483f16c\",\"quote\":\"(2) Any unloaded firearm(s) unless—\",\"start\":1586},{\"end\":2010,\"field\":\"logic_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aab45ff8a7d213a548ba64b9bd9efdd9202dcd2f94cc0c1045a1b5fb69fe86460:1586:2010:sha256-55445821b85174dd35baccbe029635bc4b535d4c2fb27e8faef334a78e47a106\",\"quote\":\"(2) Any unloaded firearm(s) unless—\\n\\n(i) The passenger declares to the aircraft operator, either orally or in writing, before checking the baggage, that the passenger has a firearm in his or her bag and that it is unloaded;\\n\\n(ii) The firearm is unloaded;\\n\\n(iii) The firearm is carried in a hard-sided container; and\\n\\n(iv) The container in which it is carried is locked, and only the passenger retains the key or combination.\",\"start\":1586},{\"end\":1809,\"field\":\"choice_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aab45ff8a7d213a548ba64b9bd9efdd9202dcd2f94cc0c1045a1b5fb69fe86460:1623:1809:sha256-f6fe03740da837c967d5e1a19cc83bd62f4517d0b086d968201a40859ccf0a16\",\"quote\":\"(i) The passenger declares to the aircraft operator, either orally or in writing, before checking the baggage, that the passenger has a firearm in his or her bag and that it is unloaded;\",\"start\":1623},{\"end\":1556,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aab45ff8a7d213a548ba64b9bd9efdd9202dcd2f94cc0c1045a1b5fb69fe86460:1376:1556:sha256-9dd5c9d0feb251838bff5c1a16b3c099ef083ecc7b0fca10625f4c8d5699fdf1\",\"quote\":\"(c) In checked baggage. A passenger may not transport or offer for transport in checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter:\",\"start\":1376},{\"end\":2010,\"field\":\"scope_text:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aab45ff8a7d213a548ba64b9bd9efdd9202dcd2f94cc0c1045a1b5fb69fe86460:1586:2010:sha256-55445821b85174dd35baccbe029635bc4b535d4c2fb27e8faef334a78e47a106\",\"quote\":\"(2) Any unloaded firearm(s) unless—\\n\\n(i) The passenger declares to the aircraft operator, either orally or in writing, before checking the baggage, that the passenger has a firearm in his or her bag and that it is unloaded;\\n\\n(ii) The firearm is unloaded;\\n\\n(iii) The firearm is carried in a hard-sided container; and\\n\\n(iv) The container in which it is carried is locked, and only the passenger retains the key or combination.\",\"start\":1586},{\"end\":1809,\"field\":\"alternative:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aab45ff8a7d213a548ba64b9bd9efdd9202dcd2f94cc0c1045a1b5fb69fe86460:1623:1809:sha256-f6fe03740da837c967d5e1a19cc83bd62f4517d0b086d968201a40859ccf0a16\",\"quote\":\"(i) The passenger declares to the aircraft operator, either orally or in writing, before checking the baggage, that the passenger has a firearm in his or her bag and that it is unloaded;\",\"start\":1623},{\"end\":1840,\"field\":\"alternative:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aab45ff8a7d213a548ba64b9bd9efdd9202dcd2f94cc0c1045a1b5fb69fe86460:1811:1840:sha256-728d008fcfc79639161d8c2b1d0a6f86e145e04143be6ec504ef19d73771e1d6\",\"quote\":\"(ii) The firearm is unloaded;\",\"start\":1811},{\"end\":1901,\"field\":\"alternative:2\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aab45ff8a7d213a548ba64b9bd9efdd9202dcd2f94cc0c1045a1b5fb69fe86460:1842:1901:sha256-e6a871e22fdb4f04a0b00e20075aa0b5b737e6d1cb0fd25f4f29d5a90551bd62\",\"quote\":\"(iii) The firearm is carried in a hard-sided container; and\",\"start\":1842},{\"end\":2010,\"field\":\"alternative:3\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aab45ff8a7d213a548ba64b9bd9efdd9202dcd2f94cc0c1045a1b5fb69fe86460:1903:2010:sha256-8522eb345b969daa7d941fb54eecd07d2803856ad5eac836d5b26f452a52a60f\",\"quote\":\"(iv) The container in which it is carried is locked, and only the passenger retains the key or combination.\",\"start\":1903}],\"id\":\"urn:rulespec:document-understanding:revision:da6280da0dc629c6093c60ae80d7bcd964a575bc03ee9005480a8e6ada9be5a6\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"prohibition\",\"logic_text\":\"(2) Any unloaded firearm(s) unless—\\n\\n(i) The passenger declares to the aircraft operator, either orally or in writing, before checking the baggage, that the passenger has a firearm in his or her bag and that it is unloaded;\\n\\n(ii) The firearm is unloaded;\\n\\n(iii) The firearm is carried in a hard-sided container; and\\n\\n(iv) The container in which it is carried is locked, and only the passenger retains the key or combination.\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:aeadf3c18bd17b846589f4fcb1a04b6faab0e190eff109cb5b7eb71fc9924cd7\",\"modality\":\"must_not\",\"modality_quote\":\"may not\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:0d967d59cdc2311fbd7c86c881b950b1cf9ea96e01c75f5e1a0aaa1fe5d5e5e6\",\"origin\":\"aiSuggested\",\"quote\":\"(2) Any unloaded firearm(s) unless—\",\"references\":[\"§ 1562.23\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:dfc13898857cd2190d741bcbab6c37c0f22e275339a1921b7a3e07e4333423ce\",\"scope_quotes\":[\"(c) In checked baggage. A passenger may not transport or offer for transport in checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter:\",\"(2) Any unloaded firearm(s) unless—\\n\\n(i) The passenger declares to the aircraft operator, either orally or in writing, before checking the baggage, that the passenger has a firearm in his or her bag and that it is unloaded;\\n\\n(ii) The firearm is unloaded;\\n\\n(iii) The firearm is carried in a hard-sided container; and\\n\\n(iv) The container in which it is carried is locked, and only the passenger retains the key or combination.\"],\"scope_text\":\"In checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter, governing any unloaded firearm(s) unless all four declaration, condition, packaging, and locking requirements are met.\",\"section_id\":\"section-1\",\"start\":1586,\"summary\":\"A passenger may not transport or offer for transport in checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter any unloaded firearm(s) unless: (i) the passenger declares to the aircraft operator, either orally or in writing, before checking the baggage, that the passenger has a firearm in his or her bag and that it is unloaded; (ii) the firearm is unloaded; (iii) the firearm is carried in a hard-sided container; and (iv) the container in which it is carried is locked, and only the passenger retains the key or combination.\",\"target_ids\":[],\"typed_values\":[]}",

    {
      "@id": "urn:rulespec:document-understanding:scope:c35e7e1dbeb0eb050ccbbfe8a8c2c8c7305c6f1d7b249d90fc227be3031cebf5",
      "@type": "rkaf:ApplicabilityScope",
      "rkaf:appliesInJurisdiction": [],
      "rkaf:applicabilityCondition": "In checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter, governing any unloaded firearm(s) unless all four declaration, condition, packaging, and locking requirements are met."
    },
    {
      "@id": "urn:rulespec:document-understanding:assertion:075ea8cd7eca9efe262ec6a0766f853da328df684b1b55daf21fc098effe06b3",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:262a1d1ed1d9f3c24435f3acf3be6725f9b4615111a63ba3639bca348e424ac4",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:b44c8bb7e2042ca93bb18dcf3226d5285e90983811292b110f4bd7661df4fa8e",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:dfc13898857cd2190d741bcbab6c37c0f22e275339a1921b7a3e07e4333423ce",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:states-prohibition",
      "rkaf:assertsValue": {
        "@value": "A passenger may not transport or offer for transport in checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter any unloaded firearm(s) unless: (i) the passenger declares to the aircraft operator, either orally or in writing, before checking the baggage, that the passenger has a firearm in his or her bag and that it is unloaded; (ii) the firearm is unloaded; (iii) the firearm is carried in a hard-sided container; and (iv) the container in which it is carried is locked, and only the passenger retains the key or combination.",
        "@language": "en"
      },

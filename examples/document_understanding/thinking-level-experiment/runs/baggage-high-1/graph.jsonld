    {
      "@id": "urn:rulespec:document-understanding:scope:52e8dc8b029f66772b1a805f0345d0aa18865297b6c71626d5c46dffd9534bee",
      "@type": "rkaf:ApplicabilityScope",
      "rkaf:appliesInJurisdiction": [],
      "rkaf:applicabilityCondition": "Applies to carriage of firearms and other weapons on an individual's person or accessible property if the individual meets one of three specified criteria."
    },
    {

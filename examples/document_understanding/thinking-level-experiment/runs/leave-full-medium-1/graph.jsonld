      "rkaf:appliesInJurisdiction": [],
      "rkaf:applicabilityCondition": "When an employee's leave has already started, or when an employee gives notice of the need for leave."
    },
    {
      "@id": "urn:rulespec:document-understanding:assertion:e1ac79e261c9938d4c6def2edbab1fe18b21611b7294e47bb96b8d7f2ea37581",

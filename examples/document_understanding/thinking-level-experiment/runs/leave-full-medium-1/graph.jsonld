      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:f92ca017aef3096b00065892f37925ba366b31df96cc72275ab97057938442e5",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:states-definition",
      "rkaf:assertsValue": {
        "@value": "An eligible employee is an employee of a covered employer who has been employed by the employer for at least 12 months, has been employed for at least 1,250 hours of service during the 12-month period immediately preceding the commencement of the leave (subject to special hours of service requirements for airline flight crew employees in § 825.801), and is employed at a worksite where 50 or more employees are employed by the employer within 75 miles of that worksite.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:99e9a5ecb8ad32b43618416d78cee6b0eb86d7d74a47fe33974955c7c6c02498",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:states-requirement",
      "rkaf:assertsValue": {
        "@value": "Employment periods preceding a break in service of more than seven years must be counted in determining whether the employee has been employed by the employer for at least 12 months where the break in service is occasioned by the fulfillment of a USERRA-covered service obligation (and the period of absence necessitated by such service must also be counted, without providing greater entitlement than USERRA), or where a written agreement, including a collective bargaining agreement, exists concerning the employer's intention to rehire the employee after the break in service.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

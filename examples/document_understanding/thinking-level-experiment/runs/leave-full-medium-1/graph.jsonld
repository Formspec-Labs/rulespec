      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:0c5da0b0e7ec132f1e450b556482a1668c07e3460373d6c4fbbc654ac11cc879\",\"urn:rulespec:document-understanding:assertion:d9906e191c6a6da25c06179b90739ffa0a2c8006cf04ff9cb506ada6de0c7586\",\"urn:rulespec:document-understanding:assertion:9b9388dd51f3d15b26aca54d3855395d03c78f0ffc3ed895a85cfa6528f9aacf\",\"urn:rulespec:document-understanding:assertion:0503b4f5d4abaacab3454a123044933bae740dad5093e7134595dabc3683628b\",\"urn:rulespec:document-understanding:assertion:5d8b96901d7a2eda29562eafa3aa5080880b6f08b270446e55ecebb8a619e05c\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[\"29 CFR 825.110 — Eligible employee.\"],\"effective_periods\":[],\"end\":590,\"evidence\":[{\"end\":590,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa4cdfc9b75c8a1ed78c29b8a344913757e4b95198a4b069127aa9092960aaf4f:37:590:sha256-e43d03081e43a5cd56466e06b1489af91ab5a4d901b3a2068f64e68e4fa8e5dd\",\"quote\":\"(a) An eligible employee is an employee of a covered employer who:\\n\\n(1) Has been employed by the employer for at least 12 months, and\\n\\n(2) Has been employed for at least 1,250 hours of service during the 12-month period immediately preceding the commencement of the leave ( see § 825.801 for special hours of service requirements for airline flight crew employees), and\\n\\n(3) Is employed at a worksite where 50 or more employees are employed by the employer within 75 miles of that worksite. See § 825.105(b) regarding employees who work outside the U.S.\",\"start\":37},{\"end\":590,\"field\":\"logic_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa4cdfc9b75c8a1ed78c29b8a344913757e4b95198a4b069127aa9092960aaf4f:37:590:sha256-e43d03081e43a5cd56466e06b1489af91ab5a4d901b3a2068f64e68e4fa8e5dd\",\"quote\":\"(a) An eligible employee is an employee of a covered employer who:\\n\\n(1) Has been employed by the employer for at least 12 months, and\\n\\n(2) Has been employed for at least 1,250 hours of service during the 12-month period immediately preceding the commencement of the leave ( see § 825.801 for special hours of service requirements for airline flight crew employees), and\\n\\n(3) Is employed at a worksite where 50 or more employees are employed by the employer within 75 miles of that worksite. See § 825.105(b) regarding employees who work outside the U.S.\",\"start\":37},{\"end\":103,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa4cdfc9b75c8a1ed78c29b8a344913757e4b95198a4b069127aa9092960aaf4f:37:103:sha256-f65766fc8c1d9018ff7f6a685d59a802898d9b888c3de0a8c3c4756b5c8959a4\",\"quote\":\"(a) An eligible employee is an employee of a covered employer who:\",\"start\":37},{\"end\":35,\"field\":\"context:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa4cdfc9b75c8a1ed78c29b8a344913757e4b95198a4b069127aa9092960aaf4f:0:35:sha256-cdba565171941ded4034f74b1980d94e626fe3b38491ebf5285ac9ba0f59d68b\",\"quote\":\"29 CFR 825.110 — Eligible employee.\",\"start\":0}],\"id\":\"urn:rulespec:document-understanding:revision:f7a1715d0ff98d33b58feba50b986c561459acf2f7c11f227d68d6b71c254e7a\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"definition\",\"logic_text\":\"(a) An eligible employee is an employee of a covered employer who:\\n\\n(1) Has been employed by the employer for at least 12 months, and\\n\\n(2) Has been employed for at least 1,250 hours of service during the 12-month period immediately preceding the commencement of the leave ( see § 825.801 for special hours of service requirements for airline flight crew employees), and\\n\\n(3) Is employed at a worksite where 50 or more employees are employed by the employer within 75 miles of that worksite. See § 825.105(b) regarding employees who work outside the U.S.\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:5d8b96901d7a2eda29562eafa3aa5080880b6f08b270446e55ecebb8a619e05c\",\"modality\":\"not_stated\",\"modality_quote\":\"\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:98db50957c8d640a45197837aba11e9483dc4aa5879edbf5424d22e8e077a545\",\"origin\":\"aiSuggested\",\"quote\":\"(a) An eligible employee is an employee of a covered employer who:\\n\\n(1) Has been employed by the employer for at least 12 months, and\\n\\n(2) Has been employed for at least 1,250 hours of service during the 12-month period immediately preceding the commencement of the leave ( see § 825.801 for special hours of service requirements for airline flight crew employees), and\\n\\n(3) Is employed at a worksite where 50 or more employees are employed by the employer within 75 miles of that worksite. See § 825.105(b) regarding employees who work outside the U.S.\",\"references\":[\"§ 825.801\",\"§ 825.105(b)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:f92ca017aef3096b00065892f37925ba366b31df96cc72275ab97057938442e5\",\"scope_quotes\":[\"(a) An eligible employee is an employee of a covered employer who:\"],\"scope_text\":\"Applicable to an employee of a covered employer seeking status as an eligible employee.\",\"section_id\":\"section-1\",\"start\":37,\"summary\":\"An eligible employee is an employee of a covered employer who has been employed by the employer for at least 12 months, has been employed for at least 1,250 hours of service during the 12-month period immediately preceding the commencement of the leave (subject to special hours of service requirements for airline flight crew employees in § 825.801), and is employed at a worksite where 50 or more employees are employed by the employer within 75 miles of that worksite.\",\"target_ids\":[],\"typed_values\":[]}",

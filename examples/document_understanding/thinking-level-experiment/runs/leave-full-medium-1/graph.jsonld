      ],
      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "(3) Is employed at a worksite where 50 or more employees are employed by the employer within 75 miles of that worksite. See § 825.105(b) regarding employees who work outside the U.S."
        },
        {
          "@type": "oa:TextPositionSelector",
          "oa:start": 408,
          "oa:end": 590,
          "rkaf:coordinateSystem": "rkaf:unicode-codepoint"

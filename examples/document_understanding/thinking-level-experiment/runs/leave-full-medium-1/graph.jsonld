      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:states-prohibition",
      "rkaf:assertsValue": {
        "@value": "Whether 50 employees are employed within 75 miles is determined when the employee gives notice of the need for leave; once determined eligible in response to that notice, eligibility is not affected by any subsequent change in employee count within 75 miles for that specific notice, and an employer may not terminate employee leave that has already started if the employee count drops below 50.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

    {
      "@id": "urn:rulespec:document-understanding:scope:313dffa4dc5cd4084d3484d91e03819ddcfb8eda3fa3c2da8e588c7df0a1a43e",
      "@type": "rkaf:ApplicabilityScope",
      "rkaf:appliesInJurisdiction": [],
      "rkaf:applicabilityCondition": "In the event an employer does not maintain an accurate record of hours worked by an employee, including employees exempt from FLSA recordkeeping requirements."
    },
    {
      "@id": "urn:rulespec:document-understanding:assertion:28743d790b551651a4ba8bf819fa908eedee8cd958bf650dc9693e7e9a92b81b",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:e76aed5713bb4cbed3a6d3c908c2520aeabd2319b69a9d8c88a22740239ccc29",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:f700aeebd8b043eee2e34a1f892874a08d1bc68bf21238b971ca1c79783d5a10",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:f8fb42ef57c075b97d6c2dfb86be12670be22d58081d26b31db66c0bc542d34f",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:states-requirement",
      "rkaf:assertsValue": {
        "@value": "In the event an employer does not maintain an accurate record of hours worked by an employee, the employer has the burden of showing that the employee has not worked the requisite hours, and must be able to clearly demonstrate that the employee did not work 1,250 hours during the previous 12 months in order to claim that the employee is not eligible for FMLA leave.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },
    {
      "@id": "urn:rulespec:document-understanding:binding:42cb72b1448691b7765393a55b53f43596a5c5d686f3ba79b8bff1299cda289f",
      "@type": "rkaf:EvidenceBinding",
      "rkaf:bindsAssertion": "urn:rulespec:document-understanding:assertion:28743d790b551651a4ba8bf819fa908eedee8cd958bf650dc9693e7e9a92b81b",
      "rkaf:evidenceRole": "rkaf:textualEvidence",
      "rkaf:evidentiaryFunction": "rkaf:supports",
      "rkaf:bindsSourceFragment": [
        "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa4cdfc9b75c8a1ed78c29b8a344913757e4b95198a4b069127aa9092960aaf4f:4440:5368:sha256-f224bb89288a47851c4a1b3b1e2aceb37d95d77172afee44175f2f36b851f8ae"
      ]
    },
    {
      "@id": "urn:rulespec:document-understanding:binding:3e63c265ce95761553c61062b31be702f2efd61dee74725e57e1c9f32859553d",

      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:f760ae06ce53e43afe85938be653c5b4cc2032d4a8649a4987c270a4386f680f\",\"urn:rulespec:document-understanding:assertion:dab5f22f9a665bff738e4675ce90d9d83870a1ad2e885e1e1275d0185f8a6cee\",\"urn:rulespec:document-understanding:assertion:c57abd96e5258a8e89d99b35b9203beb87ce8d5280e8da094f4920c04f5cd86b\",\"urn:rulespec:document-understanding:assertion:291337e8e1a1ff365bec666164ceea95f90d80f0d8347bea81d64ea593f8b3aa\",\"urn:rulespec:document-understanding:assertion:7e3f9413f73bc98cd97515fe7320bcef270a23ffe3540e187ed4523cf9635885\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[\"(1) Has been employed by the employer for at least 12 months, and\",\"(b) The 12 months an employee must have been employed by the employer need not be consecutive months, provided\"],\"effective_periods\":[],\"end\":2417,\"evidence\":[{\"end\":2417,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa4cdfc9b75c8a1ed78c29b8a344913757e4b95198a4b069127aa9092960aaf4f:1948:2417:sha256-4048733db741ffbcee82288a3f298f4f891c683f3d1c1b543892af4f7ddc5dba\",\"quote\":\"(3) If an employee is maintained on the payroll for any part of a week, including any periods of paid or unpaid leave (sick, vacation) during which other benefits or compensation are provided by the employer (e.g., workers' compensation, group health plan benefits, etc.), the week counts as a week of employment. For purposes of determining whether intermittent/occasional/casual employment qualifies as at least 12 months, 52 weeks is deemed to be equal to 12 months.\",\"start\":1948},{\"end\":2417,\"field\":\"logic_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa4cdfc9b75c8a1ed78c29b8a344913757e4b95198a4b069127aa9092960aaf4f:1948:2417:sha256-4048733db741ffbcee82288a3f298f4f891c683f3d1c1b543892af4f7ddc5dba\",\"quote\":\"(3) If an employee is maintained on the payroll for any part of a week, including any periods of paid or unpaid leave (sick, vacation) during which other benefits or compensation are provided by the employer (e.g., workers' compensation, group health plan benefits, etc.), the week counts as a week of employment. For purposes of determining whether intermittent/occasional/casual employment qualifies as at least 12 months, 52 weeks is deemed to be equal to 12 months.\",\"start\":1948},{\"end\":2417,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa4cdfc9b75c8a1ed78c29b8a344913757e4b95198a4b069127aa9092960aaf4f:1948:2417:sha256-4048733db741ffbcee82288a3f298f4f891c683f3d1c1b543892af4f7ddc5dba\",\"quote\":\"(3) If an employee is maintained on the payroll for any part of a week, including any periods of paid or unpaid leave (sick, vacation) during which other benefits or compensation are provided by the employer (e.g., workers' compensation, group health plan benefits, etc.), the week counts as a week of employment. For purposes of determining whether intermittent/occasional/casual employment qualifies as at least 12 months, 52 weeks is deemed to be equal to 12 months.\",\"start\":1948},{\"end\":170,\"field\":\"context:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa4cdfc9b75c8a1ed78c29b8a344913757e4b95198a4b069127aa9092960aaf4f:105:170:sha256-65892c2f4a4b04b4af78de1dd2934ed6701e42ce507cd493e35ac4d9a1ba80b0\",\"quote\":\"(1) Has been employed by the employer for at least 12 months, and\",\"start\":105},{\"end\":702,\"field\":\"context:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa4cdfc9b75c8a1ed78c29b8a344913757e4b95198a4b069127aa9092960aaf4f:592:702:sha256-130832d94200d58087ab6a46024a3a10483b1b99086401c1b273635c4e31aaf3\",\"quote\":\"(b) The 12 months an employee must have been employed by the employer need not be consecutive months, provided\",\"start\":592}],\"id\":\"urn:rulespec:document-understanding:revision:039f36a982b47ac2844d9030dd137e9a8a8f5294a98c7706e5f455ad6b510caf\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"statement\",\"logic_text\":\"(3) If an employee is maintained on the payroll for any part of a week, including any periods of paid or unpaid leave (sick, vacation) during which other benefits or compensation are provided by the employer (e.g., workers' compensation, group health plan benefits, etc.), the week counts as a week of employment. For purposes of determining whether intermittent/occasional/casual employment qualifies as at least 12 months, 52 weeks is deemed to be equal to 12 months.\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:7e3f9413f73bc98cd97515fe7320bcef270a23ffe3540e187ed4523cf9635885\",\"modality\":\"not_stated\",\"modality_quote\":\"\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:775b63480bdfd4f8f8a72e0d52127b2c69ab83e5dc0d7ff5a214f93da2e8de36\",\"origin\":\"aiSuggested\",\"quote\":\"(3) If an employee is maintained on the payroll for any part of a week, including any periods of paid or unpaid leave (sick, vacation) during which other benefits or compensation are provided by the employer (e.g., workers' compensation, group health plan benefits, etc.), the week counts as a week of employment. For purposes of determining whether intermittent/occasional/casual employment qualifies as at least 12 months, 52 weeks is deemed to be equal to 12 months.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:0cc8b0c4915e1ea2038bc8c8a4e6d7f9192dfdf774307fdf77878ae6ed861f16\",\"scope_quotes\":[\"(3) If an employee is maintained on the payroll for any part of a week, including any periods of paid or unpaid leave (sick, vacation) during which other benefits or compensation are provided by the employer (e.g., workers' compensation, group health plan benefits, etc.), the week counts as a week of employment. For purposes of determining whether intermittent/occasional/casual employment qualifies as at least 12 months, 52 weeks is deemed to be equal to 12 months.\"],\"scope_text\":\"In determining weeks of employment and whether intermittent, occasional, or casual employment qualifies as at least 12 months.\",\"section_id\":\"section-1\",\"start\":1948,\"summary\":\"If an employee is maintained on the payroll for any part of a week, including any periods of paid or unpaid leave during which other benefits or compensation are provided by the employer, the week counts as a week of employment; and for determining whether intermittent, occasional, or casual employment qualifies as at least 12 months, 52 weeks is deemed to be equal to 12 months.\",\"target_ids\":[],\"typed_values\":[]}",

    {
      "@id": "urn:rulespec:document-understanding:revision:9f6260d622808cf0d40db175c8578203637de2756955d6898c3de30c48f6bb10",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:9f6260d622808cf0d40db175c8578203637de2756955d6898c3de30c48f6bb10",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",

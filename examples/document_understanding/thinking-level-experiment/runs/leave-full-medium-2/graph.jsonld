      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:5ce1669f93904fad3feb9e4049e1f69462332b561433669712e6c9ba690bbb4d",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:6f9c0330bf16e4a9dbee654d6a46eae4b15e811059709e1e7cf8ca15aa02c20a",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:c5e978eeec0bc45ecf812abbffb021d20c6e4763c01739ad49addd300a7a5b10",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:alternative:2",
      "rkaf:assertsValue": {
        "@value": "(3) Is employed at a worksite where 50 or more employees are employed by the employer within 75 miles of that worksite. See § 825.105(b) regarding employees who work outside the U.S.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"

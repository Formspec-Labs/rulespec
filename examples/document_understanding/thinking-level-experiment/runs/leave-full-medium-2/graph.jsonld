    {
      "@id": "urn:rulespec:document-understanding:revision:320fefa3140b8a4e50df23973781771bbb08d755de3f11fec82197ac7d8c209c",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:320fefa3140b8a4e50df23973781771bbb08d755de3f11fec82197ac7d8c209c",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:b188b6b0b60d8078123a9ebc34f2e581237e40d66c0ed20c3070e8cdfd44e927",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:f18d95590ceeb6c3fbe0149e0375dcf2bf64ebcf5736334d22d314bedd79148e\",\"urn:rulespec:document-understanding:assertion:a048af27a3620cd7b91d59ff8e8a1debe6bf8742a3cfc31b2f699e43094174fd\",\"urn:rulespec:document-understanding:assertion:598bfd54e7cce9de285b73d90a585924b72afb4f69376888f6a02027db72b9a9\",\"urn:rulespec:document-understanding:assertion:470f1b5c00ae79b217e380e981159f9936a3dd3a400ce23e0f72bc4f5076108d\",\"urn:rulespec:document-understanding:assertion:c6fc41507ffa52d7ca4be8aa874144f25d4aa59d46d5b5de493e1048f439df46\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[\"(2) Employment periods preceding a break in service of more than seven years must be counted in determining whether the employee has been employed by the employer for at least 12 months where:\\n\\n(i) The employee's break in service is occasioned by the fulfillment of his or her Uniformed Services Employment and Reemployment Rights Act (USERRA), 38 U.S.C. 4301, et seq., covered service obligation. The period of absence from work due to or necessitated by USERRA-covered service must be also counted in determining whether the employee has been employed for at least 12 months by the employer. However, this section does not provide any greater entitlement to the employee than would be available under the USERRA; or\\n\\n(ii) A written agreement, including a collective bargaining agreement, exists concerning the employer's intention to rehire the employee after the break in service (e.g., for purposes of the employee furthering his or her education or for childrearing purposes).\"],\"effective_periods\":[],\"end\":963,\"evidence\":[{\"end\":963,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa4cdfc9b75c8a1ed78c29b8a344913757e4b95198a4b069127aa9092960aaf4f:704:963:sha256-438c5644572a847c74d79f58c54f20e47ea923230c819e21bf4f8083396eaabc\",\"quote\":\"(1) Subject to the exceptions provided in paragraph (b)(2) of this section, employment periods prior to a break in service of seven years or more need not be counted in determining whether the employee has been employed by the employer for at least 12 months.\",\"start\":704},{\"end\":963,\"field\":\"logic_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa4cdfc9b75c8a1ed78c29b8a344913757e4b95198a4b069127aa9092960aaf4f:704:963:sha256-438c5644572a847c74d79f58c54f20e47ea923230c819e21bf4f8083396eaabc\",\"quote\":\"(1) Subject to the exceptions provided in paragraph (b)(2) of this section, employment periods prior to a break in service of seven years or more need not be counted in determining whether the employee has been employed by the employer for at least 12 months.\",\"start\":704},{\"end\":858,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa4cdfc9b75c8a1ed78c29b8a344913757e4b95198a4b069127aa9092960aaf4f:850:858:sha256-b00eebc92fbf41e3d233b28a918c7b90de96d6a15c0daebb94dde8af457529df\",\"quote\":\"need not\",\"start\":850},{\"end\":702,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa4cdfc9b75c8a1ed78c29b8a344913757e4b95198a4b069127aa9092960aaf4f:592:702:sha256-130832d94200d58087ab6a46024a3a10483b1b99086401c1b273635c4e31aaf3\",\"quote\":\"(b) The 12 months an employee must have been employed by the employer need not be consecutive months, provided\",\"start\":592},{\"end\":1946,\"field\":\"context:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa4cdfc9b75c8a1ed78c29b8a344913757e4b95198a4b069127aa9092960aaf4f:965:1946:sha256-44393cd9a380898a3a1acc3ba34a55b09730edf38e8b44fe99ff1f8768321518\",\"quote\":\"(2) Employment periods preceding a break in service of more than seven years must be counted in determining whether the employee has been employed by the employer for at least 12 months where:\\n\\n(i) The employee's break in service is occasioned by the fulfillment of his or her Uniformed Services Employment and Reemployment Rights Act (USERRA), 38 U.S.C. 4301, et seq., covered service obligation. The period of absence from work due to or necessitated by USERRA-covered service must be also counted in determining whether the employee has been employed for at least 12 months by the employer. However, this section does not provide any greater entitlement to the employee than would be available under the USERRA; or\\n\\n(ii) A written agreement, including a collective bargaining agreement, exists concerning the employer's intention to rehire the employee after the break in service (e.g., for purposes of the employee furthering his or her education or for childrearing purposes).\",\"start\":965}],\"id\":\"urn:rulespec:document-understanding:revision:320fefa3140b8a4e50df23973781771bbb08d755de3f11fec82197ac7d8c209c\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"exemption\",\"logic_text\":\"(1) Subject to the exceptions provided in paragraph (b)(2) of this section, employment periods prior to a break in service of seven years or more need not be counted in determining whether the employee has been employed by the employer for at least 12 months.\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:c6fc41507ffa52d7ca4be8aa874144f25d4aa59d46d5b5de493e1048f439df46\",\"modality\":\"not_required\",\"modality_quote\":\"need not\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:d722a6e600fad269b669de264de6041eec50355c869fc167fd483c2f11f97d2f\",\"origin\":\"aiSuggested\",\"quote\":\"(1) Subject to the exceptions provided in paragraph (b)(2) of this section, employment periods prior to a break in service of seven years or more need not be counted in determining whether the employee has been employed by the employer for at least 12 months.\",\"references\":[\"paragraph (b)(2)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:926d991a28e36d74873892e7aad555511a039c5674faa644877c810a2651a991\",\"scope_quotes\":[\"(b) The 12 months an employee must have been employed by the employer need not be consecutive months, provided\"],\"scope_text\":\"In determining whether an employee has been employed by the employer for at least 12 months, subject to the exceptions provided in paragraph (b)(2).\",\"section_id\":\"section-1\",\"start\":704,\"summary\":\"Subject to the exceptions provided in paragraph (b)(2), employment periods prior to a break in service of seven years or more need not be counted in determining whether the employee has been employed by the employer for at least 12 months.\",\"target_ids\":[],\"typed_values\":[]}",

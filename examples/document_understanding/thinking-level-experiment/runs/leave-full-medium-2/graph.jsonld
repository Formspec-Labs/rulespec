    {
      "@id": "urn:rulespec:document-understanding:revision:3c8d2404441896166877e50cd0e17c9148f602a4fc34a3085f75544e05760495",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:3c8d2404441896166877e50cd0e17c9148f602a4fc34a3085f75544e05760495",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:0c0e6135f4f08a622c8528c9ed088b12e28f87a700a308208db91e409a788d20",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:36410ee92f4d5724784e3068a720ed37ab232a4f5e44fe4d37524e22ac8267c8\",\"urn:rulespec:document-understanding:assertion:ded5b1b9e095a9b753ab3ff0448525d400b7952e9fa992e77eb3136e45f6c557\",\"urn:rulespec:document-understanding:assertion:fa7aab88f2bb0f2e15d38801bf5b6f142f6cf6c5d89759b5427418dd9568f7f9\",\"urn:rulespec:document-understanding:assertion:d29c15c349dd0886ead691f94843ece901a56dd64577c42dbbeb9123bc3215b3\",\"urn:rulespec:document-understanding:assertion:e08ab82441b1cc0b9d7158c49159272eff5d1dd9b3520d02259549e2647b0515\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"effective_periods\":[],\"end\":6919,\"evidence\":[{\"end\":6919,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa4cdfc9b75c8a1ed78c29b8a344913757e4b95198a4b069127aa9092960aaf4f:5935:6919:sha256-1672ae977263bffd648cf9a677362859d00854d5b07622e1cc91d5bcdd749c8c\",\"quote\":\"(e) Whether 50 employees are employed within 75 miles to ascertain an employee's eligibility for FMLA benefits is determined when the employee gives notice of the need for leave. Whether the leave is to be taken at one time or on an intermittent or reduced leave schedule basis, once an employee is determined eligible in response to that notice of the need for leave, the employee's eligibility is not affected by any subsequent change in the number of employees employed at or within 75 miles of the employee's worksite, for that specific notice of the need for leave. Similarly, an employer may not terminate employee leave that has already started if the employee count drops below 50. For example, if an employer employs 60 employees in August, but expects that the number of employees will drop to 40 in December, the employer must grant FMLA benefits to an otherwise eligible employee who gives notice of the need for leave in August for a period of leave to begin in December.\",\"start\":5935},{\"end\":6919,\"field\":\"logic_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa4cdfc9b75c8a1ed78c29b8a344913757e4b95198a4b069127aa9092960aaf4f:5935:6919:sha256-1672ae977263bffd648cf9a677362859d00854d5b07622e1cc91d5bcdd749c8c\",\"quote\":\"(e) Whether 50 employees are employed within 75 miles to ascertain an employee's eligibility for FMLA benefits is determined when the employee gives notice of the need for leave. Whether the leave is to be taken at one time or on an intermittent or reduced leave schedule basis, once an employee is determined eligible in response to that notice of the need for leave, the employee's eligibility is not affected by any subsequent change in the number of employees employed at or within 75 miles of the employee's worksite, for that specific notice of the need for leave. Similarly, an employer may not terminate employee leave that has already started if the employee count drops below 50. For example, if an employer employs 60 employees in August, but expects that the number of employees will drop to 40 in December, the employer must grant FMLA benefits to an otherwise eligible employee who gives notice of the need for leave in August for a period of leave to begin in December.\",\"start\":5935},{\"end\":6536,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa4cdfc9b75c8a1ed78c29b8a344913757e4b95198a4b069127aa9092960aaf4f:6529:6536:sha256-0007a8bea4dcd3f6b1490fc7199650f1046713dd92d9314e1f2ede6946fcd999\",\"quote\":\"may not\",\"start\":6529},{\"end\":103,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa4cdfc9b75c8a1ed78c29b8a344913757e4b95198a4b069127aa9092960aaf4f:37:103:sha256-f65766fc8c1d9018ff7f6a685d59a802898d9b888c3de0a8c3c4756b5c8959a4\",\"quote\":\"(a) An eligible employee is an employee of a covered employer who:\",\"start\":37},{\"end\":590,\"field\":\"scope_text:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa4cdfc9b75c8a1ed78c29b8a344913757e4b95198a4b069127aa9092960aaf4f:408:590:sha256-eb912ba3e3b8c4d1913a4740159f38d60c23793adb2467a188d1d44e8220b6ca\",\"quote\":\"(3) Is employed at a worksite where 50 or more employees are employed by the employer within 75 miles of that worksite. See § 825.105(b) regarding employees who work outside the U.S.\",\"start\":408}],\"id\":\"urn:rulespec:document-understanding:revision:3c8d2404441896166877e50cd0e17c9148f602a4fc34a3085f75544e05760495\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"prohibition\",\"logic_text\":\"(e) Whether 50 employees are employed within 75 miles to ascertain an employee's eligibility for FMLA benefits is determined when the employee gives notice of the need for leave. Whether the leave is to be taken at one time or on an intermittent or reduced leave schedule basis, once an employee is determined eligible in response to that notice of the need for leave, the employee's eligibility is not affected by any subsequent change in the number of employees employed at or within 75 miles of the employee's worksite, for that specific notice of the need for leave. Similarly, an employer may not terminate employee leave that has already started if the employee count drops below 50. For example, if an employer employs 60 employees in August, but expects that the number of employees will drop to 40 in December, the employer must grant FMLA benefits to an otherwise eligible employee who gives notice of the need for leave in August for a period of leave to begin in December.\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:e08ab82441b1cc0b9d7158c49159272eff5d1dd9b3520d02259549e2647b0515\",\"modality\":\"must_not\",\"modality_quote\":\"may not\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:1c048e55021c2c22cd72f991e0d256cd70089d1e28accc312729f5bc3910621a\",\"origin\":\"aiSuggested\",\"quote\":\"(e) Whether 50 employees are employed within 75 miles to ascertain an employee's eligibility for FMLA benefits is determined when the employee gives notice of the need for leave. Whether the leave is to be taken at one time or on an intermittent or reduced leave schedule basis, once an employee is determined eligible in response to that notice of the need for leave, the employee's eligibility is not affected by any subsequent change in the number of employees employed at or within 75 miles of the employee's worksite, for that specific notice of the need for leave. Similarly, an employer may not terminate employee leave that has already started if the employee count drops below 50. For example, if an employer employs 60 employees in August, but expects that the number of employees will drop to 40 in December, the employer must grant FMLA benefits to an otherwise eligible employee who gives notice of the need for leave in August for a period of leave to begin in December.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:7eb140d0bff56cf6aada057735cbf21289a2bf006a85d65df365fc0cadfc40b8\",\"scope_quotes\":[\"(a) An eligible employee is an employee of a covered employer who:\",\"(3) Is employed at a worksite where 50 or more employees are employed by the employer within 75 miles of that worksite. See § 825.105(b) regarding employees who work outside the U.S.\"],\"scope_text\":\"Once an employee has been determined eligible in response to a notice of the need for leave, and leave has already started.\",\"section_id\":\"section-1\",\"start\":5935,\"summary\":\"An employer may not terminate employee leave that has already started if the employee count drops below 50 within 75 miles; eligibility is determined when the employee gives notice of the need for leave and is not affected by subsequent changes in employee headcount for that specific notice.\",\"target_ids\":[],\"typed_values\":[]}",

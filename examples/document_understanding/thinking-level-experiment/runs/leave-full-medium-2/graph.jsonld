    {
      "@id": "urn:rulespec:document-understanding:assertion:e08ab82441b1cc0b9d7158c49159272eff5d1dd9b3520d02259549e2647b0515",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:5ce1669f93904fad3feb9e4049e1f69462332b561433669712e6c9ba690bbb4d",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:6f9c0330bf16e4a9dbee654d6a46eae4b15e811059709e1e7cf8ca15aa02c20a",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:7eb140d0bff56cf6aada057735cbf21289a2bf006a85d65df365fc0cadfc40b8",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"effective_periods\":[],\"jurisdiction\":\"\",\"kind\":\"prohibition\",\"logic_text\":\"(e) Whether 50 employees are employed within 75 miles to ascertain an employee's eligibility for FMLA benefits is determined when the employee gives notice of the need for leave. Whether the leave is to be taken at one time or on an intermittent or reduced leave schedule basis, once an employee is determined eligible in response to that notice of the need for leave, the employee's eligibility is not affected by any subsequent change in the number of employees employed at or within 75 miles of the employee's worksite, for that specific notice of the need for leave. Similarly, an employer may not terminate employee leave that has already started if the employee count drops below 50. For example, if an employer employs 60 employees in August, but expects that the number of employees will drop to 40 in December, the employer must grant FMLA benefits to an otherwise eligible employee who gives notice of the need for leave in August for a period of leave to begin in December.\",\"modality\":\"must_not\",\"object\":\"\",\"scope_text\":\"Once an employee has been determined eligible in response to a notice of the need for leave, and leave has already started.\",\"summary\":\"An employer may not terminate employee leave that has already started if the employee count drops below 50 within 75 miles; eligibility is determined when the employee gives notice of the need for leave and is not affected by subsequent changes in employee headcount for that specific notice.\",\"typed_values\":[]}",
        "@type": "xsd:string"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed",
      "rkaf:hasApplicability": "urn:rulespec:document-understanding:scope:d08007cbbd37238c8dd06bcd759a5aef0f94809a047ec7863264fec0b172b054"
    },

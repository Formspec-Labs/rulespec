      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:states-prohibition",
      "rkaf:assertsValue": {
        "@value": "An employer may not terminate employee leave that has already started if the employee count drops below 50 within 75 miles; eligibility is determined when the employee gives notice of the need for leave and is not affected by subsequent changes in employee headcount for that specific notice.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

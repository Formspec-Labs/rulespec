    {
      "@id": "urn:rulespec:document-understanding:assertion:18a15ba419ade0a325f62958d17d519f42ad585fbe24efdc61fdb1fa0b3f13b0",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:5ce1669f93904fad3feb9e4049e1f69462332b561433669712e6c9ba690bbb4d",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:6f9c0330bf16e4a9dbee654d6a46eae4b15e811059709e1e7cf8ca15aa02c20a",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:c5e978eeec0bc45ecf812abbffb021d20c6e4763c01739ad49addd300a7a5b10",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[\"(1) Has been employed by the employer for at least 12 months, and\",\"(2) Has been employed for at least 1,250 hours of service during the 12-month period immediately preceding the commencement of the leave ( see § 825.801 for special hours of service requirements for airline flight crew employees), and\",\"(3) Is employed at a worksite where 50 or more employees are employed by the employer within 75 miles of that worksite. See § 825.105(b) regarding employees who work outside the U.S.\"],\"choice_text\":\"All three requirements must be met: (1) employed by the employer for at least 12 months, (2) employed for at least 1,250 hours of service during the 12-month period immediately preceding leave commencement, and (3) employed at a worksite where 50 or more employees are employed by the employer within 75 miles of that worksite.\",\"claimants\":[],\"concepts\":[],\"effective_periods\":[],\"jurisdiction\":\"\",\"kind\":\"definition\",\"logic_text\":\"(a) An eligible employee is an employee of a covered employer who:\\n\\n(1) Has been employed by the employer for at least 12 months, and\\n\\n(2) Has been employed for at least 1,250 hours of service during the 12-month period immediately preceding the commencement of the leave ( see § 825.801 for special hours of service requirements for airline flight crew employees), and\\n\\n(3) Is employed at a worksite where 50 or more employees are employed by the employer within 75 miles of that worksite. See § 825.105(b) regarding employees who work outside the U.S.\",\"modality\":\"not_stated\",\"object\":\"\",\"scope_text\":\"Applies to an employee of a covered employer seeking to be an eligible employee under the FMLA.\",\"summary\":\"An eligible employee is defined as an employee of a covered employer who has been employed by the employer for at least 12 months, has been employed for at least 1,250 hours of service during the 12-month period immediately preceding the commencement of the leave (subject to special rules for airline flight crew employees in § 825.801), and is employed at a worksite where 50 or more employees are employed by the employer within 75 miles of that worksite (referencing § 825.105(b) for employees working outside the U.S.).\",\"typed_values\":[]}",
        "@type": "xsd:string"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed",

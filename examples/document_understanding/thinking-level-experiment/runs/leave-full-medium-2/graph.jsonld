    {
      "@id": "urn:rulespec:document-understanding:scope:313dffa4dc5cd4084d3484d91e03819ddcfb8eda3fa3c2da8e588c7df0a1a43e",
      "@type": "rkaf:ApplicabilityScope",
      "rkaf:appliesInJurisdiction": [],
      "rkaf:applicabilityCondition": "In the event an employer does not maintain an accurate record of hours worked by an employee, including employees exempt from FLSA recordkeeping requirements."
    },
    {
      "@id": "urn:rulespec:document-understanding:assertion:fa5979d26e4e0c3ae5f83320efd0f8a56af68bc370e0620c3003972cd675547c",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:5ce1669f93904fad3feb9e4049e1f69462332b561433669712e6c9ba690bbb4d",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:6f9c0330bf16e4a9dbee654d6a46eae4b15e811059709e1e7cf8ca15aa02c20a",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:5772d2dca6841930d4b56c37449f0beb342481b14c95b4f0520efe547614021c",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:states-requirement",
      "rkaf:assertsValue": {
        "@value": "If an employer does not maintain an accurate record of hours worked by an employee (including FLSA-exempt employees), the employer has the burden of showing that the employee has not worked the requisite hours, and must be able to clearly demonstrate that the employee did not work 1,250 hours during the previous 12 months in order to claim that the employee is not eligible for FMLA leave.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },
    {
      "@id": "urn:rulespec:document-understanding:binding:015e223153760af2374269094d07c7aff44684ae8aadb0ca78f4aee09fee11c5",

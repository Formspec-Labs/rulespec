      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:choice_text",
      "rkaf:assertsValue": {
        "@value": "Either (i) the break in service is occasioned by USERRA-covered service obligation, or (ii) a written agreement exists concerning the employer's intention to rehire the employee after the break in service.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },
    {
      "@id": "urn:rulespec:document-understanding:binding:99c7c66bcd91a8477fc4ccf308c9d9ed6baf73d3d1e6b2292c9427418ce536aa",

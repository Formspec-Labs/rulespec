    {
      "@id": "urn:rulespec:document-understanding:scope:861c5e30b142f666c1c82372838e4f1791ea4287989208f8e06cf9c0174d0ba0",
      "@type": "rkaf:ApplicabilityScope",
      "rkaf:appliesInJurisdiction": [],
      "rkaf:applicabilityCondition": "In determining whether an employee has been employed by the employer for at least 12 months, where an employee had a break in service of more than seven years."
    },
    {
      "@id": "urn:rulespec:document-understanding:assertion:a2bdaa183833485f7a50111cf4c565ca84510957a6d5cdb32884abb9cceb2b49",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:5ce1669f93904fad3feb9e4049e1f69462332b561433669712e6c9ba690bbb4d",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:6f9c0330bf16e4a9dbee654d6a46eae4b15e811059709e1e7cf8ca15aa02c20a",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:767145c345b6dec64966dbd3abe8929321f9549049ad5b723173bf8df6e40ef4",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:states-requirement",
      "rkaf:assertsValue": {
        "@value": "Employment periods preceding a break in service of more than seven years must be counted in determining whether an employee has been employed by the employer for at least 12 months where: (i) the break in service is occasioned by fulfillment of a USERRA-covered service obligation (and the period of absence due to USERRA service must also be counted, without granting greater entitlement than USERRA), or (ii) a written agreement, including a collective bargaining agreement, exists concerning the employer's intention to rehire the employee after the break in service.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

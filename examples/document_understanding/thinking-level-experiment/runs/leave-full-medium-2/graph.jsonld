      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:8bca6d1bfb24782ecea6f4888f5ccced879466b064ef65f42f0c7ae6a9b4bc9e\",\"urn:rulespec:document-understanding:assertion:fcff818878aa223cd818f19ae35668ed6a6f25c8847bad68c0c3ad66237606ea\",\"urn:rulespec:document-understanding:assertion:593a034e205fdaed5ae6b1ac40e3abbb26cac267665284bac245c75a7acf8401\",\"urn:rulespec:document-understanding:assertion:30d6405dacf6be945328265652e3e3bf9e33d6b84189a633d91ad740383e3b71\",\"urn:rulespec:document-understanding:assertion:389d0bfd164c522c2ad443eecdfd754e847306baf87e3a77ce3870c9a6e847d8\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"effective_periods\":[],\"end\":2417,\"evidence\":[{\"end\":2417,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa4cdfc9b75c8a1ed78c29b8a344913757e4b95198a4b069127aa9092960aaf4f:1948:2417:sha256-4048733db741ffbcee82288a3f298f4f891c683f3d1c1b543892af4f7ddc5dba\",\"quote\":\"(3) If an employee is maintained on the payroll for any part of a week, including any periods of paid or unpaid leave (sick, vacation) during which other benefits or compensation are provided by the employer (e.g., workers' compensation, group health plan benefits, etc.), the week counts as a week of employment. For purposes of determining whether intermittent/occasional/casual employment qualifies as at least 12 months, 52 weeks is deemed to be equal to 12 months.\",\"start\":1948},{\"end\":2417,\"field\":\"logic_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa4cdfc9b75c8a1ed78c29b8a344913757e4b95198a4b069127aa9092960aaf4f:1948:2417:sha256-4048733db741ffbcee82288a3f298f4f891c683f3d1c1b543892af4f7ddc5dba\",\"quote\":\"(3) If an employee is maintained on the payroll for any part of a week, including any periods of paid or unpaid leave (sick, vacation) during which other benefits or compensation are provided by the employer (e.g., workers' compensation, group health plan benefits, etc.), the week counts as a week of employment. For purposes of determining whether intermittent/occasional/casual employment qualifies as at least 12 months, 52 weeks is deemed to be equal to 12 months.\",\"start\":1948},{\"end\":170,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa4cdfc9b75c8a1ed78c29b8a344913757e4b95198a4b069127aa9092960aaf4f:105:170:sha256-65892c2f4a4b04b4af78de1dd2934ed6701e42ce507cd493e35ac4d9a1ba80b0\",\"quote\":\"(1) Has been employed by the employer for at least 12 months, and\",\"start\":105},{\"end\":702,\"field\":\"scope_text:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa4cdfc9b75c8a1ed78c29b8a344913757e4b95198a4b069127aa9092960aaf4f:592:702:sha256-130832d94200d58087ab6a46024a3a10483b1b99086401c1b273635c4e31aaf3\",\"quote\":\"(b) The 12 months an employee must have been employed by the employer need not be consecutive months, provided\",\"start\":592}],\"id\":\"urn:rulespec:document-understanding:revision:724eefe818a318afe5021f2cb3c9b4ce3fb35efb732c88e7f60382c54633954e\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"statement\",\"logic_text\":\"(3) If an employee is maintained on the payroll for any part of a week, including any periods of paid or unpaid leave (sick, vacation) during which other benefits or compensation are provided by the employer (e.g., workers' compensation, group health plan benefits, etc.), the week counts as a week of employment. For purposes of determining whether intermittent/occasional/casual employment qualifies as at least 12 months, 52 weeks is deemed to be equal to 12 months.\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:389d0bfd164c522c2ad443eecdfd754e847306baf87e3a77ce3870c9a6e847d8\",\"modality\":\"not_stated\",\"modality_quote\":\"\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:883835c79e0c5d7000f231fd30b6f8a93a5df4079d38ecc3386c707e2ba9664f\",\"origin\":\"aiSuggested\",\"quote\":\"(3) If an employee is maintained on the payroll for any part of a week, including any periods of paid or unpaid leave (sick, vacation) during which other benefits or compensation are provided by the employer (e.g., workers' compensation, group health plan benefits, etc.), the week counts as a week of employment. For purposes of determining whether intermittent/occasional/casual employment qualifies as at least 12 months, 52 weeks is deemed to be equal to 12 months.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:40e99cb43bf54e01bc03a9cd8eb690de2931e163901ab6febb5ad69cfbca1f21\",\"scope_quotes\":[\"(1) Has been employed by the employer for at least 12 months, and\",\"(b) The 12 months an employee must have been employed by the employer need not be consecutive months, provided\"],\"scope_text\":\"In determining whether an employee has been employed by the employer for at least 12 months.\",\"section_id\":\"section-1\",\"start\":1948,\"summary\":\"If an employee is maintained on the payroll for any part of a week, including periods of paid or unpaid leave during which other benefits or compensation are provided by the employer, the week counts as a week of employment; for purposes of determining whether intermittent, occasional, or casual employment qualifies as at least 12 months, 52 weeks is deemed equal to 12 months.\",\"target_ids\":[],\"typed_values\":[]}",

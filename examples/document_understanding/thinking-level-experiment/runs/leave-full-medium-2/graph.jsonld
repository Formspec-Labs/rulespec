    {
      "@id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa4cdfc9b75c8a1ed78c29b8a344913757e4b95198a4b069127aa9092960aaf4f:37:406:sha256-c134e120c2026f4e85415f07c2963e76ae6725bcb4606bf43895261e108ce53f",
      "@type": "rkaf:SourceFragment",
      "oa:hasSource": "urn:rulespec:document-understanding:document:a4cdfc9b75c8a1ed78c29b8a344913757e4b95198a4b069127aa9092960aaf4f",
      "rkaf:fragmentIdentityScheme": "rkaf:carrier-local-fragment",
      "rkaf:sourceArtifactDigest": "sha256:a4cdfc9b75c8a1ed78c29b8a344913757e4b95198a4b069127aa9092960aaf4f",
      "rkaf:fragmentContentDigest": "sha256:c134e120c2026f4e85415f07c2963e76ae6725bcb4606bf43895261e108ce53f",
      "rkaf:selectorKind": [
        "oa:TextQuoteSelector",
        "oa:TextPositionSelector"
      ],
      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "(a) An eligible employee is an employee of a covered employer who:\n\n(1) Has been employed by the employer for at least 12 months, and\n\n(2) Has been employed for at least 1,250 hours of service during the 12-month period immediately preceding the commencement of the leave ( see § 825.801 for special hours of service requirements for airline flight crew employees), and"
        },
        {
          "@type": "oa:TextPositionSelector",
          "oa:start": 37,
          "oa:end": 406,
          "rkaf:coordinateSystem": "rkaf:unicode-codepoint"
        }
      ]
    },
    {
      "@id": "urn:rulespec:document-understanding:scope:1648f6b88848f8f0c8d3dcafa67b0a104538e54f3bdd4b8cf49e0c9575af1f63",
      "@type": "rkaf:ApplicabilityScope",
      "rkaf:appliesInJurisdiction": [],
      "rkaf:applicabilityCondition": "When determining whether an employee meets the hours of service requirement and the 12-month employment requirement."
    },
    {
      "@id": "urn:rulespec:document-understanding:assertion:8cf78722ccf38ca24ca383a15abc0863f0be514b81bf6c104472c768f041805a",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:5ce1669f93904fad3feb9e4049e1f69462332b561433669712e6c9ba690bbb4d",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:6f9c0330bf16e4a9dbee654d6a46eae4b15e811059709e1e7cf8ca15aa02c20a",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:054da8498c24ba1078d87021ccc4c8742e05ed9502fb90a3ce22955948d4f40d",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:states-requirement",
      "rkaf:assertsValue": {
        "@value": "The determination of whether an employee meets the hours of service requirement and has been employed by the employer for at least 12 months must be made as of the date the FMLA leave is to start; if an employee is on non-FMLA leave when reaching 12-month eligibility, any portion of leave taken for an FMLA-qualifying reason after meeting the requirement is FMLA leave.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

      "rkaf:applicabilityCondition": "When determining eligibility for FMLA-qualifying leave for an employee returning from USERRA-covered service."
    },
    {
      "@id": "urn:rulespec:document-understanding:assertion:b90efc084879a3c317a5727fb3010369648391d7b54f35af8775603203d28867",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:5ce1669f93904fad3feb9e4049e1f69462332b561433669712e6c9ba690bbb4d",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:6f9c0330bf16e4a9dbee654d6a46eae4b15e811059709e1e7cf8ca15aa02c20a",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:86cd845544eb2b0edfce5befaa17269fa33596fea127b5fd7341883cb447fd53",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:states-requirement",
      "rkaf:assertsValue": {
        "@value": "An employee returning from USERRA-covered service shall be credited with the hours of service that would have been performed but for the absence due to USERRA service to meet the hours of service requirement, added to hours actually worked during the previous 12-month period, and the employee's pre-service work schedule can generally be used for calculations (referencing § 825.801(c) for airline flight crew rules).",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

      "rkaf:assertsValue": {
        "@value": "Except as provided in paragraph (c)(2) and § 825.801, whether an employee has worked the minimum 1,250 hours of service is determined according to FLSA principles for compensable hours of work based on actual hours worked; the determination is not limited by recordkeeping methods or inaccurate compensation agreements, and any accurate accounting of actual hours worked under FLSA principles may be used.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

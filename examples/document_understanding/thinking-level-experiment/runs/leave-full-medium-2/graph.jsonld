      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:6d43b51cdbb512866b84755b15df842c916a6bc54186a5bfe7a3c7e96301d980\",\"urn:rulespec:document-understanding:assertion:7cb76fa5525c391d5afb50054df30bb5a2209f603b2640a38ddd4d79a84c2674\",\"urn:rulespec:document-understanding:assertion:13c3274a0fc02d672a6f66b1a9e0a35f81e55bae1bfcf37f68bd35f4196e1bfc\",\"urn:rulespec:document-understanding:assertion:5ec20d31c7f4c0e91c969e1436337c5c677929e8bce1c0fd469a3a6742cd6910\",\"urn:rulespec:document-understanding:assertion:c8b96c7fd557773c560f5d8438e01bcdf33bfbe6e3fd61ca6028e36b25342789\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[\"(1) Subject to the exceptions provided in paragraph (b)(2) of this section, employment periods prior to a break in service of seven years or more need not be counted in determining whether the employee has been employed by the employer for at least 12 months.\"],\"effective_periods\":[],\"end\":702,\"evidence\":[{\"end\":702,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa4cdfc9b75c8a1ed78c29b8a344913757e4b95198a4b069127aa9092960aaf4f:592:702:sha256-130832d94200d58087ab6a46024a3a10483b1b99086401c1b273635c4e31aaf3\",\"quote\":\"(b) The 12 months an employee must have been employed by the employer need not be consecutive months, provided\",\"start\":592},{\"end\":702,\"field\":\"logic_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa4cdfc9b75c8a1ed78c29b8a344913757e4b95198a4b069127aa9092960aaf4f:592:702:sha256-130832d94200d58087ab6a46024a3a10483b1b99086401c1b273635c4e31aaf3\",\"quote\":\"(b) The 12 months an employee must have been employed by the employer need not be consecutive months, provided\",\"start\":592},{\"end\":670,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa4cdfc9b75c8a1ed78c29b8a344913757e4b95198a4b069127aa9092960aaf4f:662:670:sha256-b00eebc92fbf41e3d233b28a918c7b90de96d6a15c0daebb94dde8af457529df\",\"quote\":\"need not\",\"start\":662},{\"end\":103,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa4cdfc9b75c8a1ed78c29b8a344913757e4b95198a4b069127aa9092960aaf4f:37:103:sha256-f65766fc8c1d9018ff7f6a685d59a802898d9b888c3de0a8c3c4756b5c8959a4\",\"quote\":\"(a) An eligible employee is an employee of a covered employer who:\",\"start\":37},{\"end\":170,\"field\":\"scope_text:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa4cdfc9b75c8a1ed78c29b8a344913757e4b95198a4b069127aa9092960aaf4f:105:170:sha256-65892c2f4a4b04b4af78de1dd2934ed6701e42ce507cd493e35ac4d9a1ba80b0\",\"quote\":\"(1) Has been employed by the employer for at least 12 months, and\",\"start\":105},{\"end\":963,\"field\":\"context:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa4cdfc9b75c8a1ed78c29b8a344913757e4b95198a4b069127aa9092960aaf4f:704:963:sha256-438c5644572a847c74d79f58c54f20e47ea923230c819e21bf4f8083396eaabc\",\"quote\":\"(1) Subject to the exceptions provided in paragraph (b)(2) of this section, employment periods prior to a break in service of seven years or more need not be counted in determining whether the employee has been employed by the employer for at least 12 months.\",\"start\":704}],\"id\":\"urn:rulespec:document-understanding:revision:e7ac396ca11b099d56d6bac2c4d5ea820c52a6cf73f64a867052b0ec7c8fa8e9\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"exemption\",\"logic_text\":\"(b) The 12 months an employee must have been employed by the employer need not be consecutive months, provided\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:c8b96c7fd557773c560f5d8438e01bcdf33bfbe6e3fd61ca6028e36b25342789\",\"modality\":\"not_required\",\"modality_quote\":\"need not\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:bf0faa75c81c288a8d00a9174f56eff812decf01d7bfc86e1e9ead77e3e5df09\",\"origin\":\"aiSuggested\",\"quote\":\"(b) The 12 months an employee must have been employed by the employer need not be consecutive months, provided\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:b64aada79827dd1dfecb38b7ce340826e9a68ad45d67054494f47d0ac15de4bd\",\"scope_quotes\":[\"(a) An eligible employee is an employee of a covered employer who:\",\"(1) Has been employed by the employer for at least 12 months, and\"],\"scope_text\":\"In determining whether an employee has been employed by the employer for at least 12 months.\",\"section_id\":\"section-1\",\"start\":592,\"summary\":\"The 12 months an employee must have been employed by the employer need not be consecutive months, provided the rules in paragraph (b) are met.\",\"target_ids\":[],\"typed_values\":[]}",

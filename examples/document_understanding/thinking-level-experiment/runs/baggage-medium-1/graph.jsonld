      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:d50ca22bc825d5a34ef1679ccb5b588e9ff6ce0ee13d5ce8c3b1004f142216f2\",\"urn:rulespec:document-understanding:assertion:4297526a13b96d0643e68ef28d0c73ef02521643fae2ed1dedab3567320a0afe\",\"urn:rulespec:document-understanding:assertion:b7d693d5fe1c17b000233d7169f3e13a880ca40cdad7bdcf400743579749902c\",\"urn:rulespec:document-understanding:assertion:01a600e8d5f30ed7a32d4f6d766fbb1bc4ba4e5c3a1e960a841b861e608a4d81\",\"urn:rulespec:document-understanding:assertion:110ca086c49d06ec3cb8a892004be97a9e999b0fd30379cf80f6a3ae1dd9cd54\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"effective_periods\":[],\"end\":1584,\"evidence\":[{\"end\":1584,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aab45ff8a7d213a548ba64b9bd9efdd9202dcd2f94cc0c1045a1b5fb69fe86460:1376:1584:sha256-6c487aed336ad1cb682d66ec0d70d30d7d769fea9894c3e82b93edafdf57b3d9\",\"quote\":\"(c) In checked baggage. A passenger may not transport or offer for transport in checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter:\\n\\n(1) Any loaded firearm(s).\",\"start\":1376},{\"end\":1584,\"field\":\"logic_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aab45ff8a7d213a548ba64b9bd9efdd9202dcd2f94cc0c1045a1b5fb69fe86460:1376:1584:sha256-6c487aed336ad1cb682d66ec0d70d30d7d769fea9894c3e82b93edafdf57b3d9\",\"quote\":\"(c) In checked baggage. A passenger may not transport or offer for transport in checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter:\\n\\n(1) Any loaded firearm(s).\",\"start\":1376},{\"end\":1419,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aab45ff8a7d213a548ba64b9bd9efdd9202dcd2f94cc0c1045a1b5fb69fe86460:1412:1419:sha256-0007a8bea4dcd3f6b1490fc7199650f1046713dd92d9314e1f2ede6946fcd999\",\"quote\":\"may not\",\"start\":1412},{\"end\":1556,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aab45ff8a7d213a548ba64b9bd9efdd9202dcd2f94cc0c1045a1b5fb69fe86460:1376:1556:sha256-9dd5c9d0feb251838bff5c1a16b3c099ef083ecc7b0fca10625f4c8d5699fdf1\",\"quote\":\"(c) In checked baggage. A passenger may not transport or offer for transport in checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter:\",\"start\":1376}],\"id\":\"urn:rulespec:document-understanding:revision:30453a73110d7142af4e76c42882e8cfa80efcbd64a0ffe0311c3579ce39574c\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"prohibition\",\"logic_text\":\"(c) In checked baggage. A passenger may not transport or offer for transport in checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter:\\n\\n(1) Any loaded firearm(s).\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:110ca086c49d06ec3cb8a892004be97a9e999b0fd30379cf80f6a3ae1dd9cd54\",\"modality\":\"must_not\",\"modality_quote\":\"may not\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:6ea0a83eab09e9650c331381e05a1271a77d27d6ef79c647b6df3d067b91bf8f\",\"origin\":\"aiSuggested\",\"quote\":\"(c) In checked baggage. A passenger may not transport or offer for transport in checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter:\\n\\n(1) Any loaded firearm(s).\",\"references\":[\"§ 1562.23\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:e5e4dc4dc5ae41a5c79b9e8be44c88caa1e588beb205944d16ddd8025f313ceb\",\"scope_quotes\":[\"(c) In checked baggage. A passenger may not transport or offer for transport in checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter:\"],\"scope_text\":\"In checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter.\",\"section_id\":\"section-1\",\"start\":1376,\"summary\":\"A passenger may not transport or offer for transport in checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter any loaded firearm(s).\",\"target_ids\":[],\"typed_values\":[]}",

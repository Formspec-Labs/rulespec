    {
      "@id": "urn:rulespec:document-understanding:revision:2c77fd513c2e4000904e3834fe9a6688c5081b9daf4e74b6e2079dcb684b5da8",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:2c77fd513c2e4000904e3834fe9a6688c5081b9daf4e74b6e2079dcb684b5da8",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",

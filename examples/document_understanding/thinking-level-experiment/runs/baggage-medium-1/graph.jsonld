      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:8a8840b7391d249d01093f763554fc8f14d0b5ec6a37749a74e33b7918522c6c",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:438580e4d0a7a36e2f3783991ae73be0496b90a0af20e3fc9279941f50c28fa7",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:b935a54546cc11adaf9c8eb2648e925e9c450986150138af3d5096dd658a5144",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[\"(i) The passenger declares to the aircraft operator, either orally or in writing, before checking the baggage, that the passenger has a firearm in his or her bag and that it is unloaded;\",\"(ii) The firearm is unloaded;\",\"(iii) The firearm is carried in a hard-sided container; and\",\"(iv) The container in which it is carried is locked, and only the passenger retains the key or combination.\"],\"choice_text\":\"All of the following must be met: (i) The passenger declares to the aircraft operator, either orally or in writing, before checking the baggage, that the passenger has a firearm in his or her bag and that it is unloaded; (ii) The firearm is unloaded; (iii) The firearm is carried in a hard-sided container; and (iv) The container in which it is carried is locked, and only the passenger retains the key or combination.\",\"claimants\":[],\"concepts\":[],\"effective_periods\":[],\"jurisdiction\":\"\",\"kind\":\"prohibition\",\"logic_text\":\"(2) Any unloaded firearm(s) unless—\\n\\n(i) The passenger declares to the aircraft operator, either orally or in writing, before checking the baggage, that the passenger has a firearm in his or her bag and that it is unloaded;\\n\\n(ii) The firearm is unloaded;\\n\\n(iii) The firearm is carried in a hard-sided container; and\\n\\n(iv) The container in which it is carried is locked, and only the passenger retains the key or combination.\",\"modality\":\"must_not\",\"object\":\"\",\"scope_text\":\"In checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter, unless all specified declaration, unloading, hard-sided container, and locking requirements are met.\",\"summary\":\"A passenger may not transport or offer for transport in checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter any unloaded firearm(s) unless the passenger declares it orally or in writing before checking baggage, the firearm is unloaded, the firearm is carried in a hard-sided container, and the container is locked with only the passenger retaining the key or combination.\",\"typed_values\":[]}",
        "@type": "xsd:string"
      },

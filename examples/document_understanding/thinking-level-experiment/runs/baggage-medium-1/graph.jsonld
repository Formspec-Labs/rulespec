    {
      "@id": "urn:rulespec:document-understanding:scope:7cff3dac7b99d3c7d52b1889fbedfd431fd04cf8f1f196796255af8a9873498b",
      "@type": "rkaf:ApplicabilityScope",
      "rkaf:appliesInJurisdiction": [],
      "rkaf:applicabilityCondition": "In checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter, unless all specified declaration, unloading, hard-sided container, and locking requirements are met."
    },
    {
      "@id": "urn:rulespec:document-understanding:assertion:9ebfba58e4d465b69d8db552ae6616f2a306569072b2348676a85bf322252c4e",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:8a8840b7391d249d01093f763554fc8f14d0b5ec6a37749a74e33b7918522c6c",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:438580e4d0a7a36e2f3783991ae73be0496b90a0af20e3fc9279941f50c28fa7",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:b935a54546cc11adaf9c8eb2648e925e9c450986150138af3d5096dd658a5144",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:states-prohibition",
      "rkaf:assertsValue": {
        "@value": "A passenger may not transport or offer for transport in checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter any unloaded firearm(s) unless the passenger declares it orally or in writing before checking baggage, the firearm is unloaded, the firearm is carried in a hard-sided container, and the container is locked with only the passenger retaining the key or combination.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },
    {
      "@id": "urn:rulespec:document-understanding:binding:a086a830f51754c5c795000a937fedcd2cb116869d69e9846fcb1b12ddbd4b9c",

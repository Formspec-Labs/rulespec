      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:8a8840b7391d249d01093f763554fc8f14d0b5ec6a37749a74e33b7918522c6c",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:438580e4d0a7a36e2f3783991ae73be0496b90a0af20e3fc9279941f50c28fa7",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:b935a54546cc11adaf9c8eb2648e925e9c450986150138af3d5096dd658a5144",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:choice_text",
      "rkaf:assertsValue": {
        "@value": "All of the following must be met: (i) The passenger declares to the aircraft operator, either orally or in writing, before checking the baggage, that the passenger has a firearm in his or her bag and that it is unloaded; (ii) The firearm is unloaded; (iii) The firearm is carried in a hard-sided container; and (iv) The container in which it is carried is locked, and only the passenger retains the key or combination.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

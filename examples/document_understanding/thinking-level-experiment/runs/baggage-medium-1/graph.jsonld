      "rkaf:assertsValue": {
        "@value": "Paragraph (a) of 49 CFR 1540.111 does not apply to the carriage of firearms and other weapons if the individual is law enforcement personnel required to carry a weapon in the performance of duty at the airport, an individual authorized to carry a weapon under §§ 1544.219, 1544.221, 1544.223, 1546.211, or subpart B of part 1562, or an individual authorized to carry a weapon in a sterile area under a security program.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

    {
      "@id": "urn:rulespec:document-understanding:assertion:9f8564f17c67fb16c70682df6753e9290b1f105ae440072c6972da0e2df530d1",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:8a8840b7391d249d01093f763554fc8f14d0b5ec6a37749a74e33b7918522c6c",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:438580e4d0a7a36e2f3783991ae73be0496b90a0af20e3fc9279941f50c28fa7",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:2b777e9bc8752b5d1df79bb12841998e49009be4339f84410d7714a8590707df",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[\"(1) Law enforcement personnel required to carry a firearm or other weapons while in the performance of law enforcement duty at the airport.\",\"(2) An individual authorized to carry a weapon in accordance with §§ 1544.219, 1544.221, 1544.223, 1546.211, or subpart B of part 1562 of this chapter.\",\"(3) An individual authorized to carry a weapon in a sterile area under a security program.\"],\"choice_text\":\"The individual must be one of the following: (1) Law enforcement personnel required to carry a firearm or other weapons while in the performance of law enforcement duty at the airport; (2) An individual authorized to carry a weapon in accordance with §§ 1544.219, 1544.221, 1544.223, 1546.211, or subpart B of part 1562 of this chapter; or (3) An individual authorized to carry a weapon in a sterile area under a security program.\",\"claimants\":[],\"concepts\":[],\"effective_periods\":[],\"jurisdiction\":\"\",\"kind\":\"exemption\",\"logic_text\":\"(b) On an individual's person or accessible property—permitted carriage of a weapon. Paragraph (a) of this section does not apply as to carriage of firearms and other weapons if the individual is one of the following:\\n\\n(1) Law enforcement personnel required to carry a firearm or other weapons while in the performance of law enforcement duty at the airport.\\n\\n(2) An individual authorized to carry a weapon in accordance with §§ 1544.219, 1544.221, 1544.223, 1546.211, or subpart B of part 1562 of this chapter.\\n\\n(3) An individual authorized to carry a weapon in a sterile area under a security program.\",\"modality\":\"not_required\",\"object\":\"\",\"scope_text\":\"As to carriage of firearms and other weapons on an individual's person or accessible property, if the individual is one of the listed categories.\",\"summary\":\"Paragraph (a) of 49 CFR 1540.111 does not apply to the carriage of firearms and other weapons if the individual is law enforcement personnel required to carry a weapon in the performance of duty at the airport, an individual authorized to carry a weapon under §§ 1544.219, 1544.221, 1544.223, 1546.211, or subpart B of part 1562, or an individual authorized to carry a weapon in a sterile area under a security program.\",\"typed_values\":[]}",
        "@type": "xsd:string"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed",
      "rkaf:hasApplicability": "urn:rulespec:document-understanding:scope:32d30e2093cfce531cd221e3497dee37fae30bae3a91fdb19c9293f274e31567"
    },

ision:d9b00a3c36eefeba51b844346225d5d75ff34c087ec9058cf99c04bec9642570\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:e1652d5973d46860ac63d81721df13a2f6b7d8291008bdab190df1544f44a283\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:39612f5d8467cf3d518a44485a93265e12b200195e22af0ac010b0b606013fc9\",\"origin\":\"aiSuggested\",\"quote\":\"(5) A generator shall mark or label the generator's container with the following:\\n\\n(a) The words \\\"Hazardous Waste\\\"; and\\n\\n(b) An indication of the hazards of the contents [examples include, but are not limited to, the applicable hazardous waste characteristics (i.e., ignitable, corrosive, reactive, toxic); hazard communication consistent with the department of transportation requirements at 49 CFR Part 172 subpart E (labeling) or subpart F (placarding); a hazard statement or pictogram consistent with the occupational safety and health administration hazard communication standard at 29 CFR 1910.1200; or a chemical hazard label consistent with the national fire protection association code 704].\",\"references\":[\"49 CFR Part 172 subpart E\",\"subpart F\",\"29 CFR 1910.1200\",\"national fire protection association code 704\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:07a157f00362a108bad19bcb9dbca3b123b3cde9873be1c8ac3297422e90621f\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":3195,\"summary\":\"As a condition for exemption for satellite accumulation, a generator must mark or label the generator's container with the words \\\"Hazardous Waste\\\" and an indication of the hazards of the contents [examples include, but are not limited to, the applicable hazardous waste characteristics (i.e., ignitable, corrosive, reactive, toxic); hazard communication consistent with the department of transportation requirements at 49 CFR Part 172 subpart E (labeling) or subpart F (placarding); a hazard statement or pictogram consistent with the occupational safety and health administration hazard communication standard at 29 CFR 1910.1200; or a chemical hazard label consistent with the national fire protection association code 704].\",\"target_ids\":[],\"typed_values\":[]}",

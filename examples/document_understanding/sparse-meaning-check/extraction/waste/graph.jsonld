      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:bba9b86b48d58a04544a5d461b382baf8e06fdecf6cf9cb4a12cf45c670b950f\",\"urn:rulespec:document-understanding:assertion:19eefce6d4f9344bab437d7a01379277f2f49253474d61bd57c9d2dcd253974d\",\"urn:rulespec:document-understanding:assertion:40feee12f1f56bf4e652da384d89837803fcb43cdc9e3f80a48d40fc7093611c\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"effective_periods\":[],\"end\":1757,\"evidence\":[{\"end\":1757,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A43f75aaf4a19870db19d481dd6883f99ef4c606c7cb4914012a118a12fbce149:1311:1757:sha256-278f91bbd96af50fed3b8dd60580e3ca81d24fc499aaac10b5d3dad824b6c1bc\",\"quote\":\"(1) If a container holding hazardous waste is not in good condition, or if the container begins to leak, the generator shall immediately transfer the hazardous waste from this container to a container that is in good condition and does not leak, or immediately transfer and manage the waste in a central accumulation area operated in compliance with paragraph (B) of rule 3745-52-16 or paragraph (A) of rule 3745-52-17 of the Administrative Code.\",\"start\":1311},{\"end\":1435,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A43f75aaf4a19870db19d481dd6883f99ef4c606c7cb4914012a118a12fbce149:1430:1435:sha256-56ee5b508706bf2de91712d85d6d1e11ddbff01949142ed6e8c22e3b1bed1c71\",\"quote\":\"shall\",\"start\":1430}],\"id\":\"urn:rulespec:document-understanding:revision:cf4024b3c66ba62f146905a6f01534d769c27b138de7abbb3f64b493c7c92c84\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:40feee12f1f56bf4e652da384d8
      "rkaf:assertsValue": {
        "@value": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"effective_periods\":[],\"jurisdiction\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"modality\":\"must\",\"object\":\"\",\"scope_text\":\"\",\"summary\":\"As a condition for exemption for satellite accumulation under special standards for incompatible wastes, a container holding a hazardous waste that is incompatible with any waste or other materials accumulated nearby in other containers must be separated from the other materials or protected from the incompatible waste or material by any practical means.\",\"typed_values\":[]}",
        "@type": "xsd:string"
      },

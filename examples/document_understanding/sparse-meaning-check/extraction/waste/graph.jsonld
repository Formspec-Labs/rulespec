      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:f905f5a6624c227c72ed3d977e03de09174dcefc343396d108f751e1620c149a\",\"urn:rulespec:document-understanding:assertion:a5622a33dae5e1e00a2291d1fc6edf45940acb01f1d9bf649fdb7e1328c0d11b\",\"urn:rulespec:document-understanding:assertion:99806b6d2ec7eb571035ff5a9dced315a9dd3b04fe13391e114e47b52e4ab02c\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"effective_periods\":[],\"end\":1309,\"evidence\":[{\"end\":1309,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A43f75aaf4a19870db19d481dd6883f99ef4c606c7cb4914012a118a12fbce149:121:1309:sha256-b1f414f71874caa7cb1888a99a7de9b50bfee7c357001f3a76143b7503ec786d\",\"quote\":\"(A) A generator may accumulate as much as fifty-five gallons of non-acute hazardous waste and either one quart of liquid acute hazardous waste listed in rule 3745-51-31 or paragraph (E) of rule 3745-51-33 of the Administrative Code or one kilogram (kg) (2.2 pounds) of solid acute hazardous waste listed in rule 3745-51-31 or paragraph (E) of rule 3745-51-33 of the Administrative Code in containers at or near any point of generation where wastes initially accumulate which is under the control of the operator of the process generating the waste, without a permit or permit by rule and without complying with the requirements of Chapters 3745-50, 3745-54 to 3745-57 and 3745-205, 3745-65 to 3745-69 and 3745-256, 3745-266, and 3745-267 of the Administrative Code, provided that all of the conditions for exemption in this rule are met. A generator may comply with the conditions for exemption in this rule instead of complying with the conditions for exemption in paragraph (B) of rule 3745-52-16 or paragraph (A) of rule 3745-52-17 of the Administrative Code, except as required in paragraphs (A)(7) and (A)(8) of this rule. The conditions for exemption for satellite accumulation are:\",\"start\":121}],\"id\":\"urn:rulespec:document-understanding:revision:f7eee10be4d07134a06dd644f850cf989e106b06cf2c42d0d36035d079e610b7\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"permission\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:99806b6d2ec7eb571035ff5a9dced315a9dd3b04fe13391e114e47b52e4ab02c\",\"modality\":\"may\",\"modality_quote\":\"may\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:45e8d4db4b048df0dc4be1731de2b13e796d6b4a011933171e90496cfe76399d\",\"origin\":\"aiSuggested\",\"quote\":\"(A) A generator may accumulate as much as fifty-five gallons of non-acute hazardous waste and either one quart of liquid acute hazardous waste listed in rule 3745-51-31 or paragraph (E) of rule 3745-51-33 of the Administrative Code or one kilogram (kg) (2.2 pounds) of solid acute hazardous waste listed in rule 3745-51-31 or paragraph (E) of rule 3745-51-33 of the Administrative Code in containers at or near any point of generation where wastes initially accumulate which is under the control of the operator of the process generating the waste, without a permit or permit by rule and without complying with the requirements of Chapters 3745-50, 3745-54 to 3745-57 and 3745-205, 3745-65 to 3745-69 and 3745-256, 3745-266, and 3745-267 of the Administrative Code, provided that all of the conditions for exemption in this rule are met. A generator may comply with the conditions for exemption in this rule instead of complying with the conditions for exemption in paragraph (B) of rule 3745-52-16 or paragraph (A) of rule 3745-52-17 of the Administrative Code, except as required in paragraphs (A)(7) and (A)(8) of this rule. The conditions for exemption for satellite accumulation are:\",\"references\":[\"paragraph (B) of rule 3745-52-16\",\"paragraph (A) of rule 3745-52-17\",\"paragraphs (A)(7) and (A)(8) of this rule\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:010802b0b9d1198495acc50f615257c195f063b6b443c1c28d206acf5b732a3a\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":121,\"summary\":\"A generator may comply with the conditions for exemption in this rule instead of complying with the conditions for exemption in paragraph (B) of rule 3745-52-16 or paragraph (A) of rule 3745-52-17 of the Administrative Code, except as required in paragraphs (A)(7) and (A)(8) of this rule.\",\"target_ids\":[],\"typed_values\":[]}",

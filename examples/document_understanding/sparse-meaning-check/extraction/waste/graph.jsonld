      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:caf34e3404707932b749904049e4d96632a059aa7956446c26e740dcf94fe0a8\",\"urn:rulespec:document-understanding:assertion:ee8ceed4e616b651eb4523abba9b48809348240fa9cab98e083d84aae457ceb4\",\"urn:rulespec:document-understanding:assertion:1932dc00376f25714571c8376bbb678e00a7028a8a195d4a50cc04ac0dfa32be\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"effective_periods\":[],\"end\":3193,\"evidence\":[{\"end\":3193,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A43f75aaf4a19870db19d481dd6883f99ef4c606c7cb4914012a118a12fbce149:2860:3193:sha256-2239f9fe9fc4f774422b951c1464ee5c5f34af485342b25b13bd60158bb7faa5\",\"quote\":\"(4) A container holding hazardous waste shall be closed at all times during accumulation, except:\\n\\n(a) When adding, removing, or consolidating waste; or\\n\\n(b) When temporary venting of a container is necessary:\\n\\n(i) For the proper operation of equipment; or\\n\\n(ii) To prevent dangerous situations, such as build-up of extreme pressure.\",\"start\":2860},{\"end\":2905,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A43f75aaf4a19870db19d481dd6883f99ef4c606c7cb4914012a118a12fbce149:2900:2905:sha256-56ee5b508706bf2de91712d85d6d1e11ddbff01949142ed6e8c22e3b1bed1c71\",\"quote\":\"shall\",\"start\":2900}],\"id\":\"urn:rulespec:document-understanding:revision:81c28600954d97e36fc9651005cc1851af8d6d7dcf399553c51c05b4d8a83f29\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:1932dc00376f25714571c8376bbb678e00a7028a8a195d4a50cc04ac0dfa32be\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:6986766993f27605f37bfa7de6882ef1ba63dc383e779d5e6b2ec8f98df4d476\",\"origin\":\"aiSuggested\",\"quote\":\"(4) A container holding hazardous waste shall be closed at all times during accumulation, except:\\n\\n(a) When adding, removing, or consolidating waste; or\\n\\n(b) When temporary venting of a container is necessary:\\n\\n(i) For the proper operation of equipment; or\\n\\n(ii) To prevent dangerous situations, such as build-up of extreme pressure.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:2e5ccf91a9e7cf3d44fb30e8ce0d8990cea977d7dcd4a49f471bb1ceeedce24d\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":2860,\"summary\":\"As a condition for exemption for satellite accumulation, a container holding hazardous waste must be closed at all times during accumulation, except when adding, removing, or consolidating waste, or when temporary venting of a container is necessary for the proper operation of equipment or to prevent dangerous situations, such as build-up of extreme pressure.\",\"target_ids\":[],\"typed_values\":[]}",
      "dcterms:references": [
        {
          "@id": "urn:rulespec:document-understanding:assertion:caf34e3404707932b749904049e4d96632a059aa7956446c26e740dcf94fe0a8"

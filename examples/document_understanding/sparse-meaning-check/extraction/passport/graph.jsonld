      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:6897b5b52f331f558d50d1e1d74aa47a0b6a65fab54bc7628191f68173b425a1",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"effective_periods\":[],\"jurisdiction\":\"\",\"kind\":\"prohibition\",\"logic_text\":\"\",\"modality\":\"must_not\",\"object\":\"\",\"scope_text\":\"\",\"summary\":\"No changes or alterations to the INs may be made unilaterally at passport agencies/centers without the approval of CA/PPT/S/A, except in extenuating circumstances on a case-by-case basis with the approval of passport agency/center management (e.g., when using an endorsement 46 to limit a passport for a special problem).\",\"typed_values\":[]}",
        "@type": "xsd:string"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

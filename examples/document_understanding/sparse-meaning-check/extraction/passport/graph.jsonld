      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:09f8c347e376ac257cb60c2d1e6fdcd81e87c68db14d746d89af10423c1e3a2a",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:7da65826c272e38155c33bb0d437165aed8a337534818be118fc388f0675f957",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"effective_periods\":[],\"jurisdiction\":\"\",\"kind\":\"definition\",\"logic_text\":\"\",\"modality\":\"not_stated\",\"object\":\"\",\"scope_text\":\"\",\"summary\":\"INs are standardized notices that provide passport bearers with information about their passports (for example, an IN may be included to explain why the passport was limited in validity, and/or what documentation is needed to obtain a fully valid passport).\",\"typed_values\":[]}",
        "@type": "xsd:string"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },
    {
      "@id": "urn:rulespec:document-understanding:binding:9e58d640cf8ccd12a32f0d8bc622f30aae821cf530417a5b8fc5f7c33f3db9c9",

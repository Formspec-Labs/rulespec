    {
      "@id": "urn:rulespec:document-understanding:revision:807ab9d6975aabc55e18e016ade124a0d7b3f2cf412ebee76ac83b31999378f3",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:807ab9d6975aabc55e18e016ade124a0d7b3f2cf412ebee76ac83b31999378f3",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:8750237b3aa48c6d549a8f9e712c1353a62b1813101e752effeaa7c1adcaba8a",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:c41f17b2631767e368b282fcbcf95a37ab230a56ed4253bddbec68e6072d177c\",\"urn:rulespec:document-understanding:assertion:0bbc51177fea95c3c3463a1dc656d3c0ddbffb815c72f1fbd9293a6d343f751c\",\"urn:rulespec:document-understanding:assertion:3cdcf3efc6604a8d27f0106129a23bb724ebac311fe2685ee84c8bcfed786cf0\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"effective_periods\":[],\"end\":2386,\"evidence\":[{\"end\":2386,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa150f4ee3b06251ce1b4533a18231db38769787697dbaee26861e227c43e353a:1578:2386:sha256-83916a909e28b50c3312da2eb87b8cec508edf844f37aae0b6ab9c59915e8b04\",\"quote\":\"c. INs are standardized notices that provide passport bearers with information about their passports. For example, an IN may be included to explain why the passport was limited in validity, and/or what documentation is needed to obtain a fully valid passport. The INs have been carefully crafted to communicate this information clearly and accurately. Consequently, no changes or alterations to the INs may be made unilaterally at passport agencies/centers without the approval of CA/PPT/S/A except in extenuating circumstances on a case-by-case basis with the approval of passport agency/center management, e.g., when using an endorsement 46 to limit a passport for a special problem. INs do not require a response from the applicant and do not need to be personalized with the applicant's name and address.\",\"start\":1578}],\"id\":\"urn:rulespec:document-understanding:revision:807ab9d6975aabc55e18e016ade124a0d7b3f2cf412ebee76ac83b31999378f3\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"statement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:3cdcf3efc6604a8d27f0106129a23bb724ebac311fe2685ee84c8bcfed786cf0\",\"modality\":\"not_stated\",\"modality_quote\":\"\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:4d347da7244e28ffbeb0844fe3e59900e299d0e18cb1a2a32e08b4bdf3d49abc\",\"origin\":\"aiSuggested\",\"quote\":\"c. INs are standardized notices that provide passport bearers with information about their passports. For example, an IN may be included to explain why the passport was limited in validity, and/or what documentation is needed to obtain a fully valid passport. The INs have been carefully crafted to communicate this information clearly and accurately. Consequently, no changes or alterations to the INs may be made unilaterally at passport agencies/centers without the approval of CA/PPT/S/A except in extenuating circumstances on a case-by-case basis with the approval of passport agency/center management, e.g., when using an endorsement 46 to limit a passport for a special problem. INs do not require a response from the applicant and do not need to be personalized with the applicant's name and address.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:2cf45159254f50e3f7079019caa07eaad9fd10b8cfd831c1f555a4f6c2bed1a2\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":1578,\"summary\":\"The INs have been carefully crafted to communicate information about their passports clearly and accurately.\",\"target_ids\":[],\"typed_values\":[]}",

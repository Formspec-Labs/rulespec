      "rkaf:hasContentDigest": "sha256:b12b651b3b5e5aad6b78dedd65b43db5689253315e896f8fa54cf3f3795237ff",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:573589715ca04067889a5a1d36189790c872217fcce28526e4ec610006e0052c\",\"urn:rulespec:document-understanding:assertion:a7421882ae903ccaa566129d967653c30d2333775373be5a2a62916201da91b3\",\"urn:rulespec:document-understanding:assertion:01e9167b724ea8c476b260ea1377b32281885fc98bad81a0319771d138b9ac1e\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"effective_periods\":[],\"end\":651,\"evidence\":[{\"end\":651,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa150f4ee3b06251ce1b4533a18231db38769787697dbaee26861e227c43e353a:200:651:sha256-19325de2fb1e6e628b7e6a6f83a16314ca28f7891a3c2c4916d0f2afa2a0ffd5\",\"quote\":\"b. IRLs are personalized, standardized letters with a date and signature block that request from the applicant additional information, documentation, or action needed to process the passport application. You must fully adjudicate the application prior to suspending to ensure that you are addressing all issues. The IRLs have been carefully crafted to communicate clearly and accurately statutory, regulatory, and other requirements of the Department.\",\"start\":200},{\"end\":412,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa150f4ee3b06251ce1b4533a18231db38769787697dbaee26861e227c43e353a:408:412:sha256-4137b01e139589b7a1d3b3fc4da031d8ce5bb415808734e970c3a58ea0e98f0f\",\"quote\":\"must\",\"start\":408}],\"id\":\"urn:rulespec:document-understanding:revision:b58a5e76c96df2cc53a13707a4a0d4bc366d1d8859e73a387f79ba9e8f5bd34d\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:01e9167b724ea8c476b260ea1377b32281885fc98bad81a0319771d138b9ac1e\",\"modality\":\"must\",\"modality_quote\":\"must\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:8843da05f804f8570e1de8e55029d77b5b6e774b34a5bb2840d9f7867c2b5da2\",\"origin\":\"aiSuggested\",\"quote\":\"b. IRLs are personalized, standardized letters with a date and signature block that request from the applicant additional information, documentation, or action needed to process the passport application. You must fully adjudicate the application prior to suspending to ensure that you are addressing all issues. The IRLs have been carefully crafted to communicate clearly and accurately statutory, regulatory, and other requirements of the Department.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:b945700ed591b164294291f454774452fe7a2548bcefa94bcc00f7497fedbaaa\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":200,\"summary\":\"You must fully adjudicate the passport application prior to suspending to ensure that you are addressing all issues.\",\"target_ids\":[],\"typed_values\":[]}",

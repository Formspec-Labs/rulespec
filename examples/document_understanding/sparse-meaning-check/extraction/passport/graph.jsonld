      "rkaf:assertsValue": {
        "@value": "Passport agencies/centers must not make unilateral changes or alterations to the IRLs without the approval of the Office of Adjudication (CA/PPT/S/A), except on a case-by-case basis with the approval of passport agency/center management in extenuating circumstances (e.g., when you request that the applicant submit a birth certificate instead of a notification of birth registration, and the applicant insists that the notification of birth registration is the birth certificate).",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

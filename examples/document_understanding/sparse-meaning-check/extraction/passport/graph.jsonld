    {
      "@id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa150f4ee3b06251ce1b4533a18231db38769787697dbaee26861e227c43e353a:653:1140:sha256-fe943f2920cb59c6062588f6312a3e3a6b3c04c5df97f1c3e177f0a93c135f43",
      "@type": "rkaf:SourceFragment",
      "oa:hasSource": "urn:rulespec:document-understanding:document:a150f4ee3b06251ce1b4533a18231db38769787697dbaee26861e227c43e353a",
      "rkaf:fragmentIdentityScheme": "rkaf:carrier-local-fragment",
      "rkaf:sourceArtifactDigest": "sha256:a150f4ee3b06251ce1b4533a18231db38769787697dbaee26861e227c43e353a",
      "rkaf:fragmentContentDigest": "sha256:fe943f2920cb59c6062588f6312a3e3a6b3c04c5df97f1c3e177f0a93c135f43",
      "rkaf:selectorKind": [
        "oa:TextQuoteSelector",
        "oa:TextPositionSelector"
      ],
      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "(1) Passport agencies/centers must not make unilateral changes or alterations to the IRLs without the approval of the Office of Adjudication (CA/PPT/S/A) except on a case-by-case basis with the approval of passport agency/center management in extenuating circumstances, e.g., when you request that the applicant submit a birth certificate instead of a notification of birth registration, and the applicant insists that the notification of birth registration is the birth certificate; and"
        },

    {
      "@id": "urn:rulespec:document-understanding:revision:2e803367b7edf6cc6c960fe87a516929fbe49a6461b4dbebb7a372db43efd0c7",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:2e803367b7edf6cc6c960fe87a516929fbe49a6461b4dbebb7a372db43efd0c7",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:4b2f600a67fe503f412619579d3699afd34cd7f8c9cd96f68ac9b9f10f276405",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:c4698df2efbbf67d563170725deb861f2afc6d7c3e29ca83c37a2f693e2121f0\",\"urn:rulespec:document-understanding:assertion:cac9aa07de9a0f5af2f7cb323e90f56ffe00824948dc9e0023e138d27a32b926\",\"urn:rulespec:document-understanding:assertion:06243abee572b038f23979b13a99cddf3e6f7bee38454c433398eef59556aa3c\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"effective_periods\":[],\"end\":2386,\"evidence\":[{\"end\":2386,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa150f4ee3b06251ce1b4533a18231db38769787697dbaee26861e227c43e353a:1578:2386:sha256-83916a909e28b50c3312da2eb87b8cec508edf844f37aae0b6ab9c59915e8b04\",\"quote\":\"c. INs are standardized notices that provide passport bearers with information about their passports. For example, an IN may be included to explain why the passport was limited in validity, and/or what documentation is needed to obtain a fully valid passport. The INs have been carefully crafted to communicate this information clearly and accurately. Consequently, no changes or alterations to the INs may be made unilaterally at passport agencies/centers without the approval of CA/PPT/S/A except in extenuating circumstances on a case-by-case basis with the approval of passport agency/center management, e.g., when using an endorsement 46 to limit a passport for a special problem. INs do not require a response from the applicant and do not need to be personalized with the applicant's name and address.\",\"start\":1578},{\"end\":1992,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa150f4ee3b06251ce1b4533a18231db38769787697dbaee26861e227c43e353a:1944:1992:sha256-57373b2c123a91b4a6be8da7c30625385e16fb61f8289da2989179392eb72a56\",\"quote\":\"no changes or alterations to the INs may be made\",\"start\":1944}],\"id\":\"urn:rulespec:document-understanding:revision:2e803367b7edf6cc6c960fe87a516929fbe49a6461b4dbebb7a372db43efd0c7\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"prohibition\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:06243abee572b038f23979b13a99cddf3e6f7bee38454c433398eef59556aa3c\",\"modality\":\"must_not\",\"modality_quote\":\"no changes or alterations to the INs may be made\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:e891efbad73bd97934c77f26025f6775f0bb3ae8a507d45e01003fdb4fea0456\",\"origin\":\"aiSuggested\",\"quote\":\"c. INs are standardized notices that provide passport bearers with information about their passports. For example, an IN may be included to explain why the passport was limited in validity, and/or what documentation is needed to obtain a fully valid passport. The INs have been carefully crafted to communicate this information clearly and accurately. Consequently, no changes or alterations to the INs may be made unilaterally at passport agencies/centers without the approval of CA/PPT/S/A except in extenuating circumstances on a case-by-case basis with the approval of passport agency/center management, e.g., when using an endorsement 46 to limit a passport for a special problem. INs do not require a response from the applicant and do not need to be personalized with the applicant's name and address.\",\"references\":[\"CA/PPT/S/A\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:6897b5b52f331f558d50d1e1d74aa47a0b6a65fab54bc7628191f68173b425a1\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":1578,\"summary\":\"No changes or alterations to the INs may be made unilaterally at passport agencies/centers without the approval of CA/PPT/S/A, except in extenuating circumstances on a case-by-case basis with the approval of passport agency/center management (e.g., when using an endorsement 46 to limit a passport for a special problem).\",\"target_ids\":[],\"typed_values\":[]}",

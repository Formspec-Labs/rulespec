        "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa150f4ee3b06251ce1b4533a18231db38769787697dbaee26861e227c43e353a:1578:2386:sha256-83916a909e28b50c3312da2eb87b8cec508edf844f37aae0b6ab9c59915e8b04",

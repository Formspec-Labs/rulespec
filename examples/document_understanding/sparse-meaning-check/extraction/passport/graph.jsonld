    {
      "@id": "urn:rulespec:document-understanding:revision:99200aa4a9a3ba1ccf9b0f50f13328108fdf76c1007c6c0e4ca50d3e145ae162",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:99200aa4a9a3ba1ccf9b0f50f13328108fdf76c1007c6c0e4ca50d3e145ae162",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:254f709115338f67be348719d963ac5d8947e130eba3a0f6f7f202449be32f8b",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:1f986b06febc503107a297b1a90299f7264e2ef8c56724bd0ea83e768a4504d3\",\"urn:rulespec:document-understanding:assertion:6875296589c3000290be60929b20c9f525d63880ae2681e5d12d92a2679b2956\",\"urn:rulespec:document-understanding:assertion:6919e978a3e9ef1d6a9cf61ac4615122d1c91a0f22acd81335bf99e7af546bca\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"effective_periods\":[],\"end\":2386,\"evidence\":[{\"end\":2386,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa150f4ee3b06251ce1b4533a18231db38769787697dbaee26861e227c43e353a:1578:2386:sha256-83916a909e28b50c3312da2eb87b8cec508edf844f37aae0b6ab9c59915e8b04\",\"quote\":\"c. INs are standardized notices that provide passport bearers with information about their passports. For example, an IN may be included to explain why the passport was limited in validity, and/or what documentation is needed to obtain a fully valid passport. The INs have been carefully crafted to communicate this information clearly and accurately. Consequently, no changes or alterations to the INs may be made unilaterally at passport agencies/centers without the approval of CA/PPT/S/A except in extenuating circumstances on a case-by-case basis with the approval of passport agency/center management, e.g., when using an endorsement 46 to limit a passport for a special problem. INs do not require a response from the applicant and do not need to be personalized with the applicant's name and address.\",\"start\":1578}],\"id\":\"urn:rulespec:document-understanding:revision:99200aa4a9a3ba1ccf9b0f50f13328108fdf76c1007c6c0e4ca50d3e145ae162\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"definition\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:6919e978a3e9ef1d6a9cf61ac4615122d1c91a0f22acd81335bf99e7af546bca\",\"modality\":\"not_stated\",\"modality_quote\":\"\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:7822d78dbe3addee465cfd354619ca217c2fe36964fb5b1a6814a2cd1b49bcca\",\"origin\":\"aiSuggested\",\"quote\":\"c. INs are standardized notices that provide passport bearers with information about their passports. For example, an IN may be included to explain why the passport was limited in validity, and/or what documentation is needed to obtain a fully valid passport. The INs have been carefully crafted to communicate this information clearly and accurately. Consequently, no changes or alterations to the INs may be made unilaterally at passport agencies/centers without the approval of CA/PPT/S/A except in extenuating circumstances on a case-by-case basis with the approval of passport agency/center management, e.g., when using an endorsement 46 to limit a passport for a special problem. INs do not require a response from the applicant and do not need to be personalized with the applicant's name and address.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:7da65826c272e38155c33bb0d437165aed8a337534818be118fc388f0675f957\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":1578,\"summary\":\"INs are standardized notices that provide passport bearers with information about their passports (for example, an IN may be included to explain why the passport was limited in validity, and/or what documentation is needed to obtain a fully valid passport).\",\"target_ids\":[],\"typed_values\":[]}",

      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:9702677c0de987852d204fe5ddf27aef4155a86266b4a46b5de26e3628e7c84d\",\"urn:rulespec:document-understanding:assertion:aa180053552c49d9726b964de48aab7d99c67978bb3e5a64d789d43b8ecb09d5\",\"urn:rulespec:document-understanding:assertion:f967fd72277ad0ee70e829c4e9b2ac5d2f3d7e53e4e9611ee7bd8f6dc004d18e\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"effective_periods\":[],\"end\":2386,\"evidence\":[{\"end\":2386,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa150f4ee3b06251ce1b4533a18231db38769787697dbaee26861e227c43e353a:1578:2386:sha256-83916a909e28b50c3312da2eb87b8cec508edf844f37aae0b6ab9c59915e8b04\",\"quote\":\"c. INs are standardized notices that provide passport bearers with information about their passports. For example, an IN may be included to explain why the passport was limited in validity, and/or what documentation is needed to obtain a fully valid passport. The INs have been carefully crafted to communicate this information clearly and accurately. Consequently, no changes or alterations to the INs may be made unilaterally at passport agencies/centers without the approval of CA/PPT/S/A except in extenuating circumstances on a case-by-case basis with the approval of passport agency/center management, e.g., when using an endorsement 46 to limit a passport for a special problem. INs do not require a response from the applicant and do not need to be personalized with the applicant's name and address.\",\"start\":1578},{\"end\":2282,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa150f4ee3b06251ce1b4533a18231db38769787697dbaee26861e227c43e353a:2268:2282:sha256-286d45f3c118838fab430532a5de93c7b6eb8cd9f6d9e5a99718e78b9b94f97b\",\"quote\":\"do not require\",\"start\":2268}],\"id\":\"urn:rulespec:document-understanding:revision:52876317ef7100e7c3bef60e1380e218a716b6a8aa0f6673e9e8dccd455d1287\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"exemption\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:f967fd72277ad0ee70e829c4e9b2ac5d2f3d7e53e4e9611ee7bd8f6dc004d18e\",\"modality\":\"not_required\",\"modality_quote\":\"do not require\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:908cfd7c5affc54e440c98c9ca1417799c71facb61404710e9c5e4e7f16e7744\",\"origin\":\"aiSuggested\",\"quote\":\"c. INs are standardized notices that provide passport bearers with information about their passports. For example, an IN may be included to explain why the passport was limited in validity, and/or what documentation is needed to obtain a fully valid passport. The INs have been carefully crafted to communicate this information clearly and accurately. Consequently, no changes or alterations to the INs may be made unilaterally at passport agencies/centers without the approval of CA/PPT/S/A except in extenuating circumstances on a case-by-case basis with the approval of passport agency/center management, e.g., when using an endorsement 46 to limit a passport for a special problem. INs do not require a response from the applicant and do not need to be personalized with the applicant's name and address.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:99ecdcb33601065cb46ead1db6b03be300ed29286531d58b15d9e1f7caee492e\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":1578,\"summary\":\"INs do not require a response from the applicant and do not need to be personalized with the applicant's name and address.\",\"target_ids\":[],\"typed_values\":[]}",

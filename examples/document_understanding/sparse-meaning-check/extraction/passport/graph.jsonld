      "@id": "urn:rulespec:document-understanding:revision:b58a5e76c96df2cc53a13707a4a0d4bc366d1d8859e73a387f79ba9e8f5bd34d",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:b58a5e76c96df2cc53a13707a4a0d4bc366d1d8859e73a387f79ba9e8f5bd34d",

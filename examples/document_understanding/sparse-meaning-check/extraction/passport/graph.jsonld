      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:0a06842be180db21b832f6eadb0d35d7c88c3810d4fd0a4b19c7617848321b90\",\"urn:rulespec:document-understanding:assertion:4c2e2f06f6154b377fa2da6d68cf27bccde28f8f5b8a89857cc640a4ee0418f8\",\"urn:rulespec:document-understanding:assertion:0b15c578f992266e4f2a3482d16f1e22d5e3f58c32a4436ac7123651f41c5d0e\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"effective_periods\":[],\"end\":651,\"evidence\":[{\"end\":651,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa150f4ee3b06251ce1b4533a18231db38769787697dbaee26861e227c43e353a:200:651:sha256-19325de2fb1e6e628b7e6a6f83a16314ca28f7891a3c2c4916d0f2afa2a0ffd5\",\"quote\":\"b. IRLs are personalized, standardized letters with a date and signature block that request from the applicant additional information, documentation, or action needed to process the passport application. You must fully adjudicate the application prior to suspending to ensure that you are addressing all issues. The IRLs have been carefully crafted to communicate clearly and accurately statutory, regulatory, and other requirements of the Department.\",\"start\":200}],\"id\":\"urn:rulespec:document-understanding:revision:1ed0f49419061bdd7103e0818baa3bbacbccef0dfb9cec1ac883ec6577115b1e\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"statement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:0b15c578f992266e4f2a3482d16f1e22d5e3f58c32a4436ac7123651f41c5d0e\",\"modality\":\"not_stated\",\"modality_quote\":\"\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:8b2468f53cef1c2dfea45853c2c6ac8ea1ff7ef4b0cd3fdfb00eab4e43482055\",\"origin\":\"aiSuggested\",\"quote\":\"b. IRLs are personalized, standardized letters with a date and signature block that request from the applicant additional information, documentation, or action needed to process the passport application. You must fully adjudicate the application prior to suspending to ensure that you are addressing all issues. The IRLs have been carefully crafted to communicate clearly and accurately statutory, regulatory, and other requirements of the Department.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:1832234c8b1ad09fcedab0efab107b1dcb3ae4736687e9a60627d4a9f7a73f6d\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":200,\"summary\":\"The IRLs have been carefully crafted to communicate clearly and accurately statutory, regulatory, and other requirements of the Department.\",\"target_ids\":[],\"typed_values\":[]}",

            "text": "{\n  \"proposals\": [\n    {\n      \"rationale\": \"Recover the missing substantive guidance from the NOTE regarding photographs re-used from Certificates of Citizenship or Naturalization, which may not satisfy the six-month recency requirement due to USCIS processing times.\",\n      \"operation\": \"add\",\n      \"target\": \"\",\n      \"qualifies\": [],\n      \"quote\": \"Be aware that even if the certificate itself was recently issued, because of U.S. Citizenship and Immigration Services processing times, the photograph may not have been taken within six months of submitting the application.\",\n      \"fields\": {\n        \"kind\": \"statement\",\n        \"scope_quotes\": [\n          \"Applicants may wish to re-use a passport photograph that is depicted on their submitted U.S Certificate of Citizenship or Certificate of Naturalization.\"\n        ],\n        \"scope_text\": \"When applicants wish to re-use a passport photograph depicted on their submitted U.S. Certificate of Citizenship or Certificate of Naturalization.\",\n        \"context_quotes\": [],\n        \"modality_quote\": \"may not have been\",\n        \"modality\": \"possible\",\n        \"alternative_quotes\": [\n          \"U.S Certificate of Citizenship\",\n          \"Certificate of Naturalization\"\n        ],\n        \"choice_quote\": \"U.S Certificate of Citizenship or Certificate of Naturalization\",\n        \"choice_text\": \"U.S Certificate of Citizenship OR Certificate of Naturalization\",\n        \"logic_text\": \"even if the certificate itself was recently issued, because of U.S. Citizenship and Immigration Services processing times, the photograph may not have been taken within six months of submitting the application\",\n        \"actor_quote\": \"\",\n        \"actor\": \"\",\n        \"action_quote\": \"taken within six months of submitting the application\",\n        \"action\": \"taken within six months of submitting the application\",\n        \"object_quote\": \"the photograph\",\n        \"object\": \"the photograph\",\n        \"jurisdiction_quote\": \"\",\n        \"jurisdiction\": \"\",\n        \"relation\": \"none\",\n        \"references\": [],\n        \"summary\": \"Even if a submitted U.S. Certificate of Citizenship or Certificate of Naturalization was recently issued, the photograph depicted on it may not have been taken within six months of submitting the application due to USCIS processing times.\"\n      }\n    }\n  ],\n  \"observations\": [\n    {\n      \"quote\": \"The goal is the best likeness that can reasonably be obtained:\",\n      \"rationale\": \"This introductory statement expresses an overarching aspirational objective rather than an independent actionable duty, and is already captured as context on C0000 and C0001.\",\n      \"disposition\": \"already_represented\"\n    }\n  ]\n}",

            "text": "{\n  \"proposals\": [\n    {\n      \"rationale\": \"Update C0002 to explicitly incorporate the exception for married names in 8 FAM 403.1-4(C) into both the scope text, scope quotes, and summary.\",\n      \"operation\": \"edit\",\n      \"target\": \"C0002\",\n      \"qualifies\": [],\n      \"quote\": \"Material discrepancies between the name recorded on the application, the applicant's evidence of U.S. citizenship/non-citizen U.S. nationality, or the evidence of identity must be documented by submission of one or more of the documents listed in this section (see an exception for married names in 8 FAM 403.1-4(C)). Acceptable means of documenting a material name change include (per 22 CFR 51.25):\\n\\n(1) Court orders or decrees:\\n\\n(a) Name change orders; or\\n\\n(b) Divorce decrees;\\n\\n(2) Certificates of naturalization;\\n\\n(3) Marriage certificates;\\n\\n(4) Documentation demonstrating change of name by operation of state law; or\\n\\n(5) Documentation of customary usage.\",\n      \"fields\": {\n        \"kind\": \"requirement\",\n        \"scope_quotes\": [\n          \"between the name recorded on the application, the applicant's evidence of U.S. citizenship/non-citizen U.S. nationality, or the evidence of identity\",\n          \"(see an exception for married names in 8 FAM 403.1-4(C))\"\n        ],\n        \"scope_text\": \"Applies when there are material discrepancies between the name recorded on the application, the applicant's evidence of U.S. citizenship/non-citizen U.S. nationality, or the evidence of identity, subject to an exception for married names in 8 FAM 403.1-4(C).\",\n        \"context_quotes\": [\n          \"(per 22 CFR 51.25)\"\n        ],\n        \"modality_quote\": \"must\",\n        \"modality\": \"must\",\n        \"alternative_quotes\": [\n          \"Court orders or decrees:\\n\\n(a) Name change orders; or\\n\\n(b) Divorce decrees\",\n          \"Certificates of naturalization\",\n          \"Marriage certificates\",\n          \"Documentation demonstrating change of name by operation of state law\",\n          \"Documentation of customary usage\"\n        ],\n        \"choice_quote\": \"one or more of the documents listed in this section\",\n        \"choice_text\": \"one or more of: Court orders or decrees (Name change orders OR Divorce decrees); Certificates of naturalization; Marriage certificates; Documentation demonstrating change of name by operation of state law; OR Documentation of customary usage\",\n        \"logic_text\": \"one or more of the documents listed in this section\",\n        \"actor_quote\": \"\",\n        \"actor\": \"\",\n        \"action_quote\": \"must be documented by submission of\",\n        \"action\": \"document by submission of\",\n        \"object_quote\": \"Material discrepancies between the name recorded on the application, the applicant's evidence of U.S. citizenship/non-citizen U.S. nationality, or the evidence of identity\",\n        \"object\": \"Material discrepancies between the name recorded on the application, the applicant's evidence of U.S. citizenship/non-citizen U.S. nationality, or the evidence of identity\",\n        \"jurisdiction_quote\": \"\",\n        \"jurisdiction\": \"\",\n        \"relation\": \"none\",\n        \"references\": [\n          \"8 FAM 403.1-4(C)\",\n          \"22 CFR 51.25\"\n        ],\n        \"summary\": \"Material discrepancies between the name recorded on the application, evidence of U.S. citizenship/non-citizen U.S. nationality, or evidence of identity must be documented by submitting one or more listed acceptable documents, subject to an exception for married names in 8 FAM 403.1-4(C).\"\n      }\n    },\n    {\n      \"rationale\": \"Recover the missing substantive guidance from 8 FAM 403.1-4(d)(2) (audit unit U0009) acknowledging that applicants generally need their name change documentation to update the name on their ID.\",\n      \"operation\": \"add\",\n      \"target\": \"\",\n      \"qualifies\": [],\n      \"quote\": \"The applicant generally will need the name change documentation to change the name on her/his ID.\",\n      \"fields\": {\n        \"kind\": \"statement\",\n        \"scope_quotes\": [],\n        \"scope_text\": \"\",\n        \"context_quotes\": [],\n        \"modality_quote\": \"generally will\",\n        \"modality\": \"possible\",\n        \"alternative_quotes\": [],\n        \"choice_quote\": \"\",\n        \"choice_text\": \"\",\n        \"logic_text\": \"generally will need\",\n        \"actor_quote\": \"The applicant\",\n        \"actor\": \"The applicant\",\n        \"action_quote\": \"will need\",\n        \"action\": \"need\",\n        \"object_quote\": \"the name change documentation to change the name on her/his ID\",\n        \"object\": \"the name change documentation to change the name on her/his ID\",\n        \"jurisdiction_quote\": \"\",\n        \"jurisdiction\": \"\",\n        \"relation\": \"none\",\n        \"references\": [],\n        \"summary\": \"The applicant generally will need the name change documentation to change the name on her/his ID.\"\n      }\n    }\n  ],\n  \"observations\": [\n    {\n      \"quote\": \"The applicant's name is an integral part of her/his identity.\",\n      \"rationale\": \"Audit unit U0006 noted this foundational premise was omitted from the explicit logic and summary of C0005, but it is already faithfully represented as explanatory context in C0005.\",\n      \"disposition\": \"already_represented\"\n    }\n  ]\n}",

{
  "model": "gemini-3.8-flash",
  "contents": "Return the empty arrays required by the schema. No source exists and no items exist.",
  "config": {
    "temperature": 0,
    "max_output_tokens": 256,
    "response_mime_type": "application/json",
    "response_json_schema": {
      "type": "object",
      "properties": {
        "proposals": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "rationale": {
                "type": "string",
                "minLength": 1
              },
              "operation": {
                "type": "string",
                "enum": [
                  "add",
                  "edit"
                ]
              },
              "target": {
                "type": "string"
              },
              "qualifies": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "quote": {
                "type": "string",
                "minLength": 1
              },
              "fields": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "authority",
                      "condition",
                      "definition",
                      "exception",
                      "exemption",
                      "permission",
                      "prohibition",
                      "recommendation",
                      "requirement",
                      "statement",
                      "threshold"
                    ],
                    "description": "Semantic kind; must agree with modality and relationship role."
                  },
                  "scope_quotes": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Exact source passages defining the governing conditions, including parent lead-ins outside the main quote."
                  },
                  "scope_text": {
                    "type": "string",
                    "description": "ALL source-supported conditions governing this unit, including inherited parent cases and timing; do not transfer neighboring branch scope."
                  },
                  "context_quotes": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Exact explanatory passages that aid interpretation without asserting conditions."
                  },
                  "modality_quote": {
                    "type": "string",
                    "description": "Exact support for modal force; preserve generally, might, should and negation."
                  },
                  "modality": {
                    "type": "string",
                    "description": "Normative force: must, should, permission may, prohibition must_not, exemption not_required, descriptive possible, not_stated or uncertain.",
                    "enum": [
                      "must",
                      "should",
                      "may",
                      "must_not",
                      "not_required",
                      "possible",
                      "not_stated",
                      "uncertain"
                    ]
                  },
                  "alternative_quotes": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "EVERY exact source option with its qualifying text, not just the list introduction."
                  },
                  "choice_quote": {
                    "type": "string",
                    "description": "One exact contiguous source passage supporting choice/grouping; never join separate phrases with invented separators."
                  },
                  "choice_text": {
                    "type": "string",
                    "description": "Complete source choice/grouping in words, including nested AND/OR and qualifications."
                  },
                  "logic_text": {
                    "type": "string",
                    "description": "Verbatim source wording retaining AND/OR, thresholds, units, dates and negation; no invented executable logic."
                  },
                  "actor_quote": {
                    "type": "string",
                    "description": "Exact source support for actor, including antecedent if needed."
                  },
                  "actor": {
                    "type": "string",
                    "description": "Source-supported responsible person or entity; empty if unstated."
                  },
                  "action_quote": {
                    "type": "string",
                    "description": "Exact source support for action."
                  },
                  "action": {
                    "type": "string",
                    "description": "Source-supported action; empty when inapplicable or unstated."
                  },
                  "object_quote": {
                    "type": "string",
                    "description": "Exact source support for object."
                  },
                  "object": {
                    "type": "string",
                    "description": "What the action concerns; preserve option grouping; empty if unstated."
                  },
                  "jurisdiction_quote": {
                    "type": "string",
                    "description": "Exact source support for jurisdiction; empty when unstated."
                  },
                  "jurisdiction": {
                    "type": "string",
                    "description": "Territorial scope only when explicitly supported in supplied text; never infer from URL."
                  },
                  "relation": {
                    "type": "string",
                    "description": "A condition/exception's relationship to its baseline; none for other kinds.",
                    "enum": [
                      "none",
                      "scope",
                      "prerequisite",
                      "trigger",
                      "exception"
                    ]
                  },
                  "references": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Source section labels for cross-references, including unresolved remote targets."
                  },
                  "summary": {
                    "type": "string",
                    "description": "Complete meaning of this unit, preserving governing scope, qualifications and modal force."
                  }
                },
                "required": [
                  "kind",
                  "scope_quotes",
                  "scope_text",
                  "context_quotes",
                  "modality_quote",
                  "modality",
                  "alternative_quotes",
                  "choice_quote",
                  "choice_text",
                  "logic_text",
                  "actor_quote",
                  "actor",
                  "action_quote",
                  "action",
                  "object_quote",
                  "object",
                  "jurisdiction_quote",
                  "jurisdiction",
                  "relation",
                  "references",
                  "summary"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "rationale",
              "operation",
              "target",
              "qualifies",
              "quote",
              "fields"
            ],
            "additionalProperties": false
          },
          "maxItems": 8
        },
        "observations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "quote": {
                "type": "string",
                "minLength": 1
              },
              "rationale": {
                "type": "string",
                "minLength": 1
              },
              "disposition": {
                "type": "string",
                "enum": [
                  "already_represented",
                  "unresolved"
                ]
              }
            },
            "required": [
              "quote",
              "rationale",
              "disposition"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "proposals",
        "observations"
      ],
      "additionalProperties": false
    }
  }
}

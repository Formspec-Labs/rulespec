            "inline_data": null,
            "text": "{\n  \"units\": [\n    {\n      \"quote\": \"The permittee conducting surface coal mining and reclamation operations on natural slopes that exceed 20 degrees, or on lesser slopes that require measures to protect the area from disturbance, as determined by the regulatory authority after consideration of soils, climate, the method of operation, geology, and other regional characteristics, shall meet the following performance standards.\",\n      \"scope_quotes\": [],\n      \"kind\": \"requirement\",\n      \"meaning\": \"Permittees conducting surface coal mining and reclamation operations on natural slopes exceeding 20 degrees, or on lesser slopes determined by the regulatory authority (after evaluating soils, climate, operational method, geology, and regional characteristics) to require protective measures against disturbance, must comply with the performance standards set forth in this section.\"\n    },\n    {\n      \"quote\": \"The standards of this section do not apply where mining is done on a flat or gently rolling terrain with an occasional steep slope through which the mining proceeds and leaves a plain or predominantly flat area; or where the mining is governed by § 716.3.\",\n      \"scope_quotes\": [],\n      \"kind\": \"exemption\",\n      \"meaning\": \"The steep slope performance standards of this section are not applicable if mining occurs on flat or gently rolling terrain featuring only an occasional steep slope that mining cuts through leaving a plain or predominantly flat area, or if the mining operation is governed by § 716.3.\"\n    },\n    {\n      \"quote\": \"Spoil, waste materials or debris, including that from clearing and grubbing, and abandoned or disabled equipment, shall not be placed or allowed to remain on the downslope.\",\n      \"scope_quotes\": [\n        \"The permittee conducting surface coal mining and reclamation operations on natural slopes that exceed 20 degrees, or on lesser slopes that require measures to protect the area from disturbance, as determined by the regulatory authority after consideration of soils, climate, the method of operation, geology, and other regional characteristics, shall meet the following performance standards.\"\n      ],\n      \"kind\": \"prohibition\",\n      \"meaning\": \"In covered operations, operators are prohibited from placing or allowing spoil, waste materials, debris (including clearing and grubbing debris), or abandoned or disabled equipment to remain on the downslope.\"\n    },\n    {\n      \"quote\": \"The highwall shall be completely covered with spoil and the disturbed are a graded to comply with the provisions of § 715.14 of this chapter.\",\n      \"scope_quotes\": [\n        \"The permittee conducting surface coal mining and reclamation operations on natural slopes that exceed 20 degrees, or on lesser slopes that require measures to protect the area from disturbance, as determined by the regulatory authority after consideration of soils, climate, the method of operation, geology, and other regional characteristics, shall meet the following performance standards.\"\n      ],\n      \"kind\": \"requirement\",\n      \"meaning\": \"In covered operations, the highwall must be entirely covered with spoil, and the disturbed area must be graded to satisfy all requirements of § 715.14.\"\n    },\n    {\n      \"quote\": \"Land above the highwall shall not be disturbed unless the regulatory authority finds that the disturbance will facilitate compliance with the requirements of this section.\",\n      \"scope_quotes\": [\n        \"The permittee conducting surface coal mining and reclamation operations on natural slopes that exceed 20 degrees, or on lesser slopes that require measures to protect the area from disturbance, as determined by the regulatory authority after consideration of soils, climate, the method of operation, geology, and other regional characteristics, shall meet the following performance standards.\"\n      ],\n      \"kind\": \"prohibition\",\n      \"meaning\": \"In covered operations, disturbing land above the highwall is prohibited unless the regulatory authority specifically finds that disturbing such land will facilitate compliance with the requirements of this section.\"\n    },\n    {\n      \"quote\": \"Material in excess of that required to meet the provisions of § 715.14 of this chapter shall be disposed of in accordance with the requirements of § 715.15 of this chapter.\",\n      \"scope_quotes\": [\n        \"The permittee conducting surface coal mining and reclamation operations on natural slopes that exceed 20 degrees, or on lesser slopes that require measures to protect the area from disturbance, as determined by the regulatory authority after consideration of soils, climate, the method of operation, geology, and other regional characteristics, shall meet the following performance standards.\"\n      ],\n      \"kind\": \"requirement\",\n      \"meaning\": \"In covered operations, any material exceeding the quantity needed to comply with § 715.14 must be disposed of in compliance with § 715.15.\"\n    },\n    {\n      \"quote\": \"Woody materials may be buried in the backfilled area only when burial does not cause, or add to, instability of the backfill.\",\n      \"scope_quotes\": [\n        \"The permittee conducting surface coal mining and reclamation operations on natural slopes that exceed 20 degrees, or on lesser slopes that require measures to protect the area from disturbance, as determined by the regulatory authority after consideration of soils, climate, the method of operation, geology, and other regional characteristics, shall meet the following performance standards.\"\n      ],\n      \"kind\": \"permission\",\n      \"meaning\": \"In covered operations, burying woody materials in the backfilled area is permitted solely under the condition that burial neither causes nor increases instability in the backfill.\"\n    },\n    {\n      \"quote\": \"Woody materials may be chipped and distributed through the backfill when approved by the regulatory authority.\",\n      \"scope_quotes\": [\n        \"The permittee conducting surface coal mining and reclamation operations on natural slopes that exceed 20 degrees, or on lesser slopes that require measures to protect the area from disturbance, as determined by the regulatory authority after consideration of soils, climate, the method of operation, geology, and other regional characteristics, shall meet the following performance standards.\"\n      ],\n      \"kind\": \"permission\",\n      \"meaning\": \"In covered operations, operators are permitted to chip and distribute woody materials throughout the backfill only if approved by the regulatory authority.\"\n    }\n  ]\n}",

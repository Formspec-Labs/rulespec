        {
          "source_id": "urn:rulespec:document-understanding:document:2121d7a65944c6bcd169c568eaf6ab38642f378ca63195763b375de54c91c10c",
          "quote": "Land above the highwall shall not be disturbed unless the regulatory authority finds that the disturbance will facilitate compliance with the requirements of this section.",

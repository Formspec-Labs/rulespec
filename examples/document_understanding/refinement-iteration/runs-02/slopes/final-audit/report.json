      "rationale": "C0002 covers the prohibition against placing or leaving spoil, debris, and disabled equipment on the downslope.",
      "source_spans": [
        {
          "source_id": "urn:rulespec:document-understanding:document:2121d7a65944c6bcd169c568eaf6ab38642f378ca63195763b375de54c91c10c",
          "quote": "Spoil, waste materials or debris, including that from clearing and grubbing, and abandoned or disabled equipment, shall not be placed or allowed to remain on the downslope.",
          "start": 654,
          "end": 826
        }
      ]
    },

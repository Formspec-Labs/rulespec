      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"finds that the disturbance will facilitate compliance with the requirements of this section\",\"actor\":\"the regulatory authority\",\"alternative_quotes\":[],\"applies_to\":[\"Land above the highwall shall not be disturbed unless the regulatory authority finds that the disturbance will facilitate compliance with the requirements of this section.\"],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:1d89550484755c243a420058da16d654b7711dd383bc87faa3520dcbd236f107\",\"urn:rulespec:document-understanding:assertion:f93d76127d5e51f44a7706a531ef2715333a632f2e83d61398560273755d46f5\",\"urn:rulespec:document-understanding:assertion:89f4a1f6d4e1145fd4138a900e8fc452a7ddc439ec077e34953e90cd8d8bd38d\",\"urn:rulespec:document-understanding:assertion:681ac8b38055caf334b2a37e990b585fe893898ad43a2b5052c49811138ddabf\",\"urn:rulespec:document-understanding:assertion:c191de8d2f47ad5518fb87681162ff5ba07f7bff3ea85e1b552be47307e3acd0\",\"urn:rulespec:document-understanding:assertion:458170a81a11e6d867d4521a99bdde620d43d1ab17889402c75f8fca3b912806\",\"urn:rulespec:document-understanding:assertion:3594cfcea6bc2824ea2dc948e0a054144ce9f8564c5085be7281dbb154661263\",\"urn:rulespec:document-understanding:assertion:81cbe55e30af89dcd7c0f9864001af313fc3c1ab68ada4c210647da914fde10a\",\"urn:rulespec:document-understanding:assertion:0bf59320b1845d184c3de07e7c42aeb7ea5e24d2424f6a13f9ad5dd62ff26d2d\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"context_quotes\":[],\"end\":1144,\"evidence\":[{\"end\":1144,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A2121d7a65944c6bcd169c568eaf6ab38642f378ca63195763b375de54c91c10c:1021:1144:sha256-58b73df7a1b48c1fe8c3e9f83a38b8686a4ac0450b6a0063d94979dad1f659f8\",\"quote\":\"unless the regulatory authority finds that the disturbance will facilitate compliance with the requirements of this section\",\"start\":1021},{\"end\":1052,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A2121d7a65944c6bcd169c568eaf6ab38642f378ca63195763b375de54c91c10c:1028:1052:sha256-c24cd660748abadcce4d514aa4f0d3870f28eba67d9a5349e7823eab7dbd2234\",\"quote\":\"the regulatory authority\",\"start\":1028},{\"end\":1058,\"field\":\"action\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A2121d7a65944c6bcd169c568eaf6ab38642f378ca63195763b375de54c91c10c:1053:1058:sha256-2149c64d00134c01cf475036ce41c879bd4a75ad6968301c4566437ed8fb313d\",\"quote\":\"finds\",\"start\":1053},{\"end\":1079,\"field\":\"object\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A2121d7a65944c6bcd169c568eaf6ab38642f378ca63195763b375de54c91c10c:1064:1079:sha256-db7d1c9f2958f889bc00806af8107f7b97f81e160cefd99c9d170a4ea12520e7\",\"quote\":\"the disturbance\",\"start\":1064},{\"end\":1144,\"field\":\"logic_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A2121d7a65944c6bcd169c568eaf6ab38642f378ca63195763b375de54c91c10c:1021:1144:sha256-58b73df7a1b48c1fe8c3e9f83a38b8686a4ac0450b6a0063d94979dad1f659f8\",\"quote\":\"unless the regulatory authority finds that the disturbance will facilitate compliance with the requirements of this section\",\"start\":1021},{\"end\":392,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A2121d7a65944c6bcd169c568eaf6ab38642f378ca63195763b375de54c91c10c:0:392:sha256-9afce8cab4fa0be3a73a3ca1fafe0da545a5e86f1904605d24ab51c42d4589cb\",\"quote\":\"The permittee conducting surface coal mining and reclamation operations on natural slopes that exceed 20 degrees, or on lesser slopes that require measures to protect the area from disturbance, as determined by the regulatory authority after consideration of soils, climate, the method of operation, geology, and other regional characteristics, shall meet the following performance standards.\",\"start\":0}],\"id\":\"urn:rulespec:document-understanding:revision:1d485d24c1529482fcd40c9b5a4a49319bcf2500d97c87f2af1f5620b22a32d9\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"exception\",\"logic_text\":\"unless the regulatory authority finds that the disturbance will facilitate compliance with the requirements of this section\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:81cbe55e30af89dcd7c0f9864001af313fc3c1ab68ada4c210647da914fde10a\",\"modality\":\"not_stated\",\"modality_quote\":\"\",\"object\":\"the disturbance\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:90a98b4a5743965fdba89e8a4f08077eff7fc26dceac754ac90c34a6b4cb1581\",\"origin\":\"aiSuggested\",\"quote\":\"unless the regulatory authority finds that the disturbance will facilitate compliance with the requirements of this section\",\"references\":[],\"relation\":\"exception\",\"rule_id\":\"urn:rulespec:document-understanding:rule:ae6e9bd1bde7c773945c3c8d9725f5bfe98a3423bef4977171bf5e0c877a1c10\",\"scope_quotes\":[\"The permittee conducting surface coal mining and reclamation operations on natural slopes that exceed 20 degrees, or on lesser slopes that require measures to protect the area from disturbance, as determined by the regulatory authority after consideration of soils, climate, the method of operation, geology, and other regional characteristics, shall meet the following performance standards.\"],\"scope_text\":\"Governed by steep slope operations under this section, where mining is not on flat/gently rolling terrain leaving a flat area and not governed by § 716.3.\",\"section_id\":\"section-1\",\"start\":1021,\"summary\":\"The prohibition on disturbing land above the highwall does not apply if the regulatory authority finds that the disturbance will facilitate compliance with this section.\",\"target_ids\":[\"urn:rulespec:document-understanding:revision:2f6a8e75000a4c9631bcb0b576cd4e2fe796d545ee02a478a3d6d79fd45789df\"]}",

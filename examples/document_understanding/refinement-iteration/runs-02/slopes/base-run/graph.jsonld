      "rkaf:assertsValue": {
        "@value": "{\"action\":\"do not apply\",\"actor\":\"\",\"alternative_quotes\":[\"where mining is done on a flat or gently rolling terrain with an occasional steep slope through which the mining proceeds and leaves a plain or predominantly flat area\",\"where the mining is governed by § 716.3\"],\"choice_text\":\"where mining is done on flat or gently rolling terrain with an occasional steep slope leaving a plain/predominantly flat area OR where mining is governed by § 716.3\",\"jurisdiction\":\"\",\"kind\":\"exception\",\"logic_text\":\"where mining is done on a flat or gently rolling terrain with an occasional steep slope through which the mining proceeds and leaves a plain or predominantly flat area; or where the mining is governed by § 716.3\",\"modality\":\"not_stated\",\"object\":\"The standards of this section\",\"scope_text\":\"\",\"summary\":\"The performance standards do not apply where mining occurs on flat or gently rolling terrain leaving a plain or predominantly flat area, or where mining is governed by § 716.3.\"}",
        "@type": "xsd:string"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

      "dcterms:description": "{\"action\":\"does not cause, or add to, instability of the backfill\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[\"Woody materials may be buried in the backfilled area only when burial does not cause, or add to, instability of the backfill.\"],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:726bf01bb5639a6d109ab64f78569312910d1d7ef6359503b6be9f426418f27f\",\"urn:rulespec:document-understanding:assertion:4f5427ddb0b7e3708a2cfa2b3c0ecaad2569f7276f6f5ef044202c8c582ec303\",\"urn:rulespec:document-understanding:assertion:5a0b81c5dc3af674797dd6066bbd56a960e9537564a7f628629e2e00502964dc\",\"urn:rulespec:document-understanding:assertion:37abeff0389597d5de52a65062dc9860ac23e21f7ccaa4554230196334790b91\",\"urn:rulespec:document-understanding:assertion:9ef71f3a6707347359ec5af74897ab80c67cd4bccadb4c03e01df56f321c1d9b\",\"urn:rulespec:document-understanding:assertion:231bf007b49cb9bd6bd8392c288bead8268162a1421bed6a3b021af456918dc7\",\"urn:rulespec:document-understanding:assertion:537f95172a2b7882b3023495f59968ccbf9954f56e2521bfa395fdd208fe0ce9\",\"urn:rulespec:document-understanding:assertion:b622b2bf898ef68e2e2811567ab283ff9c06e1ee40d183824748cb3173441d87\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"context_quotes\":[],\"end\":1453,\"evidence\":[{\"end\":1453,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A2121d7a65944c6bcd169c568eaf6ab38642f378ca63195763b375de54c91c10c:1382:1453:sha256-b41e9ad4733d54033959c659be00d61316ccf5feb7462abeee78b3a217becd88\",\"quote\":\"only when burial does not cause, or add to, instability of the backfill\",\"start\":1382},{\"end\":1437,\"field\":\"action\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A2121d7a65944c6bcd169c568eaf6ab38642f378ca63195763b375de54c91c10c:1399:1437:sha256-a945ab15c1c617223b5811f3a3227c110c466058dcbb43e9767c854cd8d3d7e5\",\"quote\":\"does not cause, or add to, instability\",\"start\":1399},{\"end\":1453,\"field\":\"object\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A2121d7a65944c6bcd169c568eaf6ab38642f378ca63195763b375de54c91c10c:1426:1453:sha256-1b346c1d9c0ec3e18cf6a60042065617fe1796b90a5fb166423ea7496fe00c81\",\"quote\":\"instability of the backfill\",\"start\":1426},{\"end\":1453,\"field\":\"logic_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A2121d7a65944c6bcd169c568eaf6ab38642f378ca63195763b375de54c91c10c:1382:1453:sha256-b41e9ad4733d54033959c659be00d61316ccf5feb7462abeee78b3a217becd88\",\"quote\":\"only when burial does not cause, or add to, instability of the backfill\",\"start\":1382},{\"end\":392,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A2121d7a65944c6bcd169c568eaf6ab38642f378ca63195763b375de54c91c10c:0:392:sha256-9afce8cab4fa0be3a73a3ca1fafe0da545a5e86f1904605d24ab51c42d4589cb\",\"quote\":\"The permittee conducting surface coal mining and reclamation operations on natural slopes that exceed 20 degrees, or on lesser slopes that require measures to protect the area from disturbance, as determined by the regulatory authority after consideration of soils, climate, the method of operation, geology, and other regional characteristics, shall meet the following performance standards.\",\"start\":0}],\"id\":\"urn:rulespec:document-understanding:revision:35c282e8b3455ec84602d81a1a92c0208c61d7e2107081dc707d07d863128c3a\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"condition\",\"logic_text\":\"only when burial does not cause, or add to, instability of the backfill\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:537f95172a2b7882b3023495f59968ccbf9954f56e2521bfa395fdd208fe0ce9\",\"modality\":\"not_stated\",\"modality_quote\":\"\",\"object\":\"instability of the backfill\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:ee69b87bbe2938593e917660c23ead29aba14e9b64b200d1f8acf097e42362a5\",\"origin\":\"aiSuggested\",\"quote\":\"only when burial does not cause, or add to, instability of the backfill\",\"references\":[],\"relation\":\"prerequisite\",\"rule_id\":\"urn:rulespec:document-understanding:rule:341c9a469255431d56ae6f2256d92812951e8c5d84ea6716cb9ad1e6434acb37\",\"scope_quotes\":[\"The permittee conducting surface coal mining and reclamation operations on natural slopes that exceed 20 degrees, or on lesser slopes that require measures to protect the area from disturbance, as determined by the regulatory authority after consideration of soils, climate, the method of operation, geology, and other regional characteristics, shall meet the following performance standards.\"],\"scope_text\":\"Governed by steep slope operations under this section, where mining is not on flat/gently rolling terrain leaving a flat area and not governed by § 716.3.\",\"section_id\":\"section-1\",\"start\":1382,\"summary\":\"Burying woody materials in the backfilled area requires that the burial does not cause or add to instability of the backfill.\",\"target_ids\":[\"urn:rulespec:document-understanding:revision:15b9516fae43d370b93adaf5e5c3421951049fb6ac080eb16fbf920931e58149\"]}",

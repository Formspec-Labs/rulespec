s\",\"start\":14},{\"end\":112,\"field\":\"alternative:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A2121d7a65944c6bcd169c568eaf6ab38642f378ca63195763b375de54c91c10c:72:112:sha256-9fbaea906bb7120a33d9360cfadbd9f1a81932a56c40b479a63f637b98edfb73\",\"quote\":\"on natural slopes that exceed 20 degrees\",\"start\":72},{\"end\":343,\"field\":\"alternative:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A2121d7a65944c6bcd169c568eaf6ab38642f378ca63195763b375de54c91c10c:117:343:sha256-19ac68cf8901bae07a11f34ac29a43b22d117a83baeb92a91ed761f735db6e4f\",\"quote\":\"on lesser slopes that require measures to protect the area from disturbance, as determined by the regulatory authority after consideration of soils, climate, the method of operation, geology, and other regional characteristics\",\"start\":117}],\"id\":\"urn:rulespec:document-understanding:revision:5475def59ffd01966c599094b64d30bcef8af5afaa0d274a6df369b89332e35a\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"on natural slopes that exceed 20 degrees, or on lesser slopes that require measures to protect the area from disturbance, as determined by the regulatory authority after consideration of soils, climate, the method of operation, geology, and other regional characteristics\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:2477a3756d5cbc92964e59d889c32d845ed894e07e93495f79b49456c13d3a73\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"the following performance standards\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:a7f463840696f885be8f3a4f65646aa3377e865e899c75f42b32f8ee8ad4c0df\",\"origin\":\"aiSuggested\",\"quote\":\"The permittee conducting surface coal mining and reclamation operations on natural slopes that exceed 20 degrees, or on lesser slopes that require measures to protect the area from disturbance, as determined by the regulatory authority after consideration of soils, climate, the method of operation, geology, and other regional characteristics, shall meet the following performance standards.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:a3bc008d98eb72525cab615bd7ee4831084eeefe6759a2ab55bc8a52376f9ce4\",\"scope_quotes\":[\"conducting surface coal mining and reclamation operations on natural slopes that exceed 20 degrees, or on lesser slopes that require measures to protect the area from disturbance, as determined by the regulatory authority after consideration of soils, climate, the method of operation, geology, and other regional characteristics\"],\"scope_text\":\"Applies to permittees conducting surface coal mining and reclamation operations on natural slopes exceeding 20 degrees, or on lesser slopes requiring measures to protect the area from disturbance as determined by the regulatory authority after considering soils, climate, operation method, geology, and other regional characteristics.\",\"section_id\":\"section-1\",\"start\":0,\"summary\":\"Permittees conducting surface coal mining and reclamation operations on natural slopes over 20 degrees or specified lesser slopes must meet the performance standards of this section.\",\"target_ids\":[]}",

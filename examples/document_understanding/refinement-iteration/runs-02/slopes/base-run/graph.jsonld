      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"do not apply\",\"actor\":\"\",\"alternative_quotes\":[\"where mining is done on a flat or gently rolling terrain with an occasional steep slope through which the mining proceeds and leaves a plain or predominantly flat area\",\"where the mining is governed by § 716.3\"],\"applies_to\":[\"The permittee conducting surface coal mining and reclamation operations on natural slopes that exceed 20 degrees, or on lesser slopes that require measures to protect the area from disturbance, as determined by the regulatory authority after consideration of soils, climate, the method of operation, geology, and other regional characteristics, shall meet the following performance standards.\"],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:f46785239cf3fd4021b0a3bc0f8d9873012192b2b691be3a8102e639eb2e1944\",\"urn:rulespec:document-understanding:assertion:f305c6e07942048ce6e69a87af1a8fb20a12eb089524a66088dce7c28b6149fc\",\"urn:rulespec:document-understanding:assertion:4f0e82295271a2db5a3acea397b0b8e2cb4d8cc2da526ea0bc013fb7dcf2a0d3\",\"urn:rulespec:document-understanding:assertion:a11a894ff0c5ad14cfb5cb0252e092acdc85594dc58d22f0ec6e17f784058801\",\"urn:rulespec:document-understanding:assertion:e12abba0a83bb22c9d86d21a170e5b3fa23892eb0c86fc982439c5f00a85821c\",\"urn:rulespec:document-understanding:assertion:ce43351e2e813a2ea5e650a22fa0d4db82a42c4f36022413d100c15c1fce8365\",\"urn:rulespec:document-understanding:assertion:dedfb63077b74fcefb600b851598b72815c54351785f440b332cce856de26de4\",\"urn:rulespec:document-understanding:assertion:95536b5fb89c5a263f343978371d88e4167922f077adeac45f27d213aeab9acf\",\"urn:rulespec:document-understanding:assertion:8efc29c222c05822fbd75c54838e3c47490fd0e078be3d20b84bc8ae17a50032\",\"urn:rulespec:document-understanding:assertion:644314ffe4944764028b43e20450582e8021b2478f47036856c74224d25ec777\"],\"choice_quote\":\"where mining is done on a flat or gently rolling terrain with an occasional steep slope through which the mining proceeds and leaves a plain or predominantly flat area; or where the mining is governed by § 716.3\",\"choice_text\":\"where mining is done on flat or gently rolling terrain with an occasional steep slope leaving a plain/predominantly flat area OR where mining is governed by § 716.3\",\"context_quotes\":[],\"end\":648,\"evidence\":[{\"end\":648,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A2121d7a65944c6bcd169c568eaf6ab38642f378ca63195763b375de54c91c10c:393:648:sha256-fad3c02386d70a315aa83c0bfb4b1f40fc6188c1ecaac1b8e456023912a3de34\",\"quote\":\"The standards of this section do not apply where mining is done on a flat or gently rolling terrain with an occasional steep slope through which the mining proceeds and leaves a plain or predominantly flat area; or where the mining is governed by § 716.3.\",\"start\":393},{\"end\":435,\"field\":\"action\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A2121d7a65944c6bcd169c568eaf6ab38642f378ca63195763b375de54c91c10c:423:435:sha256-011dc140e7e7b43cabd2096e52627692999c0dcdea721341bd1ba9b626e02fe8\",\"quote\":\"do not apply\",\"start\":423},{\"end\":422,\"field\":\"object\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A2121d7a65944c6bcd169c568eaf6ab38642f378ca63195763b375de54c91c10c:393:422:sha256-07a83997e7d8119dd527dd959f5454544619e6bb67f72bab7e730e87c8ecddc1\",\"quote\":\"The standards of this section\",\"start\":393},{\"end\":647,\"field\":\"logic_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A2121d7a65944c6bcd169c568eaf6ab38642f378ca63195763b375de54c91c10c:436:647:sha256-a53e011f6aa5acb0100da9ec930cac14ac24aa9992d2cfae60e387a28e53cc2e\",\"quote\":\"where mining is done on a flat or gently rolling terrain with an occasional steep slope through which the mining proceeds and leaves a plain or predominantly flat area; or where the mining is governed by § 716.3\",\"start\":436},{\"end\":435,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A2121d7a65944c6bcd169c568eaf6ab38642f378ca63195763b375de54c91c10c:423:435:sha256-011dc140e7e7b43cabd2096e52627692999c0dcdea721341bd1ba9b626e02fe8\",\"quote\":\"do not apply\",\"start\":423},{\"end\":647,\"field\":\"choice_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A2121d7a65944c6bcd169c568eaf6ab38642f378ca63195763b375de54c91c10c:436:647:sha256-a53e011f6aa5acb0100da9ec930cac14ac24aa9992d2cfae60e387a28e53cc2e\",\"quote\":\"where mining is done on a flat or gently rolling terrain with an occasional steep slope through which the mining proceeds and leaves a plain or predominantly flat area; or where the mining is governed by § 716.3\",\"start\":436},{\"end\":603,\"field\":\"alternative:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A2121d7a65944c6bcd169c568eaf6ab38642f378ca63195763b375de54c91c10c:436:603:sha256-9d0e1d4fe62ed9682ad854a40b233bf692e81412d2fd3806030bdbe2a1bf775f\",\"quote\":\"where mining is done on a flat or gently rolling terrain with an occasional steep slope through which the mining proceeds and leaves a plain or predominantly flat area\",\"start\":436},{\"end\":647,\"field\":\"alternative:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A2121d7a65944c6bcd169c568eaf6ab38642f378ca63195763b375de54c91c10c:608:647:sha256-6e70da412b1a2c83106b1332ec269a4e218543f27b72102eba982af960a32c16\",\"quote\":\"where the mining is governed by § 716.3\",\"start\":608}],\"id\":\"urn:rulespec:document-understanding:revision:06a0f0775a06b58e2e429d68b1b666b953d38b9d1103272ad886339f355d3edb\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"exception\",\"logic_text\":\"where mining is done on a flat or gently rolling terrain with an occasional steep slope through which the mining proceeds and leaves a plain or predominantly flat area; or where the mining is governed by § 716.3\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:8efc29c222c05822fbd75c54838e3c47490fd0e078be3d20b84bc8ae17a50032\",\"modality\":\"not_stated\",\"modality_quote\":\"do not apply\",\"object\":\"The standards of this section\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:dff0d70f8847d4356e1f145561493022aaae533e70a75a6eb1a5a8a26fa34edb\",\"origin\":\"aiSuggested\",\"quote\":\"The standards of this section do not apply where mining is done on a flat or gently rolling terrain with an occasional steep slope through which the mining proceeds and leaves a plain or predominantly flat area; or where the mining is governed by § 716.3.\",\"references\":[\"§ 716.3\"],\"relation\":\"exception\",\"rule_id\":\"urn:rulespec:document-understanding:rule:76e018a29c6e38cc827f8c2e43be661cfe03aea4574308aa70626ceea0891678\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":393,\"summary\":\"The performance standards do not apply where mining occurs on flat or gently rolling terrain leaving a plain or predominantly flat area, or where mining is governed by § 716.3.\",\"target_ids\":[\"urn:rulespec:document-understanding:revision:5475def59ffd01966c599094b64d30bcef8af5afaa0d274a6df369b89332e35a\"]}",

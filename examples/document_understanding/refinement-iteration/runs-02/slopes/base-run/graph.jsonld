      "dcterms:description": "{\"action\":\"approves chipping and distributing woody materials through the backfill\",\"actor\":\"the regulatory authority\",\"alternative_quotes\":[],\"applies_to\":[\"Woody materials may be chipped and distributed through the backfill when approved by the regulatory authority.\"],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:b65b83f0c3ddf729621b0e4d0196e5ed0c71445fb85a173fd9adf8cc0cbd085f\",\"urn:rulespec:document-understanding:assertion:8a1a733e83f234f6533bd36ad3c44e9618c1e38d6ade1fd5df5fc5950df3e8fc\",\"urn:rulespec:document-understanding:assertion:f02d29f07e7746ad1a81836b5388018f2d25fb26ee3f3fddf8b5b2a2c6076f2b\",\"urn:rulespec:document-understanding:assertion:c9eef83c828921b4ca8edb3fcdbefe6ab935769ccd534af7d904e6eb26da59c0\",\"urn:rulespec:document-understanding:assertion:f93decba202175054c22e2909a20b6344dadbe5576203aa01a07afe04c69cd30\",\"urn:rulespec:document-understanding:assertion:799b22ef379ec9a67e9bb8a7b8b1628f172cd99fe0635b0d55d11011e1a85e51\",\"urn:rulespec:document-understanding:assertion:069438b2a051ab7f105f5a190c405a797fb2ffb02338f69c151dee0598fd094c\",\"urn:rulespec:document-understanding:assertion:46b778085623299e2ab1eca73c6125156c00cf608bf1ab3da7b7a94be127bb23\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"context_quotes\":[],\"end\":1564,\"evidence\":[{\"end\":1564,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A2121d7a65944c6bcd169c568eaf6ab38642f378ca63195763b375de54c91c10c:1523:1564:sha256-b02a6da8062dc5c775982fd2cc9afd32e434cc798f58d6b096dd4fd02b4bd7ee\",\"quote\":\"when approved by the regulatory authority\",\"start\":1523},{\"end\":1564,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A2121d7a65944c6bcd169c568eaf6ab38642f378ca63195763b375de54c91c10c:1540:1564:sha256-c24cd660748abadcce4d514aa4f0d3870f28eba67d9a5349e7823eab7dbd2234\",\"quote\":\"the regulatory authority\",\"start\":1540},{\"end\":1536,\"field\":\"action\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A2121d7a65944c6bcd169c568eaf6ab38642f378ca63195763b375de54c91c10c:1528:1536:sha256-2687f86ed6784b8a5fca36e6c468e12aa44dc3c7e8137e3160d1a95079bdcd02\",\"quote\":\"approved\",\"start\":1528},{\"end\":1564,\"field\":\"logic_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A2121d7a65944c6bcd169c568eaf6ab38642f378ca63195763b375de54c91c10c:1523:1564:sha256-b02a6da8062dc5c775982fd2cc9afd32e434cc798f58d6b096dd4fd02b4bd7ee\",\"quote\":\"when approved by the regulatory authority\",\"start\":1523},{\"end\":392,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A2121d7a65944c6bcd169c568eaf6ab38642f378ca63195763b375de54c91c10c:0:392:sha256-9afce8cab4fa0be3a73a3ca1fafe0da545a5e86f1904605d24ab51c42d4589cb\",\"quote\":\"The permittee conducting surface coal mining and reclamation operations on natural slopes that exceed 20 degrees, or on lesser slopes that require measures to protect the area from disturbance, as determined by the regulatory authority after consideration of soils, climate, the method of operation, geology, and other regional characteristics, shall meet the following performance standards.\",\"start\":0}],\"id\":\"urn:rulespec:document-understanding:revision:a0b2cbb621276c99abb78bf63894d499616e1addee06e696c157a694fb55508c\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"condition\",\"logic_text\":\"when approved by the regulatory authority\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:069438b2a051ab7f105f5a190c405a797fb2ffb02338f69c151dee0598fd094c\",\"modality\":\"not_stated\",\"modality_quote\":\"\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:aee22cf92aeeaee8e2d5067a73a7f33077ca8005d217f4d076fba871b7e063a3\",\"origin\":\"aiSuggested\",\"quote\":\"when approved by the regulatory authority\",\"references\":[],\"relation\":\"prerequisite\",\"rule_id\":\"urn:rulespec:document-understanding:rule:9ae71ccecd62a014fce38a18c44aeb76a78bd20d796ff14cd0b08d1a6a42d862\",\"scope_quotes\":[\"The permittee conducting surface coal mining and reclamation operations on natural slopes that exceed 20 degrees, or on lesser slopes that require measures to protect the area from disturbance, as determined by the regulatory authority after consideration of soils, climate, the method of operation, geology, and other regional characteristics, shall meet the following performance standards.\"],\"scope_text\":\"Governed by steep slope operations under this section, where mining is not on flat/gently rolling terrain leaving a flat area and not governed by § 716.3.\",\"section_id\":\"section-1\",\"start\":1523,\"summary\":\"Chipping and distributing woody materials through the backfill requires approval by the regulatory authority.\",\"target_ids\":[\"urn:rulespec:document-understanding:revision:87b44f60e967a0f6af4d051e2db5c4e7b4c38e14dc102b07172c10f9efe2f86c\"]}",

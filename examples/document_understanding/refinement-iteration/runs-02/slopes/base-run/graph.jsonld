    {
      "@id": "urn:rulespec:document-understanding:revision:1d485d24c1529482fcd40c9b5a4a49319bcf2500d97c87f2af1f5620b22a32d9",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:1d485d24c1529482fcd40c9b5a4a49319bcf2500d97c87f2af1f5620b22a32d9",

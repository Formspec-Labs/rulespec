      "dcterms:description": "{\"action\":\"completely cover the highwall with spoil and grade the disturbed area to comply\",\"actor\":\"The permittee conducting surface coal mining and reclamation operations\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:477457db7f96d879674b464b8bdcab4f5b1a7c949f6b2bb0a645265fcb9383af\",\"urn:rulespec:document-understanding:assertion:cd549f3f01eaca374831dfd8b1c91deb7259de76ba13180410d5ec776f9316ae\",\"urn:rulespec:document-understanding:assertion:76595018fcdf5a65bab1ac0271f278ab0f2e61144be104fd9ffca88bec778ae8\",\"urn:rulespec:document-understanding:assertion:36d86298f596a4a4c32c8b14166c89539736f1cf54d1fbe5f9a4592cc2c187a1\",\"urn:rulespec:document-understanding:assertion:a0a91ca0136d93362a38e5d6b28188421ec5999d9c1a2c6c669881000506f62f\",\"urn:rulespec:document-understanding:assertion:d93bca4966b33834a4cdcca8e8b34a85e9a9d98d17ff1d5fddd9ba3ff820d0f3\",\"urn:rulespec:document-understanding:assertion:58cc507696072ac9a579fcc809c41ad3361846449b5eba54b107611a699afe3d\",\"urn:rulespec:document-understanding:assertion:bf07620caa6954a8862374509a57a34729f6c201a4f2948436bd13d27cfc33a1\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"context_quotes\":[],\"end\":973,\"evidence\":[{\"end\":973,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A2121d7a65944c6bcd169c568eaf6ab38642f378ca63195763b375de54c91c10c:832:973:sha256-f93ab45197ee56cd172cf33dbf6be6c658cd3dbf99e77898a4405ffb57c59df6\",\"quote\":\"The highwall shall be completely covered with spoil and the disturbed are a graded to comply with the provisions of § 715.14 of this chapter.\",\"start\":832},{\"end\":71,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A2121d7a65944c6bcd169c568eaf6ab38642f378ca63195763b375de54c91c10c:0:71:sha256-dfe68b2d06b18fda7d814e045e09b428feee5767d757d9c8ef4fd1c145199eab\",\"quote\":\"The permittee conducting surface coal mining and reclamation operations\",\"start\":0},{\"end\":924,\"field\":\"action\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A2121d7a65944c6bcd169c568eaf6ab38642f378ca63195763b375de54c91c10c:845:924:sha256-05976b9157ba97ae247fae056f69315e1318580a2a447ca59e2926e31825ea59\",\"quote\":\"shall be completely covered with spoil and the disturbed are a graded to comply\",\"start\":845},{\"end\":844,\"field\":\"object\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A2121d7a65944c6bcd169c568eaf6ab38642f378ca63195763b375de54c91c10c:832:844:sha256-2b7facf0842a962093c24f520e7a1fc9091e78001b71e03dd991768a3875e9d0\",\"quote\":\"The highwall\",\"start\":832},{\"end\":973,\"field\":\"logic_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A2121d7a65944c6bcd169c568eaf6ab38642f378ca63195763b375de54c91c10c:832:973:sha256-f93ab45197ee56cd172cf33dbf6be6c658cd3dbf99e77898a4405ffb57c59df6\",\"quote\":\"The highwall shall be completely covered with spoil and the disturbed are a graded to comply with the provisions of § 715.14 of this chapter.\",\"start\":832},{\"end\":850,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A2121d7a65944c6bcd169c568eaf6ab38642f378ca63195763b375de54c91c10c:845:850:sha256-56ee5b508706bf2de91712d85d6d1e11ddbff01949142ed6e8c22e3b1bed1c71\",\"quote\":\"shall\",\"start\":845},{\"end\":392,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A2121d7a65944c6bcd169c568eaf6ab38642f378ca63195763b375de54c91c10c:0:392:sha256-9afce8cab4fa0be3a73a3ca1fafe0da545a5e86f1904605d24ab51c42d4589cb\",\"quote\":\"The permittee conducting surface coal mining and reclamation operations on natural slopes that exceed 20 degrees, or on lesser slopes that require measures to protect the area from disturbance, as determined by the regulatory authority after consideration of soils, climate, the method of operation, geology, and other regional characteristics, shall meet the following performance standards.\",\"start\":0}],\"id\":\"urn:rulespec:document-understanding:revision:2bbf67965a616310bb38c26d59d2ef866e6fc0a516c2668c5b72f1909006b954\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"The highwall shall be completely covered with spoil and the disturbed are a graded to comply with the provisions of § 715.14 of this chapter.\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:bf07620caa6954a8862374509a57a34729f6c201a4f2948436bd13d27cfc33a1\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"The highwall and the disturbed area\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:a9ce53c15e098a76a5517d7e9800a32cbf4f6dbbe33fad94219e87934458cd55\",\"origin\":\"aiSuggested\",\"quote\":\"The highwall shall be completely covered with spoil and the disturbed are a graded to comply with the provisions of § 715.14 of this chapter.\",\"references\":[\"§ 715.14\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:31e7991773a0223cd9152f6309f5506cb01bab7cc78beb8f56a2b89f04033b68\",\"scope_quotes\":[\"The permittee conducting surface coal mining and reclamation operations on natural slopes that exceed 20 degrees, or on lesser slopes that require measures to protect the area from disturbance, as determined by the regulatory authority after consideration of soils, climate, the method of operation, geology, and other regional characteristics, shall meet the following performance standards.\"],\"scope_text\":\"Governed by steep slope operations under this section, where mining is not on flat/gently rolling terrain leaving a flat area and not governed by § 716.3.\",\"section_id\":\"section-1\",\"start\":832,\"summary\":\"The highwall must be completely covered with spoil, and the disturbed area must be graded to comply with § 715.14 of this chapter.\",\"target_ids\":[]}",

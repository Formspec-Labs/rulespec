            "text": "{\n  \"units\": [\n    {\n      \"quote\": \"(3) Authorization required: Marketing.\",\n      \"scope_quotes\": [],\n      \"kind\": \"background\",\n      \"meaning\": \"Introduces the subject matter heading for subsection (3) regarding marketing authorization requirements, without establishing an independent legal obligation.\"\n    },\n    {\n      \"quote\": \"Notwithstanding any provision of this subpart, other than the transition provisions in § 164.532, a covered entity must obtain an authorization for any use or disclosure of protected health information for marketing\",\n      \"scope_quotes\": [],\n      \"kind\": \"requirement\",\n      \"meaning\": \"Notwithstanding any other provision of the subpart (except the transition provisions in § 164.532), a covered entity is mandated to obtain an authorization for any use or disclosure of protected health information for marketing purposes, unless an enumerated exception applies.\"\n    },\n    {\n      \"quote\": \"(A) A face-to-face communication made by a covered entity to an individual; or\",\n      \"scope_quotes\": [\n        \"a covered entity must obtain an authorization for any use or disclosure of protected health information for marketing, except if the communication is in the form of:\"\n      ],\n      \"kind\": \"exception\",\n      \"meaning\": \"Authorization is not required for a marketing use or disclosure of protected health information if the communication takes the form of a face-to-face communication made by a covered entity to an individual.\"\n    },\n    {\n      \"quote\": \"(B) A promotional gift of nominal value provided by the covered entity.\",\n      \"scope_quotes\": [\n        \"a covered entity must obtain an authorization for any use or disclosure of protected health information for marketing, except if the communication is in the form of:\"\n      ],\n      \"kind\": \"exception\",\n      \"meaning\": \"Authorization is not required for a marketing use or disclosure of protected health information if the communication takes the form of a promotional gift of nominal value provided by the covered entity.\"\n    },\n    {\n      \"quote\": \"the authorization must state that such remuneration is involved.\",\n      \"scope_quotes\": [\n        \"If the marketing involves financial remuneration, as defined in paragraph (3) of the definition of marketing at § 164.501, to the covered entity from a third party,\"\n      ],\n      \"kind\": \"requirement\",\n      \"meaning\": \"If marketing involves financial remuneration to the covered entity from a third party (as defined in paragraph (3) of the definition of marketing at § 164.501), the authorization must specifically state that such remuneration is involved.\"\n    }\n  ]\n}",

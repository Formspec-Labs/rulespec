            "text": "{\n  \"units\": [\n    {\n      \"quote\": \"A valid authorization is a document that meets the requirements in paragraphs (a)(3)(ii), (a)(4)(ii), (c)(1), and (c)(2) of this section, as applicable.\",\n      \"scope_quotes\": [],\n      \"kind\": \"definition\",\n      \"meaning\": \"A valid authorization is defined as a document that complies with the applicable requirements established in paragraphs (a)(3)(ii), (a)(4)(ii), (c)(1), and (c)(2) of this section.\"\n    },\n    {\n      \"quote\": \"A valid authorization may contain elements or information in addition to the elements required by this section, provided that such additional elements or information are not inconsistent with the elements required by this section.\",\n      \"scope_quotes\": [],\n      \"kind\": \"permission\",\n      \"meaning\": \"A valid authorization is permitted to include elements or information beyond what this section requires, on the condition that the additional elements or information are not inconsistent with the elements required by this section.\"\n    },\n    {\n      \"quote\": \"The expiration date has passed or the expiration event is known by the covered entity to have occurred;\",\n      \"scope_quotes\": [\n        \"An authorization is not valid, if the document submitted has any of the following defects:\"\n      ],\n      \"kind\": \"condition\",\n      \"meaning\": \"An authorization is not valid if the submitted document has the defect that its expiration date has passed or the covered entity knows that the expiration event has occurred.\"\n    },\n    {\n      \"quote\": \"The authorization has not been filled out completely, with respect to an element described by paragraph (c) of this section, if applicable;\",\n      \"scope_quotes\": [\n        \"An authorization is not valid, if the document submitted has any of the following defects:\"\n      ],\n      \"kind\": \"condition\",\n      \"meaning\": \"An authorization is not valid if the submitted document has the defect of not being completely filled out with respect to an applicable element described in paragraph (c) of this section.\"\n    },\n    {\n      \"quote\": \"The authorization is known by the covered entity to have been revoked;\",\n      \"scope_quotes\": [\n        \"An authorization is not valid, if the document submitted has any of the following defects:\"\n      ],\n      \"kind\": \"condition\",\n      \"meaning\": \"An authorization is not valid if the submitted document has the defect that the covered entity knows the authorization has been revoked.\"\n    },\n    {\n      \"quote\": \"The authorization violates paragraph (b)(3) or (4) of this section, if applicable;\",\n      \"scope_quotes\": [\n        \"An authorization is not valid, if the document submitted has any of the following defects:\"\n      ],\n      \"kind\": \"condition\",\n      \"meaning\": \"An authorization is not valid if the submitted document has the defect of violating paragraph (b)(3) or paragraph (b)(4) of this section, where applicable.\"\n    },\n    {\n      \"quote\": \"Any material information in the authorization is known by the covered entity to be false.\",\n      \"scope_quotes\": [\n        \"An authorization is not valid, if the document submitted has any of the following defects:\"\n      ],\n      \"kind\": \"condition\",\n      \"meaning\": \"An authorization is not valid if the submitted document has the defect that any material information contained within it is known by the covered entity to be false.\"\n    }\n  ]\n}",

    {
      "unit_id": "urn:rulespec:audit-unit:527ded0a5726ae59e5cda20152400484c0096accef9f6c8cffb8ea4f36698436",
      "claim_ids": [
        "urn:rulespec:document-understanding:revision:e829e9e723a2c185c80ef9b3386b7b4aa2a2aac50665af3e918d7d4b307d845f"
      ],
      "source_spans": [
        {
          "source_id": "urn:rulespec:document-understanding:document:aa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc",
          "quote": "Evidence of material name changes must be reviewed for evidence of counterfeiting or alteration (see 8 FAM 201.1)",
          "start": 1083,
          "end": 1196
        }
      ],
      "rationale": "C0002 covers the requirement to inspect material name change evidence for counterfeiting or alteration.",
      "status": "covered"
    },
    {
      "unit_id": "urn:rulespec:audit-unit:020d1b8e7e42ed2becc67b7bbe0512f3a4540408e28de393d83ca5d0d45db791",
      "claim_ids": [
        "urn:rulespec:document-understanding:revision:bc7823c8826ac22866258b8c3a605b1ebbbbcd4d4a6ead5efbb783184afbbe04"
      ],
      "source_spans": [
        {
          "source_id": "urn:rulespec:document-understanding:document:aa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc",
          "quote": "The applicant may not continue to use a previous name after a material name change unless the name change documentation specifically permits the applicant to continue using that name (see 8 FAM 403.1-6 regarding “known as” names).",
          "start": 1201,
          "end": 1431
        }
      ],
      "rationale": "C0003 covers the prohibition on continuing to use a previous name after a material name change.",
      "status": "covered"
    },
    {
      "unit_id": "urn:rulespec:audit-unit:a4a0204d4fbdbde5e1e764a2b396b3d536bfdc39d681cc0731116bea1c485213",
      "claim_ids": [
        "urn:rulespec:document-understanding:revision:153d6e51a46c8138100f9e5882442eddbc27e5304bef28c80a6626e85c494cf3"
      ],
      "source_spans": [
        {
          "source_id": "urn:rulespec:document-understanding:document:aa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc",
          "quote": "unless the name change documentation specifically permits the applicant to continue using that name (see 8 FAM 403.1-6 regarding “known as” names).",
          "start": 1284,
          "end": 1431
        }
      ],
      "rationale": "C0012 expresses the exception allowing continued use of a previous name if specifically permitted by the documentation.",
      "status": "covered"
    },
    {
      "unit_id": "urn:rulespec:audit-unit:d8cdcc3240e361a5bff74716c32288c7f793ceef7642f7ab5fc24d7a7c853259",
      "claim_ids": [],
      "source_spans": [
        {
          "source_id": "urn:rulespec:document-understanding:document:aa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc",
          "quote": "The applicant's name is an integral part of her/his identity.",
          "start": 1436,
          "end": 1497
        }
      ],
      "rationale": "The assertion that an applicant's name is an integral part of identity was only included in background context quotes and is not represented by any claim.",
      "status": "missing"
    },
    {
      "unit_id": "urn:rulespec:audit-unit:db72d95a3a2691810c406ecd182b9ed1315caa92ccb182a9b55c04709c4256e5",
      "claim_ids": [
        "urn:rulespec:document-understanding:revision:36f64e584662cbcda0f68bdc866d5c3bd723c7a5f40a98fe8a972e18e2e3b7a9"
      ],
      "source_spans": [
        {
          "source_id": "urn:rulespec:document-understanding:document:aa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc",
          "quote": "Consequently, under 22 CFR 51.23(c), evidence of identity might be required in accordance with Department guidance to establish the name that best identifies the applicant:",
          "start": 1498,
          "end": 1670
        }
      ],
      "rationale": "C0004 captures the rule that identity evidence might be required under 22 CFR 51.23(c) and Department guidance.",
      "status": "covered"
    },
    {
      "unit_id": "urn:rulespec:audit-unit:69fc7f18c601c6b30fd2fa8d96a6511c01e6a9b8ec36dca5d1c5aca2d7cc0193",
      "claim_ids": [
        "urn:rulespec:document-understanding:revision:674d26b0699308acdcd8fef30517236d1d6fcf9cefd1fa41ea7d844824a6d090"
      ],
      "source_spans": [
        {
          "source_id": "urn:rulespec:document-understanding:document:aa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc",
          "quote": "If the applicant has had a material name change more than one year prior to applying on form DS-11 but has not updated her/his ID to reflect the material name change, you must suspend the application to request an acceptable ID in the new name.",
          "start": 1676,
          "end": 1920
        }
      ],
      "rationale": "C0005 covers the requirement to suspend a DS-11 application when a material change occurred more than one year prior and ID is unupdated.",
      "status": "covered"
    },
    {
      "unit_id": "urn:rulespec:audit-unit:dc31b1837d28fe076737316788f274019d1c55e0de90b1655ae33b62884f7842",
      "claim_ids": [
        "urn:rulespec:document-understanding:revision:497edc502763bc14125c8df01adbb050e394e185db096d90e8d4af36121d27aa"
      ],
      "source_spans": [
        {
          "source_id": "urn:rulespec:document-understanding:document:aa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc",
          "quote": "If there is insufficient time to request that the applicant submit acceptable ID prior to urgent or emergency travel, a limited-validity passport may be issued in the requested name;",
          "start": 1921,
          "end": 2103
        }
      ],
      "rationale": "C0006 captures the permission to issue a limited-validity passport when urgent or emergency travel prevents obtaining updated ID.",
      "status": "covered"
    },
    {
      "unit_id": "urn:rulespec:audit-unit:9b4234b548dc4e2af9a3e4f2f3c2295011def1a37c9cc4ebba690ca53a1b2371",
      "claim_ids": [
        "urn:rulespec:document-understanding:revision:9dfee9204a5e883350a578c7ccb56b2d9b040ae2557c8a10a0d2192e8550d2b8"
      ],
      "source_spans": [
        {
          "source_id": "urn:rulespec:document-understanding:document:aa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc",
          "quote": "The applicant generally will need the name change documentation to change the name on her/his ID.",
          "start": 2109,
          "end": 2206
        }
      ],
      "rationale": "C0011 reflects the statement that applicants generally need name change documentation to update ID.",
      "status": "covered"
    },
    {
      "unit_id": "urn:rulespec:audit-unit:8eb7a3c2f8d99df2ef9019a7ea18930ac6ecff06db043b802c1d1846f5ace219",
      "claim_ids": [
        "urn:rulespec:document-understanding:revision:a178fac46ca0da34e1cdf704992826f351eb44d1c822603c951130013951efe4"
      ],
      "source_spans": [
        {
          "source_id": "urn:rulespec:document-understanding:document:aa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc",
          "quote": "You must fully notate the name change documentation prior to returning the documentation, including that the documentation was \"seen and returned,\" to the applicant with the information request letter (IRL);",
          "start": 2207,
          "end": 2414
        }
      ],
      "rationale": "C0007 covers the obligation to fully notate documentation as seen and returned before returning it with an IRL.",
      "status": "covered"
    },
    {
      "unit_id": "urn:rulespec:audit-unit:8583fe80510a99816573ea8f91bd63c17d9a293e5e8f9e49c9098bbe125d6c39",
      "claim_ids": [
        "urn:rulespec:document-understanding:revision:2a093752a06204c1a080fec8969955d7d391e6d3de963248d149af3314228b67"
      ],
      "source_spans": [
        {
          "source_id": "urn:rulespec:document-understanding:document:aa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc",
          "quote": "Applicants who have had a material name change within one year of applying on a form DS-11 do not need to submit ID in the new name.",
          "start": 2424,
          "end": 2556
        }
      ],
      "rationale": "C0008 covers the exemption from submitting new ID when the material name change occurred within one year of applying on Form DS-11.",
      "status": "covered"
    },
    {
      "unit_id": "urn:rulespec:audit-unit:874736d0e814ea86f4f7f915a3700dd8e83789785ad1281618705fd542877e1b",
      "claim_ids": [
        "urn:rulespec:document-understanding:revision:49f358cea91b6e67f663d09c16d8fafad54a8957853bdfbcb618de9190b93eae"
      ],
      "source_spans": [
        {
          "source_id": "urn:rulespec:document-understanding:document:aa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc",
          "quote": "However, if the ID has not yet been changed, they must submit their name change documentation.",
          "start": 2557,
          "end": 2651
        }
      ],
      "rationale": "C0009 covers the requirement that applicants whose ID is unchanged must submit their name change documentation.",
      "status": "covered"
    }
  ]

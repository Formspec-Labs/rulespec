      "dcterms:description": "{\"action\":\"determine how the name will appear\",\"actor\":\"you (adjudicator)\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:f03eddf0d0a46fe49768e4efa3688359c31d3b75a712cf4528093a1a05fb7604\",\"urn:rulespec:document-understanding:assertion:f798364493bba6885d6f8c254f0fbbaf939e3ce4e182734baaf9a9ab5b573e64\",\"urn:rulespec:document-understanding:assertion:5334b0e4b40592180797cef4c44e9acf443a9ea6f23dbc47f516e2a7d2c158d1\",\"urn:rulespec:document-understanding:assertion:267758eff372132637e8c142d2904dcb0144d140e94b0e31f3cce7c2f458dffc\",\"urn:rulespec:document-understanding:assertion:2ffe882167143165128e73d6fba1b100650a235e3143afab202a90527220bdcc\",\"urn:rulespec:document-understanding:assertion:52ae808daef55e58ae224c71cfb6e9af1865bd5517d18de7c0fc88e77625f019\",\"urn:rulespec:document-understanding:assertion:53874272b5df2841a18c0df054cb8a01e2b3fbf1bd00d8ef32c828ee3f7a1f25\",\"urn:rulespec:document-understanding:assertion:cdfacc87d4b009043109b761aa1075959a4b4f9fd279cb10b7e2c8b05a7c6480\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"context_quotes\":[\"In accordance with International Civil Aviation Organization (ICAO) recommendations, U.S. passports, form FS-240, and form DS-2060 are printed in all uppercase letters. Printing a name with multiple parts in uppercase letters causes the name to appear as one word unless the parts are separated with spaces.\"],\"end\":4389,\"evidence\":[{\"end\":4389,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A5a4175f45e6a1e5ed68819bc7725f1871d0cab391934e214c9f7f34023ccc1da:4296:4389:sha256-e723607f2219fce469d9f09b01a63de3fc08bd8e2286f6f409fdc3958c355f51\",\"quote\":\"if the applicant has a name with multiple parts, you must determine how the name will appear:\",\"start\":4296},{\"end\":4348,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-unders
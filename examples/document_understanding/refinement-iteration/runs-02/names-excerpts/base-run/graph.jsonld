eb68bed2a468935932473ecc26ec5be59d6756454b7498ee70fb505016686f2\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"more than one year prior to applying on form DS-11 but has not updated her/his ID to reflect the material name change\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:57b349f7ba452e524ee257d132f17db186e7b861c8c415bca9c892143d959880\",\"modality\":\"must\",\"modality_quote\":\"must\",\"object\":\"the application\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:7794d6faad6f1f2a0c6ef3eb5666bbf712f7a3a997a20b28642df2485084467f\",\"origin\":\"aiSuggested\",\"quote\":\"If the applicant has had a material name change more than one year prior to applying on form DS-11 but has not updated her/his ID to reflect the material name change, you must suspend the application to request an acceptable ID in the new name.\",\"references\":[\"form DS-11\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:f4180c693bf1581607b0c8941c0f53570dc2cd26cce52fad9c04d2b213c348d0\",\"scope_quotes\":[\"If the applicant has had a material name change more than one year prior to applying on form DS-11 but has not updated her/his ID to reflect the material name change\"],\"scope_text\":\"If the applicant has had a material name change more than one year prior to applying on form DS-11 but has not updated her/his ID to reflect the material name change.\",\"section_id\":\"fam-names-03\",\"start\":1933,\"summary\":\"If the applicant had a material name change more than one year before applying on form DS-11 and has not updated their ID, you must suspend the application to request an acceptable ID in the new name.\",\"target_ids\":[]}",

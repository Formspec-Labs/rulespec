            "text": "{\n  \"claim_judgments\": [\n    {\n      \"claim_id\": \"C0000\",\n      \"unit_ids\": [\"U0000\"],\n      \"quotes\": [\n        \"The applicant may not continue to use a previous name after a material name change unless the name change documentation specifically permits the applicant to continue using that name\"\n      ],\n      \"rationale\": \"The claim summary accurately reflects the prohibition and its exception condition. The scope correctly captures 'after a material name change'. However, the structured actor, action, and object fields are left completely empty.\",\n      \"dimensions\": {\n        \"summary\": \"correct\",\n        \"actor\": \"error\",\n        \"support\": \"correct\",\n        \"scope\": \"correct\",\n        \"links\": \"correct\",\n        \"boundary\": \"correct\",\n        \"modality\": \"correct\",\n        \"action\": \"error\",\n        \"object\": \"error\",\n        \"alternatives\": \"not_applicable\",\n        \"thresholds\": \"not_applicable\"\n      }\n    },\n    {\n      \"claim_id\": \"C0001\",\n      \"unit_ids\": [\"U0002\"],\n      \"quotes\": [\n        \"You must clear the applicant's pending name even though the name change is not final and even if the passport is not being issued at this time.\"\n      ],\n      \"rationale\": \"The claim summary accurately captures the mandatory requirement and the two non-obstante clauses. Modality and support are correct, but actor, action, and object fields are unpopulated.\",\n      \"dimensions\": {\n        \"summary\": \"correct\",\n        \"actor\": \"error\",\n        \"support\": \"correct\",\n        \"scope\": \"correct\",\n        \"links\": \"correct\",\n        \"boundary\": \"correct\",\n        \"modality\": \"correct\",\n        \"action\": \"error\",\n        \"object\": \"error\",\n        \"alternatives\": \"not_applicable\",\n        \"thresholds\": \"not_applicable\"\n      }\n    },\n    {\n      \"claim_id\": \"C0002\",\n      \"unit_ids\": [\"U0001\"],\n      \"quotes\": [\n        \"unless the name change documentation specifically permits the applicant to continue using that name\"\n      ],\n      \"rationale\": \"The claim designates this clause as an exception, but it incorrectly sets target_ids to C0001 (clearing the pending name) rather than C0000 (prohibition against continuing to use a previous name). Consequently, its links and scope are in error. Furthermore, actor, action, and object are empty.\",\n      \"dimensions\": {\n        \"summary\": \"correct\",\n        \"actor\": \"error\",\n        \"support\": \"correct\",\n        \"scope\": \"error\",\n        \"links\": \"error\",\n        \"boundary\": \"correct\",\n        \"modality\": \"not_applicable\",\n        \"action\": \"error\",\n        \"object\": \"error\",\n        \"alternatives\": \"not_applicable\",\n        \"thresholds\": \"not_applicable\"\n      }\n    }\n  ],\n  \"unit_judgments\": [\n    {\n      \"unit_id\": \"U0000\",\n      \"claim_ids\": [\"C0000\"],\n      \"status\": \"covered\",\n      \"rationale\": \"Claim C0000 faithfully conveys the prohibition against an applicant continuing to use a previous name after a material name change.\",\n      \"quotes\": [\n        \"The applicant may not continue to use a previous name after a material name change\"\n      ]\n    },\n    {\n      \"unit_id\": \"U0001\",\n      \"claim_ids\": [\"C0002\"],\n      \"status\": \"partial\",\n      \"rationale\": \"Claim C0002 extracts the exception clause, but mislinks it to claim C0001 rather than C0000, disconnecting the exception from the prohibition on using previous names and omitting the governing condition of a material name change.\",\n      \"quotes\": [\n        \"unless the name change documentation specifically permits the applicant to continue using that name\"\n      ]\n    },\n    {\n      \"unit_id\": \"U0002\",\n      \"claim_ids\": [\"C0001\"],\n      \"status\": \"covered\",\n      \"rationale\": \"Claim C0001 completely and accurately conveys the requirement to clear the applicant's pending name even if the change is not final and even if the passport is not currently being issued.\",\n      \"quotes\": [\n        \"You must clear the applicant's pending name even though the name change is not final and even if the passport is not being issued at this time.\"\n      ]\n    }\n  ]\n}",

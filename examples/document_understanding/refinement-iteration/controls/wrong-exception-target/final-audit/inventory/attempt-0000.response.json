            "text": "{\n  \"units\": [\n    {\n      \"quote\": \"The applicant may not continue to use a previous name after a material name change\",\n      \"scope_quotes\": [],\n      \"kind\": \"prohibition\",\n      \"meaning\": \"An applicant is prohibited from continuing to use a previous name following a material name change, unless an exception applies.\"\n    },\n    {\n      \"quote\": \"unless the name change documentation specifically permits the applicant to continue using that name\",\n      \"scope_quotes\": [\n        \"The applicant may not continue to use a previous name after a material name change\"\n      ],\n      \"kind\": \"exception\",\n      \"meaning\": \"An applicant is permitted to continue using a previous name after a material name change if the documentation of the name change expressly permits continuing use of that name.\"\n    },\n    {\n      \"quote\": \"(see 8 FAM 403.1-6 regarding “known as” names).\",\n      \"scope_quotes\": [],\n      \"kind\": \"background\",\n      \"meaning\": \"Provides a cross-reference to 8 FAM 403.1-6 regarding “known as” names; it conveys no operational mandate, permission, or prohibition.\"\n    },\n    {\n      \"quote\": \"You must clear the applicant's pending name even though the name change is not final and even if the passport is not being issued at this time.\",\n      \"scope_quotes\": [],\n      \"kind\": \"requirement\",\n      \"meaning\": \"You are mandatory required to clear the applicant's pending name, and this duty applies even if the name change is not final and regardless of whether the passport is currently being issued.\"\n    }\n  ]\n}",

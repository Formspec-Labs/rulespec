            "text": "{\n  \"claim_judgments\": [\n    {\n      \"claim_id\": \"C0000\",\n      \"unit_ids\": [\n        \"U0000\",\n        \"U0002\",\n        \"U0003\",\n        \"U0004\",\n        \"U0005\",\n        \"U0006\"\n      ],\n      \"quotes\": [\n        \"Material discrepancies between the name recorded on the application, the applicant's evidence of U.S. citizenship/non-citizen U.S. nationality, or the evidence of identity must be documented by submission of one or more of the documents listed in this section (see an exception for married names in 8 FAM 403.1-4(C)). Acceptable means of documenting a material name change include (per 22 CFR 51.25):\\n\\n(1) Court orders or decrees:\\n\\n(a) Name change orders; or\\n\\n(b) Divorce decrees;\\n\\n(2) Certificates of naturalization;\\n\\n(3) Marriage certificates;\\n\\n(4) Documentation demonstrating change of name by operation of state law; or\\n\\n(5) Documentation of customary usage.\"\n      ],\n      \"rationale\": \"Claim C0000 accurately identifies the mandatory obligation and threshold ('must', 'one or more') to document material name discrepancies with specified documentation. However, it fails to record item (5) '(5) Documentation of customary usage' in its alternatives list and summary. Furthermore, the explicit scope, actor, action, and object fields are left blank, omitting the specific discrepancy conditions across the application, citizenship evidence, and identity evidence.\",\n      \"dimensions\": {\n        \"summary\": \"error\",\n        \"actor\": \"error\",\n        \"support\": \"correct\",\n        \"scope\": \"error\",\n        \"links\": \"correct\",\n        \"boundary\": \"correct\",\n        \"modality\": \"correct\",\n        \"action\": \"error\",\n        \"object\": \"error\",\n        \"alternatives\": \"error\",\n        \"thresholds\": \"correct\"\n      }\n    },\n    {\n      \"claim_id\": \"C0001\",\n      \"unit_ids\": [\n        \"U0001\"\n      ],\n      \"quotes\": [\n        \"(see an exception for married names in 8 FAM 403.1-4(C))\"\n      ],\n      \"rationale\": \"Claim C0001 correctly extracts the exception for married names under 8 FAM 403.1-4(C), accurately framing its target C0000 and relation type 'exception' with proper governing scope.\",\n      \"dimensions\": {\n        \"summary\": \"correct\",\n        \"actor\": \"not_applicable\",\n        \"support\": \"correct\",\n        \"scope\": \"correct\",\n        \"links\": \"correct\",\n        \"boundary\": \"correct\",\n        \"modality\": \"correct\",\n        \"action\": \"not_applicable\",\n        \"object\": \"correct\",\n        \"alternatives\": \"not_applicable\",\n        \"thresholds\": \"not_applicable\"\n      }\n    }\n  ],\n  \"unit_judgments\": [\n    {\n      \"unit_id\": \"U0000\",\n      \"claim_ids\": [\n        \"C0000\"\n      ],\n      \"status\": \"partial\",\n      \"rationale\": \"Claim C0000 states the core requirement to document discrepancies with one or more documents, but truncates the specific 3-way discrepancy scope (application, citizenship evidence, and identity evidence) and leaves the actor and explicit scope empty.\",\n      \"quotes\": [\n        \"Material discrepancies between the name recorded on the application, the applicant's evidence of U.S. citizenship/non-citizen U.S. nationality, or the evidence of identity must be documented by submission of one or more of the documents listed in this section\"\n      ]\n    },\n    {\n      \"unit_id\": \"U0001\",\n      \"claim_ids\": [\n        \"C0001\"\n      ],\n      \"status\": \"covered\",\n      \"rationale\": \"Claim C0001 completely and faithfully conveys the exception for married names governed by 8 FAM 403.1-4(C).\",\n      \"quotes\": [\n        \"(see an exception for married names in 8 FAM 403.1-4(C))\"\n      ]\n    },\n    {\n      \"unit_id\": \"U0002\",\n      \"claim_ids\": [\n        \"C0000\"\n      ],\n      \"status\": \"covered\",\n      \"rationale\": \"Name change orders as an acceptable court order alternative are covered in C0000's alternatives and summary.\",\n      \"quotes\": [\n        \"(a) Name change orders; or\"\n      ]\n    },\n    {\n      \"unit_id\": \"U0003\",\n      \"claim_ids\": [\n        \"C0000\"\n      ],\n      \"status\": \"covered\",\n      \"rationale\": \"Divorce decrees as an acceptable court order alternative are covered in C0000's alternatives and summary.\",\n      \"quotes\": [\n        \"(b) Divorce decrees;\"\n      ]\n    },\n    {\n      \"unit_id\": \"U0004\",\n      \"claim_ids\": [\n        \"C0000\"\n      ],\n      \"status\": \"covered\",\n      \"rationale\": \"Certificates of naturalization are included in C0000's alternatives list and summary.\",\n      \"quotes\": [\n        \"(2) Certificates of naturalization;\"\n      ]\n    },\n    {\n      \"unit_id\": \"U0005\",\n      \"claim_ids\": [\n        \"C0000\"\n      ],\n      \"status\": \"covered\",\n      \"rationale\": \"Marriage certificates are included in C0000's alternatives list and summary.\",\n      \"quotes\": [\n        \"(3) Marriage certificates;\"\n      ]\n    },\n    {\n      \"unit_id\": \"U0006\",\n      \"claim_ids\": [\n        \"C0000\"\n      ],\n      \"status\": \"covered\",\n      \"rationale\": \"Documentation demonstrating change of name by operation of state law is included in C0000's alternatives and summary.\",\n      \"quotes\": [\n        \"(4) Documentation demonstrating change of name by operation of state law; or\"\n      ]\n    },\n    {\n      \"unit_id\": \"U0007\",\n      \"claim_ids\": [],\n      \"status\": \"missing\",\n      \"rationale\": \"Documentation of customary usage under 22 CFR 51.25 was omitted from the draft claims' alternatives and summary.\",\n      \"quotes\": [\n        \"(5) Documentation of customary usage.\"\n      ]\n    }\n  ]\n}",

      "source_spans": [
        {
          "source_id": "urn:rulespec:document-understanding:document:660d269ce0e0ee226093dd3c78c292d98b7ef7de1af61f8431adecf82778afc6",
          "quote": "Material discrepancies between the name recorded on the application, the applicant's evidence of U.S. citizenship/non-citizen U.S. nationality, or the evidence of identity must be documented by submission of one or more of the documents listed in this section (see an exception for married names in 8 FAM 403.1-4(C)). Acceptable means of documenting a material name change include (per 22 CFR 51.25):\n\n(1) Court orders or decrees:\n\n(a) Name change orders; or\n\n(b) Divorce decrees;\n\n(2) Certificates of naturalization;\n\n(3) Marriage certificates;\n\n(4) Documentation demonstrating change of name by operation of state law; or\n\n(5) Documentation of customary usage.",
          "start": 0,
          "end": 662
        }
      ],
      "rationale": "The claim bundles the entire section into a single requirement. However, in doing so, it entirely omits alternative (5) 'Documentation of customary usage' from both its summary and extracted alternative list. Furthermore, it omits the exception for married names from its explicit summary/logic/scope fields, and leaves action, actor, and object blank.",
      "claim_sha256": "569e05782620e4317cfd27a1db3b4d2547b91fb3285e6d848bc7bbaf7bd33161",
      "dimensions": {
        "summary": "error",
        "actor": "error",
        "support": "correct",
        "scope": "error",
        "links": "correct",
        "boundary": "correct",
        "modality": "correct",
        "action": "error",
        "object": "error",
        "alternatives": "error",
        "thresholds": "correct"
      }
    }

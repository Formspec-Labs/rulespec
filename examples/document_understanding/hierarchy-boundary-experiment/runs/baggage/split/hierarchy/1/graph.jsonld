      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[\"(i) The passenger declares to the aircraft operator, either orally or in writing, before checking the baggage, that the passenger has a firearm in his or her bag and that it is unloaded;\"],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:e0ad543124952a626fb644b4f6ce957e99706dd264d05212d5d7985a701db650\",\"urn:rulespec:document-understanding:assertion:d0f0415d6309da0c1b5f3bab9933ed37809e1cc4e35cf22ba01231156aeea779\",\"urn:rulespec:document-understanding:assertion:9f3d7c64a32467ac6e9d8427bcd9b841e8c546008d10409e984176021387a82c\",\"urn:rulespec:document-understanding:assertion:e8c678a62d9593681a4701bd0741884b85bc76a86ae36a1d558b27a680160067\",\"urn:rulespec:document-understanding:assertion:a945b6e18d45ee7992de62040a043f52d02318ca2f5c248aa9c6016d094fedbe\",\"urn:rulespec:document-understanding:assertion:c1f80c7cbc71b0ea4daa873c29669768dbd2da02dc66d267e5648188be67f4eb\",\"urn:rulespec:document-understanding:assertion:a6072f364c34a89cc0ee17c780b55506597c297f14bec4baccd02166d6babac1\"],\"choice_quote\":\"(i) The passenger declares to the aircraft operator, either orally or in writing, before checking the baggage, that the passenger has a firearm in his or her bag and that it is unloaded;\",\"choice_text\":\"either orally or in writing\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[\"(iii) The firearm is carried in a hard-sided container; and\"],\"effective_periods\":[],\"end\":1840,\"evidence\":[{\"end\":1840,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aab45ff8a7d213a548ba64b9bd9efdd9202dcd2f94cc0c1045a1b5fb69fe86460:1586:1840:sha256-dcc656614d750e48df96b508e69124ac5f6e7dd5d0019280614aba907d6096f7\",\"quote\":\"(2) Any unloaded firearm(s) unless—\\n\\n(i) The passenger declares to the aircraft operator, either orally or in writing, before checking the baggage, that the passenger has a firearm in his or her bag and that it is unloaded;\\n\\n(ii) The firearm is unloaded;\",\"start\":1586},{\"end\":1621,\"field\":\"logic_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aab45ff8a7d213a548ba64b9bd9efdd9202dcd2f94cc0c1045a1b5fb69fe86460:1586:1621:sha256-a03b234b39a7e3d902b46246302bd2c0d5986a277e51dcd12feeb18f5483f16c\",\"quote\":\"(2) Any unloaded firearm(s) unless—\",\"start\":1586},{\"end\":1809,\"field\":\"choice_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aab45ff8a7d213a548ba64b9bd9efdd9202dcd2f94cc0c1045a1b5fb69fe86460:1623:1809:sha256-f6fe03740da837c967d5e1a19cc83bd62f4517d0b086d968201a40859ccf0a16\",\"quote\":\"(i) The passenger declares to the aircraft operator, either orally or in writing, before checking the baggage, that the passenger has a firearm in his or her bag and that it is unloaded;\",\"start\":1623},{\"end\":1556,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aab45ff8a7d213a548ba64b9bd9efdd9202dcd2f94cc0c1045a1b5fb69fe86460:1376:1556:sha256-9dd5c9d0feb251838bff5c1a16b3c099ef083ecc7b0fca10625f4c8d5699fdf1\",\"quote\":\"(c) In checked baggage. A passenger may not transport or offer for transport in checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter:\",\"start\":1376},{\"end\":1840,\"field\":\"scope_text:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aab45ff8a7d213a548ba64b9bd9efdd9202dcd2f94cc0c1045a1b5fb69fe86460:1586:1840:sha256-dcc656614d750e48df96b508e69124ac5f6e7dd5d0019280614aba907d6096f7\",\"quote\":\"(2) Any unloaded firearm(s) unless—\\n\\n(i) The passenger declares to the aircraft operator, either orally or in writing, before checking the baggage, that the passenger has a firearm in his or her bag and that it is unloaded;\\n\\n(ii) The firearm is unloaded;\",\"start\":1586},{\"end\":1901,\"field\":\"context:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aab45ff8a7d213a548ba64b9bd9efdd9202dcd2f94cc0c1045a1b5fb69fe86460:1842:1901:sha256-e6a871e22fdb4f04a0b00e20075aa0b5b737e6d1cb0fd25f4f29d5a90551bd62\",\"quote\":\"(iii) The firearm is carried in a hard-sided container; and\",\"start\":1842},{\"end\":1809,\"field\":\"alternative:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aab45ff8a7d213a548ba64b9bd9efdd9202dcd2f94cc0c1045a1b5fb69fe86460:1623:1809:sha256-f6fe03740da837c967d5e1a19cc83bd62f4517d0b086d968201a40859ccf0a16\",\"quote\":\"(i) The passenger declares to the aircraft operator, either orally or in writing, before checking the baggage, that the passenger has a firearm in his or her bag and that it is unloaded;\",\"start\":1623}],\"id\":\"urn:rulespec:document-understanding:revision:87a63196bc1f98101aef3b5e0acf1f067722be33b28291cac7b299d34bfa55af\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"prohibition\",\"logic_text\":\"(2) Any unloaded firearm(s) unless—\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:a6072f364c34a89cc0ee17c780b55506597c297f14bec4baccd02166d6babac1\",\"modality\":\"must_not\",\"modality_quote\":\"may not\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:abb9fea866853b4144e3cab3a7b9bf38719f027302b17553ff4bfccad199fca3\",\"origin\":\"aiSuggested\",\"quote\":\"(2) Any unloaded firearm(s) unless—\\n\\n(i) The passenger declares to the aircraft operator, either orally or in writing, before checking the baggage, that the passenger has a firearm in his or her bag and that it is unloaded;\\n\\n(ii) The firearm is unloaded;\",\"references\":[\"1562.23\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:c7694d579a086d41656b2c8353b8901905d9299ead449442fda2b08f0cf5f6ad\",\"scope_quotes\":[\"(c) In checked baggage. A passenger may not transport or offer for transport in checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter:\",\"(2) Any unloaded firearm(s) unless—\\n\\n(i) The passenger declares to the aircraft operator, either orally or in writing, before checking the baggage, that the passenger has a firearm in his or her bag and that it is unloaded;\\n\\n(ii) The firearm is unloaded;\"],\"scope_text\":\"Applies when transporting or offering for transport in checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter, unless the passenger declares to the aircraft operator, either orally or in writing, before checking the baggage, that the passenger has a firearm in his or her bag and that it is unloaded, and the firearm is unloaded.\",\"section_id\":\"section-1\",\"start\":1586,\"summary\":\"A passenger may not transport or offer for transport in checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter any unloaded firearm(s) unless: (i) the passenger declares to the aircraft operator, either orally or in writing, before checking the baggage, that the passenger has a firearm in his or her bag and that it is unloaded; and (ii) the firearm is unloaded.\",\"target_ids\":[],\"typed_values\":[]}",

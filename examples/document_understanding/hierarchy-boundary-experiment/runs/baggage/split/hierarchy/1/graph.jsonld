    {
      "@id": "urn:rulespec:document-understanding:assertion:a686ed7cfdfa406cc77f06d8ef299799dfae70205c5cae890331068fe3dfcf5b",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:56cb76fc321644b4a87fe3315c4ad2cc6eb3f3465561a511cc18dda36e94ab5a",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:2767e8af9917ed0d8b84b7b615bc15cf78b4093a9a7980d336bf37bfafb7b6e8",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:5045d3eec25810d8438cc1f92ce08310c76add1bd90d4a2535902824467ae5e9",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[\"(1) Law enforcement personnel required to carry a firearm or other weapons while in the performance of law enforcement duty at the airport.\",\"(2) An individual authorized to carry a weapon in accordance with §§ 1544.219, 1544.221, 1544.223, 1546.211, or subpart B of part 1562 of this chapter.\",\"(3) An individual authorized to carry a weapon in a sterile area under a security program.\"],\"choice_text\":\"(1) Law enforcement personnel required to carry a firearm or other weapons while in the performance of law enforcement duty at the airport; (2) An individual authorized to carry a weapon in accordance with §§ 1544.219, 1544.221, 1544.223, 1546.211, or subpart B of part 1562 of this chapter; or (3) An individual authorized to carry a weapon in a sterile area under a security program.\",\"claimants\":[],\"concepts\":[],\"effective_periods\":[],\"jurisdiction\":\"\",\"kind\":\"exemption\",\"logic_text\":\"(b) On an individual's person or accessible property—permitted carriage of a weapon. Paragraph (a) of this section does not apply as to carriage of firearms and other weapons if the individual is one of the following:\",\"modality\":\"not_required\",\"object\":\"\",\"scope_text\":\"Applies to the carriage of firearms and other weapons on an individual's person or accessible property if the individual is law enforcement personnel required to carry a firearm or other weapons while in the performance of law enforcement duty at the airport; an individual authorized to carry a weapon in accordance with §§ 1544.219, 1544.221, 1544.223, 1546.211, or subpart B of part 1562 of this chapter; or an individual authorized to carry a weapon in a sterile area under a security program.\",\"summary\":\"Paragraph (a) of 49 CFR 1540.111 does not apply as to carriage of firearms and other weapons if the individual is one of the following: (1) law enforcement personnel required to carry a firearm or other weapons while in the performance of law enforcement duty at the airport; (2) an individual authorized to carry a weapon in accordance with §§ 1544.219, 1544.221, 1544.223, 1546.211, or subpart B of part 1562 of this chapter; or (3) an individual authorized to carry a weapon in a sterile area under a security program.\",\"typed_values\":[]}",
        "@type": "xsd:string"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed",
      "rkaf:hasApplicability": "urn:rulespec:document-understanding:scope:9e474f0f7d221a7564b1edf0fdfb7a2dd13f4b5383539ea417ea5f4981e92d31"
    },

            "text": "{\n  \"extractions\": [\n    {\n      \"unit\": \"F001:F004\",\n      \"unit_attributes\": {\n        \"kind\": \"prohibition\",\n        \"scope_quotes\": [\n          \"F001:F004\"\n        ],\n        \"scope_text\": \"Except as provided in paragraph (b) of 49 CFR 1540.111, applies when performance has begun of the inspection of the individual's person or accessible property before entering a sterile area, or before boarding an aircraft for which screening is conducted under this subchapter; when the individual is entering or in a sterile area; or when the individual is attempting to board or onboard an aircraft for which screening is conducted under §§ 1544.201, 1546.201, or 1562.23 of this chapter.\",\n        \"context_quotes\": [],\n        \"modality_quote\": \"may not\",\n        \"modality\": \"must_not\",\n        \"alternative_quotes\": [\n          \"F002\",\n          \"F003\",\n          \"F004\"\n        ],\n        \"choice_quote\": \"F002:F004\",\n        \"choice_text\": \"(1) When performance has begun of the inspection of the individual's person or accessible property before entering a sterile area, or before boarding an aircraft for which screening is conducted under this subchapter; (2) When the individual is entering or in a sterile area; or (3) When the individual is attempting to board or onboard an aircraft for which screening is conducted under §§ 1544.201, 1546.201, or 1562.23 of this chapter.\",\n        \"logic_quote\": \"F002:F004\",\n        \"references\": [\n          \"1544.201\",\n          \"1546.201\",\n          \"1562.23\"\n        ],\n        \"statement\": \"Except as provided in paragraph (b) of 49 CFR 1540.111, an individual may not have a weapon, explosive, or incendiary, on or about the individual's person or accessible property: (1) when performance has begun of the inspection of the individual's person or accessible property before entering a sterile area, or before boarding an aircraft for which screening is conducted under this subchapter; (2) when the individual is entering or in a sterile area; or (3) when the individual is attempting to board or onboard an aircraft for which screening is conducted under §§ 1544.201, 1546.201, or 1562.23 of this chapter.\"\n      }\n    },\n    {\n      \"unit\": \"F005:F008\",\n      \"unit_attributes\": {\n        \"kind\": \"exemption\",\n        \"scope_quotes\": [\n          \"F005:F008\"\n        ],\n        \"scope_text\": \"Applies to the carriage of firearms and other weapons on an individual's person or accessible property if the individual is law enforcement personnel required to carry a firearm or other weapons while in the performance of law enforcement duty at the airport; an individual authorized to carry a weapon in accordance with §§ 1544.219, 1544.221, 1544.223, 1546.211, or subpart B of part 1562 of this chapter; or an individual authorized to carry a weapon in a sterile area under a security program.\",\n        \"context_quotes\": [],\n        \"modality_quote\": \"does not apply\",\n        \"modality\": \"not_required\",\n        \"alternative_quotes\": [\n          \"F006\",\n          \"F007\",\n          \"F008\"\n        ],\n        \"choice_quote\": \"F006:F008\",\n        \"choice_text\": \"(1) Law enforcement personnel required to carry a firearm or other weapons while in the performance of law enforcement duty at the airport; (2) An individual authorized to carry a weapon in accordance with §§ 1544.219, 1544.221, 1544.223, 1546.211, or subpart B of part 1562 of this chapter; or (3) An individual authorized to carry a weapon in a sterile area under a security program.\",\n        \"logic_quote\": \"F005\",\n        \"references\": [\n          \"1544.219\",\n          \"1544.221\",\n          \"1544.223\",\n          \"1546.211\",\n          \"subpart B of part 1562\"\n        ],\n        \"statement\": \"Paragraph (a) of 49 CFR 1540.111 does not apply as to carriage of firearms and other weapons if the individual is one of the following: (1) law enforcement personnel required to carry a firearm or other weapons while in the performance of law enforcement duty at the airport; (2) an individual authorized to carry a weapon in accordance with §§ 1544.219, 1544.221, 1544.223, 1546.211, or subpart B of part 1562 of this chapter; or (3) an individual authorized to carry a weapon in a sterile area under a security program.\"\n      }\n    },\n    {\n      \"unit\": \"F010\",\n      \"unit_attributes\": {\n        \"kind\": \"prohibition\",\n        \"scope_quotes\": [\n          \"F009\"\n        ],\n        \"scope_text\": \"Applies when transporting or offering for transport in checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter.\",\n        \"context_quotes\": [],\n        \"modality_quote\": \"may not\",\n        \"modality\": \"must_not\",\n        \"alternative_quotes\": [],\n        \"choice_quote\": \"\",\n        \"choice_text\": \"\",\n        \"logic_quote\": \"\",\n        \"references\": [\n          \"1562.23\"\n        ],\n        \"statement\": \"A passenger may not transport or offer for transport in checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter any loaded firearm(s).\"\n      }\n    },\n    {\n      \"unit\": \"F011:F013\",\n      \"unit_attributes\": {\n        \"kind\": \"prohibition\",\n        \"scope_quotes\": [\n          \"F009\",\n          \"F011:F013\"\n        ],\n        \"scope_text\": \"Applies when transporting or offering for transport in checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter, unless the passenger declares to the aircraft operator, either orally or in writing, before checking the baggage, that the passenger has a firearm in his or her bag and that it is unloaded, and the firearm is unloaded.\",\n        \"context_quotes\": [\n          \"C000\"\n        ],\n        \"modality_quote\": \"may not\",\n        \"modality\": \"must_not\",\n        \"alternative_quotes\": [\n          \"F012\"\n        ],\n        \"choice_quote\": \"F012\",\n        \"choice_text\": \"either orally or in writing\",\n        \"logic_quote\": \"F011\",\n        \"references\": [\n          \"1562.23\"\n        ],\n        \"statement\": \"A passenger may not transport or offer for transport in checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter any unloaded firearm(s) unless: (i) the passenger declares to the aircraft operator, either orally or in writing, before checking the baggage, that the passenger has a firearm in his or her bag and that it is unloaded; and (ii) the firearm is unloaded.\"\n      }\n    }\n  ]\n}",

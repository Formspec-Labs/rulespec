      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:02a1f3c224e286472bf0e63d0ecb890e4852d2507881faa7774bf136d5f18fd7\",\"urn:rulespec:document-understanding:assertion:b72a34e9e11ebeb87dbdfaa663676e9df488ef559ad8ff6c082d46ad58f471aa\",\"urn:rulespec:document-understanding:assertion:18be2d8a71a15f07b9662d1bef1294bb8349ef3151bf8cbc79b30826b0066083\",\"urn:rulespec:document-understanding:assertion:8d970e6fea0747859df7b736ebfdb58e105017890276fa3fec9f1948beac368b\",\"urn:rulespec:document-understanding:assertion:fcea20833c0a06d76f279edd20ad9a2dc5c8a437503ff2f068083345cc8327ca\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[\"(iii) The firearm is carried in a hard-sided container; and\"],\"effective_periods\":[],\"end\":1840,\"evidence\":[{\"end\":1840,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aab45ff8a7d213a548ba64b9bd9efdd9202dcd2f94cc0c1045a1b5fb69fe86460:1586:1840:sha256-dcc656614d750e48df96b508e69124ac5f6e7dd5d0019280614aba907d6096f7\",\"quote\":\"(2) Any unloaded firearm(s) unless—\\n\\n(i) The passenger declares to the aircraft operator, either orally or in writing, before checking the baggage, that the passenger has a firearm in his or her bag and that it is unloaded;\\n\\n(ii) The firearm is unloaded;\",\"start\":1586},{\"end\":1840,\"field\":\"logic_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aab45ff8a7d213a548ba64b9bd9efdd9202dcd2f94cc0c1045a1b5fb69fe86460:1586:1840:sha256-dcc656614d750e48df96b508e69124ac5f6e7dd5d0019280614aba907d6096f7\",\"quote\":\"(2) Any unloaded firearm(s) unless—\\n\\n(i) The passenger declares to the aircraft operator, either orally or in writing, before checking the baggage, that the passenger has a firearm in his or her bag and that it is unloaded;\\n\\n(ii) The firearm is unloaded;\",\"start\":1586},{\"end\":1556,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aab45ff8a7d213a548ba64b9bd9efdd9202dcd2f94cc0c1045a1b5fb69fe86460:1376:1556:sha256-9dd5c9d0feb251838bff5c1a16b3c099ef083ecc7b0fca10625f4c8d5699fdf1\",\"quote\":\"(c) In checked baggage. A passenger may not transport or offer for transport in checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter:\",\"start\":1376},{\"end\":1840,\"field\":\"scope_text:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aab45ff8a7d213a548ba64b9bd9efdd9202dcd2f94cc0c1045a1b5fb69fe86460:1586:1840:sha256-dcc656614d750e48df96b508e69124ac5f6e7dd5d0019280614aba907d6096f7\",\"quote\":\"(2) Any unloaded firearm(s) unless—\\n\\n(i) The passenger declares to the aircraft operator, either orally or in writing, before checking the baggage, that the passenger has a firearm in his or her bag and that it is unloaded;\\n\\n(ii) The firearm is unloaded;\",\"start\":1586},{\"end\":1901,\"field\":\"context:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aab45ff8a7d213a548ba64b9bd9efdd9202dcd2f94cc0c1045a1b5fb69fe86460:1842:1901:sha256-e6a871e22fdb4f04a0b00e20075aa0b5b737e6d1cb0fd25f4f29d5a90551bd62\",\"quote\":\"(iii) The firearm is carried in a hard-sided container; and\",\"start\":1842}],\"id\":\"urn:rulespec:document-understanding:revision:ce62873b9255726cc9878e2cec098b939c1b7f1e605cd70c86a2d601abe3f0ea\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"prohibition\",\"logic_text\":\"(2) Any unloaded firearm(s) unless—\\n\\n(i) The passenger declares to the aircraft operator, either orally or in writing, before checking the baggage, that the passenger has a firearm in his or her bag and that it is unloaded;\\n\\n(ii) The firearm is unloaded;\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:fcea20833c0a06d76f279edd20ad9a2dc5c8a437503ff2f068083345cc8327ca\",\"modality\":\"must_not\",\"modality_quote\":\"may not\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:02d88b228936295bf87eb34f58dbf43ddb0d13e36706946a613955b424cae29a\",\"origin\":\"aiSuggested\",\"quote\":\"(2) Any unloaded firearm(s) unless—\\n\\n(i) The passenger declares to the aircraft operator, either orally or in writing, before checking the baggage, that the passenger has a firearm in his or her bag and that it is unloaded;\\n\\n(ii) The firearm is unloaded;\",\"references\":[\"1562.23\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:9abefad7728da62e8484398a54068b67e8b3684ab48d05326c832d6a58125921\",\"scope_quotes\":[\"(c) In checked baggage. A passenger may not transport or offer for transport in checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter:\",\"(2) Any unloaded firearm(s) unless—\\n\\n(i) The passenger declares to the aircraft operator, either orally or in writing, before checking the baggage, that the passenger has a firearm in his or her bag and that it is unloaded;\\n\\n(ii) The firearm is unloaded;\"],\"scope_text\":\"When a passenger transports or offers for transport baggage in checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter, unless the passenger declares to the aircraft operator, either orally or in writing, before checking the baggage, that the passenger has a firearm in his or her bag and that it is unloaded, and the firearm is unloaded.\",\"section_id\":\"section-1\",\"start\":1586,\"summary\":\"A passenger must not transport or offer for transport in checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter any unloaded firearm(s) unless: (i) the passenger declares to the aircraft operator, either orally or in writing, before checking the baggage, that the passenger has a firearm in his or her bag and that it is unloaded; and (ii) the firearm is unloaded.\",\"target_ids\":[],\"typed_values\":[]}",

    {
      "@id": "urn:rulespec:document-understanding:scope:c0e44e50bf622ed15d7a54f7bea9085cc1665fc4e627d1a4e6fa024dbac507a4",
      "@type": "rkaf:ApplicabilityScope",
      "rkaf:appliesInJurisdiction": [],
      "rkaf:applicabilityCondition": "When a passenger transports or offers for transport baggage in checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter, unless the passenger declares to the aircraft operator, either orally or in writing, before checking the baggage, that the passenger has a firearm in his or her bag and that it is unloaded, and the firearm is unloaded."
    },

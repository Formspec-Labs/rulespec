    {
      "@id": "urn:rulespec:document-understanding:assertion:4b53de4c89478e3b0ff844c08c4c0231deae7474c7f822a9e046c950d6f94181",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:1f636f3894316ff2e1cd31756f23071b86161a1fda4a1545bc07a81adce683ee",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:6824c10b00db6ae715e23c6c3ab9ace8aa12bdd38d5ca70ae6c09442068ea8e6",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:0231bb5cd16792b43906d415403d18bf0178d485aba19a1adb5b8697bed16a08",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[\"(1) Law enforcement personnel required to carry a firearm or other weapons while in the performance of law enforcement duty at the airport.\",\"(2) An individual authorized to carry a weapon in accordance with §§ 1544.219, 1544.221, 1544.223, 1546.211, or subpart B of part 1562 of this chapter.\",\"(3) An individual authorized to carry a weapon in a sterile area under a security program.\"],\"choice_text\":\"Paragraph (a) of this section does not apply if the individual is one of the following: (1) law enforcement personnel required to carry a firearm or other weapons while in the performance of law enforcement duty at the airport; (2) an individual authorized to carry a weapon in accordance with §§ 1544.219, 1544.221, 1544.223, 1546.211, or subpart B of part 1562 of this chapter; or (3) an individual authorized to carry a weapon in a sterile area under a security program.\",\"claimants\":[],\"concepts\":[],\"effective_periods\":[],\"jurisdiction\":\"\",\"kind\":\"exemption\",\"logic_text\":\"(b) On an individual's person or accessible property—permitted carriage of a weapon. Paragraph (a) of this section does not apply as to carriage of firearms and other weapons if the individual is one of the following:\\n\\n(1) Law enforcement personnel required to carry a firearm or other weapons while in the performance of law enforcement duty at the airport.\\n\\n(2) An individual authorized to carry a weapon in accordance with §§ 1544.219, 1544.221, 1544.223, 1546.211, or subpart B of part 1562 of this chapter.\\n\\n(3) An individual authorized to carry a weapon in a sterile area under a security program.\",\"modality\":\"not_required\",\"object\":\"\",\"scope_text\":\"As to carriage of firearms and other weapons on an individual's person or accessible property, if the individual is law enforcement personnel required to carry a firearm or other weapons while in the performance of law enforcement duty at the airport; an individual authorized to carry a weapon in accordance with §§ 1544.219, 1544.221, 1544.223, 1546.211, or subpart B of part 1562 of this chapter; or an individual authorized to carry a weapon in a sterile area under a security program.\",\"summary\":\"Paragraph (a) of 49 CFR 1540.111 does not apply as to carriage of firearms and other weapons on or about an individual's person or accessible property if the individual is: (1) law enforcement personnel required to carry a firearm or other weapons while in the performance of law enforcement duty at the airport; (2) an individual authorized to carry a weapon in accordance with §§ 1544.219, 1544.221, 1544.223, 1546.211, or subpart B of part 1562 of this chapter; or (3) an individual authorized to carry a weapon in a sterile area under a security program.\",\"typed_values\":[]}",
        "@type": "xsd:string"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed",
      "rkaf:hasApplicability": "urn:rulespec:document-understanding:scope:73c9cb1f1a73f5cbfdae54af851b1fe633d15995178faf3362cda998a09e5e22"
    },

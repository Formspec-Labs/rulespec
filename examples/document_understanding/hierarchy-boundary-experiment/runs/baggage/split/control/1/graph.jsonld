          "oa:exact": "(2) Any unloaded firearm(s) unless—\n\n(i) The passenger declares to the aircraft operator, either orally or in writing, before checking the baggage, that the passenger has a firearm in his or her bag and that it is unloaded;\n\n(ii) The firearm is unloaded;"
        },
        {
          "@type": "oa:TextPositionSelector",
          "oa:start": 1586,
          "oa:end": 1840,
          "rkaf:coordinateSystem": "rkaf:unicode-codepoint"

      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[\"(i) The passenger declares to the aircraft operator, either orally or in writing, before checking the baggage, that the passenger has a firearm in his or her bag and that it is unloaded;\",\"(ii) The firearm is unloaded;\"],\"choice_text\":\"Unless: (i) The passenger declares to the aircraft operator, either orally or in writing, before checking the baggage, that the passenger has a firearm in his or her bag and that it is unloaded; and (ii) The firearm is unloaded.\",\"claimants\":[],\"concepts\":[],\"effective_periods\":[],\"jurisdiction\":\"\",\"kind\":\"prohibition\",\"logic_text\":\"(2) Any unloaded firearm(s) unless—\",\"modality\":\"must_not\",\"object\":\"\",\"scope_text\":\"In checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter, unless specified conditions are met.\",\"summary\":\"A passenger may not transport or offer for transport any unloaded firearm(s) in checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter unless the passenger declares to the aircraft operator, either orally or in writing, before checking the baggage, that the passenger has a firearm in his or her bag and that it is unloaded, and the firearm is unloaded.\",\"typed_values\":[]}",

    {
      "@id": "urn:rulespec:document-understanding:assertion:53eff6bf8e5e0bc52d5a79ef72377370ba1e0ee4fcbe10aaa02f9434999d2a32",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:8dcc4c7224629f322fc6c7d8a2fb17b4304144cbf45a0cf45105abfeec8842f2",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:44fb0bd4f1d4bc4b4f9b23959f8251331880e3a56e05bc27bf8bb563b50f4f32",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:5232eea1d9c7d3cff164a22a7aee971ffc463cba8b5a662d54e52257c2c1d181",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[\"(1) Law enforcement personnel required to carry a firearm or other weapons while in the performance of law enforcement duty at the airport.\",\"(2) An individual authorized to carry a weapon in accordance with §§ 1544.219, 1544.221, 1544.223, 1546.211, or subpart B of part 1562 of this chapter.\",\"(3) An individual authorized to carry a weapon in a sterile area under a security program.\"],\"choice_text\":\"The individual is one of the following: (1) Law enforcement personnel required to carry a firearm or other weapons while in the performance of law enforcement duty at the airport; (2) An individual authorized to carry a weapon in accordance with §§ 1544.219, 1544.221, 1544.223, 1546.211, or subpart B of part 1562 of this chapter; or (3) An individual authorized to carry a weapon in a sterile area under a security program.\",\"claimants\":[],\"concepts\":[],\"effective_periods\":[],\"jurisdiction\":\"\",\"kind\":\"exemption\",\"logic_text\":\"(b) On an individual's person or accessible property—permitted carriage of a weapon. Paragraph (a) of this section does not apply as to carriage of firearms and other weapons if the individual is one of the following:\",\"modality\":\"not_required\",\"object\":\"\",\"scope_text\":\"As to carriage of firearms and other weapons on an individual's person or accessible property.\",\"summary\":\"Paragraph (a) of 49 CFR 1540.111 does not apply to carriage of firearms and other weapons if the individual is law enforcement personnel required to carry a firearm or other weapons while performing law enforcement duty at the airport, an individual authorized to carry a weapon in accordance with §§ 1544.219, 1544.221, 1544.223, 1546.211, or subpart B of part 1562 of this chapter, or an individual authorized to carry a weapon in a sterile area under a security program.\",\"typed_values\":[]}",
        "@type": "xsd:string"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed",
      "rkaf:hasApplicability": "urn:rulespec:document-understanding:scope:f1550aefa490763bbfb5e459eada9d6c63b34423ed6b64b4865b055ca9028c52"
    },

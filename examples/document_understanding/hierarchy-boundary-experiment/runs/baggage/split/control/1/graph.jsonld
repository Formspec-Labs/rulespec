    {
      "@id": "urn:rulespec:document-understanding:revision:324d41f7ea6f3b27c43c46082c941143f1fad2a9fc4346cf5e0d2c6fe3af0f4b",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:324d41f7ea6f3b27c43c46082c941143f1fad2a9fc4346cf5e0d2c6fe3af0f4b",

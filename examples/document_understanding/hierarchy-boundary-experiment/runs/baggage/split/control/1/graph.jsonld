      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[\"(i) The passenger declares to the aircraft operator, either orally or in writing, before checking the baggage, that the passenger has a firearm in his or her bag and that it is unloaded;\",\"(ii) The firearm is unloaded;\"],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:4827602a564f5a2a9c8a548352ae682222fb12868e43171f49ba87b6a1c8ad60\",\"urn:rulespec:document-understanding:assertion:a8804cd94ed1fe33823405b047a21ec92ed48701087f44b910c3807a37574210\",\"urn:rulespec:document-understanding:assertion:98d3fae42f45f384df2ebbbe9a941b878d289a23342693693d655b0054a53c73\",\"urn:rulespec:document-understanding:assertion:d09696278381d4d2dee0318661a7e238b87baf954bc24001cd5f5d0273ee523f\",\"urn:rulespec:document-understanding:assertion:1f1e753fdf4da607c249f70905196ae1c521ffa8eb0cbf83b3e64620c1af6b63\",\"urn:rulespec:document-understanding:assertion:7107bc662bf3ce5ada926cceef0aeb75ee258a3d6c6819e6d234da7a8e3320a4\",\"urn:rulespec:document-understanding:assertion:6003ec70e18e8f170b0a86afa10b3eb5c90b61a006e9e63d71b1cb28a6b56471\",\"urn:rulespec:document-understanding:assertion:daf3a659250166f7c83d90f19cf4c86170ede5f0b915294b1311993c53d097f4\"],\"choice_quote\":\"(2) Any unloaded firearm(s) unless—\\n\\n(i) The passenger declares to the aircraft operator, either orally or in writing, before checking the baggage, that the passenger has a firearm in his or her bag and that it is unloaded;\\n\\n(ii) The firearm is unloaded;\",\"choice_text\":\"Unless: (i) The passenger declares to the aircraft operator, either orally or in writing, before checking the baggage, that the passenger has a firearm in his or her bag and that it is unloaded; and (ii) The firearm is unloaded.\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[\"(iii) The firearm is carried in a hard-sided container; and\"],\"effective_periods\":[],\"end\":1840,\"evidence\":[{\"end\":1840,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aab45ff8a7d213a548ba64b9bd9efdd9202dcd2f94cc0c1045a1b5fb69fe86460:1586:1840:sha256-dcc656614d750e48df96b508e69124ac5f6e7dd5d0019280614aba907d6096f7\",\"quote\":\"(2) Any unloaded firearm(s) unless—\\n\\n(i) The passenger declares to the aircraft operator, either orally or in writing, before checking the baggage, that the passenger has a firearm in his or her bag and that it is unloaded;\\n\\n(ii) The firearm is unloaded;\",\"start\":1586},{\"end\":1621,\"field\":\"logic_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aab45ff8a7d213a548ba64b9bd9efdd9202dcd2f94cc0c1045a1b5fb69fe86460:1586:1621:sha256-a03b234b39a7e3d902b46246302bd2c0d5986a277e51dcd12feeb18f5483f16c\",\"quote\":\"(2) Any unloaded firearm(s) unless—\",\"start\":1586},{\"end\":1840,\"field\":\"choice_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aab45ff8a7d213a548ba64b9bd9efdd9202dcd2f94cc0c1045a1b5fb69fe86460:1586:1840:sha256-dcc656614d750e48df96b508e69124ac5f6e7dd5d0019280614aba907d6096f7\",\"quote\":\"(2) Any unloaded firearm(s) unless—\\n\\n(i) The passenger declares to the aircraft operator, either orally or in writing, before checking the baggage, that the passenger has a firearm in his or her bag and that it is unloaded;\\n\\n(ii) The firearm is unloaded;\",\"start\":1586},{\"end\":1556,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aab45ff8a7d213a548ba64b9bd9efdd9202dcd2f94cc0c1045a1b5fb69fe86460:1376:1556:sha256-9dd5c9d0feb251838bff5c1a16b3c099ef083ecc7b0fca10625f4c8d5699fdf1\",\"quote\":\"(c) In checked baggage. A passenger may not transport or offer for transport in checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter:\",\"start\":1376},{\"end\":1621,\"field\":\"scope_text:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aab45ff8a7d213a548ba64b9bd9efdd9202dcd2f94cc0c1045a1b5fb69fe86460:1586:1621:sha256-a03b234b39a7e3d902b46246302bd2c0d5986a277e51dcd12feeb18f5483f16c\",\"quote\":\"(2) Any unloaded firearm(s) unless—\",\"start\":1586},{\"end\":1901,\"field\":\"context:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aab45ff8a7d213a548ba64b9bd9efdd9202dcd2f94cc0c1045a1b5fb69fe86460:1842:1901:sha256-e6a871e22fdb4f04a0b00e20075aa0b5b737e6d1cb0fd25f4f29d5a90551bd62\",\"quote\":\"(iii) The firearm is carried in a hard-sided container; and\",\"start\":1842},{\"end\":1809,\"field\":\"alternative:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aab45ff8a7d213a548ba64b9bd9efdd9202dcd2f94cc0c1045a1b5fb69fe86460:1623:1809:sha256-f6fe03740da837c967d5e1a19cc83bd62f4517d0b086d968201a40859ccf0a16\",\"quote\":\"(i) The passenger declares to the aircraft operator, either orally or in writing, before checking the baggage, that the passenger has a firearm in his or her bag and that it is unloaded;\",\"start\":1623},{\"end\":1840,\"field\":\"alternative:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aab45ff8a7d213a548ba64b9bd9efdd9202dcd2f94cc0c1045a1b5fb69fe86460:1811:1840:sha256-728d008fcfc79639161d8c2b1d0a6f86e145e04143be6ec504ef19d73771e1d6\",\"quote\":\"(ii) The firearm is unloaded;\",\"start\":1811}],\"id\":\"urn:rulespec:document-understanding:revision:e1930ea47e2807e66ab208c91d10384d549d5b724c2fe0b2b40d687c52c5aa3b\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"prohibition\",\"logic_text\":\"(2) Any unloaded firearm(s) unless—\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:daf3a659250166f7c83d90f19cf4c86170ede5f0b915294b1311993c53d097f4\",\"modality\":\"must_not\",\"modality_quote\":\"may not\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:03e979fedc0c71f8ef53d1c4affdcdf104e07f3eed939b024c37bc3dc3a50983\",\"origin\":\"aiSuggested\",\"quote\":\"(2) Any unloaded firearm(s) unless—\\n\\n(i) The passenger declares to the aircraft operator, either orally or in writing, before checking the baggage, that the passenger has a firearm in his or her bag and that it is unloaded;\\n\\n(ii) The firearm is unloaded;\",\"references\":[\"§ 1562.23\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:a0810ce49b804a4c3b697819673cb28d9c673765fc06a42c443385ac3bc79f92\",\"scope_quotes\":[\"(c) In checked baggage. A passenger may not transport or offer for transport in checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter:\",\"(2) Any unloaded firearm(s) unless—\"],\"scope_text\":\"In checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter, unless specified conditions are met.\",\"section_id\":\"section-1\",\"start\":1586,\"summary\":\"A passenger may not transport or offer for transport any unloaded firearm(s) in checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter unless the passenger declares to the aircraft operator, either orally or in writing, before checking the baggage, that the passenger has a firearm in his or her bag and that it is unloaded, and the firearm is unloaded.\",\"target_ids\":[],\"typed_values\":[]}",

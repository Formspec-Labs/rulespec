      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:8dcc4c7224629f322fc6c7d8a2fb17b4304144cbf45a0cf45105abfeec8842f2",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:44fb0bd4f1d4bc4b4f9b23959f8251331880e3a56e05bc27bf8bb563b50f4f32",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:6477eed777679ff5b578e2ee4cf16463cd9a2b41a06ebd0c6be4a36d6b4f015d",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[\"(1) When performance has begun of the inspection of the individual's person or accessible property before entering a sterile area, or before boarding an aircraft for which screening is conducted under this subchapter;\",\"(2) When the individual is entering or in a sterile area; or\",\"(3) When the individual is attempting to board or onboard an aircraft for which screening is conducted under §§ 1544.201, 1546.201, or 1562.23 of this chapter.\"],\"choice_text\":\"When performance has begun of the inspection of the individual's person or accessible property before entering a sterile area, or before boarding an aircraft for which screening is conducted under this subchapter; or when the individual is entering or in a sterile area; or when the individual is attempting to board or onboard an aircraft for which screening is conducted under §§ 1544.201, 1546.201, or 1562.23 of this chapter.\",\"claimants\":[],\"concepts\":[],\"effective_periods\":[],\"jurisdiction\":\"\",\"kind\":\"prohibition\",\"logic_text\":\"(2) When the individual is entering or in a sterile area; or\",\"modality\":\"must_not\",\"object\":\"\",\"scope_text\":\"Except as provided in paragraph (b) of 49 CFR 1540.111.\",\"summary\":\"Except as provided in paragraph (b) of this section, an individual may not have a weapon, explosive, or incendiary, on or about the individual's person or accessible property when performance has begun of the inspection of the individual's person or accessible property before entering a sterile area or before boarding a screened aircraft, when entering or in a sterile area, or when attempting to board or onboard an aircraft screened under §§ 1544.201, 1546.201, or 1562.23 of this chapter.\",\"typed_values\":[]}",
        "@type": "xsd:string"
      },

      "@id": "urn:rulespec:document-understanding:scope:5a10325e0fcb2f88409b8d88355178c4e0719e6a4b366a3026681cc8625107ad",
      "@type": "rkaf:ApplicabilityScope",
      "rkaf:appliesInJurisdiction": [],
      "rkaf:applicabilityCondition": "In checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter, unless specified conditions are met."
    },
    {
      "@id": "urn:rulespec:document-understanding:assertion:4827602a564f5a2a9c8a548352ae682222fb12868e43171f49ba87b6a1c8ad60",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:8dcc4c7224629f322fc6c7d8a2fb17b4304144cbf45a0cf45105abfeec8842f2",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:44fb0bd4f1d4bc4b4f9b23959f8251331880e3a56e05bc27bf8bb563b50f4f32",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:a0810ce49b804a4c3b697819673cb28d9c673765fc06a42c443385ac3bc79f92",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:states-prohibition",
      "rkaf:assertsValue": {
        "@value": "A passenger may not transport or offer for transport any unloaded firearm(s) in checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter unless the passenger declares to the aircraft operator, either orally or in writing, before checking the baggage, that the passenger has a firearm in his or her bag and that it is unloaded, and the firearm is unloaded.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

            "text": "{\"extractions\":[{\"unit\":\"F000\",\"unit_attributes\":{\"kind\":\"prohibition\",\"scope_quotes\":[\"C000\",\"C001\"],\"scope_text\":\"When a passenger transports or offers for transport in checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter any unloaded firearm(s).\",\"context_quotes\":[],\"modality_quote\":\"may not\",\"modality\":\"must_not\",\"alternative_quotes\":[],\"choice_quote\":\"\",\"choice_text\":\"\",\"logic_quote\":\"C001\",\"references\":[\"§ 1562.23\"],\"statement\":\"A passenger may not transport or offer for transport in checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter any unloaded firearm(s) unless the firearm is carried in a hard-sided container.\"}},{\"unit\":\"F001\",\"unit_attributes\":{\"kind\":\"prohibition\",\"scope_quotes\":[\"C000\",\"C001\"],\"scope_text\":\"When a passenger transports or offers for transport in checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter any unloaded firearm(s).\",\"context_quotes\":[],\"modality_quote\":\"may not\",\"modality\":\"must_not\",\"alternative_quotes\":[],\"choice_quote\":\"F001\",\"choice_text\":\"the key or combination\",\"logic_quote\":\"F001\",\"references\":[\"§ 1562.23\"],\"statement\":\"A passenger may not transport or offer for transport in checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter any unloaded firearm(s) unless the container in which it is carried is locked, and only the passenger retains the key or combination.\"}},{\"unit\":\"F002\",\"unit_attributes\":{\"kind\":\"prohibition\",\"scope_quotes\":[\"C000\"],\"scope_text\":\"In checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter.\",\"context_quotes\":[],\"modality_quote\":\"may not\",\"modality\":\"must_not\",\"alternative_quotes\":[\"F002\"],\"choice_quote\":\"F002\",\"choice_text\":\"unauthorized explosive or incendiary\",\"logic_quote\":\"F002\",\"references\":[\"§ 1562.23\"],\"statement\":\"A passenger may not transport or offer for transport in checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter any unauthorized explosive or incendiary.\"}},{\"unit\":\"F003\",\"unit_attributes\":{\"kind\":\"exemption\",\"scope_quotes\":[],\"scope_text\":\"\",\"context_quotes\":[],\"modality_quote\":\"does not prohibit\",\"modality\":\"not_required\",\"alternative_quotes\":[\"F003\"],\"choice_quote\":\"F003\",\"choice_text\":\"carriage of ammunition in checked baggage or in the same container as a firearm\",\"logic_quote\":\"F003\",\"references\":[],\"statement\":\"This section does not prohibit the carriage of ammunition in checked baggage or in the same container as a firearm.\"}},{\"unit\":\"F003\",\"unit_attributes\":{\"kind\":\"statement\",\"scope_quotes\":[],\"scope_text\":\"\",\"context_quotes\":[],\"modality_quote\":\"\",\"modality\":\"not_stated\",\"alternative_quotes\":[],\"choice_quote\":\"\",\"choice_text\":\"\",\"logic_quote\":\"\",\"references\":[\"Title 49 CFR part 175\"],\"statement\":\"Title 49 CFR part 175 provides additional requirements governing carriage of ammunition on aircraft.\"}}]}",

    {
      "@id": "urn:rulespec:document-understanding:assertion:d3c3200ba248c1d49f838ac9e2d2c95db965068f70dc16da5a3002d952b9bbe2",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:3cde08e812f305777c9541f4ed262422acc118cff067ca6777351d7676ff30d9",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:d1e69187b8ceff5a61b0201424bdc5a6c5738f5b55b10131929583f8834985ff",

    {
      "@id": "urn:rulespec:document-understanding:revision:26d8c47f127ca408ebadedbb8d1c96b65e52744661caa0d70908d136abc46bbb",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:26d8c47f127ca408ebadedbb8d1c96b65e52744661caa0d70908d136abc46bbb",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:78d5dea607273d1cc88637a3d315faa990ba3e76e2bae25683cd34593469ffe6",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:16567ed82515bcd4ced1988839baef3b6e557c9e06ab809a2213dd135a9bfc9a\",\"urn:rulespec:document-understanding:assertion:d0f76353b7212884ef395eec577fdecbfb61e7372c08d52b6f6223cef154cd0d\",\"urn:rulespec:document-understanding:assertion:1560e93e9810973e35d7600a0709d3dea9fd26660d1eecf8e0dc62dd0a4bd140\",\"urn:rulespec:document-understanding:assertion:e0938729e784d63281e0853f2c13fa4bdc4cdabf7914462b5fab58ab6b43cb6b\",\"urn:rulespec:document-understanding:assertion:9b41934a90b4b4ddeaf21d45602eda7821f9e321f4565dd012bb21b1b4ccfd36\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[\"(iii) The firearm is carried in a hard-sided container; and\"],\"effective_periods\":[],\"end\":1840,\"evidence\":[{\"end\":1840,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aab45ff8a7d213a548ba64b9bd9efdd9202dcd2f94cc0c1045a1b5fb69fe86460:1376:1840:sha256-5b61286145d4d72859f33d3cfa592e8fde009b5264e05cb2532505c101143790\",\"quote\":\"(c) In checked baggage. A passenger may not transport or offer for transport in checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter:\\n\\n(1) Any loaded firearm(s).\\n\\n(2) Any unloaded firearm(s) unless—\\n\\n(i) The passenger declares to the aircraft operator, either orally or in writing, before checking the baggage, that the passenger has a firearm in his or her bag and that it is unloaded;\\n\\n(ii) The firearm is unloaded;\",\"start\":1376},{\"end\":1621,\"field\":\"logic_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aab45ff8a7d213a548ba64b9bd9efdd9202dcd2f94cc0c1045a1b5fb69fe86460:1586:1621:sha256-a03b234b39a7e3d902b46246302bd2c0d5986a277e51dcd12feeb18f5483f16c\",\"quote\":\"(2) Any unloaded firearm(s) unless—\",\"start\":1586},{\"end\":1419,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aab45ff8a7d213a548ba64b9bd9efdd9202dcd2f94cc0c1045a1b5fb69fe86460:1412:1419:sha256-0007a8bea4dcd3f6b1490fc7199650f1046713dd92d9314e1f2ede6946fcd999\",\"quote\":\"may not\",\"start\":1412},{\"end\":1556,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aab45ff8a7d213a548ba64b9bd9efdd9202dcd2f94cc0c1045a1b5fb69fe86460:1376:1556:sha256-9dd5c9d0feb251838bff5c1a16b3c099ef083ecc7b0fca10625f4c8d5699fdf1\",\"quote\":\"(c) In checked baggage. A passenger may not transport or offer for transport in checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter:\",\"start\":1376},{\"end\":1840,\"field\":\"scope_text:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aab45ff8a7d213a548ba64b9bd9efdd9202dcd2f94cc0c1045a1b5fb69fe86460:1586:1840:sha256-dcc656614d750e48df96b508e69124ac5f6e7dd5d0019280614aba907d6096f7\",\"quote\":\"(2) Any unloaded firearm(s) unless—\\n\\n(i) The passenger declares to the aircraft operator, either orally or in writing, before checking the baggage, that the passenger has a firearm in his or her bag and that it is unloaded;\\n\\n(ii) The firearm is unloaded;\",\"start\":1586},{\"end\":1901,\"field\":\"context:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aab45ff8a7d213a548ba64b9bd9efdd9202dcd2f94cc0c1045a1b5fb69fe86460:1842:1901:sha256-e6a871e22fdb4f04a0b00e20075aa0b5b737e6d1cb0fd25f4f29d5a90551bd62\",\"quote\":\"(iii) The firearm is carried in a hard-sided container; and\",\"start\":1842}],\"id\":\"urn:rulespec:document-understanding:revision:26d8c47f127ca408ebadedbb8d1c96b65e52744661caa0d70908d136abc46bbb\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"prohibition\",\"logic_text\":\"(2) Any unloaded firearm(s) unless—\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:9b41934a90b4b4ddeaf21d45602eda7821f9e321f4565dd012bb21b1b4ccfd36\",\"modality\":\"must_not\",\"modality_quote\":\"may not\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:e527cd6f0dfe8b598a4bbae11eb770ac5f0d2bb8cecb0b9668148970c0d9a0dd\",\"origin\":\"aiSuggested\",\"quote\":\"(c) In checked baggage. A passenger may not transport or offer for transport in checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter:\\n\\n(1) Any loaded firearm(s).\\n\\n(2) Any unloaded firearm(s) unless—\\n\\n(i) The passenger declares to the aircraft operator, either orally or in writing, before checking the baggage, that the passenger has a firearm in his or her bag and that it is unloaded;\\n\\n(ii) The firearm is unloaded;\",\"references\":[\"§ 1562.23\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:4e866aaf1944299277667331b9219f4aef7b0e1b9ab1efdcc4b06ac8bcadb4e1\",\"scope_quotes\":[\"(c) In checked baggage. A passenger may not transport or offer for transport in checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter:\",\"(2) Any unloaded firearm(s) unless—\\n\\n(i) The passenger declares to the aircraft operator, either orally or in writing, before checking the baggage, that the passenger has a firearm in his or her bag and that it is unloaded;\\n\\n(ii) The firearm is unloaded;\"],\"scope_text\":\"In checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter, unless the passenger declares to the aircraft operator, either orally or in writing, before checking the baggage, that the passenger has a firearm in his or her bag and that it is unloaded, and the firearm is unloaded.\",\"section_id\":\"section-1\",\"start\":1376,\"summary\":\"A passenger may not transport or offer for transport any unloaded firearm(s) in checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter unless the passenger declares to the aircraft operator, orally or in writing, before checking the baggage, that the passenger has a firearm in his or her bag and that it is unloaded, and the firearm is unloaded.\",\"target_ids\":[],\"typed_values\":[]}",

id\":\"urn:rulespec:document-understanding:occurrence:0db9fe2e8af19d6efbd83a46d330496454d95e2732acd14030b4c79c6b667492\",\"origin\":\"aiSuggested\",\"quote\":\"(1) Any loaded firearm(s).\",\"references\":[\"1562.23\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:4a7e70168dab9cfa2e912fbede8311ea00c0c63ad1b614673f1904fe3280b746\",\"scope_quotes\":[\"(c) In checked baggage. A passenger may not transport or offer for transport in checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter:\"],\"scope_text\":\"A passenger transporting or offering for transport baggage in checked baggage or in baggage carried in an inaccessible cargo hold under 49 CFR 1562.23.\",\"section_id\":\"section-1\",\"start\":1558,\"summary\":\"A passenger may not transport or offer for transport any loaded firearm(s) in checked baggage or in baggage carried in an inaccessible cargo hold under 49 CFR 1562.23.\",\"target_ids\":[],\"typed_values\":[]}",

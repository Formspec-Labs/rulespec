      "rkaf:applicabilityCondition": "Applies to the carriage of firearms and other weapons on an individual's person or accessible property if the individual is one of the qualifying individuals specified in paragraph (b)."
    },
    {
      "@id": "urn:rulespec:document-understanding:assertion:758350dde3611c5132fe0194354d531d1505c4c5ac8ad5ffd7005b143f154e58",
      "@type": "rkaf:ValueAssertion",

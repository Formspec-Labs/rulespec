    {
      "@id": "urn:rulespec:document-understanding:assertion:cb07db8a364410fe8987cad35d5db9231cdb7e9089f8954868da88693859785d",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:0306e3ae0d661cda39498883f066ec3827c6a616704e1dde0a184cfc2d950e3f",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:684db64f8003187fd4fcba2355d440b03b5b16176d134008bfa50f48d73848b3",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:586993cbbe9e7a5ee7f3d406b8b63cb4cafc13d88b1399b950b505f163727da5",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[\"(1) When performance has begun of the inspection of the individual's person or accessible property before entering a sterile area, or before boarding an aircraft for which screening is conducted under this subchapter;\",\"(2) When the individual is entering or in a sterile area; or\",\"(3) When the individual is attempting to board or onboard an aircraft for which screening is conducted under §§ 1544.201, 1546.201, or 1562.23 of this chapter.\"],\"choice_text\":\"Any of the following situations: (1) when performance has begun of the inspection of the individual's person or accessible property before entering a sterile area, or before boarding an aircraft for which screening is conducted under this subchapter; (2) when the individual is entering or in a sterile area; or (3) when the individual is attempting to board or onboard an aircraft for which screening is conducted under 49 CFR 1544.201, 1546.201, or 1562.23.\",\"claimants\":[],\"concepts\":[],\"effective_periods\":[],\"jurisdiction\":\"\",\"kind\":\"prohibition\",\"logic_text\":\"(2) When the individual is entering or in a sterile area; or\",\"modality\":\"must_not\",\"object\":\"\",\"scope_text\":\"Except as provided in paragraph (b) of 49 CFR 1540.111, when performance has begun of the inspection of the individual's person or accessible property before entering a sterile area or before boarding an aircraft for which screening is conducted under this subchapter; when the individual is entering or in a sterile area; or when the individual is attempting to board or onboard an aircraft for which screening is conducted under 49 CFR 1544.201, 1546.201, or 1562.23.\",\"summary\":\"Except as provided in paragraph (b) of 49 CFR 1540.111, an individual may not have a weapon, explosive, or incendiary on or about the individual's person or accessible property when inspection has begun before entering a sterile area or boarding a screened aircraft, when entering or in a sterile area, or when attempting to board or onboard an aircraft screened under 49 CFR 1544.201, 1546.201, or 1562.23.\",\"typed_values\":[]}",
        "@type": "xsd:string"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed",
      "rkaf:hasApplicability": "urn:rulespec:document-understanding:scope:fabe152069cafce27b47b79952c960364e4b5dde78a0fc47ce540fa63a093983"
    },

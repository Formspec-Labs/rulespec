        "@value": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"effective_periods\":[],\"jurisdiction\":\"\",\"kind\":\"prohibition\",\"logic_text\":\"\",\"modality\":\"must_not\",\"object\":\"\",\"scope_text\":\"A passenger transporting or offering for transport baggage in checked baggage or in baggage carried in an inaccessible cargo hold under 49 CFR 1562.23.\",\"summary\":\"A passenger may not transport or offer for transport any unauthorized explosive or incendiary in checked baggage or in baggage carried in an inaccessible cargo hold under 49 CFR 1562.23.\",\"typed_values\":[]}",

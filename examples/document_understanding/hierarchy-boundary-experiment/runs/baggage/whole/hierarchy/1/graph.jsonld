    {
      "@id": "urn:rulespec:document-understanding:assertion:c7677e4bdffd08786b6d723500446e8549114b666ed3fe9a485da4b9fade41b2",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:0306e3ae0d661cda39498883f066ec3827c6a616704e1dde0a184cfc2d950e3f",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:684db64f8003187fd4fcba2355d440b03b5b16176d134008bfa50f48d73848b3",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:d66008419ebb9e049ec03d5b6fce7b16e69b3039bd8eff56e1abad6739dbaf1d",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[\"(1) Law enforcement personnel required to carry a firearm or other weapons while in the performance of law enforcement duty at the airport.\",\"(2) An individual authorized to carry a weapon in accordance with §§ 1544.219, 1544.221, 1544.223, 1546.211, or subpart B of part 1562 of this chapter.\",\"(3) An individual authorized to carry a weapon in a sterile area under a security program.\"],\"choice_text\":\"The individual must be one of the following: (1) law enforcement personnel required to carry a firearm or other weapons while in the performance of law enforcement duty at the airport; (2) an individual authorized to carry a weapon in accordance with 49 CFR 1544.219, 1544.221, 1544.223, 1546.211, or subpart B of part 1562; or (3) an individual authorized to carry a weapon in a sterile area under a security program.\",\"claimants\":[],\"concepts\":[],\"effective_periods\":[],\"jurisdiction\":\"\",\"kind\":\"exemption\",\"logic_text\":\"(b) On an individual's person or accessible property—permitted carriage of a weapon. Paragraph (a) of this section does not apply as to carriage of firearms and other weapons if the individual is one of the following:\",\"modality\":\"not_required\",\"object\":\"\",\"scope_text\":\"Applies to the carriage of firearms and other weapons on an individual's person or accessible property if the individual is one of the qualifying individuals specified in paragraph (b).\",\"summary\":\"Paragraph (a) of 49 CFR 1540.111 does not apply to the carriage of firearms and other weapons on or about an individual's person or accessible property if the individual is law enforcement personnel required to carry a firearm or other weapons while in the performance of law enforcement duty at the airport, an individual authorized to carry a weapon under 49 CFR 1544.219, 1544.221, 1544.223, 1546.211, or subpart B of part 1562, or an individual authorized to carry a weapon in a sterile area under a security program.\",\"typed_values\":[]}",
        "@type": "xsd:string"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed",
      "rkaf:hasApplicability": "urn:rulespec:document-understanding:scope:9053a01e678c443b901ee5287876cb828f44abac8da2aa1819aca8c4e7772479"
    },

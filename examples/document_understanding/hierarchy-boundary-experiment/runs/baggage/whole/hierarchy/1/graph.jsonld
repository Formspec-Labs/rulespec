    {
      "@id": "urn:rulespec:document-understanding:assertion:b97c760efd4b555590129a14a8f4d9fde7738a7433cb3b91d67794629e65f8d6",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:0306e3ae0d661cda39498883f066ec3827c6a616704e1dde0a184cfc2d950e3f",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:684db64f8003187fd4fcba2355d440b03b5b16176d134008bfa50f48d73848b3",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:95ad790e6fd7ba0edaa3db5afa2de0e52fd87ca711df6c3edb4c80ff9000d683",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:choice_text",
      "rkaf:assertsValue": {
        "@value": "All of the following conditions are required to be satisfied: (i) the passenger declares to the aircraft operator, either orally or in writing, before checking the baggage, that the passenger has a firearm in his or her bag and that it is unloaded; (ii) the firearm is unloaded; (iii) the firearm is carried in a hard-sided container; and (iv) the container in which it is carried is locked, and only the passenger retains the key or combination.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

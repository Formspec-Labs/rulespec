    {
      "@id": "urn:rulespec:document-understanding:assertion:d1c646c46a6a4f9c7ea95ce41fac81c20fa7fb9714b047f876d95c4267ffe47c",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:0306e3ae0d661cda39498883f066ec3827c6a616704e1dde0a184cfc2d950e3f",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:684db64f8003187fd4fcba2355d440b03b5b16176d134008bfa50f48d73848b3",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:95ad790e6fd7ba0edaa3db5afa2de0e52fd87ca711df6c3edb4c80ff9000d683",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[\"(i) The passenger declares to the aircraft operator, either orally or in writing, before checking the baggage, that the passenger has a firearm in his or her bag and that it is unloaded;\",\"(ii) The firearm is unloaded;\",\"(iii) The firearm is carried in a hard-sided container; and\",\"(iv) The container in which it is carried is locked, and only the passenger retains the key or combination.\"],\"choice_text\":\"All of the following conditions are required to be satisfied: (i) the passenger declares to the aircraft operator, either orally or in writing, before checking the baggage, that the passenger has a firearm in his or her bag and that it is unloaded; (ii) the firearm is unloaded; (iii) the firearm is carried in a hard-sided container; and (iv) the container in which it is carried is locked, and only the passenger retains the key or combination.\",\"claimants\":[],\"concepts\":[],\"effective_periods\":[],\"jurisdiction\":\"\",\"kind\":\"prohibition\",\"logic_text\":\"(iii) The firearm is carried in a hard-sided container; and\\n\\n(iv) The container in which it is carried is locked, and only the passenger retains the key or combination.\",\"modality\":\"must_not\",\"object\":\"\",\"scope_text\":\"A passenger transporting or offering for transport baggage in checked baggage or in baggage carried in an inaccessible cargo hold under 49 CFR 1562.23, unless all conditions of paragraphs (c)(2)(i) through (iv) are met.\",\"summary\":\"A passenger may not transport or offer for transport any unloaded firearm(s) in checked baggage or in baggage carried in an inaccessible cargo hold under 49 CFR 1562.23 unless the passenger declares it orally or in writing to the aircraft operator before checking that the firearm is in the bag and unloaded, the firearm is unloaded, the firearm is carried in a hard-sided container, and the container is locked with only the passenger retaining the key or combination.\",\"typed_values\":[]}",
        "@type": "xsd:string"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed",
      "rkaf:hasApplicability": "urn:rulespec:document-understanding:scope:4403b5307b69681bf9b65ffcd86df0a7336882bf7d0d18e18656e05283e7a94b"
    },

      "rkaf:assertsValue": {
        "@value": "A passenger transporting or offering for transport baggage in checked baggage or in baggage carried in an inaccessible cargo hold under 49 CFR 1562.23, unless all conditions of paragraphs (c)(2)(i) through (iv) are met.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },
    {
      "@id": "urn:rulespec:document-understanding:binding:7eef2c2cbf7d59a110ce4f677fb0d75e07b41d13e2c69d881220cb1b0ff47935",

      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:2076554fa43e11fa6a1ac5da629ecd8473e290831bfba270c0148259752294d0",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:c51cb1d7e669d3d73aea571a2b2849869af137c6ffe1dc4550a59c73443a94cc",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:d80530a2a8de916fb15c010b27ba0f0e31a0b66606e8036c06da7aa107d6b578",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:states-prohibition",
      "rkaf:assertsValue": {
        "@value": "A passenger may not transport or offer for transport in checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter any unloaded firearm(s) unless: (1) the passenger declares to the aircraft operator, either orally or in writing, before checking the baggage, that the passenger has a firearm in his or her bag and that it is unloaded; (2) the firearm is unloaded; (3) the firearm is carried in a hard-sided container; and (4) the container in which it is carried is locked, and only the passenger retains the key or combination.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

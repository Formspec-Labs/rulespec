    {
      "@id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aab45ff8a7d213a548ba64b9bd9efdd9202dcd2f94cc0c1045a1b5fb69fe86460:1586:2010:sha256-55445821b85174dd35baccbe029635bc4b535d4c2fb27e8faef334a78e47a106",
      "@type": "rkaf:SourceFragment",
      "oa:hasSource": "urn:rulespec:document-understanding:document:ab45ff8a7d213a548ba64b9bd9efdd9202dcd2f94cc0c1045a1b5fb69fe86460",
      "rkaf:fragmentIdentityScheme": "rkaf:carrier-local-fragment",
      "rkaf:sourceArtifactDigest": "sha256:ab45ff8a7d213a548ba64b9bd9efdd9202dcd2f94cc0c1045a1b5fb69fe86460",
      "rkaf:fragmentContentDigest": "sha256:55445821b85174dd35baccbe029635bc4b535d4c2fb27e8faef334a78e47a106",
      "rkaf:selectorKind": [
        "oa:TextQuoteSelector",
        "oa:TextPositionSelector"
      ],
      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "(2) Any unloaded firearm(s) unless—\n\n(i) The passenger declares to the aircraft operator, either orally or in writing, before checking the baggage, that the passenger has a firearm in his or her bag and that it is unloaded;\n\n(ii) The firearm is unloaded;\n\n(iii) The firearm is carried in a hard-sided container; and\n\n(iv) The container in which it is carried is locked, and only the passenger retains the key or combination."
        },
        {
          "@type": "oa:TextPositionSelector",
          "oa:start": 1586,
          "oa:end": 2010,
          "rkaf:coordinateSystem": "rkaf:unicode-codepoint"
        }
      ]
    },

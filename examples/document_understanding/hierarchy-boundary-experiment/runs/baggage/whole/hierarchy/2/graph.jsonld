    {
      "@id": "urn:rulespec:document-understanding:assertion:dd7f5139fb58f9124cc774d977dc72b249cb6b1b97c6eff2bca2d6d094ff98e7",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:2076554fa43e11fa6a1ac5da629ecd8473e290831bfba270c0148259752294d0",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:c51cb1d7e669d3d73aea571a2b2849869af137c6ffe1dc4550a59c73443a94cc",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:d80530a2a8de916fb15c010b27ba0f0e31a0b66606e8036c06da7aa107d6b578",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:choice_text",
      "rkaf:assertsValue": {
        "@value": "An unloaded firearm may not be transported or offered for transport unless all of the following hold: (i) the passenger declares to the aircraft operator, either orally or in writing, before checking the baggage, that the passenger has a firearm in his or her bag and that it is unloaded; (ii) the firearm is unloaded; (iii) the firearm is carried in a hard-sided container; and (iv) the container in which it is carried is locked, and only the passenger retains the key or combination.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

    {
      "@id": "urn:rulespec:document-understanding:assertion:22de5eef650e5950ac21c26202ab8c53b156e5980b8276d35c7fb35fd0dad5cc",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:2076554fa43e11fa6a1ac5da629ecd8473e290831bfba270c0148259752294d0",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:c51cb1d7e669d3d73aea571a2b2849869af137c6ffe1dc4550a59c73443a94cc",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:1658ec4e0ca6c48114c894e20b9f2d9cf437ae7e1f735e1add6069ac4dc04db0",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[\"(1) When performance has begun of the inspection of the individual's person or accessible property before entering a sterile area, or before boarding an aircraft for which screening is conducted under this subchapter;\",\"(2) When the individual is entering or in a sterile area; or\",\"(3) When the individual is attempting to board or onboard an aircraft for which screening is conducted under §§ 1544.201, 1546.201, or 1562.23 of this chapter.\"],\"choice_text\":\"The prohibition applies: (1) when performance has begun of the inspection of the individual's person or accessible property before entering a sterile area, or before boarding an aircraft for which screening is conducted under this subchapter; (2) when the individual is entering or in a sterile area; or (3) when the individual is attempting to board or onboard an aircraft for which screening is conducted under §§ 1544.201, 1546.201, or 1562.23 of this chapter.\",\"claimants\":[],\"concepts\":[],\"effective_periods\":[],\"jurisdiction\":\"\",\"kind\":\"prohibition\",\"logic_text\":\"(a) On an individual's person or accessible property—prohibitions. Except as provided in paragraph (b) of this section, an individual may not have a weapon, explosive, or incendiary, on or about the individual's person or accessible property—\\n\\n(1) When performance has begun of the inspection of the individual's person or accessible property before entering a sterile area, or before boarding an aircraft for which screening is conducted under this subchapter;\\n\\n(2) When the individual is entering or in a sterile area; or\\n\\n(3) When the individual is attempting to board or onboard an aircraft for which screening is conducted under §§ 1544.201, 1546.201, or 1562.23 of this chapter.\",\"modality\":\"must_not\",\"object\":\"\",\"scope_text\":\"Except as provided in paragraph (b) of 49 CFR 1540.111.\",\"summary\":\"Except as provided in paragraph (b) of 49 CFR 1540.111, an individual may not have a weapon, explosive, or incendiary, on or about the individual's person or accessible property: (1) when performance has begun of the inspection of the individual's person or accessible property before entering a sterile area, or before boarding an aircraft for which screening is conducted under this subchapter; (2) when the individual is entering or in a sterile area; or (3) when the individual is attempting to board or onboard an aircraft for which screening is conducted under §§ 1544.201, 1546.201, or 1562.23 of this chapter.\",\"typed_values\":[]}",
        "@type": "xsd:string"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed",
      "rkaf:hasApplicability": "urn:rulespec:document-understanding:scope:c02311c3e81847c0430df87d6eb3bb7c523267df148aec8dee188b6f5b877f26"
    },

    {
      "@id": "urn:rulespec:document-understanding:assertion:439d82ec565e436b8a7425d99b6fc3700f92ec0fc99b81785391a1a10b5cd1f3",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:2076554fa43e11fa6a1ac5da629ecd8473e290831bfba270c0148259752294d0",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:c51cb1d7e669d3d73aea571a2b2849869af137c6ffe1dc4550a59c73443a94cc",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:d80530a2a8de916fb15c010b27ba0f0e31a0b66606e8036c06da7aa107d6b578",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[\"(i) The passenger declares to the aircraft operator, either orally or in writing, before checking the baggage, that the passenger has a firearm in his or her bag and that it is unloaded;\",\"(ii) The firearm is unloaded;\",\"(iii) The firearm is carried in a hard-sided container; and\",\"(iv) The container in which it is carried is locked, and only the passenger retains the key or combination.\"],\"choice_text\":\"An unloaded firearm may not be transported or offered for transport unless all of the following hold: (i) the passenger declares to the aircraft operator, either orally or in writing, before checking the baggage, that the passenger has a firearm in his or her bag and that it is unloaded; (ii) the firearm is unloaded; (iii) the firearm is carried in a hard-sided container; and (iv) the container in which it is carried is locked, and only the passenger retains the key or combination.\",\"claimants\":[],\"concepts\":[],\"effective_periods\":[],\"jurisdiction\":\"\",\"kind\":\"prohibition\",\"logic_text\":\"(2) Any unloaded firearm(s) unless—\\n\\n(i) The passenger declares to the aircraft operator, either orally or in writing, before checking the baggage, that the passenger has a firearm in his or her bag and that it is unloaded;\\n\\n(ii) The firearm is unloaded;\\n\\n(iii) The firearm is carried in a hard-sided container; and\\n\\n(iv) The container in which it is carried is locked, and only the passenger retains the key or combination.\",\"modality\":\"must_not\",\"object\":\"\",\"scope_text\":\"For a passenger transporting or offering for transport in checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter.\",\"summary\":\"A passenger may not transport or offer for transport in checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter any unloaded firearm(s) unless: (1) the passenger declares to the aircraft operator, either orally or in writing, before checking the baggage, that the passenger has a firearm in his or her bag and that it is unloaded; (2) the firearm is unloaded; (3) the firearm is carried in a hard-sided container; and (4) the container in which it is carried is locked, and only the passenger retains the key or combination.\",\"typed_values\":[]}",
        "@type": "xsd:string"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed",
      "rkaf:hasApplicability": "urn:rulespec:document-understanding:scope:7553c4cac7ddd8d2f04c2d4e2586a78bdf82984b2d21842f045dc4478a2c6d3e"
    },

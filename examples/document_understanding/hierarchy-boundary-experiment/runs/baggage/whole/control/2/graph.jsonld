      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:5dfb4c2ae40f23870d88f910342784e5f0c4299bc0b757ba4be177ea6badfdba",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:ed89221e251c5e26a9c2a3c2c1fa4f5e93510c53fc11a3882cb79e33e4645983",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:ff9b873588c3e31b08a5d5811fea3a4bf586c90fc21b60193f2d0f3bb708f5a5",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[\"(1) Law enforcement personnel required to carry a firearm or other weapons while in the performance of law enforcement duty at the airport.\",\"(2) An individual authorized to carry a weapon in accordance with §§ 1544.219, 1544.221, 1544.223, 1546.211, or subpart B of part 1562 of this chapter.\",\"(3) An individual authorized to carry a weapon in a sterile area under a security program.\"],\"choice_text\":\"Any one of the following: (1) law enforcement personnel required to carry a firearm or other weapons while in the performance of law enforcement duty at the airport; (2) an individual authorized to carry a weapon in accordance with 49 CFR 1544.219, 1544.221, 1544.223, 1546.211, or subpart B of part 1562; or (3) an individual authorized to carry a weapon in a sterile area under a security program.\",\"claimants\":[],\"concepts\":[],\"effective_periods\":[],\"jurisdiction\":\"\",\"kind\":\"exemption\",\"logic_text\":\"(b) On an individual's person or accessible property—permitted carriage of a weapon. Paragraph (a) of this section does not apply as to carriage of firearms and other weapons if the individual is one of the following:\",\"modality\":\"not_required\",\"object\":\"\",\"scope_text\":\"With respect to the carriage of firearms and other weapons on an individual's person or accessible property, where the individual is law enforcement personnel required to carry a firearm or other weapons while in the performance of law enforcement duty at the airport; an individual authorized to carry a weapon in accordance with 49 CFR 1544.219, 1544.221, 1544.223, 1546.211, or subpart B of part 1562; or an individual authorized to carry a weapon in a sterile area under a security program.\",\"summary\":\"Paragraph (a) of 49 CFR 1540.111 does not apply to the carriage of firearms and other weapons on an individual's person or accessible property if the individual is law enforcement personnel required to carry a firearm or other weapons while performing law enforcement duty at the airport, an individual authorized to carry a weapon under 49 CFR 1544.219, 1544.221, 1544.223, 1546.211, or subpart B of part 1562, or an individual authorized to carry a weapon in a sterile area under a security program.\",\"typed_values\":[]}",
        "@type": "xsd:string"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed",
      "rkaf:hasApplicability": "urn:rulespec:document-understanding:scope:e2f63babc3df58f6531df5398095868432225482065e98992516e09210b7734c"
    },

    {
      "@id": "urn:rulespec:document-understanding:revision:688e36ca8e42a8773993e7612f07cbb20dec929ae19b8375f8f33edea526b2fe",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:688e36ca8e42a8773993e7612f07cbb20dec929ae19b8375f8f33edea526b2fe",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:93b18ec4ba5fc730c2afb70c8ef4eda704600de7566fc1eae41c0ba7cdc9b25f",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:0b3cef999b6dd01281c75ff1ed5d28007787193621c83738cd4e63b80dac0cc5\",\"urn:rulespec:document-understanding:assertion:cce6f633125a06175ef6c80f468d7a966e53935459d3dddfcc708fe12d3d8c3f\",\"urn:rulespec:document-understanding:assertion:bcfe950aeef9ca803f7e65b8085c4c54a02d2df3735f1ac98fce4eaa0dab4f22\",\"urn:rulespec:document-understanding:assertion:c7ae476812433dd5da0075671ee7669ef604a046587421f76d01100e814959bc\",\"urn:rulespec:document-understanding:assertion:51b93a81a6131e7372212aec72661e3258dfb563f1bc0df6ea52b04a82151afd\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"effective_periods\":[],\"end\":2057,\"evidence\":[{\"end\":2057,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aab45ff8a7d213a548ba64b9bd9efdd9202dcd2f94cc0c1045a1b5fb69fe86460:1376:2057:sha256-1d38e854b9db34bf76172106880d92595fbe517d8e35ee9635dad4bf20a0f477\",\"quote\":\"(c) In checked baggage. A passenger may not transport or offer for transport in checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter:\\n\\n(1) Any loaded firearm(s).\\n\\n(2) Any unloaded firearm(s) unless—\\n\\n(i) The passenger declares to the aircraft operator, either orally or in writing, before checking the baggage, that the passenger has a firearm in his or her bag and that it is unloaded;\\n\\n(ii) The firearm is unloaded;\\n\\n(iii) The firearm is carried in a hard-sided container; and\\n\\n(iv) The container in which it is carried is locked, and only the passenger retains the key or combination.\\n\\n(3) Any unauthorized explosive or incendiary.\",\"start\":1376},{\"end\":1556,\"field\":\"logic_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aab45ff8a7d213a548ba64b9bd9efdd9202dcd2f94cc0c1045a1b5fb69fe86460:1376:1556:sha256-9dd5c9d0feb251838bff5c1a16b3c099ef083ecc7b0fca10625f4c8d5699fdf1\",\"quote\":\"(c) In checked baggage. A passenger may not transport or offer for transport in checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter:\",\"start\":1376},{\"end\":1419,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aab45ff8a7d213a548ba64b9bd9efdd9202dcd2f94cc0c1045a1b5fb69fe86460:1412:1419:sha256-0007a8bea4dcd3f6b1490fc7199650f1046713dd92d9314e1f2ede6946fcd999\",\"quote\":\"may not\",\"start\":1412},{\"end\":1556,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aab45ff8a7d213a548ba64b9bd9efdd9202dcd2f94cc0c1045a1b5fb69fe86460:1376:1556:sha256-9dd5c9d0feb251838bff5c1a16b3c099ef083ecc7b0fca10625f4c8d5699fdf1\",\"quote\":\"(c) In checked baggage. A passenger may not transport or offer for transport in checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter:\",\"start\":1376}],\"id\":\"urn:rulespec:document-understanding:revision:688e36ca8e42a8773993e7612f07cbb20dec929ae19b8375f8f33edea526b2fe\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"prohibition\",\"logic_text\":\"(c) In checked baggage. A passenger may not transport or offer for transport in checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter:\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:51b93a81a6131e7372212aec72661e3258dfb563f1bc0df6ea52b04a82151afd\",\"modality\":\"must_not\",\"modality_quote\":\"may not\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:c260dcbe121e3442c39fde0949ebc9c16b9ba198bd79b71f596c1228afd2127c\",\"origin\":\"aiSuggested\",\"quote\":\"(c) In checked baggage. A passenger may not transport or offer for transport in checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter:\\n\\n(1) Any loaded firearm(s).\\n\\n(2) Any unloaded firearm(s) unless—\\n\\n(i) The passenger declares to the aircraft operator, either orally or in writing, before checking the baggage, that the passenger has a firearm in his or her bag and that it is unloaded;\\n\\n(ii) The firearm is unloaded;\\n\\n(iii) The firearm is carried in a hard-sided container; and\\n\\n(iv) The container in which it is carried is locked, and only the passenger retains the key or combination.\\n\\n(3) Any unauthorized explosive or incendiary.\",\"references\":[\"§ 1562.23\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:1beda0127190d68b9768d52555826b287cf736a9dca10dc6bafbdcddd013dc3d\",\"scope_quotes\":[\"(c) In checked baggage. A passenger may not transport or offer for transport in checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter:\"],\"scope_text\":\"For baggage transported or offered for transport by a passenger in checked baggage or in baggage carried in an inaccessible cargo hold under 49 CFR 1562.23.\",\"section_id\":\"section-1\",\"start\":1376,\"summary\":\"A passenger may not transport or offer for transport in checked baggage or in baggage carried in an inaccessible cargo hold under 49 CFR 1562.23 any unauthorized explosive or incendiary.\",\"target_ids\":[],\"typed_values\":[]}",
      "dcterms:references": [

    {
      "@id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aab45ff8a7d213a548ba64b9bd9efdd9202dcd2f94cc0c1045a1b5fb69fe86460:1376:2057:sha256-1d38e854b9db34bf76172106880d92595fbe517d8e35ee9635dad4bf20a0f477",
      "@type": "rkaf:SourceFragment",
      "oa:hasSource": "urn:rulespec:document-understanding:document:ab45ff8a7d213a548ba64b9bd9efdd9202dcd2f94cc0c1045a1b5fb69fe86460",
      "rkaf:fragmentIdentityScheme": "rkaf:carrier-local-fragment",
      "rkaf:sourceArtifactDigest": "sha256:ab45ff8a7d213a548ba64b9bd9efdd9202dcd2f94cc0c1045a1b5fb69fe86460",
      "rkaf:fragmentContentDigest": "sha256:1d38e854b9db34bf76172106880d92595fbe517d8e35ee9635dad4bf20a0f477",
      "rkaf:selectorKind": [
        "oa:TextQuoteSelector",
        "oa:TextPositionSelector"
      ],
      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "(c) In checked baggage. A passenger may not transport or offer for transport in checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter:\n\n(1) Any loaded firearm(s).\n\n(2) Any unloaded firearm(s) unless—\n\n(i) The passenger declares to the aircraft operator, either orally or in writing, before checking the baggage, that the passenger has a firearm in his or her bag and that it is unloaded;\n\n(ii) The firearm is unloaded;\n\n(iii) The firearm is carried in a hard-sided container; and\n\n(iv) The container in which it is carried is locked, and only the passenger retains the key or combination.\n\n(3) Any unauthorized explosive or incendiary."
        },
        {
          "@type": "oa:TextPositionSelector",
          "oa:start": 1376,
          "oa:end": 2057,
          "rkaf:coordinateSystem": "rkaf:unicode-codepoint"
        }

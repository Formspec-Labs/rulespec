    {
      "@id": "urn:rulespec:document-understanding:scope:a755eb7027153a3ec7c536cc20143d8d015851a0356b554ada4b59542f65ad8e",
      "@type": "rkaf:ApplicabilityScope",
      "rkaf:appliesInJurisdiction": [],
      "rkaf:applicabilityCondition": "Except as provided in 49 CFR 1540.111(b), when performance has begun of the inspection of an individual's person or accessible property before entering a sterile area, or before boarding an aircraft for which screening is conducted under this subchapter; when the individual is entering or in a sterile area; or when the individual is attempting to board or onboard an aircraft for which screening is conducted under 49 CFR 1544.201, 1546.201, or 1562.23."
    },
    {
      "@id": "urn:rulespec:document-understanding:assertion:ca5a346f38f4204ced3c780c0c32dd36601d10871fd4ed586f8e309124af7870",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:5dfb4c2ae40f23870d88f910342784e5f0c4299bc0b757ba4be177ea6badfdba",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:ed89221e251c5e26a9c2a3c2c1fa4f5e93510c53fc11a3882cb79e33e4645983",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:a57c4fd40ccd21a4e65af40da24e0782b8c51eb5da76d37baa2d43642bf63c41",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:states-prohibition",
      "rkaf:assertsValue": {
        "@value": "Except as provided in paragraph (b) of 49 CFR 1540.111, an individual may not have a weapon, explosive, or incendiary on or about the individual's person or accessible property when inspection has begun before entering a sterile area or before boarding an aircraft screened under this subchapter, when entering or in a sterile area, or when attempting to board or onboard an aircraft screened under 49 CFR 1544.201, 1546.201, or 1562.23.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

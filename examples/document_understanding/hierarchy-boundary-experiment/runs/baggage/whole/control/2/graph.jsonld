      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:5dfb4c2ae40f23870d88f910342784e5f0c4299bc0b757ba4be177ea6badfdba",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:ed89221e251c5e26a9c2a3c2c1fa4f5e93510c53fc11a3882cb79e33e4645983",

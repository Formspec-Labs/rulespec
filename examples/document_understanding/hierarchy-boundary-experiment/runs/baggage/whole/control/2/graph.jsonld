      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:5dfb4c2ae40f23870d88f910342784e5f0c4299bc0b757ba4be177ea6badfdba",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:ed89221e251c5e26a9c2a3c2c1fa4f5e93510c53fc11a3882cb79e33e4645983",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:fc0cba7da96a9b690ff01c5295a06261b767240d7c1846def206ce5b26a82613",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:logic_text",
      "rkaf:assertsValue": {
        "@value": "(2) Any unloaded firearm(s) unless—\n\n(i) The passenger declares to the aircraft operator, either orally or in writing, before checking the baggage, that the passenger has a firearm in his or her bag and that it is unloaded;\n\n(ii) The firearm is unloaded;\n\n(iii) The firearm is carried in a hard-sided container; and\n\n(iv) The container in which it is carried is locked, and only the passenger retains the key or combination.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

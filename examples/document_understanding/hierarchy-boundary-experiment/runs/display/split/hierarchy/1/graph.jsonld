        "@value": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"choice_text\":\"Weekends and holidays count toward the 30 calendar days.\",\"claimants\":[],\"concepts\":[],\"effective_periods\":[],\"jurisdiction\":\"\",\"kind\":\"requirement\",\"logic_text\":\"(d) The organizer must retain each inspection record for at least 30 calendar days after the display closes. Weekends and holidays count toward the 30 days. If an investigation is open when that period ends, the organizer must retain the record until the agency closes the investigation.\",\"modality\":\"must\",\"object\":\"\",\"scope_text\":\"After the display closes.\",\"summary\":\"The organizer must retain each inspection record for at least 30 calendar days after the display closes, with weekends and holidays counting toward the 30 days.\",\"typed_values\":[]}",

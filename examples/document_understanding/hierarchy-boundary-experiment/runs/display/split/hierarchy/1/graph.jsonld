      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:210935d8f833037840d514043df369b46de8f150eba3660ee5b9d277f3890b25\",\"urn:rulespec:document-understanding:assertion:ab3b99c04d8747b73b5a6b0140058ea41ca889e27e3d291b6d670b322606c977\",\"urn:rulespec:document-understanding:assertion:cadd2feea608d7cb1cec72ba81383ae104a77b3109f9a1735337fd953d0f1eef\",\"urn:rulespec:document-understanding:assertion:6df8a0966b8cce9333a06d0e946fe03692ef3749ff2a2002ca9bedf4b3f3850f\",\"urn:rulespec:document-understanding:assertion:edf191e6404fa9b4fcb09463caad09d3c40143215e936eb53f71cfc7ad0745f0\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"effective_periods\":[],\"end\":754,\"evidence\":[{\"end\":754,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Acd1d2d681c56417058e5883c90b99d7d8c562af40621c5b8e3d3b614540154d5:519:754:sha256-dbea7b17f13efc5648bf55eebcb9aff4b968bd00d90301ecde3f87fb84c14234\",\"quote\":\"(3) The organizer must appoint an adult steward who remains on site throughout the time the display remains open. This appointment duty does not apply when an agency employee is assigned to supervise the display for that entire period.\",\"start\":519},{\"end\":754,\"field\":\"logic_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Acd1d2d681c56417058e5883c90b99d7d8c562af40621c5b8e3d3b614540154d5:519:754:sha256-dbea7b17f13efc5648bf55eebcb9aff4b968bd00d90301ecde3f87fb84c14234\",\"quote\":\"(3) The organizer must appoint an adult steward who remains on site throughout the time the display remains open. This appointment duty does not apply when an agency employee is assigned to supervise the display for that entire period.\",\"start\":519},{\"end\":669,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Acd1d2d681c56417058e5883c90b99d7d8c562af40621c5b8e3d3b614540154d5:655:669:sha256-533232681eac9dd2c357af3b24908d4c4e8d41562c911ad7ed51eb0f4638ccd0\",\"quote\":\"does not apply\",\"start\":655},{\"end\":230,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Acd1d2d681c56417058e5883c90b99d7d8c562af40621c5b8e3d3b614540154d5:91:230:sha256-b6abd80d117b4b566300972de823d7857c2472c21cbd8866fece15a96eef055f\",\"quote\":\"(a) For a temporary display open to the public after sunset on agency premises, the organizer must satisfy all of the following conditions:\",\"start\":91}],\"id\":\"urn:rulespec:document-understanding:revision:ebb15c5696e89bc6c5076b73035c7727d33db08eff60668c7b06abaf4e0600b0\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"exemption\",\"logic_text\":\"(3) The organizer must appoint an adult steward who remains on site throughout the time the display remains open. This appointment duty does not apply when an agency employee is assigned to supervise the display for that entire period.\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:edf191e6404fa9b4fcb09463caad09d3c40143215e936eb53f71cfc7ad0745f0\",\"modality\":\"not_required\",\"modality_quote\":\"does not apply\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:2a5af96160e37c7664a9be2d0292e0a27f0ff245c5bea3f4274c8cd8198d13e4\",\"origin\":\"aiSuggested\",\"quote\":\"(3) The organizer must appoint an adult steward who remains on site throughout the time the display remains open. This appointment duty does not apply when an agency employee is assigned to supervise the display for that entire period.\",\"references\":[\"(a)\",\"(3)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:b885020edc62fd246cec8bd8dcf218c72a1e3ae4998ea020a4d90539136774df\",\"scope_quotes\":[\"(a) For a temporary display open to the public after sunset on agency premises, the organizer must satisfy all of the following conditions:\"],\"scope_text\":\"For a temporary display open to the public after sunset on agency premises, when an agency employee is assigned to supervise the display for that entire period.\",\"section_id\":\"section-1\",\"start\":519,\"summary\":\"The duty to appoint an adult steward does not apply when an agency employee is assigned to supervise the display for that entire period.\",\"target_ids\":[],\"typed_values\":[]}",

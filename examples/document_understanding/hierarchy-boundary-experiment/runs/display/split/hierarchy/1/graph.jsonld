      "rkaf:assertsValue": {
        "@value": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"effective_periods\":[],\"jurisdiction\":\"\",\"kind\":\"requirement\",\"logic_text\":\"(d) The organizer must retain each inspection record for at least 30 calendar days after the display closes. Weekends and holidays count toward the 30 days. If an investigation is open when that period ends, the organizer must retain the record until the agency closes the investigation.\",\"modality\":\"must\",\"object\":\"\",\"scope_text\":\"After the display closes, if an investigation is open when the 30-calendar-day retention period ends.\",\"summary\":\"If an investigation is open when the 30-calendar-day retention period ends after the display closes, the organizer must retain the inspection record until the agency closes the investigation.\",\"typed_values\":[]}",

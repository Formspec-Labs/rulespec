      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:8e35ae31c76a7c62b613cbbb5b5179b257b3bca0f3ff77f857da0aad5267afc0\",\"urn:rulespec:document-understanding:assertion:e6d41c11d575b5a7060c259e16ac111e7bff1dadc463489d5d37c16e50dd2e35\",\"urn:rulespec:document-understanding:assertion:3be1b308aaf0e4fd75acdc5eadefc32f8e5e813300b9cd0914e2eb409b239f08\",\"urn:rulespec:document-understanding:assertion:c90c320e3f71195aa7d29a285c8374ddfb2d72e2e5492b6a1de6fdc611c01e0b\",\"urn:rulespec:document-understanding:assertion:772be805b73f1ba5b2a33f2861294a1daa67b1032f4d4429c6c5a7b20af5dd18\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"effective_periods\":[],\"end\":754,\"evidence\":[{\"end\":754,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Acd1d2d681c56417058e5883c90b99d7d8c562af40621c5b8e3d3b614540154d5:519:754:sha256-dbea7b17f13efc5648bf55eebcb9aff4b968bd00d90301ecde3f87fb84c14234\",\"quote\":\"(3) The organizer must appoint an adult steward who remains on site throughout the time the display remains open. This appointment duty does not apply when an agency employee is assigned to supervise the display for that entire period.\",\"start\":519},{\"end\":754,\"field\":\"logic_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Acd1d2d681c56417058e5883c90b99d7d8c562af40621c5b8e3d3b614540154d5:519:754:sha256-dbea7b17f13efc5648bf55eebcb9aff4b968bd00d90301ecde3f87fb84c14234\",\"quote\":\"(3) The organizer must appoint an adult steward who remains on site throughout the time the display remains open. This appointment duty does not apply when an agency employee is assigned to supervise the display for that entire period.\",\"start\":519},{\"end\":669,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Acd1d2d681c56417058e5883c90b99d7d8c562af40621c5b8e3d3b614540154d5:655:669:sha256-533232681eac9dd2c357af3b24908d4c4e8d41562c911ad7ed51eb0f4638ccd0\",\"quote\":\"does not apply\",\"start\":655},{\"end\":230,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Acd1d2d681c56417058e5883c90b99d7d8c562af40621c5b8e3d3b614540154d5:91:230:sha256-b6abd80d117b4b566300972de823d7857c2472c21cbd8866fece15a96eef055f\",\"quote\":\"(a) For a temporary display open to the public after sunset on agency premises, the organizer must satisfy all of the following conditions:\",\"start\":91},{\"end\":754,\"field\":\"scope_text:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Acd1d2d681c56417058e5883c90b99d7d8c562af40621c5b8e3d3b614540154d5:519:754:sha256-dbea7b17f13efc5648bf55eebcb9aff4b968bd00d90301ecde3f87fb84c14234\",\"quote\":\"(3) The organizer must appoint an adult steward who remains on site throughout the time the display remains open. This appointment duty does not apply when an agency employee is assigned to supervise the display for that entire period.\",\"start\":519}],\"id\":\"urn:rulespec:document-understanding:revision:6104ef3d4c1fd2ed0a79b01793efcb636f378f3fce48d36c85e13bc90dfa7ea1\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"exemption\",\"logic_text\":\"(3) The organizer must appoint an adult steward who remains on site throughout the time the display remains open. This appointment duty does not apply when an agency employee is assigned to supervise the display for that entire period.\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:772be805b73f1ba5b2a33f2861294a1daa67b1032f4d4429c6c5a7b20af5dd18\",\"modality\":\"not_required\",\"modality_quote\":\"does not apply\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:fee42b586d82e05e91ce04a520eea5a618939a0ac7f7a249364a915d01b93c3b\",\"origin\":\"aiSuggested\",\"quote\":\"(3) The organizer must appoint an adult steward who remains on site throughout the time the display remains open. This appointment duty does not apply when an agency employee is assigned to supervise the display for that entire period.\",\"references\":[\"(a)(3)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:2a02c2b9f560291d5d28568c51cd488b557219668a7f12381bd6fb59ebbe1ad1\",\"scope_quotes\":[\"(a) For a temporary display open to the public after sunset on agency premises, the organizer must satisfy all of the following conditions:\",\"(3) The organizer must appoint an adult steward who remains on site throughout the time the display remains open. This appointment duty does not apply when an agency employee is assigned to supervise the display for that entire period.\"],\"scope_text\":\"For a temporary display open to the public after sunset on agency premises, when an agency employee is assigned to supervise the display for that entire period\",\"section_id\":\"section-1\",\"start\":519,\"summary\":\"For a temporary display open to the public after sunset on agency premises, the duty to appoint an adult steward who remains on site does not apply when an agency employee is assigned to supervise the display for that entire period.\",\"target_ids\":[],\"typed_values\":[]}",

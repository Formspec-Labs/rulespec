      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:d166d365684e98f93d420d13e788589135d6ba70a9fd5cdb2de57cb36489a136",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:9fab47b6386d1fe94c4eaf60350501b0e5e022eef61dcee8b44cb2aa5ac1eea9",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:9e22053c353c65943f53d5be5ab9a9cf088eb9a5cae597ebb47b4f8478a2f4ea",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:logic_text",
      "rkaf:assertsValue": {
        "@value": "(b) When a storm warning is active, the organizer must suspend outdoor demonstrations unless all of the following conditions are met:\n\n(1) The demonstration takes place beneath a fixed roof.\n\n(2) The agency has measured wind speed below 20 kilometers per hour at the demonstration site within the preceding 10 minutes.\n\n(3) An agency officer authorizes the demonstration for the duration of the current warning. The authorization expires when that warning ends; it does not authorize demonstrations under a later warning.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

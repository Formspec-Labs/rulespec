        "@value": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"effective_periods\":[],\"jurisdiction\":\"\",\"kind\":\"statement\",\"logic_text\":\"(3) An agency officer authorizes the demonstration for the duration of the current warning. The authorization expires when that warning ends; it does not authorize demonstrations under a later warning.\",\"modality\":\"not_stated\",\"object\":\"\",\"scope_text\":\"For demonstration authorizations issued by an agency officer during an active storm warning\",\"summary\":\"The demonstration authorization expires when that storm warning ends and does not authorize demonstrations under a later warning.\",\"typed_values\":[]}",

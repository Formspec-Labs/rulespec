      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[\"(1) The demonstration takes place beneath a fixed roof.\",\"(2) The agency has measured wind speed below 20 kilometers per hour at the demonstration site within the preceding 10 minutes.\",\"(3) An agency officer authorizes the demonstration for the duration of the current warning. The authorization expires when that warning ends; it does not authorize demonstrations under a later warning.\"],\"choice_text\":\"all of the following conditions are met: (1) fixed roof, (2) wind speed below 20 km/h within preceding 10 minutes, and (3) agency officer authorization for duration of warning\",\"claimants\":[],\"concepts\":[],\"effective_periods\":[],\"jurisdiction\":\"\",\"kind\":\"requirement\",\"logic_text\":\"(b) When a storm warning is active, the organizer must suspend outdoor demonstrations unless all of the following conditions are met:\",\"modality\":\"must\",\"object\":\"\",\"scope_text\":\"When a storm warning is active, unless all of the following conditions are met: (1) the demonstration takes place beneath a fixed roof; (2) the agency has measured wind speed below 20 kilometers per hour at the demonstration site within the preceding 10 minutes; and (3) an agency officer authorizes the demonstration for the duration of the current warning\",\"summary\":\"When a storm warning is active, the organizer must suspend outdoor demonstrations unless all of the following conditions are met: the demonstration takes place beneath a fixed roof; the agency has measured wind speed below 20 kilometers per hour at the demonstration site within the preceding 10 minutes; and an agency officer authorizes the demonstration for the duration of the current warning.\",\"typed_values\":[]}",
        "@type": "xsd:string"
      },

          "passage_ids": [
            "urn:rulespec:document-understanding:passage:ed92d96f78d76c3adac998a2418e428bd8438306ed3613b0978f0d4e2624b8e1",
            "urn:rulespec:document-understanding:passage:90d4975048c69fb899b181671f7a85cd7b0d8b4f236ddc3ed84f39d01a44927c",
            "urn:rulespec:document-understanding:passage:9a45ebfca3d9a23b72f87d87a2faa63ed96a37d1a1e27da9b98bde8d24e42f26",
            "urn:rulespec:document-understanding:passage:2681cc2eaa3cbc3c0b3f6be6ee60e8da1cc5e764ab7f465ca7ccab2476edc6ce",
            "urn:rulespec:document-understanding:passage:e3743ca26297a472464680c2de481c14c44c174696ea8c5c94820beb972fc903",
            "urn:rulespec:document-understanding:passage:fced1788afbe1df692b439d1c8902e1279208ed49cc90ba3765edb6e773a56c0",
            "urn:rulespec:document-understanding:passage:46db7497de5fe741393bb33beeb50d5a8b016412f8b8f829e6c0a8e50295dd7e",
            "urn:rulespec:document-understanding:passage:7952a1fbf8dedd785600fca759fa9be63aba0f2cc274a9cde08bdbe1b68c7fb5",
            "urn:rulespec:document-understanding:passage:101ef91ce3a51324c4e020b21edaa260a695799caee5105304e9ab9edb07b56f",
            "urn:rulespec:document-understanding:passage:83177688dc3e8d2ff9089e52032b55dc5198b398e5977fb7bfef92634706493b",
            "urn:rulespec:document-understanding:passage:df21f6e3102e83df27d1da8374190c16c0adae812d5c9108f50bbc90b02fd9cb",
            "urn:rulespec:document-understanding:passage:0faeeeb74d90bb31bcb98f83951e4b39bb2b41fe756487ec6793252cc079a19c",
            "urn:rulespec:document-understanding:passage:0e2a2483af29d2dacdc3c1bf4bd4c65a6a408f40a0bcb18f2393eee7bd384db8"
          ],
          "context_spans": [],

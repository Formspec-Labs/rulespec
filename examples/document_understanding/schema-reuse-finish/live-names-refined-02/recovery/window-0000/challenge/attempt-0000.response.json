            "text": "{\n  \"judgments\": [\n    {\n      \"proposal_id\": \"P0000\",\n      \"quotes\": [\n        \"A material discrepancy is any name change that is not defined as immaterial in 8 FAM 403.1-5.\"\n      ],\n      \"rationale\": \"The proposal fixes a confirmed defect identified during audit where a claimant ('Department') was erroneously attributed using text from a downstream paragraph. Clearing the spurious claimant and clearing the modality quote for an unstated modality accurately reflects the source definition.\",\n      \"verdict\": \"supported\"\n    },\n    {\n      \"proposal_id\": \"P0001\",\n      \"quotes\": [\n        \"Consequently, under 22 CFR 51.23(c), evidence of identity might be required in accordance with Department guidance to establish the name that best identifies the applicant:\"\n      ],\n      \"rationale\": \"The proposal removes 'Department' from the claimants list, resolving an audit error where 'in accordance with Department guidance' was misconstrued as a claimant asserting the statement rather than a governing procedural standard.\",\n      \"verdict\": \"supported\"\n    }\n  ]\n}",

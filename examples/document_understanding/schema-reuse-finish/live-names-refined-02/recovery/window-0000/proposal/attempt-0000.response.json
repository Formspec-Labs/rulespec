            "text": "{\n  \"proposals\": [\n    {\n      \"rationale\": \"Remove spurious claimant attributed from an unrelated downstream paragraph, and clear modality_quote for a not_stated definition.\",\n      \"operation\": \"edit\",\n      \"target\": \"C0000\",\n      \"qualifies\": [],\n      \"quote\": \"A material discrepancy is any name change that is not defined as immaterial in 8 FAM 403.1-5.\",\n      \"fields\": {\n        \"concepts\": [\n          {\n            \"label\": \"Material Discrepancy\",\n            \"definition\": \"Any name change that is not defined as immaterial in 8 FAM 403.1-5.\",\n            \"quote\": \"A material discrepancy is any name change that is not defined as immaterial in 8 FAM 403.1-5.\",\n            \"role\": \"rkaf:assignmentPrimary\"\n          }\n        ],\n        \"claimants\": [],\n        \"typed_values\": [],\n        \"effective_periods\": [],\n        \"kind\": \"definition\",\n        \"scope_quotes\": [],\n        \"scope_text\": \"\",\n        \"context_quotes\": [],\n        \"modality_quote\": \"\",\n        \"modality\": \"not_stated\",\n        \"alternative_quotes\": [],\n        \"choice_quote\": \"\",\n        \"choice_text\": \"\",\n        \"logic_text\": \"\",\n        \"actor_quote\": \"\",\n        \"actor\": \"\",\n        \"action_quote\": \"\",\n        \"action\": \"\",\n        \"object_quote\": \"\",\n        \"object\": \"\",\n        \"jurisdiction_quote\": \"\",\n        \"jurisdiction\": \"\",\n        \"relation\": \"none\",\n        \"references\": [\n          \"8 FAM 403.1-5\"\n        ],\n        \"summary\": \"A material discrepancy is defined as any name change that is not defined as immaterial in 8 FAM 403.1-5.\"\n      }\n    },\n    {\n      \"rationale\": \"Remove claimant 'Department' because 'in accordance with Department guidance' describes the governing standard rather than an attributed asserter.\",\n      \"operation\": \"edit\",\n      \"target\": \"C0005\",\n      \"qualifies\": [],\n      \"quote\": \"Consequently, under 22 CFR 51.23(c), evidence of identity might be required in accordance with Department guidance to establish the name that best identifies the applicant:\",\n      \"fields\": {\n        \"concepts\": [\n          {\n            \"label\": \"Identity Evidence Requirement Possibility\",\n            \"definition\": \"Possibility that evidence of identity is required per Department guidance to establish the name best identifying the applicant.\",\n            \"quote\": \"evidence of identity might be required in accordance with Department guidance to establish the name that best identifies the applicant\",\n            \"role\": \"rkaf:assignmentPrimary\"\n          }\n        ],\n        \"claimants\": [],\n        \"typed_values\": [],\n        \"effective_periods\": [],\n        \"kind\": \"statement\",\n        \"scope_quotes\": [\n          \"The applicant's name is an integral part of her/his identity.\"\n        ],\n        \"scope_text\": \"Under 22 CFR 51.23(c), given that the applicant's name is an integral part of her/his identity.\",\n        \"context_quotes\": [\n          \"The applicant's name is an integral part of her/his identity.\"\n        ],\n        \"modality_quote\": \"might\",\n        \"modality\": \"possible\",\n        \"alternative_quotes\": [],\n        \"choice_quote\": \"\",\n        \"choice_text\": \"\",\n        \"logic_text\": \"\",\n        \"actor_quote\": \"\",\n        \"actor\": \"\",\n        \"action_quote\": \"be required in accordance with Department guidance to establish the name that best identifies the applicant\",\n        \"action\": \"be required in accordance with Department guidance to establish the name that best identifies the applicant\",\n        \"object_quote\": \"evidence of identity\",\n        \"object\": \"evidence of identity\",\n        \"jurisdiction_quote\": \"\",\n        \"jurisdiction\": \"\",\n        \"relation\": \"none\",\n        \"references\": [\n          \"22 CFR 51.23(c)\"\n        ],\n        \"summary\": \"Under 22 CFR 51.23(c), evidence of identity might be required in accordance with Department guidance to establish the name that best identifies the applicant.\"\n      }\n    }\n  ],\n  \"observations\": [\n    {\n      \"quote\": \"Acceptable means of documenting a material name change include (per 22 CFR 51.25):\\n\\n(1) Court orders or decrees:\\n\\n(a) Name change orders; or\\n\\n(b) Divorce decrees;\\n\\n(2) Certificates of naturalization;\\n\\n(3) Marriage certificates;\\n\\n(4) Documentation demonstrating change of name by operation of state law; or\\n\\n(5) Documentation of customary usage.\",\n      \"rationale\": \"The enumerated list of acceptable documentation types for documenting a material name change corresponds to unit U0003 and is already fully represented in grouped claim C0002.\",\n      \"disposition\": \"already_represented\"\n    },\n    {\n      \"quote\": \"(see an exception for married names in 8 FAM 403.1-4(C))\",\n      \"rationale\": \"The married-names exception cross-reference is already represented in claim C0002's summary, context quotes, and references.\",\n      \"disposition\": \"already_represented\"\n    }\n  ]\n}",

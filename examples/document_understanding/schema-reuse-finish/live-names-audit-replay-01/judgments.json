    {
      "unit_id": "urn:rulespec:audit-unit:fe3158b238d665c3c9c84df9f6a8536b1b45d74bbea33c0803474ec55c352c12",
      "claim_ids": [
        "urn:rulespec:document-understanding:revision:036690ae5e6ca04a41045e67196d8f9a393e15732f00ae43b6bb337b58415b12"
      ],
      "source_spans": [
        {

        "urn:rulespec:audit-unit:5679a1534cc8547e165f685e9ab266fda754baca1a88a012a099210bcdd32cf5",
        "urn:rulespec:audit-unit:89bd56ef33a7c30a66080c4e8c7fd2bb81385655642470c800c1046e1c63f8e5",
        "urn:rulespec:audit-unit:c463a2e50e690bd5e3446526aa1e4cab97b18aa4fa34c8c6961502bc81cdbca2",
        "urn:rulespec:audit-unit:fe3158b238d665c3c9c84df9f6a8536b1b45d74bbea33c0803474ec55c352c12",
        "urn:rulespec:audit-unit:57657c1009240da9043b02d61ffbd2be744d4ef4494fbb6c880d1ea2c6acbc10"
      ],
      "source_spans": [
        {
          "source_id": "urn:rulespec:document-understanding:document:aa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc",
          "quote": "Material discrepancies between the name recorded on the application, the applicant's evidence of U.S. citizenship/non-citizen U.S. nationality, or the evidence of identity must be documented by submission of one or more of the documents listed in this section (see an exception for married names in 8 FAM 403.1-4(C)). Acceptable means of documenting a material name change include (per 22 CFR 51.25):",
          "start": 413,
          "end": 813
        },
        {
          "source_id": "urn:rulespec:document-understanding:document:aa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc",
          "quote": "(1) Court orders or decrees:",
          "start": 815,
          "end": 843
        },
        {
          "source_id": "urn:rulespec:document-understanding:document:aa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc",
          "quote": "(a) Name change orders; or",
          "start": 845,
          "end": 871
        },
        {
          "source_id": "urn:rulespec:document-understanding:document:aa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc",
          "quote": "(b) Divorce decrees;",
          "start": 873,
          "end": 893
        },
        {
          "source_id": "urn:rulespec:document-understanding:document:aa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc",
          "quote": "(2) Certificates of naturalization;",
          "start": 895,
          "end": 930
        },
        {
          "source_id": "urn:rulespec:document-understanding:document:aa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc",
          "quote": "(3) Marriage certificates;",
          "start": 932,
          "end": 958
        },
        {
          "source_id": "urn:rulespec:document-understanding:document:aa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc",
          "quote": "(4) Documentation demonstrating change of name by operation of state law; or",
          "start": 960,
          "end": 1036
        },
        {
          "source_id": "urn:rulespec:document-understanding:document:aa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc",
          "quote": "(5) Documentation of customary usage.",
          "start": 1038,
          "end": 1075
        }
      ],
      "rationale": "C0002 captures the mandatory documentation requirement, the married name exception reference, and all enumerated acceptable document types (court orders/decrees including name change orders and divorce decrees, naturalization certificates, marriage certificates, operation of state law documentation, and customary usage).",
      "claim_sha256": "6147e2a283178733200c82988833cc93e0b08a54394bc109e03e05c67916f01d",
      "dimensions": {
        "summary": "correct",

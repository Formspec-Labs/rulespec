ent:urn%3Arulespec%3Adocument-understanding%3Adocument%3A1a47a76c521a93dcac7e7e6d3fb8e2bcef821725a1aa174ee419d39827b0ff4a:358:365:sha256-67556cd0dda76ca333bc2aa39ae597067177eec967ac4f1143f644f5825feba2\",\"quote\":\"infants\",\"start\":358},{\"end\":353,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A1a47a76c521a93dcac7e7e6d3fb8e2bcef821725a1aa174ee419d39827b0ff4a:343:353:sha256-129b70f8672ecacafe6a4c4f63c584842def71d10e3ca0b9be89543ffd4ff4e6\",\"quote\":\"acceptable\",\"start\":343},{\"end\":102,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A1a47a76c521a93dcac7e7e6d3fb8e2bcef821725a1aa174ee419d39827b0ff4a:0:102:sha256-d5352952c35d27ead43ba84f11e560e73e7604cc8f5e1991855c69f726f1417f\",\"quote\":\"d. Infants pose a particular challenge. The goal is the best likeness that can reasonably be obtained:\",\"start\":0},{\"end\":366,\"field\":\"concepts:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A1a47a76c521a93dcac7e7e6d3fb8e2bcef821725a1aa174ee419d39827b0ff4a:330:366:sha256-522cfa2c7952f1dfe52751024fa4bc93cdb5aa3e43fcadc108abb28d9a80bc35\",\"quote\":\"Head tilt is acceptable for infants;\",\"start\":330}],\"id\":\"urn:rulespec:document-understanding:revision:3db098e75a5bd0b1f6ce0deaf8c8e786ea24e4fd9fb229bdf62edad4bdcbf2b5\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"permission\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:8507b441d73bba1bd5e97922daf45d05fe5bb5c368ad654a9c02822df0323157\",\"modality\":\"may\",\"modality_quote\":\"acceptable\",\"object\":\"infants\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:63a4609a738dae7b8412e9fba0d0f5a027abcd43f799995017577953305feafb\",\"origin\":\"aiSuggested\",\"quote\":\"Head tilt is acceptable for infants;\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn
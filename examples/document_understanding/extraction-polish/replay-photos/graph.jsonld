      "rkaf:assertsValue": {
        "@value": "{\"action\":\"discreetly support\",\"actor\":\"\",\"alternative_quotes\":[\"white\",\"off-white\"],\"choice_text\":\"A white or off-white blanket behind the child.\",\"claimants\":[],\"concepts\":[{\"definition\":\"Permission and methods for discreetly supporting an infant's head in an application photograph.\",\"label\":\"Infant head support\",\"quote\":\"The infant's head may be discreetly supported, e.g., a car seat with a white or off-white blanket behind the child.\",\"role\":\"rkaf:assignmentPrimary\"}],\"effective_periods\":[],\"jurisdiction\":\"\",\"kind\":\"permission\",\"logic_text\":\"white or off-white\",\"modality\":\"may\",\"object\":\"The infant's head\",\"scope_text\":\"In the case of photographs of infants, where the goal is the best likeness that can reasonably be obtained.\",\"summary\":\"In infant photographs, the infant's head may be discreetly supported (for example, using a car seat with a white or off-white blanket behind the child).\",\"typed_values\":[]}",
        "@type": "xsd:string"
      },

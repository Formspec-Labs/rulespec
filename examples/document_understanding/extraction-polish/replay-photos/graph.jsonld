    {
      "@id": "urn:rulespec:document-understanding:concept:7c7b4fa8144b59438bc306048ba9d6d66f936978bf3c929c7b9e38fb4c5d48cc",
      "@type": "rkaf:LocalConcept",
      "skos:prefLabel": {
        "en": "Certificate photograph timing caution"
      },
      "skos:definition": {
        "en": "Advisory caution noting that certificate photographs may not have been taken within six months due to agency processing times, regardless of recent certificate issuance."
      },
      "skos:inScheme": "urn:rulespec:document-understanding:concept-scheme:1a47a76c521a93dcac7e7e6d3fb8e2bcef821725a1aa174ee419d39827b0ff4a",

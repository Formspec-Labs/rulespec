\":208,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A1a47a76c521a93dcac7e7e6d3fb8e2bcef821725a1aa174ee419d39827b0ff4a:108:208:sha256-a97a81db885d6eb9b9f1b797f184ba9670be25dee687c99024a22158dca24573\",\"quote\":\"It is acceptable if the infant's eyes, particularly a newborn's, are partially or completely closed;\",\"start\":108},{\"end\":207,\"field\":\"action\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A1a47a76c521a93dcac7e7e6d3fb8e2bcef821725a1aa174ee419d39827b0ff4a:173:207:sha256-fd0ac58ad648a080a300dfbd972705696de8869134995edf450fadbb1db4375f\",\"quote\":\"are partially or completely closed\",\"start\":173},{\"end\":145,\"field\":\"object\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A1a47a76c521a93dcac7e7e6d3fb8e2bcef821725a1aa174ee419d39827b0ff4a:128:145:sha256-abbbd0c0c02729d40ed6aa1579a651e8f1773079a7d34ab65910e26b359e79f5\",\"quote\":\"the infant's eyes\",\"start\":128},{\"end\":207,\"field\":\"logic_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A1a47a76c521a93dcac7e7e6d3fb8e2bcef821725a1aa174ee419d39827b0ff4a:177:207:sha256-268ecf099f1d32c3e05639ac95af6a411fa7cfb6c36f09399e95e7d790ce5968\",\"quote\":\"partially or completely closed\",\"start\":177},{\"end\":124,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A1a47a76c521a93dcac7e7e6d3fb8e2bcef821725a1aa174ee419d39827b0ff4a:114:124:sha256-129b70f8672ecacafe6a4c4f63c584842def71d10e3ca0b9be89543ffd4ff4e6\",\"quote\":\"acceptable\",\"start\":114},{\"end\":207,\"field\":\"choice_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A1a47a76c521a93dcac7e7e6d3fb8e2bcef821725a1aa174ee419d39827b0ff4a:177:207:sha256-268ecf099f1d32c3e05639ac95af6a411fa7cfb6c36f09399e95e7d790ce5968\",\"quote\":\"partially or completely closed\",\"start\":177},{\"end\":102,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A1a47a76c521a93dcac7e7e6d3fb8e2bcef821725a1aa174ee419d39827b0ff4a:0:102:sha256-d5352952c35d27ead43ba84f11e560e73e7604cc8f5e1991855c69f726f1417f\",\"quote\":\"d. Infants pose a particular challenge. The goal is the best likeness that can reasonably be obtained:\",\"start\":0},{\"end\":186,\"field\":\"alternative:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A1a47a76c521a93dcac7e7e6d3fb8e2bcef821725a1aa174ee419d39827b0ff4a:177:186:sha256-4b56ea8eae2d74b90e3408870706e7c75b2d59db18dd55f45a7433383a74cded\",\"quote\":\"partially\",\"start\":177},{\"end\":207,\"field\":\"alternative:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A1a47a76c521a93dcac7e7e6d3fb8e2bcef821725a1aa174ee419d39827b0ff4a:190:207:sha256-68f7adf3d4d2f3c36def5ee3711feb5a78b7738c41892a95ed2369bf261fffe5\",\"quote\":\"completely closed\",\"start\":190},{\"end\":208,\"field\":\"concepts:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A1a47a76c521a93dcac7e7e6d3fb8e2bcef821725a1aa174ee419d39827b0ff4a:108:208:sha256-a97a81db885d6eb9b9f1b797f184ba9670be25dee687c99024a22158dca24573\",\"quote\":\"It is acceptable if the infant's eyes, particularly a newborn's, are partially or completely closed;\",\"start\":108}],\"id\":\"urn:rulespec:document-understanding:revision:3d474a9978dba1c49f25068c47a28037a8f2f5d9da464be094d1c0215144e5ff\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"permission\",\"logic_text\":\"partially or completely closed\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:6d39f40d9af421da4ddeb7d65cd75b559537c631de7ff5cc55875ef3e29bce83\",\"modality\":\"may\",\"modality_quote\":\"acceptable\",\"object\":\"the infant's eyes\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:0ce615b74238fa17f74cc101aeec6adc0b077210ddb280b3b40a94abf56c3959\",\"origin\":\"aiSuggested\",\"quote\":\"It is acceptable if the infant's eyes, particularly a newborn's, are partially or completely closed;\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:7798bd6e13b1986edbba9ea9fa949ab5acd6f58f1a86e73ee7425f0cef92bb9c\",\"scope_quotes\":[\"d. Infants pose a particular challenge. The goal is the best likeness that can reasonably be obtained:\"],\"scope_text\":\"In the case of photographs of infants, where the goal is the best likeness that can reasonably be obtained.\",\"section_id\":\"section-1\",\"start\":108,\"summary\":\"For infant photographs, it is acceptable if the infant's eyes (particularly a newborn's) are partially or completely closed.\",\"target_ids\":[],\"typed_values\":[]}",

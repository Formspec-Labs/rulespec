      "rkaf:assertsValue": {
        "@value": "{\"action\":\"having eyes partially or completely closed\",\"actor\":\"\",\"alternative_quotes\":[\"partially\",\"completely closed\"],\"choice_text\":\"Eyes may be partially or completely closed.\",\"claimants\":[],\"concepts\":[{\"definition\":\"Acceptability criteria regarding partially or completely closed eyes in photographs of infants.\",\"label\":\"Infant photograph eyes\",\"quote\":\"It is acceptable if the infant's eyes, particularly a newborn's, are partially or completely closed;\",\"role\":\"rkaf:assignmentPrimary\"}],\"effective_periods\":[],\"jurisdiction\":\"\",\"kind\":\"permission\",\"logic_text\":\"partially or completely closed\",\"modality\":\"may\",\"object\":\"the infant's eyes\",\"scope_text\":\"In the case of photographs of infants, where the goal is the best likeness that can reasonably be obtained.\",\"summary\":\"For infant photographs, it is acceptable if the infant's eyes (particularly a newborn's) are partially or completely closed.\",\"typed_values\":[]}",
        "@type": "xsd:string"
      },

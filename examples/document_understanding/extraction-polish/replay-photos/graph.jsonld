      "dcterms:description": "{\"action\":\"discreetly support\",\"actor\":\"\",\"alternative_quotes\":[\"white\",\"off-white\"],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:b4e76469e65137185ccfa698675fc662d705d01e4167b639a8b0527adc0a1cce\",\"urn:rulespec:document-understanding:assertion:ed678a8c018e2b9ced50b3f8ebe6bc4eb3e160d71a4120dd4eaf142d095c899f\",\"urn:rulespec:document-understanding:assertion:f6957a0b20a04245f5bde8aa775e715a7c52e4cb7c70c3995cd74c2a8ece2afc\",\"urn:rulespec:document-understanding:assertion:37c98bc22f63877288b8e2550c2cfe0d81391f40f49a16de06a446caef801000\",\"urn:rulespec:document-understanding:assertion:d0c1238a2b44e7cdd67c612864804efaecf29b0c1456773f6c2323b6b3ebacc2\",\"urn:rulespec:document-understanding:assertion:24fd4375055f1f6a0c615668023628cece38747b117fee493b9b83ba1539775a\",\"urn:rulespec:document-understanding:assertion:8f5aa92b1bf7827da6d207b393022a6f4a33c5627e046d392624844983948f12\",\"urn:rulespec:document-understanding:assertion:0a0356e914b51da09d08374f12ebb84a70b9792db7c34698bbceed93af73cf15\",\"urn:rulespec:document-understanding:assertion:2119aa70ba283fcf27207ed903777db580248ff28924f5d1cc438fd1922887b1\",\"urn:rulespec:document-understanding:assertion:efd7d44ca80d0de411156ea7d0e9e4b605d80833d147317b2e638f2f01e6a26e\",\"urn:rulespec:document-understanding:assertion:714773fa74bfe5424af24e56bb4d690d3914b98483e0981f12813f5b06d0bce8\"],\"choice_quote\":\"white or off-white\",\"choice_text\":\"A white or off-white blanket behind the child.\",\"claimants\":[],\"concepts\":[{\"definition\":\"Permission and methods for discreetly supporting an infant's head in an application photograph.\",\"label\":\"Infant head support\",\"quote\":\"The infant's head may be discreetly supported, e.g., a car seat with a white or off-white blanket behind the child.\",\"role\":\"rkaf:assignmentPrimary\"}],\"context_quotes\":[\"e.g., a car seat with a white or off-white blanket behind the child.\"],\"effective_periods\":[],\"end\":329,\"evidence\":[{\"end\":329,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A1a47a76c521a93dcac7e7e6d3fb8e2bcef821725a1aa174ee419d39827b0ff4a:214:329:sha256-6d4a63ef35a9bb1840f740c457f39367daf28f284a8437323612f715c58c5e84\",\"quote\":\"The infant's head may be discreetly supported, e.g., a car seat with a white or off-white blanket behind the child.\",\"start\":214},{\"end\":259,\"field\":\"action\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A1a47a76c521a93dcac7e7e6d3fb8e2bcef821725a1aa174ee419d39827b0ff4a:236:259:sha256-5f4735f2be75e50514b6f2b2d2f3ee84e340ce834bfbe743ff3ca62c9d4ca86d\",\"quote\":\"be discreetly supported\",\"start\":236},{\"end\":231,\"field\":\"object\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A1a47a76c521a93dcac7e7e6d3fb8e2bcef821725a1aa174ee419d39827b0ff4a:214:231:sha256-7e96be97b7782fdc8f6c86c30ad09790a60a7c7ee8856db1c25ef8980bc646cd\",\"quote\":\"The infant's head\",\"start\":214},{\"end\":303,\"field\":\"logic_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A1a47a76c521a93dcac7e7e6d3fb8e2bcef821725a1aa174ee419d39827b0ff4a:285:303:sha256-bc4d42d81d1520c6e1331271d980a20330a4ec1d8dc51e87116a7a0057135b9d\",\"quote\":\"white or off-white\",\"start\":285},{\"end\":235,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A1a47a76c521a93dcac7e7e6d3fb8e2bcef821725a1aa174ee419d39827b0ff4a:232:235:sha256-ee4d988c65de860fabbfbcd27f73d50bbebe3fba37fe419284f4811389c30bdc\",\"quote\":\"may\",\"start\":232},{\"end\":303,\"field\":\"choice_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A1a47a76c521a93dcac7e7e6d3fb8e2bcef821725a1aa174ee419d39827b0ff4a:285:303:sha256-bc4d42d81d1520c6e1331271d980a20330a4ec1d8dc51e87116a7a0057135b9d\",\"quote\":\"white or off-white\",\"start\":285},{\"end\":102,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A1a47a76c521a93dcac7e7e6d3fb8e2bcef821725a1aa174ee419d39827b0ff4a:0:102:sha256-d5352952c35d27ead43ba84f11e560e73e7604cc8f5e1991855c69f726f1417f\",\"quote\":\"d. Infants pose a particular challenge. The goal is the best likeness that can reasonably be obtained:\",\"start\":0},{\"end\":329,\"field\":\"context:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A1a47a76c521a93dcac7e7e6d3fb8e2bcef821725a1aa174ee419d39827b0ff4a:261:329:sha256-5a3e513f9b885be888728ebf9042e57c3e9eb599b81f779ea60272cb1f35db32\",\"quote\":\"e.g., a car seat with a white or off-white blanket behind the child.\",\"start\":261},{\"end\":303,\"field\":\"alternative:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A1a47a76c521a93dcac7e7e6d3fb8e2bcef821725a1aa174ee419d39827b0ff4a:294:303:sha256-206781b80f0bddb8fa3bc833d923af55d9e88bb09bca258dfdc903a658e81862\",\"quote\":\"off-white\",\"start\":294},{\"end\":329,\"field\":\"concepts:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A1a47a76c521a93dcac7e7e6d3fb8e2bcef821725a1aa174ee419d39827b0ff4a:214:329:sha256-6d4a63ef35a9bb1840f740c457f39367daf28f284a8437323612f715c58c5e84\",\"quote\":\"The infant's head may be discreetly supported, e.g., a car seat with a white or off-white blanket behind the child.\",\"start\":214}],\"id\":\"urn:rulespec:document-understanding:revision:10065b04ee16ccccee1f6d78a64cac05bc19b977a251d39c4bf736a0c6eceeaa\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"permission\",\"logic_text\":\"white or off-white\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:efd7d44ca80d0de411156ea7d0e9e4b605d80833d147317b2e638f2f01e6a26e\",\"modality\":\"may\",\"modality_quote\":\"may\",\"object\":\"The infant's head\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:3a57b9e71dd4310f7e2be26f3ca8bea3cfa51eceb92aa506325499b0f427bb07\",\"origin\":\"aiSuggested\",\"quote\":\"The infant's head may be discreetly supported, e.g., a car seat with a white or off-white blanket behind the child.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:039900e8c53c66ff0ea3ae3b97ae6cdcdd0ea35c27dec3b9bc5ca35c29388cd0\",\"scope_quotes\":[\"d. Infants pose a particular challenge. The goal is the best likeness that can reasonably be obtained:\"],\"scope_text\":\"In the case of photographs of infants, where the goal is the best likeness that can reasonably be obtained.\",\"section_id\":\"section-1\",\"start\":214,\"summary\":\"In infant photographs, the infant's head may be discreetly supported (for example, using a car seat with a white or off-white blanket behind the child).\",\"target_ids\":[],\"typed_values\":[]}",

      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"action\":\"be taken within six months of submitting the application\",\"actor\":\"\",\"alternative_quotes\":[],\"choice_text\":\"\",\"claimants\":[],\"concepts\":[{\"definition\":\"Advisory caution noting that certificate photographs may not have been taken within six months due to agency processing times, regardless of recent certificate issuance.\",\"label\":\"Certificate photograph timing caution\",\"quote\":\"Be aware that even if the certificate itself was recently issued, because of U.S. Citizenship and Immigration Services processing times, the photograph may not have been taken within six months of submitting the application.\",\"role\":\"rkaf:assignmentPrimary\"}],\"effective_periods\":[],\"jurisdiction\":\"\",\"kind\":\"statement\",\"logic_text\":\"even if the certificate itself was recently issued, because of U.S. Citizenship and Immigration Services processing times, the photograph may not have been taken within six months of submitting the application\",\"modality\":\"possible\",\"object\":\"the photograph\",\"scope_text\":\"Even if the certificate itself was recently issued.\",\"summary\":\"Even if a citizenship or naturalization certificate was recently issued, the photograph depicted on it may not have been taken within six months of submitting the application due to U.S. Citizenship and Immigration Services processing times.\",\"typed_values\":[{\"anchor\":\"submitting the application\",\"comparator\":\"within\",\"datatype\":\"xsd:duration\",\"name\":\"six-month timing window\",\"quote\":\"within six months of submitting the application\",\"unit\":\"months\",\"value\":\"P6M\"}]}",
        "@type": "xsd:string"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed",
      "rkaf:hasApplicability": "urn:rulespec:document-understanding:scope:a22e4cf6f941c3bc0e65052be0750e88e487d45b7e8a3dcb28ecbb93f83551f4"
    },

      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"be taken within six months of submitting the application, be a good likeness of, and satisfactorily identify\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:fcaf78aa1ef72a977d65c877c14f3f51614f2c23a2b17d57db2fff271f5ce817\",\"urn:rulespec:document-understanding:assertion:bd454b8132266d98de224f57f7563a80f1f10f5fc36ac3fe89b0a46b94aa198c\",\"urn:rulespec:document-understanding:assertion:8ff7e04125928dad96cca645d284ace73bc587e14858dd9d09ef38fcc463ef0c\",\"urn:rulespec:document-understanding:assertion:1861d08ce6f3eddb2c7d4c1d60356f2813db586b1650dc30a77003b1c8941b4d\",\"urn:rulespec:document-understanding:assertion:1573748142c4e8f99a32c87cd41d0f6ee1ee63150cd19e0470b110a9c596db1b\",\"urn:rulespec:document-understanding:assertion:9c5d6389be821dbeac87a03c296fda4067a7a5ec1dfb40bcc629edd1a7812fa9\",\"urn:rulespec:document-understanding:assertion:d19242cbaf4cf14eb1f8f5b9706d1306fd929e9aba056583580195ec4222aa77\",\"urn:rulespec:document-understanding:assertion:037b2c7417f8bc58b4841c03ae886de6458e7a52b51b8f95e462b8bfe6f2e611\",\"urn:rulespec:document-understanding:assertion:24a39794561b046fa972711e6a134c9557a43b1ef73fb2ba799837d6980c3a10\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[{\"definition\":\"Recommendation that a photograph be taken within six months of submitting the application, provide a good likeness, and satisfactorily identify the applicant.\",\"label\":\"Photograph timing and likeness\",\"quote\":\"The photograph should be taken within six months of submitting the application, be a good likeness of and satisfactorily identify the applicant at the time of the application (see 22 CFR 51.26).\",\"role\":\"rkaf:assignmentPrimary\"}],\"context_quotes\":[],\"effective_periods\":[],\"end\":777,\"evidence\":[{\"end\":777,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A1a47a76c521a93dcac7e7e6d3fb8e2bcef821725a1aa174ee419d39827b0ff4a:579:777:sha256-b510b6af00ca7b0c23737836083cc4d12a960965231345ad01b5f23f4db27990\",\"quote\":\"(2) The photograph should be taken within six months of submitting the application, be a good likeness of and satisfactorily identify the applicant at the time of the application (see 22 CFR 51.26).\",\"start\":579},{\"end\":712,\"field\":\"action\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A1a47a76c521a93dcac7e7e6d3fb8e2bcef821725a1aa174ee419d39827b0ff4a:605:712:sha256-bb3eb84c690c4991b7e2928f81c3c41ee8037ef7e402f79dadd112258fd63433\",\"quote\":\"be taken within six months of submitting the application, be a good likeness of and satisfactorily identify\",\"start\":605},{\"end\":726,\"field\":\"object\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A1a47a76c521a93dcac7e7e6d3fb8e2bcef821725a1aa174ee419d39827b0ff4a:713:726:sha256-8ef9d27a07ce0795981ff451394777b4334f90b19415a9fa97bf254305ab328e\",\"quote\":\"the applicant\",\"start\":713},{\"end\":661,\"field\":\"logic_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A1a47a76c521a93dcac7e7e6d3fb8e2bcef821725a1aa174ee419d39827b0ff4a:614:661:sha256-259f04ab641e765d27f59d7a0df9033f15a0bb67eade3ff5adf0d8a9de464130\",\"quote\":\"within six months of submitting the application\",\"start\":614},{\"end\":604,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A1a47a76c521a93dcac7e7e6d3fb8e2bcef821725a1aa174ee419d39827b0ff4a:598:604:sha256-f86b1f62a8554232b940f4fd9c8d6601aae4767456df3d6cdff55a51f17b5075\",\"quote\":\"should\",\"start\":598},{\"end\":539,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A1a47a76c521a93dcac7e7e6d3fb8e2bcef821725a1aa174ee419d39827b0ff4a:436:539:sha256-7f0fa99d97951a139f33ec44a19b323846e2dfb0edb6a59ea10b8060a5799c86\",\"quote\":\"You must request a new photograph if the photograph submitted does not meet the following requirements:\",\"start\":436},{\"end\":777,\"field\":\"concepts:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A1a47a76c521a93dcac7e7e6d3fb8e2bcef821725a1aa174ee419d39827b0ff4a:583:777:sha256-23e904742f4617b5724573d2cab7b278f729345b31e1555996d856fd4e2bc51e\",\"quote\":\"The photograph should be taken within six months of submitting the application, be a good likeness of and satisfactorily identify the applicant at the time of the application (see 22 CFR 51.26).\",\"start\":583},{\"end\":661,\"field\":\"typed_values:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A1a47a76c521a93dcac7e7e6d3fb8e2bcef821725a1aa174ee419d39827b0ff4a:614:661:sha256-259f04ab641e765d27f59d7a0df9033f15a0bb67eade3ff5adf0d8a9de464130\",\"quote\":\"within six months of submitting the application\",\"start\":614}],\"id\":\"urn:rulespec:document-understanding:revision:d0dd1ba0631a613406da2389623657f4952a5ed68e55602327d58d4853041efd\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"recommendation\",\"logic_text\":\"within six months of submitting the application\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:d19242cbaf4cf14eb1f8f5b9706d1306fd929e9aba056583580195ec4222aa77\",\"modality\":\"should\",\"modality_quote\":\"should\",\"object\":\"the applicant\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:9ccf61c296af5a6f03715d228fa42888545440b241fe40b01bd8ca287868ab1f\",\"origin\":\"aiSuggested\",\"quote\":\"(2) The photograph should be taken within six months of submitting the application, be a good likeness of and satisfactorily identify the applicant at the time of the application (see 22 CFR 51.26).\",\"references\":[\"22 CFR 51.26\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:540407481703f1cda904b116a192034e33c3ce3d9c749b1f5d724f493e5940c7\",\"scope_quotes\":[\"You must request a new photograph if the photograph submitted does not meet the following requirements:\"],\"scope_text\":\"Governing requirements for submitted photographs under which a new photograph must be requested if not met.\",\"section_id\":\"section-1\",\"start\":579,\"summary\":\"The photograph should be taken within six months of submitting the application, and it should be a good likeness of and satisfactorily identify the applicant at the time of the application.\",\"target_ids\":[],\"typed_values\":[{\"anchor\":\"submitting the application\",\"comparator\":\"within\",\"datatype\":\"xsd:duration\",\"name\":\"photograph timing window\",\"quote\":\"within six months of submitting the application\",\"unit\":\"months\",\"value\":\"P6M\"}]}",

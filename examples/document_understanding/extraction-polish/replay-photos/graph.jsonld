      "dcterms:description": "{\"action\":\"be taken within six months of submitting the application\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:58d35cdca4601cf44221a0be51f8685c43e14a13866b4e7905d74319113173ae\",\"urn:rulespec:document-understanding:assertion:b7b2e41fcf509357d9db1a193ee215a5daabc4222d132430ff715cb9944d0012\",\"urn:rulespec:document-understanding:assertion:5b3925e18af99f3534f792185d8c05f5496cef93d4782d90b7dd6ef744e4fd4c\",\"urn:rulespec:document-understanding:assertion:1d9986ebdd08909ee151b3b0ddc0478684856507e52e675a5dce883a6c41cdad\",\"urn:rulespec:document-understanding:assertion:fb8da32de67ac26bd52ffec3b95cb9f7d3efa584d1f266c26ed160a311f5f1a7\",\"urn:rulespec:document-understanding:assertion:9c42d1157c3cf1bd784f78a90462f9da2944a4529dca459c6f00388d11694fd4\",\"urn:rulespec:document-understanding:assertion:2ad9ee92702ecd45fded168b9475c2ac5662536762eb7ce0ec6ab42fa8c0be08\",\"urn:rulespec:document-understanding:assertion:44a67f6e98ff716a08255ee9cd939bb56a702733ca5646ad5fd06d26f3278578\",\"urn:rulespec:document-understanding:assertion:baeab7c2cf2a9d4ff9d317c6f898a240aa8067fbd31e7e5b149cd82052cea3f3\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[{\"definition\":\"Advisory caution noting that certificate photographs may not have been taken within six months due to agency processing times, regardless of recent certificate issuance.\",\"label\":\"Certificate photograph timing caution\",\"quote\":\"Be aware that even if the certificate itself was recently issued, because of U.S. Citizenship and Immigration Services processing times, the photograph may not have been taken within six months of submitting the application.\",\"role\":\"rkaf:assignmentPrimary\"}],\"context_quotes\":[\"because of U.S. Citizenship and Immigration Services processing times\"],\"effective_periods\":[],\"end\":1326,\"evidence\":[{\"end\":1326,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A1a47a76c521a93dcac7e7e6d3fb8e2bcef821725a1aa174ee419d39827b0ff4a:1102:1326:sha256-50a909659c137a0145e26c14415f58eddd60d597036b4b5dc9946eb860ff1a9d\",\"quote\":\"Be aware that even if the certificate itself was recently issued, because of U.S. Citizenship and Immigration Services processing times, the photograph may not have been taken within six months of submitting the application.\",\"start\":1102},{\"end\":1325,\"field\":\"action\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A1a47a76c521a93dcac7e7e6d3fb8e2bcef821725a1aa174ee419d39827b0ff4a:1262:1325:sha256-affac32bfacc48a3cb09c05cd98466ac869dc5ac6f026c9c8dc9b460bff00adc\",\"quote\":\"have been taken within six months of submitting the application\",\"start\":1262},{\"end\":1253,\"field\":\"object\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A1a47a76c521a93dcac7e7e6d3fb8e2bcef821725a1aa174ee419d39827b0ff4a:1239:1253:sha256-c01ab7b07819a3f56e947b3b55dd30e6b4cab963ee7d0dd8efb61b44d2bf957e\",\"quote\":\"the photograph\",\"start\":1239},{\"end\":1325,\"field\":\"logic_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A1a47a76c521a93dcac7e7e6d3fb8e2bcef821725a1aa174ee419d39827b0ff4a:1116:1325:sha256-a069edb4b79605e554523b150dee381d6aff7a2a09d520b1026d29645b279c71\",\"quote\":\"even if the certificate itself was recently issued, because of U.S. Citizenship and Immigration Services processing times, the photograph may not have been taken within six months of submitting the application\",\"start\":1116},{\"end\":1257,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A1a47a76c521a93dcac7e7e6d3fb8e2bcef821725a1aa174ee419d39827b0ff4a:1254:1257:sha256-ee4d988c65de860fabbfbcd27f73d50bbebe3fba37fe419284f4811389c30bdc\",\"quote\":\"may\",\"start\":1254},{\"end\":1166,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A1a47a76c521a93dcac7e7e6d3fb8e2bcef821725a1aa174ee419d39827b0ff4a:1116:1166:sha256-e5acac693988dc6cb403fb8f1dfe9b9034f0c9b1c2cbf4ab8e156eb365a291c8\",\"quote\":\"even if the certificate itself was recently issued\",\"start\":1116},{\"end\":1237,\"field\":\"context:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A1a47a76c521a93dcac7e7e6d3fb8e2bcef821725a1aa174ee419d39827b0ff4a:1168:1237:sha256-192c9c01fa8d65048d13c7c55e98204a5394bd49b505f269a4cfd867d3527843\",\"quote\":\"because of U.S. Citizenship and Immigration Services processing times\",\"start\":1168},{\"end\":1326,\"field\":\"concepts:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A1a47a76c521a93dcac7e7e6d3fb8e2bcef821725a1aa174ee419d39827b0ff4a:1102:1326:sha256-50a909659c137a0145e26c14415f58eddd60d597036b4b5dc9946eb860ff1a9d\",\"quote\":\"Be aware that even if the certificate itself was recently issued, because of U.S. Citizenship and Immigration Services processing times, the photograph may not have been taken within six months of submitting the application.\",\"start\":1102},{\"end\":1325,\"field\":\"typed_values:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A1a47a76c521a93dcac7e7e6d3fb8e2bcef821725a1aa174ee419d39827b0ff4a:1278:1325:sha256-259f04ab641e765d27f59d7a0df9033f15a0bb67eade3ff5adf0d8a9de464130\",\"quote\":\"within six months of submitting the application\",\"start\":1278}],\"id\":\"urn:rulespec:document-understanding:revision:34e9e12c33ba16b5628352b7c3d26f2ed898a75008e3994e1e6938afa8902e90\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"statement\",\"logic_text\":\"even if the certificate itself was recently issued, because of U.S. Citizenship and Immigration Services processing times, the photograph may not have been taken within six months of submitting the application\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:2ad9ee92702ecd45fded168b9475c2ac5662536762eb7ce0ec6ab42fa8c0be08\",\"modality\":\"possible\",\"modality_quote\":\"may\",\"object\":\"the photograph\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:3ce37d960d94e6a30a971529cedf0a140559878274dd9074af33f7b5b9b11c2e\",\"origin\":\"aiSuggested\",\"quote\":\"Be aware that even if the certificate itself was recently issued, because of U.S. Citizenship and Immigration Services processing times, the photograph may not have been taken within six months of submitting the application.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:b9fcc874ccb1554b156966aa6766855198123f8507d2fc9d58e61ad120b2805f\",\"scope_quotes\":[\"even if the certificate itself was recently issued\"],\"scope_text\":\"Even if the certificate itself was recently issued.\",\"section_id\":\"section-1\",\"start\":1102,\"summary\":\"Even if a citizenship or naturalization certificate was recently issued, the photograph depicted on it may not have been taken within six months of submitting the application due to U.S. Citizenship and Immigration Services processing times.\",\"target_ids\":[],\"typed_values\":[{\"anchor\":\"submitting the application\",\"comparator\":\"within\",\"datatype\":\"xsd:duration\",\"name\":\"six-month timing window\",\"quote\":\"within six months of submitting the application\",\"unit\":\"months\",\"value\":\"P6M\"}]}",

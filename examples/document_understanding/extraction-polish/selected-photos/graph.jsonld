      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"choice_text\":\"\",\"claimants\":[],\"concepts\":[{\"definition\":\"Cautionary note that certificate photographs might not satisfy the six-month timeliness standard despite recent issuance.\",\"label\":\"Certificate Photo Recency Warning\",\"quote\":\"Be aware that even if the certificate itself was recently issued, because of U.S. Citizenship and Immigration Services processing times, the photograph may not have been taken within six months of submitting the application.\",\"role\":\"rkaf:assignmentPrimary\"}],\"effective_periods\":[],\"jurisdiction\":\"\",\"kind\":\"statement\",\"logic_text\":\"even if the certificate itself was recently issued, because of U.S. Citizenship and Immigration Services processing times, the photograph may not have been taken within six months of submitting the application\",\"modality\":\"possible\",\"object\":\"the photograph\",\"scope_text\":\"Applies when evaluating certificate photos, even if the certificate was recently issued, due to USCIS processing times.\",\"summary\":\"Even if a citizenship or naturalization certificate was recently issued, due to USCIS processing times, the photograph may possibly not have been taken within six months of submitting the application.\",\"typed_values\":[{\"anchor\":\"submitting the application\",\"comparator\":\"within\",\"datatype\":\"xsd:duration\",\"name\":\"photo_recency_period\",\"quote\":\"within six months of submitting the application\",\"unit\":\"months\",\"value\":\"P6M\"}]}",
        "@type": "xsd:string"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed",
      "rkaf:hasApplicability": "urn:rulespec:document-understanding:scope:d72c7313152198f22434bd241a7cb371a084124f5eaa419bd328a48e980c9cb9"
    },

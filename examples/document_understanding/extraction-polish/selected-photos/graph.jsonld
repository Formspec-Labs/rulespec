      "rkaf:assertsValue": {
        "@value": "{\"action\":\"having eyes partially or completely closed\",\"actor\":\"\",\"alternative_quotes\":[\"partially\",\"completely closed\"],\"choice_text\":\"Eyes may be partially closed or completely closed.\",\"claimants\":[],\"concepts\":[{\"definition\":\"Standard allowing an infant's or newborn's eyes to be partially or completely closed in a photograph.\",\"label\":\"Infant Passport Photograph Eyes\",\"quote\":\"It is acceptable if the infant's eyes, particularly a newborn's, are partially or completely closed;\",\"role\":\"rkaf:assignmentPrimary\"}],\"effective_periods\":[],\"jurisdiction\":\"\",\"kind\":\"permission\",\"logic_text\":\"partially or completely closed\",\"modality\":\"may\",\"object\":\"the infant's eyes, particularly a newborn's\",\"scope_text\":\"Governed by the context of photographs of infants, where the goal is the best likeness that can reasonably be obtained.\",\"summary\":\"For infant photographs, it is acceptable for the infant's eyes, particularly a newborn's, to be partially or completely closed.\",\"typed_values\":[]}",
        "@type": "xsd:string"
      },

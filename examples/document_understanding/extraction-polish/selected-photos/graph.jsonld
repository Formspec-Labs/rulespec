      "rkaf:assertsValue": {
        "@value": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[\"hairstyle\",\"facial hair\"],\"choice_text\":\"A change in hairstyle or a change in facial hair.\",\"claimants\":[],\"concepts\":[{\"definition\":\"Allowance of hair changes between the ID and photograph as long as good likeness is maintained.\",\"label\":\"Change in Hairstyle or Facial Hair\",\"quote\":\"A photograph showing a change in hairstyle or facial hair from the identification document submitted is acceptable if it still is a good likeness of the applicant;\",\"role\":\"rkaf:assignmentPrimary\"}],\"effective_periods\":[],\"jurisdiction\":\"\",\"kind\":\"permission\",\"logic_text\":\"if it still is a good likeness of the applicant\",\"modality\":\"may\",\"object\":\"A photograph showing a change in hairstyle or facial hair from the identification document submitted\",\"scope_text\":\"Conditioned on the photograph still being a good likeness of the applicant.\",\"summary\":\"A photograph showing a change in hairstyle or facial hair compared to the submitted identification document is acceptable if it remains a good likeness of the applicant.\",\"typed_values\":[]}",
        "@type": "xsd:string"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed",
      "rkaf:hasApplicability": "urn:rulespec:document-understanding:scope:903ea220b5b14d21eb83e5e1df581f0b4c38fac1071b53ac8ffea5b2cfe3af27"

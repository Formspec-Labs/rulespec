      "rkaf:assertsValue": {
        "@value": "{\"action\":\"be taken within six months of submitting the application, be a good likeness of, and satisfactorily identify the applicant at the time of the application\",\"actor\":\"\",\"alternative_quotes\":[],\"choice_text\":\"\",\"claimants\":[],\"concepts\":[{\"definition\":\"Recommendation regarding photograph recency (six months), likeness, and applicant identification.\",\"label\":\"Photograph Timeliness and Likeness\",\"quote\":\"The photograph should be taken within six months of submitting the application, be a good likeness of and satisfactorily identify the applicant at the time of the application (see 22 CFR 51.26).\",\"role\":\"rkaf:assignmentPrimary\"}],\"effective_periods\":[],\"jurisdiction\":\"\",\"kind\":\"recommendation\",\"logic_text\":\"within six months of submitting the application, be a good likeness of and satisfactorily identify the applicant at the time of the application\",\"modality\":\"should\",\"object\":\"The photograph\",\"scope_text\":\"Governed as part of the requirements for submitted photographs.\",\"summary\":\"The photograph should be taken within six months of submitting the application, be a good likeness of the applicant, and satisfactorily identify the applicant at the time of the application (referencing 22 CFR 51.26).\",\"typed_values\":[{\"anchor\":\"submitting the application\",\"comparator\":\"within\",\"datatype\":\"xsd:duration\",\"name\":\"timeliness_threshold\",\"quote\":\"within six months of submitting the application\",\"unit\":\"months\",\"value\":\"P6M\"}]}",
        "@type": "xsd:string"
      },

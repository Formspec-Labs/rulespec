      "dcterms:description": "{\"action\":\"be taken within six months of submitting the application, be a good likeness of, and satisfactorily identify the applicant at the time of the application\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:e0244dfa8dccd37bae372b2c0f25ee9170f6fd330d57f77cbbca8bc5ce8664de\",\"urn:rulespec:document-understanding:assertion:e339976bf04e41fb8a04f9b02a71f8ccdbd67b8c82daeea03617a8e9cd09b281\",\"urn:rulespec:document-understanding:assertion:c9394338ffa906fa37949d6f217c9009fcd3aa215603d0a5422e2974aa1a51e1\",\"urn:rulespec:document-understanding:assertion:e8e9951a337983fcf2ffa8e20da077e8cf71f71071e24ed3912dd4ff26319e6a\",\"urn:rulespec:document-understanding:assertion:0b35d074a8511d6ba66cb0120fdf79c677a503b9dd2cc679de33f33173c78b7e\",\"urn:rulespec:document-understanding:assertion:d3b108bf0f8c00f945719aca799c432e72e0864107092e49352c788bdb8ce6ee\",\"urn:rulespec:document-understanding:assertion:19b9dea2cc1edc9f8756d579ca4318137dc2d5a20b7171131148889d57ea960f\",\"urn:rulespec:document-understanding:assertion:3be2f327431077beb394f15760cbf534c9932cf6daee01b7cba65a295eaff9d2\",\"urn:rulespec:document-understanding:assertion:c2208963f51f8cc42496c32757966beeafb365d7ac2e7056365bca118958bbed\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[{\"definition\":\"Recommendation regarding photograph recency (six months), likeness, and applicant identification.\",\"label\":\"Photograph Timeliness and Likeness\",\"quote\":\"The photograph should be taken within six months of submitting the application, be a good likeness of and satisfactorily identify the applicant at the time of the application (see 22 CFR 51.26).\",\"role\":\"rkaf:assignmentPrimary\"}],\"context_quotes\":[],\"effective_periods\":[],\"end\":777,\"evidence\":[{\"end\":777,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A1
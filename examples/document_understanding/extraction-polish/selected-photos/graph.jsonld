      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[\"hairstyle\",\"facial hair\"],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:04559549107e75c1931cf7a131a41627144095d9af98509ff318017e091a4455\",\"urn:rulespec:document-understanding:assertion:078cc3e9657eb8f1b057c6989ae39631f783323968b641d93c25d39fd06dad77\",\"urn:rulespec:document-understanding:assertion:13d275d73307622712f7538f34f68172ff4da69f5673e6e4fcf0414c7ab76aae\",\"urn:rulespec:document-understanding:assertion:604b04e8c7069e93ef24cf3298d662c929ca4306d3711f66040a35cf18ae1a0d\",\"urn:rulespec:document-understanding:assertion:23df57d21622df560f804c36d290872b722308ec6711b86531319c416d5cec36\",\"urn:rulespec:document-understanding:assertion:2aedb5d4bfc22cd11b525a5513be40d6e38bdbbcac53bb2d4fdc60465f743777\",\"urn:rulespec:document-understanding:assertion:03e4024b5668f6a8f0ea2ae875a82877b6db2bcbf6c37eb06427e9a145eaece6\",\"urn:rulespec:document-understanding:assertion:6148733e3937fa70474cc0b99dcd4434f42918534af43d5352bbc437c5d70bc4\",\"urn:rulespec:document-understanding:assertion:faeb8f08e33a025c1f67b3d3d92b04ea8aaa3a17ab4e398c058ee49ab3d52750\",\"urn:rulespec:document-understanding:assertion:2759cf732a93862ee5d47662894b2837edf2a3f9cc4ac72e16cbc28548e135bf\"],\"choice_quote\":\"hairstyle or facial hair\",\"choice_text\":\"A change in hairstyle or a change in facial hair.\",\"claimants\":[],\"concepts\":[{\"definition\":\"Allowance of hair changes between the ID and photograph as long as good likeness is maintained.\",\"label\":\"Change in Hairstyle or Facial Hair\",\"quote\":\"A photograph showing a change in hairstyle or facial hair from the identification document submitted is acceptable if it still is a good likeness of the applicant;\",\"role\":\"rkaf:assignmentPrimary\"}],\"context_quotes\":[\"The photograph should be taken within six months of submitting the application, be a good likeness of and satisfactorily identify the applicant at the time of the application (see 22 CFR 51.26).\"],\"effective_periods\":[],\"end\":941,\"evidence\":[{\"end\":941,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A1a47a76c521a93dcac7e7e6d3fb8e2bcef821725a1aa174ee419d39827b0ff4a:778:941:sha256-f85948cbae782232b24b5a1e18ba22b60d5e648ccf3dce95f23e97ff4a73da62\",\"quote\":\"A photograph showing a change in hairstyle or facial hair from the identification document submitted is acceptable if it still is a good likeness of the applicant;\",\"start\":778},{\"end\":878,\"field\":\"object\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A1a47a76c521a93dcac7e7e6d3fb8e2bcef821725a1aa174ee419d39827b0ff4a:778:878:sha256-441f92a7a591513a993fb995525b97d75638004927d559f88abb8d9d56b5b8c5\",\"quote\":\"A photograph showing a change in hairstyle or facial hair from the identification document submitted\",\"start\":778},{\"end\":940,\"field\":\"logic_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A1a47a76c521a93dcac7e7e6d3fb8e2bcef821725a1aa174ee419d39827b0ff4a:893:940:sha256-ea1e4c1337600c67a24988d71cb1554166db8686d05960f88534bdbd6e9564a1\",\"quote\":\"if it still is a good likeness of the applicant\",\"start\":893},{\"end\":892,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A1a47a76c521a93dcac7e7e6d3fb8e2bcef821725a1aa174ee419d39827b0ff4a:882:892:sha256-129b70f8672ecacafe6a4c4f63c584842def71d10e3ca0b9be89543ffd4ff4e6\",\"quote\":\"acceptable\",\"start\":882},{\"end\":835,\"field\":\"choice_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A1a47a76c521a93dcac7e7e6d3fb8e2bcef821725a1aa174ee419d39827b0ff4a:811:835:sha256-bb98ab5e7d34d28287ae8cf6df4d686d3ea9d4d5f723b049f4fe840d2e1d0036\",\"quote\":\"hairstyle or facial hair\",\"start\":811},{\"end\":940,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A1a47a76c521a93dcac7e7e6d3fb8e2bcef821725a1aa174ee419d39827b0ff4a:893:940:sha256-ea1e4c1337600c67a24988d71cb1554166db8686d05960f88534bdbd6e9564a1\",\"quote\":\"if it still is a good likeness of the applicant\",\"start\":893},{\"end\":777,\"field\":\"context:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A1a47a76c521a93dcac7e7e6d3fb8e2bcef821725a1aa174ee419d39827b0ff4a:583:777:sha256-23e904742f4617b5724573d2cab7b278f729345b31e1555996d856fd4e2bc51e\",\"quote\":\"The photograph should be taken within six months of submitting the application, be a good likeness of and satisfactorily identify the applicant at the time of the application (see 22 CFR 51.26).\",\"start\":583},{\"end\":820,\"field\":\"alternative:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A1a47a76c521a93dcac7e7e6d3fb8e2bcef821725a1aa174ee419d39827b0ff4a:811:820:sha256-6db3c4c04f261482716c407fb6b85eed133550dd87fc0afabec3560d44dccbeb\",\"quote\":\"hairstyle\",\"start\":811},{\"end\":835,\"field\":\"alternative:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A1a47a76c521a93dcac7e7e6d3fb8e2bcef821725a1aa174ee419d39827b0ff4a:824:835:sha256-dc91e7b2214ab0b930152b902d3e0d2a0e2f095f2cbb1a706380a5ec7f4fbf87\",\"quote\":\"facial hair\",\"start\":824},{\"end\":941,\"field\":\"concepts:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A1a47a76c521a93dcac7e7e6d3fb8e2bcef821725a1aa174ee419d39827b0ff4a:778:941:sha256-f85948cbae782232b24b5a1e18ba22b60d5e648ccf3dce95f23e97ff4a73da62\",\"quote\":\"A photograph showing a change in hairstyle or facial hair from the identification document submitted is acceptable if it still is a good likeness of the applicant;\",\"start\":778}],\"id\":\"urn:rulespec:document-understanding:revision:a63526ad8150d0a6f42c97711d0fb01d76413ef1fe13efe00ebd7323e6af7c21\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"permission\",\"logic_text\":\"if it still is a good likeness of the applicant\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:faeb8f08e33a025c1f67b3d3d92b04ea8aaa3a17ab4e398c058ee49ab3d52750\",\"modality\":\"may\",\"modality_quote\":\"acceptable\",\"object\":\"A photograph showing a change in hairstyle or facial hair from the identification document submitted\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:066216d3494808c588e4286309406e11db4576528f1c962939f3715580a022ec\",\"origin\":\"aiSuggested\",\"quote\":\"A photograph showing a change in hairstyle or facial hair from the identification document submitted is acceptable if it still is a good likeness of the applicant;\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:c3d742c527b835a3bfff51bb15409f9f89b43decb99d42acd3bf51603e4bb608\",\"scope_quotes\":[\"if it still is a good likeness of the applicant\"],\"scope_text\":\"Conditioned on the photograph still being a good likeness of the applicant.\",\"section_id\":\"section-1\",\"start\":778,\"summary\":\"A photograph showing a change in hairstyle or facial hair compared to the submitted identification document is acceptable if it remains a good likeness of the applicant.\",\"target_ids\":[],\"typed_values\":[]}",

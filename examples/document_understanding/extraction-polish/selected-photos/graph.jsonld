b8e2bcef821725a1aa174ee419d39827b0ff4a:177:207:sha256-268ecf099f1d32c3e05639ac95af6a411fa7cfb6c36f09399e95e7d790ce5968\",\"quote\":\"partially or completely closed\",\"start\":177},{\"end\":102,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A1a47a76c521a93dcac7e7e6d3fb8e2bcef821725a1aa174ee419d39827b0ff4a:0:102:sha256-d5352952c35d27ead43ba84f11e560e73e7604cc8f5e1991855c69f726f1417f\",\"quote\":\"d. Infants pose a particular challenge. The goal is the best likeness that can reasonably be obtained:\",\"start\":0},{\"end\":102,\"field\":\"context:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A1a47a76c521a93dcac7e7e6d3fb8e2bcef821725a1aa174ee419d39827b0ff4a:0:102:sha256-d5352952c35d27ead43ba84f11e560e73e7604cc8f5e1991855c69f726f1417f\",\"quote\":\"d. Infants pose a particular challenge. The goal is the best likeness that can reasonably be obtained:\",\"start\":0},{\"end\":186,\"field\":\"alternative:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A1a47a76c521a93dcac7e7e6d3fb8e2bcef821725a1aa174ee419d39827b0ff4a:177:186:sha256-4b56ea8eae2d74b90e3408870706e7c75b2d59db18dd55f45a7433383a74cded\",\"quote\":\"partially\",\"start\":177},{\"end\":207,\"field\":\"alternative:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A1a47a76c521a93dcac7e7e6d3fb8e2bcef821725a1aa174ee419d39827b0ff4a:190:207:sha256-68f7adf3d4d2f3c36def5ee3711feb5a78b7738c41892a95ed2369bf261fffe5\",\"quote\":\"completely closed\",\"start\":190},{\"end\":208,\"field\":\"concepts:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A1a47a76c521a93dcac7e7e6d3fb8e2bcef821725a1aa174ee419d39827b0ff4a:108:208:sha256-a97a81db885d6eb9b9f1b797f184ba9670be25dee687c99024a22158dca24573\",\"quote\":\"It is acceptable if the infant's eyes, particularly a newborn's, are partially or comple
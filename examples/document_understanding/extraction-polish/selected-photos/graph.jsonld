      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:6c8b0cc07f81380dfe850122df22649fa340fffb9350da911480cd78f425d26b\",\"urn:rulespec:document-understanding:assertion:e7f828db750c83e9c46850c37b493a0d004d8d130bb521e34883d7651fdf8d13\",\"urn:rulespec:document-understanding:assertion:e0c8f5a1393b960d5ed28e420ac0f8a028db92625626f7522008ad26d64d9ea0\",\"urn:rulespec:document-understanding:assertion:6b244e337e46a2a9808bd2b6f58111e91b3984647ff268b87cde96942a63e774\",\"urn:rulespec:document-understanding:assertion:abebc2562bf0f93def4c83b1f107f9a74c5c6a239a38f7ae78b340904811b2a9\",\"urn:rulespec:document-understanding:assertion:7bd51fe9694fe57342ed67d7f55c297fe977d6ab5485c5845e46e870f47ca955\",\"urn:rulespec:document-understanding:assertion:1a5536c9b00665c8780086955525923f658bab3c5595fc44a51da98146e56414\",\"urn:rulespec:document-understanding:assertion:4e544b1ab01413791416e12266ca7af15d1ddf715095c4f724fdcc07365d2754\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[{\"definition\":\"Cautionary note that certificate photographs might not satisfy the six-month timeliness standard despite recent issuance.\",\"label\":\"Certificate Photo Recency Warning\",\"quote\":\"Be aware that even if the certificate itself was recently issued, because of U.S. Citizenship and Immigration Services processing times, the photograph may not have been taken within six months of submitting the application.\",\"role\":\"rkaf:assignmentPrimary\"}],\"context_quotes\":[\"NOTE: Applicants may wish to re-use a passport photograph that is depicted on their submitted U.S Certificate of Citizenship or Certificate of Naturalization.\"],\"effective_periods\":[],\"end\":1326,\"evidence\":[{\"end\":1326,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A1a47a76c521a93dcac7e7e6d3fb8e2bcef821725a1aa174ee419d39827b0ff4a:1102:1326:sha256-50a909659c137a0145e26c14415f58eddd60d597036b4b5dc9946eb860ff1a9d\",\"quote\":\"Be aware that even if the certificate itself was recently issued, because of U.S. Citizenship and Immigration Services processing times, the photograph may not have been taken within six months of submitting the application.\",\"start\":1102},{\"end\":1253,\"field\":\"object\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A1a47a76c521a93dcac7e7e6d3fb8e2bcef821725a1aa174ee419d39827b0ff4a:1239:1253:sha256-c01ab7b07819a3f56e947b3b55dd30e6b4cab963ee7d0dd8efb61b44d2bf957e\",\"quote\":\"the photograph\",\"start\":1239},{\"end\":1325,\"field\":\"logic_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A1a47a76c521a93dcac7e7e6d3fb8e2bcef821725a1aa174ee419d39827b0ff4a:1116:1325:sha256-a069edb4b79605e554523b150dee381d6aff7a2a09d520b1026d29645b279c71\",\"quote\":\"even if the certificate itself was recently issued, because of U.S. Citizenship and Immigration Services processing times, the photograph may not have been taken within six months of submitting the application\",\"start\":1116},{\"end\":1257,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A1a47a76c521a93dcac7e7e6d3fb8e2bcef821725a1aa174ee419d39827b0ff4a:1254:1257:sha256-ee4d988c65de860fabbfbcd27f73d50bbebe3fba37fe419284f4811389c30bdc\",\"quote\":\"may\",\"start\":1254},{\"end\":1237,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A1a47a76c521a93dcac7e7e6d3fb8e2bcef821725a1aa174ee419d39827b0ff4a:1116:1237:sha256-4aadd3af98a1108b92c2ddb298ecbaad8cb5a743e1c46ef0999d12fd8219b4c6\",\"quote\":\"even if the certificate itself was recently issued, because of U.S. Citizenship and Immigration Services processing times\",\"start\":1116},{\"end\":1101,\"field\":\"context:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A1a47a76c521a93dcac7e7e6d3fb8e2bcef821725a1aa174ee419d39827b0ff4a:943:1101:sha256-c0dfbfc14d5bd47b86ff19b674a009b1f8477c28ba1656cbb254ae6db478d6ac\",\"quote\":\"NOTE: Applicants may wish to re-use a passport photograph that is depicted on their submitted U.S Certificate of Citizenship or Certificate of Naturalization.\",\"start\":943},{\"end\":1326,\"field\":\"concepts:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A1a47a76c521a93dcac7e7e6d3fb8e2bcef821725a1aa174ee419d39827b0ff4a:1102:1326:sha256-50a909659c137a0145e26c14415f58eddd60d597036b4b5dc9946eb860ff1a9d\",\"quote\":\"Be aware that even if the certificate itself was recently issued, because of U.S. Citizenship and Immigration Services processing times, the photograph may not have been taken within six months of submitting the application.\",\"start\":1102},{\"end\":1325,\"field\":\"typed_values:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A1a47a76c521a93dcac7e7e6d3fb8e2bcef821725a1aa174ee419d39827b0ff4a:1278:1325:sha256-259f04ab641e765d27f59d7a0df9033f15a0bb67eade3ff5adf0d8a9de464130\",\"quote\":\"within six months of submitting the application\",\"start\":1278}],\"id\":\"urn:rulespec:document-understanding:revision:e82e0eaddf81e6483ba9c074c40427a72f7fdeecc84d4684e3208eb9b9d4117b\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"statement\",\"logic_text\":\"even if the certificate itself was recently issued, because of U.S. Citizenship and Immigration Services processing times, the photograph may not have been taken within six months of submitting the application\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:7bd51fe9694fe57342ed67d7f55c297fe977d6ab5485c5845e46e870f47ca955\",\"modality\":\"possible\",\"modality_quote\":\"may\",\"object\":\"the photograph\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:792b166004114b0de33f4ec4886368486dbb2bcf333aba20766e7c6f7a1c4927\",\"origin\":\"aiSuggested\",\"quote\":\"Be aware that even if the certificate itself was recently issued, because of U.S. Citizenship and Immigration Services processing times, the photograph may not have been taken within six months of submitting the application.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:c2689f6662e20cfe43aec80da0820b569245195ab4a5d898df081c3b1a751524\",\"scope_quotes\":[\"even if the certificate itself was recently issued, because of U.S. Citizenship and Immigration Services processing times\"],\"scope_text\":\"Applies when evaluating certificate photos, even if the certificate was recently issued, due to USCIS processing times.\",\"section_id\":\"section-1\",\"start\":1102,\"summary\":\"Even if a citizenship or naturalization certificate was recently issued, due to USCIS processing times, the photograph may possibly not have been taken within six months of submitting the application.\",\"target_ids\":[],\"typed_values\":[{\"anchor\":\"submitting the application\",\"comparator\":\"within\",\"datatype\":\"xsd:duration\",\"name\":\"photo_recency_period\",\"quote\":\"within six months of submitting the application\",\"unit\":\"months\",\"value\":\"P6M\"}]}",

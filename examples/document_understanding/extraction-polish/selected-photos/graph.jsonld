      "dcterms:description": "{\"action\":\"be discreetly supported\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:c0ca6b3d03eb6f7fed2f8f0297e4a6f17592e8b7b425a90d465a5a232afc351d\",\"urn:rulespec:document-understanding:assertion:41b7ae9926f4fbcfdf89745c4d0d0beba31d8ee9bd674179b0b8857e4061b55a\",\"urn:rulespec:document-understanding:assertion:bea20dc8448accb2fa228d7eaf5cfcfc36d97e0cbdd886915c92786084a8cec7\",\"urn:rulespec:document-understanding:assertion:be757c6b99b6c4d55002dcef531c3c0949ec326d9bce4ea7d5dba6864794f28c\",\"urn:rulespec:document-understanding:assertion:156fc99de6a831462d50cbde23c3537930356a551ea4e04febc434052b9dbf76\",\"urn:rulespec:document-understanding:assertion:eef7c24136e08c44fd71681ba627a051535ecdc364f7bc0d6830318b6fe8d412\",\"urn:rulespec:document-understanding:assertion:671a029d67deba95707da2ea57a93e5270024820ba5b60a7a0f2a4b921c0fb69\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[{\"definition\":\"Permitted discreet support of an infant's head in a photograph.\",\"label\":\"Infant Head Support\",\"quote\":\"The infant's head may be discreetly supported, e.g., a car seat with a white or off-white blanket behind the child.\",\"role\":\"rkaf:assignmentPrimary\"}],\"context_quotes\":[\"e.g., a car seat with a white or off-white blanket behind the child.\"],\"effective_periods\":[],\"end\":329,\"evidence\":[{\"end\":329,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A1a47a76c521a93dcac7e7e6d3fb8e2bcef821725a1aa174ee419d39827b0ff4a:214:329:sha256-6d4a63ef35a9bb1840f740c457f39367daf28f284a8437323612f715c58c5e84\",\"quote\":\"The infant's head may be discreetly supported, e.g., a car seat with a white or off-white blanket behind the child.\",\"start\":214},{\"end\":259,\"field\":\"action\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A1a47a76c521a93dcac7e7e6d3fb8e2bcef821725a1aa174ee419d39827b0ff4a:236:259:sha256-5f4735f2be75e50514b6f2b2d2f3ee84e340ce834bfbe743ff3ca62c9d4ca86d\",\"quote\":\"be discreetly supported\",\"start\":236},{\"end\":231,\"field\":\"object\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A1a47a76c521a93dcac7e7e6d3fb8e2bcef821725a1aa174ee419d39827b0ff4a:214:231:sha256-7e96be97b7782fdc8f6c86c30ad09790a60a7c7ee8856db1c25ef8980bc646cd\",\"quote\":\"The infant's head\",\"start\":214},{\"end\":235,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A1a47a76c521a93dcac7e7e6d3fb8e2bcef821725a1aa174ee419d39827b0ff4a:232:235:sha256-ee4d988c65de860fabbfbcd27f73d50bbebe3fba37fe419284f4811389c30bdc\",\"quote\":\"may\",\"start\":232},{\"end\":102,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A1a47a76c521a93dcac7e7e6d3fb8e2bcef821725a1aa174ee419d39827b0ff4a:0:102:sha256-d5352952c35d27ead43ba84f11e560e73e7604cc8f5e1991855c69f726f1417f\",\"quote\":\"d. Infants pose a particular challenge. The goal is the best likeness that can reasonably be obtained:\",\"start\":0},{\"end\":329,\"field\":\"context:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A1a47a76c521a93dcac7e7e6d3fb8e2bcef821725a1aa174ee419d39827b0ff4a:261:329:sha256-5a3e513f9b885be888728ebf9042e57c3e9eb599b81f779ea60272cb1f35db32\",\"quote\":\"e.g., a car seat with a white or off-white blanket behind the child.\",\"start\":261},{\"end\":329,\"field\":\"concepts:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A1a47a76c521a93dcac7e7e6d3fb8e2bcef821725a1aa174ee419d39827b0ff4a:214:329:sha256-6d4a63ef35a9bb1840f740c457f39367daf28f284a8437323612f715c58c5e84\",\"quote\":\"The infant's head may be discreetly supported, e.g., a car seat with a white or off-white blanket behind the child.\",\"start\":214}],\"id\":\"urn:rulespec:document-understanding:revision:2752c0809d0bef046ea0b00fb1855fe05c8502a3e603f7095badfbf930934223\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"permission\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:eef7c24136e08c44fd71681ba627a051535ecdc364f7bc0d6830318b6fe8d412\",\"modality\":\"may\",\"modality_quote\":\"may\",\"object\":\"The infant's head\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:4f2c28e482d07a899d14c43ae755bd20a0d5d329c584c88c7b6332a9fbf1e039\",\"origin\":\"aiSuggested\",\"quote\":\"The infant's head may be discreetly supported, e.g., a car seat with a white or off-white blanket behind the child.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:1b9716ab91e8e8b7713d0e9711e29d9f2dc0271d59f61e54b2b31f035420275d\",\"scope_quotes\":[\"d. Infants pose a particular challenge. The goal is the best likeness that can reasonably be obtained:\"],\"scope_text\":\"Governed by the context of infant photographs.\",\"section_id\":\"section-1\",\"start\":214,\"summary\":\"In infant photographs, the infant's head may be discreetly supported (for example, using a car seat with a white or off-white blanket behind the child).\",\"target_ids\":[],\"typed_values\":[]}",

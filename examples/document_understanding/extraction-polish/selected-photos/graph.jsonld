anding%3Adocument%3A1a47a76c521a93dcac7e7e6d3fb8e2bcef821725a1aa174ee419d39827b0ff4a:436:539:sha256-7f0fa99d97951a139f33ec44a19b323846e2dfb0edb6a59ea10b8060a5799c86\",\"quote\":\"You must request a new photograph if the photograph submitted does not meet the following requirements:\",\"start\":436},{\"end\":777,\"field\":\"concepts:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A1a47a76c521a93dcac7e7e6d3fb8e2bcef821725a1aa174ee419d39827b0ff4a:583:777:sha256-23e904742f4617b5724573d2cab7b278f729345b31e1555996d856fd4e2bc51e\",\"quote\":\"The photograph should be taken within six months of submitting the application, be a good likeness of and satisfactorily identify the applicant at the time of the application (see 22 CFR 51.26).\",\"start\":583},{\"end\":661,\"field\":\"typed_values:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A1a47a76c521a93dcac7e7e6d3fb8e2bcef821725a1aa174ee419d39827b0ff4a:614:661:sha256-259f04ab641e765d27f59d7a0df9033f15a0bb67eade3ff5adf0d8a9de464130\",\"quote\":\"within six months of submitting the application\",\"start\":614}],\"id\":\"urn:rulespec:document-understanding:revision:2370ec086dd656b047347213db0e3272dae9265ffb4af45fa4d45c3c08d1ee51\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"recommendation\",\"logic_text\":\"within six months of submitting the application, be a good likeness of and satisfactorily identify the applicant at the time of the application\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:19b9dea2cc1edc9f8756d579ca4318137dc2d5a20b7171131148889d57ea960f\",\"modality\":\"should\",\"modality_quote\":\"should\",\"object\":\"The photograph\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:70fb19a302eb44a7ae6bec70fd313d9af03afb362afe17e85a7983c012c28cf6\",\"origin\":\"aiSuggested\",\"quote\":\"The photograph should be taken within six months of submitting the application, be a good likeness of and satisfactorily identify the applicant at the time of the application (see 22 CFR 51.26).\",\"references\":[\"22 CFR 51.26\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:96a6662566aa60203b607aa5c7519ea674aecfef9ba5b103b9f34654ec765818\",\"scope_quotes\":[\"You must request a new photograph if the photograph submitted does not meet the following requirements:\"],\"scope_text\":\"Governed as part of the requirements for submitted photographs.\",\"section_id\":\"section-1\",\"start\":583,\"summary\":\"The photograph should be taken within six months of submitting the application, be a good likeness of the applicant, and satisfactorily identify the applicant at the time of the application (referencing 22 CFR 51.26).\",\"target_ids\":[],\"typed_values\":[{\"anchor\":\"submitting the application\",\"comparator\":\"within\",\"datatype\":\"xsd:duration\",\"name\":\"timeliness_threshold\",\"quote\":\"within six months of submitting the application\",\"unit\":\"months\",\"value\":\"P6M\"}]}",

    {
      "@id": "urn:rulespec:document-understanding:assertion:b6f0ee7ecc4e335d4fd439e16aa4b77e5f45e6f86dfb5a6f7a4996616e2908ec",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:a993c688f99762debefbfe838390e99c028dbc5f01ab880a2f7cb17fd1cc6e1a",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:fa8713d3a2afc6574c3b2d7c7ad4c310d81c757d173f0b65a6b4d821072c029d",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:4c44870fb1b891b6d47bf3a84b910e9b2c7ced89cd4a4c2b2de1992dd21f1a3a",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"action\":\"document by submission of\",\"actor\":\"\",\"alternative_quotes\":[\"Court orders or decrees:\\n\\n(a) Name change orders; or\\n\\n(b) Divorce decrees\",\"Certificates of naturalization\",\"Marriage certificates\",\"Documentation demonstrating change of name by operation of state law\",\"Documentation of customary usage\"],\"choice_text\":\"One or more of: (1) Court orders or decrees (either name change orders or divorce decrees); (2) Certificates of naturalization; (3) Marriage certificates; (4) Documentation demonstrating change of name by operation of state law; or (5) Documentation of customary usage.\",\"claimants\":[],\"concepts\":[{\"definition\":\"Submission of acceptable documentation to substantiate a material name discrepancy.\",\"label\":\"Documenting Material Name Change\",\"quote\":\"Material discrepancies between the name recorded on the application, the applicant's evidence of U.S. citizenship/non-citizen U.S. nationality, or the evidence of identity must be documented by submission of one or more of the documents listed in this section\",\"role\":\"rkaf:assignmentPrimary\"}],\"effective_periods\":[],\"jurisdiction\":\"\",\"kind\":\"requirement\",\"logic_text\":\"one or more of the documents listed in this section\",\"modality\":\"must\",\"object\":\"Material discrepancies between the name recorded on the application, the applicant's evidence of U.S. citizenship/non-citizen U.S. nationality, or the evidence of identity\",\"scope_text\":\"\",\"summary\":\"Material discrepancies between the name recorded on the application, the applicant's evidence of U.S. citizenship/non-citizen U.S. nationality, or the evidence of identity must be documented by submitting one or more acceptable documents listed (court orders/decrees including name change orders or divorce decrees, certificates of naturalization, marriage certificates, documentation demonstrating change of name by operation of state law, or documentation of customary usage), subject to an exception for married names in 8 FAM 403.1-4(C).\",\"typed_values\":[]}",
        "@type": "xsd:string"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

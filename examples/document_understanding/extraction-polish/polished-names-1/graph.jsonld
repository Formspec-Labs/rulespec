cument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:1535:1555:sha256-f30948c1391413dbd020413d43f1b7b59b62e70ac5ce9b7e9645b2071eca38f1\",\"quote\":\"evidence of identity\",\"start\":1535},{\"end\":1573,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:1556:1573:sha256-23b7ce9c2f762c5aab6a810c2ffd1824264172e3c93524a804abbcd2520b8ad9\",\"quote\":\"might be required\",\"start\":1556},{\"end\":1533,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:1512:1533:sha256-6cf702f4e92e097cf8bbab9fa673fb53b79d88896129da354cbfd0d83013e3d2\",\"quote\":\"under 22 CFR 51.23(c)\",\"start\":1512},{\"end\":1510,\"field\":\"scope_text:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:1436:1510:sha256-4a797c5b206961d4b458c4a790c9df4533a92744b2c205c48cc7a030ca1c2519\",\"quote\":\"The applicant's name is an integral part of her/his identity. Consequently\",\"start\":1436}],\"id\":\"urn:rulespec:document-understanding:revision:affb301a68eb1ce142e621b7e1a233ff8208f8fc42f2753bf8c5e4ce6eada689\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"statement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:54b26b0e04519fc21b79a07caa0bfcd8a4284e2389b03c2172216ea1d3cb46a8\",\"modality\":\"possible\",\"modality_quote\":\"might be required\",\"object\":\"evidence of identity\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:b8b8cb5928a736421f1d27f63a0cd68c967f94fb8339638fdcf6f07f878cc350\",\"origin\":\"aiSuggested\",\"quote\":\"evidence of identity might be required in accordance with Department guidance to establish the name that best identifies t
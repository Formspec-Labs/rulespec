urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:1843:1846:sha256-bb0347a468d97e98a9c00e37cebec1ab930f6f1221cae0f1fbb92b07e1900ba2\",\"quote\":\"you\",\"start\":1843},{\"end\":1919,\"field\":\"action\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:1852:1919:sha256-ea99bf39ccaa8fae843da272796bf5c6af6afe0a8217cb7187bca4b22db9c98e\",\"quote\":\"suspend the application to request an acceptable ID in the new name\",\"start\":1852},{\"end\":1875,\"field\":\"object\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:1860:1875:sha256-59b33147eed775afbd220ad5c1d10dfd17c401cb664c3c05a2e877c208d45bfb\",\"quote\":\"the application\",\"start\":1860},{\"end\":1851,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:1847:1851:sha256-4137b01e139589b7a1d3b3fc4da031d8ce5bb415808734e970c3a58ea0e98f0f\",\"quote\":\"must\",\"start\":1847},{\"end\":1841,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:1676:1841:sha256-8d6e9a2e653ca62614166aac8953994fa3ed5eaadb3fe7d2c0dd5978ab49c209\",\"quote\":\"If the applicant has had a material name change more than one year prior to applying on form DS-11 but has not updated her/his ID to reflect the material name change\",\"start\":1676},{\"end\":1774,\"field\":\"typed_values:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:1724:1774:sha256-43e59de37518acf791cdec24febe5d82bfc02883339b2858f4a7b7b6f9f78b1f\",\"quote\":\"more than one year prior to applying on form DS-11\",\"start\":1724}],\"id\":\"urn:rulespec:document-understanding:revision:e716868b68a99d7de686ddc64aff2cca6512daf930b832a19382b19234b81c26\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"If ... but\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:370b88d682c34440620f67828025eda96ba2f757151072760aa09935c9aa24e9\",\"modality\":\"must\",\"modality_quote\":\"must\",\"object\":\"the application\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:115552ef089fa782e16e6334a9c00261fa2a9356535119b22aefa6a4191c9fca\",\"origin\":\"aiSuggested\",\"quote\":\"If the applicant has had a material name change more than one year prior to applying on form DS-11 but has not updated her/his ID to reflect the material name change, you must suspend the application to request an acceptable ID in the new name.\",\"references\":[\"form DS-11\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:690f5457487b542cb211fa1c4f11410d575169b9eb8ad5359bc607454906fd88\",\"scope_quotes\":[\"If the applicant has had a material name change more than one year prior to applying on form DS-11 but has not updated her/his ID to reflect the material name change\"],\"scope_text\":\"If the applicant had a material name change more than one year before applying on form DS-11 and has not updated her/his ID to reflect the change.\",\"section_id\":\"fam-names-section-4\",\"start\":1676,\"summary\":\"If the applicant has had a material name change more than one year prior to applying on form DS-11 but has not updated her/his ID to reflect the material name change, the adjudicator must suspend the application to request an acceptable ID in the new name.\",\"target_ids\":[],\"typed_values\":[{\"anchor\":\"applying on form DS-11\",\"comparator\":\"more than\",\"datatype\":\"xsd:duration\",\"name\":\"Time elapsed since material name change\",\"quote\":\"mo
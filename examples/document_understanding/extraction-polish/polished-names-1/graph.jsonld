    {
      "@id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:413:1075:sha256-660d269ce0e0ee226093dd3c78c292d98b7ef7de1af61f8431adecf82778afc6",
      "@type": "rkaf:SourceFragment",
      "oa:hasSource": "urn:rulespec:document-understanding:document:aa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc",
      "rkaf:fragmentIdentityScheme": "rkaf:carrier-local-fragment",
      "rkaf:sourceArtifactDigest": "sha256:aa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc",
      "rkaf:fragmentContentDigest": "sha256:660d269ce0e0ee226093dd3c78c292d98b7ef7de1af61f8431adecf82778afc6",
      "rkaf:selectorKind": [
        "oa:TextQuoteSelector",
        "oa:TextPositionSelector"
      ],
      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "Material discrepancies between the name recorded on the application, the applicant's evidence of U.S. citizenship/non-citizen U.S. nationality, or the evidence of identity must be documented by submission of one or more of the documents listed in this section (see an exception for married names in 8 FAM 403.1-4(C)). Acceptable means of documenting a material name change include (per 22 CFR 51.25):\n\n(1) Court orders or decrees:\n\n(a) Name change orders; or\n\n(b) Divorce decrees;\n\n(2) Certificates of naturalization;\n\n(3) Marriage certificates;\n\n(4) Documentation demonstrating change of name by operation of state law; or\n\n(5) Documentation of customary usage."
        },
        {
          "@type": "oa:TextPositionSelector",
          "oa:start": 413,
          "oa:end": 1075,
          "rkaf:coordinateSystem": "rkaf:unicode-codepoint"
        }
      ]
    },

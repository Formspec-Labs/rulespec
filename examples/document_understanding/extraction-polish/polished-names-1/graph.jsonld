      "dcterms:description": "{\"action\":\"document by submission of\",\"actor\":\"\",\"alternative_quotes\":[\"Court orders or decrees:\\n\\n(a) Name change orders; or\\n\\n(b) Divorce decrees\",\"Certificates of naturalization\",\"Marriage certificates\",\"Documentation demonstrating change of name by operation of state law\",\"Documentation of customary usage\"],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:19c6135715ec1295eba5ce8c33f2481a7865e1765406146eb659be036f241ce2\",\"urn:rulespec:document-understanding:assertion:16ee41ebedf7fc7b4a567b6ff2b7179e2b1bd08b30a6543bcce040a33bd5381d\",\"urn:rulespec:document-understanding:assertion:88c9b35fedd19e2e10778f261c6664852eba42c3b1fc1fc066799bf918be0865\",\"urn:rulespec:document-understanding:assertion:031159b9cbb9e8daa249a8d8c41d2545261226201bbd4c832ceb6ed7fab74364\",\"urn:rulespec:document-understanding:assertion:62d777c9291745d8c29d121efab8a9689031b3c82b61902d38db148eb3cec806\",\"urn:rulespec:document-understanding:assertion:7ccc3a976367d8334d2449c9d65d32e942cd97910955f4536fb2715a8c4c8f2e\",\"urn:rulespec:document-understanding:assertion:2ebf5517ea4232ee1c19e1d9af0dd824ac165a9c18c80d42f855d9549179ae4a\",\"urn:rulespec:document-understanding:assertion:b5b2a64ae630af19626028223010c303e29fb334a6105ba49d39676e81b5640f\",\"urn:rulespec:document-understanding:assertion:17f6f40a89ea4a4160b29ee5449408c26068ff7aa84135d494173c7f0d6a55ca\",\"urn:rulespec:document-understanding:assertion:a34d47fc6856257b04e808dec4f5dc97c361c0ec610cd5fc8a465e8e1d499ddc\",\"urn:rulespec:document-understanding:assertion:7af1db934d676284d2c5e6cdf73fb1b2133f07db3c85e7f8c97a4f6bcaca7a10\",\"urn:rulespec:document-understanding:assertion:b6f0ee7ecc4e335d4fd439e16aa4b77e5f45e6f86dfb5a6f7a4996616e2908ec\",\"urn:rulespec:document-understanding:assertion:35d4c42ee44ae0d19c295e6e39fdf135609d656c19497d36d0baf5444f6e5502\"],\"choice_quote\":\"submission of one or more of the documents listed in this section\",\"choice_text\":\"One or more of: (1) Court orders or decrees (either name change orders or divorce decrees); (2) Certificates of naturalization; (3) Marriage certificates; (4) Documentation demonstrating change of name by operation of state law; or (5) Documentation of customary usage.\",\"claimants\":[],\"concepts\":[{\"definition\":\"Submission of acceptable documentation to substantiate a material name discrepancy.\",\"label\":\"Documenting Material Name Change\",\"quote\":\"Material discrepancies between the name recorded on the application, the applicant's evidence of U.S. citizenship/non-citizen U.S. nationality, or the evidence of identity must be documented by submission of one or more of the documents listed in this section\",\"role\":\"rkaf:assignmentPrimary\"}],\"context_quotes\":[\"see an exception for married names in 8 FAM 403.1-4(C)\"],\"effective_periods\":[],\"end\":1075,\"evidence\":[{\"end\":1075,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:413:1075:sha256-660d269ce0e0ee226093dd3c78c292d98b7ef7de1af61f8431adecf82778afc6\",\"quote\":\"Material discrepancies between the name recorded on the application, the applicant's evidence of U.S. citizenship/non-citizen U.S. nationality, or the evidence of identity must be documented by submission of one or more of the documents listed in this section (see an exception for married names in 8 FAM 403.1-4(C)). Acceptable means of documenting a material name change include (per 22 CFR 51.25):\\n\\n(1) Court orders or decrees:\\n\\n(a) Name change orders; or\\n\\n(b) Divorce decrees;\\n\\n(2) Certificates of naturalization;\\n\\n(3) Marriage certificates;\\n\\n(4) Documentation demonstrating change of name by operation of state law; or\\n\\n(5) Documentation of customary usage.\",\"start\":413},{\"end\":620,\"field\":\"action\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:590:620:sha256-430609b8605456f3da603afa2a00e1f7ff34e7a7e010b169a0206f68f7671a4a\",\"quote\":\"be documented by submission of\",\"start\":590},{\"end\":584,\"field\":\"object\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:413:584:sha256-cb40404d70d90218b38e38b5d38aea0168c012097c2d557a928d6edea4eed5fa\",\"quote\":\"Material discrepancies between the name recorded on the application, the applicant's evidence of U.S. citizenship/non-citizen U.S. nationality, or the evidence of identity\",\"start\":413},{\"end\":672,\"field\":\"logic_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:621:672:sha256-2c50430030c55b2d21562547c684ecb83fc27784c220f6516ba9f50097010a5f\",\"quote\":\"one or more of the documents listed in this section\",\"start\":621},{\"end\":589,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:585:589:sha256-4137b01e139589b7a1d3b3fc4da031d8ce5bb415808734e970c3a58ea0e98f0f\",\"quote\":\"must\",\"start\":585},{\"end\":672,\"field\":\"choice_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:607:672:sha256-716fe3071f83e27c5129bb8490a4eec273130dae64fe9ec05642b35b05db925f\",\"quote\":\"submission of one or more of the documents listed in this section\",\"start\":607},{\"end\":728,\"field\":\"context:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:674:728:sha256-9e03fd200b337bebc3d105ef9acb5ddee2492a3a992ddb908eb3ac0b490b4081\",\"quote\":\"see an exception for married names in 8 FAM 403.1-4(C)\",\"start\":674},{\"end\":892,\"field\":\"alternative:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:819:892:sha256-35ff2468c1e25922663de880710dc9befba2736d3b6ca6cc948bfb53837f39fc\",\"quote\":\"Court orders or decrees:\\n\\n(a) Name change orders; or\\n\\n(b) Divorce decrees\",\"start\":819},{\"end\":929,\"field\":\"alternative:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:899:929:sha256-75acae92255c297a5b5868c038abbe72852ff99f836ed5e20419d019c53f49be\",\"quote\":\"Certificates of naturalization\",\"start\":899},{\"end\":957,\"field\":\"alternative:2\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:936:957:sha256-36f88b64f1d528d6f66a1f189a318b4633f775d520c04c542ee7257308a41fbc\",\"quote\":\"Marriage certificates\",\"start\":936},{\"end\":1032,\"field\":\"alternative:3\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:964:1032:sha256-00a3c0e73f512fbed0328495aedd36c48d634ec4667d916b58232f13617f07d8\",\"quote\":\"Documentation demonstrating change of name by operation of state law\",\"start\":964},{\"end\":1074,\"field\":\"alternative:4\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:1042:1074:sha256-fe45e8bfc73a398c1816bfecfffba0af143f5d8cb3f3036ebf315d69fef0a0ad\",\"quote\":\"Documentation of customary usage\",\"start\":1042},{\"end\":672,\"field\":\"concepts:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:413:672:sha256-84298e15183360c687736bacb2d6f53628d57494d92acc4f8f3330aa3b6bb500\",\"quote\":\"Material discrepancies between the name recorded on the application, the applicant's evidence of U.S. citizenship/non-citizen U.S. nationality, or the evidence of identity must be documented by submission of one or more of the documents listed in this section\",\"start\":413}],\"id\":\"urn:rulespec:document-understanding:revision:546934c77ed54a296f4710c64e17a671b5196479d689c2742f2271f8b8e5a26e\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"one or more of the documents listed in this section\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:b6f0ee7ecc4e335d4fd439e16aa4b77e5f45e6f86dfb5a6f7a4996616e2908ec\",\"modality\":\"must\",\"modality_quote\":\"must\",\"object\":\"Material discrepancies between the name recorded on the application, the applicant's evidence of U.S. citizenship/non-citizen U.S. nationality, or the evidence of identity\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:dd68b85e499c09d3dc5ec9ca3db37250ce25e1b57ab750b5437b63ae2a871144\",\"origin\":\"aiSuggested\",\"quote\":\"Material discrepancies between the name recorded on the application, the applicant's evidence of U.S. citizenship/non-citizen U.S. nationality, or the evidence of identity must be documented by submission of one or more of the documents listed in this section (see an exception for married names in 8 FAM 403.1-4(C)). Acceptable means of documenting a material name change include (per 22 CFR 51.25):\\n\\n(1) Court orders or decrees:\\n\\n(a) Name change orders; or\\n\\n(b) Divorce decrees;\\n\\n(2) Certificates of naturalization;\\n\\n(3) Marriage certificates;\\n\\n(4) Documentation demonstrating change of name by operation of state law; or\\n\\n(5) Documentation of customary usage.\",\"references\":[\"8 FAM 403.1-4(C)\",\"22 CFR 51.25\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:4c44870fb1b891b6d47bf3a84b910e9b2c7ced89cd4a4c2b2de1992dd21f1a3a\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"fam-names-section-4\",\"start\":413,\"summary\":\"Material discrepancies between the name recorded on the application, the applicant's evidence of U.S. citizenship/non-citizen U.S. nationality, or the evidence of identity must be documented by submitting one or more acceptable documents listed (court orders/decrees including name change orders or divorce decrees, certificates of naturalization, marriage certificates, documentation demonstrating change of name by operation of state law, or documentation of customary usage), subject to an exception for married names in 8 FAM 403.1-4(C).\",\"target_ids\":[],\"typed_values\":[]}",

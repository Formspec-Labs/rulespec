      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"action\":\"submit\",\"actor\":\"they\",\"alternative_quotes\":[],\"choice_text\":\"\",\"claimants\":[],\"concepts\":[{\"definition\":\"Requirement for applicants within one year of a material name change whose ID has not yet been changed to submit name change documentation.\",\"label\":\"Requirement to Submit Name Change Documentation\",\"quote\":\"Applicants who have had a material name change within one year of applying on a form DS-11 do not need to submit ID in the new name. However, if the ID has not yet been changed, they must submit their name change documentation.\",\"role\":\"rkaf:assignmentPrimary\"}],\"effective_periods\":[],\"jurisdiction\":\"\",\"kind\":\"requirement\",\"logic_text\":\"if\",\"modality\":\"must\",\"object\":\"their name change documentation\",\"scope_text\":\"Applies to applicants who have had a material name change within one year of applying on Form DS-11, if their ID has not yet been changed.\",\"summary\":\"If applicants who have had a material name change within one year of applying on Form DS-11 have not yet changed their ID, they must submit their name change documentation.\",\"typed_values\":[]}",
        "@type": "xsd:string"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed",
      "rkaf:hasApplicability": "urn:rulespec:document-understanding:scope:a5a526208a2a6ff39e2e8c98e4a21858eef91a83357406dafc510038dbaeffab"
    },

    {
      "@id": "urn:rulespec:document-understanding:concept:c06612fd7b90d1a647234f12174f7896c357d8f25de059ffe7046fc85a89ffb6",
      "@type": "rkaf:LocalConcept",
      "skos:prefLabel": {
        "en": "Limited-Validity Passport Issuance for Urgent Travel"
      },
      "skos:definition": {
        "en": "Permission to issue a limited-validity passport in the requested name when travel is urgent or an emergency and time precludes requesting acceptable updated ID."
      },
      "skos:inScheme": "urn:rulespec:document-understanding:concept-scheme:aa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc",
      "rkaf:definedInScope": "urn:rulespec:document-understanding:document:aa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc",
      "rkaf:conceptScope": "Permission to issue a limited-validity passport in the requested name when travel is urgent or an emergency and time precludes requesting acceptable updated ID."
    },

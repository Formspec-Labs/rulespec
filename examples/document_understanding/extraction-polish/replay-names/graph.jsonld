      "dcterms:description": "{\"action\":\"be issued in the requested name\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:69d862c58fb3778f6b57324ce60c12f05641be122df6cd320b4721745ece21e3\",\"urn:rulespec:document-understanding:assertion:2e5941fc95154930645f64ab0e4ea58fe17c0fdf5e334d24ed6eed45fa2b110d\",\"urn:rulespec:document-understanding:assertion:575f12b57e85fa88f2668d2ebcfdc74c8edd07f9e14b78b5cd6bd00139b3f005\",\"urn:rulespec:document-understanding:assertion:780d2afbb199e44a96b042231020bd67a5fdb02a58287d4605b86f3683b2d390\",\"urn:rulespec:document-understanding:assertion:80967d1775c9e22c70e9866d40820e499b274448707ab4b15fcb77d56be09b08\",\"urn:rulespec:document-understanding:assertion:0945fa713d5ae57f73108ad7539de9c2e2508dc4146af58a38ba89eb95529841\",\"urn:rulespec:document-understanding:assertion:1f1c9f5ec9fff8767d32c3b938132bde4b071a5fa154919bce3fb482204bc277\",\"urn:rulespec:document-understanding:assertion:96cf86a7f145ea25bc28e10672d412fd1a8aec5f5ddb753366b25917863ce963\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[{\"definition\":\"Permission to issue a limited-validity passport in the requested name when travel is urgent or an emergency and time precludes requesting acceptable updated ID.\",\"label\":\"Limited-Validity Passport Issuance for Urgent Travel\",\"quote\":\"If there is insufficient time to request that the applicant submit acceptable ID prior to urgent or emergency travel, a limited-validity passport may be issued in the requested name;\",\"role\":\"rkaf:assignmentPrimary\"}],\"context_quotes\":[],\"effective_periods\":[],\"end\":2103,\"evidence\":[{\"end\":2103,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:1921:2103:sha256-0fdbf8386267c11baca8f4259546dc39828a560aa3cc96c2b0d436c3602b72a9\",\"quote\":\"If there is insufficient time to request that the applicant submit acceptable ID prior to urgent or emergency travel, a limited-validity passport may be issued in the requested name;\",\"start\":1921},{\"end\":2080,\"field\":\"action\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:2071:2080:sha256-ed10f5396e75d899b20e9ced304978e02860db2e9659c5231242cd859a40580f\",\"quote\":\"be issued\",\"start\":2071},{\"end\":2066,\"field\":\"object\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:2039:2066:sha256-7c5242f452273d58b648473e49efef79268657cee618c30d4574f93e3a075b57\",\"quote\":\"a limited-validity passport\",\"start\":2039},{\"end\":1923,\"field\":\"logic_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:1921:1923:sha256-1e3abf61a37e3cad36b11b459b1cc39e76feb6a0c369fe5270957468288dcc5c\",\"quote\":\"If\",\"start\":1921},{\"end\":2070,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:2067:2070:sha256-ee4d988c65de860fabbfbcd27f73d50bbebe3fba37fe419284f4811389c30bdc\",\"quote\":\"may\",\"start\":2067},{\"end\":1841,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:1676:1841:sha256-8d6e9a2e653ca62614166aac8953994fa3ed5eaadb3fe7d2c0dd5978ab49c209\",\"quote\":\"If the applicant has had a material name change more than one year prior to applying on form DS-11 but has not updated her/his ID to reflect the material name change\",\"start\":1676},{\"end\":2037,\"field\":\"scope_text:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:1921:2037:sha256-69672abdd23b79c9ab53977f6c04fc575dfcf5ce9f86af983bd20b44baa19026\",\"quote\":\"If there is insufficient time to request that the applicant submit acceptable ID prior to urgent or emergency travel\",\"start\":1921},{\"end\":2103,\"field\":\"concepts:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:1921:2103:sha256-0fdbf8386267c11baca8f4259546dc39828a560aa3cc96c2b0d436c3602b72a9\",\"quote\":\"If there is insufficient time to request that the applicant submit acceptable ID prior to urgent or emergency travel, a limited-validity passport may be issued in the requested name;\",\"start\":1921}],\"id\":\"urn:rulespec:document-understanding:revision:e474e3af4719b6940a388344b085b566b2875b938dd8f6345b883838da14899e\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"permission\",\"logic_text\":\"If\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:1f1c9f5ec9fff8767d32c3b938132bde4b071a5fa154919bce3fb482204bc277\",\"modality\":\"may\",\"modality_quote\":\"may\",\"object\":\"a limited-validity passport\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:7dd4e9c64579b9e2d97d5282f70a0cc8cc8d6177f440029d25eb8208cdceff99\",\"origin\":\"aiSuggested\",\"quote\":\"If there is insufficient time to request that the applicant submit acceptable ID prior to urgent or emergency travel, a limited-validity passport may be issued in the requested name;\",\"references\":[\"DS-11\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:00b48de56b403dfe88b13dd41b8fb004e0f6936feb0d627493b1f6d1139f3509\",\"scope_quotes\":[\"If the applicant has had a material name change more than one year prior to applying on form DS-11 but has not updated her/his ID to reflect the material name change\",\"If there is insufficient time to request that the applicant submit acceptable ID prior to urgent or emergency travel\"],\"scope_text\":\"If the applicant has had a material name change more than one year prior to applying on form DS-11 but has not updated their ID, and there is insufficient time to request that the applicant submit acceptable ID prior to urgent or emergency travel.\",\"section_id\":\"fam-names-section-4\",\"start\":1921,\"summary\":\"If an applicant had a material name change more than one year prior to applying on Form DS-11 without updating ID, but there is insufficient time to request acceptable ID prior to urgent or emergency travel, a limited-validity passport may be issued in the requested name.\",\"target_ids\":[],\"typed_values\":[]}",

      "dcterms:description": "{\"action\":\"submit\",\"actor\":\"they\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:782e6a0fafbe52eacc4221dc5f15f590dfabe4c7ebf6178e38c57e8982377f9d\",\"urn:rulespec:document-understanding:assertion:9d7f3f9b7892916052e5c068fc23817681185e09f1ac1fd29d8ca5b9fa14682a\",\"urn:rulespec:document-understanding:assertion:dfc3e2cdf374f36821bc0e2669e5255e87bd9f85b76d4236ed3399c12c9011e3\",\"urn:rulespec:document-understanding:assertion:28c9a66959b71954fcb7277c4aae819cc3b04bf53f2053ca5f94b420166c9b39\",\"urn:rulespec:document-understanding:assertion:86224b4d594664ccc5be9a24035c73588d87eaba1551f3d8e923b4101e00417b\",\"urn:rulespec:document-understanding:assertion:d35ad5dcd830a90eb1758775bb85478fa4b7f91304e4a2f44b66da723074abb7\",\"urn:rulespec:document-understanding:assertion:1d342bf32554ce12b770d1be26315deed36d630938fa2d04c5c732286f8ac5dd\",\"urn:rulespec:document-understanding:assertion:093ea3db0377391f20530e73152d748662c195a3a8fc179b27e3398d938742dd\",\"urn:rulespec:document-understanding:assertion:d7df38ee0a94183f1a392dcb8ddce0306a3e3a161d15c3df9578f62130ea0ccb\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[{\"definition\":\"Requirement for applicants within one year of a material name change whose ID has not yet been changed to submit name change documentation.\",\"label\":\"Requirement to Submit Name Change Documentation\",\"quote\":\"Applicants who have had a material name change within one year of applying on a form DS-11 do not need to submit ID in the new name. However, if the ID has not yet been changed, they must submit their name change documentation.\",\"role\":\"rkaf:assignmentPrimary\"}],\"context_quotes\":[],\"effective_periods\":[],\"end\":2651,\"evidence\":[{\"end\":2651,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:2557:2651:sha256-b3e08f19ac8e2217ab0989dd3305951e67b008f16213fc1bc92d670f02febedd\",\"quote\":\"However, if the ID has not yet been changed, they must submit their name change documentation.\",\"start\":2557},{\"end\":2606,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:2602:2606:sha256-151e58a831306903b282edb477bb6c4b713887cdd2b0353c84aff6f43da8e95d\",\"quote\":\"they\",\"start\":2602},{\"end\":2618,\"field\":\"action\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:2612:2618:sha256-75490bd7b93e6fa7d18cfdea90cc6bcb983d5f3ea326249d2709ca6c94bc07ba\",\"quote\":\"submit\",\"start\":2612},{\"end\":2650,\"field\":\"object\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:2619:2650:sha256-224a6df778a819adadb0258079a93cc04d75a37ed839d512315d50b89f388cde\",\"quote\":\"their name change documentation\",\"start\":2619},{\"end\":2568,\"field\":\"logic_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:2566:2568:sha256-935f68319d4f227e02bfd54a0ddf85b8a242e42a4277aa5ef5eaab691710924e\",\"quote\":\"if\",\"start\":2566},{\"end\":2611,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:2607:2611:sha256-4137b01e139589b7a1d3b3fc4da031d8ce5bb415808734e970c3a58ea0e98f0f\",\"quote\":\"must\",\"start\":2607},{\"end\":2514,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:2424:2514:sha256-b8f01ff16cc26a6fab1c602d489e77c4c8999e2cc6f0a6ab138f7b589cb7ed6f\",\"quote\":\"Applicants who have had a material name change within one year of applying on a form DS-11\",\"start\":2424},{\"end\":2600,\"field\":\"scope_text:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:2566:2600:sha256-ca00d2b7e7bd4b54e1a8aa4a5b34000fbc725517113a7656966a4be9a73e5a86\",\"quote\":\"if the ID has not yet been changed\",\"start\":2566},{\"end\":2651,\"field\":\"concepts:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:2424:2651:sha256-8177749dd347e3246a1f58936407af29460d5561d32460602921fdc5399c9702\",\"quote\":\"Applicants who have had a material name change within one year of applying on a form DS-11 do not need to submit ID in the new name. However, if the ID has not yet been changed, they must submit their name change documentation.\",\"start\":2424}],\"id\":\"urn:rulespec:document-understanding:revision:afcd23de3e1d856374d4da8ed251bc0c2ee0314e8dfbe007b17248971809f46a\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"if\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:093ea3db0377391f20530e73152d748662c195a3a8fc179b27e3398d938742dd\",\"modality\":\"must\",\"modality_quote\":\"must\",\"object\":\"their name change documentation\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:cb5f7341e6a776d6abca5345f831869ae6660d1803e83ff0464f8ba514553dc4\",\"origin\":\"aiSuggested\",\"quote\":\"However, if the ID has not yet been changed, they must submit their name change documentation.\",\"references\":[\"DS-11\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:1f41cf4f9ea137bbb8ec58a0d9be91c92a5d00ab925e44f37242f0ffef5780ff\",\"scope_quotes\":[\"Applicants who have had a material name change within one year of applying on a form DS-11\",\"if the ID has not yet been changed\"],\"scope_text\":\"Applies to applicants who have had a material name change within one year of applying on Form DS-11, if their ID has not yet been changed.\",\"section_id\":\"fam-names-section-4\",\"start\":2557,\"summary\":\"If applicants who have had a material name change within one year of applying on Form DS-11 have not yet changed their ID, they must submit their name change documentation.\",\"target_ids\":[],\"typed_values\":[]}",

      "dcterms:description": "{\"action\":\"suspend the application to request an acceptable ID in the new name\",\"actor\":\"you\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:32154d276fddb9bad1cd2048fd1a5b3c02bceec737d5b1b1e77e18ceb11b6188\",\"urn:rulespec:document-understanding:assertion:52dda3770d0475d012afc925bc02315af127f3d8cc969a21b9d93d47ba3a2b68\",\"urn:rulespec:document-understanding:assertion:76f10dc09febbdabee2038541678bb95f0ef6e54ea6cc81b1983909020d66e34\",\"urn:rulespec:document-understanding:assertion:dac5273758ad801bbaa7f384cd8a4a382c083c572f03a239b9301cb96756e447\",\"urn:rulespec:document-understanding:assertion:fbb57de8c82de320f98028bee174e376aede3556bd38ccb6157650ce6771b16b\",\"urn:rulespec:document-understanding:assertion:bd3ccc25679c8a191d9133ca5a3912bb6426e9df7fb619cb0a43074428b90985\",\"urn:rulespec:document-understanding:assertion:eada9ff48b327a7350e6dbdf0322899d975a2b9bbff9523ef64fc83f6ed52885\",\"urn:rulespec:document-understanding:assertion:1805461cc1067760569c13183ec7bc0bb1e3dff23e263c6430da28cc32f9de2b\",\"urn:rulespec:document-understanding:assertion:49cc58f805e4b1aa007f7d41147455d8dfdc2707d9710c8d2fc7d8b4815ffc4e\",\"urn:rulespec:document-understanding:assertion:c3f406c80621904f60a6cecb1c5f00aaab870919ccf2c57aaa2fc7d9df15092b\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[{\"definition\":\"Mandate to suspend an application when an applicant has had a material name change over a year prior to applying on Form DS-11 without updating ID.\",\"label\":\"Suspension for Un-updated ID After Material Name Change\",\"quote\":\"If the applicant has had a material name change more than one year prior to applying on form DS-11 but has not updated her/his ID to reflect the material name change, you must suspend the application to request an acceptable ID in the new name.\",\"role\":\"rkaf:assignmentPrimary\"}],\"context_quotes\":[],\"effective_periods\":[],\"end\":1920,\"evidence\":[{\"end\":1920,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:1676:1920:sha256-2565638f681c03203d7355f09b257b887e0cb9925bad1611c09720d91cf3dd00\",\"quote\":\"If the applicant has had a material name change more than one year prior to applying on form DS-11 but has not updated her/his ID to reflect the material name change, you must suspend the application to request an acceptable ID in the new name.\",\"start\":1676},{\"end\":1846,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:1843:1846:sha256-bb0347a468d97e98a9c00e37cebec1ab930f6f1221cae0f1fbb92b07e1900ba2\",\"quote\":\"you\",\"start\":1843},{\"end\":1859,\"field\":\"action\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:1852:1859:sha256-f516e6c26493093647485274a45fd4a485a04632be8924c2769f885ee58f9da8\",\"quote\":\"suspend\",\"start\":1852},{\"end\":1875,\"field\":\"object\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:1860:1875:sha256-59b33147eed775afbd220ad5c1d10dfd17c401cb664c3c05a2e877c208d45bfb\",\"quote\":\"the application\",\"start\":1860},{\"end\":1851,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:1847:1851:sha256-4137b01e139589b7a1d3b3fc4da031d8ce5bb415808734e970c3a58ea0e98f0f\",\"quote\":\"must\",\"start\":1847},{\"end\":1841,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:1676:1841:sha256-8d6e9a2e653ca62614166aac8953994fa3ed5eaadb3fe7d2c0dd5978ab49c209\",\"quote\":\"If the applicant has had a material name change more than one year prior to applying on form DS-11 but has not updated her/his ID to reflect the material name change\",\"start\":1676},{\"end\":1920,\"field\":\"concepts:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:1676:1920:sha256-2565638f681c03203d7355f09b257b887e0cb9925bad1611c09720d91cf3dd00\",\"quote\":\"If the applicant has had a material name change more than one year prior to applying on form DS-11 but has not updated her/his ID to reflect the material name change, you must suspend the application to request an acceptable ID in the new name.\",\"start\":1676},{\"end\":1774,\"field\":\"typed_values:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:1724:1774:sha256-43e59de37518acf791cdec24febe5d82bfc02883339b2858f4a7b7b6f9f78b1f\",\"quote\":\"more than one year prior to applying on form DS-11\",\"start\":1724}],\"id\":\"urn:rulespec:document-understanding:revision:6b1c2aafc46894ea55cd16bbb424837ee19257b4b07d3bda2d5276c05a656dc8\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"If ... but\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:1805461cc1067760569c13183ec7bc0bb1e3dff23e263c6430da28cc32f9de2b\",\"modality\":\"must\",\"modality_quote\":\"must\",\"object\":\"the application\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:33a3db51526a6187b8b87209052981ceb70717fb40eaffcd5d3e1636b4273424\",\"origin\":\"aiSuggested\",\"quote\":\"If the applicant has had a material name change more than one year prior to applying on form DS-11 but has not updated her/his ID to reflect the material name change, you must suspend the application to request an acceptable ID in the new name.\",\"references\":[\"DS-11\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:b786f38edb1adc99ff4e0a3ffe5b74b2e3b0774f85fceadf1423152d264202da\",\"scope_quotes\":[\"If the applicant has had a material name change more than one year prior to applying on form DS-11 but has not updated her/his ID to reflect the material name change\"],\"scope_text\":\"If the applicant has had a material name change more than one year prior to applying on form DS-11 but has not updated her/his ID to reflect the material name change.\",\"section_id\":\"fam-names-section-4\",\"start\":1676,\"summary\":\"If an applicant had a material name change more than one year prior to applying on Form DS-11 but has not updated their ID to reflect the name change, you must suspend the application to request an acceptable ID in the new name.\",\"target_ids\":[],\"typed_values\":[{\"anchor\":\"applying on form DS-11\",\"comparator\":\"more than\",\"datatype\":\"xsd:duration\",\"name\":\"Time elapsed since material name change\",\"quote\":\"more than one year prior to applying on form DS-11\",\"unit\":\"year\",\"value\":\"P1Y\"}]}",

      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:b410b3d6f621663725751ca74f1698be39a7b8e8b5f329dc9238ba628f388c5f",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:93b5801036df3605998815907f12217c82fc52152504136d8408babaf4eadc20",

      "dcterms:description": "{\"action\":\"fully notate\",\"actor\":\"You\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:9860732a71f9135eaa312314870d12a520b0f78597936cbb1ae649340cae52a1\",\"urn:rulespec:document-understanding:assertion:193f3e59d818bc67da8428cb61086698669f6126de2b686bb2e2f42f7bbdc8c5\",\"urn:rulespec:document-understanding:assertion:8e9d35de49a50061e9cff2c62d7ecdc31d849a5d68135657446b1241091f343c\",\"urn:rulespec:document-understanding:assertion:a32df0c1f346655f7f4081a1d1d1df874140fe66d1dc12e3cb8223d5120a78ef\",\"urn:rulespec:document-understanding:assertion:2343866640e407190a2889a5b48c3c76ac5b198fd757b68bd7ddc86b2e3ec286\",\"urn:rulespec:document-understanding:assertion:010f146b28f1cedd5bc60e3e245ce91f0b13e3aa662f69051953f4a3301cedb7\",\"urn:rulespec:document-understanding:assertion:756976e50ebdd9985bb3c29f702a41e0aba11c04a49afdb4097e2fdd6661541d\",\"urn:rulespec:document-understanding:assertion:491c53060218965b779fc553eca4dda2c14951026977ea0c9f669638f645cc89\",\"urn:rulespec:document-understanding:assertion:9e9d603b7429d7defc051106398f24736e3192cbfefe02dbb9ae30dd2e3471b3\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[{\"definition\":\"Duty to fully notate name change documentation before returning it to the applicant with an IRL.\",\"label\":\"Notation of Name Change Documentation\",\"quote\":\"You must fully notate the name change documentation prior to returning the documentation, including that the documentation was \\\"seen and returned,\\\" to the applicant with the information request letter (IRL);\",\"role\":\"rkaf:assignmentPrimary\"}],\"context_quotes\":[\"The applicant generally will need the name change documentation to change the name on her/his ID.\"],\"effective_periods\":[],\"end\":2414,\"evidence\":[{\"end\":2414,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc975875
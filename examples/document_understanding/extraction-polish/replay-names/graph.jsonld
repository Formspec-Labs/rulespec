    {
      "@id": "urn:rulespec:document-understanding:assertion:d6ef63a49b157e2ae5df9bac4222344f50be63b7f6fa56bbcaa13a5f2c1f2bcb",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:b410b3d6f621663725751ca74f1698be39a7b8e8b5f329dc9238ba628f388c5f",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:93b5801036df3605998815907f12217c82fc52152504136d8408babaf4eadc20",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:7e801b274e01628182713a55c57144429d9b900169773c66a5a234d6facb2ae6",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"action\":\"be documented by submission\",\"actor\":\"\",\"alternative_quotes\":[\"Name change orders; or\",\"Divorce decrees;\",\"Certificates of naturalization;\",\"Marriage certificates;\",\"Documentation demonstrating change of name by operation of state law; or\",\"Documentation of customary usage.\"],\"choice_text\":\"One or more of: (1) Court orders or decrees (name change orders or divorce decrees); (2) Certificates of naturalization; (3) Marriage certificates; (4) Documentation demonstrating change of name by operation of state law; or (5) Documentation of customary usage.\",\"claimants\":[],\"concepts\":[{\"definition\":\"Required acceptable documentation to substantiate material discrepancies between names on application, citizenship/nationality evidence, or identity evidence.\",\"label\":\"Documentation of Material Name Discrepancies\",\"quote\":\"Material discrepancies between the name recorded on the application, the applicant's evidence of U.S. citizenship/non-citizen U.S. nationality, or the evidence of identity must be documented by submission of one or more of the documents listed in this section (see an exception for married names in 8 FAM 403.1-4(C)).\",\"role\":\"rkaf:assignmentPrimary\"}],\"effective_periods\":[],\"jurisdiction\":\"\",\"kind\":\"requirement\",\"logic_text\":\"submission of one or more of the documents listed in this section\",\"modality\":\"must\",\"object\":\"one or more of the documents listed in this section: (1) Court orders or decrees: (a) Name change orders, or (b) Divorce decrees; (2) Certificates of naturalization; (3) Marriage certificates; (4) Documentation demonstrating change of name by operation of state law; or (5) Documentation of customary usage\",\"scope_text\":\"Governed by situations where there are material discrepancies between the name recorded on the application, the applicant's evidence of U.S. citizenship/non-citizen U.S. nationality, or the evidence of identity (with an exception for married names noted in 8 FAM 403.1-4(C)).\",\"summary\":\"Material discrepancies between the name on the application, citizenship/nationality evidence, or identity evidence must be documented by submitting one or more of: (1) Court orders or decrees (name change orders or divorce decrees); (2) Certificates of naturalization; (3) Marriage certificates; (4) Documentation demonstrating change of name by operation of state law; or (5) Documentation of customary usage (noting an exception for married names in 8 FAM 403.1-4(C)).\",\"typed_values\":[]}",
        "@type": "xsd:string"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed",
      "rkaf:hasApplicability": "urn:rulespec:document-understanding:scope:7d305eb5514be90732038664b00816878627ebda4cc8ca814927728deac09d26"
    },

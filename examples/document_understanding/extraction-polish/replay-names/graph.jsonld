      "rkaf:assertsValue": {
        "@value": "{\"action\":\"submit\",\"actor\":\"Applicants who have had a material name change within one year of applying on a form DS-11\",\"alternative_quotes\":[],\"choice_text\":\"\",\"claimants\":[],\"concepts\":[{\"definition\":\"Exemption relieving applicants whose material name change was within one year of DS-11 application from submitting ID in the new name.\",\"label\":\"Exemption from New Name ID Submission\",\"quote\":\"Applicants who have had a material name change within one year of applying on a form DS-11 do not need to submit ID in the new name.\",\"role\":\"rkaf:assignmentPrimary\"}],\"effective_periods\":[],\"jurisdiction\":\"\",\"kind\":\"exemption\",\"logic_text\":\"\",\"modality\":\"not_required\",\"object\":\"ID in the new name\",\"scope_text\":\"Applies to applicants who have had a material name change within one year of applying on a form DS-11.\",\"summary\":\"Applicants who had a material name change within one year of applying on Form DS-11 are not required to submit ID in the new name.\",\"typed_values\":[{\"anchor\":\"applying on a form DS-11\",\"comparator\":\"within\",\"datatype\":\"xsd:duration\",\"name\":\"Time elapsed since material name change\",\"quote\":\"within one year of applying on a form DS-11\",\"unit\":\"year\",\"value\":\"P1Y\"}]}",

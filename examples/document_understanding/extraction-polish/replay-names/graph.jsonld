      "@type": "rkaf:ApplicabilityScope",
      "rkaf:appliesInJurisdiction": [],
      "rkaf:applicabilityCondition": "Governed by situations where there are material discrepancies between the name recorded on the application, the applicant's evidence of U.S. citizenship/non-citizen U.S. nationality, or the evidence of identity (with an exception for married names noted in 8 FAM 403.1-4(C))."
    },
    {
      "@id": "urn:rulespec:document-understanding:assertion:58fe18abdcda1d1ce15d2189368def4110ccd85c8118f4a5996a60ff0fa409cb",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:b410b3d6f621663725751ca74f1698be39a7b8e8b5f329dc9238ba628f388c5f",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:93b5801036df3605998815907f12217c82fc52152504136d8408babaf4eadc20",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:7e801b274e01628182713a55c57144429d9b900169773c66a5a234d6facb2ae6",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:states-requirement",
      "rkaf:assertsValue": {
        "@value": "Material discrepancies between the name on the application, citizenship/nationality evidence, or identity evidence must be documented by submitting one or more of: (1) Court orders or decrees (name change orders or divorce decrees); (2) Certificates of naturalization; (3) Marriage certificates; (4) Documentation demonstrating change of name by operation of state law; or (5) Documentation of customary usage (noting an exception for married names in 8 FAM 403.1-4(C)).",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

      "rkaf:assertsValue": {
        "@value": "{\"action\":\"fully notate\",\"actor\":\"You\",\"alternative_quotes\":[],\"choice_text\":\"\",\"claimants\":[],\"concepts\":[{\"definition\":\"Duty to fully notate name change documentation before returning it to the applicant with an IRL.\",\"label\":\"Notation of Name Change Documentation\",\"quote\":\"You must fully notate the name change documentation prior to returning the documentation, including that the documentation was \\\"seen and returned,\\\" to the applicant with the information request letter (IRL);\",\"role\":\"rkaf:assignmentPrimary\"}],\"effective_periods\":[],\"jurisdiction\":\"\",\"kind\":\"requirement\",\"logic_text\":\"prior to\",\"modality\":\"must\",\"object\":\"the name change documentation, including that the documentation was \\\"seen and returned,\\\"\",\"scope_text\":\"Governed by the process of returning name change documentation to the applicant with the information request letter (IRL).\",\"summary\":\"You must fully notate the name change documentation, including that it was 'seen and returned,' prior to returning the documentation to the applicant with the information request letter (IRL).\",\"typed_values\":[]}",
        "@type": "xsd:string"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed",
      "rkaf:hasApplicability": "urn:rulespec:document-understanding:scope:b573c0f0b14f5f3a4addf4968f9bf45e46854c5ab5a5613ffbf8cf2e11299e14"

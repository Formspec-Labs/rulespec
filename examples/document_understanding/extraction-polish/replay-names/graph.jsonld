      "rkaf:assertsValue": {
        "@value": "{\"action\":\"continue to use\",\"actor\":\"The applicant\",\"alternative_quotes\":[],\"choice_text\":\"\",\"claimants\":[],\"concepts\":[{\"definition\":\"Prohibition on continued use of a former name following a material name change unless explicitly authorized.\",\"label\":\"Use of Previous Name\",\"quote\":\"The applicant may not continue to use a previous name after a material name change unless the name change documentation specifically permits the applicant to continue using that name\",\"role\":\"rkaf:assignmentPrimary\"}],\"effective_periods\":[],\"jurisdiction\":\"\",\"kind\":\"prohibition\",\"logic_text\":\"unless\",\"modality\":\"must_not\",\"object\":\"a previous name\",\"scope_text\":\"Applies after a material name change, unless the name change documentation specifically permits the applicant to continue using that name.\",\"summary\":\"The applicant must not continue to use a previous name after a material name change unless the name change documentation specifically permits the applicant to continue using that name.\",\"typed_values\":[]}",
        "@type": "xsd:string"
      },

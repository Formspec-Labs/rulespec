      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"action\":\"be issued in the requested name\",\"actor\":\"\",\"alternative_quotes\":[],\"choice_text\":\"\",\"claimants\":[],\"concepts\":[{\"definition\":\"Permission to issue a limited-validity passport in the requested name when travel is urgent or an emergency and time precludes requesting acceptable updated ID.\",\"label\":\"Limited-Validity Passport Issuance for Urgent Travel\",\"quote\":\"If there is insufficient time to request that the applicant submit acceptable ID prior to urgent or emergency travel, a limited-validity passport may be issued in the requested name;\",\"role\":\"rkaf:assignmentPrimary\"}],\"effective_periods\":[],\"jurisdiction\":\"\",\"kind\":\"permission\",\"logic_text\":\"If\",\"modality\":\"may\",\"object\":\"a limited-validity passport\",\"scope_text\":\"If the applicant has had a material name change more than one year prior to applying on form DS-11 but has not updated their ID, and there is insufficient time to request that the applicant submit acceptable ID prior to urgent or emergency travel.\",\"summary\":\"If an applicant had a material name change more than one year prior to applying on Form DS-11 without updating ID, but there is insufficient time to request acceptable ID prior to urgent or emergency travel, a limited-validity passport may be issued in the requested name.\",\"typed_values\":[]}",
        "@type": "xsd:string"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed",
      "rkaf:hasApplicability": "urn:rulespec:document-understanding:scope:81f22c828fd76781754487648dabd527a129e01aa96e274ac108c7d05f4bf3cd"
    },

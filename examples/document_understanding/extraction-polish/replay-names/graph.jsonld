\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:2259:2413:sha256-92870edc32e366c9248d64f32f2dde47365f2424d16616883e116ff2a5661e4e\",\"quote\":\"prior to returning the documentation, including that the documentation was \\\"seen and returned,\\\" to the applicant with the information request letter (IRL)\",\"start\":2259},{\"end\":2206,\"field\":\"context:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:2109:2206:sha256-16e688700644dcf2ef2c3a728bf835d6d705ac0344f583a89e961468ba5baeab\",\"quote\":\"The applicant generally will need the name change documentation to change the name on her/his ID.\",\"start\":2109},{\"end\":2414,\"field\":\"concepts:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:2207:2414:sha256-1eb00a877c849b271f663c3765078e0ad5bc21a29e3f9df718f46975989eb4f0\",\"quote\":\"You must fully notate the name change documentation prior to returning the documentation, including that the documentation was \\\"seen and returned,\\\" to the applicant with the information request letter (IRL);\",\"start\":2207}],\"id\":\"urn:rulespec:document-understanding:revision:5189a9401404189fc3acb053268ea6872fdc2461414ffcdecce7ae21ba13a140\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"prior to\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:491c53060218965b779fc553eca4dda2c14951026977ea0c9f669638f645cc89\",\"modality\":\"must\",\"modality_quote\":\"must\",\"object\":\"the name change documentation, including that the documentation was \\\"seen and returned,\\\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:6a2a0d514f02c6414464f89a3305c15fbd5b3de3fcad4bc053b82e1ad3676eb8\",\"origin\":\"aiSuggested\",\"quote\":\"You must fully notate the name change documentation prior to returning the documentation, including that the documentation was \\\"seen and returned,\\\" to the applicant with the information request letter (IRL);\",\"references\":[\"IRL\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:f84700d4b70bb4132ac1c8f8897ee9114ecd77eaa73abce352c4c7f6ac80ab18\",\"scope_quotes\":[\"prior to returning the documentation, including that the documentation was \\\"seen and returned,\\\" to the applicant with the information request letter (IRL)\"],\"scope_text\":\"Governed by the process of returning name change documentation to the applicant with the information request letter (IRL).\",\"section_id\":\"fam-names-section-4\",\"start\":2207,\"summary\":\"You must fully notate the name change documentation, including that it was 'seen and returned,' prior to returning the documentation to the applicant with the information request letter (IRL).\",\"target_ids\":[],\"typed_values\":[]}",

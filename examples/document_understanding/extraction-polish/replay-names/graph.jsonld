      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"action\":\"suspend the application to request an acceptable ID in the new name\",\"actor\":\"you\",\"alternative_quotes\":[],\"choice_text\":\"\",\"claimants\":[],\"concepts\":[{\"definition\":\"Mandate to suspend an application when an applicant has had a material name change over a year prior to applying on Form DS-11 without updating ID.\",\"label\":\"Suspension for Un-updated ID After Material Name Change\",\"quote\":\"If the applicant has had a material name change more than one year prior to applying on form DS-11 but has not updated her/his ID to reflect the material name change, you must suspend the application to request an acceptable ID in the new name.\",\"role\":\"rkaf:assignmentPrimary\"}],\"effective_periods\":[],\"jurisdiction\":\"\",\"kind\":\"requirement\",\"logic_text\":\"If ... but\",\"modality\":\"must\",\"object\":\"the application\",\"scope_text\":\"If the applicant has had a material name change more than one year prior to applying on form DS-11 but has not updated her/his ID to reflect the material name change.\",\"summary\":\"If an applicant had a material name change more than one year prior to applying on Form DS-11 but has not updated their ID to reflect the name change, you must suspend the application to request an acceptable ID in the new name.\",\"typed_values\":[{\"anchor\":\"applying on form DS-11\",\"comparator\":\"more than\",\"datatype\":\"xsd:duration\",\"name\":\"Time elapsed since material name change\",\"quote\":\"more than one year prior to applying on form DS-11\",\"unit\":\"year\",\"value\":\"P1Y\"}]}",
        "@type": "xsd:string"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed",
      "rkaf:hasApplicability": "urn:rulespec:document-understanding:scope:eb8a67be889b4a1cf94f1fce28fef35c95e1d949ff7d732d360eebe91509da3c"

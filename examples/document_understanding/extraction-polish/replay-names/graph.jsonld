      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"action\":\"be required\",\"actor\":\"\",\"alternative_quotes\":[],\"choice_text\":\"\",\"claimants\":[],\"concepts\":[{\"definition\":\"The possibility that evidence of identity may be required to establish the name best identifying the applicant.\",\"label\":\"Evidence of Identity Requirement Possibility\",\"quote\":\"The applicant's name is an integral part of her/his identity. Consequently, under 22 CFR 51.23(c), evidence of identity might be required in accordance with Department guidance to establish the name that best identifies the applicant\",\"role\":\"rkaf:assignmentPrimary\"}],\"effective_periods\":[],\"jurisdiction\":\"\",\"kind\":\"statement\",\"logic_text\":\"\",\"modality\":\"possible\",\"object\":\"evidence of identity\",\"scope_text\":\"Governed by circumstances where Department guidance applies to establish the name that best identifies the applicant under 22 CFR 51.23(c).\",\"summary\":\"Under 22 CFR 51.23(c), evidence of identity might be required in accordance with Department guidance to establish the name that best identifies the applicant.\",\"typed_values\":[]}",
        "@type": "xsd:string"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed",
      "rkaf:hasApplicability": "urn:rulespec:document-understanding:scope:0ed34285e152b94475a1e73bee0461cc8b657588c9fd0b9e85812a5724a78a55"

        "@value": "{\"action\":\"submit\",\"actor\":\"Applicants who have had a material name change within one year of applying on a form DS-11\",\"alternative_quotes\":[],\"choice_text\":\"\",\"claimants\":[],\"concepts\":[{\"definition\":\"Absence of requirement to submit ID in the new name if the material name change occurred within one year of applying on Form DS-11.\",\"label\":\"ID Submission Exemption\",\"quote\":\"Applicants who have had a material name change within one year of applying on a form DS-11 do not need to submit ID in the new name.\",\"role\":\"rkaf:assignmentPrimary\"}],\"effective_periods\":[],\"jurisdiction\":\"\",\"kind\":\"exemption\",\"logic_text\":\"within one year of applying on a form DS-11\",\"modality\":\"not_required\",\"object\":\"ID in the new name\",\"scope_text\":\"For applicants who have had a material name change within one year of applying on a Form DS-11.\",\"summary\":\"Applicants who have had a material name change within one year of applying on Form DS-11 are not required to submit ID in the new name.\",\"typed_values\":[{\"anchor\":\"applying on a form DS-11\",\"comparator\":\"within\",\"datatype\":\"xsd:duration\",\"name\":\"material name change within one year threshold\",\"quote\":\"within one year of applying on a form DS-11\",\"unit\":\"year\",\"value\":\"P1Y\"}]}",

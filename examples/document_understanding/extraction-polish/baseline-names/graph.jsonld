      "dcterms:description": "{\"action\":\"documenting by submission of\",\"actor\":\"\",\"alternative_quotes\":[\"Court orders or decrees:\\n\\n(a) Name change orders; or\\n\\n(b) Divorce decrees\",\"Certificates of naturalization\",\"Marriage certificates\",\"Documentation demonstrating change of name by operation of state law\",\"Documentation of customary usage\"],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:e6567f101cf32a9c5a910c081112b4a1dbb246177495bee2740a5b3bbd282108\",\"urn:rulespec:document-understanding:assertion:1e6416af1b903552f05a2fc22df6350e7df86a82ca41983e7b6f4620e5f37074\",\"urn:rulespec:document-understanding:assertion:38e9fcea6f5bbf95aa049f26bb7c83ef357a7b739de0c5150b9aacc3c1a54474\",\"urn:rulespec:document-understanding:assertion:447bac4e73245d91b910b88e882d55271c8bf4d592bcad971cd0394a1b849877\",\"urn:rulespec:document-understanding:assertion:620d9a30d573a61ecc2245ea505db84844a23d359f756f59bc78a7af43c85209\",\"urn:rulespec:document-understanding:assertion:efeba0ea54de55737d75e5beef3c84dd6e6a4793036f55aaa017f958993b9e02\",\"urn:rulespec:document-understanding:assertion:bdae894882530bbf7431c23c766d32770c9dfc428a73c21a9772cc6ecc8a6da9\",\"urn:rulespec:document-understanding:assertion:49c8c2d5b32f77ed94f98fe0941b0e088953bbc9399d6b51a4313a4b4b9e85af\",\"urn:rulespec:document-understanding:assertion:cee865d42aa1dc0fbff7378b816bd69b2f753a06c70866bac7f82cbc95a8e233\",\"urn:rulespec:document-understanding:assertion:6ef4d7f9639aecdf3d5bd68e80838aef93bdfe7b08bbb27e36ec5e8a52626e25\",\"urn:rulespec:document-understanding:assertion:b50f6ad0d9d681d55f365e1b82248a8af9f93795ad634033832dbec107c54601\",\"urn:rulespec:document-understanding:assertion:7efaa6eefade60180b659231a68158cf475fd2fb65982743f24b99b9467323b8\",\"urn:rulespec:document-understanding:assertion:23184763da37065b0d608b62ed97824f9d015a1b3549436da39b10cfeeca7566\"],\"choice_quote\":\"submission of one or more of the documents listed in this section\",\"choice_text\":\"one or more of the documents listed: court orders or decrees (name change orders or divorce decrees), certificates of naturalization, marriage certificates, documentation demonstrating change of name by operation of state law, or documentation of customary usage\",\"claimants\":[],\"concepts\":[{\"definition\":\"Any name change that is not defined as immaterial in 8 FAM 403.1-5.\",\"label\":\"Material Discrepancy\",\"quote\":\"A material discrepancy is any name change that is not defined as immaterial in 8 FAM 403.1-5.\",\"role\":\"rkaf:assignmentPrimary\"}],\"context_quotes\":[],\"effective_periods\":[],\"end\":1075,\"evidence\":[{\"end\":1075,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:413:1075:sha256-660d269ce0e0ee226093dd3c78c292d98b7ef7de1af61f8431adecf82778afc6\",\"quote\":\"Material discrepancies between the name recorded on the application, the applicant's evidence of U.S. citizenship/non-citizen U.S. nationality, or the evidence of identity must be documented by submission of one or more of the documents listed in this section (see an exception for married names in 8 FAM 403.1-4(C)). Acceptable means of documenting a material name change include (per 22 CFR 51.25):\\n\\n(1) Court orders or decrees:\\n\\n(a) Name change orders; or\\n\\n(b) Divorce decrees;\\n\\n(2) Certificates of naturalization;\\n\\n(3) Marriage certificates;\\n\\n(4) Documentation demonstrating change of name by operation of state law; or\\n\\n(5) Documentation of customary usage.\",\"start\":413},{\"end\":620,\"field\":\"action\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:585:620:sha256-0f05f1f6231570a31de622c0969a535a4949ec69272c1c2627cd1d6d5b1d7ed2\",\"quote\":\"must be documented by submission of\",\"start\":585},{\"end\":584,\"field\":\"object\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:413:584:sha256-cb40404d70d90218b38e38b5d38aea0168c012097c2d557a928d6edea4eed5fa\",\"quote\":\"Material discrepancies between the name recorded on the application, the applicant's evidence of U.S. citizenship/non-citizen U.S. nationality, or the evidence of identity\",\"start\":413},{\"end\":672,\"field\":\"logic_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:621:672:sha256-2c50430030c55b2d21562547c684ecb83fc27784c220f6516ba9f50097010a5f\",\"quote\":\"one or more of the documents listed in this section\",\"start\":621},{\"end\":589,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:585:589:sha256-4137b01e139589b7a1d3b3fc4da031d8ce5bb415808734e970c3a58ea0e98f0f\",\"quote\":\"must\",\"start\":585},{\"end\":672,\"field\":\"choice_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:607:672:sha256-716fe3071f83e27c5129bb8490a4eec273130dae64fe9ec05642b35b05db925f\",\"quote\":\"submission of one or more of the documents listed in this section\",\"start\":607},{\"end\":892,\"field\":\"alternative:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:819:892:sha256-35ff2468c1e25922663de880710dc9befba2736d3b6ca6cc948bfb53837f39fc\",\"quote\":\"Court orders or decrees:\\n\\n(a) Name change orders; or\\n\\n(b) Divorce decrees\",\"start\":819},{\"end\":929,\"field\":\"alternative:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:899:929:sha256-75acae92255c297a5b5868c038abbe72852ff99f836ed5e20419d019c53f49be\",\"quote\":\"Certificates of naturalization\",\"start\":899},{\"end\":957,\"field\":\"alternative:2\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:936:957:sha256-36f88b64f1d528d6f66a1f189a318b4633f775d520c04c542ee7257308a41fbc\",\"quote\":\"Marriage certificates\",\"start\":936},{\"end\":1032,\"field\":\"alternative:3\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:964:1032:sha256-00a3c0e73f512fbed0328495aedd36c48d634ec4667d916b58232f13617f07d8\",\"quote\":\"Documentation demonstrating change of name by operation of state law\",\"start\":964},{\"end\":1074,\"field\":\"alternative:4\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:1042:1074:sha256-fe45e8bfc73a398c1816bfecfffba0af143f5d8cb3f3036ebf315d69fef0a0ad\",\"quote\":\"Documentation of customary usage\",\"start\":1042},{\"end\":182,\"field\":\"concepts:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:89:182:sha256-5602d44385cd415774969d0e2887a0c50302266165110bee3fb1281358e162c1\",\"quote\":\"A material discrepancy is any name change that is not defined as immaterial in 8 FAM 403.1-5.\",\"start\":89}],\"id\":\"urn:rulespec:document-understanding:revision:5d43e05110fa4a97a470f9e9c667f3240d50fe654e7c2f1115c09959f914e98d\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"one or more of the documents listed in this section\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:7efaa6eefade60180b659231a68158cf475fd2fb65982743f24b99b9467323b8\",\"modality\":\"must\",\"modality_quote\":\"must\",\"object\":\"Material discrepancies between the name recorded on the application, the applicant's evidence of U.S. citizenship/non-citizen U.S. nationality, or the evidence of identity\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:23cbdc89d913160cbdedf4da47ebc5054f296d3a178e1007df9c3f0efbdbfa76\",\"origin\":\"aiSuggested\",\"quote\":\"Material discrepancies between the name recorded on the application, the applicant's evidence of U.S. citizenship/non-citizen U.S. nationality, or the evidence of identity must be documented by submission of one or more of the documents listed in this section (see an exception for married names in 8 FAM 403.1-4(C)). Acceptable means of documenting a material name change include (per 22 CFR 51.25):\\n\\n(1) Court orders or decrees:\\n\\n(a) Name change orders; or\\n\\n(b) Divorce decrees;\\n\\n(2) Certificates of naturalization;\\n\\n(3) Marriage certificates;\\n\\n(4) Documentation demonstrating change of name by operation of state law; or\\n\\n(5) Documentation of customary usage.\",\"references\":[\"8 FAM 403.1-4(C)\",\"22 CFR 51.25\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:8fa73b4510675313af7b1a16e1b630fe6679500addbc82b9cd80c5e88cd0e009\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"fam-names-section-4\",\"start\":413,\"summary\":\"Material discrepancies between the name recorded on the application, the applicant's evidence of U.S. citizenship/non-citizen U.S. nationality, or the evidence of identity must be documented by submission of one or more listed acceptable documents (court orders or decrees including name change orders or divorce decrees; certificates of naturalization; marriage certificates; documentation demonstrating change of name by operation of state law; or documentation of customary usage), subject to an exception for married names in 8 FAM 403.1-4(C).\",\"target_ids\":[],\"typed_values\":[]}",

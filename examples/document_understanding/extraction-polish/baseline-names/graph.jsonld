    {
      "@id": "urn:rulespec:document-understanding:assertion:7efaa6eefade60180b659231a68158cf475fd2fb65982743f24b99b9467323b8",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:8b31a9227a30bbeafac27fa20982902b252f11a12f371c90d6626d72fc8ca848",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:4f2d3cc274e324cdbb097e8cc39d7b0553ef507040896f577f6a9180112cfcd0",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:8fa73b4510675313af7b1a16e1b630fe6679500addbc82b9cd80c5e88cd0e009",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"action\":\"documenting by submission of\",\"actor\":\"\",\"alternative_quotes\":[\"Court orders or decrees:\\n\\n(a) Name change orders; or\\n\\n(b) Divorce decrees\",\"Certificates of naturalization\",\"Marriage certificates\",\"Documentation demonstrating change of name by operation of state law\",\"Documentation of customary usage\"],\"choice_text\":\"one or more of the documents listed: court orders or decrees (name change orders or divorce decrees), certificates of naturalization, marriage certificates, documentation demonstrating change of name by operation of state law, or documentation of customary usage\",\"claimants\":[],\"concepts\":[{\"definition\":\"Any name change that is not defined as immaterial in 8 FAM 403.1-5.\",\"label\":\"Material Discrepancy\",\"quote\":\"A material discrepancy is any name change that is not defined as immaterial in 8 FAM 403.1-5.\",\"role\":\"rkaf:assignmentPrimary\"}],\"effective_periods\":[],\"jurisdiction\":\"\",\"kind\":\"requirement\",\"logic_text\":\"one or more of the documents listed in this section\",\"modality\":\"must\",\"object\":\"Material discrepancies between the name recorded on the application, the applicant's evidence of U.S. citizenship/non-citizen U.S. nationality, or the evidence of identity\",\"scope_text\":\"\",\"summary\":\"Material discrepancies between the name recorded on the application, the applicant's evidence of U.S. citizenship/non-citizen U.S. nationality, or the evidence of identity must be documented by submission of one or more listed acceptable documents (court orders or decrees including name change orders or divorce decrees; certificates of naturalization; marriage certificates; documentation demonstrating change of name by operation of state law; or documentation of customary usage), subject to an exception for married names in 8 FAM 403.1-4(C).\",\"typed_values\":[]}",
        "@type": "xsd:string"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

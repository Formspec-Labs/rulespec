      "rkaf:assertsValue": {
        "@value": "{\"action\":\"submit\",\"actor\":\"Applicants who have had a material name change within one year of applying on a form DS-11\",\"alternative_quotes\":[],\"choice_text\":\"\",\"claimants\":[],\"concepts\":[{\"definition\":\"Submission of name change documentation when the ID has not yet been changed.\",\"label\":\"Name Change Documentation Submission\",\"quote\":\"if the ID has not yet been changed, they must submit their name change documentation.\",\"role\":\"rkaf:assignmentPrimary\"}],\"effective_periods\":[],\"jurisdiction\":\"\",\"kind\":\"requirement\",\"logic_text\":\"if the ID has not yet been changed\",\"modality\":\"must\",\"object\":\"their name change documentation\",\"scope_text\":\"For applicants who have had a material name change within one year of applying on a Form DS-11, if the ID has not yet been changed.\",\"summary\":\"If an applicant had a material name change within one year of applying on Form DS-11 and their ID has not yet been changed, they must submit their name change documentation.\",\"typed_values\":[{\"anchor\":\"applying on a form DS-11\",\"comparator\":\"within\",\"datatype\":\"xsd:duration\",\"name\":\"material name change within one year threshold\",\"quote\":\"within one year of applying on a form DS-11\",\"unit\":\"year\",\"value\":\"P1Y\"}]}",
        "@type": "xsd:string"
      },

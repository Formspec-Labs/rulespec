      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"action\":\"issue\",\"actor\":\"\",\"alternative_quotes\":[],\"choice_text\":\"\",\"claimants\":[],\"concepts\":[{\"definition\":\"Issuing a limited-validity passport in the requested name when travel is urgent or an emergency.\",\"label\":\"Limited-Validity Passport Issuance\",\"quote\":\"a limited-validity passport may be issued in the requested name\",\"role\":\"rkaf:assignmentPrimary\"}],\"effective_periods\":[],\"jurisdiction\":\"\",\"kind\":\"permission\",\"logic_text\":\"If there is insufficient time to request that the applicant submit acceptable ID prior to urgent or emergency travel\",\"modality\":\"may\",\"object\":\"a limited-validity passport in the requested name\",\"scope_text\":\"If the applicant has had a material name change more than one year prior to applying on form DS-11 but has not updated her/his ID to reflect the material name change, and there is insufficient time to request that the applicant submit acceptable ID prior to urgent or emergency travel.\",\"summary\":\"When an applicant had a material name change more than one year prior to applying on Form DS-11 without updating their ID, and there is insufficient time to request submission of acceptable ID prior to urgent or emergency travel, a limited-validity passport may be issued in the requested name.\",\"typed_values\":[{\"anchor\":\"applying on form DS-11\",\"comparator\":\"more than\",\"datatype\":\"xsd:duration\",\"name\":\"material name change timing threshold\",\"quote\":\"more than one year prior to applying on form DS-11\",\"unit\":\"year\",\"value\":\"P1Y\"}]}",
        "@type": "xsd:string"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed",
      "rkaf:hasApplicability": "urn:rulespec:document-understanding:scope:96b25e6e5a2bbf437d21b00679ed980850634cfceb78a2cee9414d837421a9e5"

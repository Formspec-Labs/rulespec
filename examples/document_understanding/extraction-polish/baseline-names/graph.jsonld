        "@value": "{\"action\":\"suspend\",\"actor\":\"you\",\"alternative_quotes\":[],\"choice_text\":\"\",\"claimants\":[],\"concepts\":[{\"definition\":\"Suspending an application to request acceptable ID in the new name.\",\"label\":\"Application Suspension\",\"quote\":\"suspend the application to request an acceptable ID in the new name\",\"role\":\"rkaf:assignmentPrimary\"}],\"effective_periods\":[],\"jurisdiction\":\"\",\"kind\":\"requirement\",\"logic_text\":\"If the applicant has had a material name change more than one year prior to applying on form DS-11 but has not updated her/his ID to reflect the material name change\",\"modality\":\"must\",\"object\":\"the application to request an acceptable ID in the new name\",\"scope_text\":\"If the applicant has had a material name change more than one year prior to applying on form DS-11 but has not updated her/his ID to reflect the material name change.\",\"summary\":\"If the applicant had a material name change more than one year prior to applying on Form DS-11 but has not updated her/his ID to reflect the material name change, you must suspend the application to request an acceptable ID in the new name.\",\"typed_values\":[{\"anchor\":\"applying on form DS-11\",\"comparator\":\"more than\",\"datatype\":\"xsd:duration\",\"name\":\"material name change timing threshold\",\"quote\":\"more than one year prior to applying on form DS-11\",\"unit\":\"year\",\"value\":\"P1Y\"}]}",

      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:ecdf4a2b009955e7ce51eb0bf7cf6a5eb8e4ae4c5eb4d21d57840cdac66c12b8\",\"urn:rulespec:document-understanding:assertion:028277336e83f7945ec4a321a2f50e4b7483d0c87eae08216625e566cb8910ac\",\"urn:rulespec:document-understanding:assertion:0ebd296b0f36ed5e13ef631390a5dca90d574be3f10a4175de37e4c50a082718\",\"urn:rulespec:document-understanding:assertion:ac6d78ed967cb95369b6b9b3a430d45648727aeae3f7efaf307bdda41d89fcc2\",\"urn:rulespec:document-understanding:assertion:d75cb08112abbcd82d9d7d3f71e3e1aaffe5a1a6dc646ed476fe4763aea87d5d\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"effective_periods\":[],\"end\":1682,\"evidence\":[{\"end\":1682,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A17e50019a4e77ab1a9c73c9fab8bd1b6da871d60b60c77790e8803a1d9920f62:1159:1682:sha256-3583bfa13c136e40a1005ff1210b6c0bcc560609a0916bb52fde5527907c0b6a\",\"quote\":\"(i) The employee's break in service is occasioned by the fulfillment of his or her Uniformed Services Employment and Reemployment Rights Act (USERRA), 38 U.S.C. 4301, et seq., covered service obligation. The period of absence from work due to or necessitated by USERRA-covered service must be also counted in determining whether the employee has been employed for at least 12 months by the employer. However, this section does not provide any greater entitlement to the employee than would be available under the USERRA; or\",\"start\":1159},{\"end\":1682,\"field\":\"logic_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A17e50019a4e77ab1a9c73c9fab8bd1b6da871d60b60c77790e8803a1d9920f62:1159:1682:sha256-3583bfa13c136e40a1005ff1210b6c0bcc560609a0916bb52fde5527907c0b6a\",\"quote\":\"(i) The employee's break in service is occasioned by the fulfillment of his or her Uniformed Services Employment and Reemployment Rights Act (USERRA), 38 U.S.C. 4301, et seq., covered service obligation. The period of absence from work due to or necessitated by USERRA-covered service must be also counted in determining whether the employee has been employed for at least 12 months by the employer. However, this section does not provide any greater entitlement to the employee than would be available under the USERRA; or\",\"start\":1159},{\"end\":1448,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A17e50019a4e77ab1a9c73c9fab8bd1b6da871d60b60c77790e8803a1d9920f62:1444:1448:sha256-4137b01e139589b7a1d3b3fc4da031d8ce5bb415808734e970c3a58ea0e98f0f\",\"quote\":\"must\",\"start\":1444},{\"end\":702,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A17e50019a4e77ab1a9c73c9fab8bd1b6da871d60b60c77790e8803a1d9920f62:592:702:sha256-130832d94200d58087ab6a46024a3a10483b1b99086401c1b273635c4e31aaf3\",\"quote\":\"(b) The 12 months an employee must have been employed by the employer need not be consecutive months, provided\",\"start\":592},{\"end\":1157,\"field\":\"scope_text:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A17e50019a4e77ab1a9c73c9fab8bd1b6da871d60b60c77790e8803a1d9920f62:965:1157:sha256-81c4f484796168f909a9f64f9112a6ace05f639aa7e0991efd5642b3d60a67f6\",\"quote\":\"(2) Employment periods preceding a break in service of more than seven years must be counted in determining whether the employee has been employed by the employer for at least 12 months where:\",\"start\":965},{\"end\":1682,\"field\":\"scope_text:2\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A17e50019a4e77ab1a9c73c9fab8bd1b6da871d60b60c77790e8803a1d9920f62:1159:1682:sha256-3583bfa13c136e40a1005ff1210b6c0bcc560609a0916bb52fde5527907c0b6a\",\"quote\":\"(i) The employee's break in service is occasioned by the fulfillment of his or her Uniformed Services Employment and Reemployment Rights Act (USERRA), 38 U.S.C. 4301, et seq., covered service obligation. The period of absence from work due to or necessitated by USERRA-covered service must be also counted in determining whether the employee has been employed for at least 12 months by the employer. However, this section does not provide any greater entitlement to the employee than would be available under the USERRA; or\",\"start\":1159}],\"id\":\"urn:rulespec:document-understanding:revision:4f46808a5bd6fb07691938d748e4468dbcc828bc968d4d4899773803d59d07d7\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"(i) The employee's break in service is occasioned by the fulfillment of his or her Uniformed Services Employment and Reemployment Rights Act (USERRA), 38 U.S.C. 4301, et seq., covered service obligation. The period of absence from work due to or necessitated by USERRA-covered service must be also counted in determining whether the employee has been employed for at least 12 months by the employer. However, this section does not provide any greater entitlement to the employee than would be available under the USERRA; or\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:d75cb08112abbcd82d9d7d3f71e3e1aaffe5a1a6dc646ed476fe4763aea87d5d\",\"modality\":\"must\",\"modality_quote\":\"must\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:6b176c3e21a15d40933115fe2ca842de307b820227d58bf5110768c5e6de7163\",\"origin\":\"aiSuggested\",\"quote\":\"(i) The employee's break in service is occasioned by the fulfillment of his or her Uniformed Services Employment and Reemployment Rights Act (USERRA), 38 U.S.C. 4301, et seq., covered service obligation. The period of absence from work due to or necessitated by USERRA-covered service must be also counted in determining whether the employee has been employed for at least 12 months by the employer. However, this section does not provide any greater entitlement to the employee than would be available under the USERRA; or\",\"references\":[\"USERRA\",\"38 U.S.C. 4301, et seq.\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:bbf9cb14ead4c68b2755f718814156606b973fb8bd19a3e044bb1e59ac7d6710\",\"scope_quotes\":[\"(b) The 12 months an employee must have been employed by the employer need not be consecutive months, provided\",\"(2) Employment periods preceding a break in service of more than seven years must be counted in determining whether the employee has been employed by the employer for at least 12 months where:\",\"(i) The employee's break in service is occasioned by the fulfillment of his or her Uniformed Services Employment and Reemployment Rights Act (USERRA), 38 U.S.C. 4301, et seq., covered service obligation. The period of absence from work due to or necessitated by USERRA-covered service must be also counted in determining whether the employee has been employed for at least 12 months by the employer. However, this section does not provide any greater entitlement to the employee than would be available under the USERRA; or\"],\"scope_text\":\"In determining whether an employee has been employed for at least 12 months by the employer, when absence from work is due to or necessitated by USERRA-covered service, and subject to the limitation that this section does not provide any greater entitlement than available under USERRA.\",\"section_id\":\"section-1\",\"start\":1159,\"summary\":\"The period of absence from work due to or necessitated by USERRA-covered service must also be counted in determining whether the employee has been employed for at least 12 months by the employer; however, this section does not provide any greater entitlement to the employee than would be available under the USERRA.\",\"target_ids\":[],\"typed_values\":[]}",
      "dcterms:references": [
        {
          "@id": "urn:rulespec:document-understanding:assertion:ecdf4a2b009955e7ce51eb0bf7cf6a5eb8e4ae4c5eb4d21d57840cdac66c12b8"

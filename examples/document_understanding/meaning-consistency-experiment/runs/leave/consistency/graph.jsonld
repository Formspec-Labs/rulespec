      "rkaf:bindsAssertion": "urn:rulespec:document-understanding:assertion:30fa356e1e4fb34bae6f03f45a20f719ed93c6233e43f759d46e226f6878d5e7",
      "rkaf:evidenceRole": "rkaf:textualEvidence",
      "rkaf:evidentiaryFunction": "rkaf:supports",
      "rkaf:bindsSourceFragment": [
        "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A17e50019a4e77ab1a9c73c9fab8bd1b6da871d60b60c77790e8803a1d9920f62:1684:1946:sha256-22bee698e6edc5508214d1396269140108cba107f57fd0d4fea9996d63173bfb"

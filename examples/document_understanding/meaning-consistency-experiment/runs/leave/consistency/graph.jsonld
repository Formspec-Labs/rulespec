    {
      "@id": "urn:rulespec:document-understanding:scope:fd831ebc68724b22196ea9930c2927b07ff356c457bf43289e82aa682d156efb",
      "@type": "rkaf:ApplicabilityScope",
      "rkaf:appliesInJurisdiction": [],
      "rkaf:applicabilityCondition": "In determining whether an employee has been employed by the employer for at least 12 months, where employment periods precede a break in service of more than seven years and either the break was occasioned by USERRA-covered service or a qualifying written agreement exists."
    },
    {
      "@id": "urn:rulespec:document-understanding:assertion:b6d81768ceeb24e19cfe3f1ecc97903596b6c498741135080a556bd3fbc4e22b",

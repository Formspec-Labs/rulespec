    {
      "@id": "urn:rulespec:document-understanding:assertion:fdc083ba83a48da90f4df4a163a0f6a24dfc28186d1122bd3468c8a5ba22c1c6",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:5fda77d747042d1a4e328071db40c44694eedab2031442b33432a5cab9b63135",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:f77caaa50c67774dcc9b47c168e20217c308c6912f9495fff4f4489c734e2d14",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:0af752c229945acf146646aeb10dfdfae22cb3b4042e7b6df0c6456656f3afe8",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[\"(i) The employee's break in service is occasioned by the fulfillment of his or her Uniformed Services Employment and Reemployment Rights Act (USERRA), 38 U.S.C. 4301, et seq., covered service obligation. The period of absence from work due to or necessitated by USERRA-covered service must be also counted in determining whether the employee has been employed for at least 12 months by the employer. However, this section does not provide any greater entitlement to the employee than would be available under the USERRA; or\",\"(ii) A written agreement, including a collective bargaining agreement, exists concerning the employer's intention to rehire the employee after the break in service (e.g., for purposes of the employee furthering his or her education or for childrearing purposes).\"],\"choice_text\":\"Employment periods preceding a break in service of more than seven years must be counted where either: (i) the employee's break in service is occasioned by the fulfillment of a USERRA-covered service obligation; OR (ii) a written agreement, including a collective bargaining agreement, exists concerning the employer's intention to rehire the employee after the break in service (e.g., for education or childrearing).\",\"claimants\":[],\"concepts\":[],\"effective_periods\":[],\"jurisdiction\":\"\",\"kind\":\"requirement\",\"logic_text\":\"(2) Employment periods preceding a break in service of more than seven years must be counted in determining whether the employee has been employed by the employer for at least 12 months where:\\n\\n(i) The employee's break in service is occasioned by the fulfillment of his or her Uniformed Services Employment and Reemployment Rights Act (USERRA), 38 U.S.C. 4301, et seq., covered service obligation. The period of absence from work due to or necessitated by USERRA-covered service must be also counted in determining whether the employee has been employed for at least 12 months by the employer. However, this section does not provide any greater entitlement to the employee than would be available under the USERRA; or\\n\\n(ii) A written agreement, including a collective bargaining agreement, exists concerning the employer's intention to rehire the employee after the break in service (e.g., for purposes of the employee furthering his or her education or for childrearing purposes).\",\"modality\":\"must\",\"object\":\"\",\"scope_text\":\"Applies in determining whether the employee has been employed by the employer for at least 12 months when the employee has experienced a break in service of more than seven years, where either the break was occasioned by USERRA-covered service or a written agreement exists concerning the employer's intention to rehire the employee after the break.\",\"summary\":\"In determining whether an employee has been employed by the employer for at least 12 months, employment periods preceding a break in service of more than seven years must be counted where the employee's break in service is occasioned by the fulfillment of a USERRA (38 U.S.C. 4301 et seq.) covered service obligation, or where a written agreement, including a collective bargaining agreement, exists concerning the employer's intention to rehire the employee after the break in service.\",\"typed_values\":[]}",
        "@type": "xsd:string"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed",

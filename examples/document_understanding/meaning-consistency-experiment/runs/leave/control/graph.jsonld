      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:633c06915b9b5a0038ad7a69f1b88d59411b87287be9ff3a13a7f04440d90af1\",\"urn:rulespec:document-understanding:assertion:cb83da95b21adbeaa74c3046b553f9a78f9f8166b8e24974db2a76293d08de50\",\"urn:rulespec:document-understanding:assertion:e781847bd5afa6d35458daf1c77eebf62ea75aabdfd110cbf7c6a7d9d7b36863\",\"urn:rulespec:document-understanding:assertion:4700f2929092c0fcbcb8550542624467a14e80bfb668342c02493018f7d3fd7d\",\"urn:rulespec:document-understanding:assertion:70ec38147bd755d6e616718edbe7b774d2ccc32d58de4e0357395326342830d1\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"effective_periods\":[],\"end\":2804,\"evidence\":[{\"end\":2804,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A17e50019a4e77ab1a9c73c9fab8bd1b6da871d60b60c77790e8803a1d9920f62:2419:2804:sha256-668999c51c74d480383126ed520172cea18a50cba1239cdc7337af5ed0e7a425\",\"quote\":\"(4) Nothing in this section prevents employers from considering employment prior to a continuous break in service of more than seven years when determining whether an employee has met the 12-month employment requirement. However, if an employer chooses to recognize such prior employment, the employer must do so uniformly, with respect to all employees with similar breaks in service.\",\"start\":2419},{\"end\":2804,\"field\":\"logic_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A17e50019a4e77ab1a9c73c9fab8bd1b6da871d60b60c77790e8803a1d9920f62:2419:2804:sha256-668999c51c74d480383126ed520172cea18a50cba1239cdc7337af5ed0e7a425\",\"quote\":\"(4) Nothing in this section prevents employers from considering employment prior to a continuous break in service of more than seven years when determining whether an employee has met the 12-month employment requirement. However, if an employer chooses to recognize such prior employment, the employer must do so uniformly, with respect to all employees with similar breaks in service.\",\"start\":2419},{\"end\":2455,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A17e50019a4e77ab1a9c73c9fab8bd1b6da871d60b60c77790e8803a1d9920f62:2423:2455:sha256-3a9c2af8fdcb26e636d6793af0ce395348b087e952d55ab41fdda4b0dcea513f\",\"quote\":\"Nothing in this section prevents\",\"start\":2423},{\"end\":2804,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A17e50019a4e77ab1a9c73c9fab8bd1b6da871d60b60c77790e8803a1d9920f62:2419:2804:sha256-668999c51c74d480383126ed520172cea18a50cba1239cdc7337af5ed0e7a425\",\"quote\":\"(4) Nothing in this section prevents employers from considering employment prior to a continuous break in service of more than seven years when determining whether an employee has met the 12-month employment requirement. However, if an employer chooses to recognize such prior employment, the employer must do so uniformly, with respect to all employees with similar breaks in service.\",\"start\":2419}],\"id\":\"urn:rulespec:document-understanding:revision:3c34835c45de74f25bb9c4ad331b16c79aeab6ccc7a0dd07d5cf5f7bfa8aed62\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"permission\",\"logic_text\":\"(4) Nothing in this section prevents employers from considering employment prior to a continuous break in service of more than seven years when determining whether an employee has met the 12-month employment requirement. However, if an employer chooses to recognize such prior employment, the employer must do so uniformly, with respect to all employees with similar breaks in service.\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:70ec38147bd755d6e616718edbe7b774d2ccc32d58de4e0357395326342830d1\",\"modality\":\"may\",\"modality_quote\":\"Nothing in this section prevents\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:ca85104080337860a26d8aa60fbb85125fc41c105c787952dcd0d7d808ee1065\",\"origin\":\"aiSuggested\",\"quote\":\"(4) Nothing in this section prevents employers from considering employment prior to a continuous break in service of more than seven years when determining whether an employee has met the 12-month employment requirement. However, if an employer chooses to recognize such prior employment, the employer must do so uniformly, with respect to all employees with similar breaks in service.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:162ea171d7c17b8891f2359beda2dfe8e543deceb62447bc6c1b7208c4783015\",\"scope_quotes\":[\"(4) Nothing in this section prevents employers from considering employment prior to a continuous break in service of more than seven years when determining whether an employee has met the 12-month employment requirement. However, if an employer chooses to recognize such prior employment, the employer must do so uniformly, with respect to all employees with similar breaks in service.\"],\"scope_text\":\"Applies when determining whether an employee has met the 12-month employment requirement.\",\"section_id\":\"section-1\",\"start\":2419,\"summary\":\"Nothing in this section prevents employers from considering employment prior to a continuous break in service of more than seven years when determining whether an employee has met the 12-month employment requirement.\",\"target_ids\":[],\"typed_values\":[]}",

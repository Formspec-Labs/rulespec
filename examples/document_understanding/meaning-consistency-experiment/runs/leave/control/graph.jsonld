    {
      "@id": "urn:rulespec:document-understanding:assertion:0d77aa2ccb4bfae531ed21e64744909f4525b49a30cccfb3347a55d6b4e74b42",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:5fda77d747042d1a4e328071db40c44694eedab2031442b33432a5cab9b63135",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:f77caaa50c67774dcc9b47c168e20217c308c6912f9495fff4f4489c734e2d14",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:0af752c229945acf146646aeb10dfdfae22cb3b4042e7b6df0c6456656f3afe8",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:choice_text",
      "rkaf:assertsValue": {
        "@value": "Employment periods preceding a break in service of more than seven years must be counted where either: (i) the employee's break in service is occasioned by the fulfillment of a USERRA-covered service obligation; OR (ii) a written agreement, including a collective bargaining agreement, exists concerning the employer's intention to rehire the employee after the break in service (e.g., for education or childrearing).",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },
    {
      "@id": "urn:rulespec:document-understanding:binding:e9af1b861b83bbc2ebaf691b2da9a4acd839e0abd1b9cd06caa688a5fb5eced6",
      "@type": "rkaf:EvidenceBinding",
      "rkaf:bindsAssertion": "urn:rulespec:document-understanding:assertion:0d77aa2ccb4bfae531ed21e64744909f4525b49a30cccfb3347a55d6b4e74b42",
      "rkaf:evidenceRole": "rkaf:textualEvidence",
      "rkaf:evidentiaryFunction": "rkaf:supports",
      "rkaf:bindsSourceFragment": [
        "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A17e50019a4e77ab1a9c73c9fab8bd1b6da871d60b60c77790e8803a1d9920f62:965:1946:sha256-44393cd9a380898a3a1acc3ba34a55b09730edf38e8b44fe99ff1f8768321518"
      ]
    },
    {
      "@id": "urn:rulespec:document-understanding:assertion:32cd86d6285f6915ff7eb6287054ffc120cc69aa480a91febb52d7c308049a62",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:5fda77d747042d1a4e328071db40c44694eedab2031442b33432a5cab9b63135",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:f77caaa50c67774dcc9b47c168e20217c308c6912f9495fff4f4489c734e2d14",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:0af752c229945acf146646aeb10dfdfae22cb3b4042e7b6df0c6456656f3afe8",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:alternative:0",
      "rkaf:assertsValue": {
        "@value": "(i) The employee's break in service is occasioned by the fulfillment of his or her Uniformed Services Employment and Reemployment Rights Act (USERRA), 38 U.S.C. 4301, et seq., covered service obligation. The period of absence from work due to or necessitated by USERRA-covered service must be also counted in determining whether the employee has been employed for at least 12 months by the employer. However, this section does not provide any greater entitlement to the employee than would be available under the USERRA; or",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },
    {
      "@id": "urn:rulespec:document-understanding:binding:09595d186d0f3cb9faade29a042da673a77bf768ae8428f2357897a84183d610",
      "@type": "rkaf:EvidenceBinding",
      "rkaf:bindsAssertion": "urn:rulespec:document-understanding:assertion:32cd86d6285f6915ff7eb6287054ffc120cc69aa480a91febb52d7c308049a62",
      "rkaf:evidenceRole": "rkaf:textualEvidence",
      "rkaf:evidentiaryFunction": "rkaf:supports",
      "rkaf:bindsSourceFragment": [

      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:350639a47ba1760aeff7f08b47f57c756fe2f927adcc061fb08e6f8ceb88d2b1",

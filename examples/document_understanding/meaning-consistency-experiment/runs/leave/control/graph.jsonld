      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:31f84fc9de87bea5f82855ac68f0477de7fbf4d4d7da111375df145039bf794c\",\"urn:rulespec:document-understanding:assertion:d139f14f9ae5d9860e65472fc37873b1d87097683f53c2e8a8a2d0813f706d2a\",\"urn:rulespec:document-understanding:assertion:f4f02b0dd8290ee68d80a7e526090d59d6c49886360928eef18e0db5f43a9794\",\"urn:rulespec:document-understanding:assertion:649bb642dc20fff73fc990d862bb21c5cef092f87eb333ea8f4ec9825bc178be\",\"urn:rulespec:document-understanding:assertion:28a11e8f8bd9080b5f747c092ba97a05e70921011abfb6e225e54795e2478c20\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"effective_periods\":[],\"end\":2804,\"evidence\":[{\"end\":2804,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A17e50019a4e77ab1a9c73c9fab8bd1b6da871d60b60c77790e8803a1d9920f62:2419:2804:sha256-668999c51c74d480383126ed520172cea18a50cba1239cdc7337af5ed0e7a425\",\"quote\":\"(4) Nothing in this section prevents employers from considering employment prior to a continuous break in service of more than seven years when determining whether an employee has met the 12-month employment requirement. However, if an employer chooses to recognize such prior employment, the employer must do so uniformly, with respect to all employees with similar breaks in service.\",\"start\":2419},{\"end\":2804,\"field\":\"logic_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A17e50019a4e77ab1a9c73c9fab8bd1b6da871d60b60c77790e8803a1d9920f62:2419:2804:sha256-668999c51c74d480383126ed520172cea18a50cba1239cdc7337af5ed0e7a425\",\"quote\":\"(4) Nothing in this section prevents employers from considering employment prior to a continuous break in service of more than seven years when determining whether an employee has met the 12-month employment requirement. However, if an employer chooses to recognize such prior employment, the employer must do so uniformly, with respect to all employees with similar breaks in service.\",\"start\":2419},{\"end\":2725,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A17e50019a4e77ab1a9c73c9fab8bd1b6da871d60b60c77790e8803a1d9920f62:2721:2725:sha256-4137b01e139589b7a1d3b3fc4da031d8ce5bb415808734e970c3a58ea0e98f0f\",\"quote\":\"must\",\"start\":2721},{\"end\":2804,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A17e50019a4e77ab1a9c73c9fab8bd1b6da871d60b60c77790e8803a1d9920f62:2419:2804:sha256-668999c51c74d480383126ed520172cea18a50cba1239cdc7337af5ed0e7a425\",\"quote\":\"(4) Nothing in this section prevents employers from considering employment prior to a continuous break in service of more than seven years when determining whether an employee has met the 12-month employment requirement. However, if an employer chooses to recognize such prior employment, the employer must do so uniformly, with respect to all employees with similar breaks in service.\",\"start\":2419}],\"id\":\"urn:rulespec:document-understanding:revision:350639a47ba1760aeff7f08b47f57c756fe2f927adcc061fb08e6f8ceb88d2b1\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"(4) Nothing in this section prevents employers from considering employment prior to a continuous break in service of more than seven years when determining whether an employee has met the 12-month employment requirement. However, if an employer chooses to recognize such prior employment, the employer must do so uniformly, with respect to all employees with similar breaks in service.\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:28a11e8f8bd9080b5f747c092ba97a05e70921011abfb6e225e54795e2478c20\",\"modality\":\"must\",\"modality_quote\":\"must\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:23bfab467e60b817b9e686c1d09e1a8e031029a6eb3add7dfe8ff150fb281dfc\",\"origin\":\"aiSuggested\",\"quote\":\"(4) Nothing in this section prevents employers from considering employment prior to a continuous break in service of more than seven years when determining whether an employee has met the 12-month employment requirement. However, if an employer chooses to recognize such prior employment, the employer must do so uniformly, with respect to all employees with similar breaks in service.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:3307d2ef569acd0351d33ea21a99a769c8e9249ff764f61a85f8dfa56015ba67\",\"scope_quotes\":[\"(4) Nothing in this section prevents employers from considering employment prior to a continuous break in service of more than seven years when determining whether an employee has met the 12-month employment requirement. However, if an employer chooses to recognize such prior employment, the employer must do so uniformly, with respect to all employees with similar breaks in service.\"],\"scope_text\":\"Applies if an employer chooses to recognize employment prior to a continuous break in service of more than seven years when determining whether an employee has met the 12-month employment requirement.\",\"section_id\":\"section-1\",\"start\":2419,\"summary\":\"If an employer chooses to recognize employment prior to a continuous break in service of more than seven years, the employer must do so uniformly with respect to all employees with similar breaks in service.\",\"target_ids\":[],\"typed_values\":[]}",

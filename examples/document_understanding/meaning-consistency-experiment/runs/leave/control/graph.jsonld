    {
      "@id": "urn:rulespec:document-understanding:scope:2e434e86a9209c4c1a6cd1a43795207047a570d924cd48e41e5980952c9bf77d",
      "@type": "rkaf:ApplicabilityScope",
      "rkaf:appliesInJurisdiction": [],
      "rkaf:applicabilityCondition": "Applies in determining whether the employee has been employed by the employer for at least 12 months when the employee has experienced a break in service of more than seven years, where either the break was occasioned by USERRA-covered service or a written agreement exists concerning the employer's intention to rehire the employee after the break."
    },
    {
      "@id": "urn:rulespec:document-understanding:assertion:8ddc75961674847769c0575135341a82b39567fc41fbd877fb7d332c8c787ad2",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:5fda77d747042d1a4e328071db40c44694eedab2031442b33432a5cab9b63135",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:f77caaa50c67774dcc9b47c168e20217c308c6912f9495fff4f4489c734e2d14",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:0af752c229945acf146646aeb10dfdfae22cb3b4042e7b6df0c6456656f3afe8",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:states-requirement",
      "rkaf:assertsValue": {
        "@value": "In determining whether an employee has been employed by the employer for at least 12 months, employment periods preceding a break in service of more than seven years must be counted where the employee's break in service is occasioned by the fulfillment of a USERRA (38 U.S.C. 4301 et seq.) covered service obligation, or where a written agreement, including a collective bargaining agreement, exists concerning the employer's intention to rehire the employee after the break in service.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

    {
      "@id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aab45ff8a7d213a548ba64b9bd9efdd9202dcd2f94cc0c1045a1b5fb69fe86460:2012:2057:sha256-38c4807ba6ffa5c128fdddac0b00c44521dbad649b9b41b0c7e648b107744f5a",

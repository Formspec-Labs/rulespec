      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:scope_text",
      "rkaf:assertsValue": {
        "@value": "In checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter, unless all four conditions are met: (i) the passenger declares to the aircraft operator, either orally or in writing, before checking the baggage, that the passenger has a firearm in his or her bag and that it is unloaded; (ii) the firearm is unloaded; (iii) the firearm is carried in a hard-sided container; and (iv) the container in which it is carried is locked, and only the passenger retains the key or combination.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },
    {
      "@id": "urn:rulespec:document-understanding:binding:730fc55c810925fb87caf914005bbc87b57e06930cd90f117829a68dbc9dc9ef",

      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:2617d3ae649f5a9b1bb6999f9e7676702d83d42269ccc693c6a6cb4280b048d4",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:b3b0042f91b076edf39402abb89b4b014da8c60075301e71ef0cc5e561746729",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:048b73d6c7df6b31571db910ab4975c1d365cd3c83d32973ddc7668762237db8",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[\"(1) When performance has begun of the inspection of the individual's person or accessible property before entering a sterile area, or before boarding an aircraft for which screening is conducted under this subchapter;\",\"(2) When the individual is entering or in a sterile area; or\",\"(3) When the individual is attempting to board or onboard an aircraft for which screening is conducted under §§ 1544.201, 1546.201, or 1562.23 of this chapter.\"],\"choice_text\":\"(1) When performance has begun of the inspection of the individual's person or accessible property before entering a sterile area, or before boarding an aircraft for which screening is conducted under this subchapter; (2) When the individual is entering or in a sterile area; or (3) When the individual is attempting to board or onboard an aircraft for which screening is conducted under §§ 1544.201, 1546.201, or 1562.23 of this chapter.\",\"claimants\":[],\"concepts\":[],\"effective_periods\":[],\"jurisdiction\":\"\",\"kind\":\"prohibition\",\"logic_text\":\"(1) When performance has begun of the inspection of the individual's person or accessible property before entering a sterile area, or before boarding an aircraft for which screening is conducted under this subchapter;\\n\\n(2) When the individual is entering or in a sterile area; or\\n\\n(3) When the individual is attempting to board or onboard an aircraft for which screening is conducted under §§ 1544.201, 1546.201, or 1562.23 of this chapter.\",\"modality\":\"must_not\",\"object\":\"\",\"scope_text\":\"Except as provided in paragraph (b) of 49 CFR 1540.111.\",\"summary\":\"Except as provided in paragraph (b) of this section, an individual may not have a weapon, explosive, or incendiary, on or about the individual's person or accessible property when inspection has begun before entering a sterile area or boarding an aircraft screened under this subchapter, when entering or in a sterile area, or when attempting to board or onboard an aircraft screened under §§ 1544.201, 1546.201, or 1562.23.\",\"typed_values\":[]}",
        "@type": "xsd:string"
      },

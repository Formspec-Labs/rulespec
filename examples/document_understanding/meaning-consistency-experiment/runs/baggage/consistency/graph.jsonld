      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[\"(1) When performance has begun of the inspection of the individual's person or accessible property before entering a sterile area, or before boarding an aircraft for which screening is conducted under this subchapter;\",\"(2) When the individual is entering or in a sterile area; or\",\"(3) When the individual is attempting to board or onboard an aircraft for which screening is conducted under §§ 1544.201, 1546.201, or 1562.23 of this chapter.\"],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:3349edacb2796d5d4caa755dd65209b775e7cdec5a3620421bc5fdb5caecafe0\",\"urn:rulespec:document-understanding:assertion:05e46cdd0ee78a2985b274f4aab768dc83a4230311db8ad8c841deadd2572cfb\",\"urn:rulespec:document-understanding:assertion:2407d1c78baed8688be155cb1c1349d7cb42a606e694210939dadb10c26ca1df\",\"urn:rulespec:document-understanding:assertion:12d6369f8e42754c77c1955efa848d0f134f4b5b9e0d53e965fa034876f828de\",\"urn:rulespec:document-understanding:assertion:7207e9c3a3f8e54f535607c9525e21b9a1588b262300459b956255192994c71d\",\"urn:rulespec:document-understanding:assertion:678d361eba7c6257cb443bf33381239e907a1ac0e76109d0b5fe7058b38e6f80\",\"urn:rulespec:document-understanding:assertion:7946f3d7cf3302263b93f36a10798d26bc6de9c2d9523338ff3e091d21f0b375\",\"urn:rulespec:document-understanding:assertion:651d03d303b5d1eb3214a909a37462755d3bacab84dad94a072f12504270473a\",\"urn:rulespec:document-understanding:assertion:e3c8b10e0dd7fcf314f7011e57f8273dfac0b4cb218957f7c6efee182a527ed3\"],\"choice_quote\":\"(1) When performance has begun of the inspection of the individual's person or accessible property before entering a sterile area, or before boarding an aircraft for which screening is conducted under this subchapter;\\n\\n(2) When the individual is entering or in a sterile area; or\\n\\n(3) When the individual is attempting to board or onboard an aircraft for which screening is conducted under §§ 1544.201, 1546.201, or 1562.23 of this chapter.\",\"choice_text\":\"(1) When performance has begun of the inspection of the individual's person or accessible property before entering a sterile area, or before boarding an aircraft for which screening is conducted under this subchapter; (2) When the individual is entering or in a sterile area; or (3) When the individual is attempting to board or onboard an aircraft for which screening is conducted under §§ 1544.201, 1546.201, or 1562.23 of this chapter.\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"effective_periods\":[],\"end\":769,\"evidence\":[{\"end\":769,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aab45ff8a7d213a548ba64b9bd9efdd9202dcd2f94cc0c1045a1b5fb69fe86460:85:769:sha256-f0b5b25a137f7cce76590536680b771afaf6acb0a5936dc368649100eb2ba93d\",\"quote\":\"(a) On an individual's person or accessible property—prohibitions. Except as provided in paragraph (b) of this section, an individual may not have a weapon, explosive, or incendiary, on or about the individual's person or accessible property—\\n\\n(1) When performance has begun of the inspection of the individual's person or accessible property before entering a sterile area, or before boarding an aircraft for which screening is conducted under this subchapter;\\n\\n(2) When the individual is entering or in a sterile area; or\\n\\n(3) When the individual is attempting to board or onboard an aircraft for which screening is conducted under §§ 1544.201, 1546.201, or 1562.23 of this chapter.\",\"start\":85},{\"end\":769,\"field\":\"logic_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aab45ff8a7d213a548ba64b9bd9efdd9202dcd2f94cc0c1045a1b5fb69fe86460:329:769:sha256-22dcfb8db4667ffae9d7a7b17b48ca968730412e4f33fe6a7d2d7577439d118b\",\"quote\":\"(1) When performance has begun of the inspection of the individual's person or accessible property before entering a sterile area, or before boarding an aircraft for which screening is conducted under this subchapter;\\n\\n(2) When the individual is entering or in a sterile area; or\\n\\n(3) When the individual is attempting to board or onboard an aircraft for which screening is conducted under §§ 1544.201, 1546.201, or 1562.23 of this chapter.\",\"start\":329},{\"end\":226,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aab45ff8a7d213a548ba64b9bd9efdd9202dcd2f94cc0c1045a1b5fb69fe86460:219:226:sha256-0007a8bea4dcd3f6b1490fc7199650f1046713dd92d9314e1f2ede6946fcd999\",\"quote\":\"may not\",\"start\":219},{\"end\":769,\"field\":\"choice_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aab45ff8a7d213a548ba64b9bd9efdd9202dcd2f94cc0c1045a1b5fb69fe86460:329:769:sha256-22dcfb8db4667ffae9d7a7b17b48ca968730412e4f33fe6a7d2d7577439d118b\",\"quote\":\"(1) When performance has begun of the inspection of the individual's person or accessible property before entering a sterile area, or before boarding an aircraft for which screening is conducted under this subchapter;\\n\\n(2) When the individual is entering or in a sterile area; or\\n\\n(3) When the individual is attempting to board or onboard an aircraft for which screening is conducted under §§ 1544.201, 1546.201, or 1562.23 of this chapter.\",\"start\":329},{\"end\":327,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aab45ff8a7d213a548ba64b9bd9efdd9202dcd2f94cc0c1045a1b5fb69fe86460:85:327:sha256-a32c8dfb7196d8707007190b60d5fd2a41cfc2faf3efbb1eecb19d61e6401457\",\"quote\":\"(a) On an individual's person or accessible property—prohibitions. Except as provided in paragraph (b) of this section, an individual may not have a weapon, explosive, or incendiary, on or about the individual's person or accessible property—\",\"start\":85},{\"end\":546,\"field\":\"alternative:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aab45ff8a7d213a548ba64b9bd9efdd9202dcd2f94cc0c1045a1b5fb69fe86460:329:546:sha256-d5fe1a750d86ba4e476f3b755b0d6c324a6a6e30d69b292a6b13efb667ae044b\",\"quote\":\"(1) When performance has begun of the inspection of the individual's person or accessible property before entering a sterile area, or before boarding an aircraft for which screening is conducted under this subchapter;\",\"start\":329},{\"end\":608,\"field\":\"alternative:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aab45ff8a7d213a548ba64b9bd9efdd9202dcd2f94cc0c1045a1b5fb69fe86460:548:608:sha256-c139a639c1d605a7d307ad6a66eb81168e6c66c3a021b60c289053565aaa41c2\",\"quote\":\"(2) When the individual is entering or in a sterile area; or\",\"start\":548},{\"end\":769,\"field\":\"alternative:2\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aab45ff8a7d213a548ba64b9bd9efdd9202dcd2f94cc0c1045a1b5fb69fe86460:610:769:sha256-3303604764789bed72f78d4739f5fe14e317e2fcc6c61bed6be2c6efd864dead\",\"quote\":\"(3) When the individual is attempting to board or onboard an aircraft for which screening is conducted under §§ 1544.201, 1546.201, or 1562.23 of this chapter.\",\"start\":610}],\"id\":\"urn:rulespec:document-understanding:revision:5bdb6a8bd6fc1751110870759c07306b16d46ea2519a726451361fc064f0e28f\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"prohibition\",\"logic_text\":\"(1) When performance has begun of the inspection of the individual's person or accessible property before entering a sterile area, or before boarding an aircraft for which screening is conducted under this subchapter;\\n\\n(2) When the individual is entering or in a sterile area; or\\n\\n(3) When the individual is attempting to board or onboard an aircraft for which screening is conducted under §§ 1544.201, 1546.201, or 1562.23 of this chapter.\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:e3c8b10e0dd7fcf314f7011e57f8273dfac0b4cb218957f7c6efee182a527ed3\",\"modality\":\"must_not\",\"modality_quote\":\"may not\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:d280843595708bb916ef6b9737dc46476c7c9c793cf5601e3a9604a137fc5734\",\"origin\":\"aiSuggested\",\"quote\":\"(a) On an individual's person or accessible property—prohibitions. Except as provided in paragraph (b) of this section, an individual may not have a weapon, explosive, or incendiary, on or about the individual's person or accessible property—\\n\\n(1) When performance has begun of the inspection of the individual's person or accessible property before entering a sterile area, or before boarding an aircraft for which screening is conducted under this subchapter;\\n\\n(2) When the individual is entering or in a sterile area; or\\n\\n(3) When the individual is attempting to board or onboard an aircraft for which screening is conducted under §§ 1544.201, 1546.201, or 1562.23 of this chapter.\",\"references\":[\"paragraph (b)\",\"§§ 1544.201\",\"1546.201\",\"1562.23\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:048b73d6c7df6b31571db910ab4975c1d365cd3c83d32973ddc7668762237db8\",\"scope_quotes\":[\"(a) On an individual's person or accessible property—prohibitions. Except as provided in paragraph (b) of this section, an individual may not have a weapon, explosive, or incendiary, on or about the individual's person or accessible property—\"],\"scope_text\":\"Except as provided in paragraph (b) of 49 CFR 1540.111.\",\"section_id\":\"section-1\",\"start\":85,\"summary\":\"Except as provided in paragraph (b) of this section, an individual may not have a weapon, explosive, or incendiary, on or about the individual's person or accessible property when inspection has begun before entering a sterile area or boarding an aircraft screened under this subchapter, when entering or in a sterile area, or when attempting to board or onboard an aircraft screened under §§ 1544.201, 1546.201, or 1562.23.\",\"target_ids\":[],\"typed_values\":[]}",

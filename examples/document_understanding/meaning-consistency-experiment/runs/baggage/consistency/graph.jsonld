      "rkaf:assertsValue": {
        "@value": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[\"(1) Law enforcement personnel required to carry a firearm or other weapons while in the performance of law enforcement duty at the airport.\",\"(2) An individual authorized to carry a weapon in accordance with §§ 1544.219, 1544.221, 1544.223, 1546.211, or subpart B of part 1562 of this chapter.\",\"(3) An individual authorized to carry a weapon in a sterile area under a security program.\"],\"choice_text\":\"(1) Law enforcement personnel required to carry a firearm or other weapons while in the performance of law enforcement duty at the airport; (2) An individual authorized to carry a weapon in accordance with §§ 1544.219, 1544.221, 1544.223, 1546.211, or subpart B of part 1562 of this chapter; or (3) An individual authorized to carry a weapon in a sterile area under a security program.\",\"claimants\":[],\"concepts\":[],\"effective_periods\":[],\"jurisdiction\":\"\",\"kind\":\"exemption\",\"logic_text\":\"(b) On an individual's person or accessible property—permitted carriage of a weapon. Paragraph (a) of this section does not apply as to carriage of firearms and other weapons if the individual is one of the following:\\n\\n(1) Law enforcement personnel required to carry a firearm or other weapons while in the performance of law enforcement duty at the airport.\\n\\n(2) An individual authorized to carry a weapon in accordance with §§ 1544.219, 1544.221, 1544.223, 1546.211, or subpart B of part 1562 of this chapter.\\n\\n(3) An individual authorized to carry a weapon in a sterile area under a security program.\",\"modality\":\"not_required\",\"object\":\"\",\"scope_text\":\"Carriage of firearms and other weapons if the individual is law enforcement personnel required to carry a firearm or other weapons while in the performance of law enforcement duty at the airport, an individual authorized to carry a weapon in accordance with §§ 1544.219, 1544.221, 1544.223, 1546.211, or subpart B of part 1562, or an individual authorized to carry a weapon in a sterile area under a security program.\",\"summary\":\"Paragraph (a) of this section does not apply to the carriage of firearms and other weapons on an individual's person or accessible property if the individual is law enforcement personnel required to carry a weapon while performing duty at the airport, an individual authorized under §§ 1544.219, 1544.221, 1544.223, 1546.211, or subpart B of part 1562, or an individual authorized to carry a weapon in a sterile area under a security program.\",\"typed_values\":[]}",
        "@type": "xsd:string"
      },

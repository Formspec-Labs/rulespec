    {
      "@id": "urn:rulespec:document-understanding:assertion:16ba10d00f74702a8d95b90f60f1c24ba52f93dbebd34f2c8f3e9efb370b62cd",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:2617d3ae649f5a9b1bb6999f9e7676702d83d42269ccc693c6a6cb4280b048d4",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:b3b0042f91b076edf39402abb89b4b014da8c60075301e71ef0cc5e561746729",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:29d951be832920f0eb9d647e227f83acdb15a60e3e851c9c0a55fe546c5f1ea4",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[\"(i) The passenger declares to the aircraft operator, either orally or in writing, before checking the baggage, that the passenger has a firearm in his or her bag and that it is unloaded;\",\"(ii) The firearm is unloaded;\",\"(iii) The firearm is carried in a hard-sided container; and\",\"(iv) The container in which it is carried is locked, and only the passenger retains the key or combination.\"],\"choice_text\":\"Unless all of the following hold: (i) the passenger declares to the aircraft operator, either orally or in writing, before checking the baggage, that the passenger has a firearm in his or her bag and that it is unloaded; (ii) the firearm is unloaded; (iii) the firearm is carried in a hard-sided container; and (iv) the container in which it is carried is locked, and only the passenger retains the key or combination.\",\"claimants\":[],\"concepts\":[],\"effective_periods\":[],\"jurisdiction\":\"\",\"kind\":\"prohibition\",\"logic_text\":\"(2) Any unloaded firearm(s) unless—\\n\\n(i) The passenger declares to the aircraft operator, either orally or in writing, before checking the baggage, that the passenger has a firearm in his or her bag and that it is unloaded;\\n\\n(ii) The firearm is unloaded;\\n\\n(iii) The firearm is carried in a hard-sided container; and\\n\\n(iv) The container in which it is carried is locked, and only the passenger retains the key or combination.\",\"modality\":\"must_not\",\"object\":\"\",\"scope_text\":\"In checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter, unless all four conditions are met: (i) the passenger declares to the aircraft operator, either orally or in writing, before checking the baggage, that the passenger has a firearm in his or her bag and that it is unloaded; (ii) the firearm is unloaded; (iii) the firearm is carried in a hard-sided container; and (iv) the container in which it is carried is locked, and only the passenger retains the key or combination.\",\"summary\":\"A passenger may not transport or offer for transport in checked baggage or baggage carried in an inaccessible cargo hold under § 1562.23 any unloaded firearm(s) unless the passenger declares orally or in writing to the aircraft operator before checking that the bag contains an unloaded firearm, the firearm is unloaded, it is in a hard-sided container, and the container is locked with only the passenger retaining the key or combination.\",\"typed_values\":[]}",
        "@type": "xsd:string"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed",
      "rkaf:hasApplicability": "urn:rulespec:document-understanding:scope:3e367388b25990b9ddc14f135442f14437a812cc70b674b92d70abd167fff9ce"
    },

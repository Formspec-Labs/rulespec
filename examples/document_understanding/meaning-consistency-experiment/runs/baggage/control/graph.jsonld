      "rkaf:assertsValue": {
        "@value": "Governs carriage of firearms and other weapons on or about an individual's person or accessible property if the individual is one of the qualifying individuals specified in paragraphs (b)(1) through (b)(3).",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"

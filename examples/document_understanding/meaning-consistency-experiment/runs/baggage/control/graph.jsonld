      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:94e7836329dd2b7c689eda021fe298ec31adcc1a972f334642148793af753aa9\",\"urn:rulespec:document-understanding:assertion:1a16b18ce4ad1f86bc8328f633b0a893b219ce1fac876ebb47d0b234b0f33792\",\"urn:rulespec:document-understanding:assertion:234352bba41458ea4fce8113de7f38bbe754c0c61e19cedf38743e68d3738b36\",\"urn:rulespec:document-understanding:assertion:ea1936dd5238788edfee69441cec7d26bec5d8c383e875e8656755a23d3b7f63\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[\"49 CFR 1540.111 — Carriage of weapons, explosives, and incendiaries by individuals.\"],\"effective_periods\":[],\"end\":2057,\"evidence\":[{\"end\":2057,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aab45ff8a7d213a548ba64b9bd9efdd9202dcd2f94cc0c1045a1b5fb69fe86460:2012:2057:sha256-38c4807ba6ffa5c128fdddac0b00c44521dbad649b9b41b0c7e648b107744f5a\",\"quote\":\"(3) Any unauthorized explosive or incendiary.\",\"start\":2012},{\"end\":1556,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aab45ff8a7d213a548ba64b9bd9efdd9202dcd2f94cc0c1045a1b5fb69fe86460:1376:1556:sha256-9dd5c9d0feb251838bff5c1a16b3c099ef083ecc7b0fca10625f4c8d5699fdf1\",\"quote\":\"(c) In checked baggage. A passenger may not transport or offer for transport in checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter:\",\"start\":1376},{\"end\":83,\"field\":\"context:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aab45ff8a7d213a548ba64b9bd9efdd9202dcd2f94cc0c1045a1b5fb69fe86460:0:83:sha256-8748cfb8c1a75c1741d970ae0c4db25015a3e4186c6a72c37227b41da243936e\",\"quote\":\"49 CFR 1540.111 — Carriage of weapons, explosives, and incendiaries by individuals.\",\"start\":0}],\"id\":\"urn:rulespec:document-understanding:revision:42287dc564f3ce0f0822812feaa811cc68a6028318099b6037a131ab7a94d0da\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"prohibition\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:ea1936dd5238788edfee69441cec7d26bec5d8c383e875e8656755a23d3b7f63\",\"modality\":\"must_not\",\"modality_quote\":\"may not\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:4d7146265e203ff8edacf6d2c31cf94bfb57eac80d29ecb9592987fe36e9b828\",\"origin\":\"aiSuggested\",\"quote\":\"(3) Any unauthorized explosive or incendiary.\",\"references\":[\"§ 1562.23\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:ec4af3e6a5ec5aa94429eaf63fafb9369dc37454a2910a3d70e46f14b6cc460e\",\"scope_quotes\":[\"(c) In checked baggage. A passenger may not transport or offer for transport in checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter:\"],\"scope_text\":\"In checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter.\",\"section_id\":\"section-1\",\"start\":2012,\"summary\":\"A passenger may not transport or offer for transport in checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter any unauthorized explosive or incendiary.\",\"target_ids\":[],\"typed_values\":[]}",

    {
      "@id": "urn:rulespec:document-understanding:assertion:f91c49a083a73a9c4b6e9cc72a7dd8d0a80fa99f346cfba9180a552b4c2e8f04",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:0bd18546a413c3ddb35e5cf771a14377f561fda38185b3b7c36399705467beb4",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:2596085f2624775df587902e733e45366e605e48033f505c30dd6c02c83f8ef0",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:588d1526e743c498f95a2ca40e36b6e2a0ba04e1135898d742918a84bef3a37a",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[\"(1) When performance has begun of the inspection of the individual's person or accessible property before entering a sterile area, or before boarding an aircraft for which screening is conducted under this subchapter;\",\"(2) When the individual is entering or in a sterile area; or\",\"(3) When the individual is attempting to board or onboard an aircraft for which screening is conducted under §§ 1544.201, 1546.201, or 1562.23 of this chapter.\"],\"choice_text\":\"The prohibition applies under any of the following circumstances: (1) when performance has begun of the inspection of the individual's person or accessible property before entering a sterile area, or before boarding an aircraft screened under this subchapter; (2) when entering or in a sterile area; or (3) when attempting to board or onboard an aircraft screened under §§ 1544.201, 1546.201, or 1562.23.\",\"claimants\":[],\"concepts\":[],\"effective_periods\":[],\"jurisdiction\":\"\",\"kind\":\"prohibition\",\"logic_text\":\"(2) When the individual is entering or in a sterile area; or\",\"modality\":\"must_not\",\"object\":\"\",\"scope_text\":\"Except as provided in paragraph (b) of 49 CFR 1540.111, when performance has begun of the inspection of an individual's person or accessible property before entering a sterile area, or before boarding an aircraft for which screening is conducted under this subchapter; when the individual is entering or in a sterile area; or when the individual is attempting to board or onboard an aircraft for which screening is conducted under §§ 1544.201, 1546.201, or 1562.23 of this chapter.\",\"summary\":\"Except as provided in paragraph (b) of 49 CFR 1540.111, an individual may not have a weapon, explosive, or incendiary, on or about the individual's person or accessible property when inspection has begun before entering a sterile area or boarding a screened aircraft, when entering or in a sterile area, or when attempting to board or onboard a screened aircraft.\",\"typed_values\":[]}",
        "@type": "xsd:string"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed",
      "rkaf:hasApplicability": "urn:rulespec:document-understanding:scope:03c6375dc247878b15700b6cf07069e1f6bf3541132bf4ecdadcdbffa90fe933"
    },

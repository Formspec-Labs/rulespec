      "@id": "urn:rulespec:document-understanding:assertion:98489f8af2b6d9b2c6f67f4e5b4a7c2f52602e772967ad50fc2dbf22ee960d96",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:0bd18546a413c3ddb35e5cf771a14377f561fda38185b3b7c36399705467beb4",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:2596085f2624775df587902e733e45366e605e48033f505c30dd6c02c83f8ef0",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:beec02d2930f7fa4ae00504da451ed2cce0bbb36ff5824cbafe6f7df65ef024a",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:choice_text",
      "rkaf:assertsValue": {
        "@value": "Paragraph (a) does not apply if the individual is: (1) law enforcement personnel required to carry a firearm or other weapons while in the performance of law enforcement duty at the airport; (2) an individual authorized to carry a weapon in accordance with §§ 1544.219, 1544.221, 1544.223, 1546.211, or subpart B of part 1562 of this chapter; or (3) an individual authorized to carry a weapon in a sterile area under a security program.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

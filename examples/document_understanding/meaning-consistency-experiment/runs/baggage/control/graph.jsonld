    {
      "@id": "urn:rulespec:document-understanding:assertion:8f748eabb66416838c8894e87f16e6bf791414c635ad76bb9edacb617d816baf",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:0bd18546a413c3ddb35e5cf771a14377f561fda38185b3b7c36399705467beb4",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:2596085f2624775df587902e733e45366e605e48033f505c30dd6c02c83f8ef0",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:24d6a427a114c2f412a9d66dbc8466a3dda88da7dff920bd0d9f925062bbcbaa",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[\"(i) The passenger declares to the aircraft operator, either orally or in writing, before checking the baggage, that the passenger has a firearm in his or her bag and that it is unloaded;\",\"(ii) The firearm is unloaded;\",\"(iii) The firearm is carried in a hard-sided container; and\",\"(iv) The container in which it is carried is locked, and only the passenger retains the key or combination.\"],\"choice_text\":\"All of the following conditions must be satisfied: (i) passenger declares to aircraft operator orally or in writing before checking baggage that passenger has an unloaded firearm in the bag; (ii) firearm is unloaded; (iii) firearm is carried in a hard-sided container; and (iv) container is locked with only the passenger retaining key or combination.\",\"claimants\":[],\"concepts\":[],\"effective_periods\":[],\"jurisdiction\":\"\",\"kind\":\"prohibition\",\"logic_text\":\"(iii) The firearm is carried in a hard-sided container; and\",\"modality\":\"must_not\",\"object\":\"\",\"scope_text\":\"In checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter, unless all conditions (i) through (iv) are satisfied.\",\"summary\":\"A passenger may not transport or offer for transport in checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter any unloaded firearm(s) unless the passenger declares it to the aircraft operator before checking, the firearm is unloaded, it is carried in a hard-sided container, and the container is locked with only the passenger retaining the key or combination.\",\"typed_values\":[]}",
        "@type": "xsd:string"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed",
      "rkaf:hasApplicability": "urn:rulespec:document-understanding:scope:1815619d233f8803b9c03b79fd5adc1ae5a3428b51aaa05062f9048d6c353fa6"
    },

      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:choice_text",
      "rkaf:assertsValue": {
        "@value": "The prohibition applies under any of the following circumstances: (1) when performance has begun of the inspection of the individual's person or accessible property before entering a sterile area, or before boarding an aircraft screened under this subchapter; (2) when entering or in a sterile area; or (3) when attempting to board or onboard an aircraft screened under §§ 1544.201, 1546.201, or 1562.23.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

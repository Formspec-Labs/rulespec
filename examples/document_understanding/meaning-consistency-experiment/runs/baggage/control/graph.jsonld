    {
      "@id": "urn:rulespec:document-understanding:revision:6e472e1330ef8fd1cccffc560600a378a6121f7769b90e46097c760e87deeadc",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:6e472e1330ef8fd1cccffc560600a378a6121f7769b90e46097c760e87deeadc",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:f168913022d45d4978456e3467db2f839233d5005c923bc662684a0fb0d8603c",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[\"(i) The passenger declares to the aircraft operator, either orally or in writing, before checking the baggage, that the passenger has a firearm in his or her bag and that it is unloaded;\",\"(ii) The firearm is unloaded;\",\"(iii) The firearm is carried in a hard-sided container; and\",\"(iv) The container in which it is carried is locked, and only the passenger retains the key or combination.\"],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:ffc6d0410ab6436a9f55c4d8344ad596a23927cdaff7f124455a13a9cf081cbf\",\"urn:rulespec:document-understanding:assertion:8284d93695410af0c8fbb9b4fcd3bf30c17dd9df370f0587aafa9bd7fe032cb1\",\"urn:rulespec:document-understanding:assertion:9aaceffb55d3172e5b44d56727ba684d9f12f2583b1728645e603ae277a8af45\",\"urn:rulespec:document-understanding:assertion:fd7c70225e2b5ad567ce03b9a1203e32a317a266c5b3888dee782cd2950973e3\",\"urn:rulespec:document-understanding:assertion:be97a1a1a6e29e2f04666e8d706c818c2d4fc7815aaca49109e3651e5841ecd8\",\"urn:rulespec:document-understanding:assertion:d6e9405befcb94083d2fcd043cff68cb938d2522d826714ade12113b1e92997f\",\"urn:rulespec:document-understanding:assertion:3f4b49f08d70bd8f6eed54790d6828d03f6a590fdb5ec5b2ae411a6341561d41\",\"urn:rulespec:document-understanding:assertion:75ffc340265efd9e85522c3bb9fa199b9fd2f76c159b4d74d04cb9840cdd3319\",\"urn:rulespec:document-understanding:assertion:76c25866afc2da92a58bae55fb06e528476d332856e0f49288629668d251df88\",\"urn:rulespec:document-understanding:assertion:8f748eabb66416838c8894e87f16e6bf791414c635ad76bb9edacb617d816baf\"],\"choice_quote\":\"(2) Any unloaded firearm(s) unless—\\n\\n(i) The passenger declares to the aircraft operator, either orally or in writing, before checking the baggage, that the passenger has a firearm in his or her bag and that it is unloaded;\\n\\n(ii) The firearm is unloaded;\\n\\n(iii) The firearm is carried in a hard-sided container; and\\n\\n(iv) The container in which it is carried is locked, and only the passenger retains the key or combination.\",\"choice_text\":\"All of the following conditions must be satisfied: (i) passenger declares to aircraft operator orally or in writing before checking baggage that passenger has an unloaded firearm in the bag; (ii) firearm is unloaded; (iii) firearm is carried in a hard-sided container; and (iv) container is locked with only the passenger retaining key or combination.\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[\"49 CFR 1540.111 — Carriage of weapons, explosives, and incendiaries by individuals.\"],\"effective_periods\":[],\"end\":1621,\"evidence\":[{\"end\":1621,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aab45ff8a7d213a548ba64b9bd9efdd9202dcd2f94cc0c1045a1b5fb69fe86460:1586:1621:sha256-a03b234b39a7e3d902b46246302bd2c0d5986a277e51dcd12feeb18f5483f16c\",\"quote\":\"(2) Any unloaded firearm(s) unless—\",\"start\":1586},{\"end\":1901,\"field\":\"logic_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aab45ff8a7d213a548ba64b9bd9efdd9202dcd2f94cc0c1045a1b5fb69fe86460:1842:1901:sha256-e6a871e22fdb4f04a0b00e20075aa0b5b737e6d1cb0fd25f4f29d5a90551bd62\",\"quote\":\"(iii) The firearm is carried in a hard-sided container; and\",\"start\":1842},{\"end\":2010,\"field\":\"choice_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aab45ff8a7d213a548ba64b9bd9efdd9202dcd2f94cc0c1045a1b5fb69fe86460:1586:2010:sha256-55445821b85174dd35baccbe029635bc4b535d4c2fb27e8faef334a78e47a106\",\"quote\":\"(2) Any unloaded firearm(s) unless—\\n\\n(i) The passenger declares to the aircraft operator, either orally or in writing, before checking the baggage, that the passenger has a firearm in his or her bag and that it is unloaded;\\n\\n(ii) The firearm is unloaded;\\n\\n(iii) The firearm is carried in a hard-sided container; and\\n\\n(iv) The container in which it is carried is locked, and only the passenger retains the key or combination.\",\"start\":1586},{\"end\":1556,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aab45ff8a7d213a548ba64b9bd9efdd9202dcd2f94cc0c1045a1b5fb69fe86460:1376:1556:sha256-9dd5c9d0feb251838bff5c1a16b3c099ef083ecc7b0fca10625f4c8d5699fdf1\",\"quote\":\"(c) In checked baggage. A passenger may not transport or offer for transport in checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter:\",\"start\":1376},{\"end\":2010,\"field\":\"scope_text:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aab45ff8a7d213a548ba64b9bd9efdd9202dcd2f94cc0c1045a1b5fb69fe86460:1586:2010:sha256-55445821b85174dd35baccbe029635bc4b535d4c2fb27e8faef334a78e47a106\",\"quote\":\"(2) Any unloaded firearm(s) unless—\\n\\n(i) The passenger declares to the aircraft operator, either orally or in writing, before checking the baggage, that the passenger has a firearm in his or her bag and that it is unloaded;\\n\\n(ii) The firearm is unloaded;\\n\\n(iii) The firearm is carried in a hard-sided container; and\\n\\n(iv) The container in which it is carried is locked, and only the passenger retains the key or combination.\",\"start\":1586},{\"end\":83,\"field\":\"context:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aab45ff8a7d213a548ba64b9bd9efdd9202dcd2f94cc0c1045a1b5fb69fe86460:0:83:sha256-8748cfb8c1a75c1741d970ae0c4db25015a3e4186c6a72c37227b41da243936e\",\"quote\":\"49 CFR 1540.111 — Carriage of weapons, explosives, and incendiaries by individuals.\",\"start\":0},{\"end\":1809,\"field\":\"alternative:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aab45ff8a7d213a548ba64b9bd9efdd9202dcd2f94cc0c1045a1b5fb69fe86460:1623:1809:sha256-f6fe03740da837c967d5e1a19cc83bd62f4517d0b086d968201a40859ccf0a16\",\"quote\":\"(i) The passenger declares to the aircraft operator, either orally or in writing, before checking the baggage, that the passenger has a firearm in his or her bag and that it is unloaded;\",\"start\":1623},{\"end\":1840,\"field\":\"alternative:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aab45ff8a7d213a548ba64b9bd9efdd9202dcd2f94cc0c1045a1b5fb69fe86460:1811:1840:sha256-728d008fcfc79639161d8c2b1d0a6f86e145e04143be6ec504ef19d73771e1d6\",\"quote\":\"(ii) The firearm is unloaded;\",\"start\":1811},{\"end\":1901,\"field\":\"alternative:2\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aab45ff8a7d213a548ba64b9bd9efdd9202dcd2f94cc0c1045a1b5fb69fe86460:1842:1901:sha256-e6a871e22fdb4f04a0b00e20075aa0b5b737e6d1cb0fd25f4f29d5a90551bd62\",\"quote\":\"(iii) The firearm is carried in a hard-sided container; and\",\"start\":1842},{\"end\":2010,\"field\":\"alternative:3\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aab45ff8a7d213a548ba64b9bd9efdd9202dcd2f94cc0c1045a1b5fb69fe86460:1903:2010:sha256-8522eb345b969daa7d941fb54eecd07d2803856ad5eac836d5b26f452a52a60f\",\"quote\":\"(iv) The container in which it is carried is locked, and only the passenger retains the key or combination.\",\"start\":1903}],\"id\":\"urn:rulespec:document-understanding:revision:6e472e1330ef8fd1cccffc560600a378a6121f7769b90e46097c760e87deeadc\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"prohibition\",\"logic_text\":\"(iii) The firearm is carried in a hard-sided container; and\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:8f748eabb66416838c8894e87f16e6bf791414c635ad76bb9edacb617d816baf\",\"modality\":\"must_not\",\"modality_quote\":\"may not\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:48144fed38ee1c77b88b5b3c0f7528a77e2e2b89e28968c03e516aa52a66ed96\",\"origin\":\"aiSuggested\",\"quote\":\"(2) Any unloaded firearm(s) unless—\",\"references\":[\"§ 1562.23\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:24d6a427a114c2f412a9d66dbc8466a3dda88da7dff920bd0d9f925062bbcbaa\",\"scope_quotes\":[\"(c) In checked baggage. A passenger may not transport or offer for transport in checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter:\",\"(2) Any unloaded firearm(s) unless—\\n\\n(i) The passenger declares to the aircraft operator, either orally or in writing, before checking the baggage, that the passenger has a firearm in his or her bag and that it is unloaded;\\n\\n(ii) The firearm is unloaded;\\n\\n(iii) The firearm is carried in a hard-sided container; and\\n\\n(iv) The container in which it is carried is locked, and only the passenger retains the key or combination.\"],\"scope_text\":\"In checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter, unless all conditions (i) through (iv) are satisfied.\",\"section_id\":\"section-1\",\"start\":1586,\"summary\":\"A passenger may not transport or offer for transport in checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter any unloaded firearm(s) unless the passenger declares it to the aircraft operator before checking, the firearm is unloaded, it is carried in a hard-sided container, and the container is locked with only the passenger retaining the key or combination.\",\"target_ids\":[],\"typed_values\":[]}",

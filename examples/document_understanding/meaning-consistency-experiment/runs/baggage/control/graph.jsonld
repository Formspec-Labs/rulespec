    {
      "@id": "urn:rulespec:document-understanding:scope:1815619d233f8803b9c03b79fd5adc1ae5a3428b51aaa05062f9048d6c353fa6",
      "@type": "rkaf:ApplicabilityScope",
      "rkaf:appliesInJurisdiction": [],
      "rkaf:applicabilityCondition": "In checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter, unless all conditions (i) through (iv) are satisfied."
    },
    {
      "@id": "urn:rulespec:document-understanding:assertion:ffc6d0410ab6436a9f55c4d8344ad596a23927cdaff7f124455a13a9cf081cbf",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:0bd18546a413c3ddb35e5cf771a14377f561fda38185b3b7c36399705467beb4",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:2596085f2624775df587902e733e45366e605e48033f505c30dd6c02c83f8ef0",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:24d6a427a114c2f412a9d66dbc8466a3dda88da7dff920bd0d9f925062bbcbaa",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:states-prohibition",
      "rkaf:assertsValue": {
        "@value": "A passenger may not transport or offer for transport in checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter any unloaded firearm(s) unless the passenger declares it to the aircraft operator before checking, the firearm is unloaded, it is carried in a hard-sided container, and the container is locked with only the passenger retaining the key or combination.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

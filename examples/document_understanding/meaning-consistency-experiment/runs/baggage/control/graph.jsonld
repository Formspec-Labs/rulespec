    {
      "@id": "urn:rulespec:document-understanding:scope:8a561bd5a9c1690e9f4e0725aca0ec57d5af432dd9e921819611f78b185ebb76",
      "@type": "rkaf:ApplicabilityScope",
      "rkaf:appliesInJurisdiction": [],
      "rkaf:applicabilityCondition": "Governs carriage of firearms and other weapons on or about an individual's person or accessible property if the individual is one of the qualifying individuals specified in paragraphs (b)(1) through (b)(3)."
    },
    {
      "@id": "urn:rulespec:document-understanding:assertion:24e9b6c10af430ab0f0065ce64d38a946f1ee06e5d91314bca7388c7d8352b6c",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:0bd18546a413c3ddb35e5cf771a14377f561fda38185b3b7c36399705467beb4",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:2596085f2624775df587902e733e45366e605e48033f505c30dd6c02c83f8ef0",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:beec02d2930f7fa4ae00504da451ed2cce0bbb36ff5824cbafe6f7df65ef024a",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:states-exemption",
      "rkaf:assertsValue": {
        "@value": "Paragraph (a) of 49 CFR 1540.111 does not apply to the carriage of firearms and other weapons on or about an individual's person or accessible property if the individual is law enforcement personnel required to carry a weapon on duty at the airport, an individual authorized under specified regulations, or an individual authorized to carry a weapon in a sterile area under a security program.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

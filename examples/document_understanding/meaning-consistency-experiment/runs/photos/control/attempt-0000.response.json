            "text": "{\n  \"extractions\": [\n    {\n      \"unit\": \"F000\",\n      \"unit_attributes\": {\n        \"kind\": \"statement\",\n        \"scope_quotes\": [\n          \"F000\"\n        ],\n        \"scope_text\": \"When photographing infants or evaluating infant passport photographs.\",\n        \"context_quotes\": [],\n        \"modality_quote\": \"\",\n        \"modality\": \"not_stated\",\n        \"alternative_quotes\": [],\n        \"choice_quote\": \"\",\n        \"choice_text\": \"\",\n        \"logic_quote\": \"\",\n        \"references\": [],\n        \"statement\": \"Infants pose a particular challenge, and the goal is the best likeness that can reasonably be obtained.\"\n      }\n    },\n    {\n      \"unit\": \"F001\",\n      \"unit_attributes\": {\n        \"kind\": \"permission\",\n        \"scope_quotes\": [\n          \"F000\",\n          \"F001\"\n        ],\n        \"scope_text\": \"In a photograph of an infant, particularly a newborn.\",\n        \"context_quotes\": [\n          \"F000\"\n        ],\n        \"modality_quote\": \"is acceptable\",\n        \"modality\": \"may\",\n        \"alternative_quotes\": [\n          \"F001\"\n        ],\n        \"choice_quote\": \"F001\",\n        \"choice_text\": \"partially or completely closed\",\n        \"logic_quote\": \"F001\",\n        \"references\": [],\n        \"statement\": \"It is acceptable if the infant's eyes, particularly a newborn's, are partially or completely closed in the photograph.\"\n      }\n    },\n    {\n      \"unit\": \"F002\",\n      \"unit_attributes\": {\n        \"kind\": \"permission\",\n        \"scope_quotes\": [\n          \"F000\",\n          \"F002\"\n        ],\n        \"scope_text\": \"In a photograph of an infant.\",\n        \"context_quotes\": [\n          \"F000\"\n        ],\n        \"modality_quote\": \"may\",\n        \"modality\": \"may\",\n        \"alternative_quotes\": [\n          \"F002\"\n        ],\n        \"choice_quote\": \"F002\",\n        \"choice_text\": \"a white or off-white blanket\",\n        \"logic_quote\": \"F002\",\n        \"references\": [],\n        \"statement\": \"The infant's head may be discreetly supported in the photograph, such as using a car seat with a white or off-white blanket behind the child.\"\n      }\n    },\n    {\n      \"unit\": \"F002\",\n      \"unit_attributes\": {\n        \"kind\": \"permission\",\n        \"scope_quotes\": [\n          \"F000\",\n          \"F002\"\n        ],\n        \"scope_text\": \"For infant photographs.\",\n        \"context_quotes\": [\n          \"F000\"\n        ],\n        \"modality_quote\": \"is acceptable\",\n        \"modality\": \"may\",\n        \"alternative_quotes\": [],\n        \"choice_quote\": \"\",\n        \"choice_text\": \"\",\n        \"logic_quote\": \"\",\n        \"references\": [],\n        \"statement\": \"Head tilt is acceptable for infants in passport photographs.\"\n      }\n    },\n    {\n      \"unit\": \"F003\",\n      \"unit_attributes\": {\n        \"kind\": \"prohibition\",\n        \"scope_quotes\": [\n          \"F000\",\n          \"F003\"\n        ],\n        \"scope_text\": \"In the photograph of an infant.\",\n        \"context_quotes\": [\n          \"F000\"\n        ],\n        \"modality_quote\": \"cannot\",\n        \"modality\": \"must_not\",\n        \"alternative_quotes\": [],\n        \"choice_quote\": \"\",\n        \"choice_text\": \"\",\n        \"logic_quote\": \"F003\",\n        \"references\": [],\n        \"statement\": \"A parent's face cannot be in the photograph of the infant.\"\n      }\n    },\n    {\n      \"unit\": \"F004\",\n      \"unit_attributes\": {\n        \"kind\": \"requirement\",\n        \"scope_quotes\": [\n          \"F004\"\n        ],\n        \"scope_text\": \"If the photograph submitted does not meet the specified requirements.\",\n        \"context_quotes\": [],\n        \"modality_quote\": \"must\",\n        \"modality\": \"must\",\n        \"alternative_quotes\": [],\n        \"choice_quote\": \"\",\n        \"choice_text\": \"\",\n        \"logic_quote\": \"F004\",\n        \"references\": [],\n        \"statement\": \"You must request a new photograph if the photograph submitted does not meet the specified requirements.\"\n      }\n    },\n    {\n      \"unit\": \"F005\",\n      \"unit_attributes\": {\n        \"kind\": \"requirement\",\n        \"scope_quotes\": [\n          \"F004\",\n          \"F005\"\n        ],\n        \"scope_text\": \"For a submitted passport photograph.\",\n        \"context_quotes\": [\n          \"F004\"\n        ],\n        \"modality_quote\": \"must\",\n        \"modality\": \"must\",\n        \"alternative_quotes\": [],\n        \"choice_quote\": \"\",\n        \"choice_text\": \"\",\n        \"logic_quote\": \"\",\n        \"references\": [],\n        \"statement\": \"The photograph must be in color.\"\n      }\n    },\n    {\n      \"unit\": \"F006\",\n      \"unit_attributes\": {\n        \"kind\": \"recommendation\",\n        \"scope_quotes\": [\n          \"F004\",\n          \"F006\"\n        ],\n        \"scope_text\": \"For a submitted passport photograph.\",\n        \"context_quotes\": [\n          \"F004\"\n        ],\n        \"modality_quote\": \"should\",\n        \"modality\": \"should\",\n        \"alternative_quotes\": [],\n        \"choice_quote\": \"\",\n        \"choice_text\": \"\",\n        \"logic_quote\": \"F006\",\n        \"references\": [\n          \"22 CFR 51.26\"\n        ],\n        \"statement\": \"The photograph should be taken within six months of submitting the application, be a good likeness of, and satisfactorily identify the applicant at the time of the application.\"\n      }\n    },\n    {\n      \"unit\": \"F006\",\n      \"unit_attributes\": {\n        \"kind\": \"permission\",\n        \"scope_quotes\": [\n          \"F004\",\n          \"F006\"\n        ],\n        \"scope_text\": \"For a submitted photograph showing a change in hairstyle or facial hair from the submitted identification document, provided that it still is a good likeness of the applicant.\",\n        \"context_quotes\": [\n          \"F004\"\n        ],\n        \"modality_quote\": \"is acceptable\",\n        \"modality\": \"may\",\n        \"alternative_quotes\": [\n          \"F006\"\n        ],\n        \"choice_quote\": \"F006\",\n        \"choice_text\": \"hairstyle or facial hair\",\n        \"logic_quote\": \"F006\",\n        \"references\": [],\n        \"statement\": \"A photograph showing a change in hairstyle or facial hair from the identification document submitted is acceptable if it still is a good likeness of the applicant.\"\n      }\n    },\n    {\n      \"unit\": \"F007\",\n      \"unit_attributes\": {\n        \"kind\": \"statement\",\n        \"scope_quotes\": [\n          \"F007\"\n        ],\n        \"scope_text\": \"For applicants submitting a U.S. Certificate of Citizenship or Certificate of Naturalization.\",\n        \"context_quotes\": [],\n        \"modality_quote\": \"may\",\n        \"modality\": \"possible\",\n        \"alternative_quotes\": [\n          \"F007\"\n        ],\n        \"choice_quote\": \"F007\",\n        \"choice_text\": \"U.S Certificate of Citizenship or Certificate of Naturalization\",\n        \"logic_quote\": \"F007\",\n        \"references\": [],\n        \"statement\": \"Applicants may wish to re-use a passport photograph that is depicted on their submitted U.S. Certificate of Citizenship or Certificate of Naturalization.\"\n      }\n    },\n    {\n      \"unit\": \"F007\",\n      \"unit_attributes\": {\n        \"kind\": \"statement\",\n        \"scope_quotes\": [\n          \"F007\"\n        ],\n        \"scope_text\": \"When an applicant seeks to re-use a photograph depicted on a submitted U.S. Certificate of Citizenship or Certificate of Naturalization, even if the certificate itself was recently issued.\",\n        \"context_quotes\": [],\n        \"modality_quote\": \"may not\",\n        \"modality\": \"possible\",\n        \"alternative_quotes\": [],\n        \"choice_quote\": \"\",\n        \"choice_text\": \"\",\n        \"logic_quote\": \"F007\",\n        \"references\": [],\n        \"statement\": \"Even if a submitted U.S. Certificate of Citizenship or Certificate of Naturalization itself was recently issued, because of U.S. Citizenship and Immigration Services processing times, the depicted photograph may not have been taken within six months of submitting the application.\"\n      }\n    }\n  ]\n}",

        "@value": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"effective_periods\":[],\"jurisdiction\":\"\",\"kind\":\"statement\",\"logic_text\":\"NOTE: Applicants may wish to re-use a passport photograph that is depicted on their submitted U.S Certificate of Citizenship or Certificate of Naturalization. Be aware that even if the certificate itself was recently issued, because of U.S. Citizenship and Immigration Services processing times, the photograph may not have been taken within six months of submitting the application.\",\"modality\":\"possible\",\"object\":\"\",\"scope_text\":\"When an applicant seeks to re-use a photograph depicted on a submitted U.S. Certificate of Citizenship or Certificate of Naturalization, even if the certificate itself was recently issued.\",\"summary\":\"Even if a submitted U.S. Certificate of Citizenship or Certificate of Naturalization itself was recently issued, because of U.S. Citizenship and Immigration Services processing times, the depicted photograph may not have been taken within six months of submitting the application.\",\"typed_values\":[]}",

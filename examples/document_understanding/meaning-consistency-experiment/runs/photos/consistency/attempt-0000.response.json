            "text": "{\"extractions\":[{\"unit\":\"F000\",\"unit_attributes\":{\"kind\":\"statement\",\"scope_quotes\":[],\"scope_text\":\"\",\"context_quotes\":[],\"modality_quote\":\"\",\"modality\":\"not_stated\",\"alternative_quotes\":[],\"choice_quote\":\"\",\"choice_text\":\"\",\"logic_quote\":\"\",\"references\":[],\"statement\":\"Infants pose a particular challenge, and the goal is the best likeness that can reasonably be obtained.\"}},{\"unit\":\"F001\",\"unit_attributes\":{\"kind\":\"permission\",\"scope_quotes\":[\"F000\"],\"scope_text\":\"In photographs of infants, where the goal is the best likeness that can reasonably be obtained.\",\"context_quotes\":[],\"modality_quote\":\"acceptable\",\"modality\":\"may\",\"alternative_quotes\":[\"F001\"],\"choice_quote\":\"F001\",\"choice_text\":\"Partially or completely closed eyes, particularly for a newborn.\",\"logic_quote\":\"F001\",\"references\":[],\"statement\":\"It is acceptable if an infant's eyes, particularly a newborn's, are partially or completely closed in the photograph.\"}},{\"unit\":\"F002\",\"unit_attributes\":{\"kind\":\"permission\",\"scope_quotes\":[\"F000\"],\"scope_text\":\"In photographs of infants.\",\"context_quotes\":[],\"modality_quote\":\"may\",\"modality\":\"may\",\"alternative_quotes\":[],\"choice_quote\":\"\",\"choice_text\":\"\",\"logic_quote\":\"\",\"references\":[],\"statement\":\"The infant's head may be discreetly supported, for example using a car seat with a white or off-white blanket behind the child.\"}},{\"unit\":\"F002\",\"unit_attributes\":{\"kind\":\"permission\",\"scope_quotes\":[\"F000\"],\"scope_text\":\"In photographs of infants.\",\"context_quotes\":[],\"modality_quote\":\"acceptable\",\"modality\":\"may\",\"alternative_quotes\":[],\"choice_quote\":\"\",\"choice_text\":\"\",\"logic_quote\":\"\",\"references\":[],\"statement\":\"Head tilt is acceptable for infants.\"}},{\"unit\":\"F003\",\"unit_attributes\":{\"kind\":\"prohibition\",\"scope_quotes\":[\"F000\"],\"scope_text\":\"In photographs of infants.\",\"context_quotes\":[],\"modality_quote\":\"cannot\",\"modality\":\"must_not\",\"alternative_quotes\":[],\"choice_quote\":\"\",\"choice_text\":\"\",\"logic_quote\":\"F003\",\"references\":[],\"statement\":\"A parent's face cannot be in the photograph of the infant.\"}},{\"unit\":\"F004\",\"unit_attributes\":{\"kind\":\"requirement\",\"scope_quotes\":[\"F004:F006\"],\"scope_text\":\"If the photograph submitted does not meet the specified requirements: being in color, and being taken within six months of submitting the application, being a good likeness of, and satisfactorily identifying the applicant at the time of the application.\",\"context_quotes\":[],\"modality_quote\":\"must\",\"modality\":\"must\",\"alternative_quotes\":[],\"choice_quote\":\"\",\"choice_text\":\"\",\"logic_quote\":\"F004:F006\",\"references\":[],\"statement\":\"You must request a new photograph if the photograph submitted does not meet the specified requirements.\"}},{\"unit\":\"F005\",\"unit_attributes\":{\"kind\":\"requirement\",\"scope_quotes\":[\"F004\"],\"scope_text\":\"For a photograph submitted with an application.\",\"context_quotes\":[],\"modality_quote\":\"must\",\"modality\":\"must\",\"alternative_quotes\":[],\"choice_quote\":\"\",\"choice_text\":\"\",\"logic_quote\":\"\",\"references\":[],\"statement\":\"The photograph must be in color.\"}},{\"unit\":\"F006\",\"unit_attributes\":{\"kind\":\"recommendation\",\"scope_quotes\":[\"F004\"],\"scope_text\":\"For a photograph submitted with an application.\",\"context_quotes\":[],\"modality_quote\":\"should\",\"modality\":\"should\",\"alternative_quotes\":[],\"choice_quote\":\"\",\"choice_text\":\"\",\"logic_quote\":\"F006\",\"references\":[\"22 CFR 51.26\"],\"statement\":\"The photograph should be taken within six months of submitting the application, be a good likeness of, and satisfactorily identify the applicant at the time of the application.\"}},{\"unit\":\"F006\",\"unit_attributes\":{\"kind\":\"permission\",\"scope_quotes\":[\"F006\"],\"scope_text\":\"If the photograph still is a good likeness of the applicant.\",\"context_quotes\":[],\"modality_quote\":\"acceptable\",\"modality\":\"may\",\"alternative_quotes\":[\"F006\"],\"choice_quote\":\"F006\",\"choice_text\":\"A photograph showing a change in hairstyle or facial hair from the identification document submitted.\",\"logic_quote\":\"F006\",\"references\":[],\"statement\":\"A photograph showing a change in hairstyle or facial hair from the identification document submitted is acceptable if it still is a good likeness of the applicant.\"}},{\"unit\":\"F007\",\"unit_attributes\":{\"kind\":\"statement\",\"scope_quotes\":[\"F007\"],\"scope_text\":\"When applicants wish to re-use a passport photograph that is depicted on their submitted U.S. Certificate of Citizenship or Certificate of Naturalization, even if the certificate itself was recently issued.\",\"context_quotes\":[],\"modality_quote\":\"may not\",\"modality\":\"possible\",\"alternative_quotes\":[],\"choice_quote\":\"\",\"choice_text\":\"\",\"logic_quote\":\"F007\",\"references\":[],\"statement\":\"Even if a submitted U.S. Certificate of Citizenship or Certificate of Naturalization was recently issued, because of U.S. Citizenship and Immigration Services processing times, the depicted photograph may not have been taken within six months of submitting the application.\"}}]}",

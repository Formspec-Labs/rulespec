ng%3Adocument%3A1a47a76c521a93dcac7e7e6d3fb8e2bcef821725a1aa174ee419d39827b0ff4a:0:102:sha256-d5352952c35d27ead43ba84f11e560e73e7604cc8f5e1991855c69f726f1417f\",\"quote\":\"d. Infants pose a particular challenge. The goal is the best likeness that can reasonably be obtained:\",\"start\":0}],\"id\":\"urn:rulespec:document-understanding:revision:3018360f5c5549b5d07787b7760ec27ba4ec87d60578a0e7068b50d6d44ff51c\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"prohibition\",\"logic_text\":\"(3) A parent’s face cannot be in the photograph of the infant.\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:68c9fdc4b3711d819d4a6b50a6361faa0b48be7e27fd8cbb5faec94b45887e14\",\"modality\":\"must_not\",\"modality_quote\":\"cannot\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:710bd97727d0e79bb748bddc9cd5eed2d9f77ffa63a0f5f77a495f0d593ad9e5\",\"origin\":\"aiSuggested\",\"quote\":\"(3) A parent’s face cannot be in the photograph of the infant.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:d7837468fcfb05515fa4841f6d928ed5d2795f2e08a7a360a3cc28624513dda7\",\"scope_quotes\":[\"d. Infants pose a particular challenge. The goal is the best likeness that can reasonably be obtained:\"],\"scope_text\":\"In photographs of infants.\",\"section_id\":\"section-1\",\"start\":372,\"summary\":\"A parent's face cannot be in the photograph of the infant.\",\"target_ids\":[],\"typed_values\":[]}",

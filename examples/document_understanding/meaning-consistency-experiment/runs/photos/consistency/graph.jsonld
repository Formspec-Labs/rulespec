    {
      "@id": "urn:rulespec:document-understanding:revision:e4e3144950794fb7b233d0bb264fe4c879ea5c2919c85020cdf3e0db7b234e9c",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:e4e3144950794fb7b233d0bb264fe4c879ea5c2919c85020cdf3e0db7b234e9c",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:b1845811ec9de914303f6e80ee7a3ea7441084059c26aed5038fef5c8274e04b",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:214c5e581b6a9021fe7c875e8c4d65672ba1766908aa71df0405ba99815ba85a\",\"urn:rulespec:document-understanding:assertion:083dd68365a05d3a4962c3ff8eee0a79f58398a8cbec64f3c92151dcc843a346\",\"urn:rulespec:document-understanding:assertion:bf8a671eb8557ed3b44824becf7214468f878848b96a261d94baca2024ff52f4\",\"urn:rulespec:document-understanding:assertion:7be0e91d6b6eca299d6758cd0ae0d06c41edc1643f661bdc8bae4a5c1377e197\",\"urn:rulespec:document-understanding:assertion:25eccb2d77e8234e956a4ae092eb554fc5367014ead9406a3731309536311f65\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"effective_periods\":[],\"end\":539,\"evidence\":[{\"end\":539,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A1a47a76c521a93dcac7e7e6d3fb8e2bcef821725a1aa174ee419d39827b0ff4a:436:539:sha256-7f0fa99d97951a139f33ec44a19b323846e2dfb0edb6a59ea10b8060a5799c86\",\"quote\":\"You must request a new photograph if the photograph submitted does not meet the following requirements:\",\"start\":436},{\"end\":941,\"field\":\"logic_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A1a47a76c521a93dcac7e7e6d3fb8e2bcef821725a1aa174ee419d39827b0ff4a:436:941:sha256-63d38706241108a50fe116e7469b51373211b9767f9c2f1d7c414976aa9afa93\",\"quote\":\"You must request a new photograph if the photograph submitted does not meet the following requirements:\\n\\n(1) The photograph must be in color;\\n\\n(2) The photograph should be taken within six months of submitting the application, be a good likeness of and satisfactorily identify the applicant at the time of the application (see 22 CFR 51.26). A photograph showing a change in hairstyle or facial hair from the identification document submitted is acceptable if it still is a good likeness of the applicant;\",\"start\":436},{\"end\":444,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A1a47a76c521a93dcac7e7e6d3fb8e2bcef821725a1aa174ee419d39827b0ff4a:440:444:sha256-4137b01e139589b7a1d3b3fc4da031d8ce5bb415808734e970c3a58ea0e98f0f\",\"quote\":\"must\",\"start\":440},{\"end\":941,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A1a47a76c521a93dcac7e7e6d3fb8e2bcef821725a1aa174ee419d39827b0ff4a:436:941:sha256-63d38706241108a50fe116e7469b51373211b9767f9c2f1d7c414976aa9afa93\",\"quote\":\"You must request a new photograph if the photograph submitted does not meet the following requirements:\\n\\n(1) The photograph must be in color;\\n\\n(2) The photograph should be taken within six months of submitting the application, be a good likeness of and satisfactorily identify the applicant at the time of the application (see 22 CFR 51.26). A photograph showing a change in hairstyle or facial hair from the identification document submitted is acceptable if it still is a good likeness of the applicant;\",\"start\":436}],\"id\":\"urn:rulespec:document-understanding:revision:e4e3144950794fb7b233d0bb264fe4c879ea5c2919c85020cdf3e0db7b234e9c\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"You must request a new photograph if the photograph submitted does not meet the following requirements:\\n\\n(1) The photograph must be in color;\\n\\n(2) The photograph should be taken within six months of submitting the application, be a good likeness of and satisfactorily identify the applicant at the time of the application (see 22 CFR 51.26). A photograph showing a change in hairstyle or facial hair from the identification document submitted is acceptable if it still is a good likeness of the applicant;\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:25eccb2d77e8234e956a4ae092eb554fc5367014ead9406a3731309536311f65\",\"modality\":\"must\",\"modality_quote\":\"must\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:279e5ef880d7d5bba7fa2cf54c2d8edf9b002ff95c3db02922bdf8819791280b\",\"origin\":\"aiSuggested\",\"quote\":\"You must request a new photograph if the photograph submitted does not meet the following requirements:\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:ac5a609be8af80f5f3a051680376351df391d92e8559735738601b35344b597b\",\"scope_quotes\":[\"You must request a new photograph if the photograph submitted does not meet the following requirements:\\n\\n(1) The photograph must be in color;\\n\\n(2) The photograph should be taken within six months of submitting the application, be a good likeness of and satisfactorily identify the applicant at the time of the application (see 22 CFR 51.26). A photograph showing a change in hairstyle or facial hair from the identification document submitted is acceptable if it still is a good likeness of the applicant;\"],\"scope_text\":\"If the photograph submitted does not meet the specified requirements: being in color, and being taken within six months of submitting the application, being a good likeness of, and satisfactorily identifying the applicant at the time of the application.\",\"section_id\":\"section-1\",\"start\":436,\"summary\":\"You must request a new photograph if the photograph submitted does not meet the specified requirements.\",\"target_ids\":[],\"typed_values\":[]}",

  "relationships": [
    {
      "source_unit_ref": "u2",
      "target_unit_refs": [
        "u17"
      ],
      "relation": "exception",
      "evidence_quotes": [
        "It is acceptable if the infant's eyes, particularly a newborn's, are partially or completely closed;",
        "Both of the applicant’s eyes should also be visible and open in the photograph (see the exception for infants in 8 FAM 402.1-1)."
      ],
      "explanation": "Infants whose eyes are partially or completely closed are an exception to the requirement/recommendation that both of the applicant's eyes be visible and open.",
      "structurally_valid": false
    },
    {
      "source_unit_ref": "u13",
      "target_unit_refs": [
        "u12"
      ],
      "relation": "exception",
      "evidence_quotes": [
        "Eyeglasses are not acceptable unless they cannot be removed for medical reasons, e.g., the applicant has recently had ocular surgery and the eyeglasses are necessary to protect the applicant’s eyes."
      ],
      "explanation": "Eyeglasses may be accepted if they cannot be removed for medical reasons.",
      "structurally_valid": true,
      "core_source_id": "urn:rulespec:document-understanding:revision:163e3eaa88f1253b95533c8ba8b318a387b2171d69dd8622037b17a06c1ce5bf",
      "core_target_ids": [
        "urn:rulespec:document-understanding:revision:5b9ab7e9b15b0dc845af151e05598024cd1e5befff67b1dc5064dd651030db3b"
      ]
    },
    {
      "source_unit_ref": "u14",
      "target_unit_refs": [
        "u13"
      ],
      "relation": "prerequisite",
      "evidence_quotes": [
        "A medical statement signed by a medical professional/health practitioner must be requested in these rare circumstances."
      ],
      "explanation": "Accepting eyeglasses for medical reasons requires requesting a medical statement signed by a medical professional/health practitioner.",
      "structurally_valid": false
    },
    {
      "source_unit_ref": "u18",
      "target_unit_refs": [
        "u17"
      ],
      "relation": "exception",
      "evidence_quotes": [
        "If the applicant is unable to open one or both eyes because of a medical condition, you may accept the photograph."
      ],
      "explanation": "Inability to open one or both eyes due to a medical condition qualifies as an exception where the photograph may still be accepted.",
      "structurally_valid": false
    }
  ],

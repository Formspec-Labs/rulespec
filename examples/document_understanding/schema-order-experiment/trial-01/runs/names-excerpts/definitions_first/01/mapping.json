  "relationships": [
    {
      "source_unit_ref": "u8",
      "target_unit_refs": [
        "u7"
      ],
      "relation": "exception",
      "evidence_quotes": [
        "The applicant may not continue to use a previous name after a material name change unless the name change documentation specifically permits the applicant to continue using that name"
      ],
      "explanation": "Permits an applicant to continue using a previous name after a material name change if the documentation specifically allows it, carving out an exception to the baseline prohibition.",
      "structurally_valid": true,
      "core_source_id": "urn:rulespec:document-understanding:revision:06eabb8e02fa808556cc423c7713014e1c8c4c95b53de535f3b3febc9a10110d",
      "core_target_ids": [
        "urn:rulespec:document-understanding:revision:ace3b7a1bdeaff6ba72da53bad2fca9f8db822b02f7e77f8b445f46725625fe0"
      ]
    },
    {
      "source_unit_ref": "u21",
      "target_unit_refs": [
        "u20"
      ],
      "relation": "exception",
      "evidence_quotes": [
        "The court order or decree must list both the applicant's current and former name(s).\n\nEXCEPTION: You may receive a court order in which the applicant's former name is made confidential (e.g., California's Safe at Home program). When this occurs, the applicant must provide both her/his current and former names on the application."
      ],
      "explanation": "Modifies the baseline requirement that the court order itself must list both names by allowing confidential orders where former names are protected, provided the applicant lists both names on the application.",
      "structurally_valid": false
    }
  ],

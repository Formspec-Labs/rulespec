      "code": "component_quote_outside_request",
      "row_index": 0,
      "kind": "requirement",
      "raw": {
        "unit": "Material discrepancies between the name recorded on the application, the applicant's evidence of U.S. citizenship/non-citizen U.S. nationality, or the evidence of identity must be documented by submission of one or more of the documents listed in this section (see an exception for married names in 8 FAM 403.1-4(C)).",
        "unit_attributes": {
          "kind": "requirement",
          "scope_quotes": [],
          "scope_text": "",
          "context_quotes": [],
          "modality_quote": "must",
          "modality": "must",
          "alternative_quotes": [
            "(1) Court orders or decrees: (a) Name change orders; or (b) Divorce decrees;",
            "(2) Certificates of naturalization;",
            "(3) Marriage certificates;",
            "(4) Documentation demonstrating change of name by operation of state law; or",
            "(5) Documentation of customary usage."
          ],
          "choice_quote": "submission of one or more of the documents listed in this section",
          "choice_text": "one or more of: court orders or decrees (name change orders or divorce decrees); certificates of naturalization; marriage certificates; documentation demonstrating change of name by operation of state law; or documentation of customary usage",

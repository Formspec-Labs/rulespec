            "text": "{\n  \"units\": [\n    {\n      \"quote_ref\": \"F000\",\n      \"scope_refs\": [],\n      \"kind\": \"requirement\",\n      \"meaning\": \"If an employer does not maintain an accurate record of hours worked by an employee, including for employees who are exempt from the FLSA recordkeeping requirements (such as bona fide executive, administrative, and professional employees under 29 CFR part 541), the employer bears the burden of showing that the employee has not worked the requisite hours.\"\n    },\n    {\n      \"quote_ref\": \"F000\",\n      \"scope_refs\": [],\n      \"kind\": \"requirement\",\n      \"meaning\": \"To claim that full-time teachers (as defined in § 825.102) of an elementary or secondary school system, institution of higher education, or other educational establishment or institution are not eligible for FMLA leave, an employer must be able to clearly demonstrate that the teachers did not work 1,250 hours during the previous 12 months, taking into account that they often work outside the classroom or at their homes.\"\n    },\n    {\n      \"quote_ref\": \"F000\",\n      \"scope_refs\": [],\n      \"kind\": \"background\",\n      \"meaning\": \"The statement referencing § 825.801(d) for special rules applicable to airline flight crew employees serves as a cross-reference to external provisions and contains no substantive rule within this text.\"\n    }\n  ]\n}",

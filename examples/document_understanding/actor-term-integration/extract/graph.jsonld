      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:2a0b533fafd35feb3325a514e09bf331a88687ceb422e6c7c33bc86bbbee1344\",\"urn:rulespec:document-understanding:assertion:1b11cc2ac79f13e1bc01240dd7452fe28bc0be7e89cf65bdade659f2c9282f26\",\"urn:rulespec:document-understanding:assertion:67ae0fc964e2b5d3be8b35cc0d9fbeabad3c70311c6020cd025b799d7e27c05a\",\"urn:rulespec:document-understanding:assertion:9d9c7d5f5e8f515ec65437a30bb1a88eee8e00f05c8cd09512c423b73faa5da7\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":2386,\"evidence\":[{\"end\":2386,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa150f4ee3b06251ce1b4533a18231db38769787697dbaee26861e227c43e353a:1578:2386:sha256-83916a909e28b50c3312da2eb87b8cec508edf844f37aae0b6ab9c59915e8b04\",\"quote\":\"c. INs are standardized notices that provide passport bearers with information about their passports. For example, an IN may be included to explain why the passport was limited in validity, and/or what documentation is needed to obtain a fully valid passport. The INs have been carefully crafted to communicate this information clearly and accurately. Consequently, no changes or alterations to the INs may be made unilaterally at passport agencies/centers without the approval of CA/PPT/S/A except in extenuating circumstances on a case-by-case basis with the approval of passport agency/center management, e.g., when using an endorsement 46 to limit a passport for a special problem. INs do not require a response from the applicant and do not need to be personalized with the applicant's name and address.\",\"start\":1578}],\"id\":\"urn:rulespec:document-understanding:revision:1ff99c1157f33d75a108e454193b8a66e42172316330e18e6d81b37b5becff2c\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"statement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:67ae0fc964e2b5d3be8b35cc0d9fbeabad3c70311c6020cd025b799d7e27c05a\",\"modality\":\"possible\",\"modality_quote\":\"may\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:6bbf4c564312d31a3755b9920e1fc8882e31b4a80001bcfdffbf0be69955549e\",\"origin\":\"aiSuggested\",\"quote\":\"c. INs are standardized notices that provide passport bearers with information about their passports. For example, an IN may be included to explain why the passport was limited in validity, and/or what documentation is needed to obtain a fully valid passport. The INs have been carefully crafted to communicate this information clearly and accurately. Consequently, no changes or alterations to the INs may be made unilaterally at passport agencies/centers without the approval of CA/PPT/S/A except in extenuating circumstances on a case-by-case basis with the approval of passport agency/center management, e.g., when using an endorsement 46 to limit a passport for a special problem. INs do not require a response from the applicant and do not need to be personalized with the applicant's name and address.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:e9676fc45e905bb173b5db1164c1986ca10b224fb2a011f42736ee8adb8d9d4d\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":1578,\"summary\":\"As an example, an IN may be included to explain why the passport was limited in validity, and/or what documentation is needed to obtain a fully valid passport.\",\"target_ids\":[],\"term_refs\":[\"urn:rulespec:document-understanding:term:58fe20c25b1d10b0c04211351086b86ee4d1b8c41a8d84a81e0ec512298042d5\"],\"typed_values\":[]}",

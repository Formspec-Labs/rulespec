      "@id": "urn:rulespec:document-understanding:revision:efe457f3b1f210035260bf86fc6bf78756220d76a902e2021aed8b64caff4d16",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:efe457f3b1f210035260bf86fc6bf78756220d76a902e2021aed8b64caff4d16",

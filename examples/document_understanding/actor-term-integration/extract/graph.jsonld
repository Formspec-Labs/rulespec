      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"You\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:bb377a60d339d16e6b29541c408176389f16afbd1737180ca86dc01795c7af55\",\"urn:rulespec:document-understanding:assertion:e88b2d8e1bbbade8384ded0e480b326789f122a40da808f3879fa8744296bb52\",\"urn:rulespec:document-understanding:assertion:21f5c75799980d54162dcb750405900f0139a347e5eaf7f6c140bfbd24a27437\",\"urn:rulespec:document-understanding:assertion:471aa5067aca1ab14d94dcfcaa2258782118618651ecc8b822e7f940e8764054\",\"urn:rulespec:document-understanding:assertion:cd8eeb8fb94c5aabdd8d0d23522239a070469f8a849502e31cc30c42ceacabc9\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":651,\"evidence\":[{\"end\":651,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa150f4ee3b06251ce1b4533a18231db38769787697dbaee26861e227c43e353a:200:651:sha256-19325de2fb1e6e628b7e6a6f83a16314ca28f7891a3c2c4916d0f2afa2a0ffd5\",\"quote\":\"b. IRLs are personalized, standardized letters with a date and signature block that request from the applicant additional information, documentation, or action needed to process the passport application. You must fully adjudicate the application prior to suspending to ensure that you are addressing all issues. The IRLs have been carefully crafted to communicate clearly and accurately statutory, regulatory, and other requirements of the Department.\",\"start\":200},{\"end\":407,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa150f4ee3b06251ce1b4533a18231db38769787697dbaee26861e227c43e353a:404:407:sha256-08b041935798fbf6fd6ff51099ffedb140a475889986d14f5559ff8e7fc571dd\",\"quote\":\"You\",\"start\":404},{\"end\":412,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa150f4ee3b06251ce1b4533a18231db38769787697dbaee26861e227c43e353a:408:412:sha256-4137b01e139589b7a1d3b3fc4da031d8ce5bb415808734e970c3a58ea0e98f0f\",\"quote\":\"must\",\"start\":408}],\"id\":\"urn:rulespec:document-understanding:revision:0b5d8da13660a167f4c4dcc1e453cf31873685bf1c2c536d66596b90ad1507ba\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:471aa5067aca1ab14d94dcfcaa2258782118618651ecc8b822e7f940e8764054\",\"modality\":\"must\",\"modality_quote\":\"must\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:59a6122979faa529cda0f179096d5f99ced06b4c17261cf0aa25cabec030859d\",\"origin\":\"aiSuggested\",\"quote\":\"b. IRLs are personalized, standardized letters with a date and signature block that request from the applicant additional information, documentation, or action needed to process the passport application. You must fully adjudicate the application prior to suspending to ensure that you are addressing all issues. The IRLs have been carefully crafted to communicate clearly and accurately statutory, regulatory, and other requirements of the Department.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:5e33ba50635470c7fa17dfffbdc693c87602749e772f817f48b0df90330637f6\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":200,\"summary\":\"You must fully adjudicate the passport application prior to suspending to ensure that you are addressing all issues.\",\"target_ids\":[],\"term_refs\":[\"urn:rulespec:document-understanding:term:11bb3bb3e8a02ee0cf9a776d54ab95111ac9b37f7870adb31983671bfa8cc386\"],\"typed_values\":[]}",

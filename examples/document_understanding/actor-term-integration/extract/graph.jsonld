      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:d3c03db999ee10c136954edfbcd2276d31a50d249ad50e772ba493d274ed0a22\",\"urn:rulespec:document-understanding:assertion:0e312d26cb4acb8b79b8b2973d2e83b13d8bed4f9cf9a1f3929324c4f9f82c9d\",\"urn:rulespec:document-understanding:assertion:9b950b6543b2435ba08a115cf9154df2013dbee650da0ed7eb885e5f7f151922\",\"urn:rulespec:document-understanding:assertion:88e871b384a8cce3f5d50dd9a1921800427dd7cf4928db66d9722fe2d892120f\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":1576,\"evidence\":[{\"end\":1576,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa150f4ee3b06251ce1b4533a18231db38769787697dbaee26861e227c43e353a:1334:1576:sha256-248001898d5f02dbfc7d1601c34cc178f669327219718939317523b23e8429dc\",\"quote\":\"NOTE : IRLs are not adjudicative guidance. The passport application must be adjudicated in accordance with the 8 FAM and then the appropriate IRL selected to address any deficiencies with the passport or Consular Report of Birth Abroad (CRBA)\",\"start\":1334},{\"end\":1406,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa150f4ee3b06251ce1b4533a18231db38769787697dbaee26861e227c43e353a:1402:1406:sha256-4137b01e139589b7a1d3b3fc4da031d8ce5bb415808734e970c3a58ea0e98f0f\",\"quote\":\"must\",\"start\":1402}],\"id\":\"urn:rulespec:document-understanding:revision:f1ad1cc77ff937a2af5d90bc2cac0eca675846de0389c840d771c76b6a8935ac\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:9b950b6543b2435ba08a115cf9154df2013dbee650da0ed7eb885e5f7f151922\",\"modality\":\"must\",\"modality_quote\":\"must\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:5500c7cbb5e5942716c2c75d7fb33cf3945fe9f0896e32c923a32ec8006bc807\",\"origin\":\"aiSuggested\",\"quote\":\"NOTE : IRLs are not adjudicative guidance. The passport application must be adjudicated in accordance with the 8 FAM and then the appropriate IRL selected to address any deficiencies with the passport or Consular Report of Birth Abroad (CRBA)\",\"references\":[\"8 FAM\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:91ab784ad15678789405b1b6fa50eaac763b72eb897a94ac6af1416fa6180ced\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":1334,\"summary\":\"The passport application must be adjudicated in accordance with the 8 FAM and then the appropriate IRL selected to address any deficiencies with the passport or Consular Report of Birth Abroad (CRBA).\",\"target_ids\":[],\"term_refs\":[\"urn:rulespec:document-understanding:term:11bb3bb3e8a02ee0cf9a776d54ab95111ac9b37f7870adb31983671bfa8cc386\"],\"typed_values\":[]}",

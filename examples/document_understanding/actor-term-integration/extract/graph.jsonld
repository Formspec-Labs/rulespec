    {
      "@id": "urn:rulespec:document-understanding:revision:6de373b62594f914efbaa889a485dc4ad258766838b426139b604abe679349c1",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:6de373b62594f914efbaa889a485dc4ad258766838b426139b604abe679349c1",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:334c5506709a661ae677f6a2c806f0b21b2612f823bf9f06fbb3c411cadcc407",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"passport agencies/centers\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:202d79aff23e1116ba00f019e60bcdf1e06ad80d6c662b4cd2b5f730543b6a8f\",\"urn:rulespec:document-understanding:assertion:f91f81cfd1f6a83a343487107b517c73293f5dcca1e9076f222cb6fe6cf680a4\",\"urn:rulespec:document-understanding:assertion:700b8c1116d1ad137a76823b34a06c764f8b3ed667ae4edb90359d1b97674e8c\",\"urn:rulespec:document-understanding:assertion:74b320528af1582f7480940ef07fb52795d160ced4c540f83aa275e4bf8217e4\",\"urn:rulespec:document-understanding:assertion:e9a679fcb50dada2588e9578d01a46a5adc6142ec178704dbe3c5e831f9dfe01\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":2386,\"evidence\":[{\"end\":2386,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa150f4ee3b06251ce1b4533a18231db38769787697dbaee26861e227c43e353a:1578:2386:sha256-83916a909e28b50c3312da2eb87b8cec508edf844f37aae0b6ab9c59915e8b04\",\"quote\":\"c. INs are standardized notices that provide passport bearers with information about their passports. For example, an IN may be included to explain why the passport was limited in validity, and/or what documentation is needed to obtain a fully valid passport. The INs have been carefully crafted to communicate this information clearly and accurately. Consequently, no changes or alterations to the INs may be made unilaterally at passport agencies/centers without the approval of CA/PPT/S/A except in extenuating circumstances on a case-by-case basis with the approval of passport agency/center management, e.g., when using an endorsement 46 to limit a passport for a special problem. INs do not require a response from the applicant and do not need to be personalized with the applicant's name and address.\",\"start\":1578},{\"end\":2034,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa150f4ee3b06251ce1b4533a18231db38769787697dbaee26861e227c43e353a:2009:2034:sha256-5867dbad416962ecb3978ed5a445bd0d8596b00300a7d028e0841e88f8c255f7\",\"quote\":\"passport agencies/centers\",\"start\":2009},{\"end\":1992,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa150f4ee3b06251ce1b4533a18231db38769787697dbaee26861e227c43e353a:1944:1992:sha256-57373b2c123a91b4a6be8da7c30625385e16fb61f8289da2989179392eb72a56\",\"quote\":\"no changes or alterations to the INs may be made\",\"start\":1944}],\"id\":\"urn:rulespec:document-understanding:revision:6de373b62594f914efbaa889a485dc4ad258766838b426139b604abe679349c1\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"prohibition\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:74b320528af1582f7480940ef07fb52795d160ced4c540f83aa275e4bf8217e4\",\"modality\":\"must_not\",\"modality_quote\":\"no changes or alterations to the INs may be made\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:b3d86552efd5c81656e15d9c25f6bc8bd90eb0553b00ccd5eb87a5f59f40361a\",\"origin\":\"aiSuggested\",\"quote\":\"c. INs are standardized notices that provide passport bearers with information about their passports. For example, an IN may be included to explain why the passport was limited in validity, and/or what documentation is needed to obtain a fully valid passport. The INs have been carefully crafted to communicate this information clearly and accurately. Consequently, no changes or alterations to the INs may be made unilaterally at passport agencies/centers without the approval of CA/PPT/S/A except in extenuating circumstances on a case-by-case basis with the approval of passport agency/center management, e.g., when using an endorsement 46 to limit a passport for a special problem. INs do not require a response from the applicant and do not need to be personalized with the applicant's name and address.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:798bd23f74b0b85ebf1d5e7d94c0d9b58e58f3d155b193b770653e17461a962d\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":1578,\"summary\":\"No changes or alterations to the INs may be made unilaterally at passport agencies/centers without the approval of CA/PPT/S/A, except in extenuating circumstances on a case-by-case basis with the approval of passport agency/center management (e.g., when using an endorsement 46 to limit a passport for a special problem).\",\"target_ids\":[],\"term_refs\":[\"urn:rulespec:document-understanding:term:58fe20c25b1d10b0c04211351086b86ee4d1b8c41a8d84a81e0ec512298042d5\"],\"typed_values\":[]}",

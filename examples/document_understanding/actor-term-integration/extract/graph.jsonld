      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:032c61683508b37ab3019e143d17118bfca82cf62fdfe18d36d19c15fc266a3f\",\"urn:rulespec:document-understanding:assertion:9031441414a1cc0200bcab7aae88dc53d8f8178fc10f1ac5185308603c90a26e\",\"urn:rulespec:document-understanding:assertion:6691c7bc0f2efc5603052aa990473c89aa9a1ce81425ef251ae5f0d0abd331ec\",\"urn:rulespec:document-understanding:assertion:00229d026be09f6dafa6091e91c6948743516d7e3826d131389d29b621c9dcac\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":651,\"evidence\":[{\"end\":651,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa150f4ee3b06251ce1b4533a18231db38769787697dbaee26861e227c43e353a:200:651:sha256-19325de2fb1e6e628b7e6a6f83a16314ca28f7891a3c2c4916d0f2afa2a0ffd5\",\"quote\":\"b. IRLs are personalized, standardized letters with a date and signature block that request from the applicant additional information, documentation, or action needed to process the passport application. You must fully adjudicate the application prior to suspending to ensure that you are addressing all issues. The IRLs have been carefully crafted to communicate clearly and accurately statutory, regulatory, and other requirements of the Department.\",\"start\":200}],\"id\":\"urn:rulespec:document-understanding:revision:8c53316d7fe938f835d3c8e7c7672ab8ed27f37b0364728f853f18373e1bfa66\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"statement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:6691c7bc0f2efc5603052aa990473c89aa9a1ce81425ef251ae5f0d0abd331ec\",\"modality\":\"not_stated\",\"modality_quote\":\"\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:f3bb654362bfd81aad1272dec5e9e90bb77649044abcda8c2742a61fab84fb97\",\"origin\":\"aiSuggested\",\"quote\":\"b. IRLs are personalized, standardized letters with a date and signature block that request from the applicant additional information, documentation, or action needed to process the passport application. You must fully adjudicate the application prior to suspending to ensure that you are addressing all issues. The IRLs have been carefully crafted to communicate clearly and accurately statutory, regulatory, and other requirements of the Department.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:bcecb204102f0ebd06ad0d51d824b4468f3e42134b6c59a7640f2c69b7a309b6\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":200,\"summary\":\"The IRLs have been carefully crafted to communicate clearly and accurately statutory, regulatory, and other requirements of the Department.\",\"target_ids\":[],\"term_refs\":[\"urn:rulespec:document-understanding:term:11bb3bb3e8a02ee0cf9a776d54ab95111ac9b37f7870adb31983671bfa8cc386\"],\"typed_values\":[]}",

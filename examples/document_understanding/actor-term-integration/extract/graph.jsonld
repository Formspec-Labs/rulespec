        "@value": "{\"action\":\"\",\"actor\":\"passport agencies/centers\",\"alternative_quotes\":[],\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"effective_periods\":[],\"jurisdiction\":\"\",\"kind\":\"prohibition\",\"logic_text\":\"\",\"modality\":\"must_not\",\"object\":\"\",\"scope_text\":\"\",\"summary\":\"No changes or alterations to the INs may be made unilaterally at passport agencies/centers without the approval of CA/PPT/S/A, except in extenuating circumstances on a case-by-case basis with the approval of passport agency/center management (e.g., when using an endorsement 46 to limit a passport for a special problem).\",\"term_refs\":[\"urn:rulespec:document-understanding:term:58fe20c25b1d10b0c04211351086b86ee4d1b8c41a8d84a81e0ec512298042d5\"],\"typed_values\":[]}",

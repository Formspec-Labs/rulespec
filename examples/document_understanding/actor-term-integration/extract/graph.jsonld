    {
      "@id": "urn:rulespec:document-understanding:revision:7c36f80e993641f7b97c94272a5bb35c65508c1ccc32a8e02b775c06177c8329",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:7c36f80e993641f7b97c94272a5bb35c65508c1ccc32a8e02b775c06177c8329",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:93da0e5187cf20285ef3ebfa96b465086e2a6473c367b79d162d6d7e4b84b837",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:4685e6ace1fff91b822ba90e6f5d0b08d4a13656064552a73c963ab87acba521\",\"urn:rulespec:document-understanding:assertion:de61ec5a9f763e3849bb99b001a78dcd5cdaa2e84e7998b98487aafe1ad0abb2\",\"urn:rulespec:document-understanding:assertion:61e516b9860115b649396e26f9fa1436f763a4e7bcc7663d560d9d7bf960544f\",\"urn:rulespec:document-understanding:assertion:068dc974883915d0372862ff86ce09b7a38ebc85e33018fc958b0c2ee2801471\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":2386,\"evidence\":[{\"end\":2386,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa150f4ee3b06251ce1b4533a18231db38769787697dbaee26861e227c43e353a:1578:2386:sha256-83916a909e28b50c3312da2eb87b8cec508edf844f37aae0b6ab9c59915e8b04\",\"quote\":\"c. INs are standardized notices that provide passport bearers with information about their passports. For example, an IN may be included to explain why the passport was limited in validity, and/or what documentation is needed to obtain a fully valid passport. The INs have been carefully crafted to communicate this information clearly and accurately. Consequently, no changes or alterations to the INs may be made unilaterally at passport agencies/centers without the approval of CA/PPT/S/A except in extenuating circumstances on a case-by-case basis with the approval of passport agency/center management, e.g., when using an endorsement 46 to limit a passport for a special problem. INs do not require a response from the applicant and do not need to be personalized with the applicant's name and address.\",\"start\":1578},{\"end\":2282,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa150f4ee3b06251ce1b4533a18231db38769787697dbaee26861e227c43e353a:2268:2282:sha256-286d45f3c118838fab430532a5de93c7b6eb8cd9f6d9e5a99718e78b9b94f97b\",\"quote\":\"do not require\",\"start\":2268}],\"id\":\"urn:rulespec:document-understanding:revision:7c36f80e993641f7b97c94272a5bb35c65508c1ccc32a8e02b775c06177c8329\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"exemption\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:61e516b9860115b649396e26f9fa1436f763a4e7bcc7663d560d9d7bf960544f\",\"modality\":\"not_required\",\"modality_quote\":\"do not require\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:d676324717e054aa20b64d6e26168fcfb9edad646bba817df4ce83cea946857f\",\"origin\":\"aiSuggested\",\"quote\":\"c. INs are standardized notices that provide passport bearers with information about their passports. For example, an IN may be included to explain why the passport was limited in validity, and/or what documentation is needed to obtain a fully valid passport. The INs have been carefully crafted to communicate this information clearly and accurately. Consequently, no changes or alterations to the INs may be made unilaterally at passport agencies/centers without the approval of CA/PPT/S/A except in extenuating circumstances on a case-by-case basis with the approval of passport agency/center management, e.g., when using an endorsement 46 to limit a passport for a special problem. INs do not require a response from the applicant and do not need to be personalized with the applicant's name and address.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:ea43abe33b972c89bbe3101479f713a6ef95216994322e7165b72765b3d58cfd\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":1578,\"summary\":\"INs do not require a response from the applicant and do not need to be personalized with the applicant's name and address.\",\"target_ids\":[],\"term_refs\":[\"urn:rulespec:document-understanding:term:58fe20c25b1d10b0c04211351086b86ee4d1b8c41a8d84a81e0ec512298042d5\"],\"typed_values\":[]}",

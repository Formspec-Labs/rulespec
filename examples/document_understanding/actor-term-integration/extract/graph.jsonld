      "skos:prefLabel": {
        "en": "information request letters"
      },
      "skos:definition": {
        "en": "IRLs are personalized, standardized letters with a date and signature block that request from the applicant additional information, documentation, or action needed to process the passport application."
      },
      "skos:inScheme": "urn:rulespec:document-understanding:defined-term-scheme:a150f4ee3b06251ce1b4533a18231db38769787697dbaee26861e227c43e353a",

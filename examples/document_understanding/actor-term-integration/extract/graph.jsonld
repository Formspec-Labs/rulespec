    {
      "@id": "urn:rulespec:document-understanding:revision:25070d48f1d8438c6689ad2b553028523570fa9f8a8b4cc0ffbaf6827a06e93d",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:25070d48f1d8438c6689ad2b553028523570fa9f8a8b4cc0ffbaf6827a06e93d",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:68959a24518984f0312a8206afa621a67869c2ac4f34701dde25d329c4b40932",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:812224291050ee6684a0d757e43424bdf4a76fbd9851f0ec77ca0ee7e73aa539\",\"urn:rulespec:document-understanding:assertion:cb455813b42573f2b1c1cf19c0f174aa4f18eaa353943112644a47c4e0d0fdfc\",\"urn:rulespec:document-understanding:assertion:9aedcd9164929993579d44f98531e5ac81e40f5b569d296d70d807815ab0051e\",\"urn:rulespec:document-understanding:assertion:c77f3e2908583d3a7e0d258dbf677d3491df119f895982d0e81a2c2134cedb85\",\"urn:rulespec:document-understanding:assertion:b524e6369199acaab26dcc0f72c01ba8caba552ab4b5d26b00468b60d2ba458f\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[{\"aliases\":[\"IRLs\"],\"label\":\"information request letters\",\"quote\":\"b. IRLs are personalized, standardized letters with a date and signature block that request from the applicant additional information, documentation, or action needed to process the passport application. You must fully adjudicate the application prior to suspending to ensure that you are addressing all issues. The IRLs have been carefully crafted to communicate clearly and accurately statutory, regulatory, and other requirements of the Department.\",\"source_quotes\":[\"a. The purpose of this subchapter is to provide guidance regarding the use of information request letters (IRLs) and information notices (INs).\",\"b. IRLs are personalized, standardized letters with a date and signature block that request from the applicant additional information, documentation, or action needed to process the passport application. You must fully adjudicate the application prior to suspending to ensure that you are addressing all issues. The IRLs have been carefully crafted to communicate clearly and accurately statutory, regulatory, and other requirements of the Department.\"]}],\"effective_periods\":[],\"end\":651,\"evidence\":[{\"end\":651,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa150f4ee3b06251ce1b4533a18231db38769787697dbaee26861e227c43e353a:200:651:sha256-19325de2fb1e6e628b7e6a6f83a16314ca28f7891a3c2c4916d0f2afa2a0ffd5\",\"quote\":\"b. IRLs are personalized, standardized letters with a date and signature block that request from the applicant additional information, documentation, or action needed to process the passport application. You must fully adjudicate the application prior to suspending to ensure that you are addressing all issues. The IRLs have been carefully crafted to communicate clearly and accurately statutory, regulatory, and other requirements of the Department.\",\"start\":200},{\"end\":651,\"field\":\"defined_terms:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa150f4ee3b06251ce1b4533a18231db38769787697dbaee26861e227c43e353a:200:651:sha256-19325de2fb1e6e628b7e6a6f83a16314ca28f7891a3c2c4916d0f2afa2a0ffd5\",\"quote\":\"b. IRLs are personalized, standardized letters with a date and signature block that request from the applicant additional information, documentation, or action needed to process the passport application. You must fully adjudicate the application prior to suspending to ensure that you are addressing all issues. The IRLs have been carefully crafted to communicate clearly and accurately statutory, regulatory, and other requirements of the Department.\",\"start\":200},{\"end\":198,\"field\":\"defined_terms:0:source:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa150f4ee3b06251ce1b4533a18231db38769787697dbaee26861e227c43e353a:55:198:sha256-a5f0a525abde99e60365ce84a45c91c5699e638b63fb100409e4166748a6aa17\",\"quote\":\"a. The purpose of this subchapter is to provide guidance regarding the use of information request letters (IRLs) and information notices (INs).\",\"start\":55},{\"end\":651,\"field\":\"defined_terms:0:source:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa150f4ee3b06251ce1b4533a18231db38769787697dbaee26861e227c43e353a:200:651:sha256-19325de2fb1e6e628b7e6a6f83a16314ca28f7891a3c2c4916d0f2afa2a0ffd5\",\"quote\":\"b. IRLs are personalized, standardized letters with a date and signature block that request from the applicant additional information, documentation, or action needed to process the passport application. You must fully adjudicate the application prior to suspending to ensure that you are addressing all issues. The IRLs have been carefully crafted to communicate clearly and accurately statutory, regulatory, and other requirements of the Department.\",\"start\":200}],\"id\":\"urn:rulespec:document-understanding:revision:25070d48f1d8438c6689ad2b553028523570fa9f8a8b4cc0ffbaf6827a06e93d\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"definition\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:9aedcd9164929993579d44f98531e5ac81e40f5b569d296d70d807815ab0051e\",\"modality\":\"not_stated\",\"modality_quote\":\"\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:83cc4ef5e170378836c28254ba2fda025b5051569289660cbd8a7c26061efb6a\",\"origin\":\"aiSuggested\",\"quote\":\"b. IRLs are personalized, standardized letters with a date and signature block that request from the applicant additional information, documentation, or action needed to process the passport application. You must fully adjudicate the application prior to suspending to ensure that you are addressing all issues. The IRLs have been carefully crafted to communicate clearly and accurately statutory, regulatory, and other requirements of the Department.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:de61ba0b9b4e4dae25bc83e402b729f2396451911a1c2022408228d8098684e6\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":200,\"summary\":\"IRLs are personalized, standardized letters with a date and signature block that request from the applicant additional information, documentation, or action needed to process the passport application.\",\"target_ids\":[],\"term_refs\":[\"urn:rulespec:document-understanding:term:11bb3bb3e8a02ee0cf9a776d54ab95111ac9b37f7870adb31983671bfa8cc386\"],\"typed_values\":[]}",

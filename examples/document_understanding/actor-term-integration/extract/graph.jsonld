      "dcterms:description": "{\"action\":\"\",\"actor\":\"Passport agencies/centers\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:6737c1dedc09226bdf2ed1b72e24c125b927447e607cf7483006978cef78fb42\",\"urn:rulespec:document-understanding:assertion:eb3a9d3eeaf034340cd33bfe7ab7cddc62d0b43ee9408b278e0bdcddd7983c5b\",\"urn:rulespec:document-understanding:assertion:481f04e1790304973f6ee512001b83ec7ffff4f816931dcb181ba02cc2aa8f77\",\"urn:rulespec:document-understanding:assertion:7c2929d76e04e5c75634c3f3460ef783ea314767e8ca5b3a167ebf465f38c477\",\"urn:rulespec:document-understanding:assertion:7fc936431bcff0d3422085fa33e7e4f65fb49bbaaf6116ca8692f2eb1712589a\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":1140,\"evidence\":[{\"end\":1140,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa150f4ee3b06251ce1b4533a18231db38769787697dbaee26861e227c43e353a:653:1140:sha256-fe943f2920cb59c6062588f6312a3e3a6b3c04c5df97f1c3e177f0a93c135f43\",\"quote\":\"(1) Passport agencies/centers must not make unilateral changes or alterations to the IRLs without the approval of the Office of Adjudication (CA/PPT/S/A) except on a case-by-case basis with the approval of passport agency/center management in extenuating circumstances, e.g., when you request that the applicant submit a birth certificate instead of a notification of birth registration, and the applicant insists that the notification of birth registration is the birth certificate; and\",\"start\":653},{\"end\":682,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa150f4ee3b06251ce1b4533a18231db38769787697dbaee26861e227c43e353a:657:682:sha256-12450d419ed4683dbfeae6db6ca23f5070daa67e9cb2babe3f7c95957bff40db\",\"quote\":\"Passport agencies/centers\",\"start\":657},{\"end\":691,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa150f4ee3b06251ce1b4533a18231db38769787697dbaee26861e227c43e353a:683:691:sha256-df0465d9a394078860d809a83f39f74c2e1040a44d5115401199c3e4374d2729\",\"quote\":\"must not\",\"start\":683}],\"id\":\"urn:rulespec:document-understanding:revision:4800de78b2c826048f75815799537165bce2568085aee5ebe0c39757870020f0\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"prohibition\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:7c2929d76e04e5c75634c3f3460ef783ea314767e8ca5b3a167ebf465f38c477\",\"modality\":\"must_not\",\"modality_quote\":\"must not\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:fab3623635c32bb11e9b791e4fdc9d1a55a1a224e5a50782a8269bd75ac2ad2f\",\"origin\":\"aiSuggested\",\"quote\":\"(1) Passport agencies/centers must not make unilateral changes or alterations to the IRLs without the approval of the Office of Adjudication (CA/PPT/S/A) except on a case-by-case basis with the approval of passport agency/center management in extenuating circumstances, e.g., when you request that the applicant submit a birth certificate instead of a notification of birth registration, and the applicant insists that the notification of birth registration is the birth certificate; and\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:8dc29b8c5262411ecfd0efe04179b547f1cbfe0d0337fac4677b2da9e205806f\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":653,\"summary\":\"Passport agencies/centers must not make unilateral changes or alterations to the IRLs without the approval of the Office of Adjudication (CA/PPT/S/A), except on a case-by-case basis with the approval of passport agency/center management in extenuating circumstances (e.g., when you request that the applicant submit a birth certificate instead of a notification of birth registration, and the applicant insists that the notification of birth registration is the birth certificate).\",\"target_ids\":[],\"term_refs\":[\"urn:rulespec:document-understanding:term:11bb3bb3e8a02ee0cf9a776d54ab95111ac9b37f7870adb31983671bfa8cc386\"],\"typed_values\":[]}",

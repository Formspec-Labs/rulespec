    {
      "@id": "urn:rulespec:document-understanding:revision:aaa4510a8035e487daab0da2f4db9999d9093bf1319dd869c81be6076f9aef6b",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:aaa4510a8035e487daab0da2f4db9999d9093bf1319dd869c81be6076f9aef6b",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:57c06eb7e9f53b8bde923757a5d868b0696d285580c62e7d8def04e6be098c4b",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:833df2dbf223874e2cb6b068c8315072579479edf2dfcde3a38d354d0d17a20f\",\"urn:rulespec:document-understanding:assertion:abdd9d35a76eeceece65cca12ef0fdcc7a873a27e6c78d8a2fe7495e184a2a43\",\"urn:rulespec:document-understanding:assertion:895604eba119fbdfd95886569fea81a26595971de724ebf59df5e01aa53fa8fc\",\"urn:rulespec:document-understanding:assertion:e577f9700fc342ae2693be0c32ea97b792f06c9bc77781cdf2d356d496aad310\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":2386,\"evidence\":[{\"end\":2386,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa150f4ee3b06251ce1b4533a18231db38769787697dbaee26861e227c43e353a:1578:2386:sha256-83916a909e28b50c3312da2eb87b8cec508edf844f37aae0b6ab9c59915e8b04\",\"quote\":\"c. INs are standardized notices that provide passport bearers with information about their passports. For example, an IN may be included to explain why the passport was limited in validity, and/or what documentation is needed to obtain a fully valid passport. The INs have been carefully crafted to communicate this information clearly and accurately. Consequently, no changes or alterations to the INs may be made unilaterally at passport agencies/centers without the approval of CA/PPT/S/A except in extenuating circumstances on a case-by-case basis with the approval of passport agency/center management, e.g., when using an endorsement 46 to limit a passport for a special problem. INs do not require a response from the applicant and do not need to be personalized with the applicant's name and address.\",\"start\":1578}],\"id\":\"urn:rulespec:document-understanding:revision:aaa4510a8035e487daab0da2f4db9999d9093bf1319dd869c81be6076f9aef6b\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"statement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:895604eba119fbdfd95886569fea81a26595971de724ebf59df5e01aa53fa8fc\",\"modality\":\"not_stated\",\"modality_quote\":\"\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:95b6acb0632c3a64839a133b793a66c2e0c93e715a8ee2a953b8c8e8a5a97d54\",\"origin\":\"aiSuggested\",\"quote\":\"c. INs are standardized notices that provide passport bearers with information about their passports. For example, an IN may be included to explain why the passport was limited in validity, and/or what documentation is needed to obtain a fully valid passport. The INs have been carefully crafted to communicate this information clearly and accurately. Consequently, no changes or alterations to the INs may be made unilaterally at passport agencies/centers without the approval of CA/PPT/S/A except in extenuating circumstances on a case-by-case basis with the approval of passport agency/center management, e.g., when using an endorsement 46 to limit a passport for a special problem. INs do not require a response from the applicant and do not need to be personalized with the applicant's name and address.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:fca404c2fe8b69b8118c39d7db76c77ecfeed753c38f718db52212e3d8108675\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":1578,\"summary\":\"The INs have been carefully crafted to communicate information about their passports clearly and accurately.\",\"target_ids\":[],\"term_refs\":[\"urn:rulespec:document-understanding:term:58fe20c25b1d10b0c04211351086b86ee4d1b8c41a8d84a81e0ec512298042d5\"],\"typed_values\":[]}",

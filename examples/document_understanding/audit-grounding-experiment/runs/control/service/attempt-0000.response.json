  "parsed": {
    "units": [
      {
        "quote": "(b) The 12 months an employee must have been employed by the employer need not be consecutive months, provided",
        "scope_quotes": [],
        "kind": "permission",
        "meaning": "The 12 months an employee must have been employed by the employer to establish eligibility do not need to be consecutive months, subject to the conditions that follow."
      },
      {
        "quote": "(1) Subject to the exceptions provided in paragraph (b)(2) of this section, employment periods prior to a break in service of seven years or more need not be counted in determining whether the employee has been employed by the employer for at least 12 months.",
        "scope_quotes": [
          "(b) The 12 months an employee must have been employed by the employer need not be consecutive months, provided"
        ],
        "kind": "exemption",
        "meaning": "Unless one of the exceptions in paragraph (b)(2) applies, an employer is not required to count employment periods prior to a break in service of seven years or more when determining whether an employee meets the 12-month employment threshold."
      },
      {
        "quote": "(i) The employee's break in service is occasioned by the fulfillment of his or her Uniformed Services Employment and Reemployment Rights Act (USERRA), 38 U.S.C. 4301, et seq., covered service obligation.",
        "scope_quotes": [
          "(2) Employment periods preceding a break in service of more than seven years must be counted in determining whether the employee has been employed by the employer for at least 12 months where:"
        ],
        "kind": "requirement",
        "meaning": "Employment periods preceding a break in service of more than seven years must be counted toward the 12-month employment requirement when the break in service was caused by the fulfillment of the employee's USERRA-covered service obligation."
      },
      {
        "quote": "The period of absence from work due to or necessitated by USERRA-covered service must be also counted in determining whether the employee has been employed for at least 12 months by the employer.",
        "scope_quotes": [
          "(2) Employment periods preceding a break in service of more than seven years must be counted in determining whether the employee has been employed by the employer for at least 12 months where:",
          "(i) The employee's break in service is occasioned by the fulfillment of his or her Uniformed Services Employment and Reemployment Rights Act (USERRA), 38 U.S.C. 4301, et seq., covered service obligation."
        ],
        "kind": "requirement",
        "meaning": "When determining whether the employee has been employed by the employer for at least 12 months, the employer must also count the actual period of absence from work that was due to or necessitated by USERRA-covered service."
      },
      {
        "quote": "However, this section does not provide any greater entitlement to the employee than would be available under the USERRA; or",
        "scope_quotes": [
          "(2) Employment periods preceding a break in service of more than seven years must be counted in determining whether the employee has been employed by the employer for at least 12 months where:"
        ],
        "kind": "statement",
        "meaning": "This regulatory section does not confer any greater right or entitlement upon the employee than that which is available under USERRA."
      },
      {
        "quote": "(ii) A written agreement, including a collective bargaining agreement, exists concerning the employer's intention to rehire the employee after the break in service (e.g., for purposes of the employee furthering his or her education or for childrearing purposes).",
        "scope_quotes": [
          "(2) Employment periods preceding a break in service of more than seven years must be counted in determining whether the employee has been employed by the employer for at least 12 months where:"
        ],
        "kind": "requirement",
        "meaning": "Employment periods preceding a break in service of more than seven years must be counted toward the 12-month employment requirement when there exists a written agreement (which may be a collective bargaining agreement) regarding the employer's intention to rehire the employee after the break in service, such as for education or childrearing purposes."
      }
    ]
  }

            "text": "{\n  \"units\": [\n    {\n      \"quote\": \"The determination of whether an employee meets the hours of service requirement and has been employed by the employer for a total of at least 12 months must be made as of the date the FMLA leave is to start.\",\n      \"scope_quotes\": [],\n      \"kind\": \"requirement\",\n      \"meaning\": \"The determination of whether an employee satisfies the hours of service requirement and has been employed by the employer for a total of at least 12 months must be evaluated as of the date the FMLA leave is scheduled to begin.\"\n    },\n    {\n      \"quote\": \"An employee may be on non-FMLA leave at the time he or she meets the 12-month eligibility requirement\",\n      \"scope_quotes\": [],\n      \"kind\": \"permission\",\n      \"meaning\": \"An employee is permitted to be on non-FMLA leave at the point in time when he or she reaches and satisfies the 12-month employment eligibility requirement.\"\n    },\n    {\n      \"quote\": \"in that event, any portion of the leave taken for an FMLA-qualifying reason after the employee meets the eligibility requirement would be FMLA leave.\",\n      \"scope_quotes\": [\n        \"An employee may be on non-FMLA leave at the time he or she meets the 12-month eligibility requirement\"\n      ],\n      \"kind\": \"statement\",\n      \"meaning\": \"If an employee is on non-FMLA leave when reaching the 12-month eligibility requirement, any part of the leave taken for an FMLA-qualifying reason subsequent to meeting that requirement qualifies and is treated as FMLA leave.\"\n    },\n    {\n      \"quote\": \"See § 825.300(b) for rules governing the content of the eligibility notice given to employees.\",\n      \"scope_quotes\": [],\n      \"kind\": \"background\",\n      \"meaning\": \"Provides a cross-reference directing readers to § 825.300(b) for rules governing the content of eligibility notices given to employees, without stating an independent substantive rule in this provision.\"\n    }\n  ]\n}",

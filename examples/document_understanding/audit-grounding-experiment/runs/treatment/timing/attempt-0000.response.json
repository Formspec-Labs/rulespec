            "text": "{\n  \"units\": [\n    {\n      \"quote_ref\": \"F000\",\n      \"scope_refs\": [],\n      \"kind\": \"requirement\",\n      \"meaning\": \"The determination of whether an employee meets the hours of service requirement and has been employed by the employer for a total of at least 12 months must be made as of the date the FMLA leave is to start.\"\n    },\n    {\n      \"quote_ref\": \"F000\",\n      \"scope_refs\": [],\n      \"kind\": \"permission\",\n      \"meaning\": \"An employee may be on non-FMLA leave at the time he or she meets the 12-month eligibility requirement.\"\n    },\n    {\n      \"quote_ref\": \"F000\",\n      \"scope_refs\": [],\n      \"kind\": \"statement\",\n      \"meaning\": \"If an employee is on non-FMLA leave at the time he or she meets the 12-month eligibility requirement, any portion of the leave taken for an FMLA-qualifying reason after the employee meets the eligibility requirement would be FMLA leave.\"\n    },\n    {\n      \"quote_ref\": \"F000\",\n      \"scope_refs\": [],\n      \"kind\": \"background\",\n      \"meaning\": \"Provides a cross-reference directing readers to § 825.300(b) for rules governing the content of the eligibility notice given to employees, without establishing an independent substantive requirement.\"\n    }\n  ]\n}",

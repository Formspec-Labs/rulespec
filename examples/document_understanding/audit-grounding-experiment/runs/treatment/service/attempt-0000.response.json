            "text": "{\n  \"units\": [\n    {\n      \"quote_ref\": \"F000\",\n      \"scope_refs\": [],\n      \"kind\": \"permission\",\n      \"meaning\": \"The 12 months an employee must have been employed by the employer are not required to be consecutive months, provided the qualifying terms of the paragraph are met.\"\n    },\n    {\n      \"quote_ref\": \"F001\",\n      \"scope_refs\": [\"F000\"],\n      \"kind\": \"permission\",\n      \"meaning\": \"Subject to the exceptions in paragraph (b)(2), employment periods occurring prior to a break in service of seven years or more need not be counted when determining whether the employee has been employed by the employer for at least 12 months.\"\n    },\n    {\n      \"quote_ref\": \"F003\",\n      \"scope_refs\": [\"F000\", \"F002\"],\n      \"kind\": \"exception\",\n      \"meaning\": \"Employment periods preceding a break in service of more than seven years must be counted in determining whether the employee has been employed by the employer for at least 12 months where the break in service is occasioned by the fulfillment of the employee's Uniformed Services Employment and Reemployment Rights Act (USERRA), 38 U.S.C. 4301, et seq., covered service obligation.\"\n    },\n    {\n      \"quote_ref\": \"F003\",\n      \"scope_refs\": [\"F000\"],\n      \"kind\": \"requirement\",\n      \"meaning\": \"The period of absence from work due to or necessitated by USERRA-covered service must also be counted in determining whether the employee has been employed for at least 12 months by the employer.\"\n    },\n    {\n      \"quote_ref\": \"F003\",\n      \"scope_refs\": [],\n      \"kind\": \"statement\",\n      \"meaning\": \"This section does not provide any greater entitlement to the employee than would be available under USERRA.\"\n    },\n    {\n      \"quote_ref\": \"F004\",\n      \"scope_refs\": [\"F000\", \"F002\"],\n      \"kind\": \"exception\",\n      \"meaning\": \"Employment periods preceding a break in service of more than seven years must be counted in determining whether the employee has been employed by the employer for at least 12 months where a written agreement, including a collective bargaining agreement, exists concerning the employer's intention to rehire the employee after the break in service (such as for furthering education or childrearing purposes).\"\n    }\n  ]\n}",
            "thought": null,

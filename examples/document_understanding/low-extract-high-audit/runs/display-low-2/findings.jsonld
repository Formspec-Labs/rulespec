  "@graph": [
    {
      "@id": "urn:rulespec:document-understanding:audit:30d40e862969ecc1057b96fd699c78bf4ad90d4ad72da5113a7b5b575ed99661",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:audit:30d40e862969ecc1057b96fd699c78bf4ad90d4ad72da5113a7b5b575ed99661",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:30d40e862969ecc1057b96fd699c78bf4ad90d4ad72da5113a7b5b575ed99661",
      "dcterms:format": "application/json"
    },
    {
      "@id": "urn:rulespec:document-understanding:finding:ea85c59c33958ecbec722134c61db2eebfb522b69aa1b3f05e459b46dd56a2ef",
      "@type": "rkaf:Finding",
      "rkaf:findingKind": "rkaf:warning",
      "rkaf:detectedAt": "2026-09-08T23:09:24.445099+00:00",
      "rkaf:detectedBy": "urn:rulespec:document-understanding:audit:30d40e862969ecc1057b96fd699c78bf4ad90d4ad72da5113a7b5b575ed99661",
      "rkaf:subject": "urn:rulespec:document-understanding:revision:886c6616d1169b9f9dffca9a70a65918a3caa5d10d21cf4b9a410718e15646d1",
      "rkaf:rationale": "Model-assisted audit flagged links: The claim accurately captures the exemption from the adult steward appointment duty. However, because it is structured as an exemption claim without linking via target_ids to the requirement it modifies (C0004), links is an error."
    },
    {
      "@id": "urn:rulespec:document-understanding:finding:704b7515c6b2e4bba0819ce3f096eec44ff6d81ab014c13e64928235b8ad0a5b",
      "@type": "rkaf:Finding",
      "rkaf:findingKind": "rkaf:warning",
      "rkaf:detectedAt": "2026-09-08T23:09:24.445099+00:00",
      "rkaf:detectedBy": "urn:rulespec:document-understanding:audit:30d40e862969ecc1057b96fd699c78bf4ad90d4ad72da5113a7b5b575ed99661",
      "rkaf:subject": "urn:rulespec:document-understanding:revision:e5614c7b8050be0d82e1b4393311d2af2fe33544de06e06bfc16b94f22538120",
      "rkaf:rationale": "Model-assisted audit flagged alternatives: The summary and scope accurately consolidate the requirement to suspend outdoor demonstrations during a storm warning unless all three cumulative conditions are met. However, populating alternative_quotes with conditions that are conjunctive prerequisites misrepresents cumulative conditions as alternatives, so alternatives is scored as error."
    },
    {
      "@id": "urn:rulespec:document-understanding:finding:86f308524e9ed44b5f4630efcc245bdb34af5f727a7945388e1ad97d987d641c",
      "@type": "rkaf:Finding",
      "rkaf:findingKind": "rkaf:warning",
      "rkaf:detectedAt": "2026-09-08T23:09:24.445099+00:00",
      "rkaf:detectedBy": "urn:rulespec:document-understanding:audit:30d40e862969ecc1057b96fd699c78bf4ad90d4ad72da5113a7b5b575ed99661",
      "rkaf:subject": "urn:rulespec:document-understanding:revision:25b4cf1813cb8a680b78a72275a916a52bda461494af5fe7dde5a57bbc88199a",
      "rkaf:rationale": "Model-assisted audit flagged links: The summary faithfully retains both the permission to bring paper maps and the caveat that other premises rules may restrict materials. However, the caveat is an exception that was not emitted as a separate linked exception claim, resulting in an error in links."
    },
    {
      "@id": "urn:rulespec:document-understanding:finding:94c11f97fc02bca3b0089e97356f4d6d4b0beca4710c00b9262ae5b5dd5c1d9c",
      "@type": "rkaf:Finding",
      "rkaf:findingKind": "rkaf:warning",
      "rkaf:detectedAt": "2026-09-08T23:09:24.445099+00:00",
      "rkaf:detectedBy": "urn:rulespec:document-understanding:audit:30d40e862969ecc1057b96fd699c78bf4ad90d4ad72da5113a7b5b575ed99661",
      "rkaf:subject": "urn:rulespec:document-understanding:document:cd1d2d681c56417058e5883c90b99d7d8c562af40621c5b8e3d3b614540154d5",
      "rkaf:rationale": "Model-assisted audit marked urn:rulespec:audit-unit:4c50ecc6450874837205d14817d09666ed9501c6cbb2153c9ad0f93691a70059 missing: If a temporary display on agency premises is open to the public after sunset, the organizer is obligated to satisfy all four cumulative conditions set forth in paragraphs (1) through (4).. No claim extracted or represented the governing requirement of paragraph (a) that the organizer must cumulatively satisfy all of the following conditions (1) through (4). The lead-in text was used only as scope text across sub-claims."
    },
    {
      "@id": "urn:rulespec:document-understanding:finding:9c4f9730d08bde5e414a9d008f3aa36e2c9c73c3bcd93f8de3a203c72c3782f9",
      "@type": "rkaf:Finding",
      "rkaf:findingKind": "rkaf:warning",
      "rkaf:detectedAt": "2026-09-08T23:09:24.445099+00:00",
      "rkaf:detectedBy": "urn:rulespec:document-understanding:audit:30d40e862969ecc1057b96fd699c78bf4ad90d4ad72da5113a7b5b575ed99661",
      "rkaf:subject": "urn:rulespec:document-understanding:document:cd1d2d681c56417058e5883c90b99d7d8c562af40621c5b8e3d3b614540154d5",
      "rkaf:rationale": "Audit processing issue: {\"code\":\"inconsistent_coverage_judgment\",\"message\":\"Coverage lacks current, consistent reviewed claim matches.\",\"unit_id\":\"urn:rulespec:audit-unit:e7d750bc34d0703ed5cd22dda9b18b5c41a0011481f465bc96b5f8f80d70f75c\"}"
    },

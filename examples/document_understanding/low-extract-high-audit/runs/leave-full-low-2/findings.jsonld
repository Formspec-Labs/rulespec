  "@graph": [
    {
      "@id": "urn:rulespec:document-understanding:audit:ec77d777cd0fadabd793918c4b253d1dd3c27509fb723cbf69f2548298b1bb2b",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:audit:ec77d777cd0fadabd793918c4b253d1dd3c27509fb723cbf69f2548298b1bb2b",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:ec77d777cd0fadabd793918c4b253d1dd3c27509fb723cbf69f2548298b1bb2b",
      "dcterms:format": "application/json"
    },
    {
      "@id": "urn:rulespec:document-understanding:finding:90c05eac75a05851d595d1f10da9e8f1e2e345f16248b67749e0130abe0aad0d",
      "@type": "rkaf:Finding",
      "rkaf:findingKind": "rkaf:warning",
      "rkaf:detectedAt": "2026-09-08T23:08:15.930446+00:00",
      "rkaf:detectedBy": "urn:rulespec:document-understanding:audit:ec77d777cd0fadabd793918c4b253d1dd3c27509fb723cbf69f2548298b1bb2b",
      "rkaf:subject": "urn:rulespec:document-understanding:revision:940ea73a90b741cb20d84c04a94dabdc28efef9ced81883ec860c496ded9277b",
      "rkaf:rationale": "Model-assisted audit flagged scope: Claim C0001 extracts the opening permission sentence of paragraph (b). However, the governing lead-in from subsection (a) ('An eligible employee is an employee of a covered employer who: Has been employed by the employer for at least 12 months') was relegated exclusively to context_quotes and omitted from the explicit scope and summary. Because this is a permission rule ('need not be consecutive months'), omitting the prerequisite creates an overbroad scope that would improperly admit an employee of a non-covered employer or an employee outside the FMLA context claiming that 12 months of employment need not be consecutive."
    },
    {
      "@id": "urn:rulespec:document-understanding:finding:679a38e9723bfe02163ff991546f2e15cc8e6869cd4b3597e27b7eb76c92455d",
      "@type": "rkaf:Finding",
      "rkaf:findingKind": "rkaf:warning",
      "rkaf:detectedAt": "2026-09-08T23:08:15.930446+00:00",
      "rkaf:detectedBy": "urn:rulespec:document-understanding:audit:ec77d777cd0fadabd793918c4b253d1dd3c27509fb723cbf69f2548298b1bb2b",
      "rkaf:subject": "urn:rulespec:document-understanding:document:a4cdfc9b75c8a1ed78c29b8a344913757e4b95198a4b069127aa9092960aaf4f",
      "rkaf:rationale": "Model-assisted audit marked urn:rulespec:audit-unit:97062571bf9b189324d66b79e7f710ca489e1ee85bb249a2c22bc6576d2dc4c7 partial: The 12 months of employment required to establish eligibility are not required to be consecutive months, provided the qualifying conditions regarding breaks in service are satisfied.. C0001 captures that the 12 months need not be consecutive provided the conditions of paragraph (b) are met, but omits the governing prerequisite from subsection (a) ('employee of a covered employer' establishing FMLA eligibility) from its explicit scope and summary, retaining it only in context_quotes."
    },
    {
      "@id": "urn:rulespec:document-understanding:finding:f342411b0bcc3f56efe80f252e1e4c284500fe2f87eac0e26ed4f178ba27feb1",
      "@type": "rkaf:Finding",
      "rkaf:findingKind": "rkaf:warning",
      "rkaf:detectedAt": "2026-09-08T23:08:15.930446+00:00",
      "rkaf:detectedBy": "urn:rulespec:document-understanding:audit:ec77d777cd0fadabd793918c4b253d1dd3c27509fb723cbf69f2548298b1bb2b",
      "rkaf:subject": "urn:rulespec:document-understanding:document:a4cdfc9b75c8a1ed78c29b8a344913757e4b95198a4b069127aa9092960aaf4f",
      "rkaf:rationale": "Model-assisted audit marked urn:rulespec:audit-unit:3d1c5700d39904030bc592fa924609b3419e3bd42b071996e1c48e30e97bd4be partial: Where accurate records are not maintained, an employer is required to clearly demonstrate that full-time teachers of elementary, secondary, or higher education institutions did not work 1,250 hours in the prior 12 months to support claiming they are ineligible for FMLA leave.. While C0009 quotes paragraph (c)(3) in full, its summary generalized the clear demonstration requirement to any employee and omitted the specific statutory application to full-time teachers of elementary or secondary school systems or higher education institutions."
    },
    {
      "@id": "urn:rulespec:document-understanding:finding:ad0ed13ae737afe6763aeba7353cde6971de535a7c1e54023e8b3fbb0c9deef3",
      "@type": "rkaf:Finding",
      "rkaf:findingKind": "rkaf:warning",
      "rkaf:detectedAt": "2026-09-08T23:08:15.930446+00:00",
      "rkaf:detectedBy": "urn:rulespec:document-understanding:audit:ec77d777cd0fadabd793918c4b253d1dd3c27509fb723cbf69f2548298b1bb2b",
      "rkaf:subject": "urn:rulespec:document-understanding:document:a4cdfc9b75c8a1ed78c29b8a344913757e4b95198a4b069127aa9092960aaf4f",
      "rkaf:rationale": "Model-assisted audit marked urn:rulespec:audit-unit:cad5e64143652a1e6129a592a3425f54be983e8b5ec52105a048121009ba2138 partial: An employer employing 50 or more employees (e.g., 60) when notice is given in August must grant FMLA benefits for leave starting in December, even if employment is anticipated to fall below 50 (e.g., to 40) before the leave begins.. C0011 quotes the entire paragraph including the August/December 60-to-40 employee example, but its summary states only the general rules and omits the specific rule/example demonstrating that anticipated headcount drops before leave starts do not defeat eligibility established upon notice."
    }
  ]
}

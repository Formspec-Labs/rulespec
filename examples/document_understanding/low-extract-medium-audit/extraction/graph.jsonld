    {
      "@id": "urn:rulespec:document-understanding:assertion:db030aaa7591bbb95cdd8a7d2af637e066983ba3ac2be947dc67a9634c820750",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:875080c9a0a2c42ab35dc7ead94bf0db96b9ec25517e17e42a6bf3557786e3ff",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:0e4771c695abde644465e06e09292be710b2f5aad224f0ceced75a3896da2f2e",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:b8284a8dda098aa0555e8048515aa5dff1a6d2b0a9ec004ed544859a1526214e",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[\"(1) Has been employed by the employer for at least 12 months, and\",\"(2) Has been employed for at least 1,250 hours of service during the 12-month period immediately preceding the commencement of the leave ( see § 825.801 for special hours of service requirements for airline flight crew employees), and\",\"(3) Is employed at a worksite where 50 or more employees are employed by the employer within 75 miles of that worksite. See § 825.105(b) regarding employees who work outside the U.S.\"],\"choice_text\":\"An eligible employee must satisfy all three conditions: (1) has been employed by the employer for at least 12 months; (2) has been employed for at least 1,250 hours of service during the 12-month period immediately preceding the commencement of the leave (subject to special hours of service rules under § 825.801 for airline flight crew employees); and (3) is employed at a worksite where 50 or more employees are employed by the employer within 75 miles of that worksite (referencing § 825.105(b) regarding employees working outside the U.S.).\",\"claimants\":[],\"concepts\":[],\"effective_periods\":[],\"jurisdiction\":\"\",\"kind\":\"definition\",\"logic_text\":\"(a) An eligible employee is an employee of a covered employer who:\\n\\n(1) Has been employed by the employer for at least 12 months, and\\n\\n(2) Has been employed for at least 1,250 hours of service during the 12-month period immediately preceding the commencement of the leave ( see § 825.801 for special hours of service requirements for airline flight crew employees), and\\n\\n(3) Is employed at a worksite where 50 or more employees are employed by the employer within 75 miles of that worksite. See § 825.105(b) regarding employees who work outside the U.S.\",\"modality\":\"not_stated\",\"object\":\"\",\"scope_text\":\"For an employee of a covered employer under 29 CFR 825.110\",\"summary\":\"An eligible employee is an employee of a covered employer who has been employed by the employer for at least 12 months, has been employed for at least 1,250 hours of service during the 12-month period immediately preceding the commencement of the leave (subject to § 825.801 for airline flight crew employees), and is employed at a worksite where 50 or more employees are employed by the employer within 75 miles of that worksite (referencing § 825.105(b) for employees working outside the U.S.).\",\"typed_values\":[]}",
        "@type": "xsd:string"
      },

      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:0e4771c695abde644465e06e09292be710b2f5aad224f0ceced75a3896da2f2e",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:a46cfaead268fcc35a6467c6ff79c3af14905c9e947a2b545f15a83e55ad3d2d",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"effective_periods\":[],\"jurisdiction\":\"\",\"kind\":\"permission\",\"logic_text\":\"(c)(1) Except as provided in paragraph (c)(2) of this section and in § 825.801 containing the special hours of service requirement for airline flight crew employees, whether an employee has worked the minimum 1,250 hours of service is determined according to the principles established under the Fair Labor Standards Act (FLSA) for determining compensable hours of work. See 29 CFR part 785. The determining factor is the number of hours an employee has worked for the employer within the meaning of the FLSA. The determination is not limited by methods of recordkeeping, or by compensation agreements that do not accurately reflect all of the hours an employee has worked for or been in service to the employer. Any accurate accounting of actual hours worked under FLSA's principles may be used.\",\"modality\":\"may\",\"object\":\"\",\"scope_text\":\"In determining whether an employee has worked the minimum 1,250 hours of service under FLSA's principles\",\"summary\":\"Any accurate accounting of actual hours worked under FLSA's principles may be used.\",\"typed_values\":[]}",
        "@type": "xsd:string"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed",
      "rkaf:hasApplicability": "urn:rulespec:document-understanding:scope:3ce4dae808bf995da9aae278cc8d6cb22609ea335668f46bae179219556368de"
    },

      "rkaf:assertsValue": {
        "@value": "Nothing in this section prevents employers from considering employment prior to a continuous break in service of more than seven years when determining whether an employee has met the 12-month employment requirement.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"

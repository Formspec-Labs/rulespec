    {
      "@id": "urn:rulespec:document-understanding:assertion:5b4525d6785faf8e9821bb978a00ff36baa7f8210f4e2275530a37f0db845ad9",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:875080c9a0a2c42ab35dc7ead94bf0db96b9ec25517e17e42a6bf3557786e3ff",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:0e4771c695abde644465e06e09292be710b2f5aad224f0ceced75a3896da2f2e",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:a60d96283593397f7a89b7f145d07fc58eeb65347f3efe51db88357c7cd80bdf",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:logic_text",
      "rkaf:assertsValue": {
        "@value": "(d) The determination of whether an employee meets the hours of service requirement and has been employed by the employer for a total of at least 12 months must be made as of the date the FMLA leave is to start. An employee may be on non-FMLA leave at the time he or she meets the 12-month eligibility requirement, and in that event, any portion of the leave taken for an FMLA-qualifying reason after the employee meets the eligibility requirement would be FMLA leave. See § 825.300(b) for rules governing the content of the eligibility notice given to employees.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },
    {
      "@id": "urn:rulespec:document-understanding:binding:6446c0aa7a2f8ebc99955cad2e1b9695e794d4f0e9f6bdf6abe1f4ccb01e411a",

      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:875080c9a0a2c42ab35dc7ead94bf0db96b9ec25517e17e42a6bf3557786e3ff",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:0e4771c695abde644465e06e09292be710b2f5aad224f0ceced75a3896da2f2e",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:0e27252ac092cdae4603a5877d2c948f3759ad94a102e7b84ff2e2e064af695d",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:states-requirement",
      "rkaf:assertsValue": {
        "@value": "An employee returning from USERRA-covered service shall be credited with the hours of service that would have been performed but for the period of absence from work due to or necessitated by USERRA-covered service in determining eligibility for FMLA-qualifying leave, such that a person reemployed following USERRA-covered service has those hours added to any hours actually worked during the previous 12-month period to meet the hours of service requirement (subject to special rules in § 825.801(c) for airline flight crew employees).",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

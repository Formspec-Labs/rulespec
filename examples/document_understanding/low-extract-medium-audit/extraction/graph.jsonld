      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:875080c9a0a2c42ab35dc7ead94bf0db96b9ec25517e17e42a6bf3557786e3ff",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:0e4771c695abde644465e06e09292be710b2f5aad224f0ceced75a3896da2f2e",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:7765633aabd16a890cc784a1c5ad04fbbea9a10bb9eb0065f4e298c2d2348de4",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"effective_periods\":[],\"jurisdiction\":\"\",\"kind\":\"statement\",\"logic_text\":\"(2) An employee returning from USERRA-covered service shall be credited with the hours of service that would have been performed but for the period of absence from work due to or necessitated by USERRA-covered service in determining the employee's eligibility for FMLA-qualifying leave. Accordingly, a person reemployed following USERRA-covered service has the hours that would have been worked for the employer added to any hours actually worked during the previous 12-month period to meet the hours of service requirement. In order to determine the hours that would have been worked during the period of absence from work due to or necessitated by USERRA-covered service, the employee's pre-service work schedule can generally be used for calculations. See § 825.801(c) for special rules applicable to airline flight crew employees.\",\"modality\":\"possible\",\"object\":\"\",\"scope_text\":\"In order to determine the hours that would have been worked during the period of absence from work due to or necessitated by USERRA-covered service\",\"summary\":\"In order to determine the hours that would have been worked during the period of absence from work due to or necessitated by USERRA-covered service, the employee's pre-service work schedule can generally be used for calculations (referencing § 825.801(c) for airline flight crew employees).\",\"typed_values\":[]}",
        "@type": "xsd:string"
      },

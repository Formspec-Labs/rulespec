    {
      "@id": "urn:rulespec:document-understanding:scope:f1ea1fd2799b5172c09291ec74403c6fda0ea7e32507faa6b17e0aafe2cbd5ea",
      "@type": "rkaf:ApplicabilityScope",
      "rkaf:appliesInJurisdiction": [],
      "rkaf:applicabilityCondition": "In the event an employer does not maintain an accurate record of hours worked by an employee, including for employees who are exempt from FLSA's recordkeeping requirement (e.g., bona fide executive, administrative, and professional employees under 29 CFR part 541)"
    },
    {
      "@id": "urn:rulespec:document-understanding:assertion:88fae2db1d7f2e2a7bab49648db4fe35449358d6c8a9b1a7ff04eec4f6986165",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:875080c9a0a2c42ab35dc7ead94bf0db96b9ec25517e17e42a6bf3557786e3ff",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:0e4771c695abde644465e06e09292be710b2f5aad224f0ceced75a3896da2f2e",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:ad4aef7a3eb060a574fd6717847d35e73a0d0618b495dd08ee590fec2fd87f2f",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:states-requirement",
      "rkaf:assertsValue": {
        "@value": "In the event an employer does not maintain an accurate record of hours worked by an employee (including employees exempt from FLSA recordkeeping under 29 CFR part 541), the employer has the burden of showing that the employee has not worked the requisite hours, and must be able to clearly demonstrate that the employee (such as full-time teachers of an elementary, secondary, or higher education establishment) did not work 1,250 hours during the previous 12 months in order to claim ineligibility for FMLA leave (subject to § 825.801(d) for airline flight crew employees).",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },
    {

      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "(b) The 12 months an employee must have been employed by the employer need not be consecutive months, provided\n\n(1) Subject to the exceptions provided in paragraph (b)(2) of this section, employment periods prior to a break in service of seven years or more need not be counted in determining whether the employee has been employed by the employer for at least 12 months."
        },
        {
          "@type": "oa:TextPositionSelector",
          "oa:start": 592,
          "oa:end": 963,
          "rkaf:coordinateSystem": "rkaf:unicode-codepoint"

    {
      "@id": "urn:rulespec:document-understanding:assertion:67ae60b000a37a11e28e6351120a7d1a6f85c916fb8a290c3e698d07925bd4ce",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:875080c9a0a2c42ab35dc7ead94bf0db96b9ec25517e17e42a6bf3557786e3ff",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:0e4771c695abde644465e06e09292be710b2f5aad224f0ceced75a3896da2f2e",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:ad4aef7a3eb060a574fd6717847d35e73a0d0618b495dd08ee590fec2fd87f2f",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:logic_text",
      "rkaf:assertsValue": {
        "@value": "(3) In the event an employer does not maintain an accurate record of hours worked by an employee, including for employees who are exempt from FLSA's requirement that a record be kept of their hours worked (e.g., bona fide executive, administrative, and professional employees as defined in FLSA Regulations, 29 CFR part 541), the employer has the burden of showing that the employee has not worked the requisite hours. An employer must be able to clearly demonstrate, for example, that full-time teachers ( see § 825.102 for definition) of an elementary or secondary school system, or institution of higher education, or other educational establishment or institution (who often work outside the classroom or at their homes) did not work 1,250 hours during the previous 12 months in order to claim that the teachers are not eligible for FMLA leave. See § 825.801(d) for special rules applicable to airline flight crew employees.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },
    {
      "@id": "urn:rulespec:document-understanding:binding:a4e28bb7ea8085fa75671c1f7586ba4e57c7524317d9439191e56a963266b30d",

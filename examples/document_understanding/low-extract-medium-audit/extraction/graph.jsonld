    {
      "@id": "urn:rulespec:document-understanding:assertion:9376130813a884b7cb89320674f3158974fb353170c5ade67af57dd93b5f580a",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",

      "rkaf:assertsValue": {
        "@value": "Except as provided in paragraph (c)(2) of this section and in § 825.801, whether an employee has worked the minimum 1,250 hours of service is determined according to the principles established under the Fair Labor Standards Act (FLSA) for determining compensable hours of work (see 29 CFR part 785), where the determining factor is the number of hours an employee has worked for the employer within the meaning of the FLSA, not limited by methods of recordkeeping or compensation agreements that do not accurately reflect all hours worked or in service.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

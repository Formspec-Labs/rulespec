      "rkaf:assertsValue": {
        "@value": "Employment periods preceding a break in service of more than seven years must be counted in determining whether the employee has been employed by the employer for at least 12 months where the break in service is occasioned by the fulfillment of a USERRA-covered service obligation, or where a written agreement, including a collective bargaining agreement, exists concerning the employer's intention to rehire the employee after the break in service (e.g., for education or childrearing purposes).",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:states-prohibition",
      "rkaf:assertsValue": {
        "@value": "An employer may not terminate employee leave that has already started if the employee count drops below 50.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

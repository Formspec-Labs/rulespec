    {
      "@id": "urn:rulespec:document-understanding:revision:f7dd95ad3a6d6b3558ff152e26a11e9e7fd9069696dfe008b66c7b044eb625e5",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:f7dd95ad3a6d6b3558ff152e26a11e9e7fd9069696dfe008b66c7b044eb625e5",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",

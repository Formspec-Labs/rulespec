      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"effective_periods\":[],\"jurisdiction\":\"\",\"kind\":\"requirement\",\"logic_text\":\"(2) An employee returning from USERRA-covered service shall be credited with the hours of service that would have been performed but for the period of absence from work due to or necessitated by USERRA-covered service in determining the employee's eligibility for FMLA-qualifying leave. Accordingly, a person reemployed following USERRA-covered service has the hours that would have been worked for the employer added to any hours actually worked during the previous 12-month period to meet the hours of service requirement. In order to determine the hours that would have been worked during the period of absence from work due to or necessitated by USERRA-covered service, the employee's pre-service work schedule can generally be used for calculations. See § 825.801(c) for special rules applicable to airline flight crew employees.\",\"modality\":\"must\",\"object\":\"\",\"scope_text\":\"For an employee returning from USERRA-covered service, in determining the employee's eligibility for FMLA-qualifying leave\",\"summary\":\"An employee returning from USERRA-covered service shall be credited with the hours of service that would have been performed but for the period of absence from work due to or necessitated by USERRA-covered service in determining eligibility for FMLA-qualifying leave, such that a person reemployed following USERRA-covered service has those hours added to any hours actually worked during the previous 12-month period to meet the hours of service requirement (subject to special rules in § 825.801(c) for airline flight crew employees).\",\"typed_values\":[]}",
        "@type": "xsd:string"
      },

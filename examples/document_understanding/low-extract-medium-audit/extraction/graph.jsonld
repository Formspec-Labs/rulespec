      "rkaf:applicabilityCondition": "In order to determine the hours that would have been worked during the period of absence from work due to or necessitated by USERRA-covered service"
    },
    {
      "@id": "urn:rulespec:document-understanding:assertion:17464b1e551c40b009bf8f27da9d2ffc6713375252f34bd877356a143e8c81b9",

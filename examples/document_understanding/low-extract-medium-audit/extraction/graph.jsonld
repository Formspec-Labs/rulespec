      "rkaf:bindsAssertion": "urn:rulespec:document-understanding:assertion:a7ed4cdb65e131e34c27608b342d6d8877f3c60374d76132be29136b3cc3dbe2",
      "rkaf:evidenceRole": "rkaf:textualEvidence",
      "rkaf:evidentiaryFunction": "rkaf:supports",
      "rkaf:bindsSourceFragment": [
        "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa4cdfc9b75c8a1ed78c29b8a344913757e4b95198a4b069127aa9092960aaf4f:1159:1682:sha256-3583bfa13c136e40a1005ff1210b6c0bcc560609a0916bb52fde5527907c0b6a"
      ]
    },
    {
      "@id": "urn:rulespec:document-understanding:assertion:01078da42fb657f506c5b3d72fad19c48686d1363a34559466eb2364d67d1a55",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:875080c9a0a2c42ab35dc7ead94bf0db96b9ec25517e17e42a6bf3557786e3ff",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:0e4771c695abde644465e06e09292be710b2f5aad224f0ceced75a3896da2f2e",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:b90bbf0555f7b2a24cbb389705b721ce259fd835e0164a10ca22c64a07c77265",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:alternative:1",
      "rkaf:assertsValue": {
        "@value": "(ii) A written agreement, including a collective bargaining agreement, exists concerning the employer's intention to rehire the employee after the break in service (e.g., for purposes of the employee furthering his or her education or for childrearing purposes).",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:3d842245c25e3954f27c7aa7c1fafb40fba2dabf15d0d357a096783e910eface\",\"urn:rulespec:document-understanding:assertion:90ff8e4472c9bc22b0b63e74307cd0c3e8e07b08475b8fdbea758cc54a858f52\",\"urn:rulespec:document-understanding:assertion:757c9574880d44a91b76a62712b799c8dd16d48821d479f4430c54c932b84310\",\"urn:rulespec:document-understanding:assertion:fdde27757ecab59deab701bd441ca2f3f19573ea9611d4a76991b51821758a1b\",\"urn:rulespec:document-understanding:assertion:8d2cba9e4c7b0577e02a2154a4dab37566106243927bbe362cf39f02b1d06994\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[\"(a) An eligible employee is an employee of a covered employer who:\\n\\n(1) Has been employed by the employer for at least 12 months, and\"],\"effective_periods\":[],\"end\":702,\"evidence\":[{\"end\":702,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa4cdfc9b75c8a1ed78c29b8a344913757e4b95198a4b069127aa9092960aaf4f:592:702:sha256-130832d94200d58087ab6a46024a3a10483b1b99086401c1b273635c4e31aaf3\",\"quote\":\"(b) The 12 months an employee must have been employed by the employer need not be consecutive months, provided\",\"start\":592},{\"end\":702,\"field\":\"logic_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa4cdfc9b75c8a1ed78c29b8a344913757e4b95198a4b069127aa9092960aaf4f:592:702:sha256-130832d94200d58087ab6a46024a3a10483b1b99086401c1b273635c4e31aaf3\",\"quote\":\"(b) The 12 months an employee must have been employed by the employer need not be consecutive months, provided\",\"start\":592},{\"end\":670,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa4cdfc9b75c8a1ed78c29b8a344913757e4b95198a4b069127aa9092960aaf4f:662:670:sha256-b00eebc92fbf41e3d233b28a918c7b90de96d6a15c0daebb94dde8af457529df\",\"quote\":\"need not\",\"start\":662},{\"end\":963,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa4cdfc9b75c8a1ed78c29b8a344913757e4b95198a4b069127aa9092960aaf4f:592:963:sha256-4a7061fb4d62628f60012e3a783d4749a5926969fec61fd43ca33aa8bab52274\",\"quote\":\"(b) The 12 months an employee must have been employed by the employer need not be consecutive months, provided\\n\\n(1) Subject to the exceptions provided in paragraph (b)(2) of this section, employment periods prior to a break in service of seven years or more need not be counted in determining whether the employee has been employed by the employer for at least 12 months.\",\"start\":592},{\"end\":170,\"field\":\"context:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa4cdfc9b75c8a1ed78c29b8a344913757e4b95198a4b069127aa9092960aaf4f:37:170:sha256-e8dceea1815ca622686e268009c20b852f30ddfb5306ce984a5c4dada3a6fd4d\",\"quote\":\"(a) An eligible employee is an employee of a covered employer who:\\n\\n(1) Has been employed by the employer for at least 12 months, and\",\"start\":37}],\"id\":\"urn:rulespec:document-understanding:revision:a45696847e6b59b4b46359c7d7053950c4da94a192e5e1ee7292974f1b93430b\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"exemption\",\"logic_text\":\"(b) The 12 months an employee must have been employed by the employer need not be consecutive months, provided\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:8d2cba9e4c7b0577e02a2154a4dab37566106243927bbe362cf39f02b1d06994\",\"modality\":\"not_required\",\"modality_quote\":\"need not\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:62538f3c30fd751c48073cc951e445fa7c094a3bf0cdc8f807cac862f5fbea36\",\"origin\":\"aiSuggested\",\"quote\":\"(b) The 12 months an employee must have been employed by the employer need not be consecutive months, provided\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:0f553f2d8c976902d624fc4217c4f3631db794dfbbb1d0d2ae37e8e5d021ae71\",\"scope_quotes\":[\"(b) The 12 months an employee must have been employed by the employer need not be consecutive months, provided\\n\\n(1) Subject to the exceptions provided in paragraph (b)(2) of this section, employment periods prior to a break in service of seven years or more need not be counted in determining whether the employee has been employed by the employer for at least 12 months.\"],\"scope_text\":\"With respect to the 12 months an employee must have been employed by the employer, provided that, subject to paragraph (b)(2), employment periods prior to a break in service of seven years or more need not be counted\",\"section_id\":\"section-1\",\"start\":592,\"summary\":\"The 12 months an employee must have been employed by the employer need not be consecutive months.\",\"target_ids\":[],\"typed_values\":[]}",

      "rkaf:appliesInJurisdiction": [],
      "rkaf:applicabilityCondition": "When an employer employs 60 employees in August but expects the number of employees to drop to 40 in December, and an otherwise eligible employee gives notice in August for leave beginning in December"
    },
    {
      "@id": "urn:rulespec:document-understanding:assertion:1d1539cde181260ef47ba050426677d08330b2072382dacd3ce1c2a5bbdcbc6e",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:875080c9a0a2c42ab35dc7ead94bf0db96b9ec25517e17e42a6bf3557786e3ff",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:0e4771c695abde644465e06e09292be710b2f5aad224f0ceced75a3896da2f2e",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:419be38b04327b94f7ba19ee6c5718156f794895e6e03737f5a29ce9dd0a5c85",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:states-requirement",
      "rkaf:assertsValue": {
        "@value": "An employer must grant FMLA benefits to an otherwise eligible employee who gives notice of the need for leave in August for a period of leave to begin in December, even if the employer expects its employee count to drop from 60 in August to 40 in December.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

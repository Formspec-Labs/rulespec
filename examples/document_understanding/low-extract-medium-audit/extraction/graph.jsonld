    {
      "@id": "urn:rulespec:document-understanding:revision:7a7ee46ab2d5b18c7f73af00c319ef07a8482b9cdd6c48bf4d9de74e3c3d32b5",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:7a7ee46ab2d5b18c7f73af00c319ef07a8482b9cdd6c48bf4d9de74e3c3d32b5",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:ccc18592d752b428d1e6dfe7808e1a6504478f48b267b779e2bc366d63f13efd",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:17464b1e551c40b009bf8f27da9d2ffc6713375252f34bd877356a143e8c81b9\",\"urn:rulespec:document-understanding:assertion:5a6a923404439f93d3124f7f6231af32502046851a3f362a8c3b976cf689a2a0\",\"urn:rulespec:document-understanding:assertion:9681d2a5552f0bdf1c9652e16107d935e2930527daf87a8cdfffe90f6ce1fe25\",\"urn:rulespec:document-understanding:assertion:e37687ef8df846508fbf5465988e91c0929f476825973d2dcd2bbc2363d5d526\",\"urn:rulespec:document-understanding:assertion:811cc898057f297a80fef0da6955647cfab8537d08a81d17702683a5e43c5fe6\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[\"(2) An employee returning from USERRA-covered service shall be credited with the hours of service that would have been performed but for the period of absence from work due to or necessitated by USERRA-covered service in determining the employee's eligibility for FMLA-qualifying leave. Accordingly, a person reemployed following USERRA-covered service has the hours that would have been worked for the employer added to any hours actually worked during the previous 12-month period to meet the hours of service requirement. In order to determine the hours that would have been worked during the period of absence from work due to or necessitated by USERRA-covered service, the employee's pre-service work schedule can generally be used for calculations. See § 825.801(c) for special rules applicable to airline flight crew employees.\"],\"effective_periods\":[],\"end\":4438,\"evidence\":[{\"end\":4438,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa4cdfc9b75c8a1ed78c29b8a344913757e4b95198a4b069127aa9092960aaf4f:3604:4438:sha256-7dbcb059fc78a2f697d27032e4d0f71484bebb06578094a6d4adecf70f95a027\",\"quote\":\"(2) An employee returning from USERRA-covered service shall be credited with the hours of service that would have been performed but for the period of absence from work due to or necessitated by USERRA-covered service in determining the employee's eligibility for FMLA-qualifying leave. Accordingly, a person reemployed following USERRA-covered service has the hours that would have been worked for the employer added to any hours actually worked during the previous 12-month period to meet the hours of service requirement. In order to determine the hours that would have been worked during the period of absence from work due to or necessitated by USERRA-covered service, the employee's pre-service work schedule can generally be used for calculations. See § 825.801(c) for special rules applicable to airline flight crew employees.\",\"start\":3604},{\"end\":4438,\"field\":\"logic_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa4cdfc9b75c8a1ed78c29b8a344913757e4b95198a4b069127aa9092960aaf4f:3604:4438:sha256-7dbcb059fc78a2f697d27032e4d0f71484bebb06578094a6d4adecf70f95a027\",\"quote\":\"(2) An employee returning from USERRA-covered service shall be credited with the hours of service that would have been performed but for the period of absence from work due to or necessitated by USERRA-covered service in determining the employee's eligibility for FMLA-qualifying leave. Accordingly, a person reemployed following USERRA-covered service has the hours that would have been worked for the employer added to any hours actually worked during the previous 12-month period to meet the hours of service requirement. In order to determine the hours that would have been worked during the period of absence from work due to or necessitated by USERRA-covered service, the employee's pre-service work schedule can generally be used for calculations. See § 825.801(c) for special rules applicable to airline flight crew employees.\",\"start\":3604},{\"end\":4332,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa4cdfc9b75c8a1ed78c29b8a344913757e4b95198a4b069127aa9092960aaf4f:4323:4332:sha256-8ed42f97cfcba562d7258c7a14a06d41b53c672ea7d5b78473b8065967aa8403\",\"quote\":\"generally\",\"start\":4323},{\"end\":4438,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa4cdfc9b75c8a1ed78c29b8a344913757e4b95198a4b069127aa9092960aaf4f:3604:4438:sha256-7dbcb059fc78a2f697d27032e4d0f71484bebb06578094a6d4adecf70f95a027\",\"quote\":\"(2) An employee returning from USERRA-covered service shall be credited with the hours of service that would have been performed but for the period of absence from work due to or necessitated by USERRA-covered service in determining the employee's eligibility for FMLA-qualifying leave. Accordingly, a person reemployed following USERRA-covered service has the hours that would have been worked for the employer added to any hours actually worked during the previous 12-month period to meet the hours of service requirement. In order to determine the hours that would have been worked during the period of absence from work due to or necessitated by USERRA-covered service, the employee's pre-service work schedule can generally be used for calculations. See § 825.801(c) for special rules applicable to airline flight crew employees.\",\"start\":3604},{\"end\":4438,\"field\":\"context:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa4cdfc9b75c8a1ed78c29b8a344913757e4b95198a4b069127aa9092960aaf4f:3604:4438:sha256-7dbcb059fc78a2f697d27032e4d0f71484bebb06578094a6d4adecf70f95a027\",\"quote\":\"(2) An employee returning from USERRA-covered service shall be credited with the hours of service that would have been performed but for the period of absence from work due to or necessitated by USERRA-covered service in determining the employee's eligibility for FMLA-qualifying leave. Accordingly, a person reemployed following USERRA-covered service has the hours that would have been worked for the employer added to any hours actually worked during the previous 12-month period to meet the hours of service requirement. In order to determine the hours that would have been worked during the period of absence from work due to or necessitated by USERRA-covered service, the employee's pre-service work schedule can generally be used for calculations. See § 825.801(c) for special rules applicable to airline flight crew employees.\",\"start\":3604}],\"id\":\"urn:rulespec:document-understanding:revision:7a7ee46ab2d5b18c7f73af00c319ef07a8482b9cdd6c48bf4d9de74e3c3d32b5\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"statement\",\"logic_text\":\"(2) An employee returning from USERRA-covered service shall be credited with the hours of service that would have been performed but for the period of absence from work due to or necessitated by USERRA-covered service in determining the employee's eligibility for FMLA-qualifying leave. Accordingly, a person reemployed following USERRA-covered service has the hours that would have been worked for the employer added to any hours actually worked during the previous 12-month period to meet the hours of service requirement. In order to determine the hours that would have been worked during the period of absence from work due to or necessitated by USERRA-covered service, the employee's pre-service work schedule can generally be used for calculations. See § 825.801(c) for special rules applicable to airline flight crew employees.\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:811cc898057f297a80fef0da6955647cfab8537d08a81d17702683a5e43c5fe6\",\"modality\":\"possible\",\"modality_quote\":\"generally\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:09b1c3f4312c2c680071181645caab808390e2fa290a9489573fa96707216a04\",\"origin\":\"aiSuggested\",\"quote\":\"(2) An employee returning from USERRA-covered service shall be credited with the hours of service that would have been performed but for the period of absence from work due to or necessitated by USERRA-covered service in determining the employee's eligibility for FMLA-qualifying leave. Accordingly, a person reemployed following USERRA-covered service has the hours that would have been worked for the employer added to any hours actually worked during the previous 12-month period to meet the hours of service requirement. In order to determine the hours that would have been worked during the period of absence from work due to or necessitated by USERRA-covered service, the employee's pre-service work schedule can generally be used for calculations. See § 825.801(c) for special rules applicable to airline flight crew employees.\",\"references\":[\"USERRA\",\"§ 825.801(c)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:7765633aabd16a890cc784a1c5ad04fbbea9a10bb9eb0065f4e298c2d2348de4\",\"scope_quotes\":[\"(2) An employee returning from USERRA-covered service shall be credited with the hours of service that would have been performed but for the period of absence from work due to or necessitated by USERRA-covered service in determining the employee's eligibility for FMLA-qualifying leave. Accordingly, a person reemployed following USERRA-covered service has the hours that would have been worked for the employer added to any hours actually worked during the previous 12-month period to meet the hours of service requirement. In order to determine the hours that would have been worked during the period of absence from work due to or necessitated by USERRA-covered service, the employee's pre-service work schedule can generally be used for calculations. See § 825.801(c) for special rules applicable to airline flight crew employees.\"],\"scope_text\":\"In order to determine the hours that would have been worked during the period of absence from work due to or necessitated by USERRA-covered service\",\"section_id\":\"section-1\",\"start\":3604,\"summary\":\"In order to determine the hours that would have been worked during the period of absence from work due to or necessitated by USERRA-covered service, the employee's pre-service work schedule can generally be used for calculations (referencing § 825.801(c) for airline flight crew employees).\",\"target_ids\":[],\"typed_values\":[]}",
      "dcterms:references": [
        {
          "@id": "urn:rulespec:document-understanding:assertion:17464b1e551c40b009bf8f27da9d2ffc6713375252f34bd877356a143e8c81b9"

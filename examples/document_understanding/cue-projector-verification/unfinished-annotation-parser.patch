+def _split_cue_comment(line: str) -> tuple[str, Optional[str]]:
+    """Find a line comment outside quoted text, including escaped quotes."""
+    quoted = escaped = False
+    for index, char in enumerate(line):
+        if quoted:
+            if escaped:
+                escaped = False
+            elif char == "\\":
+                escaped = True
+            elif char == '"':
+                quoted = False
+        elif char == '"':
+            quoted = True
+        elif line.startswith("//", index):
+            return line[:index].rstrip(), line[index + 2:].removeprefix(" ")
+    return line.rstrip(), None
+
+
+def _extract_schema_annotations(line: str) -> tuple[str, dict[str, str]]:
+    """Read literal @title/@description attributes; leave other CUE intact."""
+    annotations: dict[str, str] = {}
+    kept: list[str] = []
+    index = 0
+    quoted = escaped = False
+    while index < len(line):
+        char = line[index]
+        if quoted:
+            kept.append(char)
+            if escaped:
+                escaped = False
+            elif char == "\\":
+                escaped = True
+            elif char == '"':
+                quoted = False
+            index += 1
+            continue
+        if char == '"':
+            quoted = True
+        match = re.match(r"@(title|description)\b", line[index:]) if char == "@" else None
+        if match:
+            name = match.group(1)
+            argument = index + match.end()
+            while argument < len(line) and line[argument].isspace():
+                argument += 1
+            if argument >= len(line) or line[argument] != "(":
+                raise CompileError(f"@{name} requires one JSON-compatible quoted string")
+            argument += 1
+            while argument < len(line) and line[argument].isspace():
+                argument += 1
+            try:
+                value, end = json.JSONDecoder().raw_decode(line, argument)
+            except ValueError as exc:
+                raise CompileError(f"@{name} requires one JSON-compatible quoted string") from exc
+            while end < len(line) and line[end].isspace():
+                end += 1
+            if not isinstance(value, str) or end >= len(line) or line[end] != ")":
+                raise CompileError(f"@{name} requires one JSON-compatible quoted string")
+            if name in annotations and annotations[name] != value:
+                raise CompileError(f"conflicting @{name} annotations on one declaration")
+            annotations[name] = value
+            index = end + 1
+            continue
+        kept.append(char)
+        index += 1
+    return "".join(kept).rstrip(), annotations
+
+
+def _documented_cue_lines(source: str) -> list[tuple[str, dict[str, str]]]:
+    """Attach adjacent documentation to declarations before structural parsing."""
+    result: list[tuple[str, dict[str, str]]] = []
+    pending: list[str] = []
+    for raw in source.splitlines():
+        code, comment = _split_cue_comment(raw)
+        if not code.strip() and comment is not None:
+            pending.append(comment)
+            result.append(("", {}))
+            continue
+        code, explicit = _extract_schema_annotations(code)
+        documented = bool(re.match(r'^\s*(?:#\w+:|"[^"]+"\??:)', code))
+        annotations = {}
+        if documented:
+            description = "\n".join([*pending, *([comment] if comment is not None else [])]).strip()
+            if description:
+                annotations["description"] = description
+        annotations.update(explicit)
+        result.append((code, annotations))
+        pending = []
+    return result
+

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rulespec.org/jsonschema/open-label.json",
  "title": "open-label",
  "$defs": {
    "UsageEligibility": {
      "type": "string",
      "enum": [
        "rkaf:notEligible",
        "rkaf:searchOnly",
        "rkaf:reviewQueueOnly",
        "rkaf:draftGenerationAllowed",
        "rkaf:localOperationalUse",
        "rkaf:publicationAllowed",
        "rkaf:officialUse"
      ]
    },
    "ConsumerLifecycleState": {
      "type": "string",
      "enum": [
        "rkaf:draft",
        "rkaf:proposedForOperational",
        "rkaf:operational",
        "rkaf:staleForCurrentUse",
        "rkaf:published"
      ]
    },
    "AssertionOrigin": {
      "type": "string",
      "enum": [
        "rkaf:humanAsserted",
        "rkaf:aiSuggested",
        "rkaf:imported",
        "rkaf:deterministicExtraction"
      ]
    },
    "EpistemicBasis": {
      "type": "string",
      "enum": [
        "rkaf:sourceExplicit",
        "rkaf:deterministicDerivation",
        "rkaf:statisticalInference",
        "rkaf:editorialAssertion",
        "rkaf:userAssertion"
      ]
    },
    "AssertionPolarity": {
      "type": "string",
      "enum": [
        "rkaf:affirmed",
        "rkaf:denied"
      ]
    },
    "ValueDatatype": {
      "type": "string",
      "enum": [
        "xsd:string",
        "xsd:token",
        "xsd:boolean",
        "xsd:integer",
        "xsd:decimal",
        "xsd:double",
        "xsd:date",
        "xsd:dateTime",
        "xsd:time",
        "xsd:duration",
        "xsd:anyURI"
      ]
    },
    "ConceptAssignmentPredicate": {
      "type": "string",
      "enum": [
        "rkaf:assignmentPrimary",
        "rkaf:assignmentSubstantive",
        "rkaf:assignmentMention",
        "rkaf:assignmentContextual"
      ]
    },
    "ProvisionalAIUsageEligibility": {
      "type": "string",
      "enum": [
        "rkaf:notEligible",
        "rkaf:searchOnly",
        "rkaf:reviewQueueOnly"
      ]
    },
    "RefSpecOpenLabelValueAssertion": {
      "type": "object",
      "properties": {
        "@type": {
          "const": "rkaf:ValueAssertion"
        },
        "rkaf:usageEligibility": {
          "$ref": "#/$defs/UsageEligibility"
        },
        "rkaf:consumerLifecycleState": {
          "$ref": "#/$defs/ConsumerLifecycleState"
        },
        "rkaf:hasAccessScope": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
        },
        "rkaf:assertionOrigin": {
          "$ref": "#/$defs/AssertionOrigin"
        },
        "rkaf:epistemicBasis": {
          "$ref": "#/$defs/EpistemicBasis"
        },
        "rkaf:hasApplicability": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
        },
        "rkaf:hasJustification": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
        },
        "rkaf:hasWarrant": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
        },
        "rkaf:hasAuthority": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
        },
        "rkaf:hasRetentionPolicy": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
        },
        "prov:wasDerivedFrom": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
              }
            }
          ]
        },
        "rkaf:hasSourceClaimant": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
        },
        "rkaf:hasExtractionProvenance": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
        },
        "rkaf:hasConfidence": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
              }
            }
          ]
        },
        "rkaf:supersedesAssertion": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
              }
            }
          ]
        },
        "rkaf:assertedAt": {
          "type": "string"
        },
        "rkaf:assertsSubject": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
        },
        "rkaf:assertsPredicate": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
        },
        "rkaf:assertionPolarity": {
          "$ref": "#/$defs/AssertionPolarity"
        },
        "rkaf:assertsValue": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "@value": {
                  "type": "string"
                },
                "@type": {
                  "$ref": "#/$defs/ValueDatatype"
                }
              },
              "additionalProperties": false,
              "required": [
                "@value",
                "@type"
              ]
            },
            {
              "type": "object",
              "properties": {
                "@value": {
                  "type": "string"
                },
                "@language": {
                  "type": "string",
                  "pattern": "^(?:(?:[A-Za-z]{2,3}(?:-[A-Za-z]{3}){0,3}|[A-Za-z]{4}|[A-Za-z]{5,8})(?:-[A-Za-z]{4})?(?:-(?:[A-Za-z]{2}|[0-9]{3}))?(?:-(?:[A-Za-z0-9]{5,8}|[0-9][A-Za-z0-9]{3}))*(?:-[0-9A-WY-Za-wy-z](?:-[A-Za-z0-9]{2,8})+)*(?:-[xX](?:-[A-Za-z0-9]{1,8})+)?|[xX](?:-[A-Za-z0-9]{1,8})+|[eE][nN]-[gG][bB]-[oO][eE][dD]|[iI]-(?:[aA][mM][iI]|[bB][nN][nN]|[dD][eE][fF][aA][uU][lL][tT]|[eE][nN][oO][cC][hH][iI][aA][nN]|[hH][aA][kK]|[kK][lL][iI][nN][gG][oO][nN]|[lL][uU][xX]|[mM][iI][nN][gG][oO]|[nN][aA][vV][aA][jJ][oO]|[pP][wW][nN]|[tT][aA][oO]|[tT][aA][yY]|[tT][sS][uU])|[sS][gG][nN]-(?:[bB][eE]-[fF][rR]|[bB][eE]-[nN][lL]|[cC][hH]-[dD][eE])|[aA][rR][tT]-[lL][oO][jJ][bB][aA][nN]|[cC][eE][lL]-[gG][aA][uU][lL][iI][sS][hH]|[nN][oO]-(?:[bB][oO][kK]|[nN][yY][nN])|[zZ][hH]-(?:[gG][uU][oO][yY][uU]|[hH][aA][kK][kK][aA]|[mM][iI][nN]|[mM][iI][nN]-[nN][aA][nN]|[xX][iI][aA][nN][gG]))$",
                  "not": {
                    "pattern": "^@none$"
                  }
                }
              },
              "additionalProperties": false,
              "required": [
                "@value",
                "@language"
              ]
            }
          ]
        },
        "rkaf:openLabelFacet": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
        },
        "rkaf:openLabelRole": {
          "$ref": "#/$defs/ConceptAssignmentPredicate"
        },
        "rkaf:hasAILineage": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
        }
      },
      "required": [
        "@type",
        "rkaf:assertionOrigin",
        "rkaf:epistemicBasis",
        "rkaf:assertsSubject",
        "rkaf:assertsPredicate",
        "rkaf:assertionPolarity",
        "rkaf:assertsValue"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "rkaf:assertionOrigin": {
                "anyOf": [
                  {
                    "const": "rkaf:aiSuggested"
                  },
                  {
                    "type": "array",
                    "contains": {
                      "const": "rkaf:aiSuggested"
                    }
                  }
                ]
              }
            },
            "required": [
              "rkaf:assertionOrigin"
            ]
          },
          "then": {
            "properties": {
              "rkaf:hasAILineage": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
              },
              "rkaf:usageEligibility": {
                "$ref": "#/$defs/ProvisionalAIUsageEligibility"
              }
            },
            "required": [
              "rkaf:hasAILineage",
              "rkaf:usageEligibility"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "rkaf:assertionOrigin": {
                "anyOf": [
                  {
                    "const": "rkaf:deterministicExtraction"
                  },
                  {
                    "type": "array",
                    "contains": {
                      "const": "rkaf:deterministicExtraction"
                    }
                  }
                ]
              }
            },
            "required": [
              "rkaf:assertionOrigin"
            ]
          },
          "then": {
            "properties": {
              "rkaf:hasExtractionProvenance": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
              }
            },
            "required": [
              "rkaf:hasExtractionProvenance"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "rkaf:assertsPredicate": {
                "anyOf": [
                  {
                    "const": "rkaf:openLabel"
                  },
                  {
                    "type": "array",
                    "contains": {
                      "const": "rkaf:openLabel"
                    }
                  }
                ]
              }
            },
            "required": [
              "rkaf:assertsPredicate"
            ]
          },
          "then": {
            "properties": {
              "rkaf:assertionPolarity": {
                "const": "rkaf:affirmed"
              },
              "rkaf:assertsValue": {
                "type": "object",
                "properties": {
                  "@value": {
                    "type": "string",
                    "pattern": "^[\\s\\S]+$"
                  },
                  "@language": {
                    "type": "string",
                    "pattern": "^(?:(?:[A-Za-z]{2,3}(?:-[A-Za-z]{3}){0,3}|[A-Za-z]{4}|[A-Za-z]{5,8})(?:-[A-Za-z]{4})?(?:-(?:[A-Za-z]{2}|[0-9]{3}))?(?:-(?:[A-Za-z0-9]{5,8}|[0-9][A-Za-z0-9]{3}))*(?:-[0-9A-WY-Za-wy-z](?:-[A-Za-z0-9]{2,8})+)*(?:-[xX](?:-[A-Za-z0-9]{1,8})+)?|[xX](?:-[A-Za-z0-9]{1,8})+|[eE][nN]-[gG][bB]-[oO][eE][dD]|[iI]-(?:[aA][mM][iI]|[bB][nN][nN]|[dD][eE][fF][aA][uU][lL][tT]|[eE][nN][oO][cC][hH][iI][aA][nN]|[hH][aA][kK]|[kK][lL][iI][nN][gG][oO][nN]|[lL][uU][xX]|[mM][iI][nN][gG][oO]|[nN][aA][vV][aA][jJ][oO]|[pP][wW][nN]|[tT][aA][oO]|[tT][aA][yY]|[tT][sS][uU])|[sS][gG][nN]-(?:[bB][eE]-[fF][rR]|[bB][eE]-[nN][lL]|[cC][hH]-[dD][eE])|[aA][rR][tT]-[lL][oO][jJ][bB][aA][nN]|[cC][eE][lL]-[gG][aA][uU][lL][iI][sS][hH]|[nN][oO]-(?:[bB][oO][kK]|[nN][yY][nN])|[zZ][hH]-(?:[gG][uU][oO][yY][uU]|[hH][aA][kK][kK][aA]|[mM][iI][nN]|[mM][iI][nN]-[nN][aA][nN]|[xX][iI][aA][nN][gG]))$",
                    "not": {
                      "pattern": "^@none$"
                    }
                  }
                },
                "additionalProperties": false,
                "required": [
                  "@value",
                  "@language"
                ]
              },
              "rkaf:openLabelFacet": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
              },
              "rkaf:openLabelRole": {
                "$ref": "#/$defs/ConceptAssignmentPredicate"
              },
              "rkaf:hasExtractionProvenance": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
              },
              "rkaf:assertedAt": {
                "type": "string"
              }
            },
            "required": [
              "rkaf:assertionPolarity",
              "rkaf:assertsValue",
              "rkaf:openLabelFacet",
              "rkaf:openLabelRole",
              "rkaf:hasExtractionProvenance",
              "rkaf:assertedAt"
            ]
          }
        }
      ]
    }
  }
}
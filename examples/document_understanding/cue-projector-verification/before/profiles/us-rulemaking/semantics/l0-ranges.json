{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rulespec.org/jsonschema/l0-ranges.json",
  "title": "l0-ranges",
  "$defs": {
    "USRulemakingL0RangeRegistry": {
      "type": "object",
      "properties": {
        "rkaf:publishedInProceeding": {
          "const": "rkaf:Proceeding"
        },
        "rkaf:publishedInDocket": {
          "const": "rkaf:Docket"
        },
        "dcat:qualifiedRelation": {
          "const": "rkaf:AgendaProceedingRelationship"
        },
        "dcterms:relation": {
          "const": "rkaf:Proceeding"
        },
        "rkaf:hasDocket": {
          "const": "rkaf:Docket"
        },
        "rkaf:proceedingAffects": {
          "const": "rkaf:Artifact"
        },
        "rkaf:proceedingProduces": {
          "const": "rkaf:Artifact"
        },
        "rkaf:proceedingSupersedes": {
          "const": "rkaf:Proceeding"
        },
        "rkaf:commentPeriodFor": {
          "const": "rkaf:Proceeding"
        },
        "rkaf:commentPeriodDocket": {
          "const": "rkaf:Docket"
        },
        "rkaf:commentPeriodOpenedBy": {
          "const": "rkaf:Artifact"
        }
      },
      "required": [
        "rkaf:publishedInProceeding",
        "rkaf:publishedInDocket",
        "dcat:qualifiedRelation",
        "dcterms:relation",
        "rkaf:hasDocket",
        "rkaf:proceedingAffects",
        "rkaf:proceedingProduces",
        "rkaf:proceedingSupersedes",
        "rkaf:commentPeriodFor",
        "rkaf:commentPeriodDocket",
        "rkaf:commentPeriodOpenedBy"
      ]
    }
  }
}
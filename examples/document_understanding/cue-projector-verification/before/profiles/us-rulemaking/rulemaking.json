{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rulespec.org/jsonschema/rulemaking.json",
  "title": "rulemaking",
  "$defs": {
    "AgendaItemIdentifierScheme": {
      "type": "string",
      "enum": [
        "rkaf:us-rin"
      ]
    },
    "AgendaObservationIdentifierScheme": {
      "type": "string",
      "enum": [
        "rkaf:urn-persistent"
      ]
    },
    "AgendaScopeStatus": {
      "type": "string",
      "enum": [
        "rkaf:agendaScopeRecurring",
        "rkaf:agendaScopeSingleObserved",
        "rkaf:agendaScopeUnresolved"
      ]
    },
    "AgendaStage": {
      "type": "string",
      "enum": [
        "rkaf:agendaPrerule",
        "rkaf:agendaProposed",
        "rkaf:agendaFinal",
        "rkaf:agendaLongterm",
        "rkaf:agendaCompleted"
      ]
    },
    "AgendaPriority": {
      "type": "string",
      "enum": [
        "rkaf:agendaPriorityEconomicallySignificant",
        "rkaf:agendaPriorityOtherSignificant",
        "rkaf:agendaPrioritySubstantiveNonsignificant",
        "rkaf:agendaPriorityRoutineFrequent",
        "rkaf:agendaPriorityInfoAdminOther"
      ]
    },
    "ProceedingIdentifierScheme": {
      "type": "string",
      "enum": [
        "rkaf:official-registry",
        "rkaf:partner-defined"
      ]
    },
    "DocketIdentifierScheme": {
      "type": "string",
      "enum": [
        "rkaf:us-regsgov",
        "rkaf:official-registry",
        "rkaf:partner-defined"
      ]
    },
    "ProceedingStage": {
      "type": "string",
      "enum": [
        "rkaf:proceedingPrerule",
        "rkaf:proceedingProposed",
        "rkaf:proceedingSupplemental",
        "rkaf:proceedingFinal",
        "rkaf:proceedingWithdrawn",
        "rkaf:proceedingLongterm",
        "rkaf:proceedingConcluded"
      ]
    },
    "ProceedingTerminationCause": {
      "type": "string",
      "enum": [
        "rkaf:agencyWithdrawal",
        "rkaf:judicialVacatur",
        "rkaf:congressionalDisapproval",
        "rkaf:administrativeConclusion"
      ]
    },
    "RegulatoryAgendaItem": {
      "type": "object",
      "properties": {
        "@type": {
          "const": "rkaf:RegulatoryAgendaItem"
        },
        "rkaf:hasAgendaItemIdentifier": {
          "type": "string",
          "pattern": "^urn:rkaf:us:rin:[0-9]{4}-[A-Z]{2}[0-9]{2}$"
        },
        "rkaf:agendaItemIdentifierScheme": {
          "$ref": "#/$defs/AgendaItemIdentifierScheme"
        },
        "rkaf:agendaScopeStatus": {
          "$ref": "#/$defs/AgendaScopeStatus"
        },
        "dcat:qualifiedRelation": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
              },
              "minItems": 1
            }
          ]
        }
      },
      "required": [
        "@type",
        "rkaf:hasAgendaItemIdentifier",
        "rkaf:agendaItemIdentifierScheme"
      ]
    },
    "RegulatoryAgendaObservation": {
      "type": "object",
      "properties": {
        "@type": {
          "const": "rkaf:RegulatoryAgendaObservation"
        },
        "rkaf:hasArtifactIdentifier": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
              },
              "minItems": 1
            }
          ]
        },
        "rkaf:artifactIdentifierScheme": {
          "anyOf": [
            {
              "$ref": "#/$defs/AgendaObservationIdentifierScheme"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/AgendaObservationIdentifierScheme"
              },
              "minItems": 1
            }
          ]
        },
        "foaf:primaryTopic": {
          "type": "string",
          "pattern": "^urn:rkaf:us:rin:[0-9]{4}-[A-Z]{2}[0-9]{2}$"
        },
        "rkaf:agendaStage": {
          "$ref": "#/$defs/AgendaStage"
        },
        "rkaf:agendaPriority": {
          "$ref": "#/$defs/AgendaPriority"
        },
        "rkaf:agendaAffectsCitation": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^urn:rkaf:us:cfr:[1-9][0-9]*:[0-9]+([a-z]|-[0-9]+)?(\\.[0-9]+[a-z]{0,3}(-[0-9a-z]+)*)?$"
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^urn:rkaf:us:cfr:[1-9][0-9]*:[0-9]+([a-z]|-[0-9]+)?(\\.[0-9]+[a-z]{0,3}(-[0-9a-z]+)*)?$"
              },
              "minItems": 1
            }
          ]
        },
        "rkaf:agendaAuthorityCitation": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^urn:rkaf:us:(usc:[1-9][0-9]*:[1-9][0-9]*[a-z]*(-[0-9a-z]+)*|pl:[1-9][0-9]*-[1-9][0-9]*)$"
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^urn:rkaf:us:(usc:[1-9][0-9]*:[1-9][0-9]*[a-z]*(-[0-9a-z]+)*|pl:[1-9][0-9]*-[1-9][0-9]*)$"
              },
              "minItems": 1
            }
          ]
        }
      },
      "required": [
        "@type",
        "rkaf:hasArtifactIdentifier",
        "rkaf:artifactIdentifierScheme",
        "foaf:primaryTopic"
      ]
    },
    "AgendaProceedingRelationship": {
      "type": "object",
      "properties": {
        "@type": {
          "const": "rkaf:AgendaProceedingRelationship"
        },
        "dcterms:relation": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
        },
        "dcat:hadRole": {
          "const": "rkaf:agendaTracksProceeding"
        },
        "prov:wasDerivedFrom": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
              },
              "minItems": 1
            }
          ]
        },
        "prov:wasGeneratedBy": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
        },
        "prov:wasAttributedTo": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
        },
        "prov:generatedAtTime": {
          "type": "string"
        }
      },
      "required": [
        "@type",
        "dcterms:relation",
        "dcat:hadRole",
        "prov:wasDerivedFrom",
        "prov:wasGeneratedBy",
        "prov:wasAttributedTo",
        "prov:generatedAtTime"
      ]
    },
    "Docket": {
      "type": "object",
      "properties": {
        "@type": {
          "const": "rkaf:Docket"
        },
        "rkaf:hasDocketIdentifier": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
        },
        "rkaf:docketIdentifierScheme": {
          "$ref": "#/$defs/DocketIdentifierScheme"
        },
        "rkaf:identifierRegistry": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
        }
      },
      "required": [
        "@type",
        "rkaf:hasDocketIdentifier",
        "rkaf:docketIdentifierScheme"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "rkaf:docketIdentifierScheme": {
                "anyOf": [
                  {
                    "const": "rkaf:us-regsgov"
                  },
                  {
                    "type": "array",
                    "contains": {
                      "const": "rkaf:us-regsgov"
                    }
                  }
                ]
              }
            },
            "required": [
              "rkaf:docketIdentifierScheme"
            ]
          },
          "then": {
            "properties": {
              "rkaf:hasDocketIdentifier": {
                "type": "string",
                "pattern": "^urn:rkaf:us:regsgov:[A-Z0-9]+([-_][A-Z0-9]+)*$"
              }
            },
            "required": [
              "rkaf:hasDocketIdentifier"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "rkaf:docketIdentifierScheme": {
                "anyOf": [
                  {
                    "const": "rkaf:official-registry"
                  },
                  {
                    "type": "array",
                    "contains": {
                      "const": "rkaf:official-registry"
                    }
                  }
                ]
              }
            },
            "required": [
              "rkaf:docketIdentifierScheme"
            ]
          },
          "then": {
            "properties": {
              "rkaf:identifierRegistry": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
              }
            },
            "required": [
              "rkaf:identifierRegistry"
            ]
          }
        }
      ]
    },
    "Proceeding": {
      "type": "object",
      "properties": {
        "@type": {
          "const": "rkaf:Proceeding"
        },
        "rkaf:hasProceedingIdentifier": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$",
          "not": {
            "pattern": "^urn:rkaf:us:(rin|regsgov):"
          }
        },
        "rkaf:proceedingIdentifierScheme": {
          "$ref": "#/$defs/ProceedingIdentifierScheme"
        },
        "rkaf:identifierRegistry": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
        },
        "rkaf:proceedingStage": {
          "$ref": "#/$defs/ProceedingStage"
        },
        "rkaf:proceedingTerminationCause": {
          "$ref": "#/$defs/ProceedingTerminationCause"
        },
        "rkaf:hasAuthority": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
              },
              "minItems": 1
            }
          ]
        },
        "rkaf:hasDocket": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
              },
              "minItems": 1
            }
          ]
        },
        "rkaf:proceedingAffects": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
              },
              "minItems": 1
            }
          ]
        },
        "rkaf:proceedingAffectsCitation": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^urn:rkaf:us:cfr:[1-9][0-9]*:[0-9]+([a-z]|-[0-9]+)?(\\.[0-9]+[a-z]{0,3}(-[0-9a-z]+)*)?$"
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^urn:rkaf:us:cfr:[1-9][0-9]*:[0-9]+([a-z]|-[0-9]+)?(\\.[0-9]+[a-z]{0,3}(-[0-9a-z]+)*)?$"
              },
              "minItems": 1
            }
          ]
        },
        "rkaf:proceedingProduces": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
              },
              "minItems": 1
            }
          ]
        },
        "rkaf:proceedingSupersedes": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
              },
              "minItems": 1
            }
          ]
        }
      },
      "required": [
        "@type",
        "rkaf:hasProceedingIdentifier",
        "rkaf:proceedingIdentifierScheme"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "rkaf:proceedingIdentifierScheme": {
                "anyOf": [
                  {
                    "const": "rkaf:official-registry"
                  },
                  {
                    "type": "array",
                    "contains": {
                      "const": "rkaf:official-registry"
                    }
                  }
                ]
              }
            },
            "required": [
              "rkaf:proceedingIdentifierScheme"
            ]
          },
          "then": {
            "properties": {
              "rkaf:identifierRegistry": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
              }
            },
            "required": [
              "rkaf:identifierRegistry"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "rkaf:proceedingStage": {
                "anyOf": [
                  {
                    "const": "rkaf:proceedingConcluded"
                  },
                  {
                    "type": "array",
                    "contains": {
                      "const": "rkaf:proceedingConcluded"
                    }
                  }
                ]
              }
            },
            "required": [
              "rkaf:proceedingStage"
            ]
          },
          "then": {
            "properties": {
              "rkaf:proceedingTerminationCause": {
                "$ref": "#/$defs/ProceedingTerminationCause"
              }
            },
            "required": [
              "rkaf:proceedingTerminationCause"
            ]
          }
        }
      ]
    },
    "CommentPeriod": {
      "type": "object",
      "properties": {
        "rkaf:commentPeriodFor": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
              },
              "minItems": 1
            }
          ]
        },
        "rkaf:commentPeriodDocket": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
              },
              "minItems": 1
            }
          ]
        },
        "@type": {
          "const": "rkaf:CommentPeriod"
        },
        "rkaf:commentPeriodOpenedBy": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
              },
              "minItems": 1
            }
          ]
        },
        "rkaf:commentPeriodStart": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "$comment": "Lexical date guard only. Calendar validity and interval ordering require the Rulespec validator or SHACL."
        },
        "rkaf:commentPeriodEnd": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "$comment": "Lexical date guard only. Calendar validity and interval ordering require the Rulespec validator or SHACL."
        },
        "prov:wasDerivedFrom": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
              },
              "minItems": 1
            }
          ]
        }
      },
      "required": [
        "@type",
        "rkaf:commentPeriodStart",
        "rkaf:commentPeriodEnd",
        "prov:wasDerivedFrom"
      ],
      "allOf": [
        {
          "anyOf": [
            {
              "properties": {
                "rkaf:commentPeriodFor": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
                    },
                    {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
                      },
                      "minItems": 1
                    }
                  ]
                }
              },
              "required": [
                "rkaf:commentPeriodFor"
              ]
            },
            {
              "properties": {
                "rkaf:commentPeriodDocket": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
                    },
                    {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
                      },
                      "minItems": 1
                    }
                  ]
                }
              },
              "required": [
                "rkaf:commentPeriodDocket"
              ]
            }
          ]
        }
      ],
      "x-rkaf-order": [
        {
          "lower": "rkaf:commentPeriodStart",
          "upper": "rkaf:commentPeriodEnd"
        }
      ]
    }
  }
}
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rulespec.org/jsonschema/l0-ranges.json",
  "title": "l0-ranges",
  "$defs": {
    "AnalysisL0RangeRegistry": {
      "type": "object",
      "properties": {
        "rkaf:changeEvidence": {
          "const": "rkaf:SourceFragment"
        },
        "rkaf:comparisonBaselineArtifact": {
          "const": "rkaf:Artifact"
        },
        "rkaf:comparisonObservedArtifact": {
          "const": "rkaf:Artifact"
        },
        "rkaf:comparisonProofRecord": {
          "const": "rkaf:ResolverProofRecord"
        },
        "rkaf:proofIssuer": {
          "const": "rkaf:ResolverProofIssuer"
        },
        "rkaf:proofComparisonContext": {
          "const": "rkaf:RelationComparisonContext"
        },
        "rkaf:findingComparisonContext": {
          "const": "rkaf:RelationComparisonContext"
        },
        "rkaf:findingProofRecord": {
          "const": "rkaf:ResolverProofRecord"
        },
        "rkaf:closureArtifact": {
          "const": "rkaf:Artifact"
        },
        "rkaf:closureRegion": {
          "const": "rkaf:SourceFragment"
        }
      },
      "required": [
        "rkaf:changeEvidence",
        "rkaf:comparisonBaselineArtifact",
        "rkaf:comparisonObservedArtifact",
        "rkaf:comparisonProofRecord",
        "rkaf:proofIssuer",
        "rkaf:proofComparisonContext",
        "rkaf:findingComparisonContext",
        "rkaf:findingProofRecord",
        "rkaf:closureArtifact",
        "rkaf:closureRegion"
      ]
    }
  }
}
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rulespec.org/jsonschema/l0-ranges.json",
  "title": "l0-ranges",
  "$defs": {
    "L0RangeRegistry": {
      "type": "object",
      "properties": {
        "rkaf:hasAuthority": {
          "const": "rkaf:Authority"
        },
        "dcterms:hasFormat": {
          "const": "rkaf:Artifact"
        },
        "dcterms:isFormatOf": {
          "const": "rkaf:Artifact"
        },
        "prov:wasRevisionOf": {
          "const": "rkaf:Artifact"
        },
        "prov:wasDerivedFrom": {
          "const": "prov:Entity"
        },
        "oa:hasSource": {
          "const": "rkaf:Artifact"
        },
        "rkaf:versionLineageEvidence": {
          "const": "rkaf:SourceFragment"
        },
        "rkaf:bindsSourceFragment": {
          "const": "rkaf:SourceFragment"
        },
        "rkaf:assignedConceptRelease": {
          "const": "rkaf:ReferenceResourceRelease"
        },
        "rkaf:sourceConceptRelease": {
          "const": "rkaf:ReferenceResourceRelease"
        },
        "rkaf:targetConceptRelease": {
          "const": "rkaf:ReferenceResourceRelease"
        },
        "dcat:distribution": {
          "const": "rkaf:Artifact"
        },
        "rkaf:hasAccessScope": {
          "const": "rkaf:AccessScope"
        },
        "rkaf:hasRetentionPolicy": {
          "const": "rkaf:RetentionPolicy"
        }
      },
      "required": [
        "rkaf:hasAuthority",
        "dcterms:hasFormat",
        "dcterms:isFormatOf",
        "prov:wasRevisionOf",
        "prov:wasDerivedFrom",
        "oa:hasSource",
        "rkaf:versionLineageEvidence",
        "rkaf:bindsSourceFragment",
        "rkaf:assignedConceptRelease",
        "rkaf:sourceConceptRelease",
        "rkaf:targetConceptRelease",
        "dcat:distribution",
        "rkaf:hasAccessScope",
        "rkaf:hasRetentionPolicy"
      ]
    }
  }
}
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rulespec.org/jsonschema/access-scope-leakage.json",
  "title": "access-scope-leakage",
  "$defs": {
    "NarrowerOrEqualScope": {
      "type": "object",
      "properties": {
        "@type": {
          "const": "rkaf:EvidenceBinding"
        },
        "rkaf:hasAccessScope": {
          "type": "string"
        },
        "rkaf:accessScopeKind": {
          "type": "string",
          "enum": [
            "rkaf:regulatoryRestricted",
            "rkaf:roleRestricted",
            "rkaf:personalRestricted",
            "rkaf:embargoUntil",
            "rkaf:organizationVisible",
            "rkaf:partnerVisible"
          ]
        }
      },
      "required": [
        "@type",
        "rkaf:hasAccessScope",
        "rkaf:accessScopeKind"
      ]
    }
  }
}
{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$defs": {
        "WarrantFamily": {
            "description": "Closed taxonomy (§4.4).",
            "enum": [
                "rkaf:legal",
                "rkaf:scientific",
                "rkaf:editorial",
                "rkaf:cryptographic",
                "rkaf:social",
                "rkaf:source-class"
            ]
        },
        "WarrantKind": {
            "anyOf": [
                {
                    "$ref": "#/$defs/WarrantKindLegal"
                },
                {
                    "$ref": "#/$defs/WarrantKindScientific"
                },
                {
                    "$ref": "#/$defs/WarrantKindEditorial"
                },
                {
                    "$ref": "#/$defs/WarrantKindCryptographic"
                },
                {
                    "$ref": "#/$defs/WarrantKindSocial"
                },
                {
                    "$ref": "#/$defs/WarrantKindSourceClass"
                }
            ]
        },
        "WarrantKindCryptographic": {
            "enum": [
                "rkaf:cryptographic",
                "rkaf:commitment"
            ]
        },
        "WarrantKindEditorial": {
            "enum": [
                "rkaf:editorial",
                "rkaf:factCheck",
                "rkaf:correction"
            ]
        },
        "WarrantKindLegal": {
            "enum": [
                "rkaf:legal",
                "rkaf:statutory",
                "rkaf:regulatory",
                "rkaf:delegated",
                "rkaf:organizational",
                "rkaf:contractual",
                "rkaf:localOperational",
                "rkaf:publication"
            ]
        },
        "WarrantKindScientific": {
            "enum": [
                "rkaf:methodological",
                "rkaf:empirical",
                "rkaf:replication",
                "rkaf:peerReview"
            ]
        },
        "WarrantKindSocial": {
            "enum": [
                "rkaf:consensus",
                "rkaf:expertOpinion",
                "rkaf:communityEndorsement"
            ]
        },
        "WarrantKindSourceClass": {
            "enum": [
                "rkaf:sourceReliability",
                "rkaf:provenanceClass"
            ]
        }
    },
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "@type": {
            "const": "rkaf:Warrant"
        },
        "rkaf:defeasible": {
            "type": "boolean",
            "description": "Annotation: defeasible (LegalRuleML interop)."
        },
        "rkaf:hasPredecessor": {
            "type": "array",
            "description": "Optional cross-warrant chain link.",
            "items": {
                "type": "string"
            }
        },
        "rkaf:warrantFamily": {
            "$ref": "#/$defs/WarrantFamily"
        },
        "rkaf:warrantKind": {
            "$ref": "#/$defs/WarrantKind"
        }
    },
    "required": [
        "rkaf:warrantFamily",
        "rkaf:warrantKind"
    ]
}

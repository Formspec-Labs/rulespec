{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$defs": {
        "AgendaItemIdentifierScheme": {
            "description": "Experimental US rulemaking-process module (spec/rkaf-rulemaking.md).\nA RIN identifies a durable RegulatoryAgendaItem. Proceedings, dockets, and\npublished documents retain separate identities.",
            "const": "rkaf:us-rin"
        },
        "AgendaScopeStatus": {
            "enum": [
                "rkaf:agendaScopeRecurring",
                "rkaf:agendaScopeSingleObserved",
                "rkaf:agendaScopeUnresolved"
            ]
        }
    },
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "@type": {
            "const": "rkaf:RegulatoryAgendaItem"
        },
        "dcat:qualifiedRelation": {
            "type": "array",
            "items": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
            },
            "minItems": 1
        },
        "rkaf:agendaItemIdentifierScheme": {
            "$ref": "#/$defs/AgendaItemIdentifierScheme"
        },
        "rkaf:agendaScopeStatus": {
            "$ref": "#/$defs/AgendaScopeStatus"
        },
        "rkaf:hasAgendaItemIdentifier": {
            "type": "string",
            "pattern": "^urn:rkaf:us:rin:[0-9]{4}-[A-Z]{2}[0-9]{2}$"
        }
    },
    "required": [
        "rkaf:hasAgendaItemIdentifier"
    ]
}

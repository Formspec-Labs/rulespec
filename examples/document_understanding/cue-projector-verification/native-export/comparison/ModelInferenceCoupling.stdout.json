{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "@type": {
            "const": "rkaf:ConfidenceRecord"
        },
        "rkaf:confidenceMethod": {
            "const": "rkaf:model-inference"
        },
        "rkaf:generatedBy": {
            "type": "string",
            "pattern": "^urn:rkaf:actor:model:"
        }
    },
    "required": [
        "rkaf:generatedBy"
    ]
}

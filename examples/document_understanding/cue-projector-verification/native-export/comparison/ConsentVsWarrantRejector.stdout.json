{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "@type": {
            "const": "rkaf:Warrant"
        },
        "rkaf:warrantKind": {
            "enum": [
                "rkaf:legal",
                "rkaf:statutory",
                "rkaf:regulatory",
                "rkaf:delegated",
                "rkaf:organizational",
                "rkaf:contractual",
                "rkaf:localOperational",
                "rkaf:publication",
                "rkaf:methodological",
                "rkaf:empirical",
                "rkaf:replication",
                "rkaf:peerReview",
                "rkaf:editorial",
                "rkaf:factCheck",
                "rkaf:correction",
                "rkaf:cryptographic",
                "rkaf:commitment",
                "rkaf:consensus",
                "rkaf:expertOpinion",
                "rkaf:communityEndorsement",
                "rkaf:sourceReliability",
                "rkaf:provenanceClass"
            ]
        }
    },
    "required": [
        "rkaf:warrantKind"
    ]
}

{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$defs": {
        "ScoreCategorical": {
            "enum": [
                "rkaf:very-low",
                "rkaf:low",
                "rkaf:medium",
                "rkaf:high",
                "rkaf:very-high"
            ]
        }
    },
    "description": "ConfidenceRecord rejects \"score theater\" by requiring confidenceMethod,\nconfidenceBasis, calibrationStatus, generatedBy on every record.",
    "anyOf": [
        {
            "type": "object",
            "properties": {
                "rkaf:score": {
                    "type": "number",
                    "maximum": 1,
                    "minimum": 0
                }
            },
            "required": [
                "rkaf:score"
            ]
        },
        {
            "type": "object",
            "properties": {
                "rkaf:scoreCategorical": {
                    "$ref": "#/$defs/ScoreCategorical"
                }
            },
            "required": [
                "rkaf:scoreCategorical"
            ]
        }
    ]
}

{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "description": "A reusable concept identifier.",
    "additionalProperties": false,
    "properties": {
        "a_label": {
            "type": "string",
            "description": "The source label."
        },
        "z_id": {
            "type": "string",
            "description": "Stable identifier. Use it in later references."
        }
    },
    "required": [
        "a_label",
        "z_id"
    ]
}

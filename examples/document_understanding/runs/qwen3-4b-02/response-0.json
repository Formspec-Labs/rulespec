  "response": "{\n  \"extractions\": [\n    {\n      \"requirement\": \"Each House shall be the Judge of the Elections, Returns and Qualifications of its own Members\",\n      \"requirement_attributes\": {\n        \"summary\": \"Each House shall be the Judge of the Elections, Returns and Qualifications of its own Members\",\n        \"actor\": \"Each House\",\n        \"applies_to\": \"\"\n      }\n    },\n    {\n      \"requirement\": \"a Majority of each shall constitute a Quorum to do Business\",\n      \"requirement_attributes\": {\n        \"summary\": \"A majority of each House constitutes a quorum to do business\",\n        \"actor\": \"Each House\",\n        \"applies_to\": \"\"\n      }\n    },\n    {\n      \"condition\": \"a smaller Number may adjourn from day to day\",\n      \"condition_attributes\": {\n        \"summary\": \"A smaller number may adjourn from day to day\",\n        \"actor\": \"Each House\",\n        \"applies_to\": \"a smaller Number may adjourn from day to day\"\n      }\n    },\n    {\n      \"condition\": \"may be authorized to compel the Attendance of absent Members\",\n      \"condition_attributes\": {\n        \"summary\": \"A smaller number may be authorized to compel attendance of absent members\",\n        \"actor\": \"Each House\",\n        \"applies_to\": \"a smaller Number may adjourn from day to day\"\n      }\n    },\n    {\n      \"condition\": \"in such Manner, and under such Penalties as each House may provide\",\n      \"condition_attributes\": {\n        \"summary\": \"In such manner and under such penalties as each House may provide\",\n        \"actor\": \"Each House\",\n        \"applies_to\": \"a smaller Number may adjourn from day to day\"\n      }\n    },\n    {\n      \"permission\": \"Each House may determine the Rules of its Proceedings\",\n      \"permission_attributes\": {\n        \"summary\": \"Each House may determine the rules of its proceedings\",\n        \"actor\": \"Each House\",\n        \"applie
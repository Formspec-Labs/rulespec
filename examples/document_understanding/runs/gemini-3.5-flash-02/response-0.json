            "text": "{\n  \"extractions\": [\n    {\n      \"requirement\": \"Each House shall be the Judge of the Elections, Returns and Qualifications of its own Members\",\n      \"requirement_attributes\": {\n        \"summary\": \"Each House must judge the elections, returns, and qualifications of its own members\",\n        \"actor\": \"Each House\",\n        \"applies_to\": \"\"\n      }\n    },\n    {\n      \"requirement\": \"a Majority of each shall constitute a Quorum to do Business\",\n      \"requirement_attributes\": {\n        \"summary\": \"A majority of each House must constitute a quorum to do business\",\n        \"actor\": \"Each House\",\n        \"applies_to\": \"\"\n      }\n    },\n    {\n      \"permission\": \"a smaller Number may adjourn from day to day\",\n      \"permission_attributes\": {\n        \"summary\": \"A smaller number of members may adjourn from day to day\",\n        \"actor\": \"a smaller Number\",\n        \"applies_to\": \"\"\n      }\n    },\n    {\n      \"permission\": \"may be authorized to compel the Attendance of absent Members\",\n      \"permission_attributes\": {\n        \"summary\": \"A smaller number of members may be authorized to compel the attendance of absent members\",\n        \"actor\": \"a smaller Number\",\n        \"applies_to\": \"\"\n      }\n    },\n    {\n      \"permission\": \"each House may provide\",\n      \"permission_attributes\": {\n        \"summary\": \"Each House may provide the manner and penalties for compelling attendance\",\n        \"actor\": \"each House\",\n        \"applies_to\": \"\"\n      }\n    },\n    {\n      \"permission\": \"Each House may determine the Rules of its Proceedings\",\n      \"permission_attributes\": {\n        \"summary\": \"Each House may determine the rules of its proceedings\",\n        \"actor\": \"Each House\",\n        \"applies_to\": \"\"\n      }\n    },\n    {\n      \"permission\": \"punish its Members for disorderly Behaviour\",\n      \"permission_attributes\": {\n        \"summary\": \"Each House may punish its members for disorderly behavior\",\n        \"actor\": \"Each House\",\n        \"applies_to\": \"\"\n      }\n    },\n    {\n      \"permission\": \"expel a Member\",\n      \"permission_attributes\": {\n        \"summary\": \"Each House may expel a member\",\n        \"actor\": \"Each House\",\n        \"applies_to\": \"\"\n      }\n    },\n    {\n      \"condition\": \"with the Concurrence of two thirds\",\n      \"condition_attributes\": {\n        \"summary\": \"Expelling a member requires the concurrence of two-thirds of the members\",\n        \"actor\": \"Each House\",\n        \"applies_to\": \"expel a Member\"\n      }\n    },\n    {\n      \"requirement\": \"Each House shall keep a Journal of its Proceedings\",\n      \"requirement_attributes\": {\n        \"summary\": \"Each House must keep a journal of its proceedings\",\n        \"actor\": \"Each House\",\n        \"applies_to\": \"\"\n      }\n    },\n    {\n      \"requirement\": \"from time to time publish the same\",\n      \"requirement_attributes\": {\n        \"summary\": \"Each House must publish its journal from time to time\",\n        \"actor\": \"Each House\",\n        \"applies_to\": \"\"\n      }\n    },\n    {\n      \"exception\": \"excepting such Parts as may in their Judgment require Secrecy\",\n      \"exception_attributes\": {\n        \"summary\": \"Parts of the journal that require secrecy in their judgment are exempt from publication\",\n        \"actor\": \"Each House\",\n        \"applies_to\": \"from time to time publish the same\"\n      }\n    },\n    {\n      \"requirement\": \"the Yeas and Nays of the Members of either House on any question shall, at the Desire of one fifth of those Present, be entered on the Journal\",\n      \"requirement_attributes\": {\n        \"summary\": \"The yeas and nays of the members on any question must be entered on the journal\",\n        \"actor\": \"either House\",\n        \"applies_to\": \"\"\n      }\n    },\n    {\n      \"condition\": \"at the Desire of one fifth of those Present\",\n      \"condition_attributes\": {\n        \"summary\": \"Entering the yeas and nays on the journal requires the desire of one-fifth of those present\",\n        \"actor\": \"Members of either House\",\n        \"applies_to\": \"the Yeas and Nays of the Members of either House on any question shall, at the Desire of one fifth of those Present, be entered on the Journal\"\n      }\n    },\n    {\n      \"prohibition\": \"Neither House, during the Session of Congress, shall, without the Consent of the other, adjourn for more than three days\",\n      \"prohibition_attributes\": {\n        \"summary\": \"Neither House shall adjourn for more than three days during the session of Congress without the consent of the other\",\n        \"actor\": \"Neither House\",\n        \"applies_to\": \"\"\n      }\n    },\n    {\n      \"prohibition\": \"nor to any other Place than that in which the two Houses shall be sitting\",\n      \"prohibition_attributes\": {\n        \"summary\": \"Neither House shall adjourn to any other place than where the two Houses are sitting\",\n        \"actor\": \"Neither House\",\n        \"applies_to\": \"\"\n      }\n    },\n    {\n      \"condition\": \"during the Session of Congress\",\n      \"condition_attributes\": {\n        \"summary\": \"The adjournment restrictions apply during the session of Congress\",\n        \"actor\": \"Neither House\",\n        \"applies_to\": \"Neither House, during the Session of Congress, shall, without the Consent of the other, adjourn for more than three days\"\n      }\n    },\n    {\n      \"condition\": \"without the Consent of the other\",\n      \"condition_attributes\": {\n        \"summary\": \"Adjourning for more than three days requires the consent of the other House\",\n        \"actor\": \"Neither House\",\n        \"applies_to\": \"Neither House, during the Session of Congress, shall, without the Consent of the other, adjourn for more than three days\"\n      }\n    }\n  ]\n}",

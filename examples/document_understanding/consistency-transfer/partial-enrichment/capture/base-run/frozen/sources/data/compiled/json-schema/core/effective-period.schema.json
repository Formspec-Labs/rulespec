{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rulespec.org/jsonschema/effective-period.json",
  "title": "effective-period",
  "$defs": {
    "EffectivePeriod": {
      "type": "object",
      "properties": {
        "@type": {
          "const": "rkaf:EffectivePeriod"
        },
        "rkaf:effectivePeriodStart": {
          "type": "string"
        },
        "rkaf:effectivePeriodEnd": {
          "type": "string"
        },
        "rkaf:retroactiveFrom": {
          "type": "string"
        },
        "rkaf:sunsetAt": {
          "type": "string"
        }
      },
      "required": [
        "@type",
        "rkaf:effectivePeriodStart"
      ]
    }
  }
}
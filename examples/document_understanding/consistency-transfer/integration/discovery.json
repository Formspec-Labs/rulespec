    {
      "id": "urn:rulespec:document-understanding:passage:3b7c85f0e25e4edf25b1db40a9ea03ff6da39f2e5f9e81102fc1cdb9ccd19c6e",
      "source": "urn:rulespec:document-understanding:document:671f8e499260a2e11465cb0d396dbf6e741bba3a2dbd843d1b6fad0fbbee374a",
      "text": "Appendix A to § 1910.151—First aid kits (Non-Mandatory)\n\n",
      "claim_ids": [],
      "evidence_refs": [
        {
          "id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A671f8e499260a2e11465cb0d396dbf6e741bba3a2dbd843d1b6fad0fbbee374a:683:740:sha256-e7b2ba3b845949ecac178bab892022fd6c62dddc6902bf21e05b01ff8c42d93b",
          "roles": [
            "source"
          ]
        }
      ],
      "start": 683,
      "end": 740,
      "parent_id": null,
      "kind": "paragraph",
      "structure_method": "text-paragraphs-and-list-markers/2",
      "window_ids": [
        "window-5dbbe442d792da93bc1c"
      ],
      "processing": "processed"
    },
    {
      "id": "urn:rulespec:document-understanding:passage:a536e0dd2c97afaa7c9a68c9e53327df241d1ac2a52056fa7c262bd7bcd19ce6",
      "source": "urn:rulespec:document-understanding:document:671f8e499260a2e11465cb0d396dbf6e741bba3a2dbd843d1b6fad0fbbee374a",
      "text": "First aid supplies are required to be readily available under paragraph § 1910.151(b). An example of the minimal contents of a generic first aid kit is described in American National Standard (ANSI) Z308.1-1998 “Minimum Requirements for Workplace First-aid Kits.” The contents of the kit listed in the ANSI standard should be adequate for small worksites. When larger operations or multiple operations are being conducted at the same location, employers should determine the need for additional first aid kits at the worksite, additional types of first aid equipment and supplies and additional quantities and types of supplies and equipment in the first aid kits.\n\n",
      "claim_ids": [
        "urn:rulespec:document-understanding:revision:f0b028039a366d77831a20310852a94c18f1d74e4b2bc23dea4f13207e6733be",
        "urn:rulespec:document-understanding:revision:f6b3b0061912734dc4c66cf3bc35e91920876be05685bb06108bec09b24692a8"
      ],
      "evidence_refs": [
        {
          "id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A671f8e499260a2e11465cb0d396dbf6e741bba3a2dbd843d1b6fad0fbbee374a:740:1406:sha256-f793fada40574b3524fc696a8edd3794616385a5c51592f44cff712ec02d5c60",
          "roles": [
            "source"
          ]
        },
        {
          "id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A671f8e499260a2e11465cb0d396dbf6e741bba3a2dbd843d1b6fad0fbbee374a:740:1404:sha256-b76b0b454dd014917350eee2d082bde7d8406b60d81d90c23e5b8ab5a9431761",
          "roles": [
            "summary",
            "scope_text:0"
          ]
        }
      ],
      "start": 740,
      "end": 1406,
      "parent_id": null,
      "kind": "paragraph",
      "structure_method": "text-paragraphs-and-list-markers/2",
      "window_ids": [

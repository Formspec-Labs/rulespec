art\":657},{\"end\":691,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa150f4ee3b06251ce1b4533a18231db38769787697dbaee26861e227c43e353a:683:691:sha256-df0465d9a394078860d809a83f39f74c2e1040a44d5115401199c3e4374d2729\",\"quote\":\"must not\",\"start\":683}],\"id\":\"urn:rulespec:document-understanding:revision:bc80c1a0d2279a3c2c81121920d7729dd23794fe7a2f3555bb09331d6d51115f\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"prohibition\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:3a4670a2ff9e4402595034797b79ec3d96edf3e8794fdca9bee5503264b3614a\",\"modality\":\"must_not\",\"modality_quote\":\"must not\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:444b8a1555a35ba9a81606716f0533898e25b24a434e7a7a49c8f6a144f27986\",\"origin\":\"aiSuggested\",\"quote\":\"(1) Passport agencies/centers must not make unilateral changes or alterations to the IRLs without the approval of the Office of Adjudication (CA/PPT/S/A) except on a case-by-case basis with the approval of passport agency/center management in extenuating circumstances, e.g., when you request that the applicant submit a birth certificate instead of a notification of birth registration, and the applicant insists that the notification of birth registration is the birth certificate; and\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:0fa6e914f473d32a434aa632f5bd7dfe35398da09d186baa3570d633f0964d25\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":653,\"summary\":\"Passport agencies/centers must not make unilateral changes or alterations to the IRLs without the approval of the Office of Adjudication (CA/PPT/S/A) except on a case-by-case basis with the approval of passport agency/center management in extenuating circumstances (for example, when you request that the applicant submit a birth certificate instead of a notification of birth registration, and the applicant insists that the notification of birth registration is the birth certificate).\",\"target_ids\":[],\"term_refs\":[\"urn:rulespec:document-understanding:term:f9ac47964dc54ec817843cc350d95fb92491e1ae2838a38d3ddd47b11ff6f1fc\"],\"typed_values\":[]}",

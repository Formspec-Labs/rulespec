their passports.\",\"start\":1581}],\"id\":\"urn:rulespec:document-understanding:revision:4317588271e19e41db36f7f250989c4ff39ed42a51630c739a80d570e67ac425\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"statement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:e5192d458379cdd9426f52953389d0a9eb9c5e30970301e3deab30580c19e799\",\"modality\":\"possible\",\"modality_quote\":\"may\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:2daf41be121ba3abc167d9da83bdfdc71208c7c22b16759a5a89921036e8ca03\",\"origin\":\"aiSuggested\",\"quote\":\"For example, an IN may be included to explain why the passport was limited in validity, and/or what documentation is needed to obtain a fully valid passport.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:4c0db5331c9328c6aad09518f94659d4ed24f243af354a83396b6d8ee9e3dafa\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":1680,\"summary\":\"An IN may be included to explain why the passport was limited in validity, and/or what documentation is needed to obtain a fully valid passport.\",\"target_ids\":[],\"term_refs\":[\"urn:rulespec:document-understanding:term:dfc64b924eac00d9ce6d04b4f66d9c1926b3fa8701a10a48c97bbecbca0cbebf\"],\"typed_values\":[]}",

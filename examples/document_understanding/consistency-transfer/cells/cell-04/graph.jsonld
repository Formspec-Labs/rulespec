    {
      "@id": "urn:rulespec:document-understanding:revision:82399d2ea2045748a4137fca7a838819779c3c95f9c46a76a1645ebf797fa4cc",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:82399d2ea2045748a4137fca7a838819779c3c95f9c46a76a1645ebf797fa4cc",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:004ed871d914a477d85e43a7c4be7fb1fb9853e0a96f6215be15bb51209075f6",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"employers\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:69e515bd27fceaf409d948be8a561adf9c5db6c37c8fe910f41dc87f29410df7\",\"urn:rulespec:document-understanding:assertion:8ded379e1ef357cd898e9e11a35edc4aa54aac11126aee2206e6946d886af70a\",\"urn:rulespec:document-understanding:assertion:6402d558920130b028175fcf966316aa99b0303cd87c8c94fcd014688a044b85\",\"urn:rulespec:document-understanding:assertion:02f9fb6cf2ee202512e1689a51c0cdb6be4e7f54345279e171a4d85cc9d3885d\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":2053,\"evidence\":[{\"end\":2053,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A671f8e499260a2e11465cb0d396dbf6e741bba3a2dbd843d1b6fad0fbbee374a:1406:2053:sha256-470ff2aa1c86be7650a171bcb4974769e7a2a36cd8aebbbd1a3ab48231a8eca4\",\"quote\":\"In a similar fashion, employers who have unique or changing first-aid needs in their workplace may need to enhance their first-aid kits. The employer can use the OSHA 300 log, OSHA 301 log, or other reports to identify these unique problems. Consultation from the local fire/rescue department, appropriate medical professional, or local emergency room may be helpful to employers in these circumstances. By assessing the specific needs of their workplace, employers can ensure that reasonably anticipated supplies are available. Employers should assess the specific needs of their worksite periodically and augment the first aid kit appropriately.\",\"start\":1406}],\"id\":\"urn:rulespec:document-understanding:revision:82399d2ea2045748a4137fca7a838819779c3c95f9c46a76a1645ebf797fa4cc\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"statement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:02f9fb6cf2ee202512e1689a51c0cdb6be4e7f54345279e171a4d85cc9d3885d\",\"modality\":\"possible\",\"modality_quote\":\"can\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:11c703be852fe381a408c587e31da1ae41965ead9ccd6f762bf4b7d8511b37f6\",\"origin\":\"aiSuggested\",\"quote\":\"In a similar fashion, employers who have unique or changing first-aid needs in their workplace may need to enhance their first-aid kits. The employer can use the OSHA 300 log, OSHA 301 log, or other reports to identify these unique problems. Consultation from the local fire/rescue department, appropriate medical professional, or local emergency room may be helpful to employers in these circumstances. By assessing the specific needs of their workplace, employers can ensure that reasonably anticipated supplies are available. Employers should assess the specific needs of their worksite periodically and augment the first aid kit appropriately.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:b2c012116bf148a291416fc01a748f666f012511e8d757df738644f2dcf3c6d6\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":1406,\"summary\":\"By assessing the specific needs of their workplace, employers can ensure that reasonably anticipated supplies are available.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

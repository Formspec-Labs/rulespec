    {
      "@id": "urn:rulespec:document-understanding:revision:edf6d3ac76e3db438bc5f0c4da4377d3e13dfb6eef3ce426e76c3265c13dd0c8",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:edf6d3ac76e3db438bc5f0c4da4377d3e13dfb6eef3ce426e76c3265c13dd0c8",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:7a7eda724495379e428b80b483911819b6477a6e46277e3a7b5cf515d6af41d0",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"Employers\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:9a917c09d62af9752f754870d2eef57d1eb935b5822d0b6c641723b447a84383\",\"urn:rulespec:document-understanding:assertion:5163e477f4de2e11ae019012c51f5fd41477663125d6e38fc7a9f610a8a7b5c8\",\"urn:rulespec:document-understanding:assertion:8e2ad6f8873994307e1bce330d378d7ea7cd11e621ac2c4c650326fe79d96fdd\",\"urn:rulespec:document-understanding:assertion:ea2cdce3ff30ff8bac177c1fb4882f2757a8afe1fba3260f5f2a37b0534b65ef\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":2053,\"evidence\":[{\"end\":2053,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A671f8e499260a2e11465cb0d396dbf6e741bba3a2dbd843d1b6fad0fbbee374a:1406:2053:sha256-470ff2aa1c86be7650a171bcb4974769e7a2a36cd8aebbbd1a3ab48231a8eca4\",\"quote\":\"In a similar fashion, employers who have unique or changing first-aid needs in their workplace may need to enhance their first-aid kits. The employer can use the OSHA 300 log, OSHA 301 log, or other reports to identify these unique problems. Consultation from the local fire/rescue department, appropriate medical professional, or local emergency room may be helpful to employers in these circumstances. By assessing the specific needs of their workplace, employers can ensure that reasonably anticipated supplies are available. Employers should assess the specific needs of their worksite periodically and augment the first aid kit appropriately.\",\"start\":1406},{\"end\":1944,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A671f8e499260a2e11465cb0d396dbf6e741bba3a2dbd843d1b6fad0fbbee374a:1935:1944:sha256-e3651de74022e8e90bf0616f11d0689b2dc3dcbaaef910989bb0ba527551938f\",\"quote\":\"Employers\",\"start\":1935},{\"end\":1951,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A671f8e499260a2e11465cb0d396dbf6e741bba3a2dbd843d1b6fad0fbbee374a:1945:1951:sha256-f86b1f62a8554232b940f4fd9c8d6601aae4767456df3d6cdff55a51f17b5075\",\"quote\":\"should\",\"start\":1945}],\"id\":\"urn:rulespec:document-understanding:revision:edf6d3ac76e3db438bc5f0c4da4377d3e13dfb6eef3ce426e76c3265c13dd0c8\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"recommendation\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:ea2cdce3ff30ff8bac177c1fb4882f2757a8afe1fba3260f5f2a37b0534b65ef\",\"modality\":\"should\",\"modality_quote\":\"should\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:f6cac54e42c3dc181c37e9739d5b5cf0c39745737ba26296aa93e63b7915bbfe\",\"origin\":\"aiSuggested\",\"quote\":\"In a similar fashion, employers who have unique or changing first-aid needs in their workplace may need to enhance their first-aid kits. The employer can use the OSHA 300 log, OSHA 301 log, or other reports to identify these unique problems. Consultation from the local fire/rescue department, appropriate medical professional, or local emergency room may be helpful to employers in these circumstances. By assessing the specific needs of their workplace, employers can ensure that reasonably anticipated supplies are available. Employers should assess the specific needs of their worksite periodically and augment the first aid kit appropriately.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:bddbf3d89899527aa4c5e20660902d5c1c43f07af2454b7aa6789517b51ba38d\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":1406,\"summary\":\"Employers should assess the specific needs of their worksite periodically and augment the first aid kit appropriately.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

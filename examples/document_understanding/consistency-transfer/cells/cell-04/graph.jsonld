    {
      "@id": "urn:rulespec:document-understanding:revision:f0b028039a366d77831a20310852a94c18f1d74e4b2bc23dea4f13207e6733be",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:f0b028039a366d77831a20310852a94c18f1d74e4b2bc23dea4f13207e6733be",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:adf65db555d0eb7a72861f57bbecf634be111e8de72695c6f35bce399f4d5637",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:f538a5951c196f475258fec625b6dec09cc01b17f5e9c754bcb7b752c4df605f\",\"urn:rulespec:document-understanding:assertion:b2bf96cf8bfce82a6ed95d448953b540492b98ca4a809a5fae7ac10c71ab6b7a\",\"urn:rulespec:document-understanding:assertion:8830c0c9fc1709ad0d961969a5686c078f02af7450a7087342f68ecc7a95db23\",\"urn:rulespec:document-understanding:assertion:8abffcc2120ff0a56ec2c771675cca557bc6e7122f4cae3fbb017be2792ca72b\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":1404,\"evidence\":[{\"end\":1404,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A671f8e499260a2e11465cb0d396dbf6e741bba3a2dbd843d1b6fad0fbbee374a:740:1404:sha256-b76b0b454dd014917350eee2d082bde7d8406b60d81d90c23e5b8ab5a9431761\",\"quote\":\"First aid supplies are required to be readily available under paragraph § 1910.151(b). An example of the minimal contents of a generic first aid kit is described in American National Standard (ANSI) Z308.1-1998 “Minimum Requirements for Workplace First-aid Kits.” The contents of the kit listed in the ANSI standard should be adequate for small worksites. When larger operations or multiple operations are being conducted at the same location, employers should determine the need for additional first aid kits at the worksite, additional types of first aid equipment and supplies and additional quantities and types of supplies and equipment in the first aid kits.\",\"start\":740},{\"end\":1404,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A671f8e499260a2e11465cb0d396dbf6e741bba3a2dbd843d1b6fad0fbbee374a:740:1404:sha256-b76b0b454dd014917350eee2d082bde7d8406b60d81d90c23e5b8ab5a9431761\",\"quote\":\"First aid supplies are required to be readily available under paragraph § 1910.151(b). An example of the minimal contents of a generic first aid kit is described in American National Standard (ANSI) Z308.1-1998 “Minimum Requirements for Workplace First-aid Kits.” The contents of the kit listed in the ANSI standard should be adequate for small worksites. When larger operations or multiple operations are being conducted at the same location, employers should determine the need for additional first aid kits at the worksite, additional types of first aid equipment and supplies and additional quantities and types of supplies and equipment in the first aid kits.\",\"start\":740}],\"id\":\"urn:rulespec:document-understanding:revision:f0b028039a366d77831a20310852a94c18f1d74e4b2bc23dea4f13207e6733be\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"recommendation\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:8abffcc2120ff0a56ec2c771675cca557bc6e7122f4cae3fbb017be2792ca72b\",\"modality\":\"should\",\"modality_quote\":\"should\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:327fb9d7d27bc703a9dce9e1ec731b7553116e6e6fe3414693a7bc0209bddafe\",\"origin\":\"aiSuggested\",\"quote\":\"First aid supplies are required to be readily available under paragraph § 1910.151(b). An example of the minimal contents of a generic first aid kit is described in American National Standard (ANSI) Z308.1-1998 “Minimum Requirements for Workplace First-aid Kits.” The contents of the kit listed in the ANSI standard should be adequate for small worksites. When larger operations or multiple operations are being conducted at the same location, employers should determine the need for additional first aid kits at the worksite, additional types of first aid equipment and supplies and additional quantities and types of supplies and equipment in the first aid kits.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:6a413df2e57da8a642505457c907cf1110004c29fbc9a58897a087182b17e4ae\",\"scope_quotes\":[\"First aid supplies are required to be readily available under paragraph § 1910.151(b). An example of the minimal contents of a generic first aid kit is described in American National Standard (ANSI) Z308.1-1998 “Minimum Requirements for Workplace First-aid Kits.” The contents of the kit listed in the ANSI standard should be adequate for small worksites. When larger operations or multiple operations are being conducted at the same location, employers should determine the need for additional first aid kits at the worksite, additional types of first aid equipment and supplies and additional quantities and types of supplies and equipment in the first aid kits.\"],\"scope_text\":\"for small worksites\",\"section_id\":\"section-1\",\"start\":740,\"summary\":\"The contents of the generic first aid kit listed in American National Standard (ANSI) Z308.1-1998 “Minimum Requirements for Workplace First-aid Kits” should be adequate for small worksites.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

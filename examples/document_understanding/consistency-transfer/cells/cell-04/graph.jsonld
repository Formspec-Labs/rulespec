      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"employers\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:de45adeb1077391047a8a7cc80c9c6e18eae12429b5d9f261b5e19ea19f28ba4\",\"urn:rulespec:document-understanding:assertion:1fc2c0111decea37b935d8ff9fcae7f17d04835944532382c5e438af924ad65c\",\"urn:rulespec:document-understanding:assertion:eaea859d7524048c61ba4264fbb459e5b7764853df070635bddfe897fa8f5014\",\"urn:rulespec:document-understanding:assertion:98cd4865636d3fa6a56c2cfce62419065129d05585bdd841a79e06d4929262d4\",\"urn:rulespec:document-understanding:assertion:0a5a43dce332578dc47f83cc8f869835dee2dddd50a2cb1115f31e2396289e1e\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":2540,\"evidence\":[{\"end\":2540,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A671f8e499260a2e11465cb0d396dbf6e741bba3a2dbd843d1b6fad0fbbee374a:2055:2540:sha256-2c14eb6e234243104b6d1e58163fa67c12c7a279c364c6a58fe7e4fca7955375\",\"quote\":\"If it is reasonably anticipated that employees will be exposed to blood or other potentially infectious materials while using first aid supplies, employers are required to provide appropriate personal protective equipment (PPE) in compliance with the provisions of the Occupational Exposure to Blood borne Pathogens standard, § 1910.1030(d)(3) (56 FR 64175). This standard lists appropriate PPE for this type of exposure, such as gloves, gowns, face shields, masks, and eye protection.\",\"start\":2055},{\"end\":2210,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A671f8e499260a2e11465cb0d396dbf6e741bba3a2dbd843d1b6fad0fbbee374a:2201:2210:sha256-4dd7b69db8684897c072ef2bff51005a9459921720011b2d75355faed18795bf\",\"quote\":\"employers\",\"start\":2201},{\"end\":2223,\"f
      "rkaf:hasContentDigest": "sha256:d10e505cb4a1f0a1227e0b89f5771eb2b5f3827293b245f714261af8a362d8c7",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:15c4d8aa8e82cbdb933e6ac47faf91b8c94c389b3bbb79ef71b60811d4bdefb8\",\"urn:rulespec:document-understanding:assertion:bc0d601f49757b91f1735414d5c2d2ec7ac6f8876c2dd56397db414d140981be\",\"urn:rulespec:document-understanding:assertion:1663b1d8a66371e38e79f12a68f3f5dba4ae977a21af3f6104b4c67c5a4a14b1\",\"urn:rulespec:document-understanding:assertion:e207d496e50c2eb0ce15fa4fa81965a107771cad8c76508cdd63206b521eec5c\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":2053,\"evidence\":[{\"end\":2053,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A671f8e499260a2e11465cb0d396dbf6e741bba3a2dbd843d1b6fad0fbbee374a:1406:2053:sha256-470ff2aa1c86be7650a171bcb4974769e7a2a36cd8aebbbd1a3ab48231a8eca4\",\"quote\":\"In a similar fashion, employers who have unique or changing first-aid needs in their workplace may need to enhance their first-aid kits. The employer can use the OSHA 300 log, OSHA 301 log, or other reports to identify these unique problems. Consultation from the local fire/rescue department, appropriate medical professional, or local emergency room may be helpful to employers in these circumstances. By assessing the specific needs of their workplace, employers can ensure that reasonably anticipated supplies are available. Employers should assess the specific needs of their worksite periodically and augment the first aid kit appropriately.\",\"start\":1406},{\"end\":2053,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A671f8e499260a2e11465cb0d396dbf6e741bba3a2dbd843d1b6fad0fbbee374a:1406:2053:sha256-470ff2aa1c86be7650a171bcb4974769e7a2a36cd8aebbbd1a3ab48231a8eca4\",\"quote\":\"In a similar fashion, employers who have unique or changing first-aid needs in their workplace may need to enhance their first-aid kits. The employer can use the OSHA 300 log, OSHA 301 log, or other reports to identify these unique problems. Consultation from the local fire/rescue department, appropriate medical professional, or local emergency room may be helpful to employers in these circumstances. By assessing the specific needs of their workplace, employers can ensure that reasonably anticipated supplies are available. Employers should assess the specific needs of their worksite periodically and augment the first aid kit appropriately.\",\"start\":1406}],\"id\":\"urn:rulespec:document-understanding:revision:c853068a13072c38ab7e9e756c51883691102ec87f112ca08d6440cf7795e615\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"statement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:e207d496e50c2eb0ce15fa4fa81965a107771cad8c76508cdd63206b521eec5c\",\"modality\":\"possible\",\"modality_quote\":\"may\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:0cee4e79895d757cbc225b32d1b917a3765d69c1d28510a9406d5db3a0c55e34\",\"origin\":\"aiSuggested\",\"quote\":\"In a similar fashion, employers who have unique or changing first-aid needs in their workplace may need to enhance their first-aid kits. The employer can use the OSHA 300 log, OSHA 301 log, or other reports to identify these unique problems. Consultation from the local fire/rescue department, appropriate medical professional, or local emergency room may be helpful to employers in these circumstances. By assessing the specific needs of their workplace, employers can ensure that reasonably anticipated supplies are available. Employers should assess the specific needs of their worksite periodically and augment the first aid kit appropriately.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:9b45d85bbdec9c7a5899cc3a28a2d486bf064432c4608a55a0236c563c43bfc4\",\"scope_quotes\":[\"In a similar fashion, employers who have unique or changing first-aid needs in their workplace may need to enhance their first-aid kits. The employer can use the OSHA 300 log, OSHA 301 log, or other reports to identify these unique problems. Consultation from the local fire/rescue department, appropriate medical professional, or local emergency room may be helpful to employers in these circumstances. By assessing the specific needs of their workplace, employers can ensure that reasonably anticipated supplies are available. Employers should assess the specific needs of their worksite periodically and augment the first aid kit appropriately.\"],\"scope_text\":\"to employers in these circumstances\",\"section_id\":\"section-1\",\"start\":1406,\"summary\":\"Consultation from the local fire/rescue department, appropriate medical professional, or local emergency room may be helpful to employers when dealing with unique or changing first-aid needs.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

    {
      "@id": "urn:rulespec:document-understanding:revision:8ec2b41c9a99980a71c9d93e89629b891784185381d1c1bf982192ede192a316",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:8ec2b41c9a99980a71c9d93e89629b891784185381d1c1bf982192ede192a316",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:1d1cbcbb5b193ff5dc36e5b6e3268eb98ff34b6a7f191f51ab0d455c8398a224",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"employers who have unique or changing first-aid needs in their workplace\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:a2cd4cf6a66f49fd1b823d0ac43c2ee274c8766a6457c44415684f7f33b2a14e\",\"urn:rulespec:document-understanding:assertion:8a12ccdb7c788530843e1d1f2d151632eeb1fefd7912fa787c223f6df458e530\",\"urn:rulespec:document-understanding:assertion:37ed8a160cd8d174d2c543fb76f6b95b821cc0808c8046fe43dad2c099ffcfb2\",\"urn:rulespec:document-understanding:assertion:97103bb300df69969bad4c4858273fa4b1c8670a816c7f28ff227a74e931f8d9\",\"urn:rulespec:document-understanding:assertion:a32ec044ae473f81895f3698b8ab9674ae2903931c8339931e8ae271b28bf9b5\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":2053,\"evidence\":[{\"end\":2053,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A671f8e499260a2e11465cb0d396dbf6e741bba3a2dbd843d1b6fad0fbbee374a:1406:2053:sha256-470ff2aa1c86be7650a171bcb4974769e7a2a36cd8aebbbd1a3ab48231a8eca4\",\"quote\":\"In a similar fashion, employers who have unique or changing first-aid needs in their workplace may need to enhance their first-aid kits. The employer can use the OSHA 300 log, OSHA 301 log, or other reports to identify these unique problems. Consultation from the local fire/rescue department, appropriate medical professional, or local emergency room may be helpful to employers in these circumstances. By assessing the specific needs of their workplace, employers can ensure that reasonably anticipated supplies are available. Employers should assess the specific needs of their worksite periodically and augment the first aid kit appropriately.\",\"start\":1406},{\"end\":1500,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A671f8e499260a2e11465cb0d396dbf6e741bba3a2dbd843d1b6fad0fbbee374a:1428:1500:sha256-6f1ac71eac9f131ed6477fcad515ee4b5c91dee5b7cf909eb960710a948a2695\",\"quote\":\"employers who have unique or changing first-aid needs in their workplace\",\"start\":1428},{\"end\":2053,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A671f8e499260a2e11465cb0d396dbf6e741bba3a2dbd843d1b6fad0fbbee374a:1406:2053:sha256-470ff2aa1c86be7650a171bcb4974769e7a2a36cd8aebbbd1a3ab48231a8eca4\",\"quote\":\"In a similar fashion, employers who have unique or changing first-aid needs in their workplace may need to enhance their first-aid kits. The employer can use the OSHA 300 log, OSHA 301 log, or other reports to identify these unique problems. Consultation from the local fire/rescue department, appropriate medical professional, or local emergency room may be helpful to employers in these circumstances. By assessing the specific needs of their workplace, employers can ensure that reasonably anticipated supplies are available. Employers should assess the specific needs of their worksite periodically and augment the first aid kit appropriately.\",\"start\":1406}],\"id\":\"urn:rulespec:document-understanding:revision:8ec2b41c9a99980a71c9d93e89629b891784185381d1c1bf982192ede192a316\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"statement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:a32ec044ae473f81895f3698b8ab9674ae2903931c8339931e8ae271b28bf9b5\",\"modality\":\"possible\",\"modality_quote\":\"may\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:f54611a82ed505e0dce59f034f13f3afe92b70b550f92767c4b09efbeea37de5\",\"origin\":\"aiSuggested\",\"quote\":\"In a similar fashion, employers who have unique or changing first-aid needs in their workplace may need to enhance their first-aid kits. The employer can use the OSHA 300 log, OSHA 301 log, or other reports to identify these unique problems. Consultation from the local fire/rescue department, appropriate medical professional, or local emergency room may be helpful to employers in these circumstances. By assessing the specific needs of their workplace, employers can ensure that reasonably anticipated supplies are available. Employers should assess the specific needs of their worksite periodically and augment the first aid kit appropriately.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:9397dbedcf7de2791e45791ce3bb1b98629ff17412885702f7f506a02bb233c9\",\"scope_quotes\":[\"In a similar fashion, employers who have unique or changing first-aid needs in their workplace may need to enhance their first-aid kits. The employer can use the OSHA 300 log, OSHA 301 log, or other reports to identify these unique problems. Consultation from the local fire/rescue department, appropriate medical professional, or local emergency room may be helpful to employers in these circumstances. By assessing the specific needs of their workplace, employers can ensure that reasonably anticipated supplies are available. Employers should assess the specific needs of their worksite periodically and augment the first aid kit appropriately.\"],\"scope_text\":\"In a similar fashion, employers who have unique or changing first-aid needs in their workplace\",\"section_id\":\"section-1\",\"start\":1406,\"summary\":\"Employers who have unique or changing first-aid needs in their workplace may need to enhance their first-aid kits.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

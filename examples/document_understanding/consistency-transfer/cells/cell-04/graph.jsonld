    {
      "@id": "urn:rulespec:document-understanding:revision:c21407e42576937cdcb2196bf4a806322617f6bd98df36b6cbc9bdcaf2235522",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:c21407e42576937cdcb2196bf4a806322617f6bd98df36b6cbc9bdcaf2235522",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",

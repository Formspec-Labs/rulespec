      "rkaf:assertsValue": {
        "@value": "{\"actor\":\"Employers\",\"kind\":\"recommendation\",\"modality\":\"should\",\"summary\":\"Employers should assess the specific needs of their worksite periodically and augment the first aid kit appropriately.\"}",

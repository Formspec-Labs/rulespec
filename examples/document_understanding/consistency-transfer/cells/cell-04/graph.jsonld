      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"The employer\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:0e80079f30d7663ebea86a0e4ce8a292bbea7d27f07b17eae716f35a8e83486b\",\"urn:rulespec:document-understanding:assertion:3311c488ef9e3f862e95b76d42b890f154b873868a88409b2329958ae3464252\",\"urn:rulespec:document-understanding:assertion:587099386f7676449ee36952228b56002954ce2b65701ec44df4be31e7d18310\",\"urn:rulespec:document-understanding:assertion:fc4cb127321199eac171986f66ac4e3c1c001217e8ed84b2e3e2513d011c3fb9\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":2053,\"evidence\":[{\"end\":2053,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A671f8e499260a2e11465cb0d396dbf6e741bba3a2dbd843d1b6fad0fbbee374a:1406:2053:sha256-470ff2aa1c86be7650a171bcb4974769e7a2a36cd8aebbbd1a3ab48231a8eca4\",\"quote\":\"In a similar fashion, employers who have unique or changing first-aid needs in their workplace may need to enhance their first-aid kits. The employer can use the OSHA 300 log, OSHA 301 log, or other reports to identify these unique problems. Consultation from the local fire/rescue department, appropriate medical professional, or local emergency room may be helpful to employers in these circumstances. By assessing the specific needs of their workplace, employers can ensure that reasonably anticipated supplies are available. Employers should assess the specific needs of their worksite periodically and augment the first aid kit appropriately.\",\"start\":1406},{\"end\":1555,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A671f8e499260a2e11465cb0d396dbf6e741bba3a2dbd843d1b6fad0fbbee374a:1543:1555:sha256-eefbd88d5db7591f0fba1d7815d52329849e45a6af060ed107f64c722ed6245e\",\"quote\":\"The employer\",\"start\":1543}],\"id\":\"urn:rulespec:document-understanding:revision:c21407e42576937cdcb2196bf4a806322617f6bd98df36b6cbc9bdcaf2235522\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"permission\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:fc4cb127321199eac171986f66ac4e3c1c001217e8ed84b2e3e2513d011c3fb9\",\"modality\":\"may\",\"modality_quote\":\"can\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:10b4df094f7d2726ec6d9e34c42bd13cd7567f6e0a127eed23034074f5db2752\",\"origin\":\"aiSuggested\",\"quote\":\"In a similar fashion, employers who have unique or changing first-aid needs in their workplace may need to enhance their first-aid kits. The employer can use the OSHA 300 log, OSHA 301 log, or other reports to identify these unique problems. Consultation from the local fire/rescue department, appropriate medical professional, or local emergency room may be helpful to employers in these circumstances. By assessing the specific needs of their workplace, employers can ensure that reasonably anticipated supplies are available. Employers should assess the specific needs of their worksite periodically and augment the first aid kit appropriately.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:f1c04ba5f079f7711ae678b99ecc63bd84c3f2f2643baede2765fa37dd4dbe3e\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":1406,\"summary\":\"The employer can use the OSHA 300 log, OSHA 301 log, or other reports to identify unique first-aid problems.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

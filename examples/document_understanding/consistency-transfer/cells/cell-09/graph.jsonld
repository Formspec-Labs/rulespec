      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"kind\":\"requirement\",\"modality\":\"must\",\"scope_text\":\"Seats that do not qualify under paragraphs (a)(3)(iii)(B)(1) and (a)(3)(iii)(B)(2) of § 91.107.\",\"summary\":\"Child restraint seats that do not qualify under paragraphs (a)(3)(iii)(B)(1) and (a)(3)(iii)(B)(2) of 14 CFR § 91.107 must bear a label or markings showing that the seat was manufactured under the standards of the United Nations, that the seat or child restraint device furnished by the operator was approved by the FAA through Type Certificate or Supplemental Type Certificate, or that the seat or child restraint device furnished by the operator, or one of the persons described in paragraph (a)(3)(iii)(A), was approved by the FAA in accordance with § 21.8(d) of 14 CFR chapter I or Technical Standard Order C-100b or a later version.\"}",
        "@type": "xsd:string"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed",

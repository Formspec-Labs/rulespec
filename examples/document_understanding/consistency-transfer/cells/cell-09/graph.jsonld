    {
      "@id": "urn:rulespec:document-understanding:revision:aeff8d3f350dcd067d07abd8ad0054719680a9fd9ff0c861234c1b75b7f7b4f0",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:aeff8d3f350dcd067d07abd8ad0054719680a9fd9ff0c861234c1b75b7f7b4f0",

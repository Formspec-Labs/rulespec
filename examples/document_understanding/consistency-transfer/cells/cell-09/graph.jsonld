    {
      "@id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A8e2a86970dc06b1340952160d3f6524db8f2948b72a87253bc35cda27b0de7e1:3069:3735:sha256-09206d989938393ca054d7a1f5865668c008727aecfe151d819b98a89373b889",
      "@type": "rkaf:SourceFragment",
      "oa:hasSource": "urn:rulespec:document-understanding:document:8e2a86970dc06b1340952160d3f6524db8f2948b72a87253bc35cda27b0de7e1",
      "rkaf:fragmentIdentityScheme": "rkaf:carrier-local-fragment",
      "rkaf:sourceArtifactDigest": "sha256:8e2a86970dc06b1340952160d3f6524db8f2948b72a87253bc35cda27b0de7e1",
      "rkaf:fragmentContentDigest": "sha256:09206d989938393ca054d7a1f5865668c008727aecfe151d819b98a89373b889",
      "rkaf:selectorKind": [
        "oa:TextQuoteSelector",
        "oa:TextPositionSelector"
      ],
      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "( 3 ) Seats that do not qualify under paragraphs (a)(3)(iii)(B)( 1 ) and (a)(3)(iii)(B)( 2 ) of this section must bear a label or markings showing:\n\n( ii ) That the seat was manufactured under the standards of the United Nations;\n\n( iii ) That the seat or child restraint device furnished by the operator was approved by the FAA through Type Certificate or Supplemental Type Certificate; or\n\n( iv ) That the seat or child restraint device furnished by the operator, or one of the persons described in paragraph (a)(3)(iii)(A) of this section, was approved by the FAA in accordance with § 21.8(d) of this chapter or Technical Standard Order C-100b or a later version."
        },
        {
          "@type": "oa:TextPositionSelector",
          "oa:start": 3069,
          "oa:end": 3735,
          "rkaf:coordinateSystem": "rkaf:unicode-codepoint"
        }
      ]
    },

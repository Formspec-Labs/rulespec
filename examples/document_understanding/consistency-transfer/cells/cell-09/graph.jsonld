      "rkaf:hasContentDigest": "sha256:a8202541e59b82f3a26b1ba8a7de13b0d3e71c2acb7df81f9f3a5d901dd95da3",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:72b50f3d3ae3ac5ab5b1daed7f8c5311720d12b958ae32b7abeaba7c62ece800\",\"urn:rulespec:document-understanding:assertion:295d2f73c7e1ceb43cdb82b583e5f1b5a79844c9d69f71dd031e47676a535004\",\"urn:rulespec:document-understanding:assertion:9aa9918a0f41a05938835c094cc4381a2fcece87c83b2db824ab2fe0a056dc31\",\"urn:rulespec:document-understanding:assertion:1b5a8e8d8674e3cb0c99c8ad1739dd15161c2c21302c09ef2eb1321667da5400\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[\"(iii) Notwithstanding any other requirement of this chapter, occupy an approved child restraint system furnished by the operator or one of the persons described in paragraph (a)(3)(iii)(A) of this section provided that:\\n\\n(A) The child is accompanied by a parent, guardian, or attendant designated by the child's parent or guardian to attend to the safety of the child during the flight;\\n\\n(B) Except as provided in paragraph (a)(3)(iii)(B)( 4 ) of this action, the approved child restraint system bears one or more labels as follows:\"],\"defined_terms\":[],\"effective_periods\":[],\"end\":3735,\"evidence\":[{\"end\":3735,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A8e2a86970dc06b1340952160d3f6524db8f2948b72a87253bc35cda27b0de7e1:3069:3735:sha256-09206d989938393ca054d7a1f5865668c008727aecfe151d819b98a89373b889\",\"quote\":\"( 3 ) Seats that do not qualify under paragraphs (a)(3)(iii)(B)( 1 ) and (a)(3)(iii)(B)( 2 ) of this section must bear a label or markings showing:\\n\\n( ii ) That the seat was manufactured under the standards of the United Nations;\\n\\n( iii ) That the seat or child restraint device furnished by the operator was approved by the FAA through Type Certificate or Supplemental Type Certificate; or\\n\\n( iv ) That the seat or child restraint device furnished by the operator, or one of the persons described in paragraph (a)(3)(iii)(A) of this section, was approved by the FAA in accordance with § 21.8(d) of this chapter or Technical Standard Order C-100b or a later version.\",\"start\":3069},{\"end\":3182,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A8e2a86970dc06b1340952160d3f6524db8f2948b72a87253bc35cda27b0de7e1:3178:3182:sha256-4137b01e139589b7a1d3b3fc4da031d8ce5bb415808734e970c3a58ea0e98f0f\",\"quote\":\"must\",\"start\":3178},{\"end\":3216,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A8e2a86970dc06b1340952160d3f6524db8f2948b72a87253bc35cda27b0de7e1:3069:3216:sha256-73f0de5a821387662dd6ac05fa6f7fdf92942e61bc9f090c00bad00b189964e1\",\"quote\":\"( 3 ) Seats that do not qualify under paragraphs (a)(3)(iii)(B)( 1 ) and (a)(3)(iii)(B)( 2 ) of this section must bear a label or markings showing:\",\"start\":3069},{\"end\":2557,\"field\":\"context:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A8e2a86970dc06b1340952160d3f6524db8f2948b72a87253bc35cda27b0de7e1:2025:2557:sha256-c16188a128e664e084983aa9f794fd641452353cea45641dc6847eaba2788a4a\",\"quote\":\"(iii) Notwithstanding any other requirement of this chapter, occupy an approved child restraint system furnished by the operator or one of the persons described in paragraph (a)(3)(iii)(A) of this section provided that:\\n\\n(A) The child is accompanied by a parent, guardian, or attendant designated by the child's parent or guardian to attend to the safety of the child during the flight;\\n\\n(B) Except as provided in paragraph (a)(3)(iii)(B)( 4 ) of this action, the approved child restraint system bears one or more labels as follows:\",\"start\":2025}],\"id\":\"urn:rulespec:document-understanding:revision:46380a47815b46d903d44f4696937c0abec5fe4c6d99f0e2a62b5f3a7406fc36\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:1b5a8e8d8674e3cb0c99c8ad1739dd15161c2c21302c09ef2eb1321667da5400\",\"modality\":\"must\",\"modality_quote\":\"must\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:1d09ea64ff61af2acca797600b4912097fd21efa9a32643988a714d59a4ebd7a\",\"origin\":\"aiSuggested\",\"quote\":\"( 3 ) Seats that do not qualify under paragraphs (a)(3)(iii)(B)( 1 ) and (a)(3)(iii)(B)( 2 ) of this section must bear a label or markings showing:\\n\\n( ii ) That the seat was manufactured under the standards of the United Nations;\\n\\n( iii ) That the seat or child restraint device furnished by the operator was approved by the FAA through Type Certificate or Supplemental Type Certificate; or\\n\\n( iv ) That the seat or child restraint device furnished by the operator, or one of the persons described in paragraph (a)(3)(iii)(A) of this section, was approved by the FAA in accordance with § 21.8(d) of this chapter or Technical Standard Order C-100b or a later version.\",\"references\":[\"paragraphs (a)(3)(iii)(B)( 1 ) and (a)(3)(iii)(B)( 2 )\",\"paragraph (a)(3)(iii)(A)\",\"§ 21.8(d)\",\"Technical Standard Order C-100b\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:f978e5c708c2ee52cd8cccbcfd38bfbd3977947b5aecfe043ddef4a0053ba0e1\",\"scope_quotes\":[\"( 3 ) Seats that do not qualify under paragraphs (a)(3)(iii)(B)( 1 ) and (a)(3)(iii)(B)( 2 ) of this section must bear a label or markings showing:\"],\"scope_text\":\"Seats that do not qualify under paragraphs (a)(3)(iii)(B)(1) and (a)(3)(iii)(B)(2) of § 91.107.\",\"section_id\":\"section-1\",\"start\":3069,\"summary\":\"Child restraint seats that do not qualify under paragraphs (a)(3)(iii)(B)(1) and (a)(3)(iii)(B)(2) of 14 CFR § 91.107 must bear a label or markings showing that the seat was manufactured under the standards of the United Nations, that the seat or child restraint device furnished by the operator was approved by the FAA through Type Certificate or Supplemental Type Certificate, or that the seat or child restraint device furnished by the operator, or one of the persons described in paragraph (a)(3)(iii)(A), was approved by the FAA in accordance with § 21.8(d) of 14 CFR chapter I or Technical Standard Order C-100b or a later version.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

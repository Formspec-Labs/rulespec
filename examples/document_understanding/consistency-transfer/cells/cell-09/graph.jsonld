      "dcterms:description": "{\"action\":\"\",\"actor\":\"person\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:f02f4174092072760d9f733ebd6c70c2aba19112a7903067c17ea4ec2f5def04\",\"urn:rulespec:document-understanding:assertion:4c6beab8c0a1a06064a2325e43a283cc3d3d16c86fd30fdfa2171da4e7fc007c\",\"urn:rulespec:document-understanding:assertion:fcbc3e1ab846a2850fd6a0706dd469e50406f2e84bb05b765516e3e12f5d890a\",\"urn:rulespec:document-understanding:assertion:52b9a07514900b1c948b8d710770e0c3ac18acc6359a9152e0ee609d14ac6470\",\"urn:rulespec:document-understanding:assertion:acea2ca2f7abe7a5a6c40849dcbd442e340a53f22a238f8a1879a85bf1f463a5\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":2557,\"evidence\":[{\"end\":2557,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A8e2a86970dc06b1340952160d3f6524db8f2948b72a87253bc35cda27b0de7e1:2025:2557:sha256-c16188a128e664e084983aa9f794fd641452353cea45641dc6847eaba2788a4a\",\"quote\":\"(iii) Notwithstanding any other requirement of this chapter, occupy an approved child restraint system furnished by the operator or one of the persons described in paragraph (a)(3)(iii)(A) of this section provided that:\\n\\n(A) The child is accompanied by a parent, guardian, or attendant designated by the child's parent or guardian to attend to the safety of the child during the flight;\\n\\n(B) Except as provided in paragraph (a)(3)(iii)(B)( 4 ) of this action, the approved child restraint system bears one or more labels as follows:\",\"start\":2025},{\"end\":2174,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A8e2a86970dc06b1340952160d3f6524db8f2948b72a87253bc35cda27b0de7e1:2168:2174:sha256-38a81e87e79631e602bf5fbd307ce2fcd382b1670c585ea09032aac778a80531\",\"quote\":\"person\",\"start\":2168},{\"end\":2244,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A8e2a86970dc06b1340952160d3f6524db8f2948b72a87253bc35cda27b0de7e1:2025:2244:sha256-5b6bd3c59b86e966ef71c39adc7ddc52fad348193747212383fc2e25e4f901af\",\"quote\":\"(iii) Notwithstanding any other requirement of this chapter, occupy an approved child restraint system furnished by the operator or one of the persons described in paragraph (a)(3)(iii)(A) of this section provided that:\",\"start\":2025}],\"id\":\"urn:rulespec:document-understanding:revision:28c02cc793f989a75dad9db72362add9d6e6f44754ab58b52bfbb38c46f8f1dc\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"permission\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:acea2ca2f7abe7a5a6c40849dcbd442e340a53f22a238f8a1879a85bf1f463a5\",\"modality\":\"may\",\"modality_quote\":\"may\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:0be4fb30b5939b850d4c72f6d82832fbf92c566c29c7d9842dc31ffd514dc7c3\",\"origin\":\"aiSuggested\",\"quote\":\"(iii) Notwithstanding any other requirement of this chapter, occupy an approved child restraint system furnished by the operator or one of the persons described in paragraph (a)(3)(iii)(A) of this section provided that:\\n\\n(A) The child is accompanied by a parent, guardian, or attendant designated by the child's parent or guardian to attend to the safety of the child during the flight;\\n\\n(B) Except as provided in paragraph (a)(3)(iii)(B)( 4 ) of this action, the approved child restraint system bears one or more labels as follows:\",\"references\":[\"paragraph (a)(3)(iii)(A)\",\"paragraph (a)(3)(iii)(B)( 4 )\",\"paragraph (a)(3)(iii)(B)\",\"paragraph (a)(3)(iii)(C)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:c56600a7b49770b57d9cd5bf42477ed7a889f8194d234f867824b6b1753672d9\",\"scope_quotes\":[\"(iii) Notwithstanding any other requirement of this chapter, occupy an approved child restraint system furnished by the operator or one of the persons described in paragraph (a)(3)(iii)(A) of this section provided that:\"],\"scope_text\":\"Notwithstanding any other requirement of 14 CFR chapter I.\",\"section_id\":\"section-1\",\"start\":2025,\"summary\":\"Notwithstanding any other requirement of 14 CFR chapter I, a person may occupy an approved child restraint system furnished by the operator or by the child's parent, guardian, or attendant designated by the child's parent or guardian to attend to the safety of the child during the flight, provided that the child is accompanied by a parent, guardian, or attendant designated by the child's parent or guardian to attend to the safety of the child during the flight; except as provided in paragraph (a)(3)(iii)(B)(4), the child restraint system bears one or more required labels under paragraph (a)(3)(iii)(B); and the operator complies with the requirements in paragraph (a)(3)(iii)(C).\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

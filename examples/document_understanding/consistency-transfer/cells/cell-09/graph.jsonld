      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:7e5d38dd044a06c54726aa2707e5b4d66d2a2d554d7a5ffaa1ba8aa1c809ced1\",\"urn:rulespec:document-understanding:assertion:40a28924aa126326570fb852d4a9d68ff96f593c604a7e3e8ff65892b458f103\",\"urn:rulespec:document-understanding:assertion:6519225349dd03e2866e356c52166c6b2a0ae3a5657a954c99b7b60d55f25d39\",\"urn:rulespec:document-understanding:assertion:cb3b8676c79059a34490e073f68c758f5a44152a597f5858bfb7c300de8074cb\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[\"(iii) Notwithstanding any other requirement of this chapter, occupy an approved child restraint system furnished by the operator or one of the persons described in paragraph (a)(3)(iii)(A) of this section provided that:\\n\\n(A) The child is accompanied by a parent, guardian, or attendant designated by the child's parent or guardian to attend to the safety of the child during the flight;\\n\\n(B) Except as provided in paragraph (a)(3)(iii)(B)( 4 ) of this action, the approved child restraint system bears one or more labels as follows:\"],\"defined_terms\":[],\"effective_periods\":[],\"end\":3067,\"evidence\":[{\"end\":3067,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A8e2a86970dc06b1340952160d3f6524db8f2948b72a87253bc35cda27b0de7e1:2769:3067:sha256-867775f8fcede8c079f987f52952e4b19e88080bf70e2e432f2d93dd800ffbbc\",\"quote\":\"( 2 ) Seats manufactured to U.S. standards on or after February 26, 1985, must bear two labels:\\n\\n( i ) “This child restraint system conforms to all applicable Federal motor vehicle safety standards”; and\\n\\n( ii ) “THIS RESTRAINT IS CERTIFIED FOR USE IN MOTOR VEHICLES AND AIRCRAFT” in red lettering;\",\"start\":2769},{\"end\":2847,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A8e2a86970dc06b1340952160d3f6524db8f2948b72a87253bc35cda27b0de7e1:2843:2847:sha256-4137b01e139589b7a1d3b3fc4da031d8ce5bb415808734e970c3a58ea0e98f0f\",\"quote\":\"must\",\"start\":2843},{\"end\":2864,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A8e2a86970dc06b1340952160d3f6524db8f2948b72a87253bc35cda27b0de7e1:2769:2864:sha256-1c7ad589b9f69130642d4cace3a06d6e5a139f92a0f4c7a058becf1bc02f7860\",\"quote\":\"( 2 ) Seats manufactured to U.S. standards on or after February 26, 1985, must bear two labels:\",\"start\":2769},{\"end\":2557,\"field\":\"context:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A8e2a86970dc06b1340952160d3f6524db8f2948b72a87253bc35cda27b0de7e1:2025:2557:sha256-c16188a128e664e084983aa9f794fd641452353cea45641dc6847eaba2788a4a\",\"quote\":\"(iii) Notwithstanding any other requirement of this chapter, occupy an approved child restraint system furnished by the operator or one of the persons described in paragraph (a)(3)(iii)(A) of this section provided that:\\n\\n(A) The child is accompanied by a parent, guardian, or attendant designated by the child's parent or guardian to attend to the safety of the child during the flight;\\n\\n(B) Except as provided in paragraph (a)(3)(iii)(B)( 4 ) of this action, the approved child restraint system bears one or more labels as follows:\",\"start\":2025}],\"id\":\"urn:rulespec:document-understanding:revision:8a04bbf834abfb02aa769ba52452240554eedb6f952467b4dc10cf0c8e3f1204\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:cb3b8676c79059a34490e073f68c758f5a44152a597f5858bfb7c300de8074cb\",\"modality\":\"must\",\"modality_quote\":\"must\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:1363a5111134d6c706b31db9554abdcd772fea2bb4027d1d380a0585f53800ec\",\"origin\":\"aiSuggested\",\"quote\":\"( 2 ) Seats manufactured to U.S. standards on or after February 26, 1985, must bear two labels:\\n\\n( i ) “This child restraint system conforms to all applicable Federal motor vehicle safety standards”; and\\n\\n( ii ) “THIS RESTRAINT IS CERTIFIED FOR USE IN MOTOR VEHICLES AND AIRCRAFT” in red lettering;\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:6bf78363a11e7acf46db8216d4c19cb2555f16782c839cbdd55a836276888a80\",\"scope_quotes\":[\"( 2 ) Seats manufactured to U.S. standards on or after February 26, 1985, must bear two labels:\"],\"scope_text\":\"Seats manufactured to U.S. standards on or after February 26, 1985.\",\"section_id\":\"section-1\",\"start\":2769,\"summary\":\"Child restraint seats manufactured to U.S. standards on or after February 26, 1985, must bear two labels: (i) “This child restraint system conforms to all applicable Federal motor vehicle safety standards”; and (ii) “THIS RESTRAINT IS CERTIFIED FOR USE IN MOTOR VEHICLES AND AIRCRAFT” in red lettering.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

ent%3A8e2a86970dc06b1340952160d3f6524db8f2948b72a87253bc35cda27b0de7e1:898:1293:sha256-0fd307f652604be2fba07c43a5f5020cfc98af71c463c224329c7b389e9f113d\",\"quote\":\"(3) Except as provided in this paragraph, each person on board a U.S.-registered civil aircraft (except a free balloon that incorporates a basket or gondola or an airship type certificated before November 2, 1987) must occupy an approved seat or berth with a safety belt and, if installed, shoulder harness, properly secured about him or her during movement on the surface, takeoff, and landing.\",\"start\":898},{\"end\":1651,\"field\":\"scope_text:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A8e2a86970dc06b1340952160d3f6524db8f2948b72a87253bc35cda27b0de7e1:1576:1651:sha256-4c2bf278eb93b84b749934e09ccee403bf62ce8679c562c231c420022f0c0b0a\",\"quote\":\"Notwithstanding the preceding requirements of this paragraph, a person may:\",\"start\":1576},{\"end\":2023,\"field\":\"scope_text:2\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A8e2a86970dc06b1340952160d3f6524db8f2948b72a87253bc35cda27b0de7e1:1888:2023:sha256-27975c24d757f978a5cf73a3e4ada408c7b02428ed1fae596fc4af74fdab27ef\",\"quote\":\"(ii) Use the floor of the aircraft as a seat, provided that the person is on board for the purpose of engaging in sport parachuting; or\",\"start\":1888}],\"id\":\"urn:rulespec:document-understanding:revision:60a900e35955c66e1ecad83ac7eb555965ae6f4c3f87b19df36da9cf70c2b565\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"permission\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:8de06b55aed404e01f30204b53d36265f39423023d17aedeb707a93aed85b880\",\"modality\":\"may\",\"modality_quote\":\"may\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:88e7a8712cb4c2dfa4273c2dcd4e07ead9d3848d3a5551edd5136a3f43333bf8\",\"origin\":\"aiSuggested\",\"quote\":\"Notwithstanding the preceding requirements of this paragraph, a person may:\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:4ed551c3f3a55f7cb99782bee94002975387dea14592bf85e01022abe5a6780a\",\"scope_quotes\":[\"(3) Except as provided in this paragraph, each person on board a U.S.-registered civil aircraft (except a free balloon that incorporates a basket or gondola or an airship type certificated before November 2, 1987) must occupy an approved seat or berth with a safety belt and, if installed, shoulder harness, properly secured about him or her during movement on the surface, takeoff, and landing.\",\"Notwithstanding the preceding requirements of this paragraph, a person may:\",\"(ii) Use the floor of the aircraft as a seat, provided that the person is on board for the purpose of engaging in sport parachuting; or\"],\"scope_text\":\"A person on board a U.S.-registered civil aircraft during movement on the surface, takeoff, and landing, provided that the person is on board for the purpose of engaging in sport parachuting.\",\"section_id\":\"section-1\",\"start\":1576,\"summary\":\"Notwithstanding the seating and restraint requirements of 14 CFR § 91.107(a)(3), a person may use the floor of the aircraft as a seat, provided that the person is on board for the purpose of engaging in sport parachuting.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

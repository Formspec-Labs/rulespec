    {
      "@id": "urn:rulespec:document-understanding:scope:796b1795c3eb3c9430f58183db93771931b793cfb2f01cfba29c4afca7426c66",
      "@type": "rkaf:ApplicabilityScope",
      "rkaf:appliesInJurisdiction": [],
      "rkaf:applicabilityCondition": "A person on board a U.S.-registered civil aircraft during movement on the surface, takeoff, and landing, provided that the person being held has not reached his or her second birthday, does not occupy or use any restraining device, the adult is occupying an approved seat or berth, and not excluded by § 91.108(j)."
    },
    {
      "@id": "urn:rulespec:document-understanding:assertion:fc463d64c8fad086fca74f21b49a1d08595530e91271e2b3887de3db368914d7",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:e4a497a8c8feb381ca08e4f026a71f1f5c16b3b507078b9352789f104e29d8e2",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:5c93ddd1e053aa5cf01bc0520b99bc6aa522b7a3fb377d6be81b549561cc88fc",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:1923e849332045a7839a85fcd5eaab61876684828dd6f3e5992b5a35273b667f",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:states-permission",
      "rkaf:assertsValue": {
        "@value": "Notwithstanding the seating and restraint requirements of 14 CFR § 91.107(a)(3), a person may be held by an adult who is occupying an approved seat or berth, except as outlined in § 91.108(j), provided that the person being held has not reached his or her second birthday and does not occupy or use any restraining device.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"

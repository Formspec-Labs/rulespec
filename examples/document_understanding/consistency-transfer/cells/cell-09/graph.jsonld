      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"The operator\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:37160d28d5f7a5c9ba0720992ff2991de799e3679c574e2f6f0ebf645db7669a\",\"urn:rulespec:document-understanding:assertion:02e5bc27e2c06944d6eaef6ca0a63669ed95f4bebf1673890056df49e8d03caa\",\"urn:rulespec:document-understanding:assertion:417d7cf4a80fb2a90f1a05a196e94915d37b90f834d4a842d9ff60be7cb2a98b\",\"urn:rulespec:document-understanding:assertion:e136aef13e02f99b2b6cd9db03d9e85a1d1a4c9ffe9f739b5e42991815b2b99e\",\"urn:rulespec:document-understanding:assertion:a4b88dea34caeb041454b68572bd744b8c780109e1d4db7afdce40d0ce837b1d\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":4658,\"evidence\":[{\"end\":4658,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A8e2a86970dc06b1340952160d3f6524db8f2948b72a87253bc35cda27b0de7e1:4359:4658:sha256-8a8d704bebadc8b0c0f25faf1cc36bd05cd40f95499d0c4d3882de04ae1d7eef\",\"quote\":\"(C) The operator complies with the following requirements:\\n\\n( 1 ) The restraint system must be properly secured to an approved forward-facing seat or berth;\\n\\n( 2 ) The child must be properly secured in the restraint system and must not exceed the specified weight limit for the restraint system; and\",\"start\":4359},{\"end\":4375,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A8e2a86970dc06b1340952160d3f6524db8f2948b72a87253bc35cda27b0de7e1:4363:4375:sha256-d1356ab3b11e9299d79c310617bca5bf74874c8377cf98040d7611edd1cb7b7e\",\"quote\":\"The operator\",\"start\":4363},{\"end\":2244,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A8e2a86970dc06b1340952160d3f6524db8f2948b72a87253bc35cda27b0de7e1:2025:2244:sha256-5b6bd3c59b86e966ef71c39adc7ddc52fad348193747212383fc2e25e4f901af\",\"quote\":\"(iii) Notwithstanding any other requirement of this chapter, occupy an approved child restraint system furnished by the operator or one of the persons described in paragraph (a)(3)(iii)(A) of this section provided that:\",\"start\":2025},{\"end\":4417,\"field\":\"scope_text:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A8e2a86970dc06b1340952160d3f6524db8f2948b72a87253bc35cda27b0de7e1:4359:4417:sha256-bdcb13309c46e6eede8e62b6cc8c9b20b1673810cf0c6ba153da01bb11c96732\",\"quote\":\"(C) The operator complies with the following requirements:\",\"start\":4359}],\"id\":\"urn:rulespec:document-understanding:revision:c7d1aff3962a55e262929db3e57be70e543228c158ca177e22b6258f6f46488d\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:a4b88dea34caeb041454b68572bd744b8c780109e1d4db7afdce40d0ce837b1d\",\"modality\":\"must\",\"modality_quote\":\"must\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:7c0fa4ba314098ae5e530bcac15534bc79a280a65175af0b0d64e039cc516339\",\"origin\":\"aiSuggested\",\"quote\":\"(C) The operator complies with the following requirements:\\n\\n( 1 ) The restraint system must be properly secured to an approved forward-facing seat or berth;\\n\\n( 2 ) The child must be properly secured in the restraint system and must not exceed the specified weight limit for the restraint system; and\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:e26ae1e0145ca3e69203353ae74d2a9cab5065dbecf8a59b119b933f6a883a17\",\"scope_quotes\":[\"(iii) Notwithstanding any other requirement of this chapter, occupy an approved child restraint system furnished by the operator or one of the persons described in paragraph (a)(3)(iii)(A) of this section provided that:\",\"(C) The operator complies with the following requirements:\"],\"scope_text\":\"When a child restraint system is occupied under paragraph (a)(3)(iii).\",\"section_id\":\"section-1\",\"start\":4359,\"summary\":\"When a child restraint system is used under 14 CFR § 91.107(a)(3)(iii), the operator must ensure that the child is properly secured in the restraint system and does not exceed the specified weight limit for the restraint system.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"pilot\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:4fcdd8c306a7e5c98f2124ce835c5ac71c18d709c82c09f7d6f1d7e6dadc89da\",\"urn:rulespec:document-understanding:assertion:12e28c5e997fe61ff7e410716b792bfe6b294b9291cdbc98753b7fa3512c652e\",\"urn:rulespec:document-understanding:assertion:94a37770e94da1d98b301607d077b5b95fc9484bc833d885ad591ef471c95569\",\"urn:rulespec:document-understanding:assertion:e4e811e0734b09ecb55350b6f7f3c0fb2be6f3a71d2716a9450b76ab5336b32c\",\"urn:rulespec:document-understanding:assertion:45a08bea9959bd3827bfa68d7680517c79dccdfcb9c655681003a68c36b7f53c\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":896,\"evidence\":[{\"end\":896,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A8e2a86970dc06b1340952160d3f6524db8f2948b72a87253bc35cda27b0de7e1:498:896:sha256-d41bff01d78767fcbc2f1bc7389c8039607a591137976abf6c3ab6708142860b\",\"quote\":\"(2) No pilot may cause to be moved on the surface, take off, or land a U.S.-registered civil aircraft (except a free balloon that incorporates a basket or gondola, or an airship type certificated before November 2, 1987) unless the pilot in command of that aircraft ensures that each person on board has been notified to fasten his or her safety belt and, if installed, his or her shoulder harness.\",\"start\":498},{\"end\":514,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A8e2a86970dc06b1340952160d3f6524db8f2948b72a87253bc35cda27b0de7e1:502:514:sha256-8e9ed702f4dba767dee44fa4b604054c84ea29f79d2cd28140e219ea854ddbc2\",\"quote\":\"No pilot may\",\"start\":502},{\"end\":134,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A8e2a86970dc06b1340952160d3f6524db8f2948b72a87253bc35cda27b0de7e1:81:134:sha256-61d97cbad29e0c59f88fb6852b7d518ee1310086188a05701321e8946463b41c\",\"quote\":\"(a) Unless otherwise authorized by the Administrator—\",\"start\":81},{\"end\":4849,\"field\":\"scope_text:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A8e2a86970dc06b1340952160d3f6524db8f2948b72a87253bc35cda27b0de7e1:4724:4849:sha256-1cf38dd1e4bc84442613f0f5ef61958ebc6b0ee771ffe41a0f54882eba6d3666\",\"quote\":\"(b) Unless otherwise stated, this section does not apply to operations conducted under part 121, 125, or 135 of this chapter.\",\"start\":4724}],\"id\":\"urn:rulespec:document-understanding:revision:67a3384b2accce4c373d16f340c4d6eea63751bc49015a040f2e7f8f8b5d536c\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"prohibition\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:45a08bea9959bd3827bfa68d7680517c79dccdfcb9c655681003a68c36b7f53c\",\"modality\":\"must_not\",\"modality_quote\":\"No pilot may\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:826cef1fb081310861c9a87c9900e378b5fe40052476e54a330b63916c70b190\",\"origin\":\"aiSuggested\",\"quote\":\"(2) No pilot may cause to be moved on the surface, take off, or land a U.S.-registered civil aircraft (except a free balloon that incorporates a basket or gondola, or an airship type certificated before November 2, 1987) unless the pilot in command of that aircraft ensures that each person on board has been notified to fasten his or her safety belt and, if installed, his or her shoulder harness.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:6a319b61b8e756debc6843a13ef92ffdf3c32dec689840f6e9fa2e6624dfc651\",\"scope_quotes\":[\"(a) Unless otherwise authorized by the Administrator—\",\"(b) Unless otherwise stated, this section does not apply to operations conducted under part 121, 125, or 135 of this chapter.\"],\"scope_text\":\"Unless otherwise authorized by the Administrator, and except for operations conducted under part 121, 125, or 135 unless otherwise stated.\",\"section_id\":\"section-1\",\"start\":498,\"summary\":\"Unless otherwise authorized by the Administrator, no pilot may cause to be moved on the surface, take off, or land a U.S.-registered civil aircraft (except a free balloon that incorporates a basket or gondola, or an airship type certificated before November 2, 1987) unless the pilot in command of that aircraft ensures that each person on board has been notified to fasten his or her safety belt and, if installed, his or her shoulder harness.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

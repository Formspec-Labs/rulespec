      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"actor\":\"person\",\"kind\":\"permission\",\"modality\":\"may\",\"scope_text\":\"Notwithstanding any other requirement of 14 CFR chapter I.\",\"summary\":\"Notwithstanding any other requirement of 14 CFR chapter I, a person may occupy an approved child restraint system furnished by the operator or by the child's parent, guardian, or attendant designated by the child's parent or guardian to attend to the safety of the child during the flight, provided that the child is accompanied by a parent, guardian, or attendant designated by the child's parent or guardian to attend to the safety of the child during the flight; except as provided in paragraph (a)(3)(iii)(B)(4), the child restraint system bears one or more required labels under paragraph (a)(3)(iii)(B); and the operator complies with the requirements in paragraph (a)(3)(iii)(C).\"}",
        "@type": "xsd:string"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed",
      "rkaf:hasApplicability": "urn:rulespec:document-understanding:scope:8ba6feaa6abfec44ebd48254f2eae3bd21e81c02c27937b6a440a9c50d6ba78e"

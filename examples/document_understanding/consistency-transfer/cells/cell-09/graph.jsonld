      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:states-prohibition",
      "rkaf:assertsValue": {
        "@value": "Unless otherwise authorized by the Administrator, no pilot may take off a U.S.-registered civil aircraft (except a free balloon that incorporates a basket or gondola, or an airship type certificated before November 2, 1987) unless the pilot in command of that aircraft ensures that each person on board is briefed on how to fasten and unfasten that person's safety belt and, if installed, shoulder harness.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

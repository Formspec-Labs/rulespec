      "rkaf:hasContentDigest": "sha256:ade12b15d1d639a26d9897db771e2a0276c5c084e8e5a29708d9fa5209796d83",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"The operator\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:0b5ce63a21b7fb49555e056aed45cdfe187907103800f2400835573d529b90a5\",\"urn:rulespec:document-understanding:assertion:6f4070fd21f3c4569cf93a29430e778a28bd69298fe503eb64b902546a16bd67\",\"urn:rulespec:document-understanding:assertion:5ef40e0ec203e7ce63ffa0b5c88585024c26a17992b3f3e2107912ffdfb79aed\",\"urn:rulespec:document-understanding:assertion:dac66165ed512b9c751d43827a22601426ad7dd55e85f3b61c03701729d2d89b\",\"urn:rulespec:document-understanding:assertion:c1017e7b9ecec3fb7dbf4f873ec07198b04c9c7b444af8571d707a14e64dc03a\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":4722,\"evidence\":[{\"end\":4722,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A8e2a86970dc06b1340952160d3f6524db8f2948b72a87253bc35cda27b0de7e1:4359:4722:sha256-8e3fd561617ae254eaa45988895d5c3c9b4d4d575708e3593f1a5b78da982049\",\"quote\":\"(C) The operator complies with the following requirements:\\n\\n( 1 ) The restraint system must be properly secured to an approved forward-facing seat or berth;\\n\\n( 2 ) The child must be properly secured in the restraint system and must not exceed the specified weight limit for the restraint system; and\\n\\n( 3 ) The restraint system must bear the appropriate label(s).\",\"start\":4359},{\"end\":4375,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A8e2a86970dc06b1340952160d3f6524db8f2948b72a87253bc35cda27b0de7e1:4363:4375:sha256-d1356ab3b11e9299d79c310617bca5bf74874c8377cf98040d7611edd1cb7b7e\",\"quote\":\"The operator\",\"start\":4363},{\"end\":2244,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A8e2a86970dc06b1340952160d3f6524db8f2948b72a87253bc35cda27b0de7e1:2025:2244:sha256-5b6bd3c59b86e966ef71c39adc7ddc52fad348193747212383fc2e25e4f901af\",\"quote\":\"(iii) Notwithstanding any other requirement of this chapter, occupy an approved child restraint system furnished by the operator or one of the persons described in paragraph (a)(3)(iii)(A) of this section provided that:\",\"start\":2025},{\"end\":4417,\"field\":\"scope_text:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A8e2a86970dc06b1340952160d3f6524db8f2948b72a87253bc35cda27b0de7e1:4359:4417:sha256-bdcb13309c46e6eede8e62b6cc8c9b20b1673810cf0c6ba153da01bb11c96732\",\"quote\":\"(C) The operator complies with the following requirements:\",\"start\":4359}],\"id\":\"urn:rulespec:document-understanding:revision:aeff8d3f350dcd067d07abd8ad0054719680a9fd9ff0c861234c1b75b7f7b4f0\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:c1017e7b9ecec3fb7dbf4f873ec07198b04c9c7b444af8571d707a14e64dc03a\",\"modality\":\"must\",\"modality_quote\":\"must\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:7ea89e529a4fa60ad7e19251b05ebef72777c327af59cba70d8259141b9dd992\",\"origin\":\"aiSuggested\",\"quote\":\"(C) The operator complies with the following requirements:\\n\\n( 1 ) The restraint system must be properly secured to an approved forward-facing seat or berth;\\n\\n( 2 ) The child must be properly secured in the restraint system and must not exceed the specified weight limit for the restraint system; and\\n\\n( 3 ) The restraint system must bear the appropriate label(s).\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:754b21f6f1948f7e6b92db227e86a505b0025e158fadadf80b0f14f460d71b40\",\"scope_quotes\":[\"(iii) Notwithstanding any other requirement of this chapter, occupy an approved child restraint system furnished by the operator or one of the persons described in paragraph (a)(3)(iii)(A) of this section provided that:\",\"(C) The operator complies with the following requirements:\"],\"scope_text\":\"When a child restraint system is occupied under paragraph (a)(3)(iii).\",\"section_id\":\"section-1\",\"start\":4359,\"summary\":\"When a child restraint system is used under 14 CFR § 91.107(a)(3)(iii), the operator must ensure that the restraint system bears the appropriate label(s).\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

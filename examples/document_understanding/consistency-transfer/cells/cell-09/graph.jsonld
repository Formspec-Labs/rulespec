    {
      "@id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A8e2a86970dc06b1340952160d3f6524db8f2948b72a87253bc35cda27b0de7e1:4359:4722:sha256-8e3fd561617ae254eaa45988895d5c3c9b4d4d575708e3593f1a5b78da982049",

      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:e4a497a8c8feb381ca08e4f026a71f1f5c16b3b507078b9352789f104e29d8e2",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:5c93ddd1e053aa5cf01bc0520b99bc6aa522b7a3fb377d6be81b549561cc88fc",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:c56600a7b49770b57d9cd5bf42477ed7a889f8194d234f867824b6b1753672d9",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:states-permission",
      "rkaf:assertsValue": {
        "@value": "Notwithstanding any other requirement of 14 CFR chapter I, a person may occupy an approved child restraint system furnished by the operator or by the child's parent, guardian, or attendant designated by the child's parent or guardian to attend to the safety of the child during the flight, provided that the child is accompanied by a parent, guardian, or attendant designated by the child's parent or guardian to attend to the safety of the child during the flight; except as provided in paragraph (a)(3)(iii)(B)(4), the child restraint system bears one or more required labels under paragraph (a)(3)(iii)(B); and the operator complies with the requirements in paragraph (a)(3)(iii)(C).",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

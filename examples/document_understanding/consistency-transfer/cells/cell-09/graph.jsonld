      "rkaf:fragmentContentDigest": "sha256:8e3fd561617ae254eaa45988895d5c3c9b4d4d575708e3593f1a5b78da982049",
      "rkaf:selectorKind": [
        "oa:TextQuoteSelector",
        "oa:TextPositionSelector"
      ],
      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "(C) The operator complies with the following requirements:\n\n( 1 ) The restraint system must be properly secured to an approved forward-facing seat or berth;\n\n( 2 ) The child must be properly secured in the restraint system and must not exceed the specified weight limit for the restraint system; and\n\n( 3 ) The restraint system must bear the appropriate label(s)."
        },
        {
          "@type": "oa:TextPositionSelector",

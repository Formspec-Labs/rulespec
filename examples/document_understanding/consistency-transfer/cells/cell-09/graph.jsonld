      "dcterms:description": "{\"action\":\"\",\"actor\":\"pilot\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:c6ca9adbe5e2cc709f50b83209f8d49a71bb2bb884f0570c8b6844e774abcc86\",\"urn:rulespec:document-understanding:assertion:f78bbc70aab4a5097adf9ee26353edebabef4d99d55b968bdbea5760d434026b\",\"urn:rulespec:document-understanding:assertion:82177070d342a76270f1ac4ade48a05b1a787418f43a2fde152ee405bb0d902f\",\"urn:rulespec:document-understanding:assertion:dfade9012ccf9a6693604c75303f2d046cb91a350861df8f1f7cb70de788be24\",\"urn:rulespec:document-understanding:assertion:04c48f7648c4f25b5ab9d77da8d86f134f5ea9cf5f863db662f7785b53f7bf52\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":496,\"evidence\":[{\"end\":496,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A8e2a86970dc06b1340952160d3f6524db8f2948b72a87253bc35cda27b0de7e1:136:496:sha256-4e5ec982b83542e5269be59ef063fecfea007193061ffcf144577f5e7c6c77d7\",\"quote\":\"(1) No pilot may take off a U.S.-registered civil aircraft (except a free balloon that incorporates a basket or gondola, or an airship type certificated before November 2, 1987) unless the pilot in command of that aircraft ensures that each person on board is briefed on how to fasten and unfasten that person's safety belt and, if installed, shoulder harness.\",\"start\":136},{\"end\":152,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A8e2a86970dc06b1340952160d3f6524db8f2948b72a87253bc35cda27b0de7e1:140:152:sha256-8e9ed702f4dba767dee44fa4b604054c84ea29f79d2cd28140e219ea854ddbc2\",\"quote\":\"No pilot may\",\"start\":140},{\"end\":134,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A8e2a86970dc06b1340952160d3f6524db8f2948b72a87253bc35cda27b0de7e1:81:134:sha256-61d97cbad29e0c59f88fb6852b7d518ee1310086188a05701321e8946463b41c\",\"quote\":\"(a) Unless otherwise authorized by the Administrator—\",\"start\":81},{\"end\":4849,\"field\":\"scope_text:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A8e2a86970dc06b1340952160d3f6524db8f2948b72a87253bc35cda27b0de7e1:4724:4849:sha256-1cf38dd1e4bc84442613f0f5ef61958ebc6b0ee771ffe41a0f54882eba6d3666\",\"quote\":\"(b) Unless otherwise stated, this section does not apply to operations conducted under part 121, 125, or 135 of this chapter.\",\"start\":4724}],\"id\":\"urn:rulespec:document-understanding:revision:d1c34323a5655cb035c61842e5fdd412b01446efbc553108ea65a0444dbe86c9\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"prohibition\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:04c48f7648c4f25b5ab9d77da8d86f134f5ea9cf5f863db662f7785b53f7bf52\",\"modality\":\"must_not\",\"modality_quote\":\"No pilot may\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:b4e325840d1578447fa569cc04c7536a5c01f2aebc498c5dbbecce6e0c54b7c8\",\"origin\":\"aiSuggested\",\"quote\":\"(1) No pilot may take off a U.S.-registered civil aircraft (except a free balloon that incorporates a basket or gondola, or an airship type certificated before November 2, 1987) unless the pilot in command of that aircraft ensures that each person on board is briefed on how to fasten and unfasten that person's safety belt and, if installed, shoulder harness.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:c054b5ee5028980b0cec9c40a419b75a49c9c4b1c6d5b53e69480183d7115009\",\"scope_quotes\":[\"(a) Unless otherwise authorized by the Administrator—\",\"(b) Unless otherwise stated, this section does not apply to operations conducted under part 121, 125, or 135 of this chapter.\"],\"scope_text\":\"Unless otherwise authorized by the Administrator, and except for operations conducted under part 121, 125, or 135 unless otherwise stated.\",\"section_id\":\"section-1\",\"start\":136,\"summary\":\"Unless otherwise authorized by the Administrator, no pilot may take off a U.S.-registered civil aircraft (except a free balloon that incorporates a basket or gondola, or an airship type certificated before November 2, 1987) unless the pilot in command of that aircraft ensures that each person on board is briefed on how to fasten and unfasten that person's safety belt and, if installed, shoulder harness.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

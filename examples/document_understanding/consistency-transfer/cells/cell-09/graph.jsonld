    {
      "@id": "urn:rulespec:document-understanding:revision:c0bc435800d08e95e90020161c2548037e0c87bbaabaa48f0b4a100d625066e6",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:c0bc435800d08e95e90020161c2548037e0c87bbaabaa48f0b4a100d625066e6",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:abb4b52b02c45234b6c9d3fde2f28da0bcb3934a98bf4c879e5fb4181006d5c1",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"person\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:fc463d64c8fad086fca74f21b49a1d08595530e91271e2b3887de3db368914d7\",\"urn:rulespec:document-understanding:assertion:5e0cd7cbf3d82b87d8353bdbcb78b9923a44b8bf64bbcdc1f9584338c3bb6576\",\"urn:rulespec:document-understanding:assertion:086e111333039050b0fb8661388b536d186a864ecb309eb87d5317f89d4375df\",\"urn:rulespec:document-understanding:assertion:c5f8fdff8a7f99f1af4e53c39e613e7b0a0b175882b1134c6ba7d8a8076438a9\",\"urn:rulespec:document-understanding:assertion:328651043bda7723288efa3c1a53262479121fd8f3d3a22c7d116f78384b92f7\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":1886,\"evidence\":[{\"end\":1886,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A8e2a86970dc06b1340952160d3f6524db8f2948b72a87253bc35cda27b0de7e1:1576:1886:sha256-37be304b44121cb2c84d43132d7112cfc16851583075b4b85e63d6322ce0ea0a\",\"quote\":\"Notwithstanding the preceding requirements of this paragraph, a person may:\\n\\n(i) Be held by an adult, except as outlined in § 91.108(j), who is occupying an approved seat or berth, provided that the person being held has not reached his or her second birthday and does not occupy or use any restraining device;\",\"start\":1576},{\"end\":1650,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A8e2a86970dc06b1340952160d3f6524db8f2948b72a87253bc35cda27b0de7e1:1647:1650:sha256-ee4d988c65de860fabbfbcd27f73d50bbebe3fba37fe419284f4811389c30bdc\",\"quote\":\"may\",\"start\":1647},{\"end\":1293,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A8e2a86970dc06b1340952160d3f6524db8f2948b72a87253bc35cda27b0de7e1:898:1293:sha256-0fd307f652604be2fba07c43a5f5020cfc98af71c463c224329c7b389e9f113d\",\"quote\":\"(3) Except as provided in this paragraph, each person on board a U.S.-registered civil aircraft (except a free balloon that incorporates a basket or gondola or an airship type certificated before November 2, 1987) must occupy an approved seat or berth with a safety belt and, if installed, shoulder harness, properly secured about him or her during movement on the surface, takeoff, and landing.\",\"start\":898},{\"end\":1651,\"field\":\"scope_text:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A8e2a86970dc06b1340952160d3f6524db8f2948b72a87253bc35cda27b0de7e1:1576:1651:sha256-4c2bf278eb93b84b749934e09ccee403bf62ce8679c562c231c420022f0c0b0a\",\"quote\":\"Notwithstanding the preceding requirements of this paragraph, a person may:\",\"start\":1576},{\"end\":1886,\"field\":\"scope_text:2\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A8e2a86970dc06b1340952160d3f6524db8f2948b72a87253bc35cda27b0de7e1:1653:1886:sha256-85b5211fa88cb4ce8b82cdf0def65903abf9136860d40e431e24c496911214f3\",\"quote\":\"(i) Be held by an adult, except as outlined in § 91.108(j), who is occupying an approved seat or berth, provided that the person being held has not reached his or her second birthday and does not occupy or use any restraining device;\",\"start\":1653}],\"id\":\"urn:rulespec:document-understanding:revision:c0bc435800d08e95e90020161c2548037e0c87bbaabaa48f0b4a100d625066e6\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"permission\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:328651043bda7723288efa3c1a53262479121fd8f3d3a22c7d116f78384b92f7\",\"modality\":\"may\",\"modality_quote\":\"may\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:16bcec52b0ca7cdfa5de20c5202a6246e832ee894b94f5c085581c9fdcbb3a49\",\"origin\":\"aiSuggested\",\"quote\":\"Notwithstanding the preceding requirements of this paragraph, a person may:\\n\\n(i) Be held by an adult, except as outlined in § 91.108(j), who is occupying an approved seat or berth, provided that the person being held has not reached his or her second birthday and does not occupy or use any restraining device;\",\"references\":[\"§ 91.108(j)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:1923e849332045a7839a85fcd5eaab61876684828dd6f3e5992b5a35273b667f\",\"scope_quotes\":[\"(3) Except as provided in this paragraph, each person on board a U.S.-registered civil aircraft (except a free balloon that incorporates a basket or gondola or an airship type certificated before November 2, 1987) must occupy an approved seat or berth with a safety belt and, if installed, shoulder harness, properly secured about him or her during movement on the surface, takeoff, and landing.\",\"Notwithstanding the preceding requirements of this paragraph, a person may:\",\"(i) Be held by an adult, except as outlined in § 91.108(j), who is occupying an approved seat or berth, provided that the person being held has not reached his or her second birthday and does not occupy or use any restraining device;\"],\"scope_text\":\"A person on board a U.S.-registered civil aircraft during movement on the surface, takeoff, and landing, provided that the person being held has not reached his or her second birthday, does not occupy or use any restraining device, the adult is occupying an approved seat or berth, and not excluded by § 91.108(j).\",\"section_id\":\"section-1\",\"start\":1576,\"summary\":\"Notwithstanding the seating and restraint requirements of 14 CFR § 91.107(a)(3), a person may be held by an adult who is occupying an approved seat or berth, except as outlined in § 91.108(j), provided that the person being held has not reached his or her second birthday and does not occupy or use any restraining device.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

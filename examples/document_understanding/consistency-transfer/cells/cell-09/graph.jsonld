      "rkaf:assertsValue": {
        "@value": "{\"actor\":\"person\",\"kind\":\"permission\",\"modality\":\"may\",\"scope_text\":\"A person on board a U.S.-registered civil aircraft during movement on the surface, takeoff, and landing, provided that the person being held has not reached his or her second birthday, does not occupy or use any restraining device, the adult is occupying an approved seat or berth, and not excluded by § 91.108(j).\",\"summary\":\"Notwithstanding the seating and restraint requirements of 14 CFR § 91.107(a)(3), a person may be held by an adult who is occupying an approved seat or berth, except as outlined in § 91.108(j), provided that the person being held has not reached his or her second birthday and does not occupy or use any restraining device.\"}",
        "@type": "xsd:string"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed",

      "rkaf:assertsValue": {
        "@value": "{\"actor\":\"You\",\"kind\":\"requirement\",\"modality\":\"must\",\"summary\":\"You must consider an injury or illness to meet the general recording criteria, and therefore to be recordable, if it results in any of the following: death, days away from work, restricted work or transfer to another job, medical treatment beyond first aid, or loss of consciousness.\"}",

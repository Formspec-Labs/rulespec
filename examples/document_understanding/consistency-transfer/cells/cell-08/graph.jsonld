    },
    {
      "@id": "urn:rulespec:document-understanding:revision:fe0f6823addc6b07e33856d827981f6ef5db453b0f2f3f0b40efc8d898250f6a",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:fe0f6823addc6b07e33856d827981f6ef5db453b0f2f3f0b40efc8d898250f6a",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:6c52a5a3fc404d995c51d69fc45ba3df1ab9d78f51ba09fb05c7879dc009f591",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:2f2bbc64aaf9814baaa30788faae2f5d3b8146035a82ed6846d8c1e0a1d68c7e\",\"urn:rulespec:document-understanding:assertion:bf0b8aa6b22d87de1f27a7b228e2fefa0e1a9a08d9505a6f33672760737a05d8\",\"urn:rulespec:document-understanding:assertion:ef01fb45a5691e855dff33104d5d16b0446671a41f72a6d45bc0034b3164ad13\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":4155,\"evidence\":[{\"end\":4155,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:3651:4155:sha256-9963db504b6feb1ffa0ebd48a5afbe5b0f2ca07098ad8deca3b8e5d16df149e2\",\"quote\":\"(iv) How do I count weekends, holidays, or other days the employee would not have worked anyway? You must count the number of calendar days the employee was unable to work as a result of the injury or illness, regardless of whether or not the employee was scheduled to work on those day(s). Weekend days, holidays, vacation days or other days off are included in the total number of days recorded if the employee would not have been able to work on those days because of a work-related injury or illness.\",\"start\":3651}],\"id\":\"urn:rulespec:document-understanding:revision:fe0f6823addc6b07e33856d827981f6ef5db453b0f2f3f0b40efc8d898250f6a\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"statement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:ef01fb45a5691e855dff33104d5d16b0446671a41f72a6d45bc0034b3164ad13\",\"modality\":\"not_stated\",\"modality_quote\":\"\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:141dafc5b1d075bf720414918ded56506eb0ed2269d10ff35e96c5a2d6f931fe\",\"origin\":\"aiSuggested\",\"quote\":\"(iv) How do I count weekends, holidays, or other days the employee would not have worked anyway? You must count the number of calendar days the employee was unable to work as a result of the injury or illness, regardless of whether or not the employee was scheduled to work on those day(s). Weekend days, holidays, vacation days or other days off are included in the total number of days recorded if the employee would not have been able to work on those days because of a work-related injury or illness.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:a0e930aaf629185fe86cdacbd68c81d782cc910b8bcd6d9e4b53d4c0e23bb183\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":3651,\"summary\":\"Weekend days, holidays, vacation days or other days off are included in the total number of days recorded if the employee would not have been able to work on those days because of a work-related injury or illness.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",
      "dcterms:references": [
        {
          "@id": "urn:rulespec:document-understanding:assertion:2f2bbc64aaf9814baaa30788faae2f5d3b8146035a82ed6846d8c1e0a1d68c7e"
        },
        {
          "@id": "urn:rulespec:document-understanding:assertion:bf0b8aa6b22d87de1f27a7b228e2fefa0e1a9a08d9505a6f33672760737a05d8"
        },

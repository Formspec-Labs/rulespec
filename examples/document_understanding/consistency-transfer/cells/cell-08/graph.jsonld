    {
      "@id": "urn:rulespec:document-understanding:revision:c94ea924a4df193065c7de7d2d4f3dd1d2c00b0d86b713bc7601a20705349b02",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:c94ea924a4df193065c7de7d2d4f3dd1d2c00b0d86b713bc7601a20705349b02",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:a6fef2215f5d381cb162511f473f3aba4c119a94d61b2e6f204401e52b96d866",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"you\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:a205cacd98e1491afd44b55ec97b303a6b7fd3aad02e3a29eb766853754d14e9\",\"urn:rulespec:document-understanding:assertion:603c71374faffbaff1b95a9f7de8345b5115890acd26ef3f4ae0d257709e49f0\",\"urn:rulespec:document-understanding:assertion:9eb102f1aff0bb7db9f673fb9548f7687c307110533554f9cf8659d964254b9d\",\"urn:rulespec:document-understanding:assertion:68fc89ca521d7f2d325ab7416f2ea06f5b22e9c3cd25e2d5e1f5c226d4cbe2cd\",\"urn:rulespec:document-understanding:assertion:db351ac824c9b354a8d8bf96be4c4ae40c8d8244e382680d9ca109d422985977\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":11027,\"evidence\":[{\"end\":11027,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:10092:11027:sha256-15cb9ba69bb8a7fa51d03cef433e216c9fea8a9dc2afc740cbbc368f695938bc\",\"quote\":\"(vii) How do I handle vague restrictions from a physician or other licensed health care professional, such as that the employee engage only in “light duty” or “take it easy for a week”? If you are not clear about the physician or other licensed health care professional's recommendation, you may ask that person whether the employee can do all of his or her routine job functions and work all of his or her normally assigned work shift. If the answer to both of these questions is “Yes,” then the case does not involve a work restriction and does not have to be recorded as such. If the answer to one or both of these questions is “No,” the case involves restricted work and must be recorded as a restricted work case. If you are unable to obtain this additional information from the physician or other licensed health care professional who recommended the restriction, record the injury or illness as a case involving restricted work.\",\"start\":10092}],\"id\":\"urn:rulespec:document-understanding:revision:c94ea924a4df193065c7de7d2d4f3dd1d2c00b0d86b713bc7601a20705349b02\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"permission\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:68fc89ca521d7f2d325ab7416f2ea06f5b22e9c3cd25e2d5e1f5c226d4cbe2cd\",\"modality\":\"may\",\"modality_quote\":\"\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:f833966750151a3f97a51498bf1e8d06dbff4c2a603303cddfae8b0ccf572922\",\"origin\":\"aiSuggested\",\"quote\":\"(vii) How do I handle vague restrictions from a physician or other licensed health care professional, such as that the employee engage only in “light duty” or “take it easy for a week”? If you are not clear about the physician or other licensed health care professional's recommendation, you may ask that person whether the employee can do all of his or her routine job functions and work all of his or her normally assigned work shift. If the answer to both of these questions is “Yes,” then the case does not involve a work restriction and does not have to be recorded as such. If the answer to one or both of these questions is “No,” the case involves restricted work and must be recorded as a restricted work case. If you are unable to obtain this additional information from the physician or other licensed health care professional who recommended the restriction, record the injury or illness as a case involving restricted work.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:36ad47332446004e578ea582acfe13c75672291a2474ff29593f4e918bfcbfb2\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":10092,\"summary\":\"If you are not clear about the physician or other licensed health care professional's vague recommendation (such as light duty or taking it easy for a week), you may ask that person whether the employee can do all of his or her routine job functions and work all of his or her normally assigned work shift.\",\"target_ids\":[],\"term_refs\":[\"urn:rulespec:document-understanding:term:f6d88742f4dc880b89095112b6aef77b21e00cc28f4c097134e6e30edd0330df\"],\"typed_values\":[]}",

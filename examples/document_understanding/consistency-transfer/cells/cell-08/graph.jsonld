      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:3769e0c4c2d8ee5f97408db8a5b340c75a99da692bf84512c101c67d0ebb4b12\",\"urn:rulespec:document-understanding:assertion:0c85cb9cda4dd14e982a18436e4d641ef40b2e516557a4adad85bcc42b680055\",\"urn:rulespec:document-understanding:assertion:9eadc970710c6bfcb3c7f48daf1060fb0a198e6d2a54b438b6e2bd3ce95708ee\",\"urn:rulespec:document-understanding:assertion:b2e34f21839d20fb8d79392fa1ac2f52f0c21902b3dc91ce9645d686627765f5\",\"urn:rulespec:document-understanding:assertion:afa8f9c1ff2312a41d2449359cc2e9cd631718047535ce42ce74aefb515d77ce\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[{\"aliases\":[],\"id\":\"urn:rulespec:document-understanding:term:699afc599efce20448012df8aefeddd76455fe2bf6fa86414f457ea98d9f0dcf\",\"label\":\"medical treatment\",\"quote\":\"(i) What is the definition of medical treatment? “Medical treatment” means the management and care of a patient to combat disease or disorder. For the purposes of part 1904, medical treatment does not include:\\n\\n(A) Visits to a physician or other licensed health care professional solely for observation or counseling;\\n\\n(B) The conduct of diagnostic procedures, such as x-rays and blood tests, including the administration of prescription medications used solely for diagnostic purposes ( e.g., eye drops to dilate pupils); or\\n\\n(C) “First aid” as defined in paragraph (b)(5)(ii) of this section.\",\"source_quotes\":[\"(i) What is the definition of medical treatment? “Medical treatment” means the management and care of a patient to combat disease or disorder. For the purposes of part 1904, medical treatment does not include:\\n\\n(A) Visits to a physician or other licensed health care professional solely for observation or counseling;\\n\\n(B) The conduct of diagnostic procedures, such as x-rays and blood tests, including the administration of prescription medications used solely for diagnostic purposes ( e.g., eye drops to dilate pupils); or\\n\\n(C) “First aid” as defined in paragraph (b)(5)(ii) of this section.\"]}],\"effective_periods\":[],\"end\":14298,\"evidence\":[{\"end\":14298,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:13704:14298:sha256-89e453fadae9e7c592fddedd72d774975979f33cb9fac1b24b0b77bcc14b94ee\",\"quote\":\"(i) What is the definition of medical treatment? “Medical treatment” means the management and care of a patient to combat disease or disorder. For the purposes of part 1904, medical treatment does not include:\\n\\n(A) Visits to a physician or other licensed health care professional solely for observation or counseling;\\n\\n(B) The conduct of diagnostic procedures, such as x-rays and blood tests, including the administration of prescription medications used solely for diagnostic purposes ( e.g., eye drops to dilate pupils); or\\n\\n(C) “First aid” as defined in paragraph (b)(5)(ii) of this section.\",\"start\":13704},{\"end\":14298,\"field\":\"defined_terms:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:13704:14298:sha256-89e453fadae9e7c592fddedd72d774975979f33cb9fac1b24b0b77bcc14b94ee\",\"quote\":\"(i) What is the definition of medical treatment? “Medical treatment” means the management and care of a patient to combat disease or disorder. For the purposes of part 1904, medical treatment does not include:\\n\\n(A) Visits to a physician or other licensed health care professional solely for observation or counseling;\\n\\n(B) The conduct of diagnostic procedures, such as x-rays and blood tests, including the administration of prescription medications used solely for diagnostic purposes ( e.g., eye drops to dilate pupils); or\\n\\n(C) “First aid” as defined in paragraph (b)(5)(ii) of this section.\",\"start\":13704},{\"end\":14298,\"field\":\"defined_terms:0:source:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:13704:14298:sha256-89e453fadae9e7c592fddedd72d774975979f33cb9fac1b24b0b77bcc14b94ee\",\"quote\":\"(i) What is the definition of medical treatment? “Medical treatment” means the management and care of a patient to combat disease or disorder. For the purposes of part 1904, medical treatment does not include:\\n\\n(A) Visits to a physician or other licensed health care professional solely for observation or counseling;\\n\\n(B) The conduct of diagnostic procedures, such as x-rays and blood tests, including the administration of prescription medications used solely for diagnostic purposes ( e.g., eye drops to dilate pupils); or\\n\\n(C) “First aid” as defined in paragraph (b)(5)(ii) of this section.\",\"start\":13704}],\"id\":\"urn:rulespec:document-understanding:revision:d8355f433842a0090a40e4273a31d9e8a47a346bfa1cbb5b363b78e03e42bf32\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"definition\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:9eadc970710c6bfcb3c7f48daf1060fb0a198e6d2a54b438b6e2bd3ce95708ee\",\"modality\":\"not_stated\",\"modality_quote\":\"\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:981d2fa9e728a51200d7ce3ab50ce075416aef6db945f1620e57ae7bdb6a9ecb\",\"origin\":\"aiSuggested\",\"quote\":\"(i) What is the definition of medical treatment? “Medical treatment” means the management and care of a patient to combat disease or disorder. For the purposes of part 1904, medical treatment does not include:\\n\\n(A) Visits to a physician or other licensed health care professional solely for observation or counseling;\\n\\n(B) The conduct of diagnostic procedures, such as x-rays and blood tests, including the administration of prescription medications used solely for diagnostic purposes ( e.g., eye drops to dilate pupils); or\\n\\n(C) “First aid” as defined in paragraph (b)(5)(ii) of this section.\",\"references\":[\"part 1904\",\"paragraph (b)(5)(ii)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:4a22b661768e260af544e01e5c6d784638dd673cb00ff968aa4185275ab726c1\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":13704,\"summary\":\"Medical treatment means the management and care of a patient to combat disease or disorder, but for the purposes of part 1904 does not include visits to a physician or other licensed health care professional solely for observation or counseling; the conduct of diagnostic procedures, such as x-rays and blood tests, including the administration of prescription medications used solely for diagnostic purposes (e.g., eye drops to dilate pupils); or first aid as defined in paragraph (b)(5)(ii) of this section.\",\"target_ids\":[],\"term_refs\":[\"urn:rulespec:document-understanding:term:b68f8fca12ed8b901b797b0a443bdd6b162b9e0f0a34d4e845cba55840034c0e\"],\"typed_values\":[]}",
      "dcterms:references": [
        {

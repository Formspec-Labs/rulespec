    {
      "@id": "urn:rulespec:document-understanding:revision:955b0ca0e44e5b376154fc47d479dd4f3c6824e4bcfc6c8484dad5e9a41c1ce4",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:955b0ca0e44e5b376154fc47d479dd4f3c6824e4bcfc6c8484dad5e9a41c1ce4",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:f61d6cbdbb0f1dc1cd6961303c4a8cfb2861d4db5df1581f3b5ded4fc8e4c0be",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"you\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:22cbdc1178fe5ae477d203948e71947717d30aa413aee7ba4fea25f54bd9d3a8\",\"urn:rulespec:document-understanding:assertion:d6c1c2862db0da8f6b28d7e17b587788016105028a7dd7bd6ca68dfee848429b\",\"urn:rulespec:document-understanding:assertion:537dc82e7d5a42fb868de24464b172fac6bd25cae371305654d74d19ecf846db\",\"urn:rulespec:document-understanding:assertion:41c66af60a3d1f0814f97e8be207d045ea1225440d6bc9d3a2763a58adceb0bd\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":11707,\"evidence\":[{\"end\":11707,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:11029:11707:sha256-82bebb5231df794011ca6d0c318abf397b52f3e725f4857f1229ff7bb34f1144\",\"quote\":\"(viii) What do I do if a physician or other licensed health care professional recommends a job restriction meeting OSHA's definition, but the employee does all of his or her routine job functions anyway? You must record the injury or illness on the OSHA 300 Log as a restricted work case. If a physician or other licensed health care professional recommends a job restriction, you should ensure that the employee complies with that restriction. If you receive recommendations from two or more physicians or other licensed health care professionals, you may make a decision as to which recommendation is the most authoritative, and record the case based upon that recommendation.\",\"start\":11029}],\"id\":\"urn:rulespec:document-understanding:revision:955b0ca0e44e5b376154fc47d479dd4f3c6824e4bcfc6c8484dad5e9a41c1ce4\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"recommendation\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:41c66af60a3d1f0814f97e8be207d045ea1225440d6bc9d3a2763a58adceb0bd\",\"modality\":\"should\",\"modality_quote\":\"\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:20585d7a66f0b2798dfb34a3ca4634a71898510779087602d3e327d8764462b1\",\"origin\":\"aiSuggested\",\"quote\":\"(viii) What do I do if a physician or other licensed health care professional recommends a job restriction meeting OSHA's definition, but the employee does all of his or her routine job functions anyway? You must record the injury or illness on the OSHA 300 Log as a restricted work case. If a physician or other licensed health care professional recommends a job restriction, you should ensure that the employee complies with that restriction. If you receive recommendations from two or more physicians or other licensed health care professionals, you may make a decision as to which recommendation is the most authoritative, and record the case based upon that recommendation.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:dea219da034e1d050b350bb2bacfdaad5718c256c1929e2d07faf641587db3c7\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":11029,\"summary\":\"If a physician or other licensed health care professional recommends a job restriction, you should ensure that the employee complies with that restriction.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

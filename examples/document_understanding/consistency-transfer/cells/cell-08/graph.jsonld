    {
      "@id": "urn:rulespec:document-understanding:revision:d6991d027157598ca9d65578afb0321bcde1eadbcf0d14ea851090d5cb41d786",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:d6991d027157598ca9d65578afb0321bcde1eadbcf0d14ea851090d5cb41d786",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:b8a7587b177201f214ab41ac181d20eaaf9c98916121735a1366e4caea2e7915",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"you\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:6d8eaf7bafb8342b19415775dc20016231a12620c648a7d02c2c0dc8c45f60ad\",\"urn:rulespec:document-understanding:assertion:60adccd04d8f151bf7dbd8d1f13078ca968f1d70135b994c1a13c3ec7a8ca5bb\",\"urn:rulespec:document-understanding:assertion:bbc2414ffb70a6308e994eaa7bf4477a9e302d7d89cdab49ee51f904f30c02e6\",\"urn:rulespec:document-understanding:assertion:9a5b638be693a9ec337a3df7807ae5cd56b9439b554be25185facd90da8b16c6\",\"urn:rulespec:document-understanding:assertion:1b4204314bf1b54d4c089b08bfa6621b93c65e235dbb91f3356af663e977e37f\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":9337,\"evidence\":[{\"end\":9337,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:8560:9337:sha256-80f56b9ec7a590c268234f799ca2d222fee853f00a162a2ec31329e2b7dfbf73\",\"quote\":\"(iv) If you or a physician or other licensed health care professional recommends a work restriction, is the injury or illness automatically recordable as a “restricted work” case? No, a recommended work restriction is recordable only if it affects one or more of the employee's routine job functions. To determine whether this is the case, you must evaluate the restriction in light of the routine functions of the injured or ill employee's job. If the restriction from you or the physician or other licensed health care professional keeps the employee from performing one or more of his or her routine job functions, or from working the full workday the injured or ill employee would otherwise have worked, the employee's work has been restricted and you must record the case.\",\"start\":8560}],\"id\":\"urn:rulespec:document-understanding:revision:d6991d027157598ca9d65578afb0321bcde1eadbcf0d14ea851090d5cb41d786\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:9a5b638be693a9ec337a3df7807ae5cd56b9439b554be25185facd90da8b16c6\",\"modality\":\"must\",\"modality_quote\":\"\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:d57c27665c9b42f7e313562f51c5921388c7e58e0360d1aee58f1ad7ba821364\",\"origin\":\"aiSuggested\",\"quote\":\"(iv) If you or a physician or other licensed health care professional recommends a work restriction, is the injury or illness automatically recordable as a “restricted work” case? No, a recommended work restriction is recordable only if it affects one or more of the employee's routine job functions. To determine whether this is the case, you must evaluate the restriction in light of the routine functions of the injured or ill employee's job. If the restriction from you or the physician or other licensed health care professional keeps the employee from performing one or more of his or her routine job functions, or from working the full workday the injured or ill employee would otherwise have worked, the employee's work has been restricted and you must record the case.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:ac1895a05fef704133aa584beaf6cea788d47cf92ce28550254728101811cbe8\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":8560,\"summary\":\"If the restriction from you or the physician or other licensed health care professional keeps the employee from performing one or more of his or her routine job functions, or from working the full workday the injured or ill employee would otherwise have worked, the employee's work has been restricted and you must record the case.\",\"target_ids\":[],\"term_refs\":[\"urn:rulespec:document-understanding:term:f6d88742f4dc880b89095112b6aef77b21e00cc28f4c097134e6e30edd0330df\"],\"typed_values\":[]}",
      "dcterms:references": [

        "@value": "{\"actor\":\"you\",\"kind\":\"requirement\",\"modality\":\"must\",\"summary\":\"If an employee leaves your company because of the injury or illness, you must estimate the total number of days away or days of restriction/job transfer and enter the day count on the 300 Log.\"}",

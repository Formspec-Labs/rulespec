      "dcterms:description": "{\"action\":\"\",\"actor\":\"You\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:bb4acee8c4d0451a6eb5824ea5d031545adf065517eb7213b6fef3b55ae39e0d\",\"urn:rulespec:document-understanding:assertion:d7be94cbbe1c4ac4e9909c22e4df596965c9d510875df033fb385b5bef2df740\",\"urn:rulespec:document-understanding:assertion:c1c32e5ac2219f080063d86a78a5b43b818be34573a33e893e0fce676ac89468\",\"urn:rulespec:document-understanding:assertion:657d26d6e83aab1c1b57651c5f8328930ec23cb2a2443df2c88cb591c17d1622\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":683,\"evidence\":[{\"end\":683,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:39:683:sha256-df4f4518f36f37eb15e0493973c7f089ab3195194a14961a9f6dd3fe76b3fdf0\",\"quote\":\"(a) Basic requirement. You must consider an injury or illness to meet the general recording criteria, and therefore to be recordable, if it results in any of the following: death, days away from work, restricted work or transfer to another job, medical treatment beyond first aid, or loss of consciousness. You must also consider a case to meet the general recording criteria if it involves a significant injury or illness diagnosed by a physician or other licensed health care professional, even if it does not result in death, days away from work, restricted work or job transfer, medical treatment beyond first aid, or loss of consciousness.\",\"start\":39}],\"id\":\"urn:rulespec:document-understanding:revision:0f7702a20a2d8b66d130cacee2ddb708d1d9a7f7adba7689497027417f50b25e\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:657d26d6e83aab1c1b57651c5f8328930ec23cb2a2443df2c88cb591c17d1622\",\"modality\":\"must\",\"modality_quote\":\"\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:977b097f228923d99c1aa98114146ea2501543478ed794111321a48db7e98c8b\",\"origin\":\"aiSuggested\",\"quote\":\"(a) Basic requirement. You must consider an injury or illness to meet the general recording criteria, and therefore to be recordable, if it results in any of the following: death, days away from work, restricted work or transfer to another job, medical treatment beyond first aid, or loss of consciousness. You must also consider a case to meet the general recording criteria if it involves a significant injury or illness diagnosed by a physician or other licensed health care professional, even if it does not result in death, days away from work, restricted work or job transfer, medical treatment beyond first aid, or loss of consciousness.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:73b2af15c3ff51927615c0064faa950ab58ed6822db5eb89f7b1d004653356b5\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":39,\"summary\":\"You must consider a case to meet the general recording criteria if it involves a significant injury or illness diagnosed by a physician or other licensed health care professional, even if it does not result in death, days away from work, restricted work or job transfer, medical treatment beyond first aid, or loss of consciousness.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",
      "dcterms:references": [
        {
          "@id": "urn:rulespec:document-understanding:assertion:bb4acee8c4d0451a6eb5824ea5d031545adf065517eb7213b6fef3b55ae39e0d"
        },

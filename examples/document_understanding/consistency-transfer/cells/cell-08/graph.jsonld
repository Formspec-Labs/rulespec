      "dcterms:description": "{\"action\":\"\",\"actor\":\"you\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:5a638248dd6aa05944bcdf4e4dee4640b5622535ada504345677bf212cf43ae8\",\"urn:rulespec:document-understanding:assertion:d6daebbadd80a74d9a41a2e5e10f3e6c8b40459519671f20cea6bbe88a6047e1\",\"urn:rulespec:document-understanding:assertion:b0fde8e551a4a4e98b80c070de58d7bb1e079cd3117d8d6d8cb8b87fef13679e\",\"urn:rulespec:document-understanding:assertion:15ac35ae3b9599eb439a04df805bfe33ae9d777ce7b52274ae68a89e5ac3f3a1\",\"urn:rulespec:document-understanding:assertion:4277c2ebee4367f0bb5f891802877bac66e79eae3618791e1dc55658ab334114\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":13702,\"evidence\":[{\"end\":13702,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:13184:13702:sha256-f281ea0cbf0a061f637ea5c08f88615fdee014a2cb60eb32ce82eb1fbb544213\",\"quote\":\"(5) How do I record an injury or illness that involves medical treatment beyond first aid? If a work-related injury or illness results in medical treatment beyond first aid, you must record it on the OSHA 300 Log. If the injury or illness did not involve death, one or more days away from work, one or more days of restricted work, or one or more days of job transfer, you enter a check mark in the box for cases where the employee received medical treatment but remained at work and was not transferred or restricted.\",\"start\":13184}],\"id\":\"urn:rulespec:document-understanding:revision:0addfa34d98e66133bb14a524d25fb85dd6f43f8ee07f5aaba801a04ff1ef8eb\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"statement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:15ac35ae3b9599eb439a04df805bfe33ae9d777ce7b52274ae68a89e5ac3f3a1\",\"modality\":\"not_stated\",\"modality_quote\":\"\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:055b02f0e6f5e6950afbd247f0254ee2a552950674fbaa316c0c9d1622531209\",\"origin\":\"aiSuggested\",\"quote\":\"(5) How do I record an injury or illness that involves medical treatment beyond first aid? If a work-related injury or illness results in medical treatment beyond first aid, you must record it on the OSHA 300 Log. If the injury or illness did not involve death, one or more days away from work, one or more days of restricted work, or one or more days of job transfer, you enter a check mark in the box for cases where the employee received medical treatment but remained at work and was not transferred or restricted.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:907ad91cd50955a4ee70d2b5554fccfda8c4de93e5ddba31538e6129bd79af13\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":13184,\"summary\":\"If the injury or illness results in medical treatment beyond first aid but did not involve death, one or more days away from work, one or more days of restricted work, or one or more days of job transfer, you enter a check mark in the box for cases where the employee received medical treatment but remained at work and was not transferred or restricted.\",\"target_ids\":[],\"term_refs\":[\"urn:rulespec:document-understanding:term:699afc599efce20448012df8aefeddd76455fe2bf6fa86414f457ea98d9f0dcf\"],\"typed_values\":[]}",
      "dcterms:references": [

    {
      "@id": "urn:rulespec:document-understanding:revision:1964b2152ce0d7794e878c681cb13c0d53f236cb0cb9c271052e0215a16a9f7c",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:1964b2152ce0d7794e878c681cb13c0d53f236cb0cb9c271052e0215a16a9f7c",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:425d86fa9fa22811b6e577855a75fb780c097b02d1370f330f0f0bf365ba6764",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"you\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:b490258ea67897ef24cbf5a8261ae62347f77dd5965a3b5ffc9105b36e0efae5\",\"urn:rulespec:document-understanding:assertion:c11540f78c837661e261eb159c1863fd8158d4526da44049028cbd4f8d4b62ac\",\"urn:rulespec:document-understanding:assertion:cfb25b3acb68bb7dcaee5976407eddc742b6ddf44a45f26c8b536f4313943aaa\",\"urn:rulespec:document-understanding:assertion:ba53f02a6a660db13c036541086aace678a7b0049a8c7f00f326fda8e7fc12ba\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":6957,\"evidence\":[{\"end\":6957,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:6274:6957:sha256-f30b3505e5ec1721e9c5fa7739371397b95774f82cd6c339f3182e387e87be1d\",\"quote\":\"(ix) If a case occurs in one year but results in days away during the next calendar year, do I record the case in both years? No, you only record the injury or illness once. You must enter the number of calendar days away for the injury or illness on the OSHA 300 Log for the year in which the injury or illness occurred. If the employee is still away from work because of the injury or illness when you prepare the annual summary, estimate the total number of calendar days you expect the employee to be away from work, use this number to calculate the total for the annual summary, and then update the initial log entry later when the day count is known or reaches the 180-day cap.\",\"start\":6274}],\"id\":\"urn:rulespec:document-understanding:revision:1964b2152ce0d7794e878c681cb13c0d53f236cb0cb9c271052e0215a16a9f7c\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:ba53f02a6a660db13c036541086aace678a7b0049a8c7f00f326fda8e7fc12ba\",\"modality\":\"must\",\"modality_quote\":\"\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:0ae8c8ae772739dd0197e66e38f8d8e0bdd694b8889ae17cb4ada47e20c63cf4\",\"origin\":\"aiSuggested\",\"quote\":\"(ix) If a case occurs in one year but results in days away during the next calendar year, do I record the case in both years? No, you only record the injury or illness once. You must enter the number of calendar days away for the injury or illness on the OSHA 300 Log for the year in which the injury or illness occurred. If the employee is still away from work because of the injury or illness when you prepare the annual summary, estimate the total number of calendar days you expect the employee to be away from work, use this number to calculate the total for the annual summary, and then update the initial log entry later when the day count is known or reaches the 180-day cap.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:b107aa250f99115f117cff02273bb04158976a110513c842c2194910fe59bf63\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":6274,\"summary\":\"If a case occurs in one year but results in days away during the next calendar year, you only record the injury or illness once, and you must enter the number of calendar days away for the injury or illness on the OSHA 300 Log for the year in which the injury or illness occurred.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",
      "dcterms:references": [

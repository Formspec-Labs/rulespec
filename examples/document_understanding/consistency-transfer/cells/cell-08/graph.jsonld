        "@value": "{\"actor\":\"You\",\"kind\":\"exemption\",\"modality\":\"not_required\",\"summary\":\"You are not required to keep track of the number of calendar days away from work if the injury or illness resulted in more than 180 calendar days away from work and/or days of job transfer or restriction, and in such a case, entering 180 in the total days away column will be considered adequate.\"}",
        "@type": "xsd:string"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

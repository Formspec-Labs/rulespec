      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"you\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:6da766ab3d956224e01d60f84ba69a0976a79f3d7e5793e9860aa4544cb88a42\",\"urn:rulespec:document-understanding:assertion:a7bdaa4ac33f845384ab5645fa068e7aa336906ac1de0e2795411565355d1c7b\",\"urn:rulespec:document-understanding:assertion:b1b0e8eff5fb12967199f63106c2b64845f75e1285f8ce54bb892f4f27e7e570\",\"urn:rulespec:document-understanding:assertion:ae1e9c0d32eca50815a57b550c863b4c97ee14cf698bb3fb6a3fab4e25fb7062\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":5713,\"evidence\":[{\"end\":5713,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:5286:5713:sha256-4649cc6490410d90b433bb6f2b05bb96cba22bcfa486e18ab71cf2806975a6e2\",\"quote\":\"(vii) Is there a limit to the number of days away from work I must count? Yes, you may “cap” the total days away at 180 calendar days. You are not required to keep track of the number of calendar days away from work if the injury or illness resulted in more than 180 calendar days away from work and/or days of job transfer or restriction. In such a case, entering 180 in the total days away column will be considered adequate.\",\"start\":5286},{\"end\":5368,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:5365:5368:sha256-bb0347a468d97e98a9c00e37cebec1ab930f6f1221cae0f1fbb92b07e1900ba2\",\"quote\":\"you\",\"start\":5365}],\"id\":\"urn:rulespec:document-understanding:revision:d7fcd05194c918545b5688f8e64f6e66e9eaf007d814c620589a4c54c00eefa6\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"permission\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:ae1e9c0d32eca50815a57b550c863b4c97ee14cf698bb3fb6a3fab4e25fb7062\",\"modality\":\"may\",\"modality_quote\":\"\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:7c0e805a751f339c0fb54aa7a17ab3bc493d84c6c898c62336e00f28959335e0\",\"origin\":\"aiSuggested\",\"quote\":\"(vii) Is there a limit to the number of days away from work I must count? Yes, you may “cap” the total days away at 180 calendar days. You are not required to keep track of the number of calendar days away from work if the injury or illness resulted in more than 180 calendar days away from work and/or days of job transfer or restriction. In such a case, entering 180 in the total days away column will be considered adequate.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:56a66e7f16e3261d16700acc073ab3b3467a800f3324ec53aea0bc7ea4e80af7\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":5286,\"summary\":\"You may cap the total days away from work at 180 calendar days.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

      "dcterms:description": "{\"action\":\"\",\"actor\":\"You\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:57d6482bcaa24676e451647600a949179f79f2a5678c58acc4cdc7b717cdc528\",\"urn:rulespec:document-understanding:assertion:1356de90af7bb6a8806f357cc478f936d43ba021978d370a710ef10cf42028d3\",\"urn:rulespec:document-understanding:assertion:c88dae0897b997990a572726d9880888812f698fd7569e130b8e2268fb413134\",\"urn:rulespec:document-understanding:assertion:d997189e23ad87e4ca905dc397a43ad56b2bf3e52b5c457ff4cd09a5c3b0440e\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":3299,\"evidence\":[{\"end\":3299,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:2343:3299:sha256-69f39fbb70f07e7dda79d0b899982b359ac723ad82b990b47ff61feba46ddace\",\"quote\":\"(ii) How do I record an injury or illness when a physician or other licensed health care professional recommends that the worker stay at home but the employee comes to work anyway? You must record these injuries and illnesses on the OSHA 300 Log using the check box for cases with days away from work and enter the number of calendar days away recommended by the physician or other licensed health care professional. If a physician or other licensed health care professional recommends days away, you should encourage your employee to follow that recommendation. However, the days away must be recorded whether the injured or ill employee follows the physician or licensed health care professional's recommendation or not. If you receive recommendations from two or more physicians or other licensed health care professionals, you may make a decision as to which recommendation is the most authoritative, and record the case based upon that recommendation.\",\"start\":2343},{\"end\":2527,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:2524:2527:sha256-08b041935798fbf6fd6ff51099ffedb140a475889986d14f5559ff8e7fc571dd\",\"quote\":\"You\",\"start\":2524}],\"id\":\"urn:rulespec:document-understanding:revision:387d49e531f63bc7194dd9a2d2c20070ac688a993f47cdf8871f7d6054397028\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:d997189e23ad87e4ca905dc397a43ad56b2bf3e52b5c457ff4cd09a5c3b0440e\",\"modality\":\"must\",\"modality_quote\":\"\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:bf0990f3ba39e64dd8a81c42b3818ab5f2c3be1b71c344d439e39dc65b64f2cb\",\"origin\":\"aiSuggested\",\"quote\":\"(ii) How do I record an injury or illness when a physician or other licensed health care professional recommends that the worker stay at home but the employee comes to work anyway? You must record these injuries and illnesses on the OSHA 300 Log using the check box for cases with days away from work and enter the number of calendar days away recommended by the physician or other licensed health care professional. If a physician or other licensed health care professional recommends days away, you should encourage your employee to follow that recommendation. However, the days away must be recorded whether the injured or ill employee follows the physician or licensed health care professional's recommendation or not. If you receive recommendations from two or more physicians or other licensed health care professionals, you may make a decision as to which recommendation is the most authoritative, and record the case based upon that recommendation.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:8fefd92c2e42f5f76081bd1a6a1
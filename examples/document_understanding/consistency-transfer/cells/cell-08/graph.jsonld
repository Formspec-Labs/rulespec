    {
      "@id": "urn:rulespec:document-understanding:revision:39f6c56806b80a01ba3009a1b7c13519cbedf8c62153825ec812ab41485d6f79",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:39f6c56806b80a01ba3009a1b7c13519cbedf8c62153825ec812ab41485d6f79",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:ff09e48adc292bae0de444954dbb9179c69978bc122b360a0f0dbb3478cf53e4",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"you\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:1a42ef4b8fcd1c358788b5db3eeb1f1a3ec5e4a01c99bd77d63e9c434cbb2488\",\"urn:rulespec:document-understanding:assertion:fad91a7422c39423c4ac5bfa68da4f7d4c97768adb97a626f851c9d2fa5ed67f\",\"urn:rulespec:document-understanding:assertion:72c9e28f4da73a955db7aa6a97f98ead958fe9cc1a3e609fa055cf56135c4a81\",\"urn:rulespec:document-understanding:assertion:0d927186558e3561aa419cdb4e98a35b3905aa514ff5c898eeeb2bb2d05c95ff\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":3299,\"evidence\":[{\"end\":3299,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:2343:3299:sha256-69f39fbb70f07e7dda79d0b899982b359ac723ad82b990b47ff61feba46ddace\",\"quote\":\"(ii) How do I record an injury or illness when a physician or other licensed health care professional recommends that the worker stay at home but the employee comes to work anyway? You must record these injuries and illnesses on the OSHA 300 Log using the check box for cases with days away from work and enter the number of calendar days away recommended by the physician or other licensed health care professional. If a physician or other licensed health care professional recommends days away, you should encourage your employee to follow that recommendation. However, the days away must be recorded whether the injured or ill employee follows the physician or licensed health care professional's recommendation or not. If you receive recommendations from two or more physicians or other licensed health care professionals, you may make a decision as to which recommendation is the most authoritative, and record the case based upon that recommendation.\",\"start\":2343}],\"id\":\"urn:rulespec:document-understanding:revision:39f6c56806b80a01ba3009a1b7c13519cbedf8c62153825ec812ab41485d6f79\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"recommendation\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:0d927186558e3561aa419cdb4e98a35b3905aa514ff5c898eeeb2bb2d05c95ff\",\"modality\":\"should\",\"modality_quote\":\"\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:c6001d2f33fee40cf55716bfa592b47e0f75eabbd981dd55010a2b22d0af53a1\",\"origin\":\"aiSuggested\",\"quote\":\"(ii) How do I record an injury or illness when a physician or other licensed health care professional recommends that the worker stay at home but the employee comes to work anyway? You must record these injuries and illnesses on the OSHA 300 Log using the check box for cases with days away from work and enter the number of calendar days away recommended by the physician or other licensed health care professional. If a physician or other licensed health care professional recommends days away, you should encourage your employee to follow that recommendation. However, the days away must be recorded whether the injured or ill employee follows the physician or licensed health care professional's recommendation or not. If you receive recommendations from two or more physicians or other licensed health care professionals, you may make a decision as to which recommendation is the most authoritative, and record the case based upon that recommendation.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:6d1780f4afdbff61ca8eaf02ffdebcc9ee8b5a9c70358de9f6358310f73678ee\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":2343,\"summary\":\"If a physician or other licensed health care professional recommends days away, you should encourage your employee to follow that recommendation.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"you\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:371764dbce36aab995945597b7d2fad693052355eaa3243203163d8cf32bca53\",\"urn:rulespec:document-understanding:assertion:84d041fb8897d2df19c4f1e7d63f234b01d6fcd29831f591823a9d4bb65c29df\",\"urn:rulespec:document-understanding:assertion:886180a9a5eefb244ecef56eeb677707999c58ca163f37753e53b1facf54b8ee\",\"urn:rulespec:document-understanding:assertion:4fa26b8f824bebca780a9d947d2189927c694c5d9e3af51975008ce6c78f7ef9\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":6957,\"evidence\":[{\"end\":6957,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:6274:6957:sha256-f30b3505e5ec1721e9c5fa7739371397b95774f82cd6c339f3182e387e87be1d\",\"quote\":\"(ix) If a case occurs in one year but results in days away during the next calendar year, do I record the case in both years? No, you only record the injury or illness once. You must enter the number of calendar days away for the injury or illness on the OSHA 300 Log for the year in which the injury or illness occurred. If the employee is still away from work because of the injury or illness when you prepare the annual summary, estimate the total number of calendar days you expect the employee to be away from work, use this number to calculate the total for the annual summary, and then update the initial log entry later when the day count is known or reaches the 180-day cap.\",\"start\":6274}],\"id\":\"urn:rulespec:document-understanding:revision:e92b59e7a3f20d342bfd51a970189e4a357fd66cbd6f04db6594329ac7d948f2\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:4fa26b8f824bebca780a9d947d2189927c694c5d9e3af51975008ce6c78f7ef9\",\"modality\":\"must\",\"modality_quote\":\"\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:14ee95ac9611550d65afcaa836cb16f3ce76d5745acdff561ab31934d989bff8\",\"origin\":\"aiSuggested\",\"quote\":\"(ix) If a case occurs in one year but results in days away during the next calendar year, do I record the case in both years? No, you only record the injury or illness once. You must enter the number of calendar days away for the injury or illness on the OSHA 300 Log for the year in which the injury or illness occurred. If the employee is still away from work because of the injury or illness when you prepare the annual summary, estimate the total number of calendar days you expect the employee to be away from work, use this number to calculate the total for the annual summary, and then update the initial log entry later when the day count is known or reaches the 180-day cap.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:e5513a0bd0b19f214e413c998b77a7a136934da6ca1ccfd3a787c51657bb15f0\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":6274,\"summary\":\"If the employee is still away from work because of the injury or illness when you prepare the annual summary, you must estimate the total number of calendar days you expect the employee to be away from work, use this number to calculate the total for the annual summary, and then update the initial log entry later when the day count is known or reaches the 180-day cap.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

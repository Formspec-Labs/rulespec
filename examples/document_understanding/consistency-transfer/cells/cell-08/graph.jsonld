      "rkaf:assertsValue": {
        "@value": "If you are not clear about the physician or other licensed health care professional's vague recommendation (such as light duty or taking it easy for a week), you may ask that person whether the employee can do all of his or her routine job functions and work all of his or her normally assigned work shift.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

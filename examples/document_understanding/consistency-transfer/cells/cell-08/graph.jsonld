      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"you\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:94ae31812eb3e4cf9173449144c71c99b5158bf5e62acf694482afcc6e15b5e9\",\"urn:rulespec:document-understanding:assertion:b090b0623cf0b4ab13f081a8b7069e273fc92cd7a2ca0b82877bd931ae0545a2\",\"urn:rulespec:document-understanding:assertion:f1ba7662f6ca58d89fa38d882432dc014ff4152ebec3be54911308261e549172\",\"urn:rulespec:document-understanding:assertion:6613eccc8e75335e62b562da3df292b8545b954e8c61e26848dc1a9b3aa06f8e\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":7401,\"evidence\":[{\"end\":7401,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:6959:7401:sha256-7ad2e469bb2a039f299d2420ba287ea41943979639aa6ccf57f5daa00ab9b9c9\",\"quote\":\"(4) How do I record a work-related injury or illness that results in restricted work or job transfer? When an injury or illness involves restricted work or job transfer but does not involve death or days away from work, you must record the injury or illness on the OSHA 300 Log by placing a check mark in the space for job transfer or restriction and an entry of the number of restricted or transferred days in the restricted workdays column.\",\"start\":6959},{\"end\":7182,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:7179:7182:sha256-bb0347a468d97e98a9c00e37cebec1ab930f6f1221cae0f1fbb92b07e1900ba2\",\"quote\":\"you\",\"start\":7179}],\"id\":\"urn:rulespec:document-understanding:revision:3c2ce1ffd70f4558ae22e20e45d5f7242bd143064d1b0884ede89c7c05b71deb\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:6613eccc8e75335e62b562da3df292b8545b954e8c61e26848dc1a9b3aa06f8e\",\"modality\":\"must\",\"modality_quote\":\"\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:869a59dad4447f28537334233616a62537e337fe1114cd541678f980855f2048\",\"origin\":\"aiSuggested\",\"quote\":\"(4) How do I record a work-related injury or illness that results in restricted work or job transfer? When an injury or illness involves restricted work or job transfer but does not involve death or days away from work, you must record the injury or illness on the OSHA 300 Log by placing a check mark in the space for job transfer or restriction and an entry of the number of restricted or transferred days in the restricted workdays column.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:9fcaaa72d3ea8de3b956464b27d47983c8fea1207c9360418a227504237a842c\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":6959,\"summary\":\"When an injury or illness involves restricted work or job transfer but does not involve death or days away from work, you must record the injury or illness on the OSHA 300 Log by placing a check mark in the space for job transfer or restriction and an entry of the number of restricted or transferred days in the restricted workdays column.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

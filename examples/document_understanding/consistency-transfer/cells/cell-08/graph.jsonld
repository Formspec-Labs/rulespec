      "rkaf:assertsValue": {
        "@value": "{\"actor\":\"you\",\"kind\":\"permission\",\"modality\":\"may\",\"summary\":\"If you are not clear about the physician or other licensed health care professional's vague recommendation (such as light duty or taking it easy for a week), you may ask that person whether the employee can do all of his or her routine job functions and work all of his or her normally assigned work shift.\",\"term_refs\":[\"urn:rulespec:document-understanding:term:f6d88742f4dc880b89095112b6aef77b21e00cc28f4c097134e6e30edd0330df\"]}",

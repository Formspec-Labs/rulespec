      "dcterms:description": "{\"action\":\"\",\"actor\":\"you\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:f180210585cc9e458fe0b39a1b2835addf141e32c21a4e46cc10f29debff88e8\",\"urn:rulespec:document-understanding:assertion:19e1ea0d1c21c2a6bfc88ef5478f49f6254c00d67cb416d783efa279d3ec09d6\",\"urn:rulespec:document-understanding:assertion:492ae62a4a7619f1e8cbf6a747311a68d29fc6fad20ba7b5d9eab4ae96e68b5f\",\"urn:rulespec:document-understanding:assertion:47275f06ab12cc2b9e345ca578dda72e6902987b7fda93174653ba07157aa844\",\"urn:rulespec:document-understanding:assertion:4313595448e90a194a01331d12e63f13e64c39eac28201f962b87340f097995d\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":17406,\"evidence\":[{\"end\":17406,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:16929:17406:sha256-9b1bcabae40c804f218637d234deab2361be44911e60d8b70a9169748800454b\",\"quote\":\"(v) What if a physician or other licensed health care professional recommends medical treatment but the employee does not follow the recommendation? If a physician or other licensed health care professional recommends medical treatment, you should encourage the injured or ill employee to follow that recommendation. However, you must record the case even if the injured or ill employee does not follow the physician or other licensed health care professional's recommendation.\",\"start\":16929}],\"id\":\"urn:rulespec:document-understanding:revision:3ccacebd53a73daa4f64be6f0f1d117829eea21e79481bd9f04a0a13b91880c9\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"recommendation\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:47275f06ab12cc2b9e345ca578dda72e6902987b7fda9
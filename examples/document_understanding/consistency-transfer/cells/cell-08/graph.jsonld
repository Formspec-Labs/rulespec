    {
      "@id": "urn:rulespec:document-understanding:revision:a07c49ce646e52b173a4eeba536ff760e770805b2d9db4174796a51bbaffa55d",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:a07c49ce646e52b173a4eeba536ff760e770805b2d9db4174796a51bbaffa55d",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:c58d1abc3253451571cc22dbb66c3b5576b1c59fe56893a82d603e7e0a41dae3",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"you\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:04dbe6d2218e902e18b6245e4cf0a8983783756a4916a2daa7ad3b0b9e20b326\",\"urn:rulespec:document-understanding:assertion:19ccf0cae88b3e0916adca38230cd7b93631a2825bf6a34f513bbb96f6237ac2\",\"urn:rulespec:document-understanding:assertion:51db00b8e76b5ea52f032669086aaf3fc97071ed1bea717948afa5aaddbaa1a4\",\"urn:rulespec:document-understanding:assertion:bd6f993d126aa3bed9f4e009f6dde209b35caa9900fc088378d720cfc0afe803\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":2174,\"evidence\":[{\"end\":2174,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:1617:2174:sha256-295e3d1d80103f075a314352a8343e90b14208ea575eac5335d4b5726fac78ca\",\"quote\":\"(3) How do I record a work-related injury or illness that results in days away from work? When an injury or illness involves one or more days away from work, you must record the injury or illness on the OSHA 300 Log with a check mark in the space for cases involving days away and an entry of the number of calendar days away from work in the number of days column. If the employee is out for an extended period of time, you must enter an estimate of the days that the employee will be away, and update the day count when the actual number of days is known.\",\"start\":1617}],\"id\":\"urn:rulespec:document-understanding:revision:a07c49ce646e52b173a4eeba536ff760e770805b2d9db4174796a51bbaffa55d\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:bd6f993d126aa3bed9f4e009f6dde209b35caa9900fc088378d720cfc0afe803\",\"modality\":\"must\",\"modality_quote\":\"\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:2751afb633b7e9d74791031ba4f3061eb9ff1af73e3d3478ac4d34558b668487\",\"origin\":\"aiSuggested\",\"quote\":\"(3) How do I record a work-related injury or illness that results in days away from work? When an injury or illness involves one or more days away from work, you must record the injury or illness on the OSHA 300 Log with a check mark in the space for cases involving days away and an entry of the number of calendar days away from work in the number of days column. If the employee is out for an extended period of time, you must enter an estimate of the days that the employee will be away, and update the day count when the actual number of days is known.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:03a736b1ab2a4dea1ff183636bd3dd8fd26bea6aba632810df73b89bb64a517c\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":1617,\"summary\":\"If the employee is out for an extended period of time, you must enter an estimate of the days that the employee will be away, and update the day count when the actual number of days is known.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

    {
      "@id": "urn:rulespec:document-understanding:revision:349e0a386ec524ad9ab60f1dd63c1a2b449b0f351704b355e81e37acd4977267",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:349e0a386ec524ad9ab60f1dd63c1a2b449b0f351704b355e81e37acd4977267",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:43aad7e99dfbb3b415fd348f8869b02d825cf160c4ac395cb09382e8e963b9e1",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"you\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:b8c6a4dff3aa8fd2b1eea23a702bb04ade3c3e32e2667fe1efb3d269946c0240\",\"urn:rulespec:document-understanding:assertion:59a22f2522bf551935acb075ddd6f1bb51ba1a6810b7147ae113f45ba25cd16b\",\"urn:rulespec:document-understanding:assertion:ed960167c9dad6f34687da9fa30d1d35e090969e37ef593d65dceac1eb248864\",\"urn:rulespec:document-understanding:assertion:de0b27d5e9188514a3d66109da58ac71a868c235e074a1ea9db26e78e9549080\",\"urn:rulespec:document-understanding:assertion:5c2180a0f9d6833339eda9f5aaf2cfbfcc9c15e71ade0a1332ff9c2243d97616\",\"urn:rulespec:document-understanding:assertion:f9bf3295996422ae7a01d37a63c6f370f161c0b34183d267fe4b6774411577d5\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":13702,\"evidence\":[{\"end\":13702,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:13184:13702:sha256-f281ea0cbf0a061f637ea5c08f88615fdee014a2cb60eb32ce82eb1fbb544213\",\"quote\":\"(5) How do I record an injury or illness that involves medical treatment beyond first aid? If a work-related injury or illness results in medical treatment beyond first aid, you must record it on the OSHA 300 Log. If the injury or illness did not involve death, one or more days away from work, one or more days of restricted work, or one or more days of job transfer, you enter a check mark in the box for cases where the employee received medical treatment but remained at work and was not transferred or restricted.\",\"start\":13184}],\"id\":\"urn:rulespec:document-understanding:revision:349e0a386ec524ad9ab60f1dd63c1a2b449b0f351704b355e81e37acd4977267\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:de0b27d5e9188514a3d66109da58ac71a868c235e074a1ea9db26e78e9549080\",\"modality\":\"must\",\"modality_quote\":\"\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:e4bbb2816a503bc2635a9059049adc9b62399cc14c118d0bdaba63c1886e64c6\",\"origin\":\"aiSuggested\",\"quote\":\"(5) How do I record an injury or illness that involves medical treatment beyond first aid? If a work-related injury or illness results in medical treatment beyond first aid, you must record it on the OSHA 300 Log. If the injury or illness did not involve death, one or more days away from work, one or more days of restricted work, or one or more days of job transfer, you enter a check mark in the box for cases where the employee received medical treatment but remained at work and was not transferred or restricted.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:3cd3e58d33708ba0b08249c693c3b07b4e4f1f8f8db7f1da75c1a1b23621fbcf\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":13184,\"summary\":\"If a work-related injury or illness results in medical treatment beyond first aid, you must record it on the OSHA 300 Log.\",\"target_ids\":[],\"term_refs\":[\"urn:rulespec:document-understanding:term:699afc599efce20448012df8aefeddd76455fe2bf6fa86414f457ea98d9f0dcf\",\"urn:rulespec:document-understanding:term:b68f8fca12ed8b901b797b0a443bdd6b162b9e0f0a34d4e845cba55840034c0e\"],\"typed_values\":[]}",

    {
      "@id": "urn:rulespec:document-understanding:revision:e555ce3ef145e26c721308b98556ee37c057e59b5798e15c8587b56f2e7c1819",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:e555ce3ef145e26c721308b98556ee37c057e59b5798e15c8587b56f2e7c1819",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:6d2a45b36578a745b4e4d80011133180c44eaae41dbc284fcb8039825da3b2af",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"You\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:8ac5c726e7962667fb1d75092ab59bb598293d4f205501836dd6476899cfc5db\",\"urn:rulespec:document-understanding:assertion:1a005aa5da34279145ab9e9d46e9efe0941b644d465cff759613754a4ed89b2c\",\"urn:rulespec:document-understanding:assertion:e39500b5a809514af66508ed53ed9e8ee65f51f6553dbd3fb364ba48742d984b\",\"urn:rulespec:document-understanding:assertion:05168747a7236a9a5d1fe553e898ec832fcbfeec25d62b8b5a2d3a4c6ad0739c\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":12595,\"evidence\":[{\"end\":12595,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:12016:12595:sha256-5e84aadde3ca497a661d1d42aee90d31dd0a29baf424d833da4d305b42465468\",\"quote\":\"(x) Are transfers to another job recorded in the same way as restricted work cases? Yes, both job transfer and restricted work cases are recorded in the same box on the OSHA 300 Log. For example, if you assign, or a physician or other licensed health care professional recommends that you assign, an injured or ill worker to his or her routine job duties for part of the day and to another job for the rest of the day, the injury or illness involves a job transfer. You must record an injury or illness that involves a job transfer by placing a check in the box for job transfer.\",\"start\":12016},{\"end\":12485,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:12482:12485:sha256-08b041935798fbf6fd6ff51099ffedb140a475889986d14f5559ff8e7fc571dd\",\"quote\":\"You\",\"start\":12482}],\"id\":\"urn:rulespec:document-understanding:revision:e555ce3ef145e26c721308b98556ee37c057e59b5798e15c8587b56f2e7c1819\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:05168747a7236a9a5d1fe553e898ec832fcbfeec25d62b8b5a2d3a4c6ad0739c\",\"modality\":\"must\",\"modality_quote\":\"\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:a3adbfc1b18368ad806d607ef00aaf137bbb6a402095a922e35c0ca5a5a2656d\",\"origin\":\"aiSuggested\",\"quote\":\"(x) Are transfers to another job recorded in the same way as restricted work cases? Yes, both job transfer and restricted work cases are recorded in the same box on the OSHA 300 Log. For example, if you assign, or a physician or other licensed health care professional recommends that you assign, an injured or ill worker to his or her routine job duties for part of the day and to another job for the rest of the day, the injury or illness involves a job transfer. You must record an injury or illness that involves a job transfer by placing a check in the box for job transfer.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:9bfdc58e88136855c80e7ead07fe2f1fcbe967f5fe45a1820e2062d2920179e3\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":12016,\"summary\":\"Both job transfer and restricted work cases are recorded in the same box on the OSHA 300 Log; you must record an injury or illness that involves a job transfer by placing a check in the box for job transfer.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",
      "dcterms:references": [

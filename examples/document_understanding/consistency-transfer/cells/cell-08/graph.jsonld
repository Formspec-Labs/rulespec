      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"you\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:e745ee2b2df3e9721fe7e1a64a7f8b0b9003cf254c81ccff5056702a9b900b39\",\"urn:rulespec:document-understanding:assertion:ea3a80796c817f0299924d8f31bc13c49758e082886465187f7ae36fbda20a89\",\"urn:rulespec:document-understanding:assertion:573e5d79e7cb9cad5979efaa63f0101fab6b0335c21aafa88db96d81cc17ed6c\",\"urn:rulespec:document-understanding:assertion:fed21706df36bbbdeb8e7f7391fa3207b737930144b6363020a7a93f8b47551b\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":3649,\"evidence\":[{\"end\":3649,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:3301:3649:sha256-2b185cdf4e9e2b0828fe0cdafd25f0a53d5e27ae6789a771ec78705cde9b4444\",\"quote\":\"(iii) How do I handle a case when a physician or other licensed health care professional recommends that the worker return to work but the employee stays at home anyway? In this situation, you must end the count of days away from work on the date the physician or other licensed health care professional recommends that the employee return to work.\",\"start\":3301},{\"end\":3493,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:3490:3493:sha256-bb0347a468d97e98a9c00e37cebec1ab930f6f1221cae0f1fbb92b07e1900ba2\",\"quote\":\"you\",\"start\":3490}],\"id\":\"urn:rulespec:document-understanding:revision:83b7c94d550c7d9959803849ba0da98047bec53239d8e9c4263c4dbe7fd62534\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:fed21706df36bbbdeb8e7f7391fa3207b737930144b6363020a7a93f8b47551b\",\"modality\":\"must\",\"modality_quote\":\"\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:41b1fb884f8d20282d6bd8758ee0c122762842b722ef007a4eccc63907b99700\",\"origin\":\"aiSuggested\",\"quote\":\"(iii) How do I handle a case when a physician or other licensed health care professional recommends that the worker return to work but the employee stays at home anyway? In this situation, you must end the count of days away from work on the date the physician or other licensed health care professional recommends that the employee return to work.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:ac3d6544d97e51a5060e1efab89809ec99a3f7b91439fc8729cb6154f3878ad3\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":3301,\"summary\":\"When a physician or other licensed health care professional recommends that the worker return to work but the employee stays at home anyway, you must end the count of days away from work on the date the physician or other licensed health care professional recommends that the employee return to work.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",
      "dcterms:references": [

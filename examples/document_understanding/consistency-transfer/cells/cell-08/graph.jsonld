        "@value": "{\"actor\":\"you\",\"kind\":\"requirement\",\"modality\":\"must\",\"summary\":\"A recommended work restriction is recordable only if it affects one or more of the employee's routine job functions, and to determine whether this is the case, you must evaluate the restriction in light of the routine functions of the injured or ill employee's job.\",\"term_refs\":[\"urn:rulespec:document-understanding:term:f6d88742f4dc880b89095112b6aef77b21e00cc28f4c097134e6e30edd0330df\"]}",
        "@type": "xsd:string"

      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:308e3fdf7adf4202d3c8429da6da96a748ba7085a7d259c54eabd9107ec1fe96",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:8b09c42a1eef96d7c4d20a9db2a7ca95f5d31e5dab36765d438fbca745fed7aa",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"actor\":\"you\",\"kind\":\"permission\",\"modality\":\"may\",\"summary\":\"If you receive recommendations from two or more physicians or other licensed health care professionals, you may make a decision as to which recommendation is the most authoritative, and record the case based upon that recommendation.\"}",
        "@type": "xsd:string"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },
    {
      "@id": "urn:rulespec:document-understanding:binding:457622eac2360429c702b55e6c115726e0921c1d3a553f57953492c943ead3f7",

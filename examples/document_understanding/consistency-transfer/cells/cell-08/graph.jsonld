    {
      "@id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:9339:9635:sha256-592349e8a5a39353c0aebb3e441e34d63c0446f4f562626c9d2e53e6c6c0f942",
      "@type": "rkaf:SourceFragment",

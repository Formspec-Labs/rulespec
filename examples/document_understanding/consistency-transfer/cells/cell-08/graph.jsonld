      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:states-requirement",
      "rkaf:assertsValue": {
        "@value": "In a case where a worker is injured or becomes ill on a Friday, reports to work on a Monday, and was not scheduled to work on the weekend, you need to record the case only if you receive information from a physician or other licensed health care professional indicating that the employee should not have worked, or should have performed only restricted work, during the weekend; if so, you must record the injury or illness as a case with days away from work or restricted work, and enter the day counts, as appropriate.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

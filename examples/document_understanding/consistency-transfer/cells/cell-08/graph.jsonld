    {
      "@id": "urn:rulespec:document-understanding:revision:63b4f704dc9db61e1713b5a1e977a750d30f13352aa1cef65688322b4f2689a1",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:63b4f704dc9db61e1713b5a1e977a750d30f13352aa1cef65688322b4f2689a1",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:3119706d29b96af96754a7bd02e7620aa948f9743f0c19ff794790120aba452b",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"you\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:fcb78ddd5d26c001356616464fb32c842186129b2d257af60b657a984d57fe5d\",\"urn:rulespec:document-understanding:assertion:7af2f88e3424a69dc4d3b2d33fb35e00aa3f31b36730fcf288d38366c6cbd4db\",\"urn:rulespec:document-understanding:assertion:165c137a34962ae46076580700428426ac24ad96740af0cfa1e6b922d9b5dabf\",\"urn:rulespec:document-understanding:assertion:88fdfe590d296d5a04d0d7173cb1f2ed5e00b8eb13c8828ba42b9101c227fd70\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":6272,\"evidence\":[{\"end\":6272,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:5715:6272:sha256-2bdc79354d7f997a678e9c02acb9f70fae948f306b2bb251b2239ed0de1e4d5c\",\"quote\":\"(viii) May I stop counting days if an employee who is away from work because of an injury or illness retires or leaves my company? Yes, if the employee leaves your company for some reason unrelated to the injury or illness, such as retirement, a plant closing, or to take another job, you may stop counting days away from work or days of restriction/job transfer. If the employee leaves your company because of the injury or illness, you must estimate the total number of days away or days of restriction/job transfer and enter the day count on the 300 Log.\",\"start\":5715}],\"id\":\"urn:rulespec:document-understanding:revision:63b4f704dc9db61e1713b5a1e977a750d30f13352aa1cef65688322b4f2689a1\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:88fdfe590d296d5a04d0d7173cb1f2ed5e00b8eb13c8828ba42b9101c227fd70\",\"modality\":\"must\",\"modality_quote\":\"\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:eeef0e5520e7691db6ad2097ce54bbfb6d65bde74f21f6f2162e1f027ab0e558\",\"origin\":\"aiSuggested\",\"quote\":\"(viii) May I stop counting days if an employee who is away from work because of an injury or illness retires or leaves my company? Yes, if the employee leaves your company for some reason unrelated to the injury or illness, such as retirement, a plant closing, or to take another job, you may stop counting days away from work or days of restriction/job transfer. If the employee leaves your company because of the injury or illness, you must estimate the total number of days away or days of restriction/job transfer and enter the day count on the 300 Log.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:457cf55c03a01792320f30ae5b1eaca9a51ca4a556311e59a69a9b02497bfed2\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":5715,\"summary\":\"If an employee leaves your company because of the injury or illness, you must estimate the total number of days away or days of restriction/job transfer and enter the day count on the 300 Log.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",
      "dcterms:references": [

    {
      "@id": "urn:rulespec:document-understanding:revision:e02763bdd6c171375a10be25d46feb95ec839a4ae87efdc2023362996eca0adc",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:e02763bdd6c171375a10be25d46feb95ec839a4ae87efdc2023362996eca0adc",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:aab91f87daa762f2fefa63943220168d01b40f2355eae07df8bca1fd4e14d3f7",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:14c1cab6bb7fc3e83c5f02c0164d2476f1ca4c35596e470d1ee13f41016ca855\",\"urn:rulespec:document-understanding:assertion:4e68c2b183977e98a95e5ef21cf6228b25c478454aa92061a5836870be3ab71b\",\"urn:rulespec:document-understanding:assertion:f5f985782b24fe045a982f7f9f9253681ff26ab911e97113f06632e6f99ef0fa\",\"urn:rulespec:document-understanding:assertion:71352c845c9ccb18ac23f17ea1575f6c75f21c64dca1c0ba43115f6fba4b114c\",\"urn:rulespec:document-understanding:assertion:a7cebcb55fa13c30bc680f66de20198875bff6f95657fdaef43cc18af82eb3fa\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":16927,\"evidence\":[{\"end\":16927,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:16277:16927:sha256-bc6d8b0e37a0c12f8840e44a8e6511203a694b341f2a8e43054f36e0287d3ae4\",\"quote\":\"(iv) Does the professional status of the person providing the treatment have any effect on what is considered first aid or medical treatment? No, OSHA considers the treatments listed in § 1904.7(b)(5)(ii) of this part to be first aid regardless of the professional status of the person providing the treatment. Even when these treatments are provided by a physician or other licensed health care professional, they are considered first aid for the purposes of part 1904. Similarly, OSHA considers treatment beyond first aid to be medical treatment even when it is provided by someone other than a physician or other licensed health care professional.\",\"start\":16277}],\"id\":\"urn:rulespec:document-understanding:revision:e02763bdd6c171375a10be25d46feb95ec839a4ae87efdc2023362996eca0adc\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"statement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:f5f985782b24fe045a982f7f9f9253681ff26ab911e97113f06632e6f99ef0fa\",\"modality\":\"not_stated\",\"modality_quote\":\"\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:8380e715929d8e63de1aff9396a0fe8bb659425a8e5b02dd339f9deb816da738\",\"origin\":\"aiSuggested\",\"quote\":\"(iv) Does the professional status of the person providing the treatment have any effect on what is considered first aid or medical treatment? No, OSHA considers the treatments listed in § 1904.7(b)(5)(ii) of this part to be first aid regardless of the professional status of the person providing the treatment. Even when these treatments are provided by a physician or other licensed health care professional, they are considered first aid for the purposes of part 1904. Similarly, OSHA considers treatment beyond first aid to be medical treatment even when it is provided by someone other than a physician or other licensed health care professional.\",\"references\":[\"part 1904\",\"§ 1904.7(b)(5)(ii)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:db871d3575584d8cadb56d06d3a6ac5e18f49237c2ca9b2110dbf23d30611c55\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":16277,\"summary\":\"OSHA considers the treatments listed in § 1904.7(b)(5)(ii) to be first aid regardless of the professional status of the person providing the treatment, even when provided by a physician or other licensed health care professional; similarly, OSHA considers treatment beyond first aid to be medical treatment even when provided by someone other than a physician or other licensed health care professional.\",\"target_ids\":[],\"term_refs\":[\"urn:rulespec:document-understanding:term:b68f8fca12ed8b901b797b0a443bdd6b162b9e0f0a34d4e845cba55840034c0e\",\"urn:rulespec:document-understanding:term:699afc599efce20448012df8aefeddd76455fe2bf6fa86414f457ea98d9f0dcf\"],\"typed_values\":[]}",

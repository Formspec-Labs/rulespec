      "dcterms:description": "{\"action\":\"\",\"actor\":\"you\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:f6aff116e6565eee3a574938eee4672cbbe6d2025ab1f262e8ab00f47abe3867\",\"urn:rulespec:document-understanding:assertion:c99e4978249430dcfd2e1fb42144c5e299ae53f0a658f3df54d169f80a686bc3\",\"urn:rulespec:document-understanding:assertion:9354d7d8b641824cb2691622048adfd0807e380ee1a2e1f3d3272107496fdb71\",\"urn:rulespec:document-understanding:assertion:22f4da1b56c03599351627b76034f0fd1a2f13781e79c2ec54476b88f694998a\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":8558,\"evidence\":[{\"end\":8558,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:8185:8558:sha256-f690593bfb01e6bc3278f5dc864aa5e2ba39fad9dfa68f237b75471c8eceda3e\",\"quote\":\"(iii) Do I have to record restricted work or job transfer if it applies only to the day on which the injury occurred or the illness began? No, you do not have to record restricted work or job transfers if you, or the physician or other licensed health care professional, impose the restriction or transfer only for the day on which the injury occurred or the illness began.\",\"start\":8185}],\"id\":\"urn:rulespec:document-understanding:revision:2e5cc2d1fec37ef02806c2430772b29a6b38fe10c410b854f6bceff20e30e782\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"exemption\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:22f4da1b56c03599351627b76034f0fd1a2f13781e79c2ec54476b88f694998a\",\"modality\":\"not_required\",\"modality_quote\":\"\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:a0fadead80e9828f3bdbfada0875a5de407740f412a65418644edd316d06293e\",\"origin\":\"aiSuggested\",\"quote\":\"(iii) Do I have to record restricted work or job transfer if it applies only to the day on which the injury occurred or the illness began? No, you do not have to record restricted work or job transfers if you, or the physician or other licensed health care professional, impose the restriction or transfer only for the day on which the injury occurred or the illness began.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:16cc7d80d2f1fb0868eb702b6478d20df3076f5df1191da2201164e82f4159db\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":8185,\"summary\":\"You do not have to record restricted work or job transfers if you, or the physician or other licensed health care professional, impose the restriction or transfer only for the day on which the injury occurred or the illness began.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

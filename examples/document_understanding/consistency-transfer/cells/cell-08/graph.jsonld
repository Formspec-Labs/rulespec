      "dcterms:description": "{\"action\":\"\",\"actor\":\"you\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:701bb74c0d5cfb7193c5567675aae9144a119f2ccd1733e9a3ebe94c40fc0ab8\",\"urn:rulespec:document-understanding:assertion:a75f5dc15404ea8e6a28dd263e0c63585d2eff84e71471a2d5c7374cbb55f418\",\"urn:rulespec:document-understanding:assertion:91d737a91074ab2e9ada7bfa7209c02fcf8279445961859d3619ecec2f0ec4b5\",\"urn:rulespec:document-understanding:assertion:bd12ae5775c9f6bea9351506ab07bd2dc75a890cf3bf192dfbc845be225f5bfc\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":4701,\"evidence\":[{\"end\":4701,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:4157:4701:sha256-881d216077e05b8bbc11156fcc0ad5fd294dc3d360300b091d93339c09e16b46\",\"quote\":\"(v) How do I record a case in which a worker is injured or becomes ill on a Friday and reports to work on a Monday, and was not scheduled to work on the weekend? You need to record this case only if you receive information from a physician or other licensed health care professional indicating that the employee should not have worked, or should have performed only restricted work, during the weekend. If so, you must record the injury or illness as a case with days away from work or restricted work, and enter the day counts, as appropriate.\",\"start\":4157}],\"id\":\"urn:rulespec:document-understanding:revision:e55b4e46986d7720ebcd3a92cc5cd300c9a4d8a7dc9b2014d1e64d3fa34ceeea\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:bd12ae5775c9f6bea9351506ab07bd2dc75a890cf3bf192dfbc845be225f5bfc\",\"modality\":\"must\",\"modality_quote\":\"\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:05b736fba46e6f1bb74dd15c00d8321c588b8eeb5c12519b222c2552c349abe3\",\"origin\":\"aiSuggested\",\"quote\":\"(v) How do I record a case in which a worker is injured or becomes ill on a Friday and reports to work on a Monday, and was not scheduled to work on the weekend? You need to record this case only if you receive information from a physician or other licensed health care professional indicating that the employee should not have worked, or should have performed only restricted work, during the weekend. If so, you must record the injury or illness as a case with days away from work or restricted work, and enter the day counts, as appropriate.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:4d22efde57d8747b3e40f932da60b6077b20949e0ba05a77104929e6d19bfa4d\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":4157,\"summary\":\"In a case where a worker is injured or becomes ill on a Friday, reports to work on a Monday, and was not scheduled to work on the weekend, you need to record the case only if you receive information from a physician or other licensed health care professional indicating that the employee should not have worked, or should have performed only restricted work, during the weekend; if so, you must record the injury or illness as a case with days away from work or restricted work, and enter the day counts, as appropriate.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",
      "dcterms:references": [
        {
          "@id": "urn:rulespec:document-understanding:assertion:701bb74c0d5cfb7193c5567675aae9144a119f2ccd1733e9a3ebe94c40fc0ab8"

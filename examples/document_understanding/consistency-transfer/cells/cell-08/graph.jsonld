      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:a3aa87054f95db21db903e5b754b09a80cbb0154ff67788dfef3f013592dac7e\",\"urn:rulespec:document-understanding:assertion:849e5c0a522b6a775f309ec695e4f3ed0f125ee88ab71777a764f37374896a4b\",\"urn:rulespec:document-understanding:assertion:dd5b7df491792b197b119734e196546311e07f5b195b188fc4eebb1ac3e9fa42\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":9635,\"evidence\":[{\"end\":9635,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:9339:9635:sha256-592349e8a5a39353c0aebb3e441e34d63c0446f4f562626c9d2e53e6c6c0f942\",\"quote\":\"(v) How do I record a case where the worker works only for a partial work shift because of a work-related injury or illness? A partial day of work is recorded as a day of job transfer or restriction for recordkeeping purposes, except for the day on which the injury occurred or the illness began.\",\"start\":9339}],\"id\":\"urn:rulespec:document-understanding:revision:e3ba1dfd0258233cee26249c8f3164ec0e76a0de4aabdb8eb29d1d547f40ddc1\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"statement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:dd5b7df491792b197b119734e196546311e07f5b195b188fc4eebb1ac3e9fa42\",\"modality\":\"not_stated\",\"modality_quote\":\"\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:0125203e0eb72ffd2dae6072150e7a276d913ead35fa49fd6d99b393acf42996\",\"origin\":\"aiSuggested\",\"quote\":\"(v) How do I record a case where the worker works only for a partial work shift because of a work-related injury or illness? A partial day of work is recorded as a day of job transfer or restriction for recordkeeping purposes, except for the day on which the injury occurred or the illness began.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:ddcbe251ac422e2d732d658551b020e95242a5f8cbcf380485d1c3d02eb3f869\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":9339,\"summary\":\"A partial day of work is recorded as a day of job transfer or restriction for recordkeeping purposes, except for the day on which the injury occurred or the illness began.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",
      "dcterms:references": [

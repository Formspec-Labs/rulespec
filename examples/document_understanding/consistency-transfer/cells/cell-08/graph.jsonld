    {
      "@id": "urn:rulespec:document-understanding:revision:ae9a5d090e6e9688b3812c546f521b0f1b5c03eab67b1f62c2774a5c15592481",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:ae9a5d090e6e9688b3812c546f521b0f1b5c03eab67b1f62c2774a5c15592481",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:e81de46c7d0e8440823274e14de1b65aaf13ce46fca8f414912931a758d0e657",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"You\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:9dd78921e5bca6ac2fc689c8ba4c40fc6aad4e696d204d3a2f6cfc01d760b1de\",\"urn:rulespec:document-understanding:assertion:06239b714b0a58bac077556c3b191b2e13644cf76e8cf6f2eb7b11d4e4543fd1\",\"urn:rulespec:document-understanding:assertion:e1ba1f8e725488b194796991ce41ba1d35e2d9637d71940a23e16827f9a7e946\",\"urn:rulespec:document-understanding:assertion:6a69aac0c9f3b150f4ea7955b6238f45400ecb16f1bcfa33b2d131e71c5fd407\",\"urn:rulespec:document-understanding:assertion:771a08b390c0d9a83c1a4cd3a3be37039a4d911a618cb5eeaef5417fc87692ff\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":11707,\"evidence\":[{\"end\":11707,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:11029:11707:sha256-82bebb5231df794011ca6d0c318abf397b52f3e725f4857f1229ff7bb34f1144\",\"quote\":\"(viii) What do I do if a physician or other licensed health care professional recommends a job restriction meeting OSHA's definition, but the employee does all of his or her routine job functions anyway? You must record the injury or illness on the OSHA 300 Log as a restricted work case. If a physician or other licensed health care professional recommends a job restriction, you should ensure that the employee complies with that restriction. If you receive recommendations from two or more physicians or other licensed health care professionals, you may make a decision as to which recommendation is the most authoritative, and record the case based upon that recommendation.\",\"start\":11029},{\"end\":11236,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:11233:11236:sha256-08b041935798fbf6fd6ff51099ffedb140a475889986d14f5559ff8e7fc571dd\",\"quote\":\"You\",\"start\":11233}],\"id\":\"urn:rulespec:document-understanding:revision:ae9a5d090e6e9688b3812c546f521b0f1b5c03eab67b1f62c2774a5c15592481\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:6a69aac0c9f3b150f4ea7955b6238f45400ecb16f1bcfa33b2d131e71c5fd407\",\"modality\":\"must\",\"modality_quote\":\"\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:5da87b8d2456cbc979792d6e6355f851d8df1867925be5b219ebd3268a8b433f\",\"origin\":\"aiSuggested\",\"quote\":\"(viii) What do I do if a physician or other licensed health care professional recommends a job restriction meeting OSHA's definition, but the employee does all of his or her routine job functions anyway? You must record the injury or illness on the OSHA 300 Log as a restricted work case. If a physician or other licensed health care professional recommends a job restriction, you should ensure that the employee complies with that restriction. If you receive recommendations from two or more physicians or other licensed health care professionals, you may make a decision as to which recommendation is the most authoritative, and record the case based upon that recommendation.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:6e81e2fd97aa249ccd9677433b9bf947320adbc72c2c955a2bb2d2a184d708f3\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":11029,\"summary\":\"If a physician or other licensed health care professional recommends a job restriction meeting OSHA's definition, but the employee does all of his or her routine job functions anyway, you must record the injury or illness on the OSHA 300 Log as a restricted work case.\",\"target_ids\":[],\"term_refs\":[\"urn:rulespec:document-understanding:term:f6d88742f4dc880b89095112b6aef77b21e00cc28f4c097134e6e30edd0330df\"],\"typed_values\":[]}",

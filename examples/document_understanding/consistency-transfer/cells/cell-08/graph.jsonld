      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:78afa3d0c2b3b39071a85989e741f33c467d224f0866ebc5d4d69ca592cda2a9",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:states-requirement",
      "rkaf:assertsValue": {
        "@value": "You must consider an injury or illness to meet the general recording criteria, and therefore to be recordable, if it results in any of the following: death, days away from work, restricted work or transfer to another job, medical treatment beyond first aid, or loss of consciousness.",

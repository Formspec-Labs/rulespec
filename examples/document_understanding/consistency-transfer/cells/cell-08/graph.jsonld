      "rkaf:hasContentDigest": "sha256:7204cf98b6d0842a53f9f8a3d74561c40cc01f01ca6e2cd44d344c7bcfe94235",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:5b499af63a334d66fcaf08ef262410a97d88831f62963ed72fce79d349303758\",\"urn:rulespec:document-understanding:assertion:65549ff5a55b5d4548f062e71995a08d766caecd31367e58d39ecf1afeb31325\",\"urn:rulespec:document-understanding:assertion:ef99f94f108b47284c7259022d5ae7284f1e2618fcc6f7e65f9c21e84acc5416\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":18168,\"evidence\":[{\"end\":18168,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:17660:18168:sha256-9cd92b9f298eed2a9b77c484a7aec3c669177e35b06cef90bf6bfbcb03ac13ea\",\"quote\":\"(7) What is a “significant” diagnosed injury or illness that is recordable under the general criteria even if it does not result in death, days away from work, restricted work or job transfer, medical treatment beyond first aid, or loss of consciousness? Work-related cases involving cancer, chronic irreversible disease, a fractured or cracked bone, or a punctured eardrum must always be recorded under the general criteria at the time of diagnosis by a physician or other licensed health care professional.\",\"start\":17660}],\"id\":\"urn:rulespec:document-understanding:revision:a0b23c6bc222c8e69c7f1dd55606e4e9927aa0d2e0cac26fcad9a0daa8954a29\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:ef99f94f108b47284c7259022d5ae7284f1e2618fcc6f7e65f9c21e84acc5416\",\"modality\":\"must\",\"modality_quote\":\"\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:2e7eb1453bab9a63b5816cf9e0ab97b029ebd0d2f6f5b288943d97511f5d6564\",\"origin\":\"aiSuggested\",\"quote\":\"(7) What is a “significant” diagnosed injury or illness that is recordable under the general criteria even if it does not result in death, days away from work, restricted work or job transfer, medical treatment beyond first aid, or loss of consciousness? Work-related cases involving cancer, chronic irreversible disease, a fractured or cracked bone, or a punctured eardrum must always be recorded under the general criteria at the time of diagnosis by a physician or other licensed health care professional.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:6c84eec60cddbee0737dfd0c3f778811a82e738a89f0131a8f2e8d5166f4cb37\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":17660,\"summary\":\"Work-related cases involving cancer, chronic irreversible disease, a fractured or cracked bone, or a punctured eardrum must always be recorded under the general criteria at the time of diagnosis by a physician or other licensed health care professional, even if they do not result in death, days away from work, restricted work or job transfer, medical treatment beyond first aid, or loss of consciousness.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",
      "dcterms:references": [
        {
          "@id": "urn:rulespec:document-understanding:assertion:5b499af63a334d66fcaf08ef262410a97d88831f62963ed72fce79d349303758"
        },

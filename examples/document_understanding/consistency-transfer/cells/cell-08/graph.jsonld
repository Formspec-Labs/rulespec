    {
      "@id": "urn:rulespec:document-understanding:revision:44911447f3595c588f65d216c7178056978358dce7cc4f4a4dedfc0adb59b09e",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:44911447f3595c588f65d216c7178056978358dce7cc4f4a4dedfc0adb59b09e",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:070c9a98d2eb07224b0728fb209482476d3a305eb0e27d82854bd98f3cf69f30",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"you\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:021968eec825b40f7e5b93a2a4a711f900030b3f557bbffd31b1cf329c6e0f63\",\"urn:rulespec:document-understanding:assertion:56524a3c818983190f1ad3e0b83ebea058b73c4b6a19411fb8d1c970d5ceacd0\",\"urn:rulespec:document-understanding:assertion:ddd77a2a1c022f3e2620bf979ae5ce86570293a8e2810159eb8e1f33aca3cf0a\",\"urn:rulespec:document-understanding:assertion:d11fe501316d1970a1855abb776a2158650f7095e7d2ab01f199e365980302c6\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":3299,\"evidence\":[{\"end\":3299,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:2343:3299:sha256-69f39fbb70f07e7dda79d0b899982b359ac723ad82b990b47ff61feba46ddace\",\"quote\":\"(ii) How do I record an injury or illness when a physician or other licensed health care professional recommends that the worker stay at home but the employee comes to work anyway? You must record these injuries and illnesses on the OSHA 300 Log using the check box for cases with days away from work and enter the number of calendar days away recommended by the physician or other licensed health care professional. If a physician or other licensed health care professional recommends days away, you should encourage your employee to follow that recommendation. However, the days away must be recorded whether the injured or ill employee follows the physician or licensed health care professional's recommendation or not. If you receive recommendations from two or more physicians or other licensed health care professionals, you may make a decision as to which recommendation is the most authoritative, and record the case based upon that recommendation.\",\"start\":2343}],\"id\":\"urn:rulespec:document-understanding:revision:44911447f3595c588f65d216c7178056978358dce7cc4f4a4dedfc0adb59b09e\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"permission\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:d11fe501316d1970a1855abb776a2158650f7095e7d2ab01f199e365980302c6\",\"modality\":\"may\",\"modality_quote\":\"\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:0cec1e51dc396d5b19ce0b01d01e054d8ac1ed5eb09227132a5881cbf4d433ff\",\"origin\":\"aiSuggested\",\"quote\":\"(ii) How do I record an injury or illness when a physician or other licensed health care professional recommends that the worker stay at home but the employee comes to work anyway? You must record these injuries and illnesses on the OSHA 300 Log using the check box for cases with days away from work and enter the number of calendar days away recommended by the physician or other licensed health care professional. If a physician or other licensed health care professional recommends days away, you should encourage your employee to follow that recommendation. However, the days away must be recorded whether the injured or ill employee follows the physician or licensed health care professional's recommendation or not. If you receive recommendations from two or more physicians or other licensed health care professionals, you may make a decision as to which recommendation is the most authoritative, and record the case based upon that recommendation.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:8b09c42a1eef96d7c4d20a9db2a7ca95f5d31e5dab36765d438fbca745fed7aa\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":2343,\"summary\":\"If you receive recommendations from two or more physicians or other licensed health care professionals, you may make a decision as to which recommendation is the most authoritative, and record the case based upon that recommendation.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",
      "dcterms:references": [

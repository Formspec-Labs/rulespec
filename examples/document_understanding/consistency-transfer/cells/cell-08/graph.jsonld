      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:9e2fd6670649627124022d2f90536d3633fac256410506163363cb57cd304928\",\"urn:rulespec:document-understanding:assertion:c119e217226b77d99044e804a97353142ef8d1c64496622e492ef54ceb36f7bb\",\"urn:rulespec:document-understanding:assertion:ca81b9b49c8f84ef74cb2f0e759b9a169cb33909a6f0bf77f12ce193bef39227\",\"urn:rulespec:document-understanding:assertion:2aaacb0be773905ca9a2483f354139263f5e89d7b790a2532fa1aade59fe7c8b\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":10090,\"evidence\":[{\"end\":10090,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:9637:10090:sha256-44db200cea7050544c81a40476a2ea32d1f66f4846c90b0b96341111b456b040\",\"quote\":\"(vi) If the injured or ill worker produces fewer goods or services than he or she would have produced prior to the injury or illness but otherwise performs all of the routine functions of his or her work, is the case considered a restricted work case? No, the case is considered restricted work only if the worker does not perform all of the routine functions of his or her job or does not work the full shift that he or she would otherwise have worked.\",\"start\":9637}],\"id\":\"urn:rulespec:document-understanding:revision:d6e7e6e784ba99dc2f1b7d2d1118fb58915fed6dee43aa88b31a8c849bbc9222\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"statement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:ca81b9b49c8f84ef74cb2f0e759b9a169cb33909a6f0bf77f12ce193bef39227\",\"modality\":\"not_stated\",\"modality_quote\":\"\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:33d41bf14dc23b1be86c831a0a8d376dd5b3bb3377725699a0667386086a41de\",\"origin\":\"aiSuggested\",\"quote\":\"(vi) If the injured or ill worker produces fewer goods or services than he or she would have produced prior to the injury or illness but otherwise performs all of the routine functions of his or her work, is the case considered a restricted work case? No, the case is considered restricted work only if the worker does not perform all of the routine functions of his or her job or does not work the full shift that he or she would otherwise have worked.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:b470fe5961d49090dc80a96e5caf86a35d12d3ef068e77b56151954229549868\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":9637,\"summary\":\"If an injured or ill worker produces fewer goods or services than he or she would have produced prior to the injury or illness but otherwise performs all of the routine functions of his or her work, the case is not considered a restricted work case; the case is considered restricted work only if the worker does not perform all of the routine functions of his or her job or does not work the full shift that he or she would otherwise have worked.\",\"target_ids\":[],\"term_refs\":[\"urn:rulespec:document-understanding:term:f6d88742f4dc880b89095112b6aef77b21e00cc28f4c097134e6e30edd0330df\"],\"typed_values\":[]}",

    {
      "@id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:13184:13702:sha256-f281ea0cbf0a061f637ea5c08f88615fdee014a2cb60eb32ce82eb1fbb544213",
      "@type": "rkaf:SourceFragment",
      "oa:hasSource": "urn:rulespec:document-understanding:document:4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493",
      "rkaf:fragmentIdentityScheme": "rkaf:carrier-local-fragment",
      "rkaf:sourceArtifactDigest": "sha256:4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493",
      "rkaf:fragmentContentDigest": "sha256:f281ea0cbf0a061f637ea5c08f88615fdee014a2cb60eb32ce82eb1fbb544213",
      "rkaf:selectorKind": [
        "oa:TextQuoteSelector",
        "oa:TextPositionSelector"
      ],
      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "(5) How do I record an injury or illness that involves medical treatment beyond first aid? If a work-related injury or illness results in medical treatment beyond first aid, you must record it on the OSHA 300 Log. If the injury or illness did not involve death, one or more days away from work, one or more days of restricted work, or one or more days of job transfer, you enter a check mark in the box for cases where the employee received medical treatment but remained at work and was not transferred or restricted."
        },
        {
          "@type": "oa:TextPositionSelector",
          "oa:start": 13184,
          "oa:end": 13702,
          "rkaf:coordinateSystem": "rkaf:unicode-codepoint"
        }
      ]
    },

      "rkaf:assertsValue": {
        "@value": "A work-related injury or illness must be recorded if it results in one or more of the following: death; days away from work; restricted work or transfer to another job; medical treatment beyond first aid; loss of consciousness; or a significant injury or illness diagnosed by a physician or other licensed health care professional.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

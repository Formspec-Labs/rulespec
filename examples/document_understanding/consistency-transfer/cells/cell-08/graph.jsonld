      "rkaf:assertsValue": {
        "@value": "{\"kind\":\"statement\",\"modality\":\"not_stated\",\"summary\":\"Weekend days, holidays, vacation days or other days off are included in the total number of days recorded if the employee would not have been able to work on those days because of a work-related injury or illness.\"}",
        "@type": "xsd:string"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

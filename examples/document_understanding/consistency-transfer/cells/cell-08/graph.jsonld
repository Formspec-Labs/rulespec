    },
    {
      "@id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:4703:5284:sha256-d5f851bfe2727d08e044f3b21f9fe892c8dbe0ce8d556de05370a648a9c00384",
      "@type": "rkaf:SourceFragment",
      "oa:hasSource": "urn:rulespec:document-understanding:document:4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493",
      "rkaf:fragmentIdentityScheme": "rkaf:carrier-local-fragment",
      "rkaf:sourceArtifactDigest": "sha256:4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493",
      "rkaf:fragmentContentDigest": "sha256:d5f851bfe2727d08e044f3b21f9fe892c8dbe0ce8d556de05370a648a9c00384",
      "rkaf:selectorKind": [
        "oa:TextQuoteSelector",
        "oa:TextPositionSelector"
      ],
      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "(vi) How do I record a case in which a worker is injured or becomes ill on the day before scheduled time off such as a holiday, a planned vacation, or a temporary plant closing? You need to record a case of this type only if you receive information from a physician or other licensed health care professional indicating that the employee should not have worked, or should have performed only restricted work, during the scheduled time off. If so, you must record the injury or illness as a case with days away from work or restricted work, and enter the day counts, as appropriate."
        },
        {
          "@type": "oa:TextPositionSelector",
          "oa:start": 4703,
          "oa:end": 5284,
          "rkaf:coordinateSystem": "rkaf:unicode-codepoint"
        }
      ]
    },

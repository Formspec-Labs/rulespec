      "rkaf:fragmentContentDigest": "sha256:7ad2e469bb2a039f299d2420ba287ea41943979639aa6ccf57f5daa00ab9b9c9",
      "rkaf:selectorKind": [
        "oa:TextQuoteSelector",
        "oa:TextPositionSelector"
      ],
      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "(4) How do I record a work-related injury or illness that results in restricted work or job transfer? When an injury or illness involves restricted work or job transfer but does not involve death or days away from work, you must record the injury or illness on the OSHA 300 Log by placing a check mark in the space for job transfer or restriction and an entry of the number of restricted or transferred days in the restricted workdays column."
        },
        {
          "@type": "oa:TextPositionSelector",
          "oa:start": 6959,
          "oa:end": 7401,
          "rkaf:coordinateSystem": "rkaf:unicode-codepoint"
        }
      ]
    },

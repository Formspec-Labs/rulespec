      "rkaf:assertsValue": {
        "@value": "{\"kind\":\"requirement\",\"modality\":\"must\",\"summary\":\"If you inquire about a vague restriction and the answer to one or both questions (regarding doing all routine job functions and working the full shift) is 'No', the case involves restricted work and must be recorded as a restricted work case.\"}",
        "@type": "xsd:string"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

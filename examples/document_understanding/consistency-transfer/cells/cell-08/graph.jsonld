    {
      "@id": "urn:rulespec:document-understanding:revision:98389f2f14d25dd5f25a930e915fe68c825bfacbfc488953fd28be056ca2683f",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:98389f2f14d25dd5f25a930e915fe68c825bfacbfc488953fd28be056ca2683f",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:1c0f0414baaef128628c2146b4728f850ea511ce79406adb41f527fe7572b263",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:0e55a607c1e853b227be5456c9a1cc293143e48d2b87c795936cb94672c79ab3\",\"urn:rulespec:document-understanding:assertion:f4a4688348224cf90dfea87d406bd5d6213da271be2224a8f201cf29046fcda6\",\"urn:rulespec:document-understanding:assertion:7870151df380855115141032812e73826dcfa9cd8d94a44f97abe8e6cfdb9f8b\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":11027,\"evidence\":[{\"end\":11027,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:10092:11027:sha256-15cb9ba69bb8a7fa51d03cef433e216c9fea8a9dc2afc740cbbc368f695938bc\",\"quote\":\"(vii) How do I handle vague restrictions from a physician or other licensed health care professional, such as that the employee engage only in “light duty” or “take it easy for a week”? If you are not clear about the physician or other licensed health care professional's recommendation, you may ask that person whether the employee can do all of his or her routine job functions and work all of his or her normally assigned work shift. If the answer to both of these questions is “Yes,” then the case does not involve a work restriction and does not have to be recorded as such. If the answer to one or both of these questions is “No,” the case involves restricted work and must be recorded as a restricted work case. If you are unable to obtain this additional information from the physician or other licensed health care professional who recommended the restriction, record the injury or illness as a case involving restricted work.\",\"start\":10092}],\"id\":\"urn:rulespec:document-understanding:revision:98389f2f14d25dd5f25a930e915fe68c825bfacbfc488953fd28be056ca2683f\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:7870151df380855115141032812e73826dcfa9cd8d94a44f97abe8e6cfdb9f8b\",\"modality\":\"must\",\"modality_quote\":\"\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:976329df1319ce7e2d0e79dd6674e3592edffbb4adc95feaebb331e18e427f99\",\"origin\":\"aiSuggested\",\"quote\":\"(vii) How do I handle vague restrictions from a physician or other licensed health care professional, such as that the employee engage only in “light duty” or “take it easy for a week”? If you are not clear about the physician or other licensed health care professional's recommendation, you may ask that person whether the employee can do all of his or her routine job functions and work all of his or her normally assigned work shift. If the answer to both of these questions is “Yes,” then the case does not involve a work restriction and does not have to be recorded as such. If the answer to one or both of these questions is “No,” the case involves restricted work and must be recorded as a restricted work case. If you are unable to obtain this additional information from the physician or other licensed health care professional who recommended the restriction, record the injury or illness as a case involving restricted work.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:dc03d88058c5b5053439a2d04186d1285d3210f9f8512a9044730de74033bb0e\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":10092,\"summary\":\"If you inquire about a vague restriction and the answer to one or both questions (regarding doing all routine job functions and working the full shift) is 'No', the case involves restricted work and must be recorded as a restricted work case.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

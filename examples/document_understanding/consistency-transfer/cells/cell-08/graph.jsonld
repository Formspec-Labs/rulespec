      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"You\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:ae4e263fad524b4fbe6bae78f30c0a397caa8b750c65faae3028cb0ebc110704\",\"urn:rulespec:document-understanding:assertion:35d34cbd773a8370929914ad70e5827b585123daad13b331afbfd1bed4e16423\",\"urn:rulespec:document-understanding:assertion:ff739adb95e475ad220b0935d5402c8ba21fb6cccee0c3ad907f398f601bbedc\",\"urn:rulespec:document-understanding:assertion:4b8eae69f0f7329692b5492b7ce0c92d904bfa68c7212be750ef7aaa51e434f6\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":5713,\"evidence\":[{\"end\":5713,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:5286:5713:sha256-4649cc6490410d90b433bb6f2b05bb96cba22bcfa486e18ab71cf2806975a6e2\",\"quote\":\"(vii) Is there a limit to the number of days away from work I must count? Yes, you may “cap” the total days away at 180 calendar days. You are not required to keep track of the number of calendar days away from work if the injury or illness resulted in more than 180 calendar days away from work and/or days of job transfer or restriction. In such a case, entering 180 in the total days away column will be considered adequate.\",\"start\":5286},{\"end\":5424,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:5421:5424:sha256-08b041935798fbf6fd6ff51099ffedb140a475889986d14f5559ff8e7fc571dd\",\"quote\":\"You\",\"start\":5421}],\"id\":\"urn:rulespec:document-understanding:revision:0c5eb7bb8460ae7443ee47d1ea1ee89ef6d1b05f8e8c76c83d15b3f8d59cb87c\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"exemption\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:4b8eae69f0f7329692b5492b7ce0c92d904bfa68c7212be750ef7aaa51e434f6\",\"modality\":\"not_required\",\"modality_quote\":\"\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:6974c6a4c3abdeb42d1ba6478455a8aa5e8a7947e21cdccc55280b4128e398c3\",\"origin\":\"aiSuggested\",\"quote\":\"(vii) Is there a limit to the number of days away from work I must count? Yes, you may “cap” the total days away at 180 calendar days. You are not required to keep track of the number of calendar days away from work if the injury or illness resulted in more than 180 calendar days away from work and/or days of job transfer or restriction. In such a case, entering 180 in the total days away column will be considered adequate.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:d7583d6086c9f804d1efaae2c2abc8f3c2e59a2bea7a08e5262a97a681535af1\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":5286,\"summary\":\"You are not required to keep track of the number of calendar days away from work if the injury or illness resulted in more than 180 calendar days away from work and/or days of job transfer or restriction, and in such a case, entering 180 in the total days away column will be considered adequate.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"you\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:a4b0b6122db4390f8fc60d508bd9cc947ec1e3079319c25469de8ad526b5aae6\",\"urn:rulespec:document-understanding:assertion:4df34688c59e8b40ddb4eb550a858febeb2959bafa05b8fc908454b453ead91b\",\"urn:rulespec:document-understanding:assertion:360044548471a21b12a502370f4a63d6101d80717be8247eb24057271835fbae\",\"urn:rulespec:document-understanding:assertion:a4cf17b3ea9a62d7b38896db8fe133d7ab2641cf4f73a7c6838edaad57decf0b\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":5284,\"evidence\":[{\"end\":5284,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:4703:5284:sha256-d5f851bfe2727d08e044f3b21f9fe892c8dbe0ce8d556de05370a648a9c00384\",\"quote\":\"(vi) How do I record a case in which a worker is injured or becomes ill on the day before scheduled time off such as a holiday, a planned vacation, or a temporary plant closing? You need to record a case of this type only if you receive information from a physician or other licensed health care professional indicating that the employee should not have worked, or should have performed only restricted work, during the scheduled time off. If so, you must record the injury or illness as a case with days away from work or restricted work, and enter the day counts, as appropriate.\",\"start\":4703}],\"id\":\"urn:rulespec:document-understanding:revision:65f25f9ceba11ac5d8523653228032159f488f03476cc605803c59f9a7298b43\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:a4cf17b3ea9a62d7b38896db8fe133d7ab2641cf4f73a7c6838edaad57decf0b\",\"modality\":\"must\",\"modality_quote\":\"\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:38e8c8246fc01f16d0ed88ef3b1a46fb45da0b7b3de340b465e4b8ab7f0a4a7f\",\"origin\":\"aiSuggested\",\"quote\":\"(vi) How do I record a case in which a worker is injured or becomes ill on the day before scheduled time off such as a holiday, a planned vacation, or a temporary plant closing? You need to record a case of this type only if you receive information from a physician or other licensed health care professional indicating that the employee should not have worked, or should have performed only restricted work, during the scheduled time off. If so, you must record the injury or illness as a case with days away from work or restricted work, and enter the day counts, as appropriate.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:244c604b713924252663b7d2288f6c7bbe8d7d72545b222c42b6e532df8f73be\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":4703,\"summary\":\"In a case where a worker is injured or becomes ill on the day before scheduled time off such as a holiday, a planned vacation, or a temporary plant closing, you need to record the case only if you receive information from a physician or other licensed health care professional indicating that the employee should not have worked, or should have performed only restricted work, during the scheduled time off; if so, you must record the injury or illness as a case with days away from work or restricted work, and enter the day counts, as appropriate.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

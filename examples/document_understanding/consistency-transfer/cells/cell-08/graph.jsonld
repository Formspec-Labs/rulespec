      "@id": "urn:rulespec:document-understanding:revision:dc8f6a20006870ff309b54f42dee7a2f98db4af8ddd8ae5439a5d64aa84d0379",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:dc8f6a20006870ff309b54f42dee7a2f98db4af8ddd8ae5439a5d64aa84d0379",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:96a61c2de0d8866162ceb630430677f6b68ea3d02041e32af85a1db3bf58e401",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:cd12176ec789712aeeb17329cffec12adaeba1b127c3b90b1c7aafa914981cfb\",\"urn:rulespec:document-understanding:assertion:889cc2fa5a1d77a21dc468c6f9934611c59ed0c2945e93fa7414a5105140cf9c\",\"urn:rulespec:document-understanding:assertion:4d3ac3fda618d66203d3ae50c4ad7ac0217239aa2de27d0e61113dc756cd9aa4\",\"urn:rulespec:document-understanding:assertion:9615197b4ba5470e3efc9ea3d017d6e34727ebe3d810c165a7bd0cf83505c8e6\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":7997,\"evidence\":[{\"end\":7997,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:7403:7997:sha256-63a7292a74988e98b53119231dc9dcaca05b4ca30229ffad64d38634bf647895\",\"quote\":\"(i) How do I decide if the injury or illness resulted in restricted work? Restricted work occurs when, as the result of a work-related injury or illness:\\n\\n(A) You keep the employee from performing one or more of the routine functions of his or her job, or from working the full workday that he or she would otherwise have been scheduled to work; or\\n\\n(B) A physician or other licensed health care professional recommends that the employee not perform one or more of the routine functions of his or her job, or not work the full workday that he or she would otherwise have been scheduled to work.\",\"start\":7403}],\"id\":\"urn:rulespec:document-understanding:revision:dc8f6a20006870ff309b54f42dee7a2f98db4af8ddd8ae5439a5d64aa84d0379\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"statement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:4d3ac3fda618d66203d3ae50c4ad7ac0217239aa2de27d0e61113dc756cd9aa4\",\"modality\":\"not_stated\",\"modality_quote\":\"\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:a9371c704278f3bbb7185c8b30a376c550259a851c0a8e01c1c271c111de99b3\",\"origin\":\"aiSuggested\",\"quote\":\"(i) How do I decide if the injury or illness resulted in restricted work? Restricted work occurs when, as the result of a work-related injury or illness:\\n\\n(A) You keep the employee from performing one or more of the routine functions of his or her job, or from working the full workday that he or she would otherwise have been scheduled to work; or\\n\\n(B) A physician or other licensed health care professional recommends that the employee not perform one or more of the routine functions of his or her job, or not work the full workday that he or she would otherwise have been scheduled to work.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:ea90b1b13d20756039916f2938074db3d7238f86fa3450dc684741bbc72e8437\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":7403,\"summary\":\"Restricted work occurs when, as the result of a work-related injury or illness, you keep the employee from performing one or more of the routine functions of his or her job, or from working the full workday that he or she would otherwise have been scheduled to work, or a physician or other licensed health care professional recommends that the employee not perform one or more of the routine functions of his or her job, or not work the full workday that he or she would otherwise have been scheduled to work.\",\"target_ids\":[],\"term_refs\":[\"urn:rulespec:document-understanding:term:f6d88742f4dc880b89095112b6aef77b21e00cc28f4c097134e6e30edd0330df\"],\"typed_values\":[]}",

    {
      "@id": "urn:rulespec:document-understanding:revision:0e24bea15a1b4cffb4c643a39eb436f7e73b88859719bdf068d66c5f42d3906c",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:0e24bea15a1b4cffb4c643a39eb436f7e73b88859719bdf068d66c5f42d3906c",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:75d800cc0e65e8cfc543bbdae6b0e68dc36688a03fea12eba1e5aa64f7fca0b5",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"You\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:44fff3030893556a94a2a0b65dc1cb237bf7e8df845193f8e0c016476cbcc41a\",\"urn:rulespec:document-understanding:assertion:aa10d2ed68956b20e1b6587aa3b57fc0fcb46e10650321cc5f7f2d8e98f4c2f2\",\"urn:rulespec:document-understanding:assertion:3c218d658402d7107fefa1da17779d019967180d45a4f6898bd09db1095d481f\",\"urn:rulespec:document-understanding:assertion:23c2de71d57ac53da7da88e5f2fdcb1fc47dff29a2e073d2648526c93768962b\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":683,\"evidence\":[{\"end\":683,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:39:683:sha256-df4f4518f36f37eb15e0493973c7f089ab3195194a14961a9f6dd3fe76b3fdf0\",\"quote\":\"(a) Basic requirement. You must consider an injury or illness to meet the general recording criteria, and therefore to be recordable, if it results in any of the following: death, days away from work, restricted work or transfer to another job, medical treatment beyond first aid, or loss of consciousness. You must also consider a case to meet the general recording criteria if it involves a significant injury or illness diagnosed by a physician or other licensed health care professional, even if it does not result in death, days away from work, restricted work or job transfer, medical treatment beyond first aid, or loss of consciousness.\",\"start\":39}],\"id\":\"urn:rulespec:document-understanding:revision:0e24bea15a1b4cffb4c643a39eb436f7e73b88859719bdf068d66c5f42d3906c\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:23c2de71d57ac53da7da88e5f2fdcb1fc47dff29a2e073d2648526c93768962b\",\"modality\":\"must\",\"modality_quote\":\"\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:9c842caa305d20c36218e56d77975328ae118d1d240131beadab103c0f42029e\",\"origin\":\"aiSuggested\",\"quote\":\"(a) Basic requirement. You must consider an injury or illness to meet the general recording criteria, and therefore to be recordable, if it results in any of the following: death, days away from work, restricted work or transfer to another job, medical treatment beyond first aid, or loss of consciousness. You must also consider a case to meet the general recording criteria if it involves a significant injury or illness diagnosed by a physician or other licensed health care professional, even if it does not result in death, days away from work, restricted work or job transfer, medical treatment beyond first aid, or loss of consciousness.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:78afa3d0c2b3b39071a85989e741f33c467d224f0866ebc5d4d69ca592cda2a9\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":39,\"summary\":\"You must consider an injury or illness to meet the general recording criteria, and therefore to be recordable, if it results in any of the following: death, days away from work, restricted work or transfer to another job, medical treatment beyond first aid, or loss of consciousness.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

        "@value": "{\"actor\":\"You\",\"kind\":\"requirement\",\"modality\":\"must\",\"summary\":\"Both job transfer and restricted work cases are recorded in the same box on the OSHA 300 Log; you must record an injury or illness that involves a job transfer by placing a check in the box for job transfer.\"}",
        "@type": "xsd:string"

      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:bcbcea02f82e5d7a09afacd434d230d610e0e30f813d4998dc2a78ba3be9263b\",\"urn:rulespec:document-understanding:assertion:86b5d778fa76903c290507f1ab12b8939d66ec1bf822739b1e11980489165e83\",\"urn:rulespec:document-understanding:assertion:c60b0d0a3d276579c685b4eb2fd2dd9de6f41fa3d82176629b385d72e37a4958\",\"urn:rulespec:document-understanding:assertion:5ac772159ce403d59fc420f5355a92216e3ea832c5b18df5c98757769b9cae91\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":16275,\"evidence\":[{\"end\":16275,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:16131:16275:sha256-53b4f335b1f0f5b916c4c7329b70ac50810485c45470cc1f62fe67c1890a9a2b\",\"quote\":\"(iii) Are any other procedures included in first aid? No, this is a complete list of all treatments considered first aid for part 1904 purposes.\",\"start\":16131}],\"id\":\"urn:rulespec:document-understanding:revision:743aeeb33a65038a57dab0e15ab700d904338cef6b2b48bcaa23a09c53eeb235\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"statement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:c60b0d0a3d276579c685b4eb2fd2dd9de6f41fa3d82176629b385d72e37a4958\",\"modality\":\"not_stated\",\"modality_quote\":\"\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:c4c7bdb69cd398e9c1eebef9729cbdcc525ea256059e2a10e7fca71aca05bb6c\",\"origin\":\"aiSuggested\",\"quote\":\"(iii) Are any other procedures included in first aid? No, this is a complete list of all treatments considered first aid for part 1904 purposes.\",\"references\":[\"part 1904\",\"§ 1904.7(b)(5)(ii)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:33297d1b7328ef1e3b9a41002e9ce83b83d8d6803d71e4e98eeb2d22447e41e0\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":16131,\"summary\":\"The list of treatments in § 1904.7(b)(5)(ii) is a complete list of all treatments considered first aid for part 1904 purposes; no other procedures are included in first aid.\",\"target_ids\":[],\"term_refs\":[\"urn:rulespec:document-understanding:term:b68f8fca12ed8b901b797b0a443bdd6b162b9e0f0a34d4e845cba55840034c0e\"],\"typed_values\":[]}",

    {
      "@id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:1273:1615:sha256-95feebdfdc8f5f37918c69eb0f079f013ef740173f51ba1c889ed0fcf30dcdc1",
      "@type": "rkaf:SourceFragment",
      "oa:hasSource": "urn:rulespec:document-understanding:document:4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493",
      "rkaf:fragmentIdentityScheme": "rkaf:carrier-local-fragment",
      "rkaf:sourceArtifactDigest": "sha256:4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493",
      "rkaf:fragmentContentDigest": "sha256:95feebdfdc8f5f37918c69eb0f079f013ef740173f51ba1c889ed0fcf30dcdc1",
      "rkaf:selectorKind": [
        "oa:TextQuoteSelector",
        "oa:TextPositionSelector"
      ],
      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "(2) How do I record a work-related injury or illness that results in the employee's death? You must record an injury or illness that results in death by entering a check mark on the OSHA 300 Log in the space for cases resulting in death. You must also report any work-related fatality to OSHA within eight (8) hours, as required by § 1904.39."
        },
        {
          "@type": "oa:TextPositionSelector",
          "oa:start": 1273,
          "oa:end": 1615,
          "rkaf:coordinateSystem": "rkaf:unicode-codepoint"
        }
      ]
    },

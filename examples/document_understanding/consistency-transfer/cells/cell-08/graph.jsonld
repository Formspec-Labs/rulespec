        "@value": "{\"actor\":\"you\",\"kind\":\"requirement\",\"modality\":\"must\",\"summary\":\"If the employee is out for an extended period of time, you must enter an estimate of the days that the employee will be away, and update the day count when the actual number of days is known.\"}",
        "@type": "xsd:string"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },
    {
      "@id": "urn:rulespec:document-understanding:binding:657830f575f6bdfd18f9601515dbc11e20cacfa64b2bc8464724755125077dd2",

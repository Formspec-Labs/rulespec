      "rkaf:assertsValue": {
        "@value": "In a case where a worker is injured or becomes ill on the day before scheduled time off such as a holiday, a planned vacation, or a temporary plant closing, you need to record the case only if you receive information from a physician or other licensed health care professional indicating that the employee should not have worked, or should have performed only restricted work, during the scheduled time off; if so, you must record the injury or illness as a case with days away from work or restricted work, and enter the day counts, as appropriate.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

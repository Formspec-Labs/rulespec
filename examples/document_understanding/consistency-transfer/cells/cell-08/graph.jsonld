        "@value": "{\"actor\":\"You\",\"kind\":\"requirement\",\"modality\":\"must\",\"summary\":\"You must count at least one day of restricted work or job transfer for cases where an employee is permanently assigned to a modified or changed job that eliminates restricted routine functions.\"}",

      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"you\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:2a6381548019adf5aa97daa604db8fe51e15eb434894e94b667d7bf2c30f78fb\",\"urn:rulespec:document-understanding:assertion:848147e1db7aef483379656fa39d53b2a8079ba0701400e70f03f7b83dfb6ef4\",\"urn:rulespec:document-understanding:assertion:1135f384e1f245760141e011d1a9a2f4a04512442bbdb4899c5d9920ee5e33f8\",\"urn:rulespec:document-understanding:assertion:6f34cc3836a6f87c96d81485dbe1c972ce161b322b09847b9c01012d07ed8817\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":17658,\"evidence\":[{\"end\":17658,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:17408:17658:sha256-9278e50a9d83eb8d6b9f3480f227bccad782b02ef97140fde6d00f9953bd34ce\",\"quote\":\"(6) Is every work-related injury or illness case involving a loss of consciousness recordable? Yes, you must record a work-related injury or illness if the worker becomes unconscious, regardless of the length of time the employee remains unconscious.\",\"start\":17408},{\"end\":17511,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:17508:17511:sha256-bb0347a468d97e98a9c00e37cebec1ab930f6f1221cae0f1fbb92b07e1900ba2\",\"quote\":\"you\",\"start\":17508}],\"id\":\"urn:rulespec:document-understanding:revision:3f42c89e177a6e0af27985b30504c7943fec1382494d052caf401e6669a54976\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:6f34cc3836a6f87c96d81485dbe1c972ce161b322b09847b9c01012d07ed8817\",\"modality\":\"must\",\"modality_quote\":\"\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:59dffc49f6beaf43789c331ed86a61109565228bb3da8d7b9d60a9fa875e80e8\",\"origin\":\"aiSuggested\",\"quote\":\"(6) Is every work-related injury or illness case involving a loss of consciousness recordable? Yes, you must record a work-related injury or illness if the worker becomes unconscious, regardless of the length of time the employee remains unconscious.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:24a11d475a5a385b3fcef503710b962c9ccb98009ebcfa231d804458177d3c1c\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":17408,\"summary\":\"You must record a work-related injury or illness if the worker becomes unconscious, regardless of the length of time the employee remains unconscious.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

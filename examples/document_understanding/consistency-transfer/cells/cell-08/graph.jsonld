      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:ff01c202eff6dc41486e8f40e6bf66e7b0e78c43a526680f2f151deffb26b287\",\"urn:rulespec:document-understanding:assertion:e802081bed48f5ecf1bcfa1eeeb5864725147dbd09a597157a849b57439121e7\",\"urn:rulespec:document-understanding:assertion:8e3d6b8d90fa529d1aff95d950c9e575c64ef5a42240e01a9bb56dfe358fbae5\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":11027,\"evidence\":[{\"end\":11027,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:10092:11027:sha256-15cb9ba69bb8a7fa51d03cef433e216c9fea8a9dc2afc740cbbc368f695938bc\",\"quote\":\"(vii) How do I handle vague restrictions from a physician or other licensed health care professional, such as that the employee engage only in “light duty” or “take it easy for a week”? If you are not clear about the physician or other licensed health care professional's recommendation, you may ask that person whether the employee can do all of his or her routine job functions and work all of his or her normally assigned work shift. If the answer to both of these questions is “Yes,” then the case does not involve a work restriction and does not have to be recorded as such. If the answer to one or both of these questions is “No,” the case involves restricted work and must be recorded as a restricted work case. If you are unable to obtain this additional information from the physician or other licensed health care professional who recommended the restriction, record the injury or illness as a case involving restricted work.\",\"start\":10092}],\"id\":\"urn:rulespec:document-understanding:revision:6e4d11bb28bc661818af65f8ad42f75fd405076a03f76728bd80c5a05b0c3b2a\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:8e3d6b8d90fa529d1aff95d950c9e575c64ef5a42240e01a9bb56dfe358fbae5\",\"modality\":\"must\",\"modality_quote\":\"\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:aabea9787d450621a9e012b4273f93f83cc2b4fbda13d1e28d12054d73f06098\",\"origin\":\"aiSuggested\",\"quote\":\"(vii) How do I handle vague restrictions from a physician or other licensed health care professional, such as that the employee engage only in “light duty” or “take it easy for a week”? If you are not clear about the physician or other licensed health care professional's recommendation, you may ask that person whether the employee can do all of his or her routine job functions and work all of his or her normally assigned work shift. If the answer to both of these questions is “Yes,” then the case does not involve a work restriction and does not have to be recorded as such. If the answer to one or both of these questions is “No,” the case involves restricted work and must be recorded as a restricted work case. If you are unable to obtain this additional information from the physician or other licensed health care professional who recommended the restriction, record the injury or illness as a case involving restricted work.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:9b89eea65c782b480ae49da8f26df598929cf6d575bf5147211bc7858427f527\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":10092,\"summary\":\"If you are unable to obtain additional clarification from the physician or other licensed health care professional who recommended the vague restriction, you must record the injury or illness as a case involving restricted work.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

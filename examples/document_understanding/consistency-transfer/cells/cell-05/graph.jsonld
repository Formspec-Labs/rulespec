      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:4a4fb02a1f40c139ed2c3a9cc6ad5ac5d7273a2349a7c14c1db1cceeac48cbf5\",\"urn:rulespec:document-understanding:assertion:f5d96771850fb3fc53ad8ed1c4fe94d83e020e13c69a5c98e4ffb93aeda6db31\",\"urn:rulespec:document-understanding:assertion:9d813697c4948af1b33d732390840f5023816a5a9ead5e67f20464dcf2712963\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":19207,\"evidence\":[{\"end\":19207,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:18884:19207:sha256-7b6cf08f9c3c4a96b71d47fd7aa4fae2ef5f7373fc9e380ba1322a4dbdf266f6\",\"quote\":\"OSHA believes that cancer, chronic irreversible diseases, fractured or cracked bones, and punctured eardrums are generally considered significant injuries and illnesses, and must be recorded at the initial diagnosis even if medical treatment or work restrictions are not recommended, or are postponed, in a particular case.\",\"start\":18884},{\"end\":19062,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:19058:19062:sha256-4137b01e139589b7a1d3b3fc4da031d8ce5bb415808734e970c3a58ea0e98f0f\",\"quote\":\"must\",\"start\":19058}],\"id\":\"urn:rulespec:document-understanding:revision:60d65f0b14d00de104388ea9c2aa8c8e1bddf4ae2ec29b4a3b39c5638c816495\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:9d813697c4948af1b33d732390840f5023816a5a9ead5e67f20464dcf2712963\",\"modality\":\"must\",\"modality_quote\":\"must\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:151597aacd6746002f7f523a5effd9e3b29b7d0f0a05379e755050771e3b6776\",\"origin\":\"aiSuggested\",\"quote\":\"OSHA believes that cancer, chronic irreversible diseases, fractured or cracked bones, and punctured eardrums are generally considered significant injuries and illnesses, and must be recorded at the initial diagnosis even if medical treatment or work restrictions are not recommended, or are postponed, in a particular case.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:1a9e58d9f4be74e162470a8507759e4da650997125e355f8512d2395046663c6\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":18884,\"summary\":\"OSHA believes that cancer, chronic irreversible diseases, fractured or cracked bones, and punctured eardrums are generally considered significant injuries and illnesses, and must be recorded at the initial diagnosis even if medical treatment or work restrictions are not recommended, or are postponed, in a particular case.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

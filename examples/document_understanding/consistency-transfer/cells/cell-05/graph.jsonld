      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:54e1a3cbe7cfc27a1171a2c8a583c6614bb46b20ed02cc4d1f457aae133c9127",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:8dcf2943bc819defd9506605916b21844276e9579270a5fced68174dcbeb7fda",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:f60f2611ed172f9b2c3c0d8263e05a1eefccc3fa0c56f5266be625ef5c0b31b8",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"actor\":\"you\",\"kind\":\"requirement\",\"modality\":\"must\",\"scope_text\":\"in which a worker is injured or becomes ill on the day before scheduled time off such as a holiday, a planned vacation, or a temporary plant closing\",\"summary\":\"In a case in which a worker is injured or becomes ill on the day before scheduled time off such as a holiday, a planned vacation, or a temporary plant closing, you need to record a case of this type only if you receive information from a physician or other licensed health care professional indicating that the employee should not have worked, or should have performed only restricted work, during the scheduled time off; if so, you must record the injury or illness as a case with days away from work or restricted work, and enter the day counts, as appropriate.\"}",
        "@type": "xsd:string"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed",
      "rkaf:hasApplicability": "urn:rulespec:document-understanding:scope:cf67dc3f84db7563033ff690f50dcdfbb32606b6c4ad37923fd0c82332c34191"
    },

      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:57db104e92373eeac1ac8ce6662e05ab2e97d0bc2a736e05e16b17c4c70c1039\",\"urn:rulespec:document-understanding:assertion:87651c837b0e6e203a09542c43d01740e688b2d83d8415bb190bb91e7e5352b1\",\"urn:rulespec:document-understanding:assertion:8d03955e5ddc5660bf84ec3f418944cd4161e5223e0b473f3c4cfde551d95c91\",\"urn:rulespec:document-understanding:assertion:3245294d8b95acfd77f7242d29dc7cf3b0dcd0f0d00655e9a38f2f32359d5106\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[\"If you are not clear about the physician or other licensed health care professional's recommendation, you may ask that person whether the employee can do all of his or her routine job functions and work all of his or her normally assigned work shift.\"],\"defined_terms\":[],\"effective_periods\":[],\"end\":10810,\"evidence\":[{\"end\":10810,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:10672:10810:sha256-fcc81d9febd60abf1a8e7823768c576c9810c97a33ae6222d0f455327f05ee4a\",\"quote\":\"If the answer to one or both of these questions is “No,” the case involves restricted work and must be recorded as a restricted work case.\",\"start\":10672},{\"end\":10771,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:10767:10771:sha256-4137b01e139589b7a1d3b3fc4da031d8ce5bb415808734e970c3a58ea0e98f0f\",\"quote\":\"must\",\"start\":10767},{\"end\":10810,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:10672:10810:sha256-fcc81d9febd6
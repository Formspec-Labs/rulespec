      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"you\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:22782f9ce59ef6e74804fbc63ed46856e8ded95424a77aa8834085768f7629eb\",\"urn:rulespec:document-understanding:assertion:5a714b74d1f05cd0bacb52732a8df64b29ec33fcdc6b77068d89cd3088ae6769\",\"urn:rulespec:document-understanding:assertion:a33e9f5c30177be016fe4880ea47f8ec49c506740c389ba67eaa764c5493518a\",\"urn:rulespec:document-understanding:assertion:e62874fbceed4ed0758f78b1b431c0c7781ad5706b0b1d17800ffdfabdeb07be\",\"urn:rulespec:document-understanding:assertion:adb1237546a49d05f00b39ab72185cc55245724bb308792be64f9a883535a361\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":7401,\"evidence\":[{\"end\":7401,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:7061:7401:sha256-fa7e2dd3ac91a6b9a8812757d76dd4ba2a502fc78160f27b33521256aeef1344\",\"quote\":\"When an injury or illness involves restricted work or job transfer but does not involve death or days away from work, you must record the injury or illness on the OSHA 300 Log by placing a check mark in the space for job transfer or restriction and an entry of the number of restricted or transferred days in the restricted workdays column.\",\"start\":7061},{\"end\":7182,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:7179:7182:sha256-bb0347a468d97e98a9c00e37cebec1ab930f6f1221cae0f1fbb92b07e1900ba2\",\"quote\":\"you\",\"start\":7179},{\"end\":7187,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:7183:7187:sha256-4137b01e139589b7a1d3b3fc4da031d8ce5bb415808734e970c3a58ea0e98f0f\",\"quote\":\"must\",\"start\":7183},{\"end\":7401,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:7061:7401:sha256-fa7e2dd3ac91a6b9a8812757d76dd4ba2a502fc78160f27b33521256aeef1344\",\"quote\":\"When an injury or illness involves restricted work or job transfer but does not involve death or days away from work, you must record the injury or illness on the OSHA 300 Log by placing a check mark in the space for job transfer or restriction and an entry of the number of restricted or transferred days in the restricted workdays column.\",\"start\":7061}],\"id\":\"urn:rulespec:document-understanding:revision:e3f8dc6e28e9aadca148bace0af81bdc6e930a04e1c707532b9ac2b7c12987bc\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:adb1237546a49d05f00b39ab72185cc55245724bb308792be64f9a883535a361\",\"modality\":\"must\",\"modality_quote\":\"must\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:b537481d80238e77c2b76ce9cacada8d32d7f992465598c262b0544a113e63d7\",\"origin\":\"aiSuggested\",\"quote\":\"When an injury or illness involves restricted work or job transfer but does not involve death or days away from work, you must record the injury or illness on the OSHA 300 Log by placing a check mark in the space for job transfer or restriction and an entry of the number of restricted or transferred days in the restricted workdays column.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:446fdd74bfbf0d35687b971872fec61750f681cfbb7d1d374fe2e9977fd05f6e\",\"scope_quotes\":[\"When an injury or illness involves restricted work or job transfer but does not involve death or days away from work, you must record the injury or illness on the OSHA 300 Log by placing a check mark in the space for job transfer or restriction and an entry of the number of restricted or transferred days in the restricted workdays column.\"],\"scope_text\":\"When an injury or illness involves restricted work or job transfer but does not involve death or days away from work\",\"section_id\":\"section-1\",\"start\":7061,\"summary\":\"When an injury or illness involves restricted work or job transfer but does not involve death or days away from work, you must record the injury or illness on the OSHA 300 Log by placing a check mark in the space for job transfer or restriction and an entry of the number of restricted or transferred days in the restricted workdays column.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

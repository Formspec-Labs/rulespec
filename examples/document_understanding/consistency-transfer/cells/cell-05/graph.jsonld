      "dcterms:description": "{\"action\":\"\",\"actor\":\"you\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:53d5858ba007cd670150cb6bfcffc0e817a16b246b51a4326431888d744a1824\",\"urn:rulespec:document-understanding:assertion:300b24e0bf3a2fe2a024fd747db1f0ee1a62150bf1b86a971550a625cf681841\",\"urn:rulespec:document-understanding:assertion:66a0ae603680872e271b98cc4d47b910e12746837f74038fe08ccaf3d34a61ef\",\"urn:rulespec:document-understanding:assertion:7c3744c00e81fa135ab185f3e55de885b5e2562e2a3aa1a63f1f44a0211a5d1f\",\"urn:rulespec:document-understanding:assertion:1c6157e9f6119b66edccbd021ed12e677218a233d9499044839d6e38c09db937\",\"urn:rulespec:document-understanding:assertion:cf99a6548304914dbb955a5e876496c7a9ebbdfe2560259505fc230ba9461dd2\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[\"(vii) How do I handle vague restrictions from a physician or other licensed health care professional, such as that the employee engage only in “light duty” or “take it easy for a week”?\"],\"defined_terms\":[],\"effective_periods\":[],\"end\":10528,\"evidence\":[{\"end\":10528,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:10278:10528:sha256-7ad933ebf510619c22791054a1772fcb24bdc2d8c9b479496440f071022fa673\",\"quote\":\"If you are not clear about the physician or other licensed health care professional's recommendation, you may ask that person whether the employee can do all of his or her routine job functions and work all of his or her normally assigned work shift.\",\"start\":10278},{\"end\":10387,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:10384:10387:sha256-ee4d988c65de860fabbfbcd27f73d50bbebe3fba37fe419284f4811389c30bdc\",\"quote\":\"may\",\"start\":10384},{\"end\":10528,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:10278:10528:sha256-7ad933ebf510619c22791054a1772fcb24bdc2d8c9b479496440f071022fa673\",\"quote\":\"If you are not clear about the physician or other licensed health care professional's recommendation, you may ask that person whether the employee can do all of his or her routine job functions and work all of his or her normally assigned work shift.\",\"start\":10278},{\"end\":10277,\"field\":\"context:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:10092:10277:sha256-bb5c228bf47758073e6541bf241ba926646de81dbb1f64efccb4f7195066920b\",\"quote\":\"(vii) How do I handle vague restrictions from a physician or other licensed health care professional, such as that the employee engage only in “light duty” or “take it easy for a week”?\",\"start\":10092}],\"id\":\"urn:rulespec:document-understanding:revision:ad603b3550370e42c4c2177978a654bec96ebce7f77533db36397c5ff15d5d4d\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"permission\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:1c6157e9f6119b66edccbd021ed12e677218a233d9499044839d6e38c09db937\",\"modality\":\"may\",\"modality_quote\":\"may\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:680e6c3c75ca5c47c8a61d0bfdc0abdbd0b8588e6003e0f8d32be974d295307e\",\"origin\":\"aiSuggested\",\"quote\":\"If you are not clear about the physician or other licensed health care professional's recommendation, you may ask that person whether the employee can do all of his or her routine job functions and work all of his or her normally assigned work shift.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:b8be95a2cb75c3f13b7ba5228e8b7449f016763e02b902d442765b0fb27e5954\",\"scope_quotes\":[\"If you are not clear about the physician or other licensed health care professional's recommendation, you may ask that person whether the employee can do all of his or her routine job functions and work all of his or her normally assigned work shift.\"],\"scope_text\":\"If you are not clear about the physician or other licensed health care professional's recommendation\",\"section_id\":\"section-1\",\"start\":10278,\"summary\":\"If you are not clear about the physician or other licensed health care professional's recommendation, such as vague restrictions to engage only in 'light duty' or 'take it easy for a week', you may ask that person whether the employee can do all of his or her routine job functions and work all of his or her normally assigned work shift.\",\"target_ids\":[],\"term_refs\":[\"urn:rulespec:document-understanding:term:cabbca0c0216f3f05b156b97a4083968cb5297c8d87460039c07b6a8ae898132\"],\"typed_values\":[]}",

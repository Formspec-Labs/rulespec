      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"You\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:9c28f9102ed124d925db0d7ad9e8218e0413019800025ec1d7ba833099feb082\",\"urn:rulespec:document-understanding:assertion:9d794bf8bf68fd11d421f36f35acc81751527f23ee6f55009f894f45f1b0da78\",\"urn:rulespec:document-understanding:assertion:f2b4e32aa85c12ae203c0eec1a80013e83f8077400fc2b0123c2701fc24dabb7\",\"urn:rulespec:document-understanding:assertion:c2c74212353d23711a76a8e12d5ab3dc87f1e39db7c31e4c6afc6a9bc420d4b9\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":683,\"evidence\":[{\"end\":683,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:346:683:sha256-a6d0285f9727ff758719307c8d31a1c4c910fb756b3ef2e23dbb436e01053066\",\"quote\":\"You must also consider a case to meet the general recording criteria if it involves a significant injury or illness diagnosed by a physician or other licensed health care professional, even if it does not result in death, days away from work, restricted work or job transfer, medical treatment beyond first aid, or loss of consciousness.\",\"start\":346},{\"end\":349,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:346:349:sha256-08b041935798fbf6fd6ff51099ffedb140a475889986d14f5559ff8e7fc571dd\",\"quote\":\"You\",\"start\":346},{\"end\":354,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:350:354:sha256-4137b01e139589b7a1d3b3fc4da031d8ce5bb415808734e970c3a58ea0e98f0f\",\"quote\":\"must\",\"start\":350}],\"id\":\"urn:rulespec:document-understanding:revision:79e7e7c8c80c6f589449746f8d403e7a0384b6e545e2f53adb2af6cb176ce143\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:c2c74212353d23711a76a8e12d5ab3dc87f1e39db7c31e4c6afc6a9bc420d4b9\",\"modality\":\"must\",\"modality_quote\":\"must\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:db1665979b893c1f055173aa051f77c7f3d969a729226fa15b412dee8a667f59\",\"origin\":\"aiSuggested\",\"quote\":\"You must also consider a case to meet the general recording criteria if it involves a significant injury or illness diagnosed by a physician or other licensed health care professional, even if it does not result in death, days away from work, restricted work or job transfer, medical treatment beyond first aid, or loss of consciousness.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:975773ddc3fb17f0647aeb3a188a24cfc340a183c7b6d465a612462303de2ee2\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":346,\"summary\":\"You must consider a case to meet the general recording criteria if it involves a significant injury or illness diagnosed by a physician or other licensed health care professional, even if it does not result in death, days away from work, restricted work or job transfer, medical treatment beyond first aid, or loss of consciousness.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

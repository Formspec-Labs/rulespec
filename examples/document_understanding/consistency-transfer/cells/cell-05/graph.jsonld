      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"defined_terms\":[{\"id\":\"urn:rulespec:document-understanding:term:b28bf9130fb325d9e129ea811c670aaf97099491d4623444437dd0b22115ccdb\",\"label\":\"medical treatment\",\"quote\":\"“Medical treatment” means the management and care of a patient to combat disease or disorder. For the purposes of part 1904, medical treatment does not include:\\n\\n(A) Visits to a physician or other licensed health care professional solely for observation or counseling;\\n\\n(B) The conduct of diagnostic procedures, such as x-rays and blood tests, including the administration of prescription medications used solely for diagnostic purposes ( e.g., eye drops to dilate pupils); or\\n\\n(C) “First aid” as defined in paragraph (b)(5)(ii) of this section.\",\"source_quotes\":[\"“Medical treatment” means the management and care of a patient to combat disease or disorder.\",\"For the purposes of part 1904, medical treatment does not include:\",\"(A) Visits to a physician or other licensed health care professional solely for observation or counseling;\",\"(B) The conduct of diagnostic procedures, such as x-rays and blood tests, including the administration of prescription medications used solely for diagnostic purposes ( e.\",\"g.\",\", eye drops to dilate pupils); or\",\"(C) “First aid” as defined in paragraph (b)(5)(ii) of this section.\"]}],\"kind\":\"definition\",\"modality\":\"not_stated\",\"summary\":\"“Medical treatment” means the management and care of a patient to combat disease or disorder; for the purposes of part 1904, medical treatment does not include: (A) visits to a physician or other licensed health care professional solely for observation or counseling; (B) the conduct of diagnostic procedures, such as x-rays and blood tests, including the administration of prescription medications used solely for diagnostic purposes (e.g., eye drops to dilate pupils); or (C) “first aid” as defined in paragraph (b)(5)(ii) of this section.\",\"term_refs\":[\"urn:rulespec:document-understanding:term:54ecd44f7f9b3e82125581631d51f7e6c8ed5c3a8c949f77619cf70d2943591a\"]}",
        "@type": "xsd:string"
      },

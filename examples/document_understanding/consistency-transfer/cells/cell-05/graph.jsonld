    {
      "@id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:788:1271:sha256-2ff044c49cc9bab1d006f36b99dbe1b2c20b7c90bb9ff275a59c883b8ce52f04",
      "@type": "rkaf:SourceFragment",
      "oa:hasSource": "urn:rulespec:document-understanding:document:4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493",
      "rkaf:fragmentIdentityScheme": "rkaf:carrier-local-fragment",
      "rkaf:sourceArtifactDigest": "sha256:4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493",
      "rkaf:fragmentContentDigest": "sha256:2ff044c49cc9bab1d006f36b99dbe1b2c20b7c90bb9ff275a59c883b8ce52f04",
      "rkaf:selectorKind": [
        "oa:TextQuoteSelector",
        "oa:TextPositionSelector"
      ],
      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "A work-related injury or illness must be recorded if it results in one or more of the following:\n\n(i) Death. See § 1904.7(b)(2).\n\n(ii) Days away from work. See § 1904.7(b)(3).\n\n(iii) Restricted work or transfer to another job. See § 1904.7(b)(4).\n\n(iv) Medical treatment beyond first aid. See § 1904.7(b)(5).\n\n(v) Loss of consciousness. See § 1904.7(b)(6).\n\n(vi) A significant injury or illness diagnosed by a physician or other licensed health care professional. See § 1904.7(b)(7)."
        },
        {
          "@type": "oa:TextPositionSelector",
          "oa:start": 788,
          "oa:end": 1271,
          "rkaf:coordinateSystem": "rkaf:unicode-codepoint"
        }
      ]
    },

      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "(v) How do I record a case in which a worker is injured or becomes ill on a Friday and reports to work on a Monday, and was not scheduled to work on the weekend?"
        },
        {
          "@type": "oa:TextPositionSelector",
          "oa:start": 4157,
          "oa:end": 4318,
          "rkaf:coordinateSystem": "rkaf:unicode-codepoint"
        }
      ]
    },
    {

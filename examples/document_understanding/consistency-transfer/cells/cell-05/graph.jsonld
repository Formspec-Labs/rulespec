      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"you\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:25014963e278776ce1b5aa46e43574f0d219fb88528074eb51a6b25b5b7ef7de\",\"urn:rulespec:document-understanding:assertion:c0cf3be33493c1f2ef4e0a78468ff75077e0d934c88d60a4787cd4a8a2557aa1\",\"urn:rulespec:document-understanding:assertion:c6622cebba9885fe858aa00c50a86aee851230214360ac9ddbeb46e3a8004540\",\"urn:rulespec:document-understanding:assertion:68677c635b107d250418d2975a8a6139e919e597d693ed9ee7d73e1fa8c3c58a\",\"urn:rulespec:document-understanding:assertion:d76e068b6e209a62899413c9f265aeda6e60b9d3fd09b2cee8db277f242223af\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[\"(vii) How do I handle vague restrictions from a physician or other licensed health care professional, such as that the employee engage only in “light duty” or “take it easy for a week”?\",\"If you are not clear about the physician or other licensed health care professional's recommendation, you may ask that person whether the employee can do all of his or her routine job functions and work all of his or her normally assigned work shift.\"],\"defined_terms\":[],\"effective_periods\":[],\"end\":11027,\"evidence\":[{\"end\":11027,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:10811:11027:sha256-da24a06bc30edc307a00f2707f4a1fa8f2ef7c8c9bf0a0918e2757061c2a9a0b\",\"quote\":\"If you are unable to obtain this additional information from the physician or other licensed health care professional who recommended the restriction, record the injury or illness as a case involving restricted work.\",\"start\":10811},{\"end\":10817,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:10814:10817:sha256-bb0347a468d97e98a9c00e37cebec1ab930f6f1221cae0f1fbb92b07e1900ba2\",\"quote\":\"you\",\"start\":10814},{\"end\":11027,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:10811:11027:sha256-da24a06bc30edc307a00f2707f4a1fa8f2ef7c8c9bf0a0918e2757061c2a9a0b\",\"quote\":\"If you are unable to obtain this additional information from the physician or other licensed health care professional who recommended the restriction, record the injury or illness as a case involving restricted work.\",\"start\":10811},{\"end\":10277,\"field\":\"context:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:10092:10277:sha256-bb5c228bf47758073e6541bf241ba926646de81dbb1f64efccb4f7195066920b\",\"quote\":\"(vii) How do I handle vague restrictions from a physician or other licensed health care professional, such as that the employee engage only in “light duty” or “take it easy for a week”?\",\"start\":10092},{\"end\":10528,\"field\":\"context:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:10278:10528:sha256-7ad933ebf510619c22791054a1772fcb24bdc2d8c9b479496440f071022fa673\",\"quote\":\"If you are not clear about the physician or other licensed health care professional's recommendation, you may ask that person whether the employee can do all of his or her routine job functions and work all of his or her normally assigned work shift.\",\"start\":10278}],\"id\":\"urn:rulespec:document-understanding:revision:d1e2efe1512151432b160526dbd7221dbfaa04b305e4ac60d409fb476d22c25e\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:d76e068b6e209a62899413c9f265aeda6e60b9d3fd09b2cee8db277f242223af\",\"modality\":\"must\",\"modality_quote\":\"\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:893381c377da85db06009bc18983e549a16ea6e95f88403cd3e4ac96e53e496f\",\"origin\":\"aiSuggested\",\"quote\":\"If you are unable to obtain this additional information from the physician or other licensed health care professional who recommended the restriction, record the injury or illness as a case involving restricted work.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:b41566470b13ba44bb790a2650e7ebf0b3eb80fc4c16ff8de9990342fb2c89ec\",\"scope_quotes\":[\"If you are unable to obtain this additional information from the physician or other licensed health care professional who recommended the restriction, record the injury or illness as a case involving restricted work.\"],\"scope_text\":\"If you are unable to obtain this additional information from the physician or other licensed health care professional who recommended the restriction\",\"section_id\":\"section-1\",\"start\":10811,\"summary\":\"If you are unable to obtain additional information from the physician or other licensed health care professional who recommended the vague restriction, record the injury or illness as a case involving restricted work.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

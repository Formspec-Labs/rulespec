      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"You\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:c6df1868b9c4da28d75ed3e96b7ac6e16434920cb4ee64b66abf1fb343a916c4\",\"urn:rulespec:document-understanding:assertion:6e82c1211d909f65ed19105458de353efea5aeb12f0de09d547db403aa139570\",\"urn:rulespec:document-understanding:assertion:aa22e746a87fab7d162838fdea34e96085d72674d57070bc2831c827f76d58bd\",\"urn:rulespec:document-understanding:assertion:11a13b8acb3e784fc3beac989cde3c9c9b8c34f82e5b8ef3df43b2c2ab2da338\",\"urn:rulespec:document-understanding:assertion:932bcf062006ae56eda8112fe5096ad50e83e24034e599c47ad32f0f18bef857\",\"urn:rulespec:document-understanding:assertion:f7e3fce2f44bda6a36808a07b8c5cc2c53dc5242996fab60e7c3f13d6214da9a\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[\"The only difference is that, if you permanently assign the injured or ill employee to a job that has been modified or permanently changed in a manner that eliminates the routine functions the employee was restricted from performing, you may stop the day count when the modification or change is made permanent.\"],\"defined_terms\":[],\"effective_periods\":[],\"end\":13182,\"evidence\":[{\"end\":13182,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:13100:13182:sha256-951d95fda19ac95b914500534ea610cda7a01cc5a03bc46b8124a87ef45e0d66\",\"quote\":\"You must count at least one day of restricted work or job transfer for such cases.\",\"start\":13100},{\"end\":13103,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:13100:13103:sha256-08b041935798fbf6fd6ff51099ffedb140a475889986d14f5559ff8e7fc571dd\",\"quote\":\"You\",\"start\":13100},{\"end\":13108,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:13104:13108:sha256-4137b01e139589b7a1d3b3fc4da031d8ce5bb415808734e970c3a58ea0e98f0f\",\"quote\":\"must\",\"start\":13104},{\"end\":13182,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:13100:13182:sha256-951d95fda19ac95b914500534ea610cda7a01cc5a03bc46b8124a87ef45e0d66\",\"quote\":\"You must count at least one day of restricted work or job transfer for such cases.\",\"start\":13100},{\"end\":13099,\"field\":\"context:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:12789:13099:sha256-f6125da25dd5b0ab7e813aa786361d5994d13482ed211fd1a36f47c207cf2f29\",\"quote\":\"The only difference is that, if you permanently assign the injured or ill employee to a job that has been modified or permanently changed in a manner that eliminates the routine functions the employee was restricted from performing, you may stop the day count when the modification or change is made permanent.\",\"start\":12789}],\"id\":\"urn:rulespec:document-understanding:revision:cdbd28da38b7374e991e5a1d4ad89a463ab67218b9fbacf5187a35bd5b2a40f1\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:932bcf062006ae56eda8112fe5096ad50e83e24034e599c47ad32f0f18bef857\",\"modality\":\"must\",\"modality_quote\":\"must\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:35746af864bff269b043927b3464c293cc14aaa2b61b4b6188477cdebabdaed8\",\"origin\":\"aiSuggested\",\"quote\":\"You must count at least one day of restricted work or job transfer for such cases.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:a2aa0e1387445b4352acc0a19d39ea41a6985b20c5f0b9844999e44dc8129ad6\",\"scope_quotes\":[\"You must count at least one day of restricted work or job transfer for such cases.\"],\"scope_text\":\"for such cases\",\"section_id\":\"section-1\",\"start\":13100,\"summary\":\"You must count at least one day of restricted work or job transfer for cases where an employee is permanently assigned to a job modified or changed to eliminate the restricted routine functions.\",\"target_ids\":[],\"term_refs\":[\"urn:rulespec:document-understanding:term:cabbca0c0216f3f05b156b97a4083968cb5297c8d87460039c07b6a8ae898132\"],\"typed_values\":[]}",

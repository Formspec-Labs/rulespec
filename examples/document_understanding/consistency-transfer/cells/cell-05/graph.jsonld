      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "(vi) How do I record a case in which a worker is injured or becomes ill on the day before scheduled time off such as a holiday, a planned vacation, or a temporary plant closing?"
        },

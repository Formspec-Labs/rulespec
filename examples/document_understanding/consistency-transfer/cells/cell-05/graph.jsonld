      "rkaf:hasContentDigest": "sha256:4b47e426e15f77244c5689f68e02d2f9aa266e3b85d082f92f6baf8522bb111d",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:7501e497796c9b8e9624953226522f8b9bc9a50f3c1a1cef68e4126447389aa4\",\"urn:rulespec:document-understanding:assertion:a9c943b627965612a2d7494eac5c7c4c6e38a502412535266df4eebba0478272\",\"urn:rulespec:document-understanding:assertion:d06a74a3d79b57fee22061d429e843bafb68b0be2f8ae5219d90e5248f24be18\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":1271,\"evidence\":[{\"end\":1271,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:788:1271:sha256-2ff044c49cc9bab1d006f36b99dbe1b2c20b7c90bb9ff275a59c883b8ce52f04\",\"quote\":\"A work-related injury or illness must be recorded if it results in one or more of the following:\\n\\n(i) Death. See § 1904.7(b)(2).\\n\\n(ii) Days away from work. See § 1904.7(b)(3).\\n\\n(iii) Restricted work or transfer to another job. See § 1904.7(b)(4).\\n\\n(iv) Medical treatment beyond first aid. See § 1904.7(b)(5).\\n\\n(v) Loss of consciousness. See § 1904.7(b)(6).\\n\\n(vi) A significant injury or illness diagnosed by a physician or other licensed health care professional. See § 1904.7(b)(7).\",\"start\":788},{\"end\":825,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:821:825:sha256-4137b01e139589b7a1d3b3fc4da031d8ce5bb415808734e970c3a58ea0e98f0f\",\"quote\":\"must\",\"start\":821}],\"id\":\"urn:rulespec:document-understanding:revision:5de320f1f322a1f587601c500d4cb92ec0b24d8ea92eb96574cb0e56d7485a77\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:d06a74a3d79b57fee22061d429e843bafb68b0be2f8ae5219d90e5248f24be18\",\"modality\":\"must\",\"modality_quote\":\"must\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:d97af202e2eaea766cfcaaec64344f052975d890bd6c67acd39155fdeec32acc\",\"origin\":\"aiSuggested\",\"quote\":\"A work-related injury or illness must be recorded if it results in one or more of the following:\\n\\n(i) Death. See § 1904.7(b)(2).\\n\\n(ii) Days away from work. See § 1904.7(b)(3).\\n\\n(iii) Restricted work or transfer to another job. See § 1904.7(b)(4).\\n\\n(iv) Medical treatment beyond first aid. See § 1904.7(b)(5).\\n\\n(v) Loss of consciousness. See § 1904.7(b)(6).\\n\\n(vi) A significant injury or illness diagnosed by a physician or other licensed health care professional. See § 1904.7(b)(7).\",\"references\":[\"§ 1904.7(b)(2)\",\"§ 1904.7(b)(3)\",\"§ 1904.7(b)(4)\",\"§ 1904.7(b)(5)\",\"§ 1904.7(b)(6)\",\"§ 1904.7(b)(7)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:6cf2828dbcd6a8130992ef78372b084fc93b7d459f3cb769627a61e7a0feadd3\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":788,\"summary\":\"A work-related injury or illness must be recorded if it results in one or more of: (i) death; (ii) days away from work; (iii) restricted work or transfer to another job; (iv) medical treatment beyond first aid; (v) loss of consciousness; or (vi) a significant injury or illness diagnosed by a physician or other licensed health care professional.\",\"target_ids\":[],\"term_refs\":[],\"typed_values\":[]}",

        "@value": "{\"kind\":\"statement\",\"modality\":\"not_stated\",\"summary\":\"OSHA considers the treatments listed in § 1904.7(b)(5)(ii) to be first aid regardless of the professional status of the person providing the treatment, and even when these treatments are provided by a physician or other licensed health care professional, they are considered first aid for the purposes of part 1904.\",\"term_refs\":[\"urn:rulespec:document-understanding:term:54ecd44f7f9b3e82125581631d51f7e6c8ed5c3a8c949f77619cf70d2943591a\"]}",

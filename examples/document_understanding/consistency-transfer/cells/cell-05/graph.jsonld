    {
      "@id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:16185:16275:sha256-c9b58ff785fd7a3c62c9b3e160be39a68750b308aff37804dea1a0950e7646ec",
      "@type": "rkaf:SourceFragment",
      "oa:hasSource": "urn:rulespec:document-understanding:document:4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493",
      "rkaf:fragmentIdentityScheme": "rkaf:carrier-local-fragment",
      "rkaf:sourceArtifactDigest": "sha256:4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493",
      "rkaf:fragmentContentDigest": "sha256:c9b58ff785fd7a3c62c9b3e160be39a68750b308aff37804dea1a0950e7646ec",

      "rkaf:assertsValue": {
        "@value": "A work-related injury or illness must be recorded if it results in one or more of: (i) death; (ii) days away from work; (iii) restricted work or transfer to another job; (iv) medical treatment beyond first aid; (v) loss of consciousness; or (vi) a significant injury or illness diagnosed by a physician or other licensed health care professional.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

      "dcterms:description": "{\"action\":\"\",\"actor\":\"you\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:128e31e0c36dc6d45d77bb14f000d2beb64c82904a41efc6d7fb2f69f1481ac9\",\"urn:rulespec:document-understanding:assertion:e80cb50e4747a117475f8077b2e1e47892e98f55952ff12dd1696465cf5525ab\",\"urn:rulespec:document-understanding:assertion:553b5dcfe68cc69b51bb267e4cd8a224aa600b54bb6fdaa48270b1c004c76351\",\"urn:rulespec:document-understanding:assertion:e91bc3c17178b8693998256d573ce7fb9de8d4efde9ca2a5dafc3b3d684f70d8\",\"urn:rulespec:document-understanding:assertion:7880e2cabf33814378fb94b9a66d9bc571f6cb09dc54e24bf44ad4ba187d52ee\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[\"(v) What if a physician or other licensed health care professional recommends medical treatment but the employee does not follow the recommendation?\",\"If a physician or other licensed health care professional recommends medical treatment, you should encourage the injured or ill employee to follow that recommendation.\"],\"defined_terms\":[],\"effective_periods\":[],\"end\":17406,\"evidence\":[{\"end\":17406,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:17246:17406:sha256-c4b41bd7b763f89088e84d0a21c1ef784ed3c48562227a359d55fbc7fb1386ea\",\"quote\":\"However, you must record the case even if the injured or ill employee does not follow the physician or other licensed health care professional's recommendation.\",\"start\":17246},{\"end\":17258,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:17255:17258:sha256-bb0347a468d97e98a9c00e37cebec1ab930f6f1221cae0f1fbb92b07e1900ba2\",\"quote\":\"you\",\"start\":17255},{\"end\":17263,\"fiel
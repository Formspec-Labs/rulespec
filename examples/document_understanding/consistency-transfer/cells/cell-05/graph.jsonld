      "rkaf:fragmentContentDigest": "sha256:395af53e32973a32b4a259da50772d3c485d64a0fb2ad331c35e783f78f3e0e0",
      "rkaf:selectorKind": [
        "oa:TextQuoteSelector",
        "oa:TextPositionSelector"
      ],
      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "No, OSHA considers the treatments listed in § 1904.7(b)(5)(ii) of this part to be first aid regardless of the professional status of the person providing the treatment. Even when these treatments are provided by a physician or other licensed health care professional, they are considered first aid for the purposes of part 1904."
        },
        {
          "@type": "oa:TextPositionSelector",
          "oa:start": 16419,
          "oa:end": 16747,
          "rkaf:coordinateSystem": "rkaf:unicode-codepoint"
        }
      ]
    },

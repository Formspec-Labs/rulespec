      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"kind\":\"statement\",\"modality\":\"not_stated\",\"summary\":\"Restricted work occurs when, as the result of a work-related injury or illness: (A) you keep the employee from performing one or more of the routine functions of his or her job, or from working the full workday that he or she would otherwise have been scheduled to work; or (B) a physician or other licensed health care professional recommends that the employee not perform one or more of the routine functions of his or her job, or not work the full workday that he or she would otherwise have been scheduled to work.\"}",
        "@type": "xsd:string"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

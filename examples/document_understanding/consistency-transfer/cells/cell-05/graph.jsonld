    {
      "@id": "urn:rulespec:document-understanding:revision:0da1f0b7b405fdcf3770ea9ead2cd7230dd88b925cb746c1ea1d7da732ba6fd5",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:0da1f0b7b405fdcf3770ea9ead2cd7230dd88b925cb746c1ea1d7da732ba6fd5",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:bf744527e4c0ef197b204a9ee4c89c1d0865e64bd92feec11aca6ed57a78288c",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:7163d02905544cbef2a510f3626a0658634f0520de9d9700f729f47e6aa88b7c\",\"urn:rulespec:document-understanding:assertion:e9edd45024dfd8c8f464f3235b8e7428be5d90b7c3fa2b6a16578664dafe8faf\",\"urn:rulespec:document-understanding:assertion:444cac2fd1dc271252b0b27d986f31b45ab68ecd88bc0f84e6190199d1844ec8\",\"urn:rulespec:document-understanding:assertion:8662626c471e5d4596161107dcd454a4dc846b96a43b814dea023c24b94fa7c8\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[\"(iv) Does the professional status of the person providing the treatment have any effect on what is considered first aid or medical treatment?\"],\"defined_terms\":[],\"effective_periods\":[],\"end\":16747,\"evidence\":[{\"end\":16747,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:16419:16747:sha256-395af53e32973a32b4a259da50772d3c485d64a0fb2ad331c35e783f78f3e0e0\",\"quote\":\"No, OSHA considers the treatments listed in § 1904.7(b)(5)(ii) of this part to be first aid regardless of the professional status of the person providing the treatment. Even when these treatments are provided by a physician or other licensed health care professional, they are considered first aid for the purposes of part 1904.\",\"start\":16419},{\"end\":16418,\"field\":\"context:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:16277:16418:sha256-1a83082ddfb1915102bb96529057986e17aff1d050d42d60352bd4796615e821\",\"quote\":\"(iv) Does the professional status of the person providing the treatment have any effect on what is considered first aid or medical treatment?\",\"start\":16277}],\"id\":\"urn:rulespec:document-understanding:revision:0da1f0b7b405fdcf3770ea9ead2cd7230dd88b925cb746c1ea1d7da732ba6fd5\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"statement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:444cac2fd1dc271252b0b27d986f31b45ab68ecd88bc0f84e6190199d1844ec8\",\"modality\":\"not_stated\",\"modality_quote\":\"\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:8e41fd154363b4dff522649ffd55401cdb60c926ff19fe0f34cd00b07826d02f\",\"origin\":\"aiSuggested\",\"quote\":\"No, OSHA considers the treatments listed in § 1904.7(b)(5)(ii) of this part to be first aid regardless of the professional status of the person providing the treatment. Even when these treatments are provided by a physician or other licensed health care professional, they are considered first aid for the purposes of part 1904.\",\"references\":[\"§ 1904.7(b)(5)(ii)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:639c5f367da7e17ca10d7131033c0687670395b75fc5bdd24053e9944729d50e\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":16419,\"summary\":\"OSHA considers the treatments listed in § 1904.7(b)(5)(ii) to be first aid regardless of the professional status of the person providing the treatment, and even when these treatments are provided by a physician or other licensed health care professional, they are considered first aid for the purposes of part 1904.\",\"target_ids\":[],\"term_refs\":[\"urn:rulespec:document-understanding:term:54ecd44f7f9b3e82125581631d51f7e6c8ed5c3a8c949f77619cf70d2943591a\"],\"typed_values\":[]}",

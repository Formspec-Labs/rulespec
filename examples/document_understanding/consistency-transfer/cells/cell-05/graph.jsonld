      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:e09329073992333e9e86943ec50aa1b6b13e11abfcaa541218636b497671d175\",\"urn:rulespec:document-understanding:assertion:2f93a4a895e179f26f6b2132d858c0cfeeca83a7ac0b6024689ca31a97577f9f\",\"urn:rulespec:document-understanding:assertion:4550cfbe7374cbdb7c2613f8b5d659b78b62fc927fdda6d1c8fe73d3ee50682b\",\"urn:rulespec:document-understanding:assertion:49747a5102cb02dfcf06f13a3e1440806913bf9a4ffb8b2fdda97f83cf81a73d\",\"urn:rulespec:document-understanding:assertion:e6cebbbb39570861eb76b02013ff88a11d12871dde1b50cb9da512fe9989f225\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[\"(i) What is the definition of medical treatment?\"],\"defined_terms\":[{\"aliases\":[],\"id\":\"urn:rulespec:document-understanding:term:b28bf9130fb325d9e129ea811c670aaf97099491d4623444437dd0b22115ccdb\",\"label\":\"medical treatment\",\"quote\":\"“Medical treatment” means the management and care of a patient to combat disease or disorder. For the purposes of part 1904, medical treatment does not include:\\n\\n(A) Visits to a physician or other licensed health care professional solely for observation or counseling;\\n\\n(B) The conduct of diagnostic procedures, such as x-rays and blood tests, including the administration of prescription medications used solely for diagnostic purposes ( e.g., eye drops to dilate pupils); or\\n\\n(C) “First aid” as defined in paragraph (b)(5)(ii) of this section.\",\"source_quotes\":[\"“Medical treatment” means the management and care of a patient to combat disease or disorder.\",\"For the purposes of part 1904, medical treatment does not include:\",\"(A) Visits to a physician or other licensed health care professional solely for observation or counseling;\",\"(B) The conduct of diagnostic procedures, such as x-rays and blood tests, including the administration of prescription medications used solely for diagnostic purposes ( e.\",\"g.\",\", eye drops to dilate pupils); or\",\"(C) “First aid” as defined in paragraph (b)(5)(ii) of this section.\"]}],\"effective_periods\":[],\"end\":14298,\"evidence\":[{\"end\":14298,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:13753:14298:sha256-aba8e2c1264251c8c53cf7a625268487e0aef85d34916179b4617ee49f47db63\",\"quote\":\"“Medical treatment” means the management and care of a patient to combat disease or disorder. For the purposes of part 1904, medical treatment does not include:\\n\\n(A) Visits to a physician or other licensed health care professional solely for observation or counseling;\\n\\n(B) The conduct of diagnostic procedures, such as x-rays and blood tests, including the administration of prescription medications used solely for diagnostic purposes ( e.g., eye drops to dilate pupils); or\\n\\n(C) “First aid” as defined in paragraph (b)(5)(ii) of this section.\",\"start\":13753},{\"end\":13752,\"field\":\"context:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:13704:13752:sha256-1ed46b582fce9b1e0adc9eba535d28071e50fb9fb9bbe03f5691a792f9385e7c\",\"quote\":\"(i) What is the definition of medical treatment?\",\"start\":13704},{\"end\":14298,\"field\":\"defined_terms:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:13753:14298:sha256-aba8e2c1264251c8c53cf7a625268487e0aef85d34916179b4617ee49f47db63\",\"quote\":\"“Medical treatment” means the management and care of a patient to combat disease or disorder. For the purposes of part 1904, medical treatment does not include:\\n\\n(A) Visits to a physician or other licensed health care professional solely for observation or counseling;\\n\\n(B) The conduct of diagnostic procedures, such as x-rays and blood tests, including the administration of prescription medications used solely for diagnostic purposes ( e.g., eye drops to dilate pupils); or\\n\\n(C) “First aid” as defined in paragraph (b)(5)(ii) of this section.\",\"start\":13753},{\"end\":13846,\"field\":\"defined_terms:0:source:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:13753:13846:sha256-4ca37e3425c34d14fda2378d10f129229d416d0115d76b87162c4fd1d591dc8c\",\"quote\":\"“Medical treatment” means the management and care of a patient to combat disease or disorder.\",\"start\":13753},{\"end\":13913,\"field\":\"defined_terms:0:source:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:13847:13913:sha256-65fa770a1f53a61f828d144a2b833f6770cc17bcaa10f5188f68423a3387f640\",\"quote\":\"For the purposes of part 1904, medical treatment does not include:\",\"start\":13847},{\"end\":14021,\"field\":\"defined_terms:0:source:2\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:13915:14021:sha256-b70f569ca2b3331942c577b921278fc28fe4e1e5a6e0019d9807039533911938\",\"quote\":\"(A) Visits to a physician or other licensed health care professional solely for observation or counseling;\",\"start\":13915},{\"end\":14194,\"field\":\"defined_terms:0:source:3\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:14023:14194:sha256-78e4018161a43f3e3357f01ea66a667168f4fb6722381101833972dee2c8e2b0\",\"quote\":\"(B) The conduct of diagnostic procedures, such as x-rays and blood tests, including the administration of prescription medications used solely for diagnostic purposes ( e.\",\"start\":14023},{\"end\":14196,\"field\":\"defined_terms:0:source:4\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:14194:14196:sha256-fc3a6817bd40089b33ad3d1f28b33c79e99f90a060dec16e04bd19da27d90fbf\",\"quote\":\"g.\",\"start\":14194},{\"end\":14229,\"field\":\"defined_terms:0:source:5\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:14196:14229:sha256-d0a5cc14517f13edee2c8a032fa7c27cb4be3d842882be082f63bb8e56db6f4b\",\"quote\":\", eye drops to dilate pupils); or\",\"start\":14196},{\"end\":14298,\"field\":\"defined_terms:0:source:6\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:14231:14298:sha256-9c53b6788e2f7a07f9e607185720ddf695ed3305eb7b82f00f2e51dc50caba06\",\"quote\":\"(C) “First aid” as defined in paragraph (b)(5)(ii) of this section.\",\"start\":14231}],\"id\":\"urn:rulespec:document-understanding:revision:5b384e36fa8ce56a70a23a7ab5311837cb0d1712b229eb2f90056a4aaae09422\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"definition\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:4550cfbe7374cbdb7c2613f8b5d659b78b62fc927fdda6d1c8fe73d3ee50682b\",\"modality\":\"not_stated\",\"modality_quote\":\"\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:73b15a4ec5ad578be4821c202970edd98cbe83000334fb4d625839c13ea75919\",\"origin\":\"aiSuggested\",\"quote\":\"“Medical treatment” means the management and care of a patient to combat disease or disorder. For the purposes of part 1904, medical treatment does not include:\\n\\n(A) Visits to a physician or other licensed health care professional solely for observation or counseling;\\n\\n(B) The conduct of diagnostic procedures, such as x-rays and blood tests, including the administration of prescription medications used solely for diagnostic purposes ( e.g., eye drops to dilate pupils); or\\n\\n(C) “First aid” as defined in paragraph (b)(5)(ii) of this section.\",\"references\":[\"paragraph (b)(5)(ii)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:171b219d2e63b9d70df7aa9384400f325748c762e883e2810fa08fe4001c2ab3\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":13753,\"summary\":\"“Medical treatment” means the management and care of a patient to combat disease or disorder; for the purposes of part 1904, medical treatment does not include: (A) visits to a physician or other licensed health care professional solely for observation or counseling; (B) the conduct of diagnostic procedures, such as x-rays and blood tests, including the administration of prescription medications used solely for diagnostic purposes (e.g., eye drops to dilate pupils); or (C) “first aid” as defined in paragraph (b)(5)(ii) of this section.\",\"target_ids\":[],\"term_refs\":[\"urn:rulespec:document-understanding:term:54ecd44f7f9b3e82125581631d51f7e6c8ed5c3a8c949f77619cf70d2943591a\"],\"typed_values\":[]}",

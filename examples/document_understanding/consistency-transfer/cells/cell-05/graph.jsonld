      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "You need to record this case only if you receive information from a physician or other licensed health care professional indicating that the employee should not have worked, or should have performed only restricted work, during the weekend. If so, you must record the injury or illness as a case with days away from work or restricted work, and enter the day counts, as appropriate."
        },
        {
          "@type": "oa:TextPositionSelector",
          "oa:start": 4319,
          "oa:end": 4701,
          "rkaf:coordinateSystem": "rkaf:unicode-codepoint"

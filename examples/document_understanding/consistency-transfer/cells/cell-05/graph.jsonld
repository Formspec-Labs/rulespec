    {
      "@id": "urn:rulespec:document-understanding:revision:09e1f650ea88ed5733610904deaeb2aefd336709121071eaac558a85743360b8",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:09e1f650ea88ed5733610904deaeb2aefd336709121071eaac558a85743360b8",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:f36818b30493045182d72a8f522e7d783af83c6e11b9d1b4577072f37cb37cbf",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:056c31a49d79d507b81f05a4e0b1f5520944daee634784aeff09a0a8862950e9\",\"urn:rulespec:document-understanding:assertion:81ca824238ca74e83a4f40a4920c06bba4b80be63af4d5c9e7e1b75ff9482290\",\"urn:rulespec:document-understanding:assertion:f31dd6dcd421c355476bdfd7708ea2003eac464414afd17a4c6312dbad500f53\",\"urn:rulespec:document-understanding:assertion:4a520e38476338a260c796f19b7aea0747fd37f215bed3a794a390768e4c4bde\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[\"(ii) What is “first aid”?\",\"(iii) Are any other procedures included in first aid?\"],\"defined_terms\":[{\"aliases\":[],\"id\":\"urn:rulespec:document-understanding:term:54ecd44f7f9b3e82125581631d51f7e6c8ed5c3a8c949f77619cf70d2943591a\",\"label\":\"first aid\",\"quote\":\"For the purposes of part 1904, “first aid” means the following:\\n\\n(A) Using a non-prescription medication at nonprescription strength (for medications available in both prescription and non-prescription form, a recommendation by a physician or other licensed health care professional to use a non-prescription medication at prescription strength is considered medical treatment for recordkeeping purposes);\\n\\n(B) Administering tetanus immunizations (other immunizations, such as Hepatitis B vaccine or rabies vaccine, are considered medical treatment);\\n\\n(C) Cleaning, flushing or soaking wounds on the surface of the skin;\\n\\n(D) Using wound coverings such as bandages, Band-Aids TM , gauze pads, etc.; or using butterfly bandages or Steri-Strips TM (other wound closing devices such as sutures, staples, etc., are considered medical treatment);\\n\\n(E) Using hot or cold therapy;\\n\\n(F) Using any non-rigid means of support, such as elastic bandages, wraps, non-rigid back belts, etc. (devices with rigid stays or other systems designed to immobilize parts of the body are considered medical treatment for recordkeeping purposes);\\n\\n(G) Using temporary immobilization devices while transporting an accident victim ( e.g., splints, slings, neck collars, back boards, etc.).\\n\\n(H) Drilling of a fingernail or toenail to relieve pressure, or draining fluid from a blister;\\n\\n(I) Using eye patches;\\n\\n(J) Removing foreign bodies from the eye using only irrigation or a cotton swab;\\n\\n(K) Removing splinters or foreign material from areas other than the eye by irrigation, tweezers, cotton swabs or other simple means;\\n\\n(L) Using finger guards;\\n\\n(M) Using massages (physical therapy or chiropractic treatment are considered medical treatment for recordkeeping purposes); or\\n\\n(N) Drinking fluids for relief of heat stress.\\n\\n(iii) Are any other procedures included in first aid? No, this is a complete list of all treatments considered first aid for part 1904 purposes.\",\"source_quotes\":[\"For the purposes of part 1904, “first aid” means the following:\",\"(A) Using a non-prescription medication at nonprescription strength (for medications available in both prescription and non-prescription form, a recommendation by a physician or other licensed health care professional to use a non-prescription medication at prescription strength is considered medical treatment for recordkeeping purposes);\",\"(B) Administering tetanus immunizations (other immunizations, such as Hepatitis B vaccine or rabies vaccine, are considered medical treatment);\",\"(C) Cleaning, flushing or soaking wounds on the surface of the skin;\",\"(D) Using wound coverings such as bandages, Band-Aids TM , gauze pads, etc.\",\"; or using butterfly bandages or Steri-Strips TM (other wound closing devices such as sutures, staples, etc.\",\", are considered medical treatment);\",\"(E) Using hot or cold therapy;\",\"(F) Using any non-rigid means of support, such as elastic bandages, wraps, non-rigid back belts, etc.\",\"(devices with rigid stays or other systems designed to immobilize parts of the body are considered medical treatment for recordkeeping purposes);\",\"(G) Using temporary immobilization devices while transporting an accident victim ( e.\",\"g.\",\", splints, slings, neck collars, back boards, etc.)\",\".\",\"(H) Drilling of a fingernail or toenail to relieve pressure, or draining fluid from a blister;\",\"(I) Using eye patches;\",\"(J) Removing foreign bodies from the eye using only irrigation or a cotton swab;\",\"(K) Removing splinters or foreign material from areas other than the eye by irrigation, tweezers, cotton swabs or other simple means;\",\"(L) Using finger guards;\",\"(M) Using massages (physical therapy or chiropractic treatment are considered medical treatment for recordkeeping purposes); or\",\"(N) Drinking fluids for relief of heat stress.\",\"No, this is a complete list of all treatments considered first aid for part 1904 purposes.\"]}],\"effective_periods\":[],\"end\":16275,\"evidence\":[{\"end\":16275,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:14326:16275:sha256-22ba3ae2b13adb1054507ed6b4c49305a2c33021b2b5d6f5be5309b790de646a\",\"quote\":\"For the purposes of part 1904, “first aid” means the following:\\n\\n(A) Using a non-prescription medication at nonprescription strength (for medications available in both prescription and non-prescription form, a recommendation by a physician or other licensed health care professional to use a non-prescription medication at prescription strength is considered medical treatment for recordkeeping purposes);\\n\\n(B) Administering tetanus immunizations (other immunizations, such as Hepatitis B vaccine or rabies vaccine, are considered medical treatment);\\n\\n(C) Cleaning, flushing or soaking wounds on the surface of the skin;\\n\\n(D) Using wound coverings such as bandages, Band-Aids TM , gauze pads, etc.; or using butterfly bandages or Steri-Strips TM (other wound closing devices such as sutures, staples, etc., are considered medical treatment);\\n\\n(E) Using hot or cold therapy;\\n\\n(F) Using any non-rigid means of support, such as elastic bandages, wraps, non-rigid back belts, etc. (devices with rigid stays or other systems designed to immobilize parts of the body are considered medical treatment for recordkeeping purposes);\\n\\n(G) Using temporary immobilization devices while transporting an accident victim ( e.g., splints, slings, neck collars, back boards, etc.).\\n\\n(H) Drilling of a fingernail or toenail to relieve pressure, or draining fluid from a blister;\\n\\n(I) Using eye patches;\\n\\n(J) Removing foreign bodies from the eye using only irrigation or a cotton swab;\\n\\n(K) Removing splinters or foreign material from areas other than the eye by irrigation, tweezers, cotton swabs or other simple means;\\n\\n(L) Using finger guards;\\n\\n(M) Using massages (physical therapy or chiropractic treatment are considered medical treatment for recordkeeping purposes); or\\n\\n(N) Drinking fluids for relief of heat stress.\\n\\n(iii) Are any other procedures included in first aid? No, this is a complete list of all treatments considered first aid for part 1904 purposes.\",\"start\":14326},{\"end\":14325,\"field\":\"context:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:14300:14325:sha256-f0e7c5257798c239b2f7b7d3ab50b38b0ac960851e6c0b9bdf48dc339313774a\",\"quote\":\"(ii) What is “first aid”?\",\"start\":14300},{\"end\":16184,\"field\":\"context:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:16131:16184:sha256-caa8df6ca1d7e404135de2fbab77948abd9e04e99cbd6862d795c72d3aef6aa2\",\"quote\":\"(iii) Are any other procedures included in first aid?\",\"start\":16131},{\"end\":16275,\"field\":\"defined_terms:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:14326:16275:sha256-22ba3ae2b13adb1054507ed6b4c49305a2c33021b2b5d6f5be5309b790de646a\",\"quote\":\"For the purposes of part 1904, “first aid” means the following:\\n\\n(A) Using a non-prescription medication at nonprescription strength (for medications available in both prescription and non-prescription form, a recommendation by a physician or other licensed health care professional to use a non-prescription medication at prescription strength is considered medical treatment for recordkeeping purposes);\\n\\n(B) Administering tetanus immunizations (other immunizations, such as Hepatitis B vaccine or rabies vaccine, are considered medical treatment);\\n\\n(C) Cleaning, flushing or soaking wounds on the surface of the skin;\\n\\n(D) Using wound coverings such as bandages, Band-Aids TM , gauze pads, etc.; or using butterfly bandages or Steri-Strips TM (other wound closing devices such as sutures, staples, etc., are considered medical treatment);\\n\\n(E) Using hot or cold therapy;\\n\\n(F) Using any non-rigid means of support, such as elastic bandages, wraps, non-rigid back belts, etc. (devices with rigid stays or other systems designed to immobilize parts of the body are considered medical treatment for recordkeeping purposes);\\n\\n(G) Using temporary immobilization devices while transporting an accident victim ( e.g., splints, slings, neck collars, back boards, etc.).\\n\\n(H) Drilling of a fingernail or toenail to relieve pressure, or draining fluid from a blister;\\n\\n(I) Using eye patches;\\n\\n(J) Removing foreign bodies from the eye using only irrigation or a cotton swab;\\n\\n(K) Removing splinters or foreign material from areas other than the eye by irrigation, tweezers, cotton swabs or other simple means;\\n\\n(L) Using finger guards;\\n\\n(M) Using massages (physical therapy or chiropractic treatment are considered medical treatment for recordkeeping purposes); or\\n\\n(N) Drinking fluids for relief of heat stress.\\n\\n(iii) Are any other procedures included in first aid? No, this is a complete list of all treatments considered first aid for part 1904 purposes.\",\"start\":14326},{\"end\":14389,\"field\":\"defined_terms:0:source:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:14326:14389:sha256-5639f26f3f021958d07bb87963f48ba755727265465c9e537024faa4a1600bee\",\"quote\":\"For the purposes of part 1904, “first aid” means the following:\",\"start\":14326},{\"end\":14731,\"field\":\"defined_terms:0:source:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:14391:14731:sha256-ec4c4b8620b0caef185b4dce602b17b4a12d8af05ef643172394ee9e80397a09\",\"quote\":\"(A) Using a non-prescription medication at nonprescription strength (for medications available in both prescription and non-prescription form, a recommendation by a physician or other licensed health care professional to use a non-prescription medication at prescription strength is considered medical treatment for recordkeeping purposes);\",\"start\":14391},{\"end\":14876,\"field\":\"defined_terms:0:source:2\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:14733:14876:sha256-b151ed9d16a6e3dcb87c84f4056a2344648fc8e63e8fe96fd6ccc1667ceeaa20\",\"quote\":\"(B) Administering tetanus immunizations (other immunizations, such as Hepatitis B vaccine or rabies vaccine, are considered medical treatment);\",\"start\":14733},{\"end\":14946,\"field\":\"defined_terms:0:source:3\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:14878:14946:sha256-bda6594dee4849388f5b00147a2262c644ea20d9010300c7810b61ebf0d46ab5\",\"quote\":\"(C) Cleaning, flushing or soaking wounds on the surface of the skin;\",\"start\":14878},{\"end\":15023,\"field\":\"defined_terms:0:source:4\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:14948:15023:sha256-24ccf7d1a5ea65fff7cf669da797e842a81b13302a741bace53c4172dba799f1\",\"quote\":\"(D) Using wound coverings such as bandages, Band-Aids TM , gauze pads, etc.\",\"start\":14948},{\"end\":15131,\"field\":\"defined_terms:0:source:5\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:15023:15131:sha256-243f2b312b37d0894669adab4c7eebfb63ca3bec3961397841677c69c85bb696\",\"quote\":\"; or using butterfly bandages or Steri-Strips TM (other wound closing devices such as sutures, staples, etc.\",\"start\":15023},{\"end\":15199,\"field\":\"defined_terms:0:source:7\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:15169:15199:sha256-5059e62c2c1908b30ab867c0a432f0514c9313744badb8a020ce8c418f779c68\",\"quote\":\"(E) Using hot or cold therapy;\",\"start\":15169},{\"end\":15302,\"field\":\"defined_terms:0:source:8\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:15201:15302:sha256-3c3c911f42446d97cb115b3dbca2b5dbede1d1daacedddfbcc9587be322610f7\",\"quote\":\"(F) Using any non-rigid means of support, such as elastic bandages, wraps, non-rigid back belts, etc.\",\"start\":15201},{\"end\":15448,\"field\":\"defined_terms:0:source:9\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:15303:15448:sha256-d101881e44ae7ec47960a081a82a928286c308b6c4c0f05b2f570906ca126e7e\",\"quote\":\"(devices with rigid stays or other systems designed to immobilize parts of the body are considered medical treatment for recordkeeping purposes);\",\"start\":15303},{\"end\":15535,\"field\":\"defined_terms:0:source:10\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:15450:15535:sha256-a0e2d6dc366098e66da057c18e65b0733bd3c0327ae92cdfd437203308450b3a\",\"quote\":\"(G) Using temporary immobilization devices while transporting an accident victim ( e.\",\"start\":15450},{\"end\":15537,\"field\":\"defined_terms:0:source:11\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:15535:15537:sha256-fc3a6817bd40089b33ad3d1f28b33c79e99f90a060dec16e04bd19da27d90fbf\",\"quote\":\"g.\",\"start\":15535},{\"end\":15588,\"field\":\"defined_terms:0:source:12\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:15537:15588:sha256-a176b7b2e7bd4ee899a230018b9ab734f0267297a00b564021fe1b6362b80aad\",\"quote\":\", splints, slings, neck collars, back boards, etc.)\",\"start\":15537},{\"end\":15685,\"field\":\"defined_terms:0:source:14\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:15591:15685:sha256-663987583d7f2bb3403c2e8e31a6f6cc3877cb7290ddaad6432c17258720d221\",\"quote\":\"(H) Drilling of a fingernail or toenail to relieve pressure, or draining fluid from a blister;\",\"start\":15591},{\"end\":15709,\"field\":\"defined_terms:0:source:15\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:15687:15709:sha256-f1bd5ae74e274e04aaa6b176294ea21ef45f0214417f87445d412945c4896588\",\"quote\":\"(I) Using eye patches;\",\"start\":15687},{\"end\":15791,\"field\":\"defined_terms:0:source:16\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:15711:15791:sha256-abf176442bf48cabcb830797562fbc5c0ee4e356e3df146256f6612be5fd1aa6\",\"quote\":\"(J) Removing foreign bodies from the eye using only irrigation or a cotton swab;\",\"start\":15711},{\"end\":15926,\"field\":\"defined_terms:0:source:17\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:15793:15926:sha256-3124e89673d5602949535c1114ea6dd30226db33f33f8ee9d56e20d49ed0db83\",\"quote\":\"(K) Removing splinters or foreign material from areas other than the eye by irrigation, tweezers, cotton swabs or other simple means;\",\"start\":15793},{\"end\":15952,\"field\":\"defined_terms:0:source:18\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:15928:15952:sha256-7b1469fb171efc8956fb4f1d55459e112b65f9402e759f3be8af5ae35dd6e64b\",\"quote\":\"(L) Using finger guards;\",\"start\":15928},{\"end\":16081,\"field\":\"defined_terms:0:source:19\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:15954:16081:sha256-3db15d6f51fdd21ca0336afaad4072d629dd8554037dcd222243bc8798c33d91\",\"quote\":\"(M) Using massages (physical therapy or chiropractic treatment are considered medical treatment for recordkeeping purposes); or\",\"start\":15954},{\"end\":16129,\"field\":\"defined_terms:0:source:20\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:16083:16129:sha256-20606de3367ac5f078d9cd3d6397e104dde63e894eb5cefa8be6fd15b6b9e3ef\",\"quote\":\"(N) Drinking fluids for relief of heat stress.\",\"start\":16083},{\"end\":16275,\"field\":\"defined_terms:0:source:21\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:16185:16275:sha256-c9b58ff785fd7a3c62c9b3e160be39a68750b308aff37804dea1a0950e7646ec\",\"quote\":\"No, this is a complete list of all treatments considered first aid for part 1904 purposes.\",\"start\":16185}],\"id\":\"urn:rulespec:document-understanding:revision:09e1f650ea88ed5733610904deaeb2aefd336709121071eaac558a85743360b8\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"definition\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:f31dd6dcd421c355476bdfd7708ea2003eac464414afd17a4c6312dbad500f53\",\"modality\":\"not_stated\",\"modality_quote\":\"\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:5b2f9b93e8984c37e0528489fe35138f84c5dd1a1dd26966117154363920df0c\",\"origin\":\"aiSuggested\",\"quote\":\"For the purposes of part 1904, “first aid” means the following:\\n\\n(A) Using a non-prescription medication at nonprescription strength (for medications available in both prescription and non-prescription form, a recommendation by a physician or other licensed health care professional to use a non-prescription medication at prescription strength is considered medical treatment for recordkeeping purposes);\\n\\n(B) Administering tetanus immunizations (other immunizations, such as Hepatitis B vaccine or rabies vaccine, are considered medical treatment);\\n\\n(C) Cleaning, flushing or soaking wounds on the surface of the skin;\\n\\n(D) Using wound coverings such as bandages, Band-Aids TM , gauze pads, etc.; or using butterfly bandages or Steri-Strips TM (other wound closing devices such as sutures, staples, etc., are considered medical treatment);\\n\\n(E) Using hot or cold therapy;\\n\\n(F) Using any non-rigid means of support, such as elastic bandages, wraps, non-rigid back belts, etc. (devices with rigid stays or other systems designed to immobilize parts of the body are considered medical treatment for recordkeeping purposes);\\n\\n(G) Using temporary immobilization devices while transporting an accident victim ( e.g., splints, slings, neck collars, back boards, etc.).\\n\\n(H) Drilling of a fingernail or toenail to relieve pressure, or draining fluid from a blister;\\n\\n(I) Using eye patches;\\n\\n(J) Removing foreign bodies from the eye using only irrigation or a cotton swab;\\n\\n(K) Removing splinters or foreign material from areas other than the eye by irrigation, tweezers, cotton swabs or other simple means;\\n\\n(L) Using finger guards;\\n\\n(M) Using massages (physical therapy or chiropractic treatment are considered medical treatment for recordkeeping purposes); or\\n\\n(N) Drinking fluids for relief of heat stress.\\n\\n(iii) Are any other procedures included in first aid? No, this is a complete list of all treatments considered first aid for part 1904 purposes.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:fb265a06bef7fe376d68b80dd36fc98903b5698f8dcfb370b279656c48eea218\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":14326,\"summary\":\"For the purposes of part 1904, “first aid” means the complete list of treatments consisting of: (A) using a non-prescription medication at nonprescription strength (for medications available in both prescription and non-prescription form, a recommendation by a physician or other licensed health care professional to use a non-prescription medication at prescription strength is considered medical treatment for recordkeeping purposes); (B) administering tetanus immunizations (other immunizations, such as Hepatitis B vaccine or rabies vaccine, are considered medical treatment); (C) cleaning, flushing or soaking wounds on the surface of the skin; (D) using wound coverings such as bandages, Band-Aids TM, gauze pads, etc.; or using butterfly bandages or Steri-Strips TM (other wound closing devices such as sutures, staples, etc., are considered medical treatment); (E) using hot or cold therapy; (F) using any non-rigid means of support, such as elastic bandages, wraps, non-rigid back belts, etc. (devices with rigid stays or other systems designed to immobilize parts of the body are considered medical treatment for recordkeeping purposes); (G) using temporary immobilization devices while transporting an accident victim (e.g., splints, slings, neck collars, back boards, etc.); (H) drilling of a fingernail or toenail to relieve pressure, or draining fluid from a blister; (I) using eye patches; (J) removing foreign bodies from the eye using only irrigation or a cotton swab; (K) removing splinters or foreign material from areas other than the eye by irrigation, tweezers, cotton swabs or other simple means; (L) using finger guards; (M) using massages (physical therapy or chiropractic treatment are considered medical treatment for recordkeeping purposes); or (N) drinking fluids for relief of heat stress. No other procedures are included in first aid.\",\"target_ids\":[],\"term_refs\":[\"urn:rulespec:document-understanding:term:b28bf9130fb325d9e129ea811c670aaf97099491d4623444437dd0b22115ccdb\"],\"typed_values\":[]}",

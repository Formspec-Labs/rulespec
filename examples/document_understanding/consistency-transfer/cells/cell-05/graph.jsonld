      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"actor\":\"you\",\"kind\":\"requirement\",\"modality\":\"must\",\"scope_text\":\"in which a worker is injured or becomes ill on a Friday and reports to work on a Monday, and was not scheduled to work on the weekend\",\"summary\":\"In a case in which a worker is injured or becomes ill on a Friday and reports to work on a Monday, and was not scheduled to work on the weekend, you need to record this case only if you receive information from a physician or other licensed health care professional indicating that the employee should not have worked, or should have performed only restricted work, during the weekend; if so, you must record the injury or illness as a case with days away from work or restricted work, and enter the day counts, as appropriate.\"}",
        "@type": "xsd:string"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed",
      "rkaf:hasApplicability": "urn:rulespec:document-understanding:scope:d2ffe2c8324a65822432b6c7cb0d344ffb946325144f1d4e0af0cd40e36fde92"

      "dcterms:description": "{\"action\":\"\",\"actor\":\"you\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:fe98aed5abe8b0d0fdd3b15e0d5478cdcf2c062d3b6cd398df10ab096cf98ca9\",\"urn:rulespec:document-understanding:assertion:9c9e662b63a4d2f64e6b94a1a3544122729a45b0fc6c70d1e1809e6a50b7e71c\",\"urn:rulespec:document-understanding:assertion:e603f080701e0bbad6e93647495eaf5370904ac46893d8bc71cc04c90e95d7c8\",\"urn:rulespec:document-understanding:assertion:4eda4f56f115e13c1a39ae7be94c8b27469a176b8f5553e66fade4e82d6902f0\",\"urn:rulespec:document-understanding:assertion:21970c4ee5b7eb9ff0bb195090762561c4038a8e1e32d99f8aa2991f6290a0a2\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[\"(viii) May I stop counting days if an employee who is away from work because of an injury or illness retires or leaves my company?\"],\"defined_terms\":[],\"effective_periods\":[],\"end\":6078,\"evidence\":[{\"end\":6078,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:5846:6078:sha256-8433f545ee4f752c4b4e17d845533c84f97b7eda5be1a99be1d5ab71d688de0e\",\"quote\":\"Yes, if the employee leaves your company for some reason unrelated to the injury or illness, such as retirement, a plant closing, or to take another job, you may stop counting days away from work or days of restriction/job transfer.\",\"start\":5846},{\"end\":6007,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:6004:6007:sha256-ee4d988c65de860fabbfbcd27f73d50bbebe3fba37fe419284f4811389c30bdc\",\"quote\":\"may\",\"start\":6004},{\"end\":6078,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b456
    {
      "@id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:16419:16747:sha256-395af53e32973a32b4a259da50772d3c485d64a0fb2ad331c35e783f78f3e0e0",

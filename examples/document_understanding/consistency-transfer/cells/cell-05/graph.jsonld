      "rkaf:assertsValue": {
        "@value": "{\"actor\":\"you\",\"kind\":\"requirement\",\"modality\":\"must\",\"scope_text\":\"If the employee is still away from work because of the injury or illness when you prepare the annual summary\",\"summary\":\"If the employee is still away from work because of the injury or illness when you prepare the annual summary, estimate the total number of calendar days you expect the employee to be away from work, use this number to calculate the total for the annual summary, and then update the initial log entry later when the day count is known or reaches the 180-day cap.\"}",
        "@type": "xsd:string"
      },

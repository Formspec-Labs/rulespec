      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"you\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:7486f4397ca8307e85d214894bc9a7518a8886a154adee77a4863db14e0964a7\",\"urn:rulespec:document-understanding:assertion:5672eb683de38af986a0cc5ad068b5f1ac4b3eff32048faafa331e13de7dfa77\",\"urn:rulespec:document-understanding:assertion:93108c6b26c875957aa4091fe98a7abbaac099a38f1df501540e766621e113a0\",\"urn:rulespec:document-understanding:assertion:b48d8498deda78f18fa4d1bfa9fdc6b5f6ec91c765f9d2ff459f08115d9e8205\",\"urn:rulespec:document-understanding:assertion:7a9dbcb1c913d2e9810aac40366786886722e2fb00272013880e4ac8388308c3\",\"urn:rulespec:document-understanding:assertion:a9d2bea2dabeccb9ed167da660fcabefb0d260dc56bbf309d36c94e78e79f81b\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":13099,\"evidence\":[{\"end\":13099,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:12789:13099:sha256-f6125da25dd5b0ab7e813aa786361d5994d13482ed211fd1a36f47c207cf2f29\",\"quote\":\"The only difference is that, if you permanently assign the injured or ill employee to a job that has been modified or permanently changed in a manner that eliminates the routine functions the employee was restricted from performing, you may stop the day count when the modification or change is made permanent.\",\"start\":12789},{\"end\":13029,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:13026:13029:sha256-ee4d988c65de860fabbfbcd27f73d50bbebe3fba37fe419284f4811389c30bdc\",\"quote\":\"may\",\"start\":13026},{\"end\":13099,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment
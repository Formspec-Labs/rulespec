      "dcterms:description": "{\"action\":\"\",\"actor\":\"you\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:605c31ce82bfcdf6014c9a7cd5012774fa7e6092b8568054ed1618edc3f6ef12\",\"urn:rulespec:document-understanding:assertion:0b4b5007f9fb37ae85b7414eb2b10295f2fc5ee32ce5bce399df29c647f09be3\",\"urn:rulespec:document-understanding:assertion:80961c3326970cbe4d1351fcb2daf432d44a901ac38ab2fdfdbf6b0ac259b79c\",\"urn:rulespec:document-understanding:assertion:c5065ba554742a378d658f6d248bdbed2a067433b4e87fcc4711408ad7bcea4d\",\"urn:rulespec:document-understanding:assertion:d3f7b994ee3e219d5e673a7e5b9121d55d1e7443e0df1643360e71093f9c90ad\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"defined_terms\":[],\"effective_periods\":[],\"end\":5284,\"evidence\":[{\"end\":5284,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:4881:5284:sha256-ea8fb513f5a9046f7ca2bba46d353fc026c622d6faafa786ce8af435c6e1cf7d\",\"quote\":\"You need to record a case of this type only if you receive information from a physician or other licensed health care professional indicating that the employee should not have worked, or should have performed only restricted work, during the scheduled time off. If so, you must record the injury or illness as a case with days away from work or restricted work, and enter the day counts, as appropriate.\",\"start\":4881},{\"end\":5158,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A4d53ee5bb82b4562bf890b41c6bf9c154ada3917edc5705a3a91d12a43964493:5154:5158:sha256-4137b01e139589b7a1d3b3fc4da031d8ce5bb415808734e970c3a58ea0e98f0f\",\"quote\":\"must\",\"start\":5154},{\"end\":4880,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-unde
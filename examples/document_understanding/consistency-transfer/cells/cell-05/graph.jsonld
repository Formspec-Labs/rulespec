      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "When an injury or illness involves restricted work or job transfer but does not involve death or days away from work, you must record the injury or illness on the OSHA 300 Log by placing a check mark in the space for job transfer or restriction and an entry of the number of restricted or transferred days in the restricted workdays column."
        },

      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"has had a material name change\",\"actor\":\"the applicant\",\"applies_to\":[\"If the applicant has had a material name change more than one year prior to applying on form DS-11 but has not updated her/his ID to reflect the material name change, you must suspend the application to request an acceptable ID in the new name.\"],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:0adabbdd2e3f90115724fa845966257d12b8f73ed061980fc5f3befd270c3cd9\",\"urn:rulespec:document-understanding:assertion:3782c7354c9202971897cbf212a234456660ecf0a8c577e349344e64ea014d99\",\"urn:rulespec:document-understanding:assertion:a91f90a0c01cc9b50ae5427aa91caa2c80f25ed3517e62751f570862b4108e07\",\"urn:rulespec:document-understanding:assertion:d67fd348f90329fff9fb1da2a48fac6a4ba0d4ad198276cb43a6c5f90171a294\",\"urn:rulespec:document-understanding:assertion:12e0091aab38f6d7e0523a9358357d4979a633a025abbbf58ab40cf547f38d45\",\"urn:rulespec:document-understanding:assertion:99d063674f874c2fa228f31212155291d588d38131b2da9c2efc9e9ef5f25ec4\"],\"end\":1841,\"evidence\":[{\"end\":1841,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:1676:1841:sha256-8d6e9a2e653ca62614166aac8953994fa3ed5eaadb3fe7d2c0dd5978ab49c209\",\"quote\":\"If the applicant has had a material name change more than one year prior to applying on form DS-11 but has not updated her/his ID to reflect the material name change\",\"start\":1676},{\"end\":1692,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:1679:1692:sha256-8ef9d27a07ce0795981ff451394777b4334f90b19415a9fa97bf254305ab328e\",\"quote\":\"the applicant\",\"start\":1679},{\"end\":1723,\"field\":\"action\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understan
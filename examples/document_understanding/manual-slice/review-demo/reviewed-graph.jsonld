      "dcterms:description": "{\"action\":\"continue using\",\"actor\":\"the applicant\",\"applies_to\":[\"The applicant may not continue to use a previous name after a material name change unless the name change documentation specifically permits the applicant to continue using that name (see 8 FAM 403.1-6 regarding “known as” names).\"],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:0feff2fa8fb8659fdc5f3abe36f79236f76b0fcc8742c3e0b3c39a03ed0fd14b\",\"urn:rulespec:document-understanding:assertion:0733105cb73594023927dee9dbf4a4be89d0d3b508da11d8114c0b9ae4a875c0\",\"urn:rulespec:document-understanding:assertion:bc212073c35a22946e52061d29471f67a44ae58ce5aaae977695c617ae066ad4\",\"urn:rulespec:document-understanding:assertion:88dff40c735b24481743d3a236f5e6336c1a394d732b1a3b4c5078e91de70793\",\"urn:rulespec:document-understanding:assertion:f99c2bf8220305d1c0f6b8a0dc6c6ec161552169062157e780ae94e89631c6eb\"],\"end\":1383,\"evidence\":[{\"end\":1383,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:1284:1383:sha256-f57ab2ae299ae1599f61bdd5fdebda4207f2400019f0ed106c9e5c70420409d2\",\"quote\":\"unless the name change documentation specifically permits the applicant to continue using that name\",\"start\":1284},{\"end\":1355,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:1342:1355:sha256-8ef9d27a07ce0795981ff451394777b4334f90b19415a9fa97bf254305ab328e\",\"quote\":\"the applicant\",\"start\":1342},{\"end\":1373,\"field\":\"action\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:1359:1373:sha256-ba462b68067fd22f66870ba86a3e7951bd139c28dc9f9f9f60dd30885dea92e1\",\"quote\":\"continue using\",\"start\":1359}
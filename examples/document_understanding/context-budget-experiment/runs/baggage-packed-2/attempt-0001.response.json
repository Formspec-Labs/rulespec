            "text": "{\n  \"extractions\": [\n    {\n      \"unit\": \"F001\",\n      \"unit_attributes\": {\n        \"kind\": \"prohibition\",\n        \"scope_quotes\": [\n          \"F000\"\n        ],\n        \"scope_text\": \"In checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter, applicable to a passenger transporting or offering for transport baggage.\",\n        \"context_quotes\": [],\n        \"modality_quote\": \"may not\",\n        \"modality\": \"must_not\",\n        \"alternative_quotes\": [],\n        \"choice_quote\": \"\",\n        \"choice_text\": \"\",\n        \"logic_quote\": \"\",\n        \"references\": [\n          \"§ 1562.23\"\n        ],\n        \"statement\": \"A passenger may not transport or offer for transport any loaded firearm(s) in checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter.\"\n      }\n    },\n    {\n      \"unit\": \"F002:F006\",\n      \"unit_attributes\": {\n        \"kind\": \"prohibition\",\n        \"scope_quotes\": [\n          \"F000\"\n        ],\n        \"scope_text\": \"In checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter, applicable to a passenger transporting or offering for transport baggage.\",\n        \"context_quotes\": [],\n        \"modality_quote\": \"may not\",\n        \"modality\": \"must_not\",\n        \"alternative_quotes\": [\n          \"F003\",\n          \"F004\",\n          \"F005\",\n          \"F006\"\n        ],\n        \"choice_quote\": \"F003:F006\",\n        \"choice_text\": \"All of the following conditions must be satisfied: the passenger declares to the aircraft operator, either orally or in writing, before checking the baggage, that the passenger has a firearm in his or her bag and that it is unloaded; the firearm is unloaded; the firearm is carried in a hard-sided container; and the container in which it is carried is locked, and only the passenger retains the key or combination.\",\n        \"logic_quote\": \"F002:F006\",\n        \"references\": [\n          \"§ 1562.23\"\n        ],\n        \"statement\": \"A passenger may not transport or offer for transport in checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter any unloaded firearm(s) unless: (i) the passenger declares to the aircraft operator, either orally or in writing, before checking the baggage, that the passenger has a firearm in his or her bag and that it is unloaded; (ii) the firearm is unloaded; (iii) the firearm is carried in a hard-sided container; and (iv) the container in which it is carried is locked, and only the passenger retains the key or combination.\"\n      }\n    },\n    {\n      \"unit\": \"F007\",\n      \"unit_attributes\": {\n        \"kind\": \"prohibition\",\n        \"scope_quotes\": [\n          \"F000\"\n        ],\n        \"scope_text\": \"In checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter, applicable to a passenger transporting or offering for transport baggage.\",\n        \"context_quotes\": [],\n        \"modality_quote\": \"may not\",\n        \"modality\": \"must_not\",\n        \"alternative_quotes\": [],\n        \"choice_quote\": \"\",\n        \"choice_text\": \"\",\n        \"logic_quote\": \"\",\n        \"references\": [\n          \"§ 1562.23\"\n        ],\n        \"statement\": \"A passenger may not transport or offer for transport any unauthorized explosive or incendiary in checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter.\"\n      }\n    },\n    {\n      \"unit\": \"F008\",\n      \"unit_attributes\": {\n        \"kind\": \"exemption\",\n        \"scope_quotes\": [\n          \"F008\"\n        ],\n        \"scope_text\": \"Under this section, with respect to carriage of ammunition in checked baggage or in the same container as a firearm.\",\n        \"context_quotes\": [],\n        \"modality_quote\": \"does not prohibit\",\n        \"modality\": \"not_required\",\n        \"alternative_quotes\": [],\n        \"choice_quote\": \"\",\n        \"choice_text\": \"\",\n        \"logic_quote\": \"\",\n        \"references\": [],\n        \"statement\": \"This section does not prohibit the carriage of ammunition in checked baggage or in the same container as a firearm.\"\n      }\n    },\n    {\n      \"unit\": \"F008\",\n      \"unit_attributes\": {\n        \"kind\": \"statement\",\n        \"scope_quotes\": [],\n        \"scope_text\": \"\",\n        \"context_quotes\": [],\n        \"modality_quote\": \"\",\n        \"modality\": \"not_stated\",\n        \"alternative_quotes\": [],\n        \"choice_quote\": \"\",\n        \"choice_text\": \"\",\n        \"logic_quote\": \"\",\n        \"references\": [\n          \"Title 49 CFR part 175\"\n        ],\n        \"statement\": \"Title 49 CFR part 175 provides additional requirements governing carriage of ammunition on aircraft.\"\n      }\n    }\n  ]\n}",

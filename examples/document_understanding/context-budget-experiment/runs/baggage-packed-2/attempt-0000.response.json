            "inline_data": null,
            "text": "{\n  \"extractions\": [\n    {\n      \"unit\": \"F001:F004\",\n      \"unit_attributes\": {\n        \"kind\": \"prohibition\",\n        \"scope_quotes\": [\n          \"F001\"\n        ],\n        \"scope_text\": \"Applies to an individual on or about the individual's person or accessible property, except as provided in paragraph (b) of 49 CFR 1540.111.\",\n        \"context_quotes\": [],\n        \"modality_quote\": \"may not\",\n        \"modality\": \"must_not\",\n        \"alternative_quotes\": [\n          \"F002\",\n          \"F003\",\n          \"F004\"\n        ],\n        \"choice_quote\": \"F002:F004\",\n        \"choice_text\": \"The prohibition applies when any of the following conditions is met: (1) when performance has begun of the inspection of the individual's person or accessible property before entering a sterile area, or before boarding an aircraft for which screening is conducted under this subchapter; (2) when the individual is entering or in a sterile area; or (3) when the individual is attempting to board or onboard an aircraft for which screening is conducted under §§ 1544.201, 1546.201, or 1562.23 of this chapter.\",\n        \"logic_quote\": \"F003\",\n        \"references\": [\n          \"paragraph (b)\",\n          \"§ 1544.201\",\n          \"§ 1546.201\",\n          \"§ 1562.23\"\n        ],\n        \"statement\": \"Except as provided in paragraph (b) of 49 CFR 1540.111, an individual may not have a weapon, explosive, or incendiary, on or about the individual's person or accessible property: (1) when performance has begun of the inspection of the individual's person or accessible property before entering a sterile area, or before boarding an aircraft for which screening is conducted under this subchapter; (2) when the individual is entering or in a sterile area; or (3) when the individual is attempting to board or onboard an aircraft for which screening is conducted under §§ 1544.201, 1546.201, or 1562.23 of this chapter.\"\n      }\n    },\n    {\n      \"unit\": \"F005:F008\",\n      \"unit_attributes\": {\n        \"kind\": \"exemption\",\n        \"scope_quotes\": [\n          \"F005\"\n        ],\n        \"scope_text\": \"Applies as to carriage of firearms and other weapons on an individual's person or accessible property governed by paragraph (a) of 49 CFR 1540.111.\",\n        \"context_quotes\": [],\n        \"modality_quote\": \"does not apply\",\n        \"modality\": \"not_required\",\n        \"alternative_quotes\": [\n          \"F006\",\n          \"F007\",\n          \"F008\"\n        ],\n        \"choice_quote\": \"F005:F008\",\n        \"choice_text\": \"Paragraph (a) does not apply if the individual is one of the following: (1) law enforcement personnel required to carry a firearm or other weapons while in the performance of law enforcement duty at the airport; (2) an individual authorized to carry a weapon in accordance with §§ 1544.219, 1544.221, 1544.223, 1546.211, or subpart B of part 1562 of this chapter; or (3) an individual authorized to carry a weapon in a sterile area under a security program.\",\n        \"logic_quote\": \"F005\",\n        \"references\": [\n          \"Paragraph (a)\",\n          \"§ 1544.219\",\n          \"§ 1544.221\",\n          \"§ 1544.223\",\n          \"§ 1546.211\",\n          \"part 1562, subpart B\"\n        ],\n        \"statement\": \"Paragraph (a) of 49 CFR 1540.111 does not apply as to carriage of firearms and other weapons if the individual is one of the following: (1) law enforcement personnel required to carry a firearm or other weapons while in the performance of law enforcement duty at the airport; (2) an individual authorized to carry a weapon in accordance with §§ 1544.219, 1544.221, 1544.223, 1546.211, or subpart B of part 1562 of this chapter; or (3) an individual authorized to carry a weapon in a sterile area under a security program.\"\n      }\n    }\n  ]\n}",

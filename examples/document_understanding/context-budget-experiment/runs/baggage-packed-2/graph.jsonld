      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:063c5fa5ba80e03e218358cc92d45a341b9f06fd84bd6e4b5a733baf4869e0e7",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:693c483f57ca90a5f4468cf17d6256ca01ba72a68634754fa5e7c56303a72940",

      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:063c5fa5ba80e03e218358cc92d45a341b9f06fd84bd6e4b5a733baf4869e0e7",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:ff3249aa8156fa22f0e44d501b7ff3a5bca4fa9844066046c306f93a3a974e0a",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:7ff6c0120a06b13414b5bcb07968bb00a05c189a2249e14839e313182a43ce0d",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:choice_text",
      "rkaf:assertsValue": {
        "@value": "All of the following conditions must be satisfied: the passenger declares to the aircraft operator, either orally or in writing, before checking the baggage, that the passenger has a firearm in his or her bag and that it is unloaded; the firearm is unloaded; the firearm is carried in a hard-sided container; and the container in which it is carried is locked, and only the passenger retains the key or combination.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:8bc516957490226c96b84c904c23678c9d77dc993f98b33c8b520dc655bd250d\",\"urn:rulespec:document-understanding:assertion:0fcf5a6b33364f1765eac152485b0e6913c5e7395836df3eb5e468f405868c0c\",\"urn:rulespec:document-understanding:assertion:2ea394b71a7d35df05b864b4614ddf283e425ad7b32901bc6500f9dfa2bcec76\",\"urn:rulespec:document-understanding:assertion:7b74b03731d07cd0b065ba4ca686491514347f6be9ffb7b895699e6b140491b8\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"effective_periods\":[],\"end\":2057,\"evidence\":[{\"end\":2057,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aab45ff8a7d213a548ba64b9bd9efdd9202dcd2f94cc0c1045a1b5fb69fe86460:2012:2057:sha256-38c4807ba6ffa5c128fdddac0b00c44521dbad649b9b41b0c7e648b107744f5a\",\"quote\":\"(3) Any unauthorized explosive or incendiary.\",\"start\":2012},{\"end\":1556,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aab45ff8a7d213a548ba64b9bd9efdd9202dcd2f94cc0c1045a1b5fb69fe86460:1376:1556:sha256-9dd5c9d0feb251838bff5c1a16b3c099ef083ecc7b0fca10625f4c8d5699fdf1\",\"quote\":\"(c) In checked baggage. A passenger may not transport or offer for transport in checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter:\",\"start\":1376}],\"id\":\"urn:rulespec:document-understanding:revision:c36e07ceb4a8fcafa6762bd0dc05765f712dc4f2d1a2cb7d725c40c93962f38b\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"prohibition\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:7b74b03731d07cd0b065ba4ca686491514347f6be9ffb7b895699e6b140491b8\",\"modality\":\"must_not\",\"modality_quote\":\"may not\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:ec82c489be561a93ae1b775cb9645b510e5d50f0eb2c08e6032472b85303e3ec\",\"origin\":\"aiSuggested\",\"quote\":\"(3) Any unauthorized explosive or incendiary.\",\"references\":[\"§ 1562.23\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:007ff8dbbe2f4c9ac77fddc69dd1df9a45f49ae68460a7593497b66079af3f27\",\"scope_quotes\":[\"(c) In checked baggage. A passenger may not transport or offer for transport in checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter:\"],\"scope_text\":\"In checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter, applicable to a passenger transporting or offering for transport baggage.\",\"section_id\":\"section-1\",\"start\":2012,\"summary\":\"A passenger may not transport or offer for transport any unauthorized explosive or incendiary in checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter.\",\"target_ids\":[],\"typed_values\":[]}",

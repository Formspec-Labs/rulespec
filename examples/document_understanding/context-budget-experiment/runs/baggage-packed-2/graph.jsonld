      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:52f40e31208351fde17f55ba46fdf5fad33b217f3d7807de7953769180c35c5b\",\"urn:rulespec:document-understanding:assertion:b1d677f5229ab9699a6cc18669b928fb04a787b68c65c159bd1c516b09a6dd70\",\"urn:rulespec:document-understanding:assertion:5b58b5dd72d2e6f68537d1571d5a946a3b6e2bf4b4085ece53d292f9070cddbe\",\"urn:rulespec:document-understanding:assertion:99caf4be6d6c414178b5d7f9a1d796491209c12e613d952db8abd9dd8bcf46bd\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"effective_periods\":[],\"end\":1584,\"evidence\":[{\"end\":1584,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aab45ff8a7d213a548ba64b9bd9efdd9202dcd2f94cc0c1045a1b5fb69fe86460:1558:1584:sha256-f67b20c11b2ab5e09c3493f45abc6a305b9d7deabb684a076a366c70e5d883ad\",\"quote\":\"(1) Any loaded firearm(s).\",\"start\":1558},{\"end\":1556,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aab45ff8a7d213a548ba64b9bd9efdd9202dcd2f94cc0c1045a1b5fb69fe86460:1376:1556:sha256-9dd5c9d0feb251838bff5c1a16b3c099ef083ecc7b0fca10625f4c8d5699fdf1\",\"quote\":\"(c) In checked baggage. A passenger may not transport or offer for transport in checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter:\",\"start\":1376}],\"id\":\"urn:rulespec:document-understanding:revision:53c95e1890c67935260cf9d872dd1d672a22d8a5627046cc9171a6bf0c5bef17\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"prohibition\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:99caf4be6d6c414178b5d7f9a1d796491209c12e613d952db8abd9dd8bcf46bd\",\"modality\":\"must_not\",\"modality_quote\":\"may not\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:dd624f1770dcca97e40d7540a92a0f9d1379554904a14639aa571dbfeec464d6\",\"origin\":\"aiSuggested\",\"quote\":\"(1) Any loaded firearm(s).\",\"references\":[\"§ 1562.23\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:f3a3d81fad5554bf87f7986df6b8360484b3d2acff70b6de88062d229107d57e\",\"scope_quotes\":[\"(c) In checked baggage. A passenger may not transport or offer for transport in checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter:\"],\"scope_text\":\"In checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter, applicable to a passenger transporting or offering for transport baggage.\",\"section_id\":\"section-1\",\"start\":1558,\"summary\":\"A passenger may not transport or offer for transport any loaded firearm(s) in checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter.\",\"target_ids\":[],\"typed_values\":[]}",

    {
      "@id": "urn:rulespec:document-understanding:assertion:e3b5c49381ea4ec75d9e204582e90e3be31ad10ba043e8a08a52827fdaa94756",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",

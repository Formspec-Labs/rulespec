    {
      "@id": "urn:rulespec:document-understanding:assertion:3e0e2a5ef67c1f5390c8cdef36fc1f39bf05e4681a94f4e225e34abd4f70e90d",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:063c5fa5ba80e03e218358cc92d45a341b9f06fd84bd6e4b5a733baf4869e0e7",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:693c483f57ca90a5f4468cf17d6256ca01ba72a68634754fa5e7c56303a72940",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:9449c69596aca6a524d44a3a0825ebcd3c87925db0c61600aa8a446a72b806d9",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[\"(1) When performance has begun of the inspection of the individual's person or accessible property before entering a sterile area, or before boarding an aircraft for which screening is conducted under this subchapter;\",\"(2) When the individual is entering or in a sterile area; or\",\"(3) When the individual is attempting to board or onboard an aircraft for which screening is conducted under §§ 1544.201, 1546.201, or 1562.23 of this chapter.\"],\"choice_text\":\"The prohibition applies when any of the following conditions is met: (1) when performance has begun of the inspection of the individual's person or accessible property before entering a sterile area, or before boarding an aircraft for which screening is conducted under this subchapter; (2) when the individual is entering or in a sterile area; or (3) when the individual is attempting to board or onboard an aircraft for which screening is conducted under §§ 1544.201, 1546.201, or 1562.23 of this chapter.\",\"claimants\":[],\"concepts\":[],\"effective_periods\":[],\"jurisdiction\":\"\",\"kind\":\"prohibition\",\"logic_text\":\"(2) When the individual is entering or in a sterile area; or\",\"modality\":\"must_not\",\"object\":\"\",\"scope_text\":\"Applies to an individual on or about the individual's person or accessible property, except as provided in paragraph (b) of 49 CFR 1540.111.\",\"summary\":\"Except as provided in paragraph (b) of 49 CFR 1540.111, an individual may not have a weapon, explosive, or incendiary, on or about the individual's person or accessible property: (1) when performance has begun of the inspection of the individual's person or accessible property before entering a sterile area, or before boarding an aircraft for which screening is conducted under this subchapter; (2) when the individual is entering or in a sterile area; or (3) when the individual is attempting to board or onboard an aircraft for which screening is conducted under §§ 1544.201, 1546.201, or 1562.23 of this chapter.\",\"typed_values\":[]}",
        "@type": "xsd:string"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed",
      "rkaf:hasApplicability": "urn:rulespec:document-understanding:scope:000c216953b425117d27da7fbfe41f06c9f316926e64b56bb007338229ccec50"
    },

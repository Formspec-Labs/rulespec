        "@value": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"effective_periods\":[],\"jurisdiction\":\"\",\"kind\":\"prohibition\",\"logic_text\":\"\",\"modality\":\"must_not\",\"object\":\"\",\"scope_text\":\"In checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter, applicable to a passenger transporting or offering for transport baggage.\",\"summary\":\"A passenger may not transport or offer for transport any unauthorized explosive or incendiary in checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter.\",\"typed_values\":[]}",

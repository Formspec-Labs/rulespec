    {
      "@id": "urn:rulespec:document-understanding:assertion:a8f4341cdc9c9fffd7896a695c2432f00a4b24556ce8daba4b26a0266c716e16",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:063c5fa5ba80e03e218358cc92d45a341b9f06fd84bd6e4b5a733baf4869e0e7",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:693c483f57ca90a5f4468cf17d6256ca01ba72a68634754fa5e7c56303a72940",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:32f14514206443766411a68cd2c063adae2e631249b1647b74cdd753ac7c6ae2",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[\"(1) Law enforcement personnel required to carry a firearm or other weapons while in the performance of law enforcement duty at the airport.\",\"(2) An individual authorized to carry a weapon in accordance with §§ 1544.219, 1544.221, 1544.223, 1546.211, or subpart B of part 1562 of this chapter.\",\"(3) An individual authorized to carry a weapon in a sterile area under a security program.\"],\"choice_text\":\"Paragraph (a) does not apply if the individual is one of the following: (1) law enforcement personnel required to carry a firearm or other weapons while in the performance of law enforcement duty at the airport; (2) an individual authorized to carry a weapon in accordance with §§ 1544.219, 1544.221, 1544.223, 1546.211, or subpart B of part 1562 of this chapter; or (3) an individual authorized to carry a weapon in a sterile area under a security program.\",\"claimants\":[],\"concepts\":[],\"effective_periods\":[],\"jurisdiction\":\"\",\"kind\":\"exemption\",\"logic_text\":\"(b) On an individual's person or accessible property—permitted carriage of a weapon. Paragraph (a) of this section does not apply as to carriage of firearms and other weapons if the individual is one of the following:\",\"modality\":\"not_required\",\"object\":\"\",\"scope_text\":\"Applies as to carriage of firearms and other weapons on an individual's person or accessible property governed by paragraph (a) of 49 CFR 1540.111.\",\"summary\":\"Paragraph (a) of 49 CFR 1540.111 does not apply as to carriage of firearms and other weapons if the individual is one of the following: (1) law enforcement personnel required to carry a firearm or other weapons while in the performance of law enforcement duty at the airport; (2) an individual authorized to carry a weapon in accordance with §§ 1544.219, 1544.221, 1544.223, 1546.211, or subpart B of part 1562 of this chapter; or (3) an individual authorized to carry a weapon in a sterile area under a security program.\",\"typed_values\":[]}",
        "@type": "xsd:string"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed",
      "rkaf:hasApplicability": "urn:rulespec:document-understanding:scope:1a7dd0cb34e4420a1745632ed2a1a49e45ee7a0ca872ebf6c2bf6dfd733b8622"
    },

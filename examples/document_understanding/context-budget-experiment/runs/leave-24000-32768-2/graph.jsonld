    {
      "@id": "urn:rulespec:document-understanding:revision:7583b56a007e445643172525e0713311eca0920de2537982bc99a6f3a0b75a01",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:7583b56a007e445643172525e0713311eca0920de2537982bc99a6f3a0b75a01",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:420b9bd87269863a40c766b268e8e8764f576457a27d6d087dcdeee76cfbbfcf",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:1fb8c120626973419ab1891cbaac3464c3ffd27ccc33d7f96ebd64b360081091\",\"urn:rulespec:document-understanding:assertion:5561b3c9e94ace1618dd73854fe26aa3b739161f0b20445a8b410063ab72b3ab\",\"urn:rulespec:document-understanding:assertion:c9560cab1876ec69807de08a3bf15993b2a49b85d850c47c3926d689afe02f17\",\"urn:rulespec:document-understanding:assertion:01efcf1a91ecb14f77447bb870efb47ddb025192858f23a1e3bdc11cf4f41fe9\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[\"(2) An employee returning from USERRA-covered service shall be credited with the hours of service that would have been performed but for the period of absence from work due to or necessitated by USERRA-covered service in determining the employee's eligibility for FMLA-qualifying leave. Accordingly, a person reemployed following USERRA-covered service has the hours that would have been worked for the employer added to any hours actually worked during the previous 12-month period to meet the hours of service requirement. In order to determine the hours that would have been worked during the period of absence from work due to or necessitated by USERRA-covered service, the employee's pre-service work schedule can generally be used for calculations. See § 825.801(c) for special rules applicable to airline flight crew employees.\"],\"effective_periods\":[],\"end\":4438,\"evidence\":[{\"end\":4438,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa4cdfc9b75c8a1ed78c29b8a344913757e4b95198a4b069127aa9092960aaf4f:3604:4438:sha256-7dbcb059fc78a2f697d27032e4d0f71484bebb06578094a6d4adecf70f95a027\",\"quote\":\"(2) An employee returning from USERRA-covered service shall be credited with the hours of service that would have been performed but for the period of absence from work due to or necessitated by USERRA-covered service in determining the employee's eligibility for FMLA-qualifying leave. Accordingly, a person reemployed following USERRA-covered service has the hours that would have been worked for the employer added to any hours actually worked during the previous 12-month period to meet the hours of service requirement. In order to determine the hours that would have been worked during the period of absence from work due to or necessitated by USERRA-covered service, the employee's pre-service work schedule can generally be used for calculations. See § 825.801(c) for special rules applicable to airline flight crew employees.\",\"start\":3604},{\"end\":4332,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa4cdfc9b75c8a1ed78c29b8a344913757e4b95198a4b069127aa9092960aaf4f:4319:4332:sha256-f02ab51079e97d340ab93b467e90fc06df107cfb146c076758a781a9b899cbcf\",\"quote\":\"can generally\",\"start\":4319},{\"end\":4438,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa4cdfc9b75c8a1ed78c29b8a344913757e4b95198a4b069127aa9092960aaf4f:3604:4438:sha256-7dbcb059fc78a2f697d27032e4d0f71484bebb06578094a6d4adecf70f95a027\",\"quote\":\"(2) An employee returning from USERRA-covered service shall be credited with the hours of service that would have been performed but for the period of absence from work due to or necessitated by USERRA-covered service in determining the employee's eligibility for FMLA-qualifying leave. Accordingly, a person reemployed following USERRA-covered service has the hours that would have been worked for the employer added to any hours actually worked during the previous 12-month period to meet the hours of service requirement. In order to determine the hours that would have been worked during the period of absence from work due to or necessitated by USERRA-covered service, the employee's pre-service work schedule can generally be used for calculations. See § 825.801(c) for special rules applicable to airline flight crew employees.\",\"start\":3604},{\"end\":4438,\"field\":\"context:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa4cdfc9b75c8a1ed78c29b8a344913757e4b95198a4b069127aa9092960aaf4f:3604:4438:sha256-7dbcb059fc78a2f697d27032e4d0f71484bebb06578094a6d4adecf70f95a027\",\"quote\":\"(2) An employee returning from USERRA-covered service shall be credited with the hours of service that would have been performed but for the period of absence from work due to or necessitated by USERRA-covered service in determining the employee's eligibility for FMLA-qualifying leave. Accordingly, a person reemployed following USERRA-covered service has the hours that would have been worked for the employer added to any hours actually worked during the previous 12-month period to meet the hours of service requirement. In order to determine the hours that would have been worked during the period of absence from work due to or necessitated by USERRA-covered service, the employee's pre-service work schedule can generally be used for calculations. See § 825.801(c) for special rules applicable to airline flight crew employees.\",\"start\":3604}],\"id\":\"urn:rulespec:document-understanding:revision:7583b56a007e445643172525e0713311eca0920de2537982bc99a6f3a0b75a01\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"permission\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:01efcf1a91ecb14f77447bb870efb47ddb025192858f23a1e3bdc11cf4f41fe9\",\"modality\":\"may\",\"modality_quote\":\"can generally\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:ebae86cc7bc3860b902f358c780d978cd175a8a18878cb130bc76cf7db508275\",\"origin\":\"aiSuggested\",\"quote\":\"(2) An employee returning from USERRA-covered service shall be credited with the hours of service that would have been performed but for the period of absence from work due to or necessitated by USERRA-covered service in determining the employee's eligibility for FMLA-qualifying leave. Accordingly, a person reemployed following USERRA-covered service has the hours that would have been worked for the employer added to any hours actually worked during the previous 12-month period to meet the hours of service requirement. In order to determine the hours that would have been worked during the period of absence from work due to or necessitated by USERRA-covered service, the employee's pre-service work schedule can generally be used for calculations. See § 825.801(c) for special rules applicable to airline flight crew employees.\",\"references\":[\"USERRA\",\"§ 825.801(c)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:6957c26ebe897ef4b22782ea703f9ad4708977d94fe06106a72c74de217eaca5\",\"scope_quotes\":[\"(2) An employee returning from USERRA-covered service shall be credited with the hours of service that would have been performed but for the period of absence from work due to or necessitated by USERRA-covered service in determining the employee's eligibility for FMLA-qualifying leave. Accordingly, a person reemployed following USERRA-covered service has the hours that would have been worked for the employer added to any hours actually worked during the previous 12-month period to meet the hours of service requirement. In order to determine the hours that would have been worked during the period of absence from work due to or necessitated by USERRA-covered service, the employee's pre-service work schedule can generally be used for calculations. See § 825.801(c) for special rules applicable to airline flight crew employees.\"],\"scope_text\":\"In order to determine the hours that would have been worked during the period of absence from work due to or necessitated by USERRA-covered service.\",\"section_id\":\"section-1\",\"start\":3604,\"summary\":\"In order to determine the hours that would have been worked during the period of absence from work due to or necessitated by USERRA-covered service, the employee's pre-service work schedule can generally be used for calculations.\",\"target_ids\":[],\"typed_values\":[]}",
      "dcterms:references": [
        {
          "@id": "urn:rulespec:document-understanding:assertion:1fb8c120626973419ab1891cbaac3464c3ffd27ccc33d7f96ebd64b360081091"
        },

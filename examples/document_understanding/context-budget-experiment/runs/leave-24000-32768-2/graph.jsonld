    {
      "@id": "urn:rulespec:document-understanding:assertion:bcfb03d7b64faa167b96ff59a8000c32b2e9c78dc51b981e60a19ad596b509d6",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",

    {
      "@id": "urn:rulespec:document-understanding:revision:c32340e388af98ebc85b512062c9e6499a7913faa4b65585010426b5cdba4435",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:c32340e388af98ebc85b512062c9e6499a7913faa4b65585010426b5cdba4435",

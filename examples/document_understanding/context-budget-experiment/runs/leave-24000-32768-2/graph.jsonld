      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:choice_text",
      "rkaf:assertsValue": {
        "@value": "All three conditions must be satisfied: (1) employed by the employer for at least 12 months; AND (2) employed for at least 1,250 hours of service during the 12-month period immediately preceding the commencement of the leave (subject to special rules for airline flight crew employees); AND (3) employed at a worksite where 50 or more employees are employed by the employer within 75 miles of that worksite.",

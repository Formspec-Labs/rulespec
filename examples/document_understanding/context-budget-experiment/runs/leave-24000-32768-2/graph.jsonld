dality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa4cdfc9b75c8a1ed78c29b8a344913757e4b95198a4b069127aa9092960aaf4f:850:858:sha256-b00eebc92fbf41e3d233b28a918c7b90de96d6a15c0daebb94dde8af457529df\",\"quote\":\"need not\",\"start\":850},{\"end\":963,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa4cdfc9b75c8a1ed78c29b8a344913757e4b95198a4b069127aa9092960aaf4f:704:963:sha256-438c5644572a847c74d79f58c54f20e47ea923230c819e21bf4f8083396eaabc\",\"quote\":\"(1) Subject to the exceptions provided in paragraph (b)(2) of this section, employment periods prior to a break in service of seven years or more need not be counted in determining whether the employee has been employed by the employer for at least 12 months.\",\"start\":704}],\"id\":\"urn:rulespec:document-understanding:revision:490df4f6b65b8f2d34d7617d2a2de8b45c13ffac03ba0cba11a3d470b3aad1f5\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"exemption\",\"logic_text\":\"(1) Subject to the exceptions provided in paragraph (b)(2) of this section, employment periods prior to a break in service of seven years or more need not be counted in determining whether the employee has been employed by the employer for at least 12 months.\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:a8b667f194a72e8d93d6832588b86f1042a0f9890901bbbd3692cedff0e52817\",\"modality\":\"not_required\",\"modality_quote\":\"need not\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:a6047124d2c5bf9c45546387c66f1e142e5b73ae0834fe1ec4e3eb7ae2c09fc9\",\"origin\":\"aiSuggested\",\"quote\":\"(1) Subject to the exceptions provided in paragraph (b)(2) of this section, employment periods prior to a break in service of seven years or more need not be counted in determining whether the employee has been employed by the employer for at least 12 months.\",\"references\":[\"paragraph (b)(2)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:c20fb08a713703482e75d61d7e93fb7515f39a7fb37dd577ede83127bf39fb75\",\"scope_quotes\":[\"(1) Subject to the exceptions provided in paragraph (b)(2) of this section, employment periods prior to a break in service of seven years or more need not be counted in determining whether the employee has been employed by the employer for at least 12 months.\"],\"scope_text\":\"In determining whether an employee has been employed by the employer for at least 12 months, subject to the exceptions provided in paragraph (b)(2) of this section.\",\"section_id\":\"section-1\",\"start\":704,\"summary\":\"Subject to the exceptions provided in paragraph (b)(2) of this section, employment periods prior to a break in service of seven years or more need not be counted in determining whether the employee has been employed by the employer for at least 12 months.\",\"target_ids\":[],\"typed_values\":[]}",

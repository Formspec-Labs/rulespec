      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:741ddc19cc2a73cff44620a413c2e45555ba5fdf75c2b433bfd112859624c708",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:scope_text",
      "rkaf:assertsValue": {
        "@value": "In determining whether an employee has been employed by the employer for at least 12 months when an employment period precedes a break in service of more than seven years, where the break is occasioned by USERRA-covered service or where a written agreement exists concerning rehire.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },
    {
      "@id": "urn:rulespec:document-understanding:binding:afc312f2208654fcb76e28873a264f1a345c3e92eed73bbfa9271b987737b3d1",
      "@type": "rkaf:EvidenceBinding",
      "rkaf:bindsAssertion": "urn:rulespec:document-understanding:assertion:a42948ad2b8311a3e23d201d0ba8588a44c7aada7c997036678002c85414ee68",
      "rkaf:evidenceRole": "rkaf:textualEvidence",
      "rkaf:evidentiaryFunction": "rkaf:supports",
      "rkaf:bindsSourceFragment": [

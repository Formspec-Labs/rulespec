          "@id": "urn:rulespec:document-understanding:assertion:5561b3c9e94ace1618dd73854fe26aa3b739161f0b20445a8b410063ab72b3ab"
        },
        {
          "@id": "urn:rulespec:document-understanding:assertion:c9560cab1876ec69807de08a3bf15993b2a49b85d850c47c3926d689afe02f17"
        },

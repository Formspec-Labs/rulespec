      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:states-statement",
      "rkaf:assertsValue": {
        "@value": "An employee may be on non-FMLA leave at the time he or she meets the 12-month eligibility requirement, and in that event, any portion of the leave taken for an FMLA-qualifying reason after the employee meets the eligibility requirement would be FMLA leave.",

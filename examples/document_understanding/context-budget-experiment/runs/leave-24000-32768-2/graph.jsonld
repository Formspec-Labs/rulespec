      "rkaf:appliesInJurisdiction": [],
      "rkaf:applicabilityCondition": "When an employee is on non-FMLA leave at the time he or she meets the 12-month eligibility requirement."
    },
    {
      "@id": "urn:rulespec:document-understanding:assertion:e16103eb63ac9e140e91e1206e012a2774033804f7428ead5ac960d54ea242bc",

      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:states-statement",
      "rkaf:assertsValue": {
        "@value": "Except as provided in paragraph (c)(2) and in § 825.801, whether an employee has worked the minimum 1,250 hours of service is determined according to the principles established under the Fair Labor Standards Act (FLSA) for determining compensable hours of work, based on the number of hours an employee has worked for the employer within the meaning of the FLSA and not limited by methods of recordkeeping or non-reflective compensation agreements.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

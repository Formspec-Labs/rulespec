      "rkaf:appliesInJurisdiction": [],
      "rkaf:applicabilityCondition": "In the event an employer does not maintain an accurate record of hours worked by an employee, including employees exempt from FLSA recordkeeping requirements under 29 CFR part 541."
    },
    {
      "@id": "urn:rulespec:document-understanding:assertion:49d35dfc54cc24ff0cd59a107ebe4e4ad4f16ab6576de98b510bcd44e909e478",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:b2fc878f196fdfe204b64387832e4342474df4ecb9342d6643ff9920b147b0b6",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:6364871bd35197a892fa99671cb8ebd7a27fc0e30a0aa49b45118263d876c9e3",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:3a66d7003ce07a23f457f7557b50684d7a6ce5707d295697f66cddc09c8cb5e3",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:states-requirement",
      "rkaf:assertsValue": {
        "@value": "In the event an employer does not maintain an accurate record of hours worked by an employee, the employer has the burden of showing that the employee has not worked the requisite hours, and must be able to clearly demonstrate that the employee did not work 1,250 hours during the previous 12 months in order to claim ineligibility.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

    {
      "@id": "urn:rulespec:document-understanding:revision:66d6bef28e0e6025c14bea4de10aeac8fee8d7abc943b665bbc723448a5d9d73",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:66d6bef28e0e6025c14bea4de10aeac8fee8d7abc943b665bbc723448a5d9d73",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:01dd81f8ffedc8d058b7abf9f2d9d1a18567567c222194726fda18e4680ec4d0",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:a7ac45ff58caeaa442f61a81482ae15e76f005f7b4f50f15cb635cf3106fd823\",\"urn:rulespec:document-understanding:assertion:8f7a6fdaa79194de8df94654d59d5c2aaf217bd5ebb24cc9354716f937776be8\",\"urn:rulespec:document-understanding:assertion:f9131ffe91cca140726dd0cd309e2c88ec3ed9a9f7a04e509fcbbce1ad6a787b\",\"urn:rulespec:document-understanding:assertion:78598a7834a8aa07869edca02ca912b6047fb146d0b5da1fef8f4bbdfe25e3b9\",\"urn:rulespec:document-understanding:assertion:d812662633151430d09b97c9a43a03917ec71855eecf98b258975fc44dd5a550\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[\"(2) An employee returning from USERRA-covered service shall be credited with the hours of service that would have been performed but for the period of absence from work due to or necessitated by USERRA-covered service in determining the employee's eligibility for FMLA-qualifying leave. Accordingly, a person reemployed following USERRA-covered service has the hours that would have been worked for the employer added to any hours actually worked during the previous 12-month period to meet the hours of service requirement. In order to determine the hours that would have been worked during the period of absence from work due to or necessitated by USERRA-covered service, the employee's pre-service work schedule can generally be used for calculations. See § 825.801(c) for special rules applicable to airline flight crew employees.\"],\"effective_periods\":[],\"end\":4438,\"evidence\":[{\"end\":4438,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa4cdfc9b75c8a1ed78c29b8a344913757e4b95198a4b069127aa9092960aaf4f:3604:4438:sha256-7dbcb059fc78a2f697d27032e4d0f71484bebb06578094a6d4adecf70f95a027\",\"quote\":\"(2) An employee returning from USERRA-covered service shall be credited with the hours of service that would have been performed but for the period of absence from work due to or necessitated by USERRA-covered service in determining the employee's eligibility for FMLA-qualifying leave. Accordingly, a person reemployed following USERRA-covered service has the hours that would have been worked for the employer added to any hours actually worked during the previous 12-month period to meet the hours of service requirement. In order to determine the hours that would have been worked during the period of absence from work due to or necessitated by USERRA-covered service, the employee's pre-service work schedule can generally be used for calculations. See § 825.801(c) for special rules applicable to airline flight crew employees.\",\"start\":3604},{\"end\":4438,\"field\":\"logic_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa4cdfc9b75c8a1ed78c29b8a344913757e4b95198a4b069127aa9092960aaf4f:3604:4438:sha256-7dbcb059fc78a2f697d27032e4d0f71484bebb06578094a6d4adecf70f95a027\",\"quote\":\"(2) An employee returning from USERRA-covered service shall be credited with the hours of service that would have been performed but for the period of absence from work due to or necessitated by USERRA-covered service in determining the employee's eligibility for FMLA-qualifying leave. Accordingly, a person reemployed following USERRA-covered service has the hours that would have been worked for the employer added to any hours actually worked during the previous 12-month period to meet the hours of service requirement. In order to determine the hours that would have been worked during the period of absence from work due to or necessitated by USERRA-covered service, the employee's pre-service work schedule can generally be used for calculations. See § 825.801(c) for special rules applicable to airline flight crew employees.\",\"start\":3604},{\"end\":3663,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa4cdfc9b75c8a1ed78c29b8a344913757e4b95198a4b069127aa9092960aaf4f:3658:3663:sha256-56ee5b508706bf2de91712d85d6d1e11ddbff01949142ed6e8c22e3b1bed1c71\",\"quote\":\"shall\",\"start\":3658},{\"end\":4438,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa4cdfc9b75c8a1ed78c29b8a344913757e4b95198a4b069127aa9092960aaf4f:3604:4438:sha256-7dbcb059fc78a2f697d27032e4d0f71484bebb06578094a6d4adecf70f95a027\",\"quote\":\"(2) An employee returning from USERRA-covered service shall be credited with the hours of service that would have been performed but for the period of absence from work due to or necessitated by USERRA-covered service in determining the employee's eligibility for FMLA-qualifying leave. Accordingly, a person reemployed following USERRA-covered service has the hours that would have been worked for the employer added to any hours actually worked during the previous 12-month period to meet the hours of service requirement. In order to determine the hours that would have been worked during the period of absence from work due to or necessitated by USERRA-covered service, the employee's pre-service work schedule can generally be used for calculations. See § 825.801(c) for special rules applicable to airline flight crew employees.\",\"start\":3604},{\"end\":4438,\"field\":\"context:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa4cdfc9b75c8a1ed78c29b8a344913757e4b95198a4b069127aa9092960aaf4f:3604:4438:sha256-7dbcb059fc78a2f697d27032e4d0f71484bebb06578094a6d4adecf70f95a027\",\"quote\":\"(2) An employee returning from USERRA-covered service shall be credited with the hours of service that would have been performed but for the period of absence from work due to or necessitated by USERRA-covered service in determining the employee's eligibility for FMLA-qualifying leave. Accordingly, a person reemployed following USERRA-covered service has the hours that would have been worked for the employer added to any hours actually worked during the previous 12-month period to meet the hours of service requirement. In order to determine the hours that would have been worked during the period of absence from work due to or necessitated by USERRA-covered service, the employee's pre-service work schedule can generally be used for calculations. See § 825.801(c) for special rules applicable to airline flight crew employees.\",\"start\":3604}],\"id\":\"urn:rulespec:document-understanding:revision:66d6bef28e0e6025c14bea4de10aeac8fee8d7abc943b665bbc723448a5d9d73\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"(2) An employee returning from USERRA-covered service shall be credited with the hours of service that would have been performed but for the period of absence from work due to or necessitated by USERRA-covered service in determining the employee's eligibility for FMLA-qualifying leave. Accordingly, a person reemployed following USERRA-covered service has the hours that would have been worked for the employer added to any hours actually worked during the previous 12-month period to meet the hours of service requirement. In order to determine the hours that would have been worked during the period of absence from work due to or necessitated by USERRA-covered service, the employee's pre-service work schedule can generally be used for calculations. See § 825.801(c) for special rules applicable to airline flight crew employees.\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:d812662633151430d09b97c9a43a03917ec71855eecf98b258975fc44dd5a550\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:bef4bf20f3ad944e1c4db04e7a7f4f9d2b22afb64d6d7e1fee6192f88adc88c6\",\"origin\":\"aiSuggested\",\"quote\":\"(2) An employee returning from USERRA-covered service shall be credited with the hours of service that would have been performed but for the period of absence from work due to or necessitated by USERRA-covered service in determining the employee's eligibility for FMLA-qualifying leave. Accordingly, a person reemployed following USERRA-covered service has the hours that would have been worked for the employer added to any hours actually worked during the previous 12-month period to meet the hours of service requirement. In order to determine the hours that would have been worked during the period of absence from work due to or necessitated by USERRA-covered service, the employee's pre-service work schedule can generally be used for calculations. See § 825.801(c) for special rules applicable to airline flight crew employees.\",\"references\":[\"USERRA\",\"§ 825.801(c)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:319a00a07d0a58f3e9b71234a5b2b5b17dacd75e482aef458062aa3314faa953\",\"scope_quotes\":[\"(2) An employee returning from USERRA-covered service shall be credited with the hours of service that would have been performed but for the period of absence from work due to or necessitated by USERRA-covered service in determining the employee's eligibility for FMLA-qualifying leave. Accordingly, a person reemployed following USERRA-covered service has the hours that would have been worked for the employer added to any hours actually worked during the previous 12-month period to meet the hours of service requirement. In order to determine the hours that would have been worked during the period of absence from work due to or necessitated by USERRA-covered service, the employee's pre-service work schedule can generally be used for calculations. See § 825.801(c) for special rules applicable to airline flight crew employees.\"],\"scope_text\":\"In determining eligibility for FMLA-qualifying leave for an employee returning from USERRA-covered service.\",\"section_id\":\"section-1\",\"start\":3604,\"summary\":\"An employee returning from USERRA-covered service shall be credited with the hours of service that would have been performed but for the period of absence from work due to or necessitated by USERRA-covered service in determining the employee's eligibility for FMLA-qualifying leave, which are added to any hours actually worked during the previous 12-month period.\",\"target_ids\":[],\"typed_values\":[]}",

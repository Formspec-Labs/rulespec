    {
      "@id": "urn:rulespec:document-understanding:assertion:56f6bb5f6b2c714ba7cdc76f18c43588514e895a4182f734451c4a891454b514",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:b2fc878f196fdfe204b64387832e4342474df4ecb9342d6643ff9920b147b0b6",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:6364871bd35197a892fa99671cb8ebd7a27fc0e30a0aa49b45118263d876c9e3",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:741ddc19cc2a73cff44620a413c2e45555ba5fdf75c2b433bfd112859624c708",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:choice_text",
      "rkaf:assertsValue": {
        "@value": "Employment periods preceding a break in service of more than seven years must be counted where either: (i) the employee's break in service is occasioned by the fulfillment of his or her USERRA-covered service obligation; OR (ii) a written agreement, including a collective bargaining agreement, exists concerning the employer's intention to rehire the employee after the break in service.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },
    {
      "@id": "urn:rulespec:document-understanding:binding:203936133f49cd7af83cf48e1ccb67fd5b56185ce75c73b00e60df2d4653a7fa",
      "@type": "rkaf:EvidenceBinding",
      "rkaf:bindsAssertion": "urn:rulespec:document-understanding:assertion:56f6bb5f6b2c714ba7cdc76f18c43588514e895a4182f734451c4a891454b514",
      "rkaf:evidenceRole": "rkaf:textualEvidence",
      "rkaf:evidentiaryFunction": "rkaf:supports",
      "rkaf:bindsSourceFragment": [
        "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa4cdfc9b75c8a1ed78c29b8a344913757e4b95198a4b069127aa9092960aaf4f:965:1946:sha256-44393cd9a380898a3a1acc3ba34a55b09730edf38e8b44fe99ff1f8768321518"
      ]
    },
    {
      "@id": "urn:rulespec:document-understanding:assertion:e17445254b032ece565490e215144103018a78b1f385bc0dcde00fc05e134126",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:b2fc878f196fdfe204b64387832e4342474df4ecb9342d6643ff9920b147b0b6",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:6364871bd35197a892fa99671cb8ebd7a27fc0e30a0aa49b45118263d876c9e3",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:741ddc19cc2a73cff44620a413c2e45555ba5fdf75c2b433bfd112859624c708",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:alternative:0",
      "rkaf:assertsValue": {
        "@value": "(i) The employee's break in service is occasioned by the fulfillment of his or her Uniformed Services Employment and Reemployment Rights Act (USERRA), 38 U.S.C. 4301, et seq., covered service obligation. The period of absence from work due to or necessitated by USERRA-covered service must be also counted in determining whether the employee has been employed for at least 12 months by the employer. However, this section does not provide any greater entitlement to the employee than would be available under the USERRA; or",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },
    {
      "@id": "urn:rulespec:document-understanding:binding:e9ce3310e596b2e37d098f1d2491f921c33d841a0d3f906107a6b6dcf8548cbd",
      "@type": "rkaf:EvidenceBinding",
      "rkaf:bindsAssertion": "urn:rulespec:document-understanding:assertion:e17445254b032ece565490e215144103018a78b1f385bc0dcde00fc05e134126",
      "rkaf:evidenceRole": "rkaf:textualEvidence",
      "rkaf:evidentiaryFunction": "rkaf:supports",
      "rkaf:bindsSourceFragment": [
        "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa4cdfc9b75c8a1ed78c29b8a344913757e4b95198a4b069127aa9092960aaf4f:1159:1682:sha256-3583bfa13c136e40a1005ff1210b6c0bcc560609a0916bb52fde5527907c0b6a"
      ]
    },
    {
      "@id": "urn:rulespec:document-understanding:assertion:44471bde44b182a21c2cdecc4564ba4f89a6c6cbafeab55a10887bbd354c5220",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:b2fc878f196fdfe204b64387832e4342474df4ecb9342d6643ff9920b147b0b6",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:6364871bd35197a892fa99671cb8ebd7a27fc0e30a0aa49b45118263d876c9e3",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:741ddc19cc2a73cff44620a413c2e45555ba5fdf75c2b433bfd112859624c708",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:alternative:1",
      "rkaf:assertsValue": {
        "@value": "(ii) A written agreement, including a collective bargaining agreement, exists concerning the employer's intention to rehire the employee after the break in service (e.g., for purposes of the employee furthering his or her education or for childrearing purposes).",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

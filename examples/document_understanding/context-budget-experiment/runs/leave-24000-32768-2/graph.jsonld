      "rkaf:assertsValue": {
        "@value": "Whether 50 employees are employed within 75 miles to ascertain an employee's eligibility for FMLA benefits is determined when the employee gives notice of the need for leave, and once determined eligible in response to that notice, eligibility is not affected by any subsequent change in employee count within 75 miles for that specific notice.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

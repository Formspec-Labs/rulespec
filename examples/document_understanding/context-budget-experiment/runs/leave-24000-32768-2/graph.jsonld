      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:scope_text",
      "rkaf:assertsValue": {
        "@value": "In the event an employer does not maintain an accurate record of hours worked by an employee, including employees exempt from FLSA recordkeeping requirements under 29 CFR part 541.",

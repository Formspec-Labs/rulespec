      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[\"(i) The employee's break in service is occasioned by the fulfillment of his or her Uniformed Services Employment and Reemployment Rights Act (USERRA), 38 U.S.C. 4301, et seq., covered service obligation. The period of absence from work due to or necessitated by USERRA-covered service must be also counted in determining whether the employee has been employed for at least 12 months by the employer. However, this section does not provide any greater entitlement to the employee than would be available under the USERRA; or\",\"(ii) A written agreement, including a collective bargaining agreement, exists concerning the employer's intention to rehire the employee after the break in service (e.g., for purposes of the employee furthering his or her education or for childrearing purposes).\"],\"choice_text\":\"Employment periods preceding a break in service of more than seven years must be counted where either: (i) the employee's break in service is occasioned by the fulfillment of his or her USERRA-covered service obligation; OR (ii) a written agreement, including a collective bargaining agreement, exists concerning the employer's intention to rehire the employee after the break in service.\",\"claimants\":[],\"concepts\":[],\"effective_periods\":[],\"jurisdiction\":\"\",\"kind\":\"requirement\",\"logic_text\":\"(2) Employment periods preceding a break in service of more than seven years must be counted in determining whether the employee has been employed by the employer for at least 12 months where:\\n\\n(i) The employee's break in service is occasioned by the fulfillment of his or her Uniformed Services Employment and Reemployment Rights Act (USERRA), 38 U.S.C. 4301, et seq., covered service obligation. The period of absence from work due to or necessitated by USERRA-covered service must be also counted in determining whether the employee has been employed for at least 12 months by the employer. However, this section does not provide any greater entitlement to the employee than would be available under the USERRA; or\\n\\n(ii) A written agreement, including a collective bargaining agreement, exists concerning the employer's intention to rehire the employee after the break in service (e.g., for purposes of the employee furthering his or her education or for childrearing purposes).\",\"modality\":\"must\",\"object\":\"\",\"scope_text\":\"In determining whether an employee has been employed by the employer for at least 12 months when an employment period precedes a break in service of more than seven years, where the break is occasioned by USERRA-covered service or where a written agreement exists concerning rehire.\",\"summary\":\"Employment periods preceding a break in service of more than seven years must be counted in determining whether the employee has been employed by the employer for at least 12 months where the break in service is occasioned by fulfillment of a USERRA-covered service obligation or where a written agreement (including a collective bargaining agreement) exists concerning the employer's intention to rehire the employee after the break in service.\",\"typed_values\":[]}",
        "@type": "xsd:string"
      },

      "rkaf:appliesInJurisdiction": [],
      "rkaf:applicabilityCondition": "For an employee who is maintained on the payroll for any part of a week, including any periods of paid or unpaid leave (sick, vacation) during which other benefits or compensation are provided by the employer."
    },

    {
      "@id": "urn:rulespec:document-understanding:assertion:39bed31b25d4d9da17a5a3ed9a548bbbb2cab0d355a3abbfb3217be7490a0735",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:b2fc878f196fdfe204b64387832e4342474df4ecb9342d6643ff9920b147b0b6",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:6364871bd35197a892fa99671cb8ebd7a27fc0e30a0aa49b45118263d876c9e3",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:e413ca76f3a822c40f2fb005fc682a6645d96a1fa258e81a50856cf8acc1e094",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"effective_periods\":[],\"jurisdiction\":\"\",\"kind\":\"statement\",\"logic_text\":\"(e) Whether 50 employees are employed within 75 miles to ascertain an employee's eligibility for FMLA benefits is determined when the employee gives notice of the need for leave. Whether the leave is to be taken at one time or on an intermittent or reduced leave schedule basis, once an employee is determined eligible in response to that notice of the need for leave, the employee's eligibility is not affected by any subsequent change in the number of employees employed at or within 75 miles of the employee's worksite, for that specific notice of the need for leave. Similarly, an employer may not terminate employee leave that has already started if the employee count drops below 50. For example, if an employer employs 60 employees in August, but expects that the number of employees will drop to 40 in December, the employer must grant FMLA benefits to an otherwise eligible employee who gives notice of the need for leave in August for a period of leave to begin in December.\",\"modality\":\"not_stated\",\"object\":\"\",\"scope_text\":\"To ascertain an employee's eligibility for FMLA benefits based on whether 50 employees are employed within 75 miles.\",\"summary\":\"Whether 50 employees are employed within 75 miles to ascertain an employee's eligibility for FMLA benefits is determined when the employee gives notice of the need for leave, and once determined eligible in response to that notice, eligibility is not affected by any subsequent change in employee count within 75 miles for that specific notice.\",\"typed_values\":[]}",
        "@type": "xsd:string"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed",
      "rkaf:hasApplicability": "urn:rulespec:document-understanding:scope:caac080e6d701a890cb61b94caf4f0d9acbee58666299ba2748a463ccdd8984f"
    },

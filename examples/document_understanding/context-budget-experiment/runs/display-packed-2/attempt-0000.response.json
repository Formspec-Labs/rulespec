            "text": "{\n  \"extractions\": [\n    {\n      \"unit\": \"F000\",\n      \"unit_attributes\": {\n        \"kind\": \"statement\",\n        \"scope_quotes\": [],\n        \"scope_text\": \"\",\n        \"context_quotes\": [],\n        \"modality_quote\": \"\",\n        \"modality\": \"not_stated\",\n        \"alternative_quotes\": [],\n        \"choice_quote\": \"\",\n        \"choice_text\": \"\",\n        \"logic_quote\": \"\",\n        \"references\": [],\n        \"statement\": \"This document is an invented public-display permit policy and is a diagnostic document, not legal guidance.\"\n      }\n    },\n    {\n      \"unit\": \"F001\",\n      \"unit_attributes\": {\n        \"kind\": \"requirement\",\n        \"scope_quotes\": [\n          \"F001\"\n        ],\n        \"scope_text\": \"For a temporary display open to the public after sunset on agency premises.\",\n        \"context_quotes\": [\n          \"F002:F005\"\n        ],\n        \"modality_quote\": \"must\",\n        \"modality\": \"must\",\n        \"alternative_quotes\": [\n          \"F002\",\n          \"F003\",\n          \"F004\",\n          \"F005\"\n        ],\n        \"choice_quote\": \"F001\",\n        \"choice_text\": \"All of the following conditions: illuminating every public exit, keeping exits clear, appointing an adult steward (unless supervised by an agency employee), and providing an inspection record before admitting visitors.\",\n        \"logic_quote\": \"F001\",\n        \"references\": [\n          \"(a)\",\n          \"(1)\",\n          \"(2)\",\n          \"(3)\",\n          \"(4)\"\n        ],\n        \"statement\": \"For a temporary display open to the public after sunset on agency premises, the organizer must satisfy all of the specified conditions in paragraphs (1) through (4).\"\n      }\n    },\n    {\n      \"unit\": \"F002\",\n      \"unit_attributes\": {\n        \"kind\": \"requirement\",\n        \"scope_quotes\": [\n          \"F001\"\n        ],\n        \"scope_text\": \"For a temporary display open to the public after sunset on agency premises.\",\n        \"context_quotes\": [],\n        \"modality_quote\": \"must\",\n        \"modality\": \"must\",\n        \"alternative_quotes\": [],\n        \"choice_quote\": \"\",\n        \"choice_text\": \"\",\n        \"logic_quote\": \"\",\n        \"references\": [\n          \"(a)\",\n          \"(1)\"\n        ],\n        \"statement\": \"For a temporary display open to the public after sunset on agency premises, the organizer must illuminate every public exit throughout the time the display remains open.\"\n      }\n    },\n    {\n      \"unit\": \"F003\",\n      \"unit_attributes\": {\n        \"kind\": \"requirement\",\n        \"scope_quotes\": [\n          \"F001\"\n        ],\n        \"scope_text\": \"For a temporary display open to the public after sunset on agency premises.\",\n        \"context_quotes\": [\n          \"F003\"\n        ],\n        \"modality_quote\": \"must\",\n        \"modality\": \"must\",\n        \"alternative_quotes\": [],\n        \"choice_quote\": \"\",\n        \"choice_text\": \"\",\n        \"logic_quote\": \"\",\n        \"references\": [\n          \"(a)\",\n          \"(2)\"\n        ],\n        \"statement\": \"For a temporary display open to the public after sunset on agency premises, the organizer must keep every public exit clear throughout the time the display remains open.\"\n      }\n    },\n    {\n      \"unit\": \"F003\",\n      \"unit_attributes\": {\n        \"kind\": \"statement\",\n        \"scope_quotes\": [\n          \"F001\"\n        ],\n        \"scope_text\": \"For a temporary display open to the public after sunset on agency premises.\",\n        \"context_quotes\": [],\n        \"modality_quote\": \"\",\n        \"modality\": \"not_stated\",\n        \"alternative_quotes\": [],\n        \"choice_quote\": \"\",\n        \"choice_text\": \"\",\n        \"logic_quote\": \"\",\n        \"references\": [\n          \"(a)\",\n          \"(2)\"\n        ],\n        \"statement\": \"Equipment stored behind a locked staff-only door is not an obstruction of a public exit.\"\n      }\n    },\n    {\n      \"unit\": \"F004\",\n      \"unit_attributes\": {\n        \"kind\": \"requirement\",\n        \"scope_quotes\": [\n          \"F001\"\n        ],\n        \"scope_text\": \"For a temporary display open to the public after sunset on agency premises.\",\n        \"context_quotes\": [],\n        \"modality_quote\": \"must\",\n        \"modality\": \"must\",\n        \"alternative_quotes\": [],\n        \"choice_quote\": \"\",\n        \"choice_text\": \"\",\n        \"logic_quote\": \"F004\",\n        \"references\": [\n          \"(a)\",\n          \"(3)\"\n        ],\n        \"statement\": \"For a temporary display open to the public after sunset on agency premises, the organizer must appoint an adult steward who remains on site throughout the time the display remains open, except that this appointment duty does not apply when an agency employee is assigned to supervise the display for that entire period.\"\n      }\n    },\n    {\n      \"unit\": \"F004\",\n      \"unit_attributes\": {\n        \"kind\": \"exemption\",\n        \"scope_quotes\": [\n          \"F001\",\n          \"F004\"\n        ],\n        \"scope_text\": \"For a temporary display open to the public after sunset on agency premises, when an agency employee is assigned to supervise the display for that entire period.\",\n        \"context_quotes\": [],\n        \"modality_quote\": \"does not apply\",\n        \"modality\": \"not_required\",\n        \"alternative_quotes\": [],\n        \"choice_quote\": \"\",\n        \"choice_text\": \"\",\n        \"logic_quote\": \"F004\",\n        \"references\": [\n          \"(a)\",\n          \"(3)\"\n        ],\n        \"statement\": \"For a temporary display open to the public after sunset on agency premises, the organizer is not required to appoint an adult steward when an agency employee is assigned to supervise the display for that entire period.\"\n      }\n    },\n    {\n      \"unit\": \"F005\",\n      \"unit_attributes\": {\n        \"kind\": \"requirement\",\n        \"scope_quotes\": [\n          \"F001\",\n          \"F005\"\n        ],\n        \"scope_text\": \"For a temporary display open to the public after sunset on agency premises, before admitting the first visitor.\",\n        \"context_quotes\": [],\n        \"modality_quote\": \"must\",\n        \"modality\": \"must\",\n        \"alternative_quotes\": [\n          \"F005\"\n        ],\n        \"choice_quote\": \"F005\",\n        \"choice_text\": \"Either a signed paper inspection record or an electronic inspection record signed by the inspecting officer.\",\n        \"logic_quote\": \"F005\",\n        \"references\": [\n          \"(a)\",\n          \"(4)\"\n        ],\n        \"statement\": \"For a temporary display open to the public after sunset on agency premises, before admitting the first visitor, the organizer must give the agency either a signed paper inspection record or an electronic inspection record signed by the inspecting officer.\"\n      }\n    },\n    {\n      \"unit\": \"F005\",\n      \"unit_attributes\": {\n        \"kind\": \"requirement\",\n        \"scope_quotes\": [\n          \"F001\",\n          \"F005\"\n        ],\n        \"scope_text\": \"For a temporary display open to the public after sunset on agency premises, for each paper or electronic inspection record given to the agency.\",\n        \"context_quotes\": [],\n        \"modality_quote\": \"must\",\n        \"modality\": \"must\",\n        \"alternative_quotes\": [],\n        \"choice_quote\": \"F005\",\n        \"choice_text\": \"All three items: the display, the inspection date, and every public exit inspected.\",\n        \"logic_quote\": \"F005\",\n        \"references\": [\n          \"(a)\",\n          \"(4)\"\n        ],\n        \"statement\": \"For a temporary display open to the public after sunset on agency premises, each inspection record given to the agency must identify the display, the inspection date, and every public exit inspected.\"\n      }\n    }\n  ]\n}",

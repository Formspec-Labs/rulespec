    {
      "@id": "urn:rulespec:document-understanding:assertion:bceb04ff0fac9d2f2200680f36f2966407f0b01568194b4ab2e50df1b021291e",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:28137829b276d341ae27d1776b59317924ba0998b87f188f9d6c8da8ca2aedc7",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:92bf4bb976bd86e7d6ba4cd6ef37297b67a2ca85caacffb16ba3ab586fe895e2",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:795510959773f534b343dc08a38695733c9014c8a5ed4c8a00268614f673ece7",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[\"(1) The organizer must illuminate every public exit throughout the time the display remains open.\",\"(2) The organizer must keep every public exit clear throughout the time the display remains open. Equipment stored behind a locked staff-only door is not an obstruction of a public exit.\",\"(3) The organizer must appoint an adult steward who remains on site throughout the time the display remains open. This appointment duty does not apply when an agency employee is assigned to supervise the display for that entire period.\",\"(4) Before admitting the first visitor, the organizer must give the agency either a signed paper inspection record or an electronic inspection record signed by the inspecting officer. Each record must identify the display, the inspection date, and every public exit inspected.\"],\"choice_text\":\"All of the following conditions: illuminating every public exit, keeping exits clear, appointing an adult steward (unless supervised by an agency employee), and providing an inspection record before admitting visitors.\",\"claimants\":[],\"concepts\":[],\"effective_periods\":[],\"jurisdiction\":\"\",\"kind\":\"requirement\",\"logic_text\":\"(a) For a temporary display open to the public after sunset on agency premises, the organizer must satisfy all of the following conditions:\",\"modality\":\"must\",\"object\":\"\",\"scope_text\":\"For a temporary display open to the public after sunset on agency premises.\",\"summary\":\"For a temporary display open to the public after sunset on agency premises, the organizer must satisfy all of the specified conditions in paragraphs (1) through (4).\",\"typed_values\":[]}",
        "@type": "xsd:string"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed",
      "rkaf:hasApplicability": "urn:rulespec:document-understanding:scope:012ba47d7ca02315f14cb645b8a688ac188ce622fb4efd44b837832cdff1d34b"
    },

    {
      "@id": "urn:rulespec:document-understanding:revision:c8d73601709fab1f112861a44e5c7a93d5749f0f3ea559a718240d44538d0fad",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:c8d73601709fab1f112861a44e5c7a93d5749f0f3ea559a718240d44538d0fad",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",

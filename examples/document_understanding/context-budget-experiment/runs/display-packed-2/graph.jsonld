0621c5b8e3d3b614540154d5:1557:1740:sha256-790b8c74af5f59d2bc58d9383788c0a7e1ed84629ef0907b749b0bb47b54d41f\",\"quote\":\"(c) For displays held entirely before sunset, the organizer should place a readable map near the entrance. This recommendation does not create a duty to illuminate exits after sunset.\",\"start\":1557}],\"id\":\"urn:rulespec:document-understanding:revision:ccd640e9ae6dce7c0fa233922381713c6dc47d89a1d7eff928613029696084ec\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"statement\",\"logic_text\":\"(c) For displays held entirely before sunset, the organizer should place a readable map near the entrance. This recommendation does not create a duty to illuminate exits after sunset.\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:1c303dbc706cdd3456d70c33bddf96dc8c6118553b3717fb7d15f4fcf2b1ce97\",\"modality\":\"not_stated\",\"modality_quote\":\"\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:1423d4df3e3235711885bbd7573ddcb48cf46cabc789ba65fb07a67de8be23c3\",\"origin\":\"aiSuggested\",\"quote\":\"(c) For displays held entirely before sunset, the organizer should place a readable map near the entrance. This recommendation does not create a duty to illuminate exits after sunset.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:4f9bdf85889fa698c809da9f8327a892885c3f3ea8e8f4abc3a5cebaa0380580\",\"scope_quotes\":[\"(c) For displays held entirely before sunset, the organizer should place a readable map near the entrance. This recommendation does not create a duty to illuminate exits after sunset.\"],\"scope_text\":\"Under the recommendation for displays held entirely before sunset to place a readable map near the entrance\",\"section_id\":\"section-1\",\"start\":1557,\"summary\":\"The recommendation to place a readable map near the entrance for displays held entirely before sunset does not create a duty to illuminate exits after sunset.
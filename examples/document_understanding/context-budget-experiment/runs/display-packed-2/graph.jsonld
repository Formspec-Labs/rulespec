      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:10d075ce5f22e980381425592cf215f73906f56a4e3e84ea1a40a8fbf8541585\",\"urn:rulespec:document-understanding:assertion:9bd472f34b6e4dcc20cc001931dfb320ccc8776a34b6ec0861ba5b28d68ce744\",\"urn:rulespec:document-understanding:assertion:3a1e3922cfef3db593c1f5e9e8587a342799962ed51579a764c7866b4e52b2b5\",\"urn:rulespec:document-understanding:assertion:5d5fde7062636fa9cfa185fce6c4d55d8455164730f12fdaeca5ad292483bcd3\",\"urn:rulespec:document-understanding:assertion:a622e304edfc66ce4b1a7d6d4b7b9b89767f96bbd095c167cb17b732eacba673\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"effective_periods\":[],\"end\":754,\"evidence\":[{\"end\":754,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Acd1d2d681c56417058e5883c90b99d7d8c562af40621c5b8e3d3b614540154d5:519:754:sha256-dbea7b17f13efc5648bf55eebcb9aff4b968bd00d90301ecde3f87fb84c14234\",\"quote\":\"(3) The organizer must appoint an adult steward who remains on site throughout the time the display remains open. This appointment duty does not apply when an agency employee is assigned to supervise the display for that entire period.\",\"start\":519},{\"end\":754,\"field\":\"logic_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Acd1d2d681c56417058e5883c90b99d7d8c562af40621c5b8e3d3b614540154d5:519:754:sha256-dbea7b17f13efc5648bf55eebcb9aff4b968bd00d90301ecde3f87fb84c14234\",\"quote\":\"(3) The organizer must appoint an adult steward who remains on site throughout the time the display remains open. This appointment duty does not apply when an agency employee is assigned to supervise the display for that entire period.\",\"start\":519},{\"end\":669,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Acd1d2d681c56417058e5883c90b99d7d8c562af40621c5b8e3d3b614540154d5:655:669:sha256-533232681eac9dd2c357af3b24908d4c4e8d41562c911ad7ed51eb0f4638ccd0\",\"quote\":\"does not apply\",\"start\":655},{\"end\":230,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Acd1d2d681c56417058e5883c90b99d7d8c562af40621c5b8e3d3b614540154d5:91:230:sha256-b6abd80d117b4b566300972de823d7857c2472c21cbd8866fece15a96eef055f\",\"quote\":\"(a) For a temporary display open to the public after sunset on agency premises, the organizer must satisfy all of the following conditions:\",\"start\":91},{\"end\":754,\"field\":\"scope_text:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Acd1d2d681c56417058e5883c90b99d7d8c562af40621c5b8e3d3b614540154d5:519:754:sha256-dbea7b17f13efc5648bf55eebcb9aff4b968bd00d90301ecde3f87fb84c14234\",\"quote\":\"(3) The organizer must appoint an adult steward who remains on site throughout the time the display remains open. This appointment duty does not apply when an agency employee is assigned to supervise the display for that entire period.\",\"start\":519}],\"id\":\"urn:rulespec:document-understanding:revision:68a421dbad42f1bbca30b2aa0ef74ff9455b4cc02651005919f2ff905b3dc61a\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"exemption\",\"logic_text\":\"(3) The organizer must appoint an adult steward who remains on site throughout the time the display remains open. This appointment duty does not apply when an agency employee is assigned to supervise the display for that entire period.\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:a622e304edfc66ce4b1a7d6d4b7b9b89767f96bbd095c167cb17b732eacba673\",\"modality\":\"not_required\",\"modality_quote\":\"does not apply\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:24306862e75184f2d63a721b93b8cd6688da6fb068302691e7681f5d93e76528\",\"origin\":\"aiSuggested\",\"quote\":\"(3) The organizer must appoint an adult steward who remains on site throughout the time the display remains open. This appointment duty does not apply when an agency employee is assigned to supervise the display for that entire period.\",\"references\":[\"(a)\",\"(3)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:db372353584aa9fa3f23ed8558171f12c8d88f23c156541ce95c7f1f93d5ee70\",\"scope_quotes\":[\"(a) For a temporary display open to the public after sunset on agency premises, the organizer must satisfy all of the following conditions:\",\"(3) The organizer must appoint an adult steward who remains on site throughout the time the display remains open. This appointment duty does not apply when an agency employee is assigned to supervise the display for that entire period.\"],\"scope_text\":\"For a temporary display open to the public after sunset on agency premises, when an agency employee is assigned to supervise the display for that entire period.\",\"section_id\":\"section-1\",\"start\":519,\"summary\":\"For a temporary display open to the public after sunset on agency premises, the organizer is not required to appoint an adult steward when an agency employee is assigned to supervise the display for that entire period.\",\"target_ids\":[],\"typed_values\":[]}",

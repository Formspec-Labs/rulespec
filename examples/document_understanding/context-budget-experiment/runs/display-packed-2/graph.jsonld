      "@id": "urn:rulespec:document-understanding:assertion:5129e41b88cd11a4f26c0becc71d59f7a0d2dd235e77f25346ea6aa3e092cbc6",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:28137829b276d341ae27d1776b59317924ba0998b87f188f9d6c8da8ca2aedc7",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:d4664321795b8437b220a545a6224bf90211e05b5db831376dc390a82f3ad909",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:7c3035b46726e1735b299c843644840d13c0573327174fc21f60715e738be32c",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:states-requirement",
      "rkaf:assertsValue": {
        "@value": "When a storm warning is active, the organizer must suspend outdoor demonstrations unless all of the following conditions are met: (1) the demonstration takes place beneath a fixed roof; (2) the agency has measured wind speed below 20 kilometers per hour at the demonstration site within the preceding 10 minutes; and (3) an agency officer authorizes the demonstration for the duration of the current warning.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

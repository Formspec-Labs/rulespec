      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:97d4bd56871a9853cff04fcb481175cf366f2cf87cca159f67b8dfb75ac3667f\",\"urn:rulespec:document-understanding:assertion:d37b1e15532649d24ecb9cd8e53a7084ae0f9c76a9de77776a936795e5afe433\",\"urn:rulespec:document-understanding:assertion:e4d792872a2d4ea070fdf0a2b7e1509bb42e1fe18e534cc1794da6714f172bc2\",\"urn:rulespec:document-understanding:assertion:4a13aef36387690db59f49fd0573913fdec3fb89168daee4c0800c44dcf1b2f2\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"effective_periods\":[],\"end\":1740,\"evidence\":[{\"end\":1740,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Acd1d2d681c56417058e5883c90b99d7d8c562af40621c5b8e3d3b614540154d5:1557:1740:sha256-790b8c74af5f59d2bc58d9383788c0a7e1ed84629ef0907b749b0bb47b54d41f\",\"quote\":\"(c) For displays held entirely before sunset, the organizer should place a readable map near the entrance. This recommendation does not create a duty to illuminate exits after sunset.\",\"start\":1557},{\"end\":1740,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Acd1d2d681c56417058e5883c90b99d7d8c562af40621c5b8e3d3b614540154d5:1557:1740:sha256-790b8c74af5f59d2bc58d9383788c0a7e1ed84629ef0907b749b0bb47b54d41f\",\"quote\":\"(c) For displays held entirely before sunset, the organizer should place a readable map near the entrance. This recommendation does not create a duty to illuminate exits after sunset.\",\"start\":1557}],\"id\":\"urn:rulespec:document-understanding:revision:75e1ff777628b4d6bfd3b1e9fbe16cc7e3f153c00ab8a3e18c833eb0fc224627\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"statement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:asser
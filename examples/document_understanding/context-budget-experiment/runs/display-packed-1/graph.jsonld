    {
      "@id": "urn:rulespec:document-understanding:revision:6f012eacf2c67e4259a890d4027515bf0cb48c2e82e311e581e1bc20f96ce46d",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:6f012eacf2c67e4259a890d4027515bf0cb48c2e82e311e581e1bc20f96ce46d",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:537025f8fd53e6e18975827e9ee94e8b34129f5b48522065975f00f84c926742",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:163c93bc2d2ba5a6398baa1c7432ecba22b2b9657294a85526a1a6a9cca94f90\",\"urn:rulespec:document-understanding:assertion:73701e8671cfb0e2f4760811d510e87452a08f2b60c3e71d521b30207051a16d\",\"urn:rulespec:document-understanding:assertion:1f851f166f32b3929273e3b202a94670a5421978ebb43aff06feee1cc61f76a4\",\"urn:rulespec:document-understanding:assertion:0903ef9afaf1128d883d2b538b955ea58fae3ac89ed2acaf1db972d11c1affae\",\"urn:rulespec:document-understanding:assertion:802b78f1787b9ff86bcf74d3334a93d931450f7a46c760108a4aa23bfb286c09\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[\"(1) The organizer must illuminate every public exit throughout the time the display remains open.\\n\\n(2) The organizer must keep every public exit clear throughout the time the display remains open. Equipment stored behind a locked staff-only door is not an obstruction of a public exit.\\n\\n(3) The organizer must appoint an adult steward who remains on site throughout the time the display remains open. This appointment duty does not apply when an agency employee is assigned to supervise the display for that entire period.\\n\\n(4) Before admitting the first visitor, the organizer must give the agency either a signed paper inspection record or an electronic inspection record signed by the inspecting officer. Each record must identify the display, the inspection date, and every public exit inspected.\"],\"effective_periods\":[],\"end\":230,\"evidence\":[{\"end\":230,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Acd1d2d681c56417058e5883c90b99d7d8c562af40621c5b8e3d3b614540154d5:91:230:sha256-b6abd80d117b4b566300972de823d7857c2472c21cbd8866fece15a96eef055f\",\"quote\":\"(a) For a temporary display open to the public after sunset on agency premises, the organizer must satisfy all of the following conditions:\",\"start\":91},{\"end\":230,\"field\":\"logic_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Acd1d2d681c56417058e5883c90b99d7d8c562af40621c5b8e3d3b614540154d5:91:230:sha256-b6abd80d117b4b566300972de823d7857c2472c21cbd8866fece15a96eef055f\",\"quote\":\"(a) For a temporary display open to the public after sunset on agency premises, the organizer must satisfy all of the following conditions:\",\"start\":91},{\"end\":189,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Acd1d2d681c56417058e5883c90b99d7d8c562af40621c5b8e3d3b614540154d5:185:189:sha256-4137b01e139589b7a1d3b3fc4da031d8ce5bb415808734e970c3a58ea0e98f0f\",\"quote\":\"must\",\"start\":185},{\"end\":230,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Acd1d2d681c56417058e5883c90b99d7d8c562af40621c5b8e3d3b614540154d5:91:230:sha256-b6abd80d117b4b566300972de823d7857c2472c21cbd8866fece15a96eef055f\",\"quote\":\"(a) For a temporary display open to the public after sunset on agency premises, the organizer must satisfy all of the following conditions:\",\"start\":91},{\"end\":1032,\"field\":\"context:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Acd1d2d681c56417058e5883c90b99d7d8c562af40621c5b8e3d3b614540154d5:232:1032:sha256-2240bcd5f393ce64ac161209e63161f949a1b4215cabf1a28288931e241c6eab\",\"quote\":\"(1) The organizer must illuminate every public exit throughout the time the display remains open.\\n\\n(2) The organizer must keep every public exit clear throughout the time the display remains open. Equipment stored behind a locked staff-only door is not an obstruction of a public exit.\\n\\n(3) The organizer must appoint an adult steward who remains on site throughout the time the display remains open. This appointment duty does not apply when an agency employee is assigned to supervise the display for that entire period.\\n\\n(4) Before admitting the first visitor, the organizer must give the agency either a signed paper inspection record or an electronic inspection record signed by the inspecting officer. Each record must identify the display, the inspection date, and every public exit inspected.\",\"start\":232}],\"id\":\"urn:rulespec:document-understanding:revision:6f012eacf2c67e4259a890d4027515bf0cb48c2e82e311e581e1bc20f96ce46d\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"(a) For a temporary display open to the public after sunset on agency premises, the organizer must satisfy all of the following conditions:\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:802b78f1787b9ff86bcf74d3334a93d931450f7a46c760108a4aa23bfb286c09\",\"modality\":\"must\",\"modality_quote\":\"must\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:887798bd09c0a10dd2baa69ca4557e4ad3811eb502744be37283f356e6d89b99\",\"origin\":\"aiSuggested\",\"quote\":\"(a) For a temporary display open to the public after sunset on agency premises, the organizer must satisfy all of the following conditions:\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:0f9b31466e3a24bd848e4bd89deba91be4f0527b78f4250ca052782cfd8fe05d\",\"scope_quotes\":[\"(a) For a temporary display open to the public after sunset on agency premises, the organizer must satisfy all of the following conditions:\"],\"scope_text\":\"For a temporary display open to the public after sunset on agency premises.\",\"section_id\":\"section-1\",\"start\":91,\"summary\":\"For a temporary display open to the public after sunset on agency premises, the organizer must satisfy all of the conditions set forth in items (1) through (4).\",\"target_ids\":[],\"typed_values\":[]}",

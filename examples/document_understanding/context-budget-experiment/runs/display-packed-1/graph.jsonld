      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:aaa65f6e70bedf5bb97555abafdab2d6a38f1005dc4dfadb886cfa6650861a90\",\"urn:rulespec:document-understanding:assertion:ce1c24e528ffeae2c92f8b59d8bebd18b34c72b8f58be9cb3a20628a8a970989\",\"urn:rulespec:document-understanding:assertion:7076d9d4270eb2b11c510c0c17960ee2e23b1d79645623be419ea9680b9e2206\",\"urn:rulespec:document-understanding:assertion:7f17efcfa0f35a8c1f98a24b27a74bbb04ab142ec13548bc29710f35efcbe42f\",\"urn:rulespec:document-understanding:assertion:33f3c44a1af46f24e4ebde1e49b7de9d978f727db14e42114ce40bea06332481\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"effective_periods\":[],\"end\":2029,\"evidence\":[{\"end\":2029,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Acd1d2d681c56417058e5883c90b99d7d8c562af40621c5b8e3d3b614540154d5:1742:2029:sha256-7103367673d0bf063011ffb987e1452cfbb156651058333a98ee69febabca7fb\",\"quote\":\"(d) The organizer must retain each inspection record for at least 30 calendar days after the display closes. Weekends and holidays count toward the 30 days. If an investigation is open when that period ends, the organizer must retain the record until the agency closes the investigation.\",\"start\":1742},{\"end\":2029,\"field\":\"logic_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Acd1d2d681c56417058e5883c90b99d7d8c562af40621c5b8e3d3b614540154d5:1742:2029:sha256-7103367673d0bf063011ffb987e1452cfbb156651058333a98ee69febabca7fb\",\"quote\":\"(d) The organizer must retain each inspection record for at least 30 calendar days after the display closes. Weekends and holidays count toward the 30 days. If an investigation is open when that period ends, the organizer must retain the record until the agency closes the investigation.\",\"start\":1742},{\"end\":2029,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Acd1d2d681c56417058e5883c90b99d7d8c562af40621c5b8e3d3b614540154d5:1742:2029:sha256-7103367673d0bf063011ffb987e1452cfbb156651058333a98ee69febabca7fb\",\"quote\":\"(d) The organizer must retain each inspection record for at least 30 calendar days after the display closes. Weekends and holidays count toward the 30 days. If an investigation is open when that period ends, the organizer must retain the record until the agency closes the investigation.\",\"start\":1742}],\"id\":\"urn:rulespec:document-understanding:revision:a3653e621b6ff1d4a600fe0888044aa5cec548c4e59c3e082008bae85effbc0f\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"(d) The organizer must retain each inspection record for at least 30 calendar days after the display closes. Weekends and holidays count toward the 30 days. If an investigation is open when that period ends, the organizer must retain the record until the agency closes the investigation.\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:33f3c44a1af46f24e4ebde1e49b7de9d978f727db14e42114ce40bea06332481\",\"modality\":\"must\",\"modality_quote\":\"must\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:0e2f04ce82d2472d2f7f0d3c6b140f0f5320074f4e3735126d13ba8d83b1b003\",\"origin\":\"aiSuggested\",\"quote\":\"(d) The organizer must retain each inspection record for at least 30 calendar days after the display closes. Weekends and holidays count toward the 30 days. If an investigation is open when that period ends, the organizer must retain the record until the agency closes the investigation.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:c9409c658fb2b1ee788cc301a87f6637d21b9edb5e5b669c8e17b119a5f216d4\",\"scope_quotes\":[\"(d) The organizer must retain each inspection record for at least 30 calendar days after the display closes. Weekends and holidays count toward the 30 days. If an investigation is open when that period ends, the organizer must retain the record until the agency closes the investigation.\"],\"scope_text\":\"When an investigation is open at the end of the at least 30-calendar-day retention period after the display closes.\",\"section_id\":\"section-1\",\"start\":1742,\"summary\":\"If an investigation is open when the 30-calendar-day retention period ends after the display closes, the organizer must retain the inspection record until the agency closes the investigation.\",\"target_ids\":[],\"typed_values\":[]}",

    {
      "@id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Acd1d2d681c56417058e5883c90b99d7d8c562af40621c5b8e3d3b614540154d5:1354:1555:sha256-76f262896325f8478b95b626857500a006e07a2d4c8aadb8f712cb7a7c69a7c9",

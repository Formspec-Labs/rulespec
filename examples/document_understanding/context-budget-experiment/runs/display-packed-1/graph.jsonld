      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:6a531cd33cb2e6e2f5fd2a4c8a1d79a84306e4839008bd39d696dbf7ca8e98d4\",\"urn:rulespec:document-understanding:assertion:ba61ded95d566e9be9d03aadbaf54106104f785dcf43d36defe759439c89efbc\",\"urn:rulespec:document-understanding:assertion:99a51157b9f1a15b51ffb0053ed23ab83f3d17f6eec3779e092a5293fb1aa64d\",\"urn:rulespec:document-understanding:assertion:f80476eca119b9e2bd34d679f3f163e898278666c136acbf2122b6c1c6e561ad\",\"urn:rulespec:document-understanding:assertion:0bc0a75506f6f43f610d9a53ab6ba490989b45195b999e9c118cb0ab20707549\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"effective_periods\":[],\"end\":754,\"evidence\":[{\"end\":754,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Acd1d2d681c56417058e5883c90b99d7d8c562af40621c5b8e3d3b614540154d5:519:754:sha256-dbea7b17f13efc5648bf55eebcb9aff4b968bd00d90301ecde3f87fb84c14234\",\"quote\":\"(3) The organizer must appoint an adult steward who remains on site throughout the time the display remains open. This appointment duty does not apply when an agency employee is assigned to supervise the display for that entire period.\",\"start\":519},{\"end\":754,\"field\":\"logic_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Acd1d2d681c56417058e5883c90b99d7d8c562af40621c5b8e3d3b614540154d5:519:754:sha256-dbea7b17f13efc5648bf55eebcb9aff4b968bd00d90301ecde3f87fb84c14234\",\"quote\":\"(3) The organizer must appoint an adult steward who remains on site throughout the time the display remains open. This appointment duty does not apply when an agency employee is assigned to supervise the display for that entire period.\",\"start\":519},{\"end\":669,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Acd1d2d681c56417058e5883c90b99d7d8c562af40621c5b8e3d3b614540154d5:655:669:sha256-533232681eac9dd2c357af3b24908d4c4e8d41562c911ad7ed51eb0f4638ccd0\",\"quote\":\"does not apply\",\"start\":655},{\"end\":230,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Acd1d2d681c56417058e5883c90b99d7d8c562af40621c5b8e3d3b614540154d5:91:230:sha256-b6abd80d117b4b566300972de823d7857c2472c21cbd8866fece15a96eef055f\",\"quote\":\"(a) For a temporary display open to the public after sunset on agency premises, the organizer must satisfy all of the following conditions:\",\"start\":91},{\"end\":754,\"field\":\"scope_text:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Acd1d2d681c56417058e5883c90b99d7d8c562af40621c5b8e3d3b614540154d5:519:754:sha256-dbea7b17f13efc5648bf55eebcb9aff4b968bd00d90301ecde3f87fb84c14234\",\"quote\":\"(3) The organizer must appoint an adult steward who remains on site throughout the time the display remains open. This appointment duty does not apply when an agency employee is assigned to supervise the display for that entire period.\",\"start\":519}],\"id\":\"urn:rulespec:document-understanding:revision:8692fe281ae22585cc526c5e143ae35e0fa40f6f9bdf3d633fbcea0daa065cea\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"exemption\",\"logic_text\":\"(3) The organizer must appoint an adult steward who remains on site throughout the time the display remains open. This appointment duty does not apply when an agency employee is assigned to supervise the display for that entire period.\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:0bc0a75506f6f43f610d9a53ab6ba490989b45195b999e9c118cb0ab20707549\",\"modality\":\"not_required\",\"modality_quote\":\"does not apply\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:ca8429298f3946302c1f824ec3ffa00c21f0bec64c3653f43a9f70d4cdbe09fa\",\"origin\":\"aiSuggested\",\"quote\":\"(3) The organizer must appoint an adult steward who remains on site throughout the time the display remains open. This appointment duty does not apply when an agency employee is assigned to supervise the display for that entire period.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:dfcc78b58e29cfbed67aec3652fd2b1e958135f90e92415a43b461b4e6b8bafb\",\"scope_quotes\":[\"(a) For a temporary display open to the public after sunset on agency premises, the organizer must satisfy all of the following conditions:\",\"(3) The organizer must appoint an adult steward who remains on site throughout the time the display remains open. This appointment duty does not apply when an agency employee is assigned to supervise the display for that entire period.\"],\"scope_text\":\"For a temporary display open to the public after sunset on agency premises, when an agency employee is assigned to supervise the display for that entire period.\",\"section_id\":\"section-1\",\"start\":519,\"summary\":\"For a temporary display open to the public after sunset on agency premises, the organizer is not required to appoint an adult steward when an agency employee is assigned to supervise the display for that entire period.\",\"target_ids\":[],\"typed_values\":[]}",

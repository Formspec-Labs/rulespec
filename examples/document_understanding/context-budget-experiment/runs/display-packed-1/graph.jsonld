%3Arulespec%3Adocument-understanding%3Adocument%3Acd1d2d681c56417058e5883c90b99d7d8c562af40621c5b8e3d3b614540154d5:537:541:sha256-4137b01e139589b7a1d3b3fc4da031d8ce5bb415808734e970c3a58ea0e98f0f\",\"quote\":\"must\",\"start\":537},{\"end\":230,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Acd1d2d681c56417058e5883c90b99d7d8c562af40621c5b8e3d3b614540154d5:91:230:sha256-b6abd80d117b4b566300972de823d7857c2472c21cbd8866fece15a96eef055f\",\"quote\":\"(a) For a temporary display open to the public after sunset on agency premises, the organizer must satisfy all of the following conditions:\",\"start\":91},{\"end\":754,\"field\":\"scope_text:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Acd1d2d681c56417058e5883c90b99d7d8c562af40621c5b8e3d3b614540154d5:519:754:sha256-dbea7b17f13efc5648bf55eebcb9aff4b968bd00d90301ecde3f87fb84c14234\",\"quote\":\"(3) The organizer must appoint an adult steward who remains on site throughout the time the display remains open. This appointment duty does not apply when an agency employee is assigned to supervise the display for that entire period.\",\"start\":519}],\"id\":\"urn:rulespec:document-understanding:revision:9a63d1238f264f4e097fa1368bd8790aa2fe9e35aaf4fa0fd7358fbb8583c21a\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"(3) The organizer must appoint an adult steward who remains on site throughout the time the display remains open. This appointment duty does not apply when an agency employee is assigned to supervise the display for that entire period.\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:25e3d594238e8f65e404713788a3887d8b4c9956ef6019c2d94dcfc689c37b87\",\"modality\":\"must\",\"modality_quote\":\"must\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:df51a3bfbbccac86e2b50b468d96d80ba02dbae55986ea23d675e2f0f320e13d\",\"origin\":\"aiSuggested\",\"quote\":\"(3) The organizer must appoint an adult steward who remains on site throughout the time the display remains open. This appointment duty does not apply when an agency employee is assigned to supervise the display for that entire period.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:136e1fa997472a0024521c2587b7967ac8de04ee77d65b0f32e9d22e7321185d\",\"scope_quotes\":[\"(a) For a temporary display open to the public after sunset on agency premises, the organizer must satisfy all of the following conditions:\",\"(3) The organizer must appoint an adult steward who remains on site throughout the time the display remains open. This appointment duty does not apply when an agency employee is assigned to supervise the display for that entire period.\"],\"scope_text\":\"For a temporary display open to the public after sunset on agency premises, unless an agency employee is assigned to supervise the display for the entire period the display remains open.\",\"section_id\":\"section-1\",\"start\":519,\"summary\":\"For a temporary display open to the public after sunset on agency premises, the organizer must appoint an adult steward who remains on site throughout the time the display remains open, unless an agency employee is assigned to supervise the display for that entire period.\",\"target_ids\":[],\"typed_values\":[]}",

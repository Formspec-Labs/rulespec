2d681c56417058e5883c90b99d7d8c562af40621c5b8e3d3b614540154d5:1034:1167:sha256-e9b094caa665823399068cbaa95843ab925afb1fd087cd1d36da3154a6090129\",\"quote\":\"(b) When a storm warning is active, the organizer must suspend outdoor demonstrations unless all of the following conditions are met:\",\"start\":1034},{\"end\":1555,\"field\":\"scope_text:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Acd1d2d681c56417058e5883c90b99d7d8c562af40621c5b8e3d3b614540154d5:1354:1555:sha256-76f262896325f8478b95b626857500a006e07a2d4c8aadb8f712cb7a7c69a7c9\",\"quote\":\"(3) An agency officer authorizes the demonstration for the duration of the current warning. The authorization expires when that warning ends; it does not authorize demonstrations under a later warning.\",\"start\":1354}],\"id\":\"urn:rulespec:document-understanding:revision:31b32fb6fc14335ae4c60ce849f8d35e03ca8e240f52d584c73ea2754138c425\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"statement\",\"logic_text\":\"(3) An agency officer authorizes the demonstration for the duration of the current warning. The authorization expires when that warning ends; it does not authorize demonstrations under a later warning.\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:d886de17f91b2517edde907b338caa3f916089d94888cd8f32cf8cab8c7bfd08\",\"modality\":\"not_stated\",\"modality_quote\":\"\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:2c3d1e8cbd1a51d056eaf0174dcfeeda554f2f561dd76e6e1c31247c2f218e73\",\"origin\":\"aiSuggested\",\"quote\":\"(3) An agency officer authorizes the demonstration for the duration of the current warning. The authorization expires when that warning ends; it does not authorize demonstrations under a later warning.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:b83af7a291d2575fede0bb29e07a74acec0bb53334318e3295a0f3bbcacb895c\",\"scope_quotes\":[\"(b) When a storm warning is active, the organizer must suspend outdoor demonstrations unless all of the following conditions are met:\",\"(3) An agency officer authorizes the demonstration for the duration of the current warning. The authorization expires when that warning ends; it does not authorize demonstrations under a later warning.\"],\"scope_text\":\"When an agency officer authorizes an outdoor demonstration during an active storm warning.\",\"section_id\":\"section-1\",\"start\":1354,\"summary\":\"An agency officer's authorization of an outdoor demonstration during a storm warning expires when that warning ends, and it does not authorize demonstrations under a later warning.\",\"target_ids\":[],\"typed_values\":[]}",

      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:850647f315f8fdef82dfe74b3fc0cad401bb15d1c4748dfab8b6c2df9415568d\",\"urn:rulespec:document-understanding:assertion:34071f3a1e20b7fb6c356ce55aee6b85ed6406dc9d24d32bffa653e508ab6d79\",\"urn:rulespec:document-understanding:assertion:5b72d52986d59c42be2af3531b8762c1d44ba0a001a17052975311690185dd47\",\"urn:rulespec:document-understanding:assertion:a29b9822678e218b057a5ad18e82929acc8c7984a91318138dd19a46f8ebb392\",\"urn:rulespec:document-understanding:assertion:99140bfaff901d8a0622663c749ddd4691876ba44c08516bc2c0e029187206fe\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"effective_periods\":[],\"end\":2271,\"evidence\":[{\"end\":2271,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Acd1d2d681c56417058e5883c90b99d7d8c562af40621c5b8e3d3b614540154d5:2031:2271:sha256-5fad6b07c8060301f905323e413c5303b7406c7fad7c3ea318567c5eff1d0bb2\",\"quote\":\"(e) Visitors are not required to supply their home addresses. This policy does not prohibit visitors from bringing paper maps, but other premises rules may restrict particular materials. A queue may form when several groups arrive together.\",\"start\":2031},{\"end\":2271,\"field\":\"logic_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Acd1d2d681c56417058e5883c90b99d7d8c562af40621c5b8e3d3b614540154d5:2031:2271:sha256-5fad6b07c8060301f905323e413c5303b7406c7fad7c3ea318567c5eff1d0bb2\",\"quote\":\"(e) Visitors are not required to supply their home addresses. This policy does not prohibit visitors from bringing paper maps, but other premises rules may restrict particular materials. A queue may form when several groups arrive together.\",\"start\":2031},{\"end\":2271,\"field\":\"scope_text:0\",\"fragment_id\"
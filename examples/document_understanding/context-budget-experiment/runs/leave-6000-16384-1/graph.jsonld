      ]
    },
    {
      "@id": "urn:rulespec:document-understanding:assertion:ad83bfb2a02a1fc03a8dbcb16716af68f7e9a8b4bd1052a8a6271114d69d116f",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:e88b720eed732b45801ee32c463ad924261ca2320ad2e861abebeafcd0a8807d",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:f376fe9d67114c4de466776dccf47269e54209f449e99d41cc09b5cab956adfa",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:a956e4b543eea4ad0d1a077fcfe022774d171572b9de3f096490ad2f67e275d7",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:alternative:1",
      "rkaf:assertsValue": {
        "@value": "(ii) A written agreement, including a collective bargaining agreement, exists concerning the employer's intention to rehire the employee after the break in service (e.g., for purposes of the employee furthering his or her education or for childrearing purposes).",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },
    {
      "@id": "urn:rulespec:document-understanding:binding:6fd1e13873989682b8ffad493ce404c7d109d4887ca73fd6b392d81a84b039c4",

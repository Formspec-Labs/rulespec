      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:states-statement",
      "rkaf:assertsValue": {
        "@value": "If an employee is maintained on the payroll for any part of a week, including any periods of paid or unpaid leave (such as sick or vacation) during which other benefits or compensation are provided by the employer (e.g., workers' compensation, group health plan benefits), the week counts as a week of employment; and for purposes of determining whether intermittent, occasional, or casual employment qualifies as at least 12 months, 52 weeks is deemed equal to 12 months.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

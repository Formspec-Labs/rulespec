      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[\"(1) Has been employed by the employer for at least 12 months, and\",\"(2) Has been employed for at least 1,250 hours of service during the 12-month period immediately preceding the commencement of the leave ( see § 825.801 for special hours of service requirements for airline flight crew employees), and\",\"(3) Is employed at a worksite where 50 or more employees are employed by the employer within 75 miles of that worksite. See § 825.105(b) regarding employees who work outside the U.S.\"],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:8bf9e887b2e8430d933fc0ec5186cc259a7f0f2a451df287d16b0a67b53fa8f1\",\"urn:rulespec:document-understanding:assertion:29802432867ea00615d3bf70cd4e2621fb7140981045ff0f572e320dba2986ba\",\"urn:rulespec:document-understanding:assertion:4e526d3a6bb9adfc1d0923e7a658cd2effc28db963d1f4e72ae0a66c456cb468\",\"urn:rulespec:document-understanding:assertion:1630d819db62f5090bfd8b72ae934ccf2fd971f9bf54ccb3c12d09bbe78268dd\",\"urn:rulespec:document-understanding:assertion:5857806dea22088a943c0f68e1ef7cebe18f2e5f750665b4790985141542d95b\",\"urn:rulespec:document-understanding:assertion:00565a80d5b3d83f590570b30b3199d475d4ddcd85d89fb48163d41102e2be99\",\"urn:rulespec:document-understanding:assertion:0cb4d8a7fb323e8bd58c5f4d04eddc1d3ae89fbd7057895385d4928af62e9987\",\"urn:rulespec:document-understanding:assertion:39cfbfe6ee87f7bcfc4bf66844ca380e0ef7c5b860b34bbfd253b65561f01a69\"],\"choice_quote\":\"(a) An eligible employee is an employee of a covered employer who:\\n\\n(1) Has been employed by the employer for at least 12 months, and\\n\\n(2) Has been employed for at least 1,250 hours of service during the 12-month period immediately preceding the commencement of the leave ( see § 825.801 for special hours of service requirements for airline flight crew employees), and\\n\\n(3) Is employed at a worksite where 50 or more employees are employed by the employer within 75 miles of that worksite. See § 825.105(b) regarding employees who work outside the U.S.\",\"choice_text\":\"An eligible employee must satisfy all three criteria: (1) employed by the employer for at least 12 months; AND (2) employed for at least 1,250 hours of service during the 12-month period immediately preceding the commencement of the leave; AND (3) employed at a worksite where 50 or more employees are employed by the employer within 75 miles of that worksite.\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[\"29 CFR 825.110 — Eligible employee.\"],\"effective_periods\":[],\"end\":590,\"evidence\":[{\"end\":590,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa4cdfc9b75c8a1ed78c29b8a344913757e4b95198a4b069127aa9092960aaf4f:37:590:sha256-e43d03081e43a5cd56466e06b1489af91ab5a4d901b3a2068f64e68e4fa8e5dd\",\"quote\":\"(a) An eligible employee is an employee of a covered employer who:\\n\\n(1) Has been employed by the employer for at least 12 months, and\\n\\n(2) Has been employed for at least 1,250 hours of service during the 12-month period immediately preceding the commencement of the leave ( see § 825.801 for special hours of service requirements for airline flight crew employees), and\\n\\n(3) Is employed at a worksite where 50 or more employees are employed by the employer within 75 miles of that worksite. See § 825.105(b) regarding employees who work outside the U.S.\",\"start\":37},{\"end\":590,\"field\":\"logic_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa4cdfc9b75c8a1ed78c29b8a344913757e4b95198a4b069127aa9092960aaf4f:105:590:sha256-a4146cb35aab2ea08ee13739825b1cfce51ae8bb0f4f18bbc5d245db39a9923b\",\"quote\":\"(1) Has been employed by the employer for at least 12 months, and\\n\\n(2) Has been employed for at least 1,250 hours of service during the 12-month period immediately preceding the commencement of the leave ( see § 825.801 for special hours of service requirements for airline flight crew employees), and\\n\\n(3) Is employed at a worksite where 50 or more employees are employed by the employer within 75 miles of that worksite. See § 825.105(b) regarding employees who work outside the U.S.\",\"start\":105},{\"end\":590,\"field\":\"choice_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa4cdfc9b75c8a1ed78c29b8a344913757e4b95198a4b069127aa9092960aaf4f:37:590:sha256-e43d03081e43a5cd56466e06b1489af91ab5a4d901b3a2068f64e68e4fa8e5dd\",\"quote\":\"(a) An eligible employee is an employee of a covered employer who:\\n\\n(1) Has been employed by the employer for at least 12 months, and\\n\\n(2) Has been employed for at least 1,250 hours of service during the 12-month period immediately preceding the commencement of the leave ( see § 825.801 for special hours of service requirements for airline flight crew employees), and\\n\\n(3) Is employed at a worksite where 50 or more employees are employed by the employer within 75 miles of that worksite. See § 825.105(b) regarding employees who work outside the U.S.\",\"start\":37},{\"end\":35,\"field\":\"context:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa4cdfc9b75c8a1ed78c29b8a344913757e4b95198a4b069127aa9092960aaf4f:0:35:sha256-cdba565171941ded4034f74b1980d94e626fe3b38491ebf5285ac9ba0f59d68b\",\"quote\":\"29 CFR 825.110 — Eligible employee.\",\"start\":0},{\"end\":170,\"field\":\"alternative:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa4cdfc9b75c8a1ed78c29b8a344913757e4b95198a4b069127aa9092960aaf4f:105:170:sha256-65892c2f4a4b04b4af78de1dd2934ed6701e42ce507cd493e35ac4d9a1ba80b0\",\"quote\":\"(1) Has been employed by the employer for at least 12 months, and\",\"start\":105},{\"end\":406,\"field\":\"alternative:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa4cdfc9b75c8a1ed78c29b8a344913757e4b95198a4b069127aa9092960aaf4f:172:406:sha256-f8c620c940dc57284f54426aad3bc219080834d541b71563d59c69ce9eeffe60\",\"quote\":\"(2) Has been employed for at least 1,250 hours of service during the 12-month period immediately preceding the commencement of the leave ( see § 825.801 for special hours of service requirements for airline flight crew employees), and\",\"start\":172},{\"end\":590,\"field\":\"alternative:2\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa4cdfc9b75c8a1ed78c29b8a344913757e4b95198a4b069127aa9092960aaf4f:408:590:sha256-eb912ba3e3b8c4d1913a4740159f38d60c23793adb2467a188d1d44e8220b6ca\",\"quote\":\"(3) Is employed at a worksite where 50 or more employees are employed by the employer within 75 miles of that worksite. See § 825.105(b) regarding employees who work outside the U.S.\",\"start\":408}],\"id\":\"urn:rulespec:document-understanding:revision:51821f6993f99c4f4506b3e5385b06c80e0ab9fc357c1ad0bc2c4306f5a8b0fc\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"definition\",\"logic_text\":\"(1) Has been employed by the employer for at least 12 months, and\\n\\n(2) Has been employed for at least 1,250 hours of service during the 12-month period immediately preceding the commencement of the leave ( see § 825.801 for special hours of service requirements for airline flight crew employees), and\\n\\n(3) Is employed at a worksite where 50 or more employees are employed by the employer within 75 miles of that worksite. See § 825.105(b) regarding employees who work outside the U.S.\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:39cfbfe6ee87f7bcfc4bf66844ca380e0ef7c5b860b34bbfd253b65561f01a69\",\"modality\":\"not_stated\",\"modality_quote\":\"\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:1d5c124b90984bc5beddc3cbb9335214cea9368a01878e209ecc4b5576eca39c\",\"origin\":\"aiSuggested\",\"quote\":\"(a) An eligible employee is an employee of a covered employer who:\\n\\n(1) Has been employed by the employer for at least 12 months, and\\n\\n(2) Has been employed for at least 1,250 hours of service during the 12-month period immediately preceding the commencement of the leave ( see § 825.801 for special hours of service requirements for airline flight crew employees), and\\n\\n(3) Is employed at a worksite where 50 or more employees are employed by the employer within 75 miles of that worksite. See § 825.105(b) regarding employees who work outside the U.S.\",\"references\":[\"§ 825.801\",\"§ 825.105(b)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:c7eee420561dbd508e55cd4672df3b97a166cf78c136389eafb4345877370d0e\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":37,\"summary\":\"An eligible employee is an employee of a covered employer who has been employed by the employer for at least 12 months, has been employed for at least 1,250 hours of service during the 12-month period immediately preceding the commencement of the leave, and is employed at a worksite where 50 or more employees are employed by the employer within 75 miles of that worksite.\",\"target_ids\":[],\"typed_values\":[]}",

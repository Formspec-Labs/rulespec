    {
      "@id": "urn:rulespec:document-understanding:scope:57f052030001bf68f2105897eda2d61e912bfa4ea645e8d07716139f50d4b10c",
      "@type": "rkaf:ApplicabilityScope",
      "rkaf:appliesInJurisdiction": [],
      "rkaf:applicabilityCondition": "In the event an employer does not maintain an accurate record of hours worked by an employee, including employees exempt from FLSA hours-worked recordkeeping requirements."
    },
    {
      "@id": "urn:rulespec:document-understanding:assertion:f33e365ee33969cc7d4672b1c3e4cbdc7210c7e30d7b5e6947bfd608694f9423",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:e88b720eed732b45801ee32c463ad924261ca2320ad2e861abebeafcd0a8807d",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:f376fe9d67114c4de466776dccf47269e54209f449e99d41cc09b5cab956adfa",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:abd156363f2ad43b014b32cbcb4330ee100896096e89a2c0d5b7b01d00881280",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:states-requirement",
      "rkaf:assertsValue": {
        "@value": "In the event an employer does not maintain an accurate record of hours worked by an employee (including for FLSA recordkeeping-exempt employees), the employer has the burden of showing that the employee has not worked the requisite hours, and must be able to clearly demonstrate that the employee did not work 1,250 hours during the previous 12 months in order to claim that the employee is not eligible for FMLA leave.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

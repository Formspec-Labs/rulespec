      "rkaf:appliesInJurisdiction": [],
      "rkaf:applicabilityCondition": "In determining eligibility for FMLA-qualifying leave for an employee returning from or reemployed following USERRA-covered service."
    },
    {
      "@id": "urn:rulespec:document-understanding:assertion:8bca2e196a92f2f676f7421d45ccece9e3cffcb2df6e37fafcc756d16cf90e70",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:e88b720eed732b45801ee32c463ad924261ca2320ad2e861abebeafcd0a8807d",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:f376fe9d67114c4de466776dccf47269e54209f449e99d41cc09b5cab956adfa",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:ba265c294bff39e06c0a059c5bf7bfc4823ecadb255f32d5e78be986e36ed856",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:states-requirement",
      "rkaf:assertsValue": {
        "@value": "An employee returning from USERRA-covered service shall be credited with the hours of service that would have been performed but for the period of absence from work due to or necessitated by USERRA-covered service, and a person reemployed following USERRA-covered service has those hours added to any hours actually worked during the previous 12-month period to meet the hours of service requirement.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

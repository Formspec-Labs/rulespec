      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:e88b720eed732b45801ee32c463ad924261ca2320ad2e861abebeafcd0a8807d",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:f376fe9d67114c4de466776dccf47269e54209f449e99d41cc09b5cab956adfa",

      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:e88b720eed732b45801ee32c463ad924261ca2320ad2e861abebeafcd0a8807d",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:c25ca1ab33c2d6b5301653365dbc9fbc850591ba67910d34b80444e198019e55",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:b091004ddc7aa9755935236891be7e021ab7817bb8756435df2f5045b2c7bf9d",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:states-statement",
      "rkaf:assertsValue": {
        "@value": "Once an employee is determined eligible in response to a notice of the need for leave, the employee's eligibility for that specific notice is not affected by any subsequent change in the number of employees employed at or within 75 miles of the employee's worksite, whether the leave is taken at one time or on an intermittent or reduced leave schedule basis.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

      "rkaf:assertsValue": {
        "@value": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"effective_periods\":[],\"jurisdiction\":\"\",\"kind\":\"statement\",\"logic_text\":\"(3) If an employee is maintained on the payroll for any part of a week, including any periods of paid or unpaid leave (sick, vacation) during which other benefits or compensation are provided by the employer (e.g., workers' compensation, group health plan benefits, etc.), the week counts as a week of employment. For purposes of determining whether intermittent/occasional/casual employment qualifies as at least 12 months, 52 weeks is deemed to be equal to 12 months.\",\"modality\":\"not_stated\",\"object\":\"\",\"scope_text\":\"When an employee is maintained on the payroll for any part of a week, including any periods of paid or unpaid leave during which other benefits or compensation are provided by the employer.\",\"summary\":\"If an employee is maintained on the payroll for any part of a week, including any periods of paid or unpaid leave (such as sick or vacation) during which other benefits or compensation are provided by the employer (e.g., workers' compensation, group health plan benefits), the week counts as a week of employment; and for purposes of determining whether intermittent, occasional, or casual employment qualifies as at least 12 months, 52 weeks is deemed equal to 12 months.\",\"typed_values\":[]}",

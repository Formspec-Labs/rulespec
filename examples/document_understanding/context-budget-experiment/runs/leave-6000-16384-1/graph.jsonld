    {
      "@id": "urn:rulespec:document-understanding:scope:c6d9d5af68140e72668ab0d10d387eb6aa1bbe7d7dd28f839a2ba4a8a971f493",
      "@type": "rkaf:ApplicabilityScope",
      "rkaf:appliesInJurisdiction": [],
      "rkaf:applicabilityCondition": "If an employer employs 60 employees in August, expects that the number of employees will drop to 40 in December, and an otherwise eligible employee gives notice of the need for leave in August for a period of leave to begin in December."
    },
    {
      "@id": "urn:rulespec:document-understanding:assertion:0fecc343054507e999457e0af3e0847309883aed2ab9dc90f7127ac66121ad5c",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:e88b720eed732b45801ee32c463ad924261ca2320ad2e861abebeafcd0a8807d",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:c25ca1ab33c2d6b5301653365dbc9fbc850591ba67910d34b80444e198019e55",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:82f4951f73257c3e8b724ec35e88154537227ad8c57eb3ec2a9d610b87474ae4",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:states-requirement",
      "rkaf:assertsValue": {
        "@value": "An employer must grant FMLA benefits to an otherwise eligible employee who gives notice of the need for leave in August for a period of leave to begin in December, if the employer employs 60 employees in August but expects the number of employees to drop to 40 in December.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },
    {
      "@id": "urn:rulespec:document-understanding:binding:22e573fce43fecf562880f6e49139e538a01a3c01adb49381b3aba457cdb8341",

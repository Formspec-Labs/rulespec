    {
      "@id": "urn:rulespec:document-understanding:revision:b0d1ca09cca98b4995c714c82ea68bd396fe7c9915c301f1ef6176d07f955bc8",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:b0d1ca09cca98b4995c714c82ea68bd396fe7c9915c301f1ef6176d07f955bc8",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:4a06aa98b5cb1088825cedbf7a9109f4585225afa0ddda15373606bb44c7d94b",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:0fecc343054507e999457e0af3e0847309883aed2ab9dc90f7127ac66121ad5c\",\"urn:rulespec:document-understanding:assertion:6222a55c22179fd538684b856b8e3b3143827d6a0fde62592c0c9566cc3acfa0\",\"urn:rulespec:document-understanding:assertion:cffc27cc39b24c681c46e6da1e0e1ca5147b02a1ece7d2a6a4d7c4a1bd8d53c3\",\"urn:rulespec:document-understanding:assertion:38a585903f69c5f455c63e72d36b2a6e4bbafdeef60f03d3786267d14c3336cd\",\"urn:rulespec:document-understanding:assertion:a1735343a055c5ce4931d2b9dc22dea1931205f3e53b428f692d9b76e9558f4a\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"effective_periods\":[],\"end\":6919,\"evidence\":[{\"end\":6919,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa4cdfc9b75c8a1ed78c29b8a344913757e4b95198a4b069127aa9092960aaf4f:5935:6919:sha256-1672ae977263bffd648cf9a677362859d00854d5b07622e1cc91d5bcdd749c8c\",\"quote\":\"(e) Whether 50 employees are employed within 75 miles to ascertain an employee's eligibility for FMLA benefits is determined when the employee gives notice of the need for leave. Whether the leave is to be taken at one time or on an intermittent or reduced leave schedule basis, once an employee is determined eligible in response to that notice of the need for leave, the employee's eligibility is not affected by any subsequent change in the number of employees employed at or within 75 miles of the employee's worksite, for that specific notice of the need for leave. Similarly, an employer may not terminate employee leave that has already started if the employee count drops below 50. For example, if an employer employs 60 employees in August, but expects that the number of employees will drop to 40 in December, the employer must grant FMLA benefits to an otherwise eligible employee who gives notice of the need for leave in August for a period of leave to begin in December.\",\"start\":5935},{\"end\":6919,\"field\":\"logic_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa4cdfc9b75c8a1ed78c29b8a344913757e4b95198a4b069127aa9092960aaf4f:5935:6919:sha256-1672ae977263bffd648cf9a677362859d00854d5b07622e1cc91d5bcdd749c8c\",\"quote\":\"(e) Whether 50 employees are employed within 75 miles to ascertain an employee's eligibility for FMLA benefits is determined when the employee gives notice of the need for leave. Whether the leave is to be taken at one time or on an intermittent or reduced leave schedule basis, once an employee is determined eligible in response to that notice of the need for leave, the employee's eligibility is not affected by any subsequent change in the number of employees employed at or within 75 miles of the employee's worksite, for that specific notice of the need for leave. Similarly, an employer may not terminate employee leave that has already started if the employee count drops below 50. For example, if an employer employs 60 employees in August, but expects that the number of employees will drop to 40 in December, the employer must grant FMLA benefits to an otherwise eligible employee who gives notice of the need for leave in August for a period of leave to begin in December.\",\"start\":5935},{\"end\":6772,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa4cdfc9b75c8a1ed78c29b8a344913757e4b95198a4b069127aa9092960aaf4f:6768:6772:sha256-4137b01e139589b7a1d3b3fc4da031d8ce5bb415808734e970c3a58ea0e98f0f\",\"quote\":\"must\",\"start\":6768},{\"end\":6919,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa4cdfc9b75c8a1ed78c29b8a344913757e4b95198a4b069127aa9092960aaf4f:5935:6919:sha256-1672ae977263bffd648cf9a677362859d00854d5b07622e1cc91d5bcdd749c8c\",\"quote\":\"(e) Whether 50 employees are employed within 75 miles to ascertain an employee's eligibility for FMLA benefits is determined when the employee gives notice of the need for leave. Whether the leave is to be taken at one time or on an intermittent or reduced leave schedule basis, once an employee is determined eligible in response to that notice of the need for leave, the employee's eligibility is not affected by any subsequent change in the number of employees employed at or within 75 miles of the employee's worksite, for that specific notice of the need for leave. Similarly, an employer may not terminate employee leave that has already started if the employee count drops below 50. For example, if an employer employs 60 employees in August, but expects that the number of employees will drop to 40 in December, the employer must grant FMLA benefits to an otherwise eligible employee who gives notice of the need for leave in August for a period of leave to begin in December.\",\"start\":5935}],\"id\":\"urn:rulespec:document-understanding:revision:b0d1ca09cca98b4995c714c82ea68bd396fe7c9915c301f1ef6176d07f955bc8\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"(e) Whether 50 employees are employed within 75 miles to ascertain an employee's eligibility for FMLA benefits is determined when the employee gives notice of the need for leave. Whether the leave is to be taken at one time or on an intermittent or reduced leave schedule basis, once an employee is determined eligible in response to that notice of the need for leave, the employee's eligibility is not affected by any subsequent change in the number of employees employed at or within 75 miles of the employee's worksite, for that specific notice of the need for leave. Similarly, an employer may not terminate employee leave that has already started if the employee count drops below 50. For example, if an employer employs 60 employees in August, but expects that the number of employees will drop to 40 in December, the employer must grant FMLA benefits to an otherwise eligible employee who gives notice of the need for leave in August for a period of leave to begin in December.\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:a1735343a055c5ce4931d2b9dc22dea1931205f3e53b428f692d9b76e9558f4a\",\"modality\":\"must\",\"modality_quote\":\"must\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:aaa2b8ba03d0252a0ab0425f092beb2791c2e0ed5b04eafbd462bbbe87d413e8\",\"origin\":\"aiSuggested\",\"quote\":\"(e) Whether 50 employees are employed within 75 miles to ascertain an employee's eligibility for FMLA benefits is determined when the employee gives notice of the need for leave. Whether the leave is to be taken at one time or on an intermittent or reduced leave schedule basis, once an employee is determined eligible in response to that notice of the need for leave, the employee's eligibility is not affected by any subsequent change in the number of employees employed at or within 75 miles of the employee's worksite, for that specific notice of the need for leave. Similarly, an employer may not terminate employee leave that has already started if the employee count drops below 50. For example, if an employer employs 60 employees in August, but expects that the number of employees will drop to 40 in December, the employer must grant FMLA benefits to an otherwise eligible employee who gives notice of the need for leave in August for a period of leave to begin in December.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:82f4951f73257c3e8b724ec35e88154537227ad8c57eb3ec2a9d610b87474ae4\",\"scope_quotes\":[\"(e) Whether 50 employees are employed within 75 miles to ascertain an employee's eligibility for FMLA benefits is determined when the employee gives notice of the need for leave. Whether the leave is to be taken at one time or on an intermittent or reduced leave schedule basis, once an employee is determined eligible in response to that notice of the need for leave, the employee's eligibility is not affected by any subsequent change in the number of employees employed at or within 75 miles of the employee's worksite, for that specific notice of the need for leave. Similarly, an employer may not terminate employee leave that has already started if the employee count drops below 50. For example, if an employer employs 60 employees in August, but expects that the number of employees will drop to 40 in December, the employer must grant FMLA benefits to an otherwise eligible employee who gives notice of the need for leave in August for a period of leave to begin in December.\"],\"scope_text\":\"If an employer employs 60 employees in August, expects that the number of employees will drop to 40 in December, and an otherwise eligible employee gives notice of the need for leave in August for a period of leave to begin in December.\",\"section_id\":\"section-1\",\"start\":5935,\"summary\":\"An employer must grant FMLA benefits to an otherwise eligible employee who gives notice of the need for leave in August for a period of leave to begin in December, if the employer employs 60 employees in August but expects the number of employees to drop to 40 in December.\",\"target_ids\":[],\"typed_values\":[]}",

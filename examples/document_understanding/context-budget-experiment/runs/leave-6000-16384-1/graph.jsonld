      "rkaf:assertsValue": {
        "@value": "In the event an employer does not maintain an accurate record of hours worked by an employee, including employees exempt from FLSA hours-worked recordkeeping requirements.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },
    {
      "@id": "urn:rulespec:document-understanding:binding:8779448ba66b6168d93015d0848ec86885b7c4ec65d42f15030f20b9ad5ab6e4",

      "rkaf:appliesInJurisdiction": [],
      "rkaf:applicabilityCondition": "For a specific notice of the need for leave, once an employee is determined eligible in response to that notice, whether the leave is to be taken at one time or on an intermittent or reduced leave schedule basis."
    },

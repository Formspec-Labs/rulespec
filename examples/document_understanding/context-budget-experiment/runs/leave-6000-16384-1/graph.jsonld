      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:ffe239412f9e049c96e8c9bda9d15a3392a69548c6c8283e2af7fca784510ed8\",\"urn:rulespec:document-understanding:assertion:41187f9d5435500ac023d1586f7d26bdb08d878d1abd72bc1c6ff20ecb7b3962\",\"urn:rulespec:document-understanding:assertion:fa581632cff0766790444f8c5256bd56ac082c0c0e2b0751d6e6c6011c0dc067\",\"urn:rulespec:document-understanding:assertion:27f494ddff4a4c4973c8fece020744b0028f80566094286fe34f2bb0a232725c\",\"urn:rulespec:document-understanding:assertion:7920631393b8477d75ac490d761cd46d56173e488ed830409f164bc73ffe48d1\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"effective_periods\":[],\"end\":4438,\"evidence\":[{\"end\":4438,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa4cdfc9b75c8a1ed78c29b8a344913757e4b95198a4b069127aa9092960aaf4f:3604:4438:sha256-7dbcb059fc78a2f697d27032e4d0f71484bebb06578094a6d4adecf70f95a027\",\"quote\":\"(2) An employee returning from USERRA-covered service shall be credited with the hours of service that would have been performed but for the period of absence from work due to or necessitated by USERRA-covered service in determining the employee's eligibility for FMLA-qualifying leave. Accordingly, a person reemployed following USERRA-covered service has the hours that would have been worked for the employer added to any hours actually worked during the previous 12-month period to meet the hours of service requirement. In order to determine the hours that would have been worked during the period of absence from work due to or necessitated by USERRA-covered service, the employee's pre-service work schedule can generally be used for calculations. See § 825.801(c) for special rules applicable to airline flight crew employees.\",\"start\":3604},{\"end\":4438,\"field\":\"logic_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa4cdfc9b75c8a1ed78c29b8a344913757e4b95198a4b069127aa9092960aaf4f:3604:4438:sha256-7dbcb059fc78a2f697d27032e4d0f71484bebb06578094a6d4adecf70f95a027\",\"quote\":\"(2) An employee returning from USERRA-covered service shall be credited with the hours of service that would have been performed but for the period of absence from work due to or necessitated by USERRA-covered service in determining the employee's eligibility for FMLA-qualifying leave. Accordingly, a person reemployed following USERRA-covered service has the hours that would have been worked for the employer added to any hours actually worked during the previous 12-month period to meet the hours of service requirement. In order to determine the hours that would have been worked during the period of absence from work due to or necessitated by USERRA-covered service, the employee's pre-service work schedule can generally be used for calculations. See § 825.801(c) for special rules applicable to airline flight crew employees.\",\"start\":3604},{\"end\":4332,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa4cdfc9b75c8a1ed78c29b8a344913757e4b95198a4b069127aa9092960aaf4f:4319:4332:sha256-f02ab51079e97d340ab93b467e90fc06df107cfb146c076758a781a9b899cbcf\",\"quote\":\"can generally\",\"start\":4319},{\"end\":4438,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa4cdfc9b75c8a1ed78c29b8a344913757e4b95198a4b069127aa9092960aaf4f:3604:4438:sha256-7dbcb059fc78a2f697d27032e4d0f71484bebb06578094a6d4adecf70f95a027\",\"quote\":\"(2) An employee returning from USERRA-covered service shall be credited with the hours of service that would have been performed but for the period of absence from work due to or necessitated by USERRA-covered service in determining the employee's eligibility for FMLA-qualifying leave. Accordingly, a person reemployed following USERRA-covered service has the hours that would have been worked for the employer added to any hours actually worked during the previous 12-month period to meet the hours of service requirement. In order to determine the hours that would have been worked during the period of absence from work due to or necessitated by USERRA-covered service, the employee's pre-service work schedule can generally be used for calculations. See § 825.801(c) for special rules applicable to airline flight crew employees.\",\"start\":3604}],\"id\":\"urn:rulespec:document-understanding:revision:863dca4eae35647d89138acb6a1fe7007652459c8366470f6a6d1dca4b67d2db\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"statement\",\"logic_text\":\"(2) An employee returning from USERRA-covered service shall be credited with the hours of service that would have been performed but for the period of absence from work due to or necessitated by USERRA-covered service in determining the employee's eligibility for FMLA-qualifying leave. Accordingly, a person reemployed following USERRA-covered service has the hours that would have been worked for the employer added to any hours actually worked during the previous 12-month period to meet the hours of service requirement. In order to determine the hours that would have been worked during the period of absence from work due to or necessitated by USERRA-covered service, the employee's pre-service work schedule can generally be used for calculations. See § 825.801(c) for special rules applicable to airline flight crew employees.\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:7920631393b8477d75ac490d761cd46d56173e488ed830409f164bc73ffe48d1\",\"modality\":\"possible\",\"modality_quote\":\"can generally\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:7cf7418edce1a3cac402acdaab675cd6f689c94547487b578aa5cc99ad1fc2ac\",\"origin\":\"aiSuggested\",\"quote\":\"(2) An employee returning from USERRA-covered service shall be credited with the hours of service that would have been performed but for the period of absence from work due to or necessitated by USERRA-covered service in determining the employee's eligibility for FMLA-qualifying leave. Accordingly, a person reemployed following USERRA-covered service has the hours that would have been worked for the employer added to any hours actually worked during the previous 12-month period to meet the hours of service requirement. In order to determine the hours that would have been worked during the period of absence from work due to or necessitated by USERRA-covered service, the employee's pre-service work schedule can generally be used for calculations. See § 825.801(c) for special rules applicable to airline flight crew employees.\",\"references\":[\"USERRA\",\"§ 825.801(c)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:8b3449d2e7befb9a52519e037999015f18d3972aaccf35b1cb25a8e98063092f\",\"scope_quotes\":[\"(2) An employee returning from USERRA-covered service shall be credited with the hours of service that would have been performed but for the period of absence from work due to or necessitated by USERRA-covered service in determining the employee's eligibility for FMLA-qualifying leave. Accordingly, a person reemployed following USERRA-covered service has the hours that would have been worked for the employer added to any hours actually worked during the previous 12-month period to meet the hours of service requirement. In order to determine the hours that would have been worked during the period of absence from work due to or necessitated by USERRA-covered service, the employee's pre-service work schedule can generally be used for calculations. See § 825.801(c) for special rules applicable to airline flight crew employees.\"],\"scope_text\":\"In order to determine the hours that would have been worked during the period of absence from work due to or necessitated by USERRA-covered service.\",\"section_id\":\"section-1\",\"start\":3604,\"summary\":\"The employee's pre-service work schedule can generally be used for calculations in order to determine the hours that would have been worked during the period of absence from work due to or necessitated by USERRA-covered service.\",\"target_ids\":[],\"typed_values\":[]}",

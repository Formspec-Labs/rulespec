    {
      "@id": "urn:rulespec:document-understanding:assertion:5e6c5dfbfb855cc664175117e0fd7ff557e29ad762132b2cc44f5015f9b8219f",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:e88b720eed732b45801ee32c463ad924261ca2320ad2e861abebeafcd0a8807d",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:f376fe9d67114c4de466776dccf47269e54209f449e99d41cc09b5cab956adfa",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:abd156363f2ad43b014b32cbcb4330ee100896096e89a2c0d5b7b01d00881280",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"effective_periods\":[],\"jurisdiction\":\"\",\"kind\":\"requirement\",\"logic_text\":\"(3) In the event an employer does not maintain an accurate record of hours worked by an employee, including for employees who are exempt from FLSA's requirement that a record be kept of their hours worked (e.g., bona fide executive, administrative, and professional employees as defined in FLSA Regulations, 29 CFR part 541), the employer has the burden of showing that the employee has not worked the requisite hours. An employer must be able to clearly demonstrate, for example, that full-time teachers ( see § 825.102 for definition) of an elementary or secondary school system, or institution of higher education, or other educational establishment or institution (who often work outside the classroom or at their homes) did not work 1,250 hours during the previous 12 months in order to claim that the teachers are not eligible for FMLA leave. See § 825.801(d) for special rules applicable to airline flight crew employees.\",\"modality\":\"must\",\"object\":\"\",\"scope_text\":\"In the event an employer does not maintain an accurate record of hours worked by an employee, including employees exempt from FLSA hours-worked recordkeeping requirements.\",\"summary\":\"In the event an employer does not maintain an accurate record of hours worked by an employee (including for FLSA recordkeeping-exempt employees), the employer has the burden of showing that the employee has not worked the requisite hours, and must be able to clearly demonstrate that the employee did not work 1,250 hours during the previous 12 months in order to claim that the employee is not eligible for FMLA leave.\",\"typed_values\":[]}",
        "@type": "xsd:string"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed",
      "rkaf:hasApplicability": "urn:rulespec:document-understanding:scope:57f052030001bf68f2105897eda2d61e912bfa4ea645e8d07716139f50d4b10c"
    },

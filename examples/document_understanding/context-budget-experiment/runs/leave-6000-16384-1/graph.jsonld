    {
      "@id": "urn:rulespec:document-understanding:revision:fca1b50343aadae9fcbbb50c5de24c788f45b4abebbcec0e81f2fb024d6d8bb8",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:fca1b50343aadae9fcbbb50c5de24c788f45b4abebbcec0e81f2fb024d6d8bb8",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:f3746a0ee6df94c52c516661018ae0fc37560e1adb38f9a0284a6a7aa4245321",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:8bca2e196a92f2f676f7421d45ccece9e3cffcb2df6e37fafcc756d16cf90e70\",\"urn:rulespec:document-understanding:assertion:8bf523ed5ceca496b6517fe2b81bc5a5564694819152d88a12e54ef4112c2afa\",\"urn:rulespec:document-understanding:assertion:f096e37225d3f70d57098e0ea9ded4f89ca8f4389c119d91239146b0948ea562\",\"urn:rulespec:document-understanding:assertion:eaaed78b795186146bdd67eaf5ca132bdf2ce921662fea3269f81b80c74e5873\",\"urn:rulespec:document-understanding:assertion:dff23859cb03852bf69d39d7d37d93e2803ee981f8583f856637c9072fbeeadd\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"effective_periods\":[],\"end\":4438,\"evidence\":[{\"end\":4438,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa4cdfc9b75c8a1ed78c29b8a344913757e4b95198a4b069127aa9092960aaf4f:3604:4438:sha256-7dbcb059fc78a2f697d27032e4d0f71484bebb06578094a6d4adecf70f95a027\",\"quote\":\"(2) An employee returning from USERRA-covered service shall be credited with the hours of service that would have been performed but for the period of absence from work due to or necessitated by USERRA-covered service in determining the employee's eligibility for FMLA-qualifying leave. Accordingly, a person reemployed following USERRA-covered service has the hours that would have been worked for the employer added to any hours actually worked during the previous 12-month period to meet the hours of service requirement. In order to determine the hours that would have been worked during the period of absence from work due to or necessitated by USERRA-covered service, the employee's pre-service work schedule can generally be used for calculations. See § 825.801(c) for special rules applicable to airline flight crew employees.\",\"start\":3604},{\"end\":4438,\"field\":\"logic_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa4cdfc9b75c8a1ed78c29b8a344913757e4b95198a4b069127aa9092960aaf4f:3604:4438:sha256-7dbcb059fc78a2f697d27032e4d0f71484bebb06578094a6d4adecf70f95a027\",\"quote\":\"(2) An employee returning from USERRA-covered service shall be credited with the hours of service that would have been performed but for the period of absence from work due to or necessitated by USERRA-covered service in determining the employee's eligibility for FMLA-qualifying leave. Accordingly, a person reemployed following USERRA-covered service has the hours that would have been worked for the employer added to any hours actually worked during the previous 12-month period to meet the hours of service requirement. In order to determine the hours that would have been worked during the period of absence from work due to or necessitated by USERRA-covered service, the employee's pre-service work schedule can generally be used for calculations. See § 825.801(c) for special rules applicable to airline flight crew employees.\",\"start\":3604},{\"end\":3663,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa4cdfc9b75c8a1ed78c29b8a344913757e4b95198a4b069127aa9092960aaf4f:3658:3663:sha256-56ee5b508706bf2de91712d85d6d1e11ddbff01949142ed6e8c22e3b1bed1c71\",\"quote\":\"shall\",\"start\":3658},{\"end\":4438,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa4cdfc9b75c8a1ed78c29b8a344913757e4b95198a4b069127aa9092960aaf4f:3604:4438:sha256-7dbcb059fc78a2f697d27032e4d0f71484bebb06578094a6d4adecf70f95a027\",\"quote\":\"(2) An employee returning from USERRA-covered service shall be credited with the hours of service that would have been performed but for the period of absence from work due to or necessitated by USERRA-covered service in determining the employee's eligibility for FMLA-qualifying leave. Accordingly, a person reemployed following USERRA-covered service has the hours that would have been worked for the employer added to any hours actually worked during the previous 12-month period to meet the hours of service requirement. In order to determine the hours that would have been worked during the period of absence from work due to or necessitated by USERRA-covered service, the employee's pre-service work schedule can generally be used for calculations. See § 825.801(c) for special rules applicable to airline flight crew employees.\",\"start\":3604}],\"id\":\"urn:rulespec:document-understanding:revision:fca1b50343aadae9fcbbb50c5de24c788f45b4abebbcec0e81f2fb024d6d8bb8\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"(2) An employee returning from USERRA-covered service shall be credited with the hours of service that would have been performed but for the period of absence from work due to or necessitated by USERRA-covered service in determining the employee's eligibility for FMLA-qualifying leave. Accordingly, a person reemployed following USERRA-covered service has the hours that would have been worked for the employer added to any hours actually worked during the previous 12-month period to meet the hours of service requirement. In order to determine the hours that would have been worked during the period of absence from work due to or necessitated by USERRA-covered service, the employee's pre-service work schedule can generally be used for calculations. See § 825.801(c) for special rules applicable to airline flight crew employees.\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:dff23859cb03852bf69d39d7d37d93e2803ee981f8583f856637c9072fbeeadd\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:58e20fb338dcd82bf8d3bda42b31c3c4bdc97440f1ca19ff375e00ac52c2e3cf\",\"origin\":\"aiSuggested\",\"quote\":\"(2) An employee returning from USERRA-covered service shall be credited with the hours of service that would have been performed but for the period of absence from work due to or necessitated by USERRA-covered service in determining the employee's eligibility for FMLA-qualifying leave. Accordingly, a person reemployed following USERRA-covered service has the hours that would have been worked for the employer added to any hours actually worked during the previous 12-month period to meet the hours of service requirement. In order to determine the hours that would have been worked during the period of absence from work due to or necessitated by USERRA-covered service, the employee's pre-service work schedule can generally be used for calculations. See § 825.801(c) for special rules applicable to airline flight crew employees.\",\"references\":[\"USERRA\",\"§ 825.801(c)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:ba265c294bff39e06c0a059c5bf7bfc4823ecadb255f32d5e78be986e36ed856\",\"scope_quotes\":[\"(2) An employee returning from USERRA-covered service shall be credited with the hours of service that would have been performed but for the period of absence from work due to or necessitated by USERRA-covered service in determining the employee's eligibility for FMLA-qualifying leave. Accordingly, a person reemployed following USERRA-covered service has the hours that would have been worked for the employer added to any hours actually worked during the previous 12-month period to meet the hours of service requirement. In order to determine the hours that would have been worked during the period of absence from work due to or necessitated by USERRA-covered service, the employee's pre-service work schedule can generally be used for calculations. See § 825.801(c) for special rules applicable to airline flight crew employees.\"],\"scope_text\":\"In determining eligibility for FMLA-qualifying leave for an employee returning from or reemployed following USERRA-covered service.\",\"section_id\":\"section-1\",\"start\":3604,\"summary\":\"An employee returning from USERRA-covered service shall be credited with the hours of service that would have been performed but for the period of absence from work due to or necessitated by USERRA-covered service, and a person reemployed following USERRA-covered service has those hours added to any hours actually worked during the previous 12-month period to meet the hours of service requirement.\",\"target_ids\":[],\"typed_values\":[]}",

      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:70f8d0e59af8e1d2c6512ac5a22ef886d2cf8f57cbd80bdd5bf830c456f3b43f\",\"urn:rulespec:document-understanding:assertion:257127098dabc93fa7882bb1c5754b78ce8d44d97d13fb5c55c236a63cab79ed\",\"urn:rulespec:document-understanding:assertion:7c588e294081e3fcedb3c26166709dbaff0f031cf5c8ddcb55b814879b358904\",\"urn:rulespec:document-understanding:assertion:adf738a5c168d5fb88d00985583cf10d1a0dc2f77fb32877f3fd296715d80aa0\",\"urn:rulespec:document-understanding:assertion:1bc4e231722470f99aca35152d9ead85edbc0267823948fadc00c52db3e9a1ac\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"effective_periods\":[],\"end\":2804,\"evidence\":[{\"end\":2804,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa4cdfc9b75c8a1ed78c29b8a344913757e4b95198a4b069127aa9092960aaf4f:2419:2804:sha256-668999c51c74d480383126ed520172cea18a50cba1239cdc7337af5ed0e7a425\",\"quote\":\"(4) Nothing in this section prevents employers from considering employment prior to a continuous break in service of more than seven years when determining whether an employee has met the 12-month employment requirement. However, if an employer chooses to recognize such prior employment, the employer must do so uniformly, with respect to all employees with similar breaks in service.\",\"start\":2419},{\"end\":2804,\"field\":\"logic_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa4cdfc9b75c8a1ed78c29b8a344913757e4b95198a4b069127aa9092960aaf4f:2419:2804:sha256-668999c51c74d480383126ed520172cea18a50cba1239cdc7337af5ed0e7a425\",\"quote\":\"(4) Nothing in this section prevents employers from considering employment prior to a continuous break in service of more than seven years when determining whether an employee has met the 12-month employment requirement. However, if an employer chooses to recognize such prior employment, the employer must do so uniformly, with respect to all employees with similar breaks in service.\",\"start\":2419},{\"end\":2725,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa4cdfc9b75c8a1ed78c29b8a344913757e4b95198a4b069127aa9092960aaf4f:2721:2725:sha256-4137b01e139589b7a1d3b3fc4da031d8ce5bb415808734e970c3a58ea0e98f0f\",\"quote\":\"must\",\"start\":2721},{\"end\":2804,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa4cdfc9b75c8a1ed78c29b8a344913757e4b95198a4b069127aa9092960aaf4f:2419:2804:sha256-668999c51c74d480383126ed520172cea18a50cba1239cdc7337af5ed0e7a425\",\"quote\":\"(4) Nothing in this section prevents employers from considering employment prior to a continuous break in service of more than seven years when determining whether an employee has met the 12-month employment requirement. However, if an employer chooses to recognize such prior employment, the employer must do so uniformly, with respect to all employees with similar breaks in service.\",\"start\":2419}],\"id\":\"urn:rulespec:document-understanding:revision:4ccc6c47acb14840c34df47cc754740d9beafab65f5719ca0622f89e683bfe48\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"(4) Nothing in this section prevents employers from considering employment prior to a continuous break in service of more than seven years when determining whether an employee has met the 12-month employment requirement. However, if an employer chooses to recognize such prior employment, the employer must do so uniformly, with respect to all employees with similar breaks in service.\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:1bc4e231722470f99aca35152d9ead85edbc0267823948fadc00c52db3e9a1ac\",\"modality\":\"must\",\"modality_quote\":\"must\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:ec28587f16b41120649cfc81b419ee13042da01aa34a89c5aa14bab4b48794d7\",\"origin\":\"aiSuggested\",\"quote\":\"(4) Nothing in this section prevents employers from considering employment prior to a continuous break in service of more than seven years when determining whether an employee has met the 12-month employment requirement. However, if an employer chooses to recognize such prior employment, the employer must do so uniformly, with respect to all employees with similar breaks in service.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:6c9ccffdd75ad3c1b93c50bc73f1e479d8cebca495a3b206708d471e3dd788fc\",\"scope_quotes\":[\"(4) Nothing in this section prevents employers from considering employment prior to a continuous break in service of more than seven years when determining whether an employee has met the 12-month employment requirement. However, if an employer chooses to recognize such prior employment, the employer must do so uniformly, with respect to all employees with similar breaks in service.\"],\"scope_text\":\"If an employer chooses to recognize employment prior to a continuous break in service of more than seven years.\",\"section_id\":\"section-1\",\"start\":2419,\"summary\":\"If an employer chooses to recognize employment prior to a continuous break in service of more than seven years when determining whether an employee has met the 12-month employment requirement, the employer must do so uniformly with respect to all employees with similar breaks in service.\",\"target_ids\":[],\"typed_values\":[]}",
      "dcterms:references": [
        {
          "@id": "urn:rulespec:document-understanding:assertion:70f8d0e59af8e1d2c6512ac5a22ef886d2cf8f57cbd80bdd5bf830c456f3b43f"

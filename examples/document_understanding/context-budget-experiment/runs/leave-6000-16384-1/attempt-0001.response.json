            "text": "{\n  \"extractions\": [\n    {\n      \"unit\": \"F000\",\n      \"unit_attributes\": {\n        \"kind\": \"statement\",\n        \"scope_quotes\": [\n          \"F000\"\n        ],\n        \"scope_text\": \"When determining whether 50 employees are employed within 75 miles to ascertain an employee's eligibility for FMLA benefits.\",\n        \"context_quotes\": [],\n        \"modality_quote\": \"\",\n        \"modality\": \"not_stated\",\n        \"alternative_quotes\": [],\n        \"choice_quote\": \"\",\n        \"choice_text\": \"\",\n        \"logic_quote\": \"F000\",\n        \"references\": [],\n        \"statement\": \"Whether 50 employees are employed within 75 miles to ascertain an employee's eligibility for FMLA benefits is determined when the employee gives notice of the need for leave.\"\n      }\n    },\n    {\n      \"unit\": \"F000\",\n      \"unit_attributes\": {\n        \"kind\": \"statement\",\n        \"scope_quotes\": [\n          \"F000\"\n        ],\n        \"scope_text\": \"For a specific notice of the need for leave, once an employee is determined eligible in response to that notice, whether the leave is to be taken at one time or on an intermittent or reduced leave schedule basis.\",\n        \"context_quotes\": [],\n        \"modality_quote\": \"\",\n        \"modality\": \"not_stated\",\n        \"alternative_quotes\": [\n          \"F000\"\n        ],\n        \"choice_quote\": \"F000\",\n        \"choice_text\": \"Leave to be taken at one time, OR on an intermittent basis, OR on a reduced leave schedule basis.\",\n        \"logic_quote\": \"F000\",\n        \"references\": [],\n        \"statement\": \"Once an employee is determined eligible in response to a notice of the need for leave, the employee's eligibility for that specific notice is not affected by any subsequent change in the number of employees employed at or within 75 miles of the employee's worksite, whether the leave is taken at one time or on an intermittent or reduced leave schedule basis.\"\n      }\n    },\n    {\n      \"unit\": \"F000\",\n      \"unit_attributes\": {\n        \"kind\": \"prohibition\",\n        \"scope_quotes\": [\n          \"F000\"\n        ],\n        \"scope_text\": \"If an employee's leave has already started and the employee count drops below 50.\",\n        \"context_quotes\": [],\n        \"modality_quote\": \"may not\",\n        \"modality\": \"must_not\",\n        \"alternative_quotes\": [],\n        \"choice_quote\": \"\",\n        \"choice_text\": \"\",\n        \"logic_quote\": \"F000\",\n        \"references\": [],\n        \"statement\": \"An employer may not terminate employee leave that has already started if the employee count drops below 50.\"\n      }\n    },\n    {\n      \"unit\": \"F000\",\n      \"unit_attributes\": {\n        \"kind\": \"requirement\",\n        \"scope_quotes\": [\n          \"F000\"\n        ],\n        \"scope_text\": \"If an employer employs 60 employees in August, expects that the number of employees will drop to 40 in December, and an otherwise eligible employee gives notice of the need for leave in August for a period of leave to begin in December.\",\n        \"context_quotes\": [],\n        \"modality_quote\": \"must\",\n        \"modality\": \"must\",\n        \"alternative_quotes\": [],\n        \"choice_quote\": \"\",\n        \"choice_text\": \"\",\n        \"logic_quote\": \"F000\",\n        \"references\": [],\n        \"statement\": \"An employer must grant FMLA benefits to an otherwise eligible employee who gives notice of the need for leave in August for a period of leave to begin in December, if the employer employs 60 employees in August but expects the number of employees to drop to 40 in December.\"\n      }\n    }\n  ]\n}",

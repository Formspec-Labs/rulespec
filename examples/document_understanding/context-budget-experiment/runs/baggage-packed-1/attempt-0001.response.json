      {
        "unit": "F002:F006",
        "unit_attributes": {
          "kind": "prohibition",
          "scope_quotes": [
            "F000"
          ],
          "scope_text": "In checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter.",
          "context_quotes": [],
          "modality_quote": "may not",
          "modality": "must_not",
          "alternative_quotes": [
            "F003"
          ],
          "choice_quote": "F003",
          "choice_text": "Declaration to the aircraft operator may be made either orally or in writing.",
          "logic_quote": "F002:F006",
          "references": [
            "§ 1562.23"
          ],
          "statement": "A passenger may not transport or offer for transport in checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter any unloaded firearm(s), unless: (i) the passenger declares to the aircraft operator, either orally or in writing, before checking the baggage, that the passenger has a firearm in his or her bag and that it is unloaded; (ii) the firearm is unloaded; (iii) the firearm is carried in a hard-sided container; and (iv) the container in which it is carried is locked, and only the passenger retains the key or combination."
        }
      },

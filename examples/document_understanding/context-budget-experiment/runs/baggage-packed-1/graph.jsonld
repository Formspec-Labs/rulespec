    {
      "@id": "urn:rulespec:document-understanding:scope:5f29d3b9d3e9fa93b51ebccce76e273fe555c551eae806f6b71e80906c2292ef",
      "@type": "rkaf:ApplicabilityScope",
      "rkaf:appliesInJurisdiction": [],
      "rkaf:applicabilityCondition": "Applies to the carriage of firearms and other weapons on an individual's person or accessible property that would otherwise be prohibited under paragraph (a) of 49 CFR 1540.111."
    },
    {
      "@id": "urn:rulespec:document-understanding:assertion:f111979864e83ccfaf601b6c8e62cc43fc6063e7aca380b63166a01f35b0c106",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:f3fc35d1175fcd0f13d4f30d00e47f00ee63fc84156ab4e949ff8a3f70e6c3a2",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:6df355011dfba00a68260f08e9d85f5ef9bfe9e32c98603b0233c8fe6cf068d4",

      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:f3fc35d1175fcd0f13d4f30d00e47f00ee63fc84156ab4e949ff8a3f70e6c3a2",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:6df355011dfba00a68260f08e9d85f5ef9bfe9e32c98603b0233c8fe6cf068d4",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:0cd8de8c1ab823c857bbc569ce5c4628eb98aabf8d386b7ba46ff7bd47ca7054",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[\"(1) Law enforcement personnel required to carry a firearm or other weapons while in the performance of law enforcement duty at the airport.\",\"(2) An individual authorized to carry a weapon in accordance with §§ 1544.219, 1544.221, 1544.223, 1546.211, or subpart B of part 1562 of this chapter.\",\"(3) An individual authorized to carry a weapon in a sterile area under a security program.\"],\"choice_text\":\"Paragraph (a) does not apply if the individual is one of the following: (1) law enforcement personnel required to carry a firearm or other weapons while in the performance of law enforcement duty at the airport; OR (2) an individual authorized to carry a weapon in accordance with §§ 1544.219, 1544.221, 1544.223, 1546.211, or subpart B of part 1562 of this chapter; OR (3) an individual authorized to carry a weapon in a sterile area under a security program.\",\"claimants\":[],\"concepts\":[],\"effective_periods\":[],\"jurisdiction\":\"\",\"kind\":\"exemption\",\"logic_text\":\"(b) On an individual's person or accessible property—permitted carriage of a weapon. Paragraph (a) of this section does not apply as to carriage of firearms and other weapons if the individual is one of the following:\",\"modality\":\"not_required\",\"object\":\"\",\"scope_text\":\"Applies to the carriage of firearms and other weapons on an individual's person or accessible property that would otherwise be prohibited under paragraph (a) of 49 CFR 1540.111.\",\"summary\":\"Paragraph (a) of 49 CFR 1540.111 does not apply as to carriage of firearms and other weapons on an individual's person or accessible property if the individual is: (1) law enforcement personnel required to carry a firearm or other weapons while in the performance of law enforcement duty at the airport; (2) an individual authorized to carry a weapon in accordance with §§ 1544.219, 1544.221, 1544.223, 1546.211, or subpart B of part 1562 of this chapter; or (3) an individual authorized to carry a weapon in a sterile area under a security program.\",\"typed_values\":[]}",
        "@type": "xsd:string"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed",
      "rkaf:hasApplicability": "urn:rulespec:document-understanding:scope:5f29d3b9d3e9fa93b51ebccce76e273fe555c551eae806f6b71e80906c2292ef"
    },

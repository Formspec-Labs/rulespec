      "@id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aab45ff8a7d213a548ba64b9bd9efdd9202dcd2f94cc0c1045a1b5fb69fe86460:1586:1621:sha256-a03b234b39a7e3d902b46246302bd2c0d5986a277e51dcd12feeb18f5483f16c",

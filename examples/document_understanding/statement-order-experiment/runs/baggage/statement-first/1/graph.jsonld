    {
      "@id": "urn:rulespec:document-understanding:assertion:8c684a3cc8096ae3f7fa9e0733c0f3ff271a461b4c69dffc474883a6b0970be5",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:50cc3dcc901d49cd4e5d5d7c017ef0f698e31c69ebd78f3a990e60a5484eb25f",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:71484ec1a539446f3c3c9ca4014c58e96cd8ac1c0aa437ef5a8e6574d32a95c6",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:f16870c09ae85d404da42d1af1869d35776d78afe3753efff09efadbb982f767",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[\"(1) When performance has begun of the inspection of the individual's person or accessible property before entering a sterile area, or before boarding an aircraft for which screening is conducted under this subchapter;\",\"(2) When the individual is entering or in a sterile area; or\",\"(3) When the individual is attempting to board or onboard an aircraft for which screening is conducted under §§ 1544.201, 1546.201, or 1562.23 of this chapter.\"],\"choice_text\":\"Applies under any of the following circumstances: (1) inspection has begun before entering a sterile area or boarding a screened aircraft; (2) entering or in a sterile area; or (3) attempting to board or onboard a screened aircraft under §§ 1544.201, 1546.201, or 1562.23.\",\"claimants\":[],\"concepts\":[],\"effective_periods\":[],\"jurisdiction\":\"\",\"kind\":\"prohibition\",\"logic_text\":\"(a) On an individual's person or accessible property—prohibitions. Except as provided in paragraph (b) of this section, an individual may not have a weapon, explosive, or incendiary, on or about the individual's person or accessible property—\\n\\n(1) When performance has begun of the inspection of the individual's person or accessible property before entering a sterile area, or before boarding an aircraft for which screening is conducted under this subchapter;\\n\\n(2) When the individual is entering or in a sterile area; or\\n\\n(3) When the individual is attempting to board or onboard an aircraft for which screening is conducted under §§ 1544.201, 1546.201, or 1562.23 of this chapter.\",\"modality\":\"must_not\",\"object\":\"\",\"scope_text\":\"Except as provided in paragraph (b) of this section, when performance has begun of the inspection of the individual's person or accessible property before entering a sterile area or before boarding an aircraft for which screening is conducted under this subchapter; when the individual is entering or in a sterile area; or when attempting to board or onboard an aircraft for which screening is conducted under §§ 1544.201, 1546.201, or 1562.23.\",\"summary\":\"Except as provided in paragraph (b) of this section, an individual may not have a weapon, explosive, or incendiary on or about the individual's person or accessible property when performance has begun of the inspection of the individual's person or accessible property before entering a sterile area, or before boarding an aircraft for which screening is conducted under this subchapter; when the individual is entering or in a sterile area; or when the individual is attempting to board or onboard an aircraft for which screening is conducted under §§ 1544.201, 1546.201, or 1562.23 of this chapter.\",\"typed_values\":[]}",
        "@type": "xsd:string"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed",

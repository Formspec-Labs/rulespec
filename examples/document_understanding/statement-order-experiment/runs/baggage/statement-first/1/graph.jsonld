      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:50cc3dcc901d49cd4e5d5d7c017ef0f698e31c69ebd78f3a990e60a5484eb25f",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:71484ec1a539446f3c3c9ca4014c58e96cd8ac1c0aa437ef5a8e6574d32a95c6",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:479b169e4b5f23e67b1874a308b24600afa668a1702978031a8f1a4c91462d4c",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:choice_text",
      "rkaf:assertsValue": {
        "@value": "Applies if the individual is any of the following: (1) law enforcement personnel required to carry a firearm or other weapons while performing law enforcement duty at the airport; (2) an individual authorized to carry a weapon under §§ 1544.219, 1544.221, 1544.223, 1546.211, or 49 CFR part 1562 subpart B; or (3) an individual authorized to carry a weapon in a sterile area under a security program.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"

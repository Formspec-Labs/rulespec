    {
      "@id": "urn:rulespec:document-understanding:assertion:2884beb8a4271a9fe651ece2f4eb13b5ab985758cbd3013342a43fbfab17ab3a",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:50cc3dcc901d49cd4e5d5d7c017ef0f698e31c69ebd78f3a990e60a5484eb25f",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:71484ec1a539446f3c3c9ca4014c58e96cd8ac1c0aa437ef5a8e6574d32a95c6",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:479b169e4b5f23e67b1874a308b24600afa668a1702978031a8f1a4c91462d4c",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[\"(1) Law enforcement personnel required to carry a firearm or other weapons while in the performance of law enforcement duty at the airport.\",\"(2) An individual authorized to carry a weapon in accordance with §§ 1544.219, 1544.221, 1544.223, 1546.211, or subpart B of part 1562 of this chapter.\",\"(3) An individual authorized to carry a weapon in a sterile area under a security program.\"],\"choice_text\":\"Applies if the individual is any of the following: (1) law enforcement personnel required to carry a firearm or other weapons while performing law enforcement duty at the airport; (2) an individual authorized to carry a weapon under §§ 1544.219, 1544.221, 1544.223, 1546.211, or 49 CFR part 1562 subpart B; or (3) an individual authorized to carry a weapon in a sterile area under a security program.\",\"claimants\":[],\"concepts\":[],\"effective_periods\":[],\"jurisdiction\":\"\",\"kind\":\"exemption\",\"logic_text\":\"(b) On an individual's person or accessible property—permitted carriage of a weapon. Paragraph (a) of this section does not apply as to carriage of firearms and other weapons if the individual is one of the following:\\n\\n(1) Law enforcement personnel required to carry a firearm or other weapons while in the performance of law enforcement duty at the airport.\\n\\n(2) An individual authorized to carry a weapon in accordance with §§ 1544.219, 1544.221, 1544.223, 1546.211, or subpart B of part 1562 of this chapter.\\n\\n(3) An individual authorized to carry a weapon in a sterile area under a security program.\",\"modality\":\"not_required\",\"object\":\"\",\"scope_text\":\"As to carriage of firearms and other weapons on an individual's person or accessible property, if the individual is qualifying law enforcement personnel or an authorized individual under specified provisions or a security program.\",\"summary\":\"Paragraph (a) of this section does not apply as to carriage of firearms and other weapons if the individual is law enforcement personnel required to carry a firearm or other weapons while in the performance of law enforcement duty at the airport; an individual authorized to carry a weapon in accordance with §§ 1544.219, 1544.221, 1544.223, 1546.211, or subpart B of part 1562 of this chapter; or an individual authorized to carry a weapon in a sterile area under a security program.\",\"typed_values\":[]}",
        "@type": "xsd:string"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed",
      "rkaf:hasApplicability": "urn:rulespec:document-understanding:scope:c95967110ee3ffade18b1548951b393dfbb35420860834c1cffa3b3e1aea88db"
    },

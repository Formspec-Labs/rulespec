    {
      "@id": "urn:rulespec:document-understanding:assertion:1b2c7b5d16b96068c8df836018fcc834f868ae133ce524b10467fd09aebf0a58",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:50cc3dcc901d49cd4e5d5d7c017ef0f698e31c69ebd78f3a990e60a5484eb25f",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:71484ec1a539446f3c3c9ca4014c58e96cd8ac1c0aa437ef5a8e6574d32a95c6",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:5f58ffc3fe3102200d9a60d9d906f08c9630ba14e1bace0e1457d1990d7a48d4",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[\"(i) The passenger declares to the aircraft operator, either orally or in writing, before checking the baggage, that the passenger has a firearm in his or her bag and that it is unloaded;\"],\"choice_text\":\"The passenger must declare to the aircraft operator either orally or in writing before checking the baggage.\",\"claimants\":[],\"concepts\":[],\"effective_periods\":[],\"jurisdiction\":\"\",\"kind\":\"prohibition\",\"logic_text\":\"(2) Any unloaded firearm(s) unless—\\n\\n(i) The passenger declares to the aircraft operator, either orally or in writing, before checking the baggage, that the passenger has a firearm in his or her bag and that it is unloaded;\\n\\n(ii) The firearm is unloaded;\\n\\n(iii) The firearm is carried in a hard-sided container; and\\n\\n(iv) The container in which it is carried is locked, and only the passenger retains the key or combination.\",\"modality\":\"must_not\",\"object\":\"\",\"scope_text\":\"In checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter, for any unloaded firearm(s), unless all four conditions in paragraphs (c)(2)(i) through (iv) are satisfied.\",\"summary\":\"A passenger may not transport or offer for transport in checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter any unloaded firearm(s) unless the passenger declares to the aircraft operator, either orally or in writing, before checking the baggage, that the passenger has a firearm in his or her bag and that it is unloaded; the firearm is unloaded; the firearm is carried in a hard-sided container; and the container in which it is carried is locked, and only the passenger retains the key or combination.\",\"typed_values\":[]}",
        "@type": "xsd:string"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed",
      "rkaf:hasApplicability": "urn:rulespec:document-understanding:scope:647f7a161e8e367bdb73c7a8e1a4d3724037331a193d96c85812c9cc8ce90b6d"
    },

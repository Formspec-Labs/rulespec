      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "(b) On an individual's person or accessible property—permitted carriage of a weapon. Paragraph (a) of this section does not apply as to carriage of firearms and other weapons if the individual is one of the following:"
        },
        {
          "@type": "oa:TextPositionSelector",
          "oa:start": 771,
          "oa:end": 988,

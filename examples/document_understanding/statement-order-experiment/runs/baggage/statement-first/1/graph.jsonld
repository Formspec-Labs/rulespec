    {
      "@id": "urn:rulespec:document-understanding:scope:647f7a161e8e367bdb73c7a8e1a4d3724037331a193d96c85812c9cc8ce90b6d",
      "@type": "rkaf:ApplicabilityScope",
      "rkaf:appliesInJurisdiction": [],
      "rkaf:applicabilityCondition": "In checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter, for any unloaded firearm(s), unless all four conditions in paragraphs (c)(2)(i) through (iv) are satisfied."
    },
    {
      "@id": "urn:rulespec:document-understanding:assertion:ffeb2df69c99cc4bad5984b2b3028558304404bd07147a32b240ee14f9b83f48",

      "@id": "urn:rulespec:document-understanding:binding:80a6ca7723649a276e8267ac1eeb5d8366a39a8dd4d6cfcaa05c2c8013526f2d",
      "@type": "rkaf:EvidenceBinding",
      "rkaf:bindsAssertion": "urn:rulespec:document-understanding:assertion:c4acfc4d480ce5c9b52507038210b482fab26aa16f03b55190cdda3e711dbee3",

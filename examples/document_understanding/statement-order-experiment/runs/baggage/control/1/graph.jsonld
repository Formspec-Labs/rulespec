      "@id": "urn:rulespec:document-understanding:assertion:d4f074eb7e76ae570e2ee1ec617c6fc65608ffdebe1728145791e0508dcd1b90",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:cb56a1d17abee0213f1a91829b322cf17a9797de4ca7aca77922240992a7b2e0",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:68b0d0f6fbaeef320b74ec4d64e907f0a6bc07c4a8634e66bc810815fbbb694d",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:2d4032a6bf2509b4c3be60d800590ec82976b2613a6ba997534d444810d3088b",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:choice_text",
      "rkaf:assertsValue": {
        "@value": "Transportation is prohibited unless all four conditions are satisfied: (i) the passenger declares to the aircraft operator, orally or in writing, before checking baggage, that the passenger has a firearm in the bag and it is unloaded; (ii) the firearm is unloaded; (iii) the firearm is carried in a hard-sided container; and (iv) the container is locked and only the passenger retains the key or combination.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:68b0d0f6fbaeef320b74ec4d64e907f0a6bc07c4a8634e66bc810815fbbb694d",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:2cfd1c5b1c5657c1517651a62f95d5bc71a72d72ed2a2c3bc8904e30f36fd92e",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:states-prohibition",
      "rkaf:assertsValue": {
        "@value": "A passenger may not transport or offer for transport any unauthorized explosive or incendiary in checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

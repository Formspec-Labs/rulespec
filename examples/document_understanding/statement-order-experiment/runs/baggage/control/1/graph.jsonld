      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:cb56a1d17abee0213f1a91829b322cf17a9797de4ca7aca77922240992a7b2e0",

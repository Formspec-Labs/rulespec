    {
      "@id": "urn:rulespec:document-understanding:revision:bf3f53299d6ab216574a30da4e1db19e5857e580e2e5fa921a8e372f6ccd6d9f",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:bf3f53299d6ab216574a30da4e1db19e5857e580e2e5fa921a8e372f6ccd6d9f",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:c2030ee3b81acacc8d23d1d42bd5d23d66031204de35b25e3e7b77fef2cd402f",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:65582db0102a22a1d6474d19d4647e09070e309e534834d4f2a60c89aa6fc183\",\"urn:rulespec:document-understanding:assertion:e5ce78c59375eeef8e170c7a0e459b700ed5f2b5f9cb6e60a089d03d45fc6e44\",\"urn:rulespec:document-understanding:assertion:1053b2a126f54bbac1005ddb4f0395b5e26612fb9d722437afb8b5c2ce9857c5\",\"urn:rulespec:document-understanding:assertion:d52332b384fc1fd787fd0ca59af5fc39db9da2712e7b988c612b98cc8ab5bbe8\",\"urn:rulespec:document-understanding:assertion:d4f074eb7e76ae570e2ee1ec617c6fc65608ffdebe1728145791e0508dcd1b90\",\"urn:rulespec:document-understanding:assertion:5bd71d422b8efa18330579e95ec1bc996703315ad7948033f387148e2252e473\"],\"choice_quote\":\"(2) Any unloaded firearm(s) unless—\\n\\n(i) The passenger declares to the aircraft operator, either orally or in writing, before checking the baggage, that the passenger has a firearm in his or her bag and that it is unloaded;\\n\\n(ii) The firearm is unloaded;\\n\\n(iii) The firearm is carried in a hard-sided container; and\\n\\n(iv) The container in which it is carried is locked, and only the passenger retains the key or combination.\",\"choice_text\":\"Transportation is prohibited unless all four conditions are satisfied: (i) the passenger declares to the aircraft operator, orally or in writing, before checking baggage, that the passenger has a firearm in the bag and it is unloaded; (ii) the firearm is unloaded; (iii) the firearm is carried in a hard-sided container; and (iv) the container is locked and only the passenger retains the key or combination.\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"effective_periods\":[],\"end\":2010,\"evidence\":[{\"end\":2010,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aab45ff8a7d213a548ba64b9bd9efdd9202dcd2f94cc0c1045a1b5fb69fe86460:1376:2010:sha256-a8c10a84329c5c4c00fbe156a5fef8f58d53dae82317da98532b0bc677ab1792\",\"quote\":\"(c) In checked baggage. A passenger may not transport or offer for transport in checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter:\\n\\n(1) Any loaded firearm(s).\\n\\n(2) Any unloaded firearm(s) unless—\\n\\n(i) The passenger declares to the aircraft operator, either orally or in writing, before checking the baggage, that the passenger has a firearm in his or her bag and that it is unloaded;\\n\\n(ii) The firearm is unloaded;\\n\\n(iii) The firearm is carried in a hard-sided container; and\\n\\n(iv) The container in which it is carried is locked, and only the passenger retains the key or combination.\",\"start\":1376},{\"end\":2010,\"field\":\"logic_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aab45ff8a7d213a548ba64b9bd9efdd9202dcd2f94cc0c1045a1b5fb69fe86460:1586:2010:sha256-55445821b85174dd35baccbe029635bc4b535d4c2fb27e8faef334a78e47a106\",\"quote\":\"(2) Any unloaded firearm(s) unless—\\n\\n(i) The passenger declares to the aircraft operator, either orally or in writing, before checking the baggage, that the passenger has a firearm in his or her bag and that it is unloaded;\\n\\n(ii) The firearm is unloaded;\\n\\n(iii) The firearm is carried in a hard-sided container; and\\n\\n(iv) The container in which it is carried is locked, and only the passenger retains the key or combination.\",\"start\":1586},{\"end\":1419,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aab45ff8a7d213a548ba64b9bd9efdd9202dcd2f94cc0c1045a1b5fb69fe86460:1412:1419:sha256-0007a8bea4dcd3f6b1490fc7199650f1046713dd92d9314e1f2ede6946fcd999\",\"quote\":\"may not\",\"start\":1412},{\"end\":2010,\"field\":\"choice_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aab45ff8a7d213a548ba64b9bd9efdd9202dcd2f94cc0c1045a1b5fb69fe86460:1586:2010:sha256-55445821b85174dd35baccbe029635bc4b535d4c2fb27e8faef334a78e47a106\",\"quote\":\"(2) Any unloaded firearm(s) unless—\\n\\n(i) The passenger declares to the aircraft operator, either orally or in writing, before checking the baggage, that the passenger has a firearm in his or her bag and that it is unloaded;\\n\\n(ii) The firearm is unloaded;\\n\\n(iii) The firearm is carried in a hard-sided container; and\\n\\n(iv) The container in which it is carried is locked, and only the passenger retains the key or combination.\",\"start\":1586},{\"end\":1556,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aab45ff8a7d213a548ba64b9bd9efdd9202dcd2f94cc0c1045a1b5fb69fe86460:1376:1556:sha256-9dd5c9d0feb251838bff5c1a16b3c099ef083ecc7b0fca10625f4c8d5699fdf1\",\"quote\":\"(c) In checked baggage. A passenger may not transport or offer for transport in checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter:\",\"start\":1376},{\"end\":1621,\"field\":\"scope_text:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aab45ff8a7d213a548ba64b9bd9efdd9202dcd2f94cc0c1045a1b5fb69fe86460:1586:1621:sha256-a03b234b39a7e3d902b46246302bd2c0d5986a277e51dcd12feeb18f5483f16c\",\"quote\":\"(2) Any unloaded firearm(s) unless—\",\"start\":1586}],\"id\":\"urn:rulespec:document-understanding:revision:bf3f53299d6ab216574a30da4e1db19e5857e580e2e5fa921a8e372f6ccd6d9f\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"prohibition\",\"logic_text\":\"(2) Any unloaded firearm(s) unless—\\n\\n(i) The passenger declares to the aircraft operator, either orally or in writing, before checking the baggage, that the passenger has a firearm in his or her bag and that it is unloaded;\\n\\n(ii) The firearm is unloaded;\\n\\n(iii) The firearm is carried in a hard-sided container; and\\n\\n(iv) The container in which it is carried is locked, and only the passenger retains the key or combination.\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:5bd71d422b8efa18330579e95ec1bc996703315ad7948033f387148e2252e473\",\"modality\":\"must_not\",\"modality_quote\":\"may not\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:407337dbc524aa7602596e32f655e6f62913fd37fb3d435f4d9a150cb47e2d23\",\"origin\":\"aiSuggested\",\"quote\":\"(c) In checked baggage. A passenger may not transport or offer for transport in checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter:\\n\\n(1) Any loaded firearm(s).\\n\\n(2) Any unloaded firearm(s) unless—\\n\\n(i) The passenger declares to the aircraft operator, either orally or in writing, before checking the baggage, that the passenger has a firearm in his or her bag and that it is unloaded;\\n\\n(ii) The firearm is unloaded;\\n\\n(iii) The firearm is carried in a hard-sided container; and\\n\\n(iv) The container in which it is carried is locked, and only the passenger retains the key or combination.\",\"references\":[\"§ 1562.23\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:2d4032a6bf2509b4c3be60d800590ec82976b2613a6ba997534d444810d3088b\",\"scope_quotes\":[\"(c) In checked baggage. A passenger may not transport or offer for transport in checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter:\",\"(2) Any unloaded firearm(s) unless—\"],\"scope_text\":\"In checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter, unless all specified conditions in (i) through (iv) are met.\",\"section_id\":\"section-1\",\"start\":1376,\"summary\":\"A passenger may not transport or offer for transport any unloaded firearm(s) in checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter unless the passenger declares to the aircraft operator (orally or in writing before checking baggage) that the bag contains an unloaded firearm, the firearm is unloaded, the firearm is carried in a hard-sided container, and the container is locked with only the passenger retaining the key or combination.\",\"target_ids\":[],\"typed_values\":[]}",

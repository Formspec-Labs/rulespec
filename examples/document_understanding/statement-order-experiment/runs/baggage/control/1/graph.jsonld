      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:cb56a1d17abee0213f1a91829b322cf17a9797de4ca7aca77922240992a7b2e0",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:68b0d0f6fbaeef320b74ec4d64e907f0a6bc07c4a8634e66bc810815fbbb694d",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:2d4032a6bf2509b4c3be60d800590ec82976b2613a6ba997534d444810d3088b",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"choice_text\":\"Transportation is prohibited unless all four conditions are satisfied: (i) the passenger declares to the aircraft operator, orally or in writing, before checking baggage, that the passenger has a firearm in the bag and it is unloaded; (ii) the firearm is unloaded; (iii) the firearm is carried in a hard-sided container; and (iv) the container is locked and only the passenger retains the key or combination.\",\"claimants\":[],\"concepts\":[],\"effective_periods\":[],\"jurisdiction\":\"\",\"kind\":\"prohibition\",\"logic_text\":\"(2) Any unloaded firearm(s) unless—\\n\\n(i) The passenger declares to the aircraft operator, either orally or in writing, before checking the baggage, that the passenger has a firearm in his or her bag and that it is unloaded;\\n\\n(ii) The firearm is unloaded;\\n\\n(iii) The firearm is carried in a hard-sided container; and\\n\\n(iv) The container in which it is carried is locked, and only the passenger retains the key or combination.\",\"modality\":\"must_not\",\"object\":\"\",\"scope_text\":\"In checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter, unless all specified conditions in (i) through (iv) are met.\",\"summary\":\"A passenger may not transport or offer for transport any unloaded firearm(s) in checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter unless the passenger declares to the aircraft operator (orally or in writing before checking baggage) that the bag contains an unloaded firearm, the firearm is unloaded, the firearm is carried in a hard-sided container, and the container is locked with only the passenger retaining the key or combination.\",\"typed_values\":[]}",
        "@type": "xsd:string"
      },

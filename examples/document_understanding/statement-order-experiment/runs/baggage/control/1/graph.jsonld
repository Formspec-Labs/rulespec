      "rkaf:assertsValue": {
        "@value": "Except as provided in paragraph (b) of this section, an individual may not have a weapon, explosive, or incendiary on or about the individual's person or accessible property when inspection has begun before entering a sterile area or boarding an aircraft screened under this subchapter, when entering or in a sterile area, or when attempting to board or onboard an aircraft screened under §§ 1544.201, 1546.201, or 1562.23 of this chapter.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"

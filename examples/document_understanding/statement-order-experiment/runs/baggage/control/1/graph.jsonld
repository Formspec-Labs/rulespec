    {
      "@id": "urn:rulespec:document-understanding:assertion:5884f6cfb454bd8278178ad375f28087c3286ea2ceb6e1e26a41672191eb78bb",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:cb56a1d17abee0213f1a91829b322cf17a9797de4ca7aca77922240992a7b2e0",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:68b0d0f6fbaeef320b74ec4d64e907f0a6bc07c4a8634e66bc810815fbbb694d",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:790fe76d9dfede40f0a69af75ab99d6664f7544ed4e4a8caf6857537fb9d9679",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[\"(1) When performance has begun of the inspection of the individual's person or accessible property before entering a sterile area, or before boarding an aircraft for which screening is conducted under this subchapter;\",\"(2) When the individual is entering or in a sterile area; or\",\"(3) When the individual is attempting to board or onboard an aircraft for which screening is conducted under §§ 1544.201, 1546.201, or 1562.23 of this chapter.\"],\"choice_text\":\"One or more of the following circumstances: (1) when performance has begun of the inspection before entering a sterile area or boarding a screened aircraft under this subchapter; (2) when entering or in a sterile area; or (3) when attempting to board or onboard an aircraft screened under §§ 1544.201, 1546.201, or 1562.23.\",\"claimants\":[],\"concepts\":[],\"effective_periods\":[],\"jurisdiction\":\"\",\"kind\":\"prohibition\",\"logic_text\":\"(a) On an individual's person or accessible property—prohibitions. Except as provided in paragraph (b) of this section, an individual may not have a weapon, explosive, or incendiary, on or about the individual's person or accessible property—\\n\\n(1) When performance has begun of the inspection of the individual's person or accessible property before entering a sterile area, or before boarding an aircraft for which screening is conducted under this subchapter;\\n\\n(2) When the individual is entering or in a sterile area; or\\n\\n(3) When the individual is attempting to board or onboard an aircraft for which screening is conducted under §§ 1544.201, 1546.201, or 1562.23 of this chapter.\",\"modality\":\"must_not\",\"object\":\"\",\"scope_text\":\"Except as provided in paragraph (b) of this section, on or about an individual's person or accessible property when: (1) performance has begun of the inspection of the individual's person or accessible property before entering a sterile area, or before boarding an aircraft for which screening is conducted under this subchapter; (2) entering or in a sterile area; or (3) attempting to board or onboard an aircraft for which screening is conducted under §§ 1544.201, 1546.201, or 1562.23.\",\"summary\":\"Except as provided in paragraph (b) of this section, an individual may not have a weapon, explosive, or incendiary on or about the individual's person or accessible property when inspection has begun before entering a sterile area or boarding an aircraft screened under this subchapter, when entering or in a sterile area, or when attempting to board or onboard an aircraft screened under §§ 1544.201, 1546.201, or 1562.23 of this chapter.\",\"typed_values\":[]}",
        "@type": "xsd:string"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed",
      "rkaf:hasApplicability": "urn:rulespec:document-understanding:scope:f8ae7a15040a04ab10847413c41c8f856e251b7362ff2caed03e6f826dc864b4"
    },

      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:states-prohibition",
      "rkaf:assertsValue": {
        "@value": "A passenger may not transport or offer for transport any unloaded firearm(s) in checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter unless the passenger declares to the aircraft operator (orally or in writing before checking baggage) that the bag contains an unloaded firearm, the firearm is unloaded, the firearm is carried in a hard-sided container, and the container is locked with only the passenger retaining the key or combination.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

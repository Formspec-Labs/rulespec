    {
      "@id": "urn:rulespec:document-understanding:assertion:6abfdfe87f18bc179d7031a9549983659b4c591c108bbcea6f78e0b876649ffa",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:cb56a1d17abee0213f1a91829b322cf17a9797de4ca7aca77922240992a7b2e0",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:68b0d0f6fbaeef320b74ec4d64e907f0a6bc07c4a8634e66bc810815fbbb694d",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:2cfd1c5b1c5657c1517651a62f95d5bc71a72d72ed2a2c3bc8904e30f36fd92e",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:logic_text",
      "rkaf:assertsValue": {
        "@value": "(c) In checked baggage. A passenger may not transport or offer for transport in checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter:\n\n(1) Any loaded firearm(s).\n\n(2) Any unloaded firearm(s) unless—\n\n(i) The passenger declares to the aircraft operator, either orally or in writing, before checking the baggage, that the passenger has a firearm in his or her bag and that it is unloaded;\n\n(ii) The firearm is unloaded;\n\n(iii) The firearm is carried in a hard-sided container; and\n\n(iv) The container in which it is carried is locked, and only the passenger retains the key or combination.\n\n(3) Any unauthorized explosive or incendiary.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },
    {
      "@id": "urn:rulespec:document-understanding:binding:04dc99845abd99dd9624e0bf32c9ff972985fe8c558f549d7fb132569f8cb439",

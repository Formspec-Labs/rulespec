      "rkaf:appliesInJurisdiction": [],
      "rkaf:applicabilityCondition": "In checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter, unless all specified conditions in (i) through (iv) are met."
    },
    {
      "@id": "urn:rulespec:document-understanding:assertion:65582db0102a22a1d6474d19d4647e09070e309e534834d4f2a60c89aa6fc183",
      "@type": "rkaf:ValueAssertion",

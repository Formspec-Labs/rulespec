      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:choice_text",
      "rkaf:assertsValue": {
        "@value": "An individual may not have a weapon, explosive, or incendiary on or about their person or accessible property in any of the following circumstances: (1) when performance has begun of the inspection of the person or accessible property before entering a sterile area or before boarding a screened aircraft; (2) when entering or in a sterile area; or (3) when attempting to board or onboard a screened aircraft under specified sections.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

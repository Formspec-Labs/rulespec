      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:states-prohibition",
      "rkaf:assertsValue": {
        "@value": "Except as provided in paragraph (b) of 49 CFR 1540.111, an individual may not have a weapon, explosive, or incendiary on or about the individual's person or accessible property when inspection has begun before entering a sterile area or boarding a screened aircraft, when entering or in a sterile area, or when attempting to board or onboard an aircraft screened under 49 CFR 1544.201, 1546.201, or 1562.23.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

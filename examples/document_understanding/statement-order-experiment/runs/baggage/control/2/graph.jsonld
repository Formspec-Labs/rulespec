    {
      "@id": "urn:rulespec:document-understanding:assertion:512e309a80e4257b79004a1126e74b08fd19f6022151634cad6d460f52585d21",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:d308a732b289b660c24566db94e760a01f81d7da27f965e38a10b8a4537fce00",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:05abe4b894049629b044e569fe648873a0ebf1c372e22751666166f84a6f3af1",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:53349cebd51336f82b11272eedf0edee4dc2fb0f667584cb6bd09b35654904d3",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[\"(1) When performance has begun of the inspection of the individual's person or accessible property before entering a sterile area, or before boarding an aircraft for which screening is conducted under this subchapter;\",\"(2) When the individual is entering or in a sterile area; or\",\"(3) When the individual is attempting to board or onboard an aircraft for which screening is conducted under §§ 1544.201, 1546.201, or 1562.23 of this chapter.\"],\"choice_text\":\"An individual may not have a weapon, explosive, or incendiary on or about their person or accessible property in any of the following circumstances: (1) when performance has begun of the inspection of the person or accessible property before entering a sterile area or before boarding a screened aircraft; (2) when entering or in a sterile area; or (3) when attempting to board or onboard a screened aircraft under specified sections.\",\"claimants\":[],\"concepts\":[],\"effective_periods\":[],\"jurisdiction\":\"\",\"kind\":\"prohibition\",\"logic_text\":\"(a) On an individual's person or accessible property—prohibitions. Except as provided in paragraph (b) of this section, an individual may not have a weapon, explosive, or incendiary, on or about the individual's person or accessible property—\\n\\n(1) When performance has begun of the inspection of the individual's person or accessible property before entering a sterile area, or before boarding an aircraft for which screening is conducted under this subchapter;\\n\\n(2) When the individual is entering or in a sterile area; or\\n\\n(3) When the individual is attempting to board or onboard an aircraft for which screening is conducted under §§ 1544.201, 1546.201, or 1562.23 of this chapter.\",\"modality\":\"must_not\",\"object\":\"\",\"scope_text\":\"Except as provided in paragraph (b) of 49 CFR 1540.111, when performance has begun of the inspection of the individual's person or accessible property before entering a sterile area or before boarding an aircraft for which screening is conducted under this subchapter, when the individual is entering or in a sterile area, or when the individual is attempting to board or onboard an aircraft for which screening is conducted under 14 CFR 1544.201, 1546.201, or 1562.23.\",\"summary\":\"Except as provided in paragraph (b) of 49 CFR 1540.111, an individual may not have a weapon, explosive, or incendiary on or about the individual's person or accessible property when inspection has begun before entering a sterile area or boarding a screened aircraft, when entering or in a sterile area, or when attempting to board or onboard an aircraft screened under 49 CFR 1544.201, 1546.201, or 1562.23.\",\"typed_values\":[]}",
        "@type": "xsd:string"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed",
      "rkaf:hasApplicability": "urn:rulespec:document-understanding:scope:2ecd0775c524eeae28da6534ae0733cef0217539db9b184f9782d90ef154548d"
    },

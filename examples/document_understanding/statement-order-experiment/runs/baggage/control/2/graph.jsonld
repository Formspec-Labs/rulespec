      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:d308a732b289b660c24566db94e760a01f81d7da27f965e38a10b8a4537fce00",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:05abe4b894049629b044e569fe648873a0ebf1c372e22751666166f84a6f3af1",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:9336e49385666ac9f19ce2c2fffafeded42957be10114edfd8ca4b39217a0ab3",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[\"(i) The passenger declares to the aircraft operator, either orally or in writing, before checking the baggage, that the passenger has a firearm in his or her bag and that it is unloaded;\",\"(ii) The firearm is unloaded;\",\"(iii) The firearm is carried in a hard-sided container; and\",\"(iv) The container in which it is carried is locked, and only the passenger retains the key or combination.\"],\"choice_text\":\"Transport or offering for transport is prohibited unless all four conditions are met: (i) the passenger declares the firearm orally or in writing before checking baggage; (ii) the firearm is unloaded; (iii) the firearm is carried in a hard-sided container; and (iv) the container is locked, and only the passenger retains the key or combination.\",\"claimants\":[],\"concepts\":[],\"effective_periods\":[],\"jurisdiction\":\"\",\"kind\":\"prohibition\",\"logic_text\":\"(2) Any unloaded firearm(s) unless—\\n\\n(i) The passenger declares to the aircraft operator, either orally or in writing, before checking the baggage, that the passenger has a firearm in his or her bag and that it is unloaded;\\n\\n(ii) The firearm is unloaded;\\n\\n(iii) The firearm is carried in a hard-sided container; and\\n\\n(iv) The container in which it is carried is locked, and only the passenger retains the key or combination.\",\"modality\":\"must_not\",\"object\":\"\",\"scope_text\":\"In checked baggage or in baggage carried in an inaccessible cargo hold under 49 CFR 1562.23.\",\"summary\":\"A passenger may not transport or offer for transport in checked baggage or baggage in an inaccessible cargo hold under 49 CFR 1562.23 any unloaded firearm(s) unless the passenger declares the unloaded firearm to the aircraft operator before checking the baggage, the firearm is unloaded, it is carried in a hard-sided container, and the container is locked with only the passenger retaining the key or combination.\",\"typed_values\":[]}",
        "@type": "xsd:string"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed",
      "rkaf:hasApplicability": "urn:rulespec:document-understanding:scope:168a7feee55db058a3a2f9cb662a9b928419c3efb232e78fc549e3a9888aacab"
    },

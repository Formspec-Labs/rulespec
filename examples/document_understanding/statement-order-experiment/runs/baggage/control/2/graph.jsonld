    {
      "@id": "urn:rulespec:document-understanding:scope:84358052a5f5fd191cdf9ca6f5e37642fe1d74ae182497a9b4bce990be2b9afc",
      "@type": "rkaf:ApplicabilityScope",
      "rkaf:appliesInJurisdiction": [],
      "rkaf:applicabilityCondition": "Applies to carriage of firearms and other weapons on an individual's person or accessible property if the individual is qualified under one of the listed categories."
    },
    {
      "@id": "urn:rulespec:document-understanding:assertion:3a18bf7e403e2197466d57084469d83c7af26914c3c8ba52d5e984b201e9b4ce",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:d308a732b289b660c24566db94e760a01f81d7da27f965e38a10b8a4537fce00",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:05abe4b894049629b044e569fe648873a0ebf1c372e22751666166f84a6f3af1",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:0a40041024ab3189f15343f5d0a6d3fbe74faa77023bb3879420dd826a71f2c7",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:states-exemption",
      "rkaf:assertsValue": {
        "@value": "Paragraph (a) prohibitions do not apply to carriage of firearms and other weapons on or about an individual's person or accessible property if the individual is law enforcement personnel required to carry a weapon in performance of airport duties, authorized to carry under 49 CFR 1544.219, 1544.221, 1544.223, 1546.211, or subpart B of part 1562, or authorized to carry in a sterile area under a security program.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

    {
      "@id": "urn:rulespec:document-understanding:assertion:0cb7a80908897d79d5fe42556db009fa2f01187edc343ca690db4613a1fd13ca",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:d308a732b289b660c24566db94e760a01f81d7da27f965e38a10b8a4537fce00",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:05abe4b894049629b044e569fe648873a0ebf1c372e22751666166f84a6f3af1",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:0a40041024ab3189f15343f5d0a6d3fbe74faa77023bb3879420dd826a71f2c7",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[\"(1) Law enforcement personnel required to carry a firearm or other weapons while in the performance of law enforcement duty at the airport.\",\"(2) An individual authorized to carry a weapon in accordance with §§ 1544.219, 1544.221, 1544.223, 1546.211, or subpart B of part 1562 of this chapter.\",\"(3) An individual authorized to carry a weapon in a sterile area under a security program.\"],\"choice_text\":\"Paragraph (a) prohibitions do not apply to carriage of firearms and other weapons if the individual is: (1) law enforcement personnel required to carry a firearm or other weapons while performing duty at the airport; (2) an individual authorized to carry a weapon in accordance with 49 CFR 1544.219, 1544.221, 1544.223, 1546.211, or subpart B of part 1562; or (3) an individual authorized to carry a weapon in a sterile area under a security program.\",\"claimants\":[],\"concepts\":[],\"effective_periods\":[],\"jurisdiction\":\"\",\"kind\":\"exemption\",\"logic_text\":\"(b) On an individual's person or accessible property—permitted carriage of a weapon. Paragraph (a) of this section does not apply as to carriage of firearms and other weapons if the individual is one of the following:\\n\\n(1) Law enforcement personnel required to carry a firearm or other weapons while in the performance of law enforcement duty at the airport.\\n\\n(2) An individual authorized to carry a weapon in accordance with §§ 1544.219, 1544.221, 1544.223, 1546.211, or subpart B of part 1562 of this chapter.\\n\\n(3) An individual authorized to carry a weapon in a sterile area under a security program.\",\"modality\":\"not_required\",\"object\":\"\",\"scope_text\":\"Applies to carriage of firearms and other weapons on an individual's person or accessible property if the individual is qualified under one of the listed categories.\",\"summary\":\"Paragraph (a) prohibitions do not apply to carriage of firearms and other weapons on or about an individual's person or accessible property if the individual is law enforcement personnel required to carry a weapon in performance of airport duties, authorized to carry under 49 CFR 1544.219, 1544.221, 1544.223, 1546.211, or subpart B of part 1562, or authorized to carry in a sterile area under a security program.\",\"typed_values\":[]}",
        "@type": "xsd:string"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed",
      "rkaf:hasApplicability": "urn:rulespec:document-understanding:scope:84358052a5f5fd191cdf9ca6f5e37642fe1d74ae182497a9b4bce990be2b9afc"
    },

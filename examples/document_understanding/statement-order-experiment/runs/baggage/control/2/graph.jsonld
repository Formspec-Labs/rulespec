    {
      "@id": "urn:rulespec:document-understanding:assertion:3fe73e587bcb64f1acd9a9f9a15ae864f32ccdc55c62953ebc96ce7da0480fca",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",

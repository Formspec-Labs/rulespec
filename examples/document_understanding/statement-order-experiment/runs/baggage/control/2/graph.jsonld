      "rkaf:assertsValue": {
        "@value": "Transport or offering for transport is prohibited unless all four conditions are met: (i) the passenger declares the firearm orally or in writing before checking baggage; (ii) the firearm is unloaded; (iii) the firearm is carried in a hard-sided container; and (iv) the container is locked, and only the passenger retains the key or combination.",
        "@language": "en"
      },

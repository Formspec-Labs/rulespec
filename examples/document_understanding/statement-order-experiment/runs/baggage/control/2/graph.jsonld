    {
      "@id": "urn:rulespec:document-understanding:binding:0f765423d91f2dfdc8a1c94e009e4f6de43876bae8b615dd750dba80a92eb1cf",
      "@type": "rkaf:EvidenceBinding",
      "rkaf:bindsAssertion": "urn:rulespec:document-understanding:assertion:2d4c3514744f40b1f8d54b0a1de86199eddb284eedbaac9aa0972f3f50304ea5",

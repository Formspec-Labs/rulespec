    {
      "@id": "urn:rulespec:document-understanding:assertion:5fa9fdb113191f776b6ff643eaaa0a129b39938945c608613acfb82c39072ac4",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:6c70f664ba3d7b8cd37a1fadccc240e43faae222ffd41cfc276c68b9a8254471",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:4fe0d6f03e82cf83dae86ac81a961b9abbff5e4578fcb2765e2949b880a85fca",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:a7a2461ece2f3b6f05d8e6695e0a7a4fd5a8c44b3bf1f36dd61aba048b182def",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:logic_text",
      "rkaf:assertsValue": {
        "@value": "(a) An eligible employee is an employee of a covered employer who:\n\n(1) Has been employed by the employer for at least 12 months, and\n\n(2) Has been employed for at least 1,250 hours of service during the 12-month period immediately preceding the commencement of the leave ( see § 825.801 for special hours of service requirements for airline flight crew employees), and\n\n(3) Is employed at a worksite where 50 or more employees are employed by the employer within 75 miles of that worksite. See § 825.105(b) regarding employees who work outside the U.S.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

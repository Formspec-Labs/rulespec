    {
      "@id": "urn:rulespec:document-understanding:revision:fdd09243ced6d0e4b49d150d6b92ed4250f3e640938f020ec5d90d223fd99316",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:fdd09243ced6d0e4b49d150d6b92ed4250f3e640938f020ec5d90d223fd99316",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",

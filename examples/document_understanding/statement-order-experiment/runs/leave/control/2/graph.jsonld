      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:94ee23368d201405b66cd8f7d1579ea7bec0adc50185cc949d23913beb33a94c\",\"urn:rulespec:document-understanding:assertion:dc908446d697a3040194dc0df516930b135de9d06dc35ad6d2016ba87b862009\",\"urn:rulespec:document-understanding:assertion:86c234a655fcbd762f19a8ca2ce78356e9bbd02be585f2e2a8e55d8bec785bdf\",\"urn:rulespec:document-understanding:assertion:fe1a6f9d1c52abddca0e1ec226cfa1bde93b1c631a0e59d17c3a26164fa22831\",\"urn:rulespec:document-understanding:assertion:5bfdfd7bc562261ed7ac311da179141dc78969a09f52deb7e1c1a50122c715cc\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"effective_periods\":[],\"end\":2804,\"evidence\":[{\"end\":2804,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A17e50019a4e77ab1a9c73c9fab8bd1b6da871d60b60c77790e8803a1d9920f62:2419:2804:sha256-668999c51c74d480383126ed520172cea18a50cba1239cdc7337af5ed0e7a425\",\"quote\":\"(4) Nothing in this section prevents employers from considering employment prior to a continuous break in service of more than seven years when determining whether an employee has met the 12-month employment requirement. However, if an employer chooses to recognize such prior employment, the employer must do so uniformly, with respect to all employees with similar breaks in service.\",\"start\":2419},{\"end\":2804,\"field\":\"logic_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A17e50019a4e77ab1a9c73c9fab8bd1b6da871d60b60c77790e8803a1d9920f62:2419:2804:sha256-668999c51c74d480383126ed520172cea18a50cba1239cdc7337af5ed0e7a425\",\"quote\":\"(4) Nothing in this section prevents employers from considering employment prior to a continuous break in service of more than seven years when determining whether an employee has met the 12-month employment requirement. However, if an employer chooses to recognize such prior employment, the employer must do so uniformly, with respect to all employees with similar breaks in service.\",\"start\":2419},{\"end\":2455,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A17e50019a4e77ab1a9c73c9fab8bd1b6da871d60b60c77790e8803a1d9920f62:2423:2455:sha256-3a9c2af8fdcb26e636d6793af0ce395348b087e952d55ab41fdda4b0dcea513f\",\"quote\":\"Nothing in this section prevents\",\"start\":2423}],\"id\":\"urn:rulespec:document-understanding:revision:f2a0c268ae1cf522aaff58742eed82cb9ab76209eebf60a774fa3fe1ab0940de\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"permission\",\"logic_text\":\"(4) Nothing in this section prevents employers from considering employment prior to a continuous break in service of more than seven years when determining whether an employee has met the 12-month employment requirement. However, if an employer chooses to recognize such prior employment, the employer must do so uniformly, with respect to all employees with similar breaks in service.\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:5bfdfd7bc562261ed7ac311da179141dc78969a09f52deb7e1c1a50122c715cc\",\"modality\":\"may\",\"modality_quote\":\"Nothing in this section prevents\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:e4ba5baadacd8620f5f2e47c209901be1299865a708d9ca316b84edc4fb8f75e\",\"origin\":\"aiSuggested\",\"quote\":\"(4) Nothing in this section prevents employers from considering employment prior to a continuous break in service of more than seven years when determining whether an employee has met the 12-month employment requirement. However, if an employer chooses to recognize such prior employment, the employer must do so uniformly, with respect to all employees with similar breaks in service.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:bbc65891fe08524339b785dced0b5f0fbaee0e5de3acc2954af987f4fc8ba488\",\"scope_quotes\":[],\"scope_text\":\"When determining whether an employee has met the 12-month employment requirement.\",\"section_id\":\"section-1\",\"start\":2419,\"summary\":\"Employers may consider employment prior to a continuous break in service of more than seven years when determining whether an employee has met the 12-month employment requirement, as nothing in this section prevents it.\",\"target_ids\":[],\"typed_values\":[]}",

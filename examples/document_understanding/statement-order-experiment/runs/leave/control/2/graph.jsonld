    {
      "@id": "urn:rulespec:document-understanding:revision:1ac9fa706034f2362f16d607606d3c4ff3ef1b24a657ed3dc2b23c969984cc9b",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:1ac9fa706034f2362f16d607606d3c4ff3ef1b24a657ed3dc2b23c969984cc9b",

      "rkaf:applicabilityCondition": "In determining whether the employee has been employed by the employer for at least 12 months when evaluating employment periods preceding a break in service of more than seven years."
    },
    {
      "@id": "urn:rulespec:document-understanding:assertion:6adc1d57dfc897ebd5a2d744ce6e402c4c92b4d151ea750d4bf815823c118fa0",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:6c70f664ba3d7b8cd37a1fadccc240e43faae222ffd41cfc276c68b9a8254471",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:4fe0d6f03e82cf83dae86ac81a961b9abbff5e4578fcb2765e2949b880a85fca",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:a882a2db0f24320952c0a43ef132f517c8298a70292c0d2ec8db7dd1d55760bf",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:states-requirement",
      "rkaf:assertsValue": {
        "@value": "Employment periods preceding a break in service of more than seven years must be counted in determining whether the employee has been employed by the employer for at least 12 months where: (i) the employee's break in service is occasioned by the fulfillment of his or her Uniformed Services Employment and Reemployment Rights Act (USERRA), 38 U.S.C. 4301, et seq., covered service obligation; or (ii) a written agreement, including a collective bargaining agreement, exists concerning the employer's intention to rehire the employee after the break in service (e.g., for purposes of the employee furthering his or her education or for childrearing purposes).",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

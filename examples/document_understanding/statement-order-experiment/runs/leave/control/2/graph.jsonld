      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[\"(1) Has been employed by the employer for at least 12 months, and\",\"(2) Has been employed for at least 1,250 hours of service during the 12-month period immediately preceding the commencement of the leave ( see § 825.801 for special hours of service requirements for airline flight crew employees), and\",\"(3) Is employed at a worksite where 50 or more employees are employed by the employer within 75 miles of that worksite. See § 825.105(b) regarding employees who work outside the U.S.\"],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:289fb96db4891d5d6066155f00bdcb9517dbada185be6c9f44cd0c16a92f9d50\",\"urn:rulespec:document-understanding:assertion:5fa9fdb113191f776b6ff643eaaa0a129b39938945c608613acfb82c39072ac4\",\"urn:rulespec:document-understanding:assertion:d15eb7989727d9ee787136c02152f98156f04456326f75d22b21078e7102d80c\",\"urn:rulespec:document-understanding:assertion:32aa3460d88d69a1d9d8bba41b592e38597e12d7a26095cbdfba94d0423629c7\",\"urn:rulespec:document-understanding:assertion:6daa76b0af77a8d52048342133285c6625579039dcd424af9d7e8f5028193ba0\",\"urn:rulespec:document-understanding:assertion:8f8805c5af7e0fd0b02178babc3476f966196076eb15b65c1ee4496c6a1d0184\",\"urn:rulespec:document-understanding:assertion:78485a95981f61eee30377e8e5a43cb735b0e063a1df0609af43f2076e0ad008\",\"urn:rulespec:document-understanding:assertion:bd3e4230bda782c372c193aa144bf4d388b5339a339b060f00f5c1667a8f38d7\"],\"choice_quote\":\"(a) An eligible employee is an employee of a covered employer who:\\n\\n(1) Has been employed by the employer for at least 12 months, and\\n\\n(2) Has been employed for at least 1,250 hours of service during the 12-month period immediately preceding the commencement of the leave ( see § 825.801 for special hours of service requirements for airline flight crew employees), and\\n\\n(3) Is employed at a worksite where 50 or more employees are employed by the employer within 75 miles of that worksite. See § 825.105(b) regarding employees who work outside the U.S.\",\"choice_text\":\"An employee must satisfy all three criteria: (1) employed by the employer for at least 12 months, AND (2) employed for at least 1,250 hours of service during the 12-month period immediately preceding the commencement of the leave, AND (3) employed at a worksite where 50 or more employees are employed by the employer within 75 miles of that worksite.\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"effective_periods\":[],\"end\":590,\"evidence\":[{\"end\":590,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A17e50019a4e77ab1a9c73c9fab8bd1b6da871d60b60c77790e8803a1d9920f62:37:590:sha256-e43d03081e43a5cd56466e06b1489af91ab5a4d901b3a2068f64e68e4fa8e5dd\",\"quote\":\"(a) An eligible employee is an employee of a covered employer who:\\n\\n(1) Has been employed by the employer for at least 12 months, and\\n\\n(2) Has been employed for at least 1,250 hours of service during the 12-month period immediately preceding the commencement of the leave ( see § 825.801 for special hours of service requirements for airline flight crew employees), and\\n\\n(3) Is employed at a worksite where 50 or more employees are employed by the employer within 75 miles of that worksite. See § 825.105(b) regarding employees who work outside the U.S.\",\"start\":37},{\"end\":590,\"field\":\"logic_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A17e50019a4e77ab1a9c73c9fab8bd1b6da871d60b60c77790e8803a1d9920f62:37:590:sha256-e43d03081e43a5cd56466e06b1489af91ab5a4d901b3a2068f64e68e4fa8e5dd\",\"quote\":\"(a) An eligible employee is an employee of a covered employer who:\\n\\n(1) Has been employed by the employer for at least 12 months, and\\n\\n(2) Has been employed for at least 1,250 hours of service during the 12-month period immediately preceding the commencement of the leave ( see § 825.801 for special hours of service requirements for airline flight crew employees), and\\n\\n(3) Is employed at a worksite where 50 or more employees are employed by the employer within 75 miles of that worksite. See § 825.105(b) regarding employees who work outside the U.S.\",\"start\":37},{\"end\":590,\"field\":\"choice_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A17e50019a4e77ab1a9c73c9fab8bd1b6da871d60b60c77790e8803a1d9920f62:37:590:sha256-e43d03081e43a5cd56466e06b1489af91ab5a4d901b3a2068f64e68e4fa8e5dd\",\"quote\":\"(a) An eligible employee is an employee of a covered employer who:\\n\\n(1) Has been employed by the employer for at least 12 months, and\\n\\n(2) Has been employed for at least 1,250 hours of service during the 12-month period immediately preceding the commencement of the leave ( see § 825.801 for special hours of service requirements for airline flight crew employees), and\\n\\n(3) Is employed at a worksite where 50 or more employees are employed by the employer within 75 miles of that worksite. See § 825.105(b) regarding employees who work outside the U.S.\",\"start\":37},{\"end\":170,\"field\":\"alternative:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A17e50019a4e77ab1a9c73c9fab8bd1b6da871d60b60c77790e8803a1d9920f62:105:170:sha256-65892c2f4a4b04b4af78de1dd2934ed6701e42ce507cd493e35ac4d9a1ba80b0\",\"quote\":\"(1) Has been employed by the employer for at least 12 months, and\",\"start\":105},{\"end\":406,\"field\":\"alternative:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A17e50019a4e77ab1a9c73c9fab8bd1b6da871d60b60c77790e8803a1d9920f62:172:406:sha256-f8c620c940dc57284f54426aad3bc219080834d541b71563d59c69ce9eeffe60\",\"quote\":\"(2) Has been employed for at least 1,250 hours of service during the 12-month period immediately preceding the commencement of the leave ( see § 825.801 for special hours of service requirements for airline flight crew employees), and\",\"start\":172},{\"end\":590,\"field\":\"alternative:2\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A17e50019a4e77ab1a9c73c9fab8bd1b6da871d60b60c77790e8803a1d9920f62:408:590:sha256-eb912ba3e3b8c4d1913a4740159f38d60c23793adb2467a188d1d44e8220b6ca\",\"quote\":\"(3) Is employed at a worksite where 50 or more employees are employed by the employer within 75 miles of that worksite. See § 825.105(b) regarding employees who work outside the U.S.\",\"start\":408}],\"id\":\"urn:rulespec:document-understanding:revision:1ac9fa706034f2362f16d607606d3c4ff3ef1b24a657ed3dc2b23c969984cc9b\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"definition\",\"logic_text\":\"(a) An eligible employee is an employee of a covered employer who:\\n\\n(1) Has been employed by the employer for at least 12 months, and\\n\\n(2) Has been employed for at least 1,250 hours of service during the 12-month period immediately preceding the commencement of the leave ( see § 825.801 for special hours of service requirements for airline flight crew employees), and\\n\\n(3) Is employed at a worksite where 50 or more employees are employed by the employer within 75 miles of that worksite. See § 825.105(b) regarding employees who work outside the U.S.\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:bd3e4230bda782c372c193aa144bf4d388b5339a339b060f00f5c1667a8f38d7\",\"modality\":\"not_stated\",\"modality_quote\":\"\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:b26d621728a0a70a72122d7770ab4377620e3dc421aa566e00df3133e730ecd9\",\"origin\":\"aiSuggested\",\"quote\":\"(a) An eligible employee is an employee of a covered employer who:\\n\\n(1) Has been employed by the employer for at least 12 months, and\\n\\n(2) Has been employed for at least 1,250 hours of service during the 12-month period immediately preceding the commencement of the leave ( see § 825.801 for special hours of service requirements for airline flight crew employees), and\\n\\n(3) Is employed at a worksite where 50 or more employees are employed by the employer within 75 miles of that worksite. See § 825.105(b) regarding employees who work outside the U.S.\",\"references\":[\"§ 825.801\",\"§ 825.105(b)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:a7a2461ece2f3b6f05d8e6695e0a7a4fd5a8c44b3bf1f36dd61aba048b182def\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":37,\"summary\":\"An eligible employee is an employee of a covered employer who: (1) has been employed by the employer for at least 12 months; (2) has been employed for at least 1,250 hours of service during the 12-month period immediately preceding the commencement of the leave (referencing § 825.801 for special hours of service requirements for airline flight crew employees); and (3) is employed at a worksite where 50 or more employees are employed by the employer within 75 miles of that worksite (referencing § 825.105(b) regarding employees who work outside the U.S.).\",\"target_ids\":[],\"typed_values\":[]}",

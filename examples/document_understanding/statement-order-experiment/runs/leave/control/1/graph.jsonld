    {
      "@id": "urn:rulespec:document-understanding:revision:39bfc33d876f13e919bb3b6953629a819a9e3f0f836aac4ce32ccfa6df5a4768",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:39bfc33d876f13e919bb3b6953629a819a9e3f0f836aac4ce32ccfa6df5a4768",

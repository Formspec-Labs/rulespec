    {
      "@id": "urn:rulespec:document-understanding:revision:6a7632dc1b10ed9fe07ad53bbd8e4c4ae92a5f784cb338a8f63d2eb34f10d0fa",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:6a7632dc1b10ed9fe07ad53bbd8e4c4ae92a5f784cb338a8f63d2eb34f10d0fa",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:e01928792b973bf898139556ccde675f7c3ce55921900c898d7306b695f60c9a",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:ecc4afba974dce7e36ef1c8e8d1eae97e5e79e71f7eec5a4a2cb6ae508ed026c\",\"urn:rulespec:document-understanding:assertion:ee933ba3028c6edaa0978526d94cd62cf5dce09835d229fb9224282d40dcb530\",\"urn:rulespec:document-understanding:assertion:9e3c047fee9967e6a8a26d956fb9314a62aac156ab91865e0eda192bb233de6e\",\"urn:rulespec:document-understanding:assertion:a4fa902f04ac93b70a41f4963ad1e3784877ecccabb8c88eec53e290806a0468\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"effective_periods\":[],\"end\":702,\"evidence\":[{\"end\":702,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A17e50019a4e77ab1a9c73c9fab8bd1b6da871d60b60c77790e8803a1d9920f62:592:702:sha256-130832d94200d58087ab6a46024a3a10483b1b99086401c1b273635c4e31aaf3\",\"quote\":\"(b) The 12 months an employee must have been employed by the employer need not be consecutive months, provided\",\"start\":592},{\"end\":670,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A17e50019a4e77ab1a9c73c9fab8bd1b6da871d60b60c77790e8803a1d9920f62:662:670:sha256-b00eebc92fbf41e3d233b28a918c7b90de96d6a15c0daebb94dde8af457529df\",\"quote\":\"need not\",\"start\":662},{\"end\":963,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A17e50019a4e77ab1a9c73c9fab8bd1b6da871d60b60c77790e8803a1d9920f62:704:963:sha256-438c5644572a847c74d79f58c54f20e47ea923230c819e21bf4f8083396eaabc\",\"quote\":\"(1) Subject to the exceptions provided in paragraph (b)(2) of this section, employment periods prior to a break in service of seven years or more need not be counted in determining whether the employee has been employed by the employer for at least 12 months.\",\"start\":704},{\"end\":1946,\"field\":\"scope_text:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A17e50019a4e77ab1a9c73c9fab8bd1b6da871d60b60c77790e8803a1d9920f62:965:1946:sha256-44393cd9a380898a3a1acc3ba34a55b09730edf38e8b44fe99ff1f8768321518\",\"quote\":\"(2) Employment periods preceding a break in service of more than seven years must be counted in determining whether the employee has been employed by the employer for at least 12 months where:\\n\\n(i) The employee's break in service is occasioned by the fulfillment of his or her Uniformed Services Employment and Reemployment Rights Act (USERRA), 38 U.S.C. 4301, et seq., covered service obligation. The period of absence from work due to or necessitated by USERRA-covered service must be also counted in determining whether the employee has been employed for at least 12 months by the employer. However, this section does not provide any greater entitlement to the employee than would be available under the USERRA; or\\n\\n(ii) A written agreement, including a collective bargaining agreement, exists concerning the employer's intention to rehire the employee after the break in service (e.g., for purposes of the employee furthering his or her education or for childrearing purposes).\",\"start\":965}],\"id\":\"urn:rulespec:document-understanding:revision:6a7632dc1b10ed9fe07ad53bbd8e4c4ae92a5f784cb338a8f63d2eb34f10d0fa\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"exemption\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:a4fa902f04ac93b70a41f4963ad1e3784877ecccabb8c88eec53e290806a0468\",\"modality\":\"not_required\",\"modality_quote\":\"need not\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:22bb29570c7b50349e1e7195a34402c518247531f4415820b4e4fc8cfb00a38b\",\"origin\":\"aiSuggested\",\"quote\":\"(b) The 12 months an employee must have been employed by the employer need not be consecutive months, provided\",\"references\":[\"paragraph (b)(1)\",\"paragraph (b)(2)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:0741579161eb743014ac8b18d7f4f1819a9c7835a3bf61f397e4806e56ff893e\",\"scope_quotes\":[\"(1) Subject to the exceptions provided in paragraph (b)(2) of this section, employment periods prior to a break in service of seven years or more need not be counted in determining whether the employee has been employed by the employer for at least 12 months.\",\"(2) Employment periods preceding a break in service of more than seven years must be counted in determining whether the employee has been employed by the employer for at least 12 months where:\\n\\n(i) The employee's break in service is occasioned by the fulfillment of his or her Uniformed Services Employment and Reemployment Rights Act (USERRA), 38 U.S.C. 4301, et seq., covered service obligation. The period of absence from work due to or necessitated by USERRA-covered service must be also counted in determining whether the employee has been employed for at least 12 months by the employer. However, this section does not provide any greater entitlement to the employee than would be available under the USERRA; or\\n\\n(ii) A written agreement, including a collective bargaining agreement, exists concerning the employer's intention to rehire the employee after the break in service (e.g., for purposes of the employee furthering his or her education or for childrearing purposes).\"],\"scope_text\":\"Determining whether an employee has been employed by the employer for at least 12 months, subject to the break-in-service rules and exceptions in paragraphs (b)(1) and (b)(2).\",\"section_id\":\"section-1\",\"start\":592,\"summary\":\"The 12 months an employee must have been employed by the employer are not required to be consecutive months, provided the applicable break-in-service rules and exceptions are observed.\",\"target_ids\":[],\"typed_values\":[]}",

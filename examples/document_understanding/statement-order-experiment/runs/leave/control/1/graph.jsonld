      "rkaf:assertsValue": {
        "@value": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"effective_periods\":[],\"jurisdiction\":\"\",\"kind\":\"exemption\",\"logic_text\":\"\",\"modality\":\"not_required\",\"object\":\"\",\"scope_text\":\"Determining whether an employee has been employed by the employer for at least 12 months, subject to the break-in-service rules and exceptions in paragraphs (b)(1) and (b)(2).\",\"summary\":\"The 12 months an employee must have been employed by the employer are not required to be consecutive months, provided the applicable break-in-service rules and exceptions are observed.\",\"typed_values\":[]}",

      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:c2d7ca4f50d15e3b6da21f9b26907788bb6cde01f7d4a3f18c72916f839d25ef\",\"urn:rulespec:document-understanding:assertion:19eb7da539239d551c020463850d309497e77336edb554faf23d602f698407de\",\"urn:rulespec:document-understanding:assertion:3c15bbfb5e20b78a46a8068a6e1440c0d36d9a8dec2ed3e9f6b92836c6160849\",\"urn:rulespec:document-understanding:assertion:6e7cc8341a100c7fbe15d4e9736568f26f0a5afa0614e54c9441732d54246d47\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"effective_periods\":[],\"end\":2804,\"evidence\":[{\"end\":2804,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A17e50019a4e77ab1a9c73c9fab8bd1b6da871d60b60c77790e8803a1d9920f62:2419:2804:sha256-668999c51c74d480383126ed520172cea18a50cba1239cdc7337af5ed0e7a425\",\"quote\":\"(4) Nothing in this section prevents employers from considering employment prior to a continuous break in service of more than seven years when determining whether an employee has met the 12-month employment requirement. However, if an employer chooses to recognize such prior employment, the employer must do so uniformly, with respect to all employees with similar breaks in service.\",\"start\":2419},{\"end\":2482,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A17e50019a4e77ab1a9c73c9fab8bd1b6da871d60b60c77790e8803a1d9920f62:2423:2482:sha256-712938ad6b7642fb779f539fde30684a0fe912532cf16979c8f3d91c084bee1d\",\"quote\":\"Nothing in this section prevents employers from considering\",\"start\":2423}],\"id\":\"urn:rulespec:document-understanding:revision:1ab29d0a07e6c66c0917048517bb0db4a258cb0df0c6eae9d42d93138cf0e95e\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"permission\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:6e7cc8341a100c7fbe15d4e9736568f26f0a5afa0614e54c9441732d54246d47\",\"modality\":\"may\",\"modality_quote\":\"Nothing in this section prevents employers from considering\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:448e91f40ffa760c4072b7149e8aff71e66e1ddeadb20b1c02044123fba30241\",\"origin\":\"aiSuggested\",\"quote\":\"(4) Nothing in this section prevents employers from considering employment prior to a continuous break in service of more than seven years when determining whether an employee has met the 12-month employment requirement. However, if an employer chooses to recognize such prior employment, the employer must do so uniformly, with respect to all employees with similar breaks in service.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:b2e50882514c202c1fbe31faafeecc488d8d86eaf0f66c5fd0de306bac11ce4d\",\"scope_quotes\":[],\"scope_text\":\"When determining whether an employee has met the 12-month employment requirement.\",\"section_id\":\"section-1\",\"start\":2419,\"summary\":\"Employers are permitted to consider employment prior to a continuous break in service of more than seven years when determining whether an employee has met the 12-month employment requirement.\",\"target_ids\":[],\"typed_values\":[]}",

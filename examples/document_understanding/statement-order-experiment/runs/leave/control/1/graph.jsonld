      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:45325a77c860b75872601929967e84ad7e7403ea9086245204a0922bbb2af85b\",\"urn:rulespec:document-understanding:assertion:c5d6794b765eaad9471ed0d04a2204bdd85b70ab8c2277c44944c33b2c422b70\",\"urn:rulespec:document-understanding:assertion:ba16d6dd6b52738885b1a9f37845566b045448f3ae5eba394aaa8158f3861b81\",\"urn:rulespec:document-understanding:assertion:aff59af2d238b5dd330725e2fe83fca56cf62c056f41247fdb610089adb91094\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"effective_periods\":[],\"end\":2804,\"evidence\":[{\"end\":2804,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A17e50019a4e77ab1a9c73c9fab8bd1b6da871d60b60c77790e8803a1d9920f62:2419:2804:sha256-668999c51c74d480383126ed520172cea18a50cba1239cdc7337af5ed0e7a425\",\"quote\":\"(4) Nothing in this section prevents employers from considering employment prior to a continuous break in service of more than seven years when determining whether an employee has met the 12-month employment requirement. However, if an employer chooses to recognize such prior employment, the employer must do so uniformly, with respect to all employees with similar breaks in service.\",\"start\":2419},{\"end\":2725,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A17e50019a4e77ab1a9c73c9fab8bd1b6da871d60b60c77790e8803a1d9920f62:2721:2725:sha256-4137b01e139589b7a1d3b3fc4da031d8ce5bb415808734e970c3a58ea0e98f0f\",\"quote\":\"must\",\"start\":2721}],\"id\":\"urn:rulespec:document-understanding:revision:b201bbe6f2af83b97bf1b61de6c817a670d0c93a2cca4958f6fec0180bd60d71\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:aff59af2d238b5dd330725e2fe83fca56cf62c056f41247fdb610089adb91094\",\"modality\":\"must\",\"modality_quote\":\"must\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:c767fe00b4a842183bae9f9fdb5e3d74cd99b33418b711d69d003f5f00f243b4\",\"origin\":\"aiSuggested\",\"quote\":\"(4) Nothing in this section prevents employers from considering employment prior to a continuous break in service of more than seven years when determining whether an employee has met the 12-month employment requirement. However, if an employer chooses to recognize such prior employment, the employer must do so uniformly, with respect to all employees with similar breaks in service.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:7eb988248a75668053946f7aa53dd7dcc3f88ee98e9674a0f2c7f712857d8812\",\"scope_quotes\":[],\"scope_text\":\"If an employer chooses to recognize employment prior to a continuous break in service of more than seven years.\",\"section_id\":\"section-1\",\"start\":2419,\"summary\":\"If an employer chooses to recognize prior employment before a continuous break in service of more than seven years, the employer must do so uniformly with respect to all employees with similar breaks in service.\",\"target_ids\":[],\"typed_values\":[]}",

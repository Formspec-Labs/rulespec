    {
      "@id": "urn:rulespec:document-understanding:scope:a24501511c53ff26b821c8c3d68c56a23034cc88d5cc2a6274509bd37c3a705c",
      "@type": "rkaf:ApplicabilityScope",
      "rkaf:appliesInJurisdiction": [],
      "rkaf:applicabilityCondition": "When determining whether an employee has been employed by the employer for at least 12 months, where employment periods precede a break in service of more than seven years and a written agreement exists concerning the employer's intention to rehire the employee after the break in service."
    },
    {
      "@id": "urn:rulespec:document-understanding:assertion:5b472d409293a3147ed1fe75e1e45e951f42a488ff34eefdae1c24e571f01688",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:38f734009f1bd06bdb06a72c8eb82cfe984b3bb3a07056344b39239fd569ff99",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:ba3a4a135011eaacd02b1860bc29ce870836b71ef12adee05cd4c7e55b9cb39e",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:8ac51dd7393e1c2d07311478986591d1937dc3e09212e097db0edeb9c042e994",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:states-requirement",
      "rkaf:assertsValue": {
        "@value": "Employment periods preceding a break in service of more than seven years must be counted in determining whether the employee has been employed by the employer for at least 12 months where a written agreement, including a collective bargaining agreement, exists concerning the employer's intention to rehire the employee after the break in service (e.g., for furthering education or childrearing purposes).",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

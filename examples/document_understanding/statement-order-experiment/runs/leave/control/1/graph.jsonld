      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:c1585e0651e8c074dc51659777d045dcb9d7069983a15e44dd0ea1466c6eacdf\",\"urn:rulespec:document-understanding:assertion:93e437054a59ddf4f3e402ac0f140cc05483096f02f49089886970bd3e4917ff\",\"urn:rulespec:document-understanding:assertion:9525d7eb596a009e9757f450a1d1a48c3a0d36029116e07ec288bc1e9e4d7eff\",\"urn:rulespec:document-understanding:assertion:d77f94c9c76060dc9241177fc7d1625babd5eff5c4183d228511f96a235f0d3f\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"effective_periods\":[],\"end\":1682,\"evidence\":[{\"end\":1682,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A17e50019a4e77ab1a9c73c9fab8bd1b6da871d60b60c77790e8803a1d9920f62:1159:1682:sha256-3583bfa13c136e40a1005ff1210b6c0bcc560609a0916bb52fde5527907c0b6a\",\"quote\":\"(i) The employee's break in service is occasioned by the fulfillment of his or her Uniformed Services Employment and Reemployment Rights Act (USERRA), 38 U.S.C. 4301, et seq., covered service obligation. The period of absence from work due to or necessitated by USERRA-covered service must be also counted in determining whether the employee has been employed for at least 12 months by the employer. However, this section does not provide any greater entitlement to the employee than would be available under the USERRA; or\",\"start\":1159},{\"end\":1448,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A17e50019a4e77ab1a9c73c9fab8bd1b6da871d60b60c77790e8803a1d9920f62:1444:1448:sha256-4137b01e139589b7a1d3b3fc4da031d8ce5bb415808734e970c3a58ea0e98f0f\",\"quote\":\"must\",\"start\":1444},{\"end\":1157,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A17e50019a4e77ab1a9c73c9fab8bd1b6da871d60b60c77790e8803a1d9920f62:965:1157:sha256-81c4f484796168f909a9f64f9112a6ace05f639aa7e0991efd5642b3d60a67f6\",\"quote\":\"(2) Employment periods preceding a break in service of more than seven years must be counted in determining whether the employee has been employed by the employer for at least 12 months where:\",\"start\":965}],\"id\":\"urn:rulespec:document-understanding:revision:5d4fc33afa12d370a0363c1044aa28279b830539328c289f39df46bb3264192f\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:d77f94c9c76060dc9241177fc7d1625babd5eff5c4183d228511f96a235f0d3f\",\"modality\":\"must\",\"modality_quote\":\"must\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:e32fc5a8c9c620e3e55c69c329bc2f65ee94a85d2068b2cf35a1aca653524ca3\",\"origin\":\"aiSuggested\",\"quote\":\"(i) The employee's break in service is occasioned by the fulfillment of his or her Uniformed Services Employment and Reemployment Rights Act (USERRA), 38 U.S.C. 4301, et seq., covered service obligation. The period of absence from work due to or necessitated by USERRA-covered service must be also counted in determining whether the employee has been employed for at least 12 months by the employer. However, this section does not provide any greater entitlement to the employee than would be available under the USERRA; or\",\"references\":[\"USERRA\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:9554ff90c177e4bc4470888b950b5cc30790929dfdc1d0b118509a8c615cb7df\",\"scope_quotes\":[\"(2) Employment periods preceding a break in service of more than seven years must be counted in determining whether the employee has been employed by the employer for at least 12 months where:\"],\"scope_text\":\"When determining whether an employee has been employed for at least 12 months by the employer, where an employee has an absence from work due to or necessitated by USERRA-covered service.\",\"section_id\":\"section-1\",\"start\":1159,\"summary\":\"The period of absence from work due to or necessitated by USERRA-covered service must also be counted in determining whether the employee has been employed for at least 12 months by the employer.\",\"target_ids\":[],\"typed_values\":[]}",

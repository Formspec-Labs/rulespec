      "rkaf:assertsValue": {
        "@value": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"effective_periods\":[],\"jurisdiction\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"modality\":\"must\",\"object\":\"\",\"scope_text\":\"When determining whether an employee has been employed for at least 12 months by the employer, where an employee has an absence from work due to or necessitated by USERRA-covered service.\",\"summary\":\"The period of absence from work due to or necessitated by USERRA-covered service must also be counted in determining whether the employee has been employed for at least 12 months by the employer.\",\"typed_values\":[]}",

      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:38f734009f1bd06bdb06a72c8eb82cfe984b3bb3a07056344b39239fd569ff99",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:ba3a4a135011eaacd02b1860bc29ce870836b71ef12adee05cd4c7e55b9cb39e",

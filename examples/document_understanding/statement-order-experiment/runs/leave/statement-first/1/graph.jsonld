      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:fa61127ec6d2008b0f0bc9d87d9e6854642510ee39e03603876732ab066df1b5",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:6a6e3b3b63199566a9a71a8d002ee02ca495e8eddc680ffb009179e7eb2a22ca",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:149a092cfd490896808bdd3130ed60727d6672efdb9a531e918a9a2b2d9d05f8",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:states-requirement",
      "rkaf:assertsValue": {
        "@value": "Employment periods preceding a break in service of more than seven years must be counted in determining whether the employee has been employed by the employer for at least 12 months where either: (i) the employee's break in service is occasioned by the fulfillment of his or her Uniformed Services Employment and Reemployment Rights Act (USERRA), 38 U.S.C. 4301, et seq., covered service obligation; or (ii) a written agreement, including a collective bargaining agreement, exists concerning the employer's intention to rehire the employee after the break in service (e.g., for purposes of the employee furthering his or her education or for childrearing purposes).",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },
    {
      "@id": "urn:rulespec:document-understanding:binding:5ba44c8c9c2f80a07b495ab8531db20f76ae7d859d588e5c8f3519a55440c537",

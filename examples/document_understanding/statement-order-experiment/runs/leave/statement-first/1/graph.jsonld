    {
      "@id": "urn:rulespec:document-understanding:revision:28bd1f1306a4a5c4cdd4f933d3d63e40a45e37f4e04a7bf5260d55f63ecfb05f",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:28bd1f1306a4a5c4cdd4f933d3d63e40a45e37f4e04a7bf5260d55f63ecfb05f",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",

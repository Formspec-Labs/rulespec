    {
      "@id": "urn:rulespec:document-understanding:revision:90938d1702485b854783a44eec353d46b74ec2275c0d89ab91cbcbafe4aabc8d",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:90938d1702485b854783a44eec353d46b74ec2275c0d89ab91cbcbafe4aabc8d",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:199f3135f769951ab075b71a5704f84544022042c42082b0fd57f9c6e00f959b",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:5a262b5b7c0520230b26de0ec32d0cc48f9fee6ed41b6b5f2e3eabf24a5c0f7c\",\"urn:rulespec:document-understanding:assertion:61c283adf98a1c6f7c08a9d5ded7b62b45552798bea1961fd8409d3a73f1a333\",\"urn:rulespec:document-understanding:assertion:694590d66cee9124565e7a9247e91e9f927aace04e101ce4b637617adf0b97bf\",\"urn:rulespec:document-understanding:assertion:dbd21c28248c05e486b0be97d17fceb5c408433b7a3fa8308d421963bb9592bf\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"effective_periods\":[],\"end\":1682,\"evidence\":[{\"end\":1682,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A17e50019a4e77ab1a9c73c9fab8bd1b6da871d60b60c77790e8803a1d9920f62:1159:1682:sha256-3583bfa13c136e40a1005ff1210b6c0bcc560609a0916bb52fde5527907c0b6a\",\"quote\":\"(i) The employee's break in service is occasioned by the fulfillment of his or her Uniformed Services Employment and Reemployment Rights Act (USERRA), 38 U.S.C. 4301, et seq., covered service obligation. The period of absence from work due to or necessitated by USERRA-covered service must be also counted in determining whether the employee has been employed for at least 12 months by the employer. However, this section does not provide any greater entitlement to the employee than would be available under the USERRA; or\",\"start\":1159},{\"end\":1682,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A17e50019a4e77ab1a9c73c9fab8bd1b6da871d60b60c77790e8803a1d9920f62:1159:1682:sha256-3583bfa13c136e40a1005ff1210b6c0bcc560609a0916bb52fde5527907c0b6a\",\"quote\":\"(i) The employee's break in service is occasioned by the fulfillment of his or her Uniformed Services Employment and Reemployment Rights Act (USERRA), 38 U.S.C. 4301, et seq., covered service obligation. The period of absence from work due to or necessitated by USERRA-covered service must be also counted in determining whether the employee has been employed for at least 12 months by the employer. However, this section does not provide any greater entitlement to the employee than would be available under the USERRA; or\",\"start\":1159}],\"id\":\"urn:rulespec:document-understanding:revision:90938d1702485b854783a44eec353d46b74ec2275c0d89ab91cbcbafe4aabc8d\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"statement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:dbd21c28248c05e486b0be97d17fceb5c408433b7a3fa8308d421963bb9592bf\",\"modality\":\"not_stated\",\"modality_quote\":\"\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:3abe7b7966af61ca8225a6fbab144dc968a248ec1b8c9289d0ee5ccb79ef0af9\",\"origin\":\"aiSuggested\",\"quote\":\"(i) The employee's break in service is occasioned by the fulfillment of his or her Uniformed Services Employment and Reemployment Rights Act (USERRA), 38 U.S.C. 4301, et seq., covered service obligation. The period of absence from work due to or necessitated by USERRA-covered service must be also counted in determining whether the employee has been employed for at least 12 months by the employer. However, this section does not provide any greater entitlement to the employee than would be available under the USERRA; or\",\"references\":[\"USERRA\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:5eff9b93833eeea1493b408f8fc3fe00fbbfc954972db119bfe6feab85936ceb\",\"scope_quotes\":[\"(i) The employee's break in service is occasioned by the fulfillment of his or her Uniformed Services Employment and Reemployment Rights Act (USERRA), 38 U.S.C. 4301, et seq., covered service obligation. The period of absence from work due to or necessitated by USERRA-covered service must be also counted in determining whether the employee has been employed for at least 12 months by the employer. However, this section does not provide any greater entitlement to the employee than would be available under the USERRA; or\"],\"scope_text\":\"Regarding entitlements under section 825.110 in connection with USERRA-covered service.\",\"section_id\":\"section-1\",\"start\":1159,\"summary\":\"Section 825.110 does not provide any greater entitlement to the employee than would be available under the USERRA.\",\"target_ids\":[],\"typed_values\":[]}",

      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:40d30486f3a52d7b28af0b82a80b59adfa546a69940df410dc685697955c6e3d\",\"urn:rulespec:document-understanding:assertion:6314c2a5b5e066b29ad820bf40f927449d6702e22fd7473d95f83986a6d4fbf4\",\"urn:rulespec:document-understanding:assertion:4c9561722ff71dbbd36c4dd9fb570d980556dfad1ab89376e5e7398d9958e5e6\",\"urn:rulespec:document-understanding:assertion:fb8d8165dce46c0eca5226700dbb9a9673bfa3209248b7c649aff2f2d613a6d4\",\"urn:rulespec:document-understanding:assertion:2aa78ebc9efa46d4275a04ee1239a5abd179ae01016e06c4ca9d0fb93f68facf\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"effective_periods\":[],\"end\":2417,\"evidence\":[{\"end\":2417,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A17e50019a4e77ab1a9c73c9fab8bd1b6da871d60b60c77790e8803a1d9920f62:1948:2417:sha256-4048733db741ffbcee82288a3f298f4f891c683f3d1c1b543892af4f7ddc5dba\",\"quote\":\"(3) If an employee is maintained on the payroll for any part of a week, including any periods of paid or unpaid leave (sick, vacation) during which other benefits or compensation are provided by the employer (e.g., workers' compensation, group health plan benefits, etc.), the week counts as a week of employment. For purposes of determining whether intermittent/occasional/casual employment qualifies as at least 12 months, 52 weeks is deemed to be equal to 12 months.\",\"start\":1948},{\"end\":2417,\"field\":\"logic_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A17e50019a4e77ab1a9c73c9fab8bd1b6da871d60b60c77790e8803a1d9920f62:1948:2417:sha256-4048733db741ffbcee82288a3f298f4f891c683f3d1c1b543892af4f7ddc5dba\",\"quote\":\"(3) If an employee is maintained on the payroll for any part of a week, including any periods of paid or unpaid leave (sick, vacation) during which other benefits or compensation are provided by the employer (e.g., workers' compensation, group health plan benefits, etc.), the week counts as a week of employment. For purposes of determining whether intermittent/occasional/casual employment qualifies as at least 12 months, 52 weeks is deemed to be equal to 12 months.\",\"start\":1948},{\"end\":2417,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A17e50019a4e77ab1a9c73c9fab8bd1b6da871d60b60c77790e8803a1d9920f62:1948:2417:sha256-4048733db741ffbcee82288a3f298f4f891c683f3d1c1b543892af4f7ddc5dba\",\"quote\":\"(3) If an employee is maintained on the payroll for any part of a week, including any periods of paid or unpaid leave (sick, vacation) during which other benefits or compensation are provided by the employer (e.g., workers' compensation, group health plan benefits, etc.), the week counts as a week of employment. For purposes of determining whether intermittent/occasional/casual employment qualifies as at least 12 months, 52 weeks is deemed to be equal to 12 months.\",\"start\":1948}],\"id\":\"urn:rulespec:document-understanding:revision:424fed91a13bdd0025775105f1d4d6bce62d5c728f81ad3aae48c0c2b8700cc9\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"statement\",\"logic_text\":\"(3) If an employee is maintained on the payroll for any part of a week, including any periods of paid or unpaid leave (sick, vacation) during which other benefits or compensation are provided by the employer (e.g., workers' compensation, group health plan benefits, etc.), the week counts as a week of employment. For purposes of determining whether intermittent/occasional/casual employment qualifies as at least 12 months, 52 weeks is deemed to be equal to 12 months.\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:2aa78ebc9efa46d4275a04ee1239a5abd179ae01016e06c4ca9d0fb93f68facf\",\"modality\":\"not_stated\",\"modality_quote\":\"\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:1eb8a77597c2564655036a5d3d86404f5da9642b77863604b41264bece0342e2\",\"origin\":\"aiSuggested\",\"quote\":\"(3) If an employee is maintained on the payroll for any part of a week, including any periods of paid or unpaid leave (sick, vacation) during which other benefits or compensation are provided by the employer (e.g., workers' compensation, group health plan benefits, etc.), the week counts as a week of employment. For purposes of determining whether intermittent/occasional/casual employment qualifies as at least 12 months, 52 weeks is deemed to be equal to 12 months.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:cb7515454e76c5b41fbabaf97498ea9f8607529a07efeb389504748e7ba7e08b\",\"scope_quotes\":[\"(3) If an employee is maintained on the payroll for any part of a week, including any periods of paid or unpaid leave (sick, vacation) during which other benefits or compensation are provided by the employer (e.g., workers' compensation, group health plan benefits, etc.), the week counts as a week of employment. For purposes of determining whether intermittent/occasional/casual employment qualifies as at least 12 months, 52 weeks is deemed to be equal to 12 months.\"],\"scope_text\":\"If an employee is maintained on the payroll for any part of a week, including any periods of paid or unpaid leave (sick, vacation) during which other benefits or compensation are provided by the employer (e.g., workers' compensation, group health plan benefits, etc.).\",\"section_id\":\"section-1\",\"start\":1948,\"summary\":\"If an employee is maintained on the payroll for any part of a week, including any periods of paid or unpaid leave (sick, vacation) during which other benefits or compensation are provided by the employer (e.g., workers' compensation, group health plan benefits, etc.), the week counts as a week of employment.\",\"target_ids\":[],\"typed_values\":[]}",

    {
      "@id": "urn:rulespec:document-understanding:assertion:a5e6874859cfc30b775ddd6a5b68832342118cfd98398281edd19c5223ac1511",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:fa61127ec6d2008b0f0bc9d87d9e6854642510ee39e03603876732ab066df1b5",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:6a6e3b3b63199566a9a71a8d002ee02ca495e8eddc680ffb009179e7eb2a22ca",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:149a092cfd490896808bdd3130ed60727d6672efdb9a531e918a9a2b2d9d05f8",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:logic_text",
      "rkaf:assertsValue": {
        "@value": "(i) The employee's break in service is occasioned by the fulfillment of his or her Uniformed Services Employment and Reemployment Rights Act (USERRA), 38 U.S.C. 4301, et seq., covered service obligation. The period of absence from work due to or necessitated by USERRA-covered service must be also counted in determining whether the employee has been employed for at least 12 months by the employer. However, this section does not provide any greater entitlement to the employee than would be available under the USERRA; or\n\n(ii) A written agreement, including a collective bargaining agreement, exists concerning the employer's intention to rehire the employee after the break in service (e.g., for purposes of the employee furthering his or her education or for childrearing purposes).",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

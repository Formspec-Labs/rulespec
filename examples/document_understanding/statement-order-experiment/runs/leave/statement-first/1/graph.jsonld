      "@id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A17e50019a4e77ab1a9c73c9fab8bd1b6da871d60b60c77790e8803a1d9920f62:1948:2417:sha256-4048733db741ffbcee82288a3f298f4f891c683f3d1c1b543892af4f7ddc5dba",
      "@type": "rkaf:SourceFragment",
      "oa:hasSource": "urn:rulespec:document-understanding:document:17e50019a4e77ab1a9c73c9fab8bd1b6da871d60b60c77790e8803a1d9920f62",
      "rkaf:fragmentIdentityScheme": "rkaf:carrier-local-fragment",
      "rkaf:sourceArtifactDigest": "sha256:17e50019a4e77ab1a9c73c9fab8bd1b6da871d60b60c77790e8803a1d9920f62",
      "rkaf:fragmentContentDigest": "sha256:4048733db741ffbcee82288a3f298f4f891c683f3d1c1b543892af4f7ddc5dba",
      "rkaf:selectorKind": [
        "oa:TextQuoteSelector",
        "oa:TextPositionSelector"
      ],
      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "(3) If an employee is maintained on the payroll for any part of a week, including any periods of paid or unpaid leave (sick, vacation) during which other benefits or compensation are provided by the employer (e.g., workers' compensation, group health plan benefits, etc.), the week counts as a week of employment. For purposes of determining whether intermittent/occasional/casual employment qualifies as at least 12 months, 52 weeks is deemed to be equal to 12 months."
        },
        {
          "@type": "oa:TextPositionSelector",
          "oa:start": 1948,
          "oa:end": 2417,
          "rkaf:coordinateSystem": "rkaf:unicode-codepoint"
        }
      ]
    },

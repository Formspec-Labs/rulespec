      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:6d6ade0c8f4722723d05160da71f8818198c7a5a0e8713b931f2d19dcaefd507\",\"urn:rulespec:document-understanding:assertion:ec2d8011b4cfbd1f0e44fdb3ea6a07e5c5f2a3f5aff0fe58ab308b31045f69a3\",\"urn:rulespec:document-understanding:assertion:7a38185f5fc65a27b20eaf95558f8df92723c1e10826f77fc270dad6f27983b4\",\"urn:rulespec:document-understanding:assertion:c00610686103947695706d87af1ee056c0321416fe818f717fb53f741fdf5559\",\"urn:rulespec:document-understanding:assertion:4dd416c5d8a0cd8b2dafb9c1860baaad4347b4b45893545dfc475ee57a589eb8\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[\"(2) Has been employed for at least 1,250 hours of service during the 12-month period immediately preceding the commencement of the leave ( see § 825.801 for special hours of service requirements for airline flight crew employees), and\",\"(3) Is employed at a worksite where 50 or more employees are employed by the employer within 75 miles of that worksite. See § 825.105(b) regarding employees who work outside the U.S.\"],\"effective_periods\":[],\"end\":590,\"evidence\":[{\"end\":590,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A17e50019a4e77ab1a9c73c9fab8bd1b6da871d60b60c77790e8803a1d9920f62:37:590:sha256-e43d03081e43a5cd56466e06b1489af91ab5a4d901b3a2068f64e68e4fa8e5dd\",\"quote\":\"(a) An eligible employee is an employee of a covered employer who:\\n\\n(1) Has been employed by the employer for at least 12 months, and\\n\\n(2) Has been employed for at least 1,250 hours of service during the 12-month period immediately preceding the commencement of the leave ( see § 825.801 for special hours of service requirements for airline flight crew employees), and\\n\\n(3) Is employed at a worksite where 50 or more employees are employed by the employer within 75 miles of that worksite. See § 825.105(b) regarding employees who work outside the U.S.\",\"start\":37},{\"end\":590,\"field\":\"logic_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A17e50019a4e77ab1a9c73c9fab8bd1b6da871d60b60c77790e8803a1d9920f62:37:590:sha256-e43d03081e43a5cd56466e06b1489af91ab5a4d901b3a2068f64e68e4fa8e5dd\",\"quote\":\"(a) An eligible employee is an employee of a covered employer who:\\n\\n(1) Has been employed by the employer for at least 12 months, and\\n\\n(2) Has been employed for at least 1,250 hours of service during the 12-month period immediately preceding the commencement of the leave ( see § 825.801 for special hours of service requirements for airline flight crew employees), and\\n\\n(3) Is employed at a worksite where 50 or more employees are employed by the employer within 75 miles of that worksite. See § 825.105(b) regarding employees who work outside the U.S.\",\"start\":37},{\"end\":103,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A17e50019a4e77ab1a9c73c9fab8bd1b6da871d60b60c77790e8803a1d9920f62:37:103:sha256-f65766fc8c1d9018ff7f6a685d59a802898d9b888c3de0a8c3c4756b5c8959a4\",\"quote\":\"(a) An eligible employee is an employee of a covered employer who:\",\"start\":37},{\"end\":406,\"field\":\"context:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A17e50019a4e77ab1a9c73c9fab8bd1b6da871d60b60c77790e8803a1d9920f62:172:406:sha256-f8c620c940dc57284f54426aad3bc219080834d541b71563d59c69ce9eeffe60\",\"quote\":\"(2) Has been employed for at least 1,250 hours of service during the 12-month period immediately preceding the commencement of the leave ( see § 825.801 for special hours of service requirements for airline flight crew employees), and\",\"start\":172},{\"end\":590,\"field\":\"context:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A17e50019a4e77ab1a9c73c9fab8bd1b6da871d60b60c77790e8803a1d9920f62:408:590:sha256-eb912ba3e3b8c4d1913a4740159f38d60c23793adb2467a188d1d44e8220b6ca\",\"quote\":\"(3) Is employed at a worksite where 50 or more employees are employed by the employer within 75 miles of that worksite. See § 825.105(b) regarding employees who work outside the U.S.\",\"start\":408}],\"id\":\"urn:rulespec:document-understanding:revision:ef6fb4d1ba9ce7980d99e2bbc1f5eff11d4dd51a9ed1209a141da635b833d13a\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"definition\",\"logic_text\":\"(a) An eligible employee is an employee of a covered employer who:\\n\\n(1) Has been employed by the employer for at least 12 months, and\\n\\n(2) Has been employed for at least 1,250 hours of service during the 12-month period immediately preceding the commencement of the leave ( see § 825.801 for special hours of service requirements for airline flight crew employees), and\\n\\n(3) Is employed at a worksite where 50 or more employees are employed by the employer within 75 miles of that worksite. See § 825.105(b) regarding employees who work outside the U.S.\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:4dd416c5d8a0cd8b2dafb9c1860baaad4347b4b45893545dfc475ee57a589eb8\",\"modality\":\"not_stated\",\"modality_quote\":\"\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:52845b0f974023ca22563eccf0178e7be8a6eb835256b9bbedf742d49a02a9ca\",\"origin\":\"aiSuggested\",\"quote\":\"(a) An eligible employee is an employee of a covered employer who:\\n\\n(1) Has been employed by the employer for at least 12 months, and\\n\\n(2) Has been employed for at least 1,250 hours of service during the 12-month period immediately preceding the commencement of the leave ( see § 825.801 for special hours of service requirements for airline flight crew employees), and\\n\\n(3) Is employed at a worksite where 50 or more employees are employed by the employer within 75 miles of that worksite. See § 825.105(b) regarding employees who work outside the U.S.\",\"references\":[\"§ 825.801\",\"§ 825.105(b)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:bde7f34333163ed7779a034dc9eb21e8ed32bc81e8a14608aa3d0bc7ecb4f446\",\"scope_quotes\":[\"(a) An eligible employee is an employee of a covered employer who:\"],\"scope_text\":\"Applies to an employee of a covered employer seeking status as an eligible employee.\",\"section_id\":\"section-1\",\"start\":37,\"summary\":\"An eligible employee is an employee of a covered employer who has been employed by the employer for at least 12 months, has been employed for at least 1,250 hours of service during the 12-month period immediately preceding the commencement of the leave (subject to § 825.801 for airline flight crew employees), and is employed at a worksite where 50 or more employees are employed by the employer within 75 miles of that worksite.\",\"target_ids\":[],\"typed_values\":[]}",

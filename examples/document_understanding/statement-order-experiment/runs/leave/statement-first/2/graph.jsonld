      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:16b1909e8bc579cb99eca6fde8d54dfc6ae4554b30d78e59b605b2b1211f356c\",\"urn:rulespec:document-understanding:assertion:217d0591c1a4ef9cf899e6bd4fc59ce93f4df5df1ddd7bb26532562b9fd5f941\",\"urn:rulespec:document-understanding:assertion:8bc08954f856762bb991955374d5f7288caf811bce64467c019c814b6ab7c8bb\",\"urn:rulespec:document-understanding:assertion:0867c763a33ec1c05d14e074ecfac2dd15a8535ee1b4c41dcec5cc3be1f926b0\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"effective_periods\":[],\"end\":2804,\"evidence\":[{\"end\":2804,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A17e50019a4e77ab1a9c73c9fab8bd1b6da871d60b60c77790e8803a1d9920f62:2419:2804:sha256-668999c51c74d480383126ed520172cea18a50cba1239cdc7337af5ed0e7a425\",\"quote\":\"(4) Nothing in this section prevents employers from considering employment prior to a continuous break in service of more than seven years when determining whether an employee has met the 12-month employment requirement. However, if an employer chooses to recognize such prior employment, the employer must do so uniformly, with respect to all employees with similar breaks in service.\",\"start\":2419},{\"end\":2455,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A17e50019a4e77ab1a9c73c9fab8bd1b6da871d60b60c77790e8803a1d9920f62:2423:2455:sha256-3a9c2af8fdcb26e636d6793af0ce395348b087e952d55ab41fdda4b0dcea513f\",\"quote\":\"Nothing in this section prevents\",\"start\":2423},{\"end\":2804,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A17e50019a4e77ab1a9c73c9fab8bd1b6da871d60b60c77790e8803a1d9920f62:2419:2804:sha256-668999c51c74d480383126ed520172cea18a50cba1239cdc7337af5ed0e7a425\",\"quote\":\"(4) Nothing in this section prevents employers from considering employment prior to a continuous break in service of more than seven years when determining whether an employee has met the 12-month employment requirement. However, if an employer chooses to recognize such prior employment, the employer must do so uniformly, with respect to all employees with similar breaks in service.\",\"start\":2419}],\"id\":\"urn:rulespec:document-understanding:revision:b3865b4392efcfd27a47175b9f2d71c08b2751756bf45ffdea0fd0d5369f4997\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"permission\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:0867c763a33ec1c05d14e074ecfac2dd15a8535ee1b4c41dcec5cc3be1f926b0\",\"modality\":\"may\",\"modality_quote\":\"Nothing in this section prevents\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:fad595fc7b0da89ffac87374ea02b20ff66d7d020bfa393a180315448ea49d9e\",\"origin\":\"aiSuggested\",\"quote\":\"(4) Nothing in this section prevents employers from considering employment prior to a continuous break in service of more than seven years when determining whether an employee has met the 12-month employment requirement. However, if an employer chooses to recognize such prior employment, the employer must do so uniformly, with respect to all employees with similar breaks in service.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:506ae07097ce610eb496e2af502cd8bfe782a2cb86f8eb7969d35a01c9979e86\",\"scope_quotes\":[\"(4) Nothing in this section prevents employers from considering employment prior to a continuous break in service of more than seven years when determining whether an employee has met the 12-month employment requirement. However, if an employer chooses to recognize such prior employment, the employer must do so uniformly, with respect to all employees with similar breaks in service.\"],\"scope_text\":\"When determining whether an employee has met the 12-month employment requirement following a continuous break in service of more than seven years.\",\"section_id\":\"section-1\",\"start\":2419,\"summary\":\"Nothing in this section prevents employers from considering employment prior to a continuous break in service of more than seven years when determining whether an employee has met the 12-month employment requirement.\",\"target_ids\":[],\"typed_values\":[]}",

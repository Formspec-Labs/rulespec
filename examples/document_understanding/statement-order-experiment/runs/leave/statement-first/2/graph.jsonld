    {
      "@id": "urn:rulespec:document-understanding:assertion:064692f03f0f207dd1d0a2ab87078ee8157cd125774f69d3ebacdc0e0cfcb689",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:46a6318d597481ef43750a5815050abcf17da41881ef51a23011450e74ec1f7b",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:dbd442f9853d75c32cf467708a00aa3445cbd700edfa419f120208e53f9488ad",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:7821db6e6210125e4932e585d7c302f909cfcd2a959b9785b34132f887cd4367",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:alternative:0",
      "rkaf:assertsValue": {
        "@value": "(i) The employee's break in service is occasioned by the fulfillment of his or her Uniformed Services Employment and Reemployment Rights Act (USERRA), 38 U.S.C. 4301, et seq., covered service obligation. The period of absence from work due to or necessitated by USERRA-covered service must be also counted in determining whether the employee has been employed for at least 12 months by the employer. However, this section does not provide any greater entitlement to the employee than would be available under the USERRA; or",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },
    {
      "@id": "urn:rulespec:document-understanding:binding:215f737bf9ef67f36aeb0ec1eeb5aaa2ec7cbec2903bf3f5c49fee8ab81324d3",
      "@type": "rkaf:EvidenceBinding",
      "rkaf:bindsAssertion": "urn:rulespec:document-understanding:assertion:064692f03f0f207dd1d0a2ab87078ee8157cd125774f69d3ebacdc0e0cfcb689",
      "rkaf:evidenceRole": "rkaf:textualEvidence",
      "rkaf:evidentiaryFunction": "rkaf:supports",
      "rkaf:bindsSourceFragment": [
        "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A17e50019a4e77ab1a9c73c9fab8bd1b6da871d60b60c77790e8803a1d9920f62:1159:1682:sha256-3583bfa13c136e40a1005ff1210b6c0bcc560609a0916bb52fde5527907c0b6a"
      ]
    },
    {
      "@id": "urn:rulespec:document-understanding:assertion:62106084514c3154f93ecbfdb65b03e3bee77c5952067573104534c02c6f6467",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:46a6318d597481ef43750a5815050abcf17da41881ef51a23011450e74ec1f7b",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:dbd442f9853d75c32cf467708a00aa3445cbd700edfa419f120208e53f9488ad",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:7821db6e6210125e4932e585d7c302f909cfcd2a959b9785b34132f887cd4367",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:alternative:1",
      "rkaf:assertsValue": {
        "@value": "(ii) A written agreement, including a collective bargaining agreement, exists concerning the employer's intention to rehire the employee after the break in service (e.g., for purposes of the employee furthering his or her education or for childrearing purposes).",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:6f19733889cbf9b47770c89275efc5e717db2aae0f17ecd7b10d78d7c9bf6611\",\"urn:rulespec:document-understanding:assertion:ce9b2f99d34f503d683bc76123f1d8779cdc5ac2b49ba12a7c0fc835fcf887bf\",\"urn:rulespec:document-understanding:assertion:2baf9dfdb3ca8f581b112082fdd59ad015fb993e9c2340ca85250c345a55218a\",\"urn:rulespec:document-understanding:assertion:8a5d490c0b71c8e86270228dbd9313fba3c688b7dca73b38d33cdb91db78d441\",\"urn:rulespec:document-understanding:assertion:9a124a582c4779df298cd92b657dc54f5e280091f177cb17ba8f6a4a3114f1e5\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"effective_periods\":[],\"end\":963,\"evidence\":[{\"end\":963,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A17e50019a4e77ab1a9c73c9fab8bd1b6da871d60b60c77790e8803a1d9920f62:704:963:sha256-438c5644572a847c74d79f58c54f20e47ea923230c819e21bf4f8083396eaabc\",\"quote\":\"(1) Subject to the exceptions provided in paragraph (b)(2) of this section, employment periods prior to a break in service of seven years or more need not be counted in determining whether the employee has been employed by the employer for at least 12 months.\",\"start\":704},{\"end\":963,\"field\":\"logic_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A17e50019a4e77ab1a9c73c9fab8bd1b6da871d60b60c77790e8803a1d9920f62:704:963:sha256-438c5644572a847c74d79f58c54f20e47ea923230c819e21bf4f8083396eaabc\",\"quote\":\"(1) Subject to the exceptions provided in paragraph (b)(2) of this section, employment periods prior to a break in service of seven years or more need not be counted in determining whether the employee has been employed by the employer for at least 12 months.\",\"start\":704},{\"end\":858,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A17e50019a4e77ab1a9c73c9fab8bd1b6da871d60b60c77790e8803a1d9920f62:850:858:sha256-b00eebc92fbf41e3d233b28a918c7b90de96d6a15c0daebb94dde8af457529df\",\"quote\":\"need not\",\"start\":850},{\"end\":702,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A17e50019a4e77ab1a9c73c9fab8bd1b6da871d60b60c77790e8803a1d9920f62:592:702:sha256-130832d94200d58087ab6a46024a3a10483b1b99086401c1b273635c4e31aaf3\",\"quote\":\"(b) The 12 months an employee must have been employed by the employer need not be consecutive months, provided\",\"start\":592},{\"end\":963,\"field\":\"scope_text:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A17e50019a4e77ab1a9c73c9fab8bd1b6da871d60b60c77790e8803a1d9920f62:704:963:sha256-438c5644572a847c74d79f58c54f20e47ea923230c819e21bf4f8083396eaabc\",\"quote\":\"(1) Subject to the exceptions provided in paragraph (b)(2) of this section, employment periods prior to a break in service of seven years or more need not be counted in determining whether the employee has been employed by the employer for at least 12 months.\",\"start\":704}],\"id\":\"urn:rulespec:document-understanding:revision:4d549babb71d16acfa8d35f5c4283c863f599987492279c6a781d01bd7f797e1\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"exemption\",\"logic_text\":\"(1) Subject to the exceptions provided in paragraph (b)(2) of this section, employment periods prior to a break in service of seven years or more need not be counted in determining whether the employee has been employed by the employer for at least 12 months.\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:9a124a582c4779df298cd92b657dc54f5e280091f177cb17ba8f6a4a3114f1e5\",\"modality\":\"not_required\",\"modality_quote\":\"need not\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:2b5eb4ed04af5e6bea99e9f836ed79c1fbf99da99fcce7464f949c1a5b27f543\",\"origin\":\"aiSuggested\",\"quote\":\"(1) Subject to the exceptions provided in paragraph (b)(2) of this section, employment periods prior to a break in service of seven years or more need not be counted in determining whether the employee has been employed by the employer for at least 12 months.\",\"references\":[\"paragraph (b)(2)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:e570e653fad0851957fb50db77985116c2444c10a0ffe336267b29e6d47766cd\",\"scope_quotes\":[\"(b) The 12 months an employee must have been employed by the employer need not be consecutive months, provided\",\"(1) Subject to the exceptions provided in paragraph (b)(2) of this section, employment periods prior to a break in service of seven years or more need not be counted in determining whether the employee has been employed by the employer for at least 12 months.\"],\"scope_text\":\"Subject to the exceptions provided in paragraph (b)(2) of this section, when determining whether an employee has been employed by the employer for at least 12 months following a break in service of seven years or more.\",\"section_id\":\"section-1\",\"start\":704,\"summary\":\"Employment periods prior to a break in service of seven years or more need not be counted in determining whether the employee has been employed by the employer for at least 12 months, subject to the exceptions provided in paragraph (b)(2).\",\"target_ids\":[],\"typed_values\":[]}",
      "dcterms:references": [
        {
          "@id": "urn:rulespec:document-understanding:assertion:6f19733889cbf9b47770c89275efc5e717db2aae0f17ecd7b10d78d7c9bf6611"

      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:3d7368710741eabf724239359695ba7c082d6ec510685f41756f47e69fe7d4c2\",\"urn:rulespec:document-understanding:assertion:50c932aeef8adb0bfd535e4ed6aed94e34f1e48c9257da725e2db5cb55a10032\",\"urn:rulespec:document-understanding:assertion:070129ffe159425ac534d03b7085fbab862878a142ec172d0a2cae92cb99f877\",\"urn:rulespec:document-understanding:assertion:f73219adce0e3c0b0ae72cd2ff5f259627796e56d8a922304cd61e760110355f\",\"urn:rulespec:document-understanding:assertion:43ed60e26dfe14c1d130dd17a21abbca006cb43a2ef051f9f6598350c0532069\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"effective_periods\":[],\"end\":2804,\"evidence\":[{\"end\":2804,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A17e50019a4e77ab1a9c73c9fab8bd1b6da871d60b60c77790e8803a1d9920f62:2419:2804:sha256-668999c51c74d480383126ed520172cea18a50cba1239cdc7337af5ed0e7a425\",\"quote\":\"(4) Nothing in this section prevents employers from considering employment prior to a continuous break in service of more than seven years when determining whether an employee has met the 12-month employment requirement. However, if an employer chooses to recognize such prior employment, the employer must do so uniformly, with respect to all employees with similar breaks in service.\",\"start\":2419},{\"end\":2804,\"field\":\"logic_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A17e50019a4e77ab1a9c73c9fab8bd1b6da871d60b60c77790e8803a1d9920f62:2419:2804:sha256-668999c51c74d480383126ed520172cea18a50cba1239cdc7337af5ed0e7a425\",\"quote\":\"(4) Nothing in this section prevents employers from considering employment prior to a continuous break in service of more than seven years when determining whether an employee has met the 12-month employment requirement. However, if an employer chooses to recognize such prior employment, the employer must do so uniformly, with respect to all employees with similar breaks in service.\",\"start\":2419},{\"end\":2725,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A17e50019a4e77ab1a9c73c9fab8bd1b6da871d60b60c77790e8803a1d9920f62:2721:2725:sha256-4137b01e139589b7a1d3b3fc4da031d8ce5bb415808734e970c3a58ea0e98f0f\",\"quote\":\"must\",\"start\":2721},{\"end\":2804,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A17e50019a4e77ab1a9c73c9fab8bd1b6da871d60b60c77790e8803a1d9920f62:2419:2804:sha256-668999c51c74d480383126ed520172cea18a50cba1239cdc7337af5ed0e7a425\",\"quote\":\"(4) Nothing in this section prevents employers from considering employment prior to a continuous break in service of more than seven years when determining whether an employee has met the 12-month employment requirement. However, if an employer chooses to recognize such prior employment, the employer must do so uniformly, with respect to all employees with similar breaks in service.\",\"start\":2419}],\"id\":\"urn:rulespec:document-understanding:revision:1f2dbc348db55aab955ab05ab6229cab906cfcf0485eb31e590abbe5a74a0239\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"(4) Nothing in this section prevents employers from considering employment prior to a continuous break in service of more than seven years when determining whether an employee has met the 12-month employment requirement. However, if an employer chooses to recognize such prior employment, the employer must do so uniformly, with respect to all employees with similar breaks in service.\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:43ed60e26dfe14c1d130dd17a21abbca006cb43a2ef051f9f6598350c0532069\",\"modality\":\"must\",\"modality_quote\":\"must\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:498abdd2aab632f62b0af83628c8f9139279e5f629adf103d4d00e9d3576873d\",\"origin\":\"aiSuggested\",\"quote\":\"(4) Nothing in this section prevents employers from considering employment prior to a continuous break in service of more than seven years when determining whether an employee has met the 12-month employment requirement. However, if an employer chooses to recognize such prior employment, the employer must do so uniformly, with respect to all employees with similar breaks in service.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:29084265f1af23f5fa518976233159c58b7ec8b5bac64c53c40f23d00aecb070\",\"scope_quotes\":[\"(4) Nothing in this section prevents employers from considering employment prior to a continuous break in service of more than seven years when determining whether an employee has met the 12-month employment requirement. However, if an employer chooses to recognize such prior employment, the employer must do so uniformly, with respect to all employees with similar breaks in service.\"],\"scope_text\":\"If an employer chooses to recognize prior employment preceding a continuous break in service of more than seven years.\",\"section_id\":\"section-1\",\"start\":2419,\"summary\":\"If an employer chooses to recognize prior employment before a continuous break in service of more than seven years, the employer must do so uniformly, with respect to all employees with similar breaks in service.\",\"target_ids\":[],\"typed_values\":[]}",

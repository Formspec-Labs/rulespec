            "text": "{\n  \"claim_judgments\": [\n    {\n      \"claim_id\": \"C0000\",\n      \"unit_ids\": [\"U0000\"],\n      \"quotes\": [\n        \"(c)(1) Except as provided in paragraph (c)(2) of this section and in § 825.801 containing the special hours of service requirement for airline flight crew employees, whether an employee has worked the minimum 1,250 hours of service is determined according to the principles established under the Fair Labor Standards Act (FLSA) for determining compensable hours of work.\",\n        \"Any accurate accounting of actual hours worked under FLSA's principles may be used.\"\n      ],\n      \"rationale\": \"The summary and scope omit the governing exceptions set forth at the beginning of paragraph (c)(1) (exceptions provided in paragraph (c)(2) for USERRA service and in § 825.801 for airline flight crew employees). The summary also omits the purpose of the accounting (determining whether an employee has worked the minimum 1,250 hours of service), and no typed value was provided for the 1,250 hours threshold. Modality 'may', boundary, and passive framing are otherwise supported by the text.\",\n      \"dimensions\": {\n        \"summary\": \"error\",\n        \"actor\": \"correct\",\n        \"support\": \"correct\",\n        \"scope\": \"error\",\n        \"links\": \"correct\",\n        \"boundary\": \"correct\",\n        \"modality\": \"correct\",\n        \"action\": \"correct\",\n        \"object\": \"correct\",\n        \"alternatives\": \"not_applicable\",\n        \"thresholds\": \"error\",\n        \"concepts\": \"not_applicable\",\n        \"source_attribution\": \"not_applicable\",\n        \"effectivity\": \"not_applicable\"\n      }\n    }\n  ],\n  \"unit_judgments\": [\n    {\n      \"unit_id\": \"U0000\",\n      \"claim_ids\": [\"C0000\"],\n      \"status\": \"partial\",\n      \"rationale\": \"Claim C0000 extracts the permission to use any accurate accounting under FLSA principles, but it fails to include the governing exceptions (paragraph (c)(2) for USERRA service and § 825.801 for airline flight crew employees) in its summary and scope, and omits the 1,250-hour threshold from its summary.\",\n      \"quotes\": [\n        \"(c)(1) Except as provided in paragraph (c)(2) of this section and in § 825.801 containing the special hours of service requirement for airline flight crew employees, whether an employee has worked the minimum 1,250 hours of service is determined according to the principles established under the Fair Labor Standards Act (FLSA) for determining compensable hours of work.\",\n        \"Any accurate accounting of actual hours worked under FLSA's principles may be used.\"\n      ]\n    }\n  ]\n}",

      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:e4b53f70fdc9b9983bef985e34974dc04cf25661027d5e64272ceb453f742899",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:503f39066fd68525ace7351d7c687aae30b943e93d7264ff2a9fde33050714fa",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:7c8e1879379fd4dacea74cefdb3d984f08cbbf4f556e10d1e34b4d61563ac725",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[\"(1) Has been employed by the employer for at least 12 months, and\",\"(2) Has been employed for at least 1,250 hours of service during the 12-month period immediately preceding the commencement of the leave ( see § 825.801 for special hours of service requirements for airline flight crew employees), and\",\"(3) Is employed at a worksite where 50 or more employees are employed by the employer within 75 miles of that worksite. See § 825.105(b) regarding employees who work outside the U.S.\"],\"choice_text\":\"All of: (1) has been employed by the employer for at least 12 months; AND (2) has been employed for at least 1,250 hours of service during the 12-month period immediately preceding the commencement of the leave; AND (3) is employed at a worksite where 50 or more employees are employed by the employer within 75 miles of that worksite.\",\"claimants\":[],\"concepts\":[],\"effective_periods\":[],\"jurisdiction\":\"\",\"kind\":\"definition\",\"logic_text\":\"(a) An eligible employee is an employee of a covered employer who:\\n\\n(1) Has been employed by the employer for at least 12 months, and\\n\\n(2) Has been employed for at least 1,250 hours of service during the 12-month period immediately preceding the commencement of the leave ( see § 825.801 for special hours of service requirements for airline flight crew employees), and\\n\\n(3) Is employed at a worksite where 50 or more employees are employed by the employer within 75 miles of that worksite. See § 825.105(b) regarding employees who work outside the U.S.\",\"modality\":\"not_stated\",\"object\":\"\",\"scope_text\":\"An employee of a covered employer\",\"summary\":\"An eligible employee is defined as an employee of a covered employer who has been employed by the employer for at least 12 months, has been employed for at least 1,250 hours of service during the 12-month period immediately preceding the commencement of the leave (noting § 825.801 for special rules for airline flight crew employees), and is employed at a worksite where 50 or more employees are employed by the employer within 75 miles of that worksite (noting § 825.105(b) regarding employees working outside the U.S.).\",\"typed_values\":[]}",
        "@type": "xsd:string"
      },

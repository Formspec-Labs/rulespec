    {
      "@id": "urn:rulespec:document-understanding:assertion:2bc42d66b53121aeebed797b188014d4533df6b9428a1e2c970ffb2323e34b3f",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",

      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:e4b53f70fdc9b9983bef985e34974dc04cf25661027d5e64272ceb453f742899",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:503f39066fd68525ace7351d7c687aae30b943e93d7264ff2a9fde33050714fa",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:495a15aff52f4e0ea2f12b3e77c8e12564fdf3fa89b9b52a4401eb34c42593f6",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"effective_periods\":[],\"jurisdiction\":\"\",\"kind\":\"statement\",\"logic_text\":\"(3) In the event an employer does not maintain an accurate record of hours worked by an employee, including for employees who are exempt from FLSA's requirement that a record be kept of their hours worked (e.g., bona fide executive, administrative, and professional employees as defined in FLSA Regulations, 29 CFR part 541), the employer has the burden of showing that the employee has not worked the requisite hours. An employer must be able to clearly demonstrate, for example, that full-time teachers ( see § 825.102 for definition) of an elementary or secondary school system, or institution of higher education, or other educational establishment or institution (who often work outside the classroom or at their homes) did not work 1,250 hours during the previous 12 months in order to claim that the teachers are not eligible for FMLA leave. See § 825.801(d) for special rules applicable to airline flight crew employees.\",\"modality\":\"not_stated\",\"object\":\"\",\"scope_text\":\"In the event an employer does not maintain an accurate record of hours worked by an employee, including for employees exempt from FLSA recordkeeping requirements (such as executive, administrative, and professional employees under 29 CFR part 541)\",\"summary\":\"In the event an employer does not maintain an accurate record of hours worked by an employee (including FLSA-exempt employees), the employer has the burden of showing that the employee has not worked the requisite hours, and must be able to clearly demonstrate that the employee did not work 1,250 hours during the previous 12 months in order to claim ineligibility (referencing § 825.801(d) for airline flight crew employees).\",\"typed_values\":[]}",
        "@type": "xsd:string"
      },

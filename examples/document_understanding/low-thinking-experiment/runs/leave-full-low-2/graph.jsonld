    {
      "@id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa4cdfc9b75c8a1ed78c29b8a344913757e4b95198a4b069127aa9092960aaf4f:2806:3602:sha256-0207e56b05e1baa2b73068ae0df66fa509d96f5833d29bab4fe4be2d62b8fd28",
      "@type": "rkaf:SourceFragment",
      "oa:hasSource": "urn:rulespec:document-understanding:document:a4cdfc9b75c8a1ed78c29b8a344913757e4b95198a4b069127aa9092960aaf4f",
      "rkaf:fragmentIdentityScheme": "rkaf:carrier-local-fragment",
      "rkaf:sourceArtifactDigest": "sha256:a4cdfc9b75c8a1ed78c29b8a344913757e4b95198a4b069127aa9092960aaf4f",
      "rkaf:fragmentContentDigest": "sha256:0207e56b05e1baa2b73068ae0df66fa509d96f5833d29bab4fe4be2d62b8fd28",
      "rkaf:selectorKind": [
        "oa:TextQuoteSelector",
        "oa:TextPositionSelector"
      ],
      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "(c)(1) Except as provided in paragraph (c)(2) of this section and in § 825.801 containing the special hours of service requirement for airline flight crew employees, whether an employee has worked the minimum 1,250 hours of service is determined according to the principles established under the Fair Labor Standards Act (FLSA) for determining compensable hours of work. See 29 CFR part 785. The determining factor is the number of hours an employee has worked for the employer within the meaning of the FLSA. The determination is not limited by methods of recordkeeping, or by compensation agreements that do not accurately reflect all of the hours an employee has worked for or been in service to the employer. Any accurate accounting of actual hours worked under FLSA's principles may be used."
        },
        {
          "@type": "oa:TextPositionSelector",
          "oa:start": 2806,
          "oa:end": 3602,
          "rkaf:coordinateSystem": "rkaf:unicode-codepoint"
        }
      ]
    },
    {
      "@id": "urn:rulespec:document-understanding:scope:241654e20f74b8ffbf315c4ce9d887e36065fa98a25111ed5c826ef512b00004",
      "@type": "rkaf:ApplicabilityScope",
      "rkaf:appliesInJurisdiction": [],
      "rkaf:applicabilityCondition": "Except as provided in paragraph (c)(2) and in § 825.801 for airline flight crew employees"
    },
    {
      "@id": "urn:rulespec:document-understanding:assertion:926fd7fabd1f21aadd4a19cb082d027141503120800978ae11caa105ee0554e7",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:e4b53f70fdc9b9983bef985e34974dc04cf25661027d5e64272ceb453f742899",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:503f39066fd68525ace7351d7c687aae30b943e93d7264ff2a9fde33050714fa",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:d989d2d997b799f93f8d1fb4d1750553529b08a823ecf0ff7ba610f4cc480b46",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:states-statement",
      "rkaf:assertsValue": {
        "@value": "Except as provided in paragraph (c)(2) and in § 825.801, whether an employee has worked the minimum 1,250 hours of service is determined according to FLSA principles for compensable hours of work, based on the number of hours worked within the meaning of the FLSA, not limited by methods of recordkeeping or non-reflective compensation agreements; any accurate accounting of actual hours worked under FLSA principles may be used.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

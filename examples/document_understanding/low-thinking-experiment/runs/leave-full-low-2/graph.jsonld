      "rkaf:assertsValue": {
        "@value": "In the event an employer does not maintain an accurate record of hours worked by an employee, including for employees exempt from FLSA recordkeeping requirements (such as executive, administrative, and professional employees under 29 CFR part 541)",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },
    {
      "@id": "urn:rulespec:document-understanding:binding:b144f0e981e21e06f22bce59395972afe2035c4040d0e9378a10a05fe2e91f1a",
      "@type": "rkaf:EvidenceBinding",
      "rkaf:bindsAssertion": "urn:rulespec:document-understanding:assertion:7ee2a0337b85b91985fe23ba0e211849c608668ed8dc22ded885f24814b9500f",

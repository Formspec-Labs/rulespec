      "rkaf:assertsValue": {
        "@value": "In determining whether the employee has been employed by the employer for at least 12 months, where a break in service exceeds seven years and a written agreement exists concerning rehire",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },
    {

    {
      "@id": "urn:rulespec:document-understanding:assertion:9aae1011e22b889cdb9b713c89ba33c4fe4b8848808692f6a6daa8485468b09f",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",

      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:c10559343c73bc17dd83a5ebedf70fbee7dddf9f31bd8106c6c67bcbbb7e577a\",\"urn:rulespec:document-understanding:assertion:7af83e5d8c7ed1e2be787bb14e80333b54799500cad315c04d72bdd00d12af63\",\"urn:rulespec:document-understanding:assertion:8bb245ffc8ca1e674d73f00b476310d79c8b7408cb82478b388397a10d942efc\",\"urn:rulespec:document-understanding:assertion:1b2422505a3d70494945df81fc32c2989342ec048d3f8fda1b80f4274fd21342\",\"urn:rulespec:document-understanding:assertion:6cfcebb7ed095b771b7f6c9f6122cdfc5ca222a755dfe91768d7fa2bc08b6652\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[\"(b) The 12 months an employee must have been employed by the employer need not be consecutive months, provided\"],\"effective_periods\":[],\"end\":2417,\"evidence\":[{\"end\":2417,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa4cdfc9b75c8a1ed78c29b8a344913757e4b95198a4b069127aa9092960aaf4f:1948:2417:sha256-4048733db741ffbcee82288a3f298f4f891c683f3d1c1b543892af4f7ddc5dba\",\"quote\":\"(3) If an employee is maintained on the payroll for any part of a week, including any periods of paid or unpaid leave (sick, vacation) during which other benefits or compensation are provided by the employer (e.g., workers' compensation, group health plan benefits, etc.), the week counts as a week of employment. For purposes of determining whether intermittent/occasional/casual employment qualifies as at least 12 months, 52 weeks is deemed to be equal to 12 months.\",\"start\":1948},{\"end\":2417,\"field\":\"logic_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa4cdfc9b75c8a1ed78c29b8a344913757e4b95198a4b069127aa9092960aaf4f:1948:2417:sha256-4048733db741ffbcee82288a3f298f4f891c683f3d1c1b543892af4f7ddc5dba\",\"quote\":\"(3) If an employee is maintained on the payroll for any part of a week, including any periods of paid or unpaid leave (sick, vacation) during which other benefits or compensation are provided by the employer (e.g., workers' compensation, group health plan benefits, etc.), the week counts as a week of employment. For purposes of determining whether intermittent/occasional/casual employment qualifies as at least 12 months, 52 weeks is deemed to be equal to 12 months.\",\"start\":1948},{\"end\":2417,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa4cdfc9b75c8a1ed78c29b8a344913757e4b95198a4b069127aa9092960aaf4f:1948:2417:sha256-4048733db741ffbcee82288a3f298f4f891c683f3d1c1b543892af4f7ddc5dba\",\"quote\":\"(3) If an employee is maintained on the payroll for any part of a week, including any periods of paid or unpaid leave (sick, vacation) during which other benefits or compensation are provided by the employer (e.g., workers' compensation, group health plan benefits, etc.), the week counts as a week of employment. For purposes of determining whether intermittent/occasional/casual employment qualifies as at least 12 months, 52 weeks is deemed to be equal to 12 months.\",\"start\":1948},{\"end\":702,\"field\":\"context:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa4cdfc9b75c8a1ed78c29b8a344913757e4b95198a4b069127aa9092960aaf4f:592:702:sha256-130832d94200d58087ab6a46024a3a10483b1b99086401c1b273635c4e31aaf3\",\"quote\":\"(b) The 12 months an employee must have been employed by the employer need not be consecutive months, provided\",\"start\":592}],\"id\":\"urn:rulespec:document-understanding:revision:137ca16653dc70713564ce3b49a16a401e0f0c942407a2bfe175004706e24081\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"statement\",\"logic_text\":\"(3) If an employee is maintained on the payroll for any part of a week, including any periods of paid or unpaid leave (sick, vacation) during which other benefits or compensation are provided by the employer (e.g., workers' compensation, group health plan benefits, etc.), the week counts as a week of employment. For purposes of determining whether intermittent/occasional/casual employment qualifies as at least 12 months, 52 weeks is deemed to be equal to 12 months.\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:6cfcebb7ed095b771b7f6c9f6122cdfc5ca222a755dfe91768d7fa2bc08b6652\",\"modality\":\"not_stated\",\"modality_quote\":\"\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:28f07c9131526f1bd0028ff5918774e76d32c94b63d9289eff1abf91b2a0a8ee\",\"origin\":\"aiSuggested\",\"quote\":\"(3) If an employee is maintained on the payroll for any part of a week, including any periods of paid or unpaid leave (sick, vacation) during which other benefits or compensation are provided by the employer (e.g., workers' compensation, group health plan benefits, etc.), the week counts as a week of employment. For purposes of determining whether intermittent/occasional/casual employment qualifies as at least 12 months, 52 weeks is deemed to be equal to 12 months.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:b1ccbfc1f397245e0b743a284bde1ca207cbf639f134801cea736360e30a0068\",\"scope_quotes\":[\"(3) If an employee is maintained on the payroll for any part of a week, including any periods of paid or unpaid leave (sick, vacation) during which other benefits or compensation are provided by the employer (e.g., workers' compensation, group health plan benefits, etc.), the week counts as a week of employment. For purposes of determining whether intermittent/occasional/casual employment qualifies as at least 12 months, 52 weeks is deemed to be equal to 12 months.\"],\"scope_text\":\"If an employee is maintained on the payroll for any part of a week, including any periods of paid or unpaid leave (sick, vacation) during which other benefits or compensation are provided by the employer (such as workers' compensation, group health plan benefits, etc.)\",\"section_id\":\"section-1\",\"start\":1948,\"summary\":\"If an employee is maintained on the payroll for any part of a week, including periods of paid or unpaid leave during which other benefits or compensation are provided by the employer, that week counts as a week of employment; and for purposes of determining whether intermittent, occasional, or casual employment qualifies as at least 12 months, 52 weeks is deemed equal to 12 months.\",\"target_ids\":[],\"typed_values\":[]}",

      "@id": "urn:rulespec:document-understanding:assertion:63e63a89da94158817891061a9afcaaab30e7152b1995dc394b73306941ed508",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",

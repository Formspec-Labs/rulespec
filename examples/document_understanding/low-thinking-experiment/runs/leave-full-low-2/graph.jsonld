    {
      "@id": "urn:rulespec:document-understanding:assertion:f01f6d6992e19275e9e609ac20d3024211d33fa1b573a9f1a132e68818e4a236",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:e4b53f70fdc9b9983bef985e34974dc04cf25661027d5e64272ceb453f742899",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:503f39066fd68525ace7351d7c687aae30b943e93d7264ff2a9fde33050714fa",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:ceae9c25e320778d432006dd4f72ce820829146929965cb4d55a83622d677cbe",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:logic_text",
      "rkaf:assertsValue": {
        "@value": "(2) Employment periods preceding a break in service of more than seven years must be counted in determining whether the employee has been employed by the employer for at least 12 months where:\n\n(i) The employee's break in service is occasioned by the fulfillment of his or her Uniformed Services Employment and Reemployment Rights Act (USERRA), 38 U.S.C. 4301, et seq., covered service obligation. The period of absence from work due to or necessitated by USERRA-covered service must be also counted in determining whether the employee has been employed for at least 12 months by the employer. However, this section does not provide any greater entitlement to the employee than would be available under the USERRA; or",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },
    {
      "@id": "urn:rulespec:document-understanding:binding:418ff1bfd1e9c74ab93df7acbe0bd52ba3fca04e7bed35d2ffb3e75c12f4e45b",

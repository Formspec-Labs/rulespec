      "rkaf:applicabilityCondition": "For determining whether an employee meets the hours of service requirement and total of at least 12 months of employment"
    },
    {
      "@id": "urn:rulespec:document-understanding:assertion:eb5fba8ffd9492bbcb762c79bfdd069398aafcd1f73ff6be54fbb8f3991c5163",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:e4b53f70fdc9b9983bef985e34974dc04cf25661027d5e64272ceb453f742899",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:503f39066fd68525ace7351d7c687aae30b943e93d7264ff2a9fde33050714fa",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:8dda62a56e1f5277004a6b8c0a9d28bb42b709a374ab4263253d4849d497955f",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:states-requirement",
      "rkaf:assertsValue": {
        "@value": "The determination of whether an employee meets the hours of service requirement and has been employed for a total of at least 12 months must be made as of the date the FMLA leave is to start, and if an employee is on non-FMLA leave when meeting 12-month eligibility, any portion taken for an FMLA-qualifying reason after meeting it becomes FMLA leave (referencing § 825.300(b) for eligibility notice rules).",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:e4b53f70fdc9b9983bef985e34974dc04cf25661027d5e64272ceb453f742899",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:503f39066fd68525ace7351d7c687aae30b943e93d7264ff2a9fde33050714fa",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:ceae9c25e320778d432006dd4f72ce820829146929965cb4d55a83622d677cbe",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:states-requirement",
      "rkaf:assertsValue": {
        "@value": "Employment periods preceding a break in service of more than seven years, and the period of absence from work due to or necessitated by USERRA-covered service, must be counted in determining whether the employee has been employed for at least 12 months by the employer where the break in service is occasioned by the fulfillment of a USERRA-covered service obligation (though this does not provide any greater entitlement than available under USERRA).",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:4dfb512f8e9e23fe9a6277403dc61ab423272f5da65436e214854fb4364c3088\",\"urn:rulespec:document-understanding:assertion:fceef64a1b77e015118264f4c91ae318135289b3d7fd2277315fc51317e937f3\",\"urn:rulespec:document-understanding:assertion:f2e7d138613c083924cff96f05fad8c81921883e812ca135c6043e2afa2d08d9\",\"urn:rulespec:document-understanding:assertion:f3a416ac416243bdf0c392239c15a5e91532f7672aca5d6e94ce55c812f51124\",\"urn:rulespec:document-understanding:assertion:4755de6fb83aec6a781f555d81776708300f694ed58b619e08b5d1b088fb1fae\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[\"(b) The 12 months an employee must have been employed by the employer need not be consecutive months, provided\"],\"effective_periods\":[],\"end\":963,\"evidence\":[{\"end\":963,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa4cdfc9b75c8a1ed78c29b8a344913757e4b95198a4b069127aa9092960aaf4f:704:963:sha256-438c5644572a847c74d79f58c54f20e47ea923230c819e21bf4f8083396eaabc\",\"quote\":\"(1) Subject to the exceptions provided in paragraph (b)(2) of this section, employment periods prior to a break in service of seven years or more need not be counted in determining whether the employee has been employed by the employer for at least 12 months.\",\"start\":704},{\"end\":963,\"field\":\"logic_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa4cdfc9b75c8a1ed78c29b8a344913757e4b95198a4b069127aa9092960aaf4f:704:963:sha256-438c5644572a847c74d79f58c54f20e47ea923230c819e21bf4f8083396eaabc\",\"quote\":\"(1) Subject to the exceptions provided in paragraph (b)(2) of this section, employment periods prior to a break in service of seven years or more need not be counted in determining whether the employee has been employed by the employer for at least 12 months.\",\"start\":704},{\"end\":861,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa4cdfc9b75c8a1ed78c29b8a344913757e4b95198a4b069127aa9092960aaf4f:850:861:sha256-cb4bb7c381fd4736333e385ca9b908d9a0058aedb01871d9657a3447db3ba312\",\"quote\":\"need not be\",\"start\":850},{\"end\":702,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa4cdfc9b75c8a1ed78c29b8a344913757e4b95198a4b069127aa9092960aaf4f:592:702:sha256-130832d94200d58087ab6a46024a3a10483b1b99086401c1b273635c4e31aaf3\",\"quote\":\"(b) The 12 months an employee must have been employed by the employer need not be consecutive months, provided\",\"start\":592},{\"end\":963,\"field\":\"scope_text:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa4cdfc9b75c8a1ed78c29b8a344913757e4b95198a4b069127aa9092960aaf4f:704:963:sha256-438c5644572a847c74d79f58c54f20e47ea923230c819e21bf4f8083396eaabc\",\"quote\":\"(1) Subject to the exceptions provided in paragraph (b)(2) of this section, employment periods prior to a break in service of seven years or more need not be counted in determining whether the employee has been employed by the employer for at least 12 months.\",\"start\":704},{\"end\":702,\"field\":\"context:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa4cdfc9b75c8a1ed78c29b8a344913757e4b95198a4b069127aa9092960aaf4f:592:702:sha256-130832d94200d58087ab6a46024a3a10483b1b99086401c1b273635c4e31aaf3\",\"quote\":\"(b) The 12 months an employee must have been employed by the employer need not be consecutive months, provided\",\"start\":592}],\"id\":\"urn:rulespec:document-understanding:revision:6271bc3ac2eb2689eca2fc994ed2061b32c68182007a3fc4533821be7c1607d2\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"exemption\",\"logic_text\":\"(1) Subject to the exceptions provided in paragraph (b)(2) of this section, employment periods prior to a break in service of seven years or more need not be counted in determining whether the employee has been employed by the employer for at least 12 months.\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:4755de6fb83aec6a781f555d81776708300f694ed58b619e08b5d1b088fb1fae\",\"modality\":\"not_required\",\"modality_quote\":\"need not be\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:a3ecbe439f79bf6277ca6b2430c6ec552b4cb88bfe837134383ee53b614d3b25\",\"origin\":\"aiSuggested\",\"quote\":\"(1) Subject to the exceptions provided in paragraph (b)(2) of this section, employment periods prior to a break in service of seven years or more need not be counted in determining whether the employee has been employed by the employer for at least 12 months.\",\"references\":[\"paragraph (b)(2)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:4d4c45d0827b31ab9a3a143f6b6c82a4c425de8a74b5309f68fcca9f15df428a\",\"scope_quotes\":[\"(b) The 12 months an employee must have been employed by the employer need not be consecutive months, provided\",\"(1) Subject to the exceptions provided in paragraph (b)(2) of this section, employment periods prior to a break in service of seven years or more need not be counted in determining whether the employee has been employed by the employer for at least 12 months.\"],\"scope_text\":\"In determining whether an employee has been employed by the employer for at least 12 months, subject to the exceptions in paragraph (b)(2)\",\"section_id\":\"section-1\",\"start\":704,\"summary\":\"Subject to the exceptions in paragraph (b)(2), employment periods prior to a break in service of seven years or more need not be counted in determining whether the employee has been employed by the employer for at least 12 months.\",\"target_ids\":[],\"typed_values\":[]}",
      "dcterms:references": [

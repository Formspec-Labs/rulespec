      "@type": "rkaf:EvidenceBinding",
      "rkaf:bindsAssertion": "urn:rulespec:document-understanding:assertion:e4c59c806f0d5e9a57c95b7c7f889ac58e0738f6e713353111fa9d7f84799bb7",

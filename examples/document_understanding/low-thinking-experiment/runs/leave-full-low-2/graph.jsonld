    {
      "@id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa4cdfc9b75c8a1ed78c29b8a344913757e4b95198a4b069127aa9092960aaf4f:4440:5368:sha256-f224bb89288a47851c4a1b3b1e2aceb37d95d77172afee44175f2f36b851f8ae",
      "@type": "rkaf:SourceFragment",
      "oa:hasSource": "urn:rulespec:document-understanding:document:a4cdfc9b75c8a1ed78c29b8a344913757e4b95198a4b069127aa9092960aaf4f",
      "rkaf:fragmentIdentityScheme": "rkaf:carrier-local-fragment",
      "rkaf:sourceArtifactDigest": "sha256:a4cdfc9b75c8a1ed78c29b8a344913757e4b95198a4b069127aa9092960aaf4f",
      "rkaf:fragmentContentDigest": "sha256:f224bb89288a47851c4a1b3b1e2aceb37d95d77172afee44175f2f36b851f8ae",
      "rkaf:selectorKind": [
        "oa:TextQuoteSelector",
        "oa:TextPositionSelector"
      ],
      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "(3) In the event an employer does not maintain an accurate record of hours worked by an employee, including for employees who are exempt from FLSA's requirement that a record be kept of their hours worked (e.g., bona fide executive, administrative, and professional employees as defined in FLSA Regulations, 29 CFR part 541), the employer has the burden of showing that the employee has not worked the requisite hours. An employer must be able to clearly demonstrate, for example, that full-time teachers ( see § 825.102 for definition) of an elementary or secondary school system, or institution of higher education, or other educational establishment or institution (who often work outside the classroom or at their homes) did not work 1,250 hours during the previous 12 months in order to claim that the teachers are not eligible for FMLA leave. See § 825.801(d) for special rules applicable to airline flight crew employees."
        },
        {
          "@type": "oa:TextPositionSelector",
          "oa:start": 4440,
          "oa:end": 5368,
          "rkaf:coordinateSystem": "rkaf:unicode-codepoint"
        }
      ]
    },
    {
      "@id": "urn:rulespec:document-understanding:scope:a9f3b81e8a68e165888d1581ca0aa4107c92c3d9ac1c9b167bb367c1d3e56904",
      "@type": "rkaf:ApplicabilityScope",
      "rkaf:appliesInJurisdiction": [],
      "rkaf:applicabilityCondition": "In the event an employer does not maintain an accurate record of hours worked by an employee, including for employees exempt from FLSA recordkeeping requirements (such as executive, administrative, and professional employees under 29 CFR part 541)"
    },
    {
      "@id": "urn:rulespec:document-understanding:assertion:a2351c7a470515cf2aa6d6b0cedd79369c83e953f6629aaefa13989ff6339c3d",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:e4b53f70fdc9b9983bef985e34974dc04cf25661027d5e64272ceb453f742899",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:503f39066fd68525ace7351d7c687aae30b943e93d7264ff2a9fde33050714fa",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:495a15aff52f4e0ea2f12b3e77c8e12564fdf3fa89b9b52a4401eb34c42593f6",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:states-statement",
      "rkaf:assertsValue": {
        "@value": "In the event an employer does not maintain an accurate record of hours worked by an employee (including FLSA-exempt employees), the employer has the burden of showing that the employee has not worked the requisite hours, and must be able to clearly demonstrate that the employee did not work 1,250 hours during the previous 12 months in order to claim ineligibility (referencing § 825.801(d) for airline flight crew employees).",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },
    {

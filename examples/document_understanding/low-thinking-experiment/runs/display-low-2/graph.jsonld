      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:4a2797d0f97f6bcdb36da56793bc53c225595d95ac8f09668f97c754d146b94b\",\"urn:rulespec:document-understanding:assertion:69d510212a39e87b9949522d376ceb1061224d31d59cc9467b1e30231f4b2c7b\",\"urn:rulespec:document-understanding:assertion:56c40a1b0d10e55cee6cf2f8d45765c562330bfc904b9709efed3e1e3757803b\",\"urn:rulespec:document-understanding:assertion:a6222597a3d4976e5639b7da9fd1a67bd1486d72ca7e4fcc4f3dd71cd2623899\",\"urn:rulespec:document-understanding:assertion:5ecbc1715bea53d325abaf65648560c1317a94f5c6d0b4b9ee8a232eb2755bc2\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"effective_periods\":[],\"end\":754,\"evidence\":[{\"end\":754,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Acd1d2d681c56417058e5883c90b99d7d8c562af40621c5b8e3d3b614540154d5:519:754:sha256-dbea7b17f13efc5648bf55eebcb9aff4b968bd00d90301ecde3f87fb84c14234\",\"quote\":\"(3) The organizer must appoint an adult steward who remains on site throughout the time the display remains open. This appointment duty does not apply when an agency employee is assigned to supervise the display for that entire period.\",\"start\":519},{\"end\":754,\"field\":\"logic_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Acd1d2d681c56417058e5883c90b99d7d8c562af40621c5b8e3d3b614540154d5:519:754:sha256-dbea7b17f13efc5648bf55eebcb9aff4b968bd00d90301ecde3f87fb84c14234\",\"quote\":\"(3) The organizer must appoint an adult steward who remains on site throughout the time the display remains open. This appointment duty does not apply when an agency employee is assigned to supervise the display for that entire period.\",\"start\":519},{\"end\":669,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn
      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "(1) The demonstration takes place beneath a fixed roof.\n\n(2) The agency has measured wind speed below 20 kilometers per hour at the demonstration site within the preceding 10 minutes.\n\n(3) An agency officer authorizes the demonstration for the duration of the current warning. The authorization expires when that warning ends; it does not authorize demonstrations under a later warning."
        },
        {
          "@type": "oa:TextPositionSelector",
          "oa:start": 1169,
          "oa:end": 1555,
          "rkaf:coordinateSystem": "rkaf:unicode-codepoint"

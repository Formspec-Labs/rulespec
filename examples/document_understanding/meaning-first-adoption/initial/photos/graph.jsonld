      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:cf2d60b0e821550ce5865bc50295d06d947d48074650dfde154c5ba092773ab8\",\"urn:rulespec:document-understanding:assertion:a7bd41eea13bd18f19549f24e62f34221b1a7d7db84f82936a65d9b28e7e1a89\",\"urn:rulespec:document-understanding:assertion:9dabdead8dd4a74c96daa197ac5a260ccc6abae1f9bc566a6fbb0164ee2a2d37\",\"urn:rulespec:document-understanding:assertion:6a8b09816af443b19001b2c39a7eeb5dbd1c69f10cbee18f2067b85399ebc946\",\"urn:rulespec:document-understanding:assertion:1bc3afc2cec4210525af4ca940120e966626173ca377ee30c4e5cb80dbf4c7dd\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"effective_periods\":[],\"end\":1326,\"evidence\":[{\"end\":1326,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A1a47a76c521a93dcac7e7e6d3fb8e2bcef821725a1aa174ee419d39827b0ff4a:943:1326:sha256-67b41604be15d164bf03e64023c9fd82bcddeb89caa71ce8cf4bba7b1b2041b6\",\"quote\":\"NOTE: Applicants may wish to re-use a passport photograph that is depicted on their submitted U.S Certificate of Citizenship or Certificate of Naturalization. Be aware that even if the certificate itself was recently issued, because of U.S. Citizenship and Immigration Services processing times, the photograph may not have been taken within six months of submitting the application.\",\"start\":943},{\"end\":1325,\"field\":\"logic_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A1a47a76c521a93dcac7e7e6d3fb8e2bcef821725a1aa174ee419d39827b0ff4a:1116:1325:sha256-a069edb4b79605e554523b150dee381d6aff7a2a09d520b1026d29645b279c71\",\"quote\":\"even if the certificate itself was recently issued, because of U.S. Citizenship and Immigration Services processing times, the photograph may not have been taken within six months of submitting the application\",\"start\":1116},{\"end\":1326,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A1a47a76c521a93dcac7e7e6d3fb8e2bcef821725a1aa174ee419d39827b0ff4a:943:1326:sha256-67b41604be15d164bf03e64023c9fd82bcddeb89caa71ce8cf4bba7b1b2041b6\",\"quote\":\"NOTE: Applicants may wish to re-use a passport photograph that is depicted on their submitted U.S Certificate of Citizenship or Certificate of Naturalization. Be aware that even if the certificate itself was recently issued, because of U.S. Citizenship and Immigration Services processing times, the photograph may not have been taken within six months of submitting the application.\",\"start\":943}],\"id\":\"urn:rulespec:document-understanding:revision:8e0e09e39f774d0c909d820a2211ef97794c8bb1a302680fb4200bff53f43697\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"statement\",\"logic_text\":\"even if the certificate itself was recently issued, because of U.S. Citizenship and Immigration Services processing times, the photograph may not have been taken within six months of submitting the application\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:1bc3afc2cec4210525af4ca940120e966626173ca377ee30c4e5cb80dbf4c7dd\",\"modality\":\"possible\",\"modality_quote\":\"may\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:ee1c3760556f5e85c6eb3f35d04963acd8f1c7ca74f638a709ccc6fc115fc1b7\",\"origin\":\"aiSuggested\",\"quote\":\"NOTE: Applicants may wish to re-use a passport photograph that is depicted on their submitted U.S Certificate of Citizenship or Certificate of Naturalization. Be aware that even if the certificate itself was recently issued, because of U.S. Citizenship and Immigration Services processing times, the photograph may not have been taken within six months of submitting the application.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:1ef92c397cb95b8f1f68e468159c164e80a36449d9664fec966f93696c5f4af2\",\"scope_quotes\":[\"NOTE: Applicants may wish to re-use a passport photograph that is depicted on their submitted U.S Certificate of Citizenship or Certificate of Naturalization. Be aware that even if the certificate itself was recently issued, because of U.S. Citizenship and Immigration Services processing times, the photograph may not have been taken within six months of submitting the application.\"],\"scope_text\":\"Even if the certificate itself was recently issued, because of U.S. Citizenship and Immigration Services processing times\",\"section_id\":\"section-1\",\"start\":943,\"summary\":\"Even if the certificate itself was recently issued, because of U.S. Citizenship and Immigration Services processing times, the photograph on a U.S. Certificate of Citizenship or Certificate of Naturalization may not have been taken within six months of submitting the application.\",\"target_ids\":[],\"typed_values\":[]}",

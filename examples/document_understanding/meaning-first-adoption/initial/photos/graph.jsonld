      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:c46f02a940c09b08190cfb18e87be7e534712f8c5c62b53d6a427a352dc0a11f\",\"urn:rulespec:document-understanding:assertion:2e7ea3694a8da4e73589e74f1cb25e54ec97a963949bc6fb10d34a530fdb9cf8\",\"urn:rulespec:document-understanding:assertion:5d2855b6aaebf63a807f9740782e03c34ae8e263d7f05eedc6a3b55bb6a68a9a\",\"urn:rulespec:document-understanding:assertion:37f085fc4f2d7f088b193564939ac5769a3c62a50386e13a6898c45e5fc618bf\",\"urn:rulespec:document-understanding:assertion:989a3a73c91d7eba779fcf7f37e58f45f469b35eb426aa0c2483f39f3d8e48d0\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"effective_periods\":[],\"end\":370,\"evidence\":[{\"end\":370,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A1a47a76c521a93dcac7e7e6d3fb8e2bcef821725a1aa174ee419d39827b0ff4a:210:370:sha256-615c651d3b77c0f73dc1b570db8afa27e4e440edc5aa00caf57180a91c60f03d\",\"quote\":\"(2) The infant's head may be discreetly supported, e.g., a car seat with a white or off-white blanket behind the child. Head tilt is acceptable for infants; and\",\"start\":210},{\"end\":259,\"field\":\"logic_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A1a47a76c521a93dcac7e7e6d3fb8e2bcef821725a1aa174ee419d39827b0ff4a:214:259:sha256-2b86194263a324247dc69495f606d7e315e934fac744b2f3111d861811f9250a\",\"quote\":\"The infant's head may be discreetly supported\",\"start\":214},{\"end\":235,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A1a47a76c521a93dcac7e7e6d3fb8e2bcef821725a1aa174ee419d39827b0ff4a:232:235:sha256-ee4d988c65de860fabbfbcd27f73d50bbebe3fba37fe419284f4811389c30bdc\",\"quote\":\"may\",\"start\":232},{\"end\":102,\"field\":\"scope_text
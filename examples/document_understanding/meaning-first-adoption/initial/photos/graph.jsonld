      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:cddda2980b707287af46833a000f92fdb70c61fbeb27a8e790c8729ede1a2969\",\"urn:rulespec:document-understanding:assertion:c583ff46e28e3a0f5691616a89c662af4e61762b576b55de5233b5db2ddbea25\",\"urn:rulespec:document-understanding:assertion:8efe64d2e22010d073a178172d5adb95a61ffd7dc4fca6f2275932ddaf757ab2\",\"urn:rulespec:document-understanding:assertion:6b4c1f08aea2072b62c8a5b4042465c360e35e43c57ab694dfbd7f25fc1c01b8\",\"urn:rulespec:document-understanding:assertion:4deee661d68ee85838b4ce474be7aaf3338667ed7d5056187b6afbe92896c6b2\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[\"(1) The photograph must be in color;\\n\\n(2) The photograph should be taken within six months of submitting the application, be a good likeness of and satisfactorily identify the applicant at the time of the application (see 22 CFR 51.26). A photograph showing a change in hairstyle or facial hair from the identification document submitted is acceptable if it still is a good likeness of the applicant;\"],\"effective_periods\":[],\"end\":539,\"evidence\":[{\"end\":539,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A1a47a76c521a93dcac7e7e6d3fb8e2bcef821725a1aa174ee419d39827b0ff4a:436:539:sha256-7f0fa99d97951a139f33ec44a19b323846e2dfb0edb6a59ea10b8060a5799c86\",\"quote\":\"You must request a new photograph if the photograph submitted does not meet the following requirements:\",\"start\":436},{\"end\":538,\"field\":\"logic_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A1a47a76c521a93dcac7e7e6d3fb8e2bcef821725a1aa174ee419d39827b0ff4a:436:538:sha256-c53915cf25eba82a14ee09d5e757c468bd6c10ccf5d9a9b71341baa440cd5764\",\"quote\":\"You must request a new photograph if the photograph submitted does not meet the following requirements\",\"start\":436},{\"end\":444,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A1a47a76c521a93dcac7e7e6d3fb8e2bcef821725a1aa174ee419d39827b0ff4a:440:444:sha256-4137b01e139589b7a1d3b3fc4da031d8ce5bb415808734e970c3a58ea0e98f0f\",\"quote\":\"must\",\"start\":440},{\"end\":539,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A1a47a76c521a93dcac7e7e6d3fb8e2bcef821725a1aa174ee419d39827b0ff4a:436:539:sha256-7f0fa99d97951a139f33ec44a19b323846e2dfb0edb6a59ea10b8060a5799c86\",\"quote\":\"You must request a new photograph if the photograph submitted does not meet the following requirements:\",\"start\":436},{\"end\":941,\"field\":\"context:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A1a47a76c521a93dcac7e7e6d3fb8e2bcef821725a1aa174ee419d39827b0ff4a:541:941:sha256-c1c4ed6a736c15eee6437947c8c3ba70feb1eb979f51fb8a13762f00c4a643aa\",\"quote\":\"(1) The photograph must be in color;\\n\\n(2) The photograph should be taken within six months of submitting the application, be a good likeness of and satisfactorily identify the applicant at the time of the application (see 22 CFR 51.26). A photograph showing a change in hairstyle or facial hair from the identification document submitted is acceptable if it still is a good likeness of the applicant;\",\"start\":541}],\"id\":\"urn:rulespec:document-understanding:revision:2fdefe8366ab891b4f475a1ee4f502264fcc59532c531785334364a379d0ac51\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"You must request a new photograph if the photograph submitted does not meet the following requirements\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:4deee661d68ee85838b4ce474be7aaf3338667ed7d5056187b6afbe92896c6b2\",\"modality\":\"must\",\"modality_quote\":\"must\",\
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:46ab202d0ac33882d78192f6dea12ba65025b045fdecd0d5a4a6fc220e8e4e4e\",\"urn:rulespec:document-understanding:assertion:8d8281bfd467e6118cf3505576b74601648e9d58f09a149971a4e49442b80573\",\"urn:rulespec:document-understanding:assertion:7a426fb713e14d14bc2ab3948ddbb446488aeeb2161fa54a4b75582ddaf11324\",\"urn:rulespec:document-understanding:assertion:fd5d457a6245fdd09fa037c9cfaaac71ed2f3bba3e50c741467f8ae72e271b46\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[\"You must request a new photograph if the photograph submitted does not meet the following requirements:\"],\"effective_periods\":[],\"end\":941,\"evidence\":[{\"end\":941,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A1a47a76c521a93dcac7e7e6d3fb8e2bcef821725a1aa174ee419d39827b0ff4a:579:941:sha256-b7b80f97588d13e2422c19992c15f3262fd999e2e3c0966b293b10977eb6bdd9\",\"quote\":\"(2) The photograph should be taken within six months of submitting the application, be a good likeness of and satisfactorily identify the applicant at the time of the application (see 22 CFR 51.26). A photograph showing a change in hairstyle or facial hair from the identification document submitted is acceptable if it still is a good likeness of the applicant;\",\"start\":579},{\"end\":757,\"field\":\"logic_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A1a47a76c521a93dcac7e7e6d3fb8e2bcef821725a1aa174ee419d39827b0ff4a:608:757:sha256-7aeac838d6b33bafea2958f6c4a68d26d4e954800ad750ceb3d787c89d4de319\",\"quote\":\"taken within six months of submitting the application, be a good likeness of and satisfactorily identify the applicant at the time of the application\",\"start\":608},{\"end\":604,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A1a47a76c521a93dcac7e7e6d3fb8e2bcef821725a1aa174ee419d39827b0ff4a:598:604:sha256-f86b1f62a8554232b940f4fd9c8d6601aae4767456df3d6cdff55a51f17b5075\",\"quote\":\"should\",\"start\":598},{\"end\":539,\"field\":\"context:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A1a47a76c521a93dcac7e7e6d3fb8e2bcef821725a1aa174ee419d39827b0ff4a:436:539:sha256-7f0fa99d97951a139f33ec44a19b323846e2dfb0edb6a59ea10b8060a5799c86\",\"quote\":\"You must request a new photograph if the photograph submitted does not meet the following requirements:\",\"start\":436}],\"id\":\"urn:rulespec:document-understanding:revision:302d6d5cd682bf5bdd22da92e8aae5bd4bc2b6e53955d75efd8e023c78bbf974\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"recommendation\",\"logic_text\":\"taken within six months of submitting the application, be a good likeness of and satisfactorily identify the applicant at the time of the application\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:fd5d457a6245fdd09fa037c9cfaaac71ed2f3bba3e50c741467f8ae72e271b46\",\"modality\":\"should\",\"modality_quote\":\"should\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:8cbd6eef5d2db7ea34228058b8b220a139cc7a2a1e3183acc2d3dfa4d27203ea\",\"origin\":\"aiSuggested\",\"quote\":\"(2) The photograph should be taken within six months of submitting the application, be a good likeness of and satisfactorily identify the applicant at the time of the application (see 22 CFR 51.26). A photograph showing a change in hairstyle or facial hair from the identification document submitted is acceptable if it still is a good likeness of the applicant;\",\"references\":[\"22 CFR 51.26\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:032ceb6a5b8fb49464d3c003bff6ab29604f5f42fe8d031b6ce9d2cb5cc7c04a\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":579,\"summary\":\"The photograph should be taken within six months of submitting the application, be a good likeness of, and satisfactorily identify the applicant at the time of the application.\",\"target_ids\":[],\"typed_values\":[]}",

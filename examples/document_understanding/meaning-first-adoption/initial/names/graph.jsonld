      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:afb740cc2613012a8b8e081ceded4f454ad19f3cd1384041f6968253bd8eef48\",\"urn:rulespec:document-understanding:assertion:07cd7d76938252b9cae82690027caf81dd1b88f77f2358aefef946ac0ba4cd92\",\"urn:rulespec:document-understanding:assertion:15234e4c0d2c0720e97b127457394893b6d0b9a3ded8e280ee29f01c3b8ce834\",\"urn:rulespec:document-understanding:assertion:47a21009f20e221a6df4c29260a9fa72048e67f6a4e3f7bd133aeeb4e0a440d4\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[\"d. The applicant's name is an integral part of her/his identity. Consequently, under 22 CFR 51.23(c), evidence of identity might be required in accordance with Department guidance to establish the name that best identifies the applicant:\"],\"effective_periods\":[],\"end\":2651,\"evidence\":[{\"end\":2651,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:2420:2651:sha256-778faf4d7d0d84cc0e664e40f572fe27b78123e9eca7cb4a31849d00058e3121\",\"quote\":\"(3) Applicants who have had a material name change within one year of applying on a form DS-11 do not need to submit ID in the new name. However, if the ID has not yet been changed, they must submit their name change documentation.\",\"start\":2420},{\"end\":2611,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:2607:2611:sha256-4137b01e139589b7a1d3b3fc4da031d8ce5bb415808734e970c3a58ea0e98f0f\",\"quote\":\"must\",\"start\":2607},{\"end\":2651,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:2420:2651:sha256-778faf4d7d0d84cc0e664e40f572fe27b78123e9eca7cb4a31849d00058e3121\",\"quote\":\"(3) Applicants who have had a material name change within one year of applying on a form DS-11 do not need to submit ID in the new name. However, if the ID has not yet been changed, they must submit their name change documentation.\",\"start\":2420},{\"end\":1670,\"field\":\"context:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:1433:1670:sha256-7fb835ed90fc315e25a5a9fafb4fd8b0f920d83c8e64fd1e2aa3da14a15e5930\",\"quote\":\"d. The applicant's name is an integral part of her/his identity. Consequently, under 22 CFR 51.23(c), evidence of identity might be required in accordance with Department guidance to establish the name that best identifies the applicant:\",\"start\":1433}],\"id\":\"urn:rulespec:document-understanding:revision:9f819aefb465ba30aa5b5bd6975861ddb2cf5a9aa8b3730db766729a3f602bea\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:47a21009f20e221a6df4c29260a9fa72048e67f6a4e3f7bd133aeeb4e0a440d4\",\"modality\":\"must\",\"modality_quote\":\"must\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:afd84b71ac163771530d5d33b88169aa83babff9e594cbaf0d3ce3f358ac4030\",\"origin\":\"aiSuggested\",\"quote\":\"(3) Applicants who have had a material name change within one year of applying on a form DS-11 do not need to submit ID in the new name. However, if the ID has not yet been changed, they must submit their name change documentation.\",\"references\":[\"form DS-11\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:c7f9e13ee3ef9fc3a1a23c58ede528fe9fe8a5873130e8f18350d007a51be5dc\",\"scope_quotes\":[\"(3) Applicants who have had a material name change within one year of applying on a form DS-11 do not need to submit ID in the new name. However, if the ID has not yet been changed, they must submit their name change documentation.\"],\"scope_text\":\"For applicants who have had a material name change within one year of applying on a form DS-11, if the ID has not yet been changed.\",\"section_id\":\"fam-names-section-4\",\"start\":2420,\"summary\":\"For applicants who have had a material name change within one year of applying on a form DS-11, if the ID has not yet been changed, they must submit their name change documentation.\",\"target_ids\":[],\"typed_values\":[]}",

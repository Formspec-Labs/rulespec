    {
      "@id": "urn:rulespec:document-understanding:assertion:aaa7e3a7c59ea3681ba67bcc9269a8eddb467c35f67f052e31aab1dc33902ad4",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:850f6e4f671a12a39a9ba5937bf87f3687035cee5fa6d6a563c73eebbd8f7f2b",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:4d1a1de70b067e905d2727ddeb98468876182ec8181c5b41216117ecb2169a1a",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:bcdd9a0920919b2b75e8b3810371914788c9e666e397962797b1013c0dc3aa04",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[\"(a) Name change orders; or\",\"(b) Divorce decrees;\",\"(2) Certificates of naturalization;\",\"(3) Marriage certificates;\",\"(4) Documentation demonstrating change of name by operation of state law; or\",\"(5) Documentation of customary usage.\"],\"choice_text\":\"Submission of one or more of the listed acceptable documents: (1) Court orders or decrees, consisting of (a) Name change orders or (b) Divorce decrees; (2) Certificates of naturalization; (3) Marriage certificates; (4) Documentation demonstrating change of name by operation of state law; or (5) Documentation of customary usage.\",\"claimants\":[],\"concepts\":[],\"effective_periods\":[],\"jurisdiction\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"modality\":\"must\",\"object\":\"\",\"scope_text\":\"When there are material discrepancies between the name recorded on the application, the applicant's evidence of U.S. citizenship/non-citizen U.S. nationality, or the evidence of identity, except for married names as provided in 8 FAM 403.1-4(C).\",\"summary\":\"Material discrepancies between the name recorded on the application, the applicant's evidence of U.S. citizenship/non-citizen U.S. nationality, or the evidence of identity must be documented by submission of one or more acceptable documents (subject to an exception for married names in 8 FAM 403.1-4(C)), which include court orders or decrees (name change orders or divorce decrees), certificates of naturalization, marriage certificates, documentation demonstrating change of name by operation of state law, or documentation of customary usage.\",\"typed_values\":[]}",
        "@type": "xsd:string"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed",
      "rkaf:hasApplicability": "urn:rulespec:document-understanding:scope:add2a7b0331a70d38fe45539c9296dd5b103ea5edaa73a26de175849a9827a3d"
    },

        "@value": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"effective_periods\":[],\"jurisdiction\":\"\",\"kind\":\"permission\",\"logic_text\":\"\",\"modality\":\"may\",\"object\":\"\",\"scope_text\":\"If the applicant has had a material name change more than one year prior to applying on form DS-11 but has not updated her/his ID to reflect the material name change, and there is insufficient time to request that the applicant submit acceptable ID prior to urgent or emergency travel.\",\"summary\":\"If the applicant had a material name change more than one year prior to applying on form DS-11 without updating her/his ID and there is insufficient time to request that the applicant submit acceptable ID prior to urgent or emergency travel, a limited-validity passport may be issued in the requested name.\",\"typed_values\":[]}",

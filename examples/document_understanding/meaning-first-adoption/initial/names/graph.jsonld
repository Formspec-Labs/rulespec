      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:62e87b5c4517e55d0b35b09813032897153ab0287bc80fd64e1182677c548b2d\",\"urn:rulespec:document-understanding:assertion:c4799b84a3a96af5a008530226d3efde1b998bdfdfdaa14d5c237dba769892fd\",\"urn:rulespec:document-understanding:assertion:af32aef116cbede790294870d141bd9c87a48de7d09e09aa5eb3a399c12ac1dd\",\"urn:rulespec:document-understanding:assertion:bba8fc517d13c198d4a513de96281e3be134ec61e30f8cd37af1c883f886cf77\",\"urn:rulespec:document-understanding:assertion:2b1868e4833a667eb5cf9b9f4dab16e394fc23d43f286edc8f60774763c25eb6\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[\"8 FAM 403.1-4 Material Discrepancies (Major name changes)\"],\"effective_periods\":[],\"end\":408,\"evidence\":[{\"end\":408,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:86:408:sha256-450017904294f49b3cb28fae632c76405891b5fe06c0954feb39962aaafd7151\",\"quote\":\"a. A material discrepancy is any name change that is not defined as immaterial in 8 FAM 403.1-5. The applicant must explain any material discrepancies between the name on the application and the name recorded in the evidence of U.S. citizenship/non-citizen U.S. nationality and the evidence of identity (see 22 CFR 51.25).\",\"start\":86},{\"end\":201,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:197:201:sha256-4137b01e139589b7a1d3b3fc4da031d8ce5bb415808734e970c3a58ea0e98f0f\",\"quote\":\"must\",\"start\":197},{\"end\":408,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:86:408:sha256-450017904294f49b3cb28fae632c76405891b5fe06c0954feb39962aaafd7151\",\"quote\":\"a. A material discrepancy is any name change that is not defined as immaterial in 8 FAM 403.1-5. The applicant must explain any material discrepancies between the name on the application and the name recorded in the evidence of U.S. citizenship/non-citizen U.S. nationality and the evidence of identity (see 22 CFR 51.25).\",\"start\":86},{\"end\":57,\"field\":\"context:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:0:57:sha256-f994cfb13f17663855bf1bbf52155c4f7a53836b3bbfee74289cf62a081c3821\",\"quote\":\"8 FAM 403.1-4 Material Discrepancies (Major name changes)\",\"start\":0}],\"id\":\"urn:rulespec:document-understanding:revision:767492c64b84c5906c875bce0872303da81754c1a5e1cf02d9e66025524c0273\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"and\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:2b1868e4833a667eb5cf9b9f4dab16e394fc23d43f286edc8f60774763c25eb6\",\"modality\":\"must\",\"modality_quote\":\"must\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:042242e6aed63eee6d37c04969408af218b064355317e529980369e8446d56f1\",\"origin\":\"aiSuggested\",\"quote\":\"a. A material discrepancy is any name change that is not defined as immaterial in 8 FAM 403.1-5. The applicant must explain any material discrepancies between the name on the application and the name recorded in the evidence of U.S. citizenship/non-citizen U.S. nationality and the evidence of identity (see 22 CFR 51.25).\",\"references\":[\"22 CFR 51.25\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:2c67b7337b69b5a7db7bff5d0aadb11331f12a09840fd78db8527f7525dfc10a\",\"scope_quotes\":[\"a. A material discrepancy is any name change that is not defined as immaterial in 8 FAM 403.1-5. The applicant must explain any material discrepancies between the name on the application and the name recorded in the evidence of U.S. citizenship/non-citizen U.S. nationality and the evidence of identity (see 22 CFR 51.25).\"],\"scope_text\":\"When there are material discrepancies between the name on the application and the name recorded in the evidence of U.S. citizenship/non-citizen U.S. nationality and the evidence of identity.\",\"section_id\":\"fam-names-section-4\",\"start\":86,\"summary\":\"The applicant must explain any material discrepancies between the name on the application and the name recorded in the evidence of U.S. citizenship/non-citizen U.S. nationality and the evidence of identity (see 22 CFR 51.25).\",\"target_ids\":[],\"typed_values\":[]}",

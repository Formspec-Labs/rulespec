      "@id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:1672:2103:sha256-a80eb4e1eddec9403c4f40ecea1e696a4799a061f2feeb00af71ab33871dd26a",

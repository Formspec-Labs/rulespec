      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:838b58503824de35f86ab9e4f96ec064fb7dd912338ee9c4e8c5a55637f6df36\",\"urn:rulespec:document-understanding:assertion:ac7fc21d44702f5ad0bb77c17cb7a2e2e6378aff82f1a92bbd9c139bc78527e3\",\"urn:rulespec:document-understanding:assertion:45578c70b17e4f7e7919a37db59c5be0f57e90f59fe9fbb2258a7d55e347ed23\",\"urn:rulespec:document-understanding:assertion:4d3b13a7baa2cae2adc2fe1609c0cd9079907e469acda519c8fc8b9a15ea4424\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[\"d. The applicant's name is an integral part of her/his identity. Consequently, under 22 CFR 51.23(c), evidence of identity might be required in accordance with Department guidance to establish the name that best identifies the applicant:\"],\"effective_periods\":[],\"end\":2418,\"evidence\":[{\"end\":2418,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:2105:2418:sha256-e69bf8f7a4a650b0a69e0c6b23e692e158a987e61a90b05520e03b1b65a57668\",\"quote\":\"(2) The applicant generally will need the name change documentation to change the name on her/his ID. You must fully notate the name change documentation prior to returning the documentation, including that the documentation was \\\"seen and returned,\\\" to the applicant with the information request letter (IRL); and\",\"start\":2105},{\"end\":2215,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:2211:2215:sha256-4137b01e139589b7a1d3b3fc4da031d8ce5bb415808734e970c3a58ea0e98f0f\",\"quote\":\"must\",\"start\":2211},{\"end\":2418,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:2105:2418:sha256-e69bf8f7a4a650b0a69e0c6b23e692e158a987e61a90b05520e03b1b65a57668\",\"quote\":\"(2) The applicant generally will need the name change documentation to change the name on her/his ID. You must fully notate the name change documentation prior to returning the documentation, including that the documentation was \\\"seen and returned,\\\" to the applicant with the information request letter (IRL); and\",\"start\":2105},{\"end\":1670,\"field\":\"context:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:1433:1670:sha256-7fb835ed90fc315e25a5a9fafb4fd8b0f920d83c8e64fd1e2aa3da14a15e5930\",\"quote\":\"d. The applicant's name is an integral part of her/his identity. Consequently, under 22 CFR 51.23(c), evidence of identity might be required in accordance with Department guidance to establish the name that best identifies the applicant:\",\"start\":1433}],\"id\":\"urn:rulespec:document-understanding:revision:dec1bdf20f7c9ef3e584bc9d6b62c3998c8e2fcafff6a88bd24d220825f5b841\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:4d3b13a7baa2cae2adc2fe1609c0cd9079907e469acda519c8fc8b9a15ea4424\",\"modality\":\"must\",\"modality_quote\":\"must\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:304eb612d07e1009cb13887e3d32f9f9eea32019ed22f5223c7f09d0032a232f\",\"origin\":\"aiSuggested\",\"quote\":\"(2) The applicant generally will need the name change documentation to change the name on her/his ID. You must fully notate the name change documentation prior to returning the documentation, including that the documentation was \\\"seen and returned,\\\" to the applicant with the information request letter (IRL); and\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:f23e407f015441aeb623cc69f9419863be8bb1d60f98d46080dbe5f89c5d03b2\",\"scope_quotes\":[\"(2) The applicant generally will need the name change documentation to change the name on her/his ID. You must fully notate the name change documentation prior to returning the documentation, including that the documentation was \\\"seen and returned,\\\" to the applicant with the information request letter (IRL); and\"],\"scope_text\":\"Prior to returning the name change documentation to the applicant with the information request letter (IRL).\",\"section_id\":\"fam-names-section-4\",\"start\":2105,\"summary\":\"You must fully notate the name change documentation prior to returning the documentation, including that the documentation was \\\"seen and returned,\\\" to the applicant with the information request letter (IRL).\",\"target_ids\":[],\"typed_values\":[]}",

      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:3071eead2b76fa54fe09cd9eb3efc292c31035804bdfdb4e40c467e0b38f901c\",\"urn:rulespec:document-understanding:assertion:37013282427bd8f1fa1f209e8cb56b81fc8180fe2092fd53ad844806e3b01123\",\"urn:rulespec:document-understanding:assertion:65057a0246d3f91ed7b56c41d7ac7a4c589247ac7f10c47bdd97a3f64cb007c6\",\"urn:rulespec:document-understanding:assertion:6d636b489897c6b45ab074c7748c4f25f9d4a0e6312b2839d4020858f1512165\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[\"d. The applicant's name is an integral part of her/his identity. Consequently, under 22 CFR 51.23(c), evidence of identity might be required in accordance with Department guidance to establish the name that best identifies the applicant:\"],\"effective_periods\":[],\"end\":2418,\"evidence\":[{\"end\":2418,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:2105:2418:sha256-e69bf8f7a4a650b0a69e0c6b23e692e158a987e61a90b05520e03b1b65a57668\",\"quote\":\"(2) The applicant generally will need the name change documentation to change the name on her/his ID. You must fully notate the name change documentation prior to returning the documentation, including that the documentation was \\\"seen and returned,\\\" to the applicant with the information request letter (IRL); and\",\"start\":2105},{\"end\":2137,\"field\":\"logic_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:2123:2137:sha256-f85a3e7a0a734d53b178f533209b8f915896d3e2b9431d6094f91cec44584baa\",\"quote\":\"generally will\",\"start\":2123},{\"end\":1670,\"field\":\"context:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:1433:1670:sha256-7fb835ed90fc315e25a5a9fafb4fd8b0f920d83c8e64fd1e2aa3da14a15e5930\",\"quote\":\"d. The applicant's name is an integral part of her/his identity. Consequently, under 22 CFR 51.23(c), evidence of identity might be required in accordance with Department guidance to establish the name that best identifies the applicant:\",\"start\":1433}],\"id\":\"urn:rulespec:document-understanding:revision:d0b0f6f6ec8795bc8b3a0f6cc14cf8bd708a8a4140ff3320f07bf6ef391ccbd2\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"statement\",\"logic_text\":\"generally will\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:6d636b489897c6b45ab074c7748c4f25f9d4a0e6312b2839d4020858f1512165\",\"modality\":\"not_stated\",\"modality_quote\":\"\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:b6d79871305c5f87251971e1f92c248b57e640d53677d69dcd6788705c3aa371\",\"origin\":\"aiSuggested\",\"quote\":\"(2) The applicant generally will need the name change documentation to change the name on her/his ID. You must fully notate the name change documentation prior to returning the documentation, including that the documentation was \\\"seen and returned,\\\" to the applicant with the information request letter (IRL); and\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:679fc2d58762e225818e99cc124031f0a47c740d02d4bd7093545082985d4a2f\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"fam-names-section-4\",\"start\":2105,\"summary\":\"The applicant generally will need the name change documentation to change the name on her/his ID.\",\"target_ids\":[],\"typed_values\":[]}",

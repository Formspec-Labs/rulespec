    {
      "@id": "urn:rulespec:document-understanding:revision:648092fe960496b59895c01b3f572e27d6eae483d19ae9bfddf07aa35104a17f",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:648092fe960496b59895c01b3f572e27d6eae483d19ae9bfddf07aa35104a17f",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:cd34e9d324ccf2966ee2901100711fc769a7f99a841dbf6b0f41ed94a02b2255",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[\"(a) Name change orders; or\",\"(b) Divorce decrees;\",\"(2) Certificates of naturalization;\",\"(3) Marriage certificates;\",\"(4) Documentation demonstrating change of name by operation of state law; or\",\"(5) Documentation of customary usage.\"],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:a5f7534cf89252dfa2818cd29ab47f66550ad989f5095ea90cb7189d1c759dce\",\"urn:rulespec:document-understanding:assertion:a09fe80ad256182d569eef8c7b32ceb234b51c47d061a722542b657164e44b4f\",\"urn:rulespec:document-understanding:assertion:74d0da18e15ec358e063d941c9b3a6ef097998dcbe3aa877932928c2503daeb1\",\"urn:rulespec:document-understanding:assertion:db0dc7f76b00fa016e976c2ea810646664cd747f819fcfa50cd4f781ea62fa39\",\"urn:rulespec:document-understanding:assertion:8318157e792c079d9e50fdc55aa012c702b7e8c5bf77dcfd7d5f2f779fb6c85f\",\"urn:rulespec:document-understanding:assertion:b2c71ede0670cd5639426a67cd6188b9c02e2b86947f8367a1faeb9ed36bc21e\",\"urn:rulespec:document-understanding:assertion:38627ed6683fd79ea1951926d3533d82bb64fb61c59d9a4a344a1da12e4e7a02\",\"urn:rulespec:document-understanding:assertion:a9edf2d3f4643521bace8901e33f98ceb934be7d96a2f9c451e9f225d158c20b\",\"urn:rulespec:document-understanding:assertion:dd805faea3c4959bc80cb6e9d69ff79e4eda14de97db885baaf2ad4f7ee05a33\",\"urn:rulespec:document-understanding:assertion:9b52141c7879aacf7de2497ca393b0f8f17e4a112bb00860be5793818c856a5b\",\"urn:rulespec:document-understanding:assertion:aaa7e3a7c59ea3681ba67bcc9269a8eddb467c35f67f052e31aab1dc33902ad4\"],\"choice_quote\":\"b. Material discrepancies between the name recorded on the application, the applicant's evidence of U.S. citizenship/non-citizen U.S. nationality, or the evidence of identity must be documented by submission of one or more of the documents listed in this section (see an exception for married names in 8 FAM 403.1-4(C)). Acceptable means of documenting a material name change include (per 22 CFR 51.25):\\n\\n(1) Court orders or decrees:\\n\\n(a) Name change orders; or\\n\\n(b) Divorce decrees;\\n\\n(2) Certificates of naturalization;\\n\\n(3) Marriage certificates;\\n\\n(4) Documentation demonstrating change of name by operation of state law; or\\n\\n(5) Documentation of customary usage.\",\"choice_text\":\"Submission of one or more of the listed acceptable documents: (1) Court orders or decrees, consisting of (a) Name change orders or (b) Divorce decrees; (2) Certificates of naturalization; (3) Marriage certificates; (4) Documentation demonstrating change of name by operation of state law; or (5) Documentation of customary usage.\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[\"8 FAM 403.1-4 Material Discrepancies (Major name changes)\"],\"effective_periods\":[],\"end\":1075,\"evidence\":[{\"end\":1075,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:410:1075:sha256-7e825b0281962427a00f89010fb8603561f586a6226e4b3fea4a1acf58abda10\",\"quote\":\"b. Material discrepancies between the name recorded on the application, the applicant's evidence of U.S. citizenship/non-citizen U.S. nationality, or the evidence of identity must be documented by submission of one or more of the documents listed in this section (see an exception for married names in 8 FAM 403.1-4(C)). Acceptable means of documenting a material name change include (per 22 CFR 51.25):\\n\\n(1) Court orders or decrees:\\n\\n(a) Name change orders; or\\n\\n(b) Divorce decrees;\\n\\n(2) Certificates of naturalization;\\n\\n(3) Marriage certificates;\\n\\n(4) Documentation demonstrating change of name by operation of state law; or\\n\\n(5) Documentation of customary usage.\",\"start\":410},{\"end\":589,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:585:589:sha256-4137b01e139589b7a1d3b3fc4da031d8ce5bb415808734e970c3a58ea0e98f0f\",\"quote\":\"must\",\"start\":585},{\"end\":1075,\"field\":\"choice_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:410:1075:sha256-7e825b0281962427a00f89010fb8603561f586a6226e4b3fea4a1acf58abda10\",\"quote\":\"b. Material discrepancies between the name recorded on the application, the applicant's evidence of U.S. citizenship/non-citizen U.S. nationality, or the evidence of identity must be documented by submission of one or more of the documents listed in this section (see an exception for married names in 8 FAM 403.1-4(C)). Acceptable means of documenting a material name change include (per 22 CFR 51.25):\\n\\n(1) Court orders or decrees:\\n\\n(a) Name change orders; or\\n\\n(b) Divorce decrees;\\n\\n(2) Certificates of naturalization;\\n\\n(3) Marriage certificates;\\n\\n(4) Documentation demonstrating change of name by operation of state law; or\\n\\n(5) Documentation of customary usage.\",\"start\":410},{\"end\":813,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:410:813:sha256-9f048c0d6748e3932976945d41d007630ad7abbd85290c4d208f919e8ca3f191\",\"quote\":\"b. Material discrepancies between the name recorded on the application, the applicant's evidence of U.S. citizenship/non-citizen U.S. nationality, or the evidence of identity must be documented by submission of one or more of the documents listed in this section (see an exception for married names in 8 FAM 403.1-4(C)). Acceptable means of documenting a material name change include (per 22 CFR 51.25):\",\"start\":410},{\"end\":57,\"field\":\"context:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:0:57:sha256-f994cfb13f17663855bf1bbf52155c4f7a53836b3bbfee74289cf62a081c3821\",\"quote\":\"8 FAM 403.1-4 Material Discrepancies (Major name changes)\",\"start\":0},{\"end\":871,\"field\":\"alternative:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:845:871:sha256-bb40a8f83843602388a43c18907ebb40aa0d6556d785704f74421ef19be9451e\",\"quote\":\"(a) Name change orders; or\",\"start\":845},{\"end\":893,\"field\":\"alternative:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:873:893:sha256-e0f1c6971d7165ebe9acb5aa4305dcd03dd8c5868762d1d06e2063a311a3c0fb\",\"quote\":\"(b) Divorce decrees;\",\"start\":873},{\"end\":930,\"field\":\"alternative:2\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:895:930:sha256-4e18e0787882e8309ae3622b09e55a5651877e9c53a350497910971ae7b678c2\",\"quote\":\"(2) Certificates of naturalization;\",\"start\":895},{\"end\":958,\"field\":\"alternative:3\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:932:958:sha256-e5cd8687a08df7afb024ac63f03ef7d3f67ae346933e9b1efe14a78515b76ad3\",\"quote\":\"(3) Marriage certificates;\",\"start\":932},{\"end\":1036,\"field\":\"alternative:4\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:960:1036:sha256-ae2aa14b1493569032e9e081d8f62feacfbdd7a24ce612d931ecbbeebb32c0f2\",\"quote\":\"(4) Documentation demonstrating change of name by operation of state law; or\",\"start\":960},{\"end\":1075,\"field\":\"alternative:5\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:1038:1075:sha256-94a68417342a7382810a40ae0bcea207f5efacf3def75383c8abe1a81fc0d9bc\",\"quote\":\"(5) Documentation of customary usage.\",\"start\":1038}],\"id\":\"urn:rulespec:document-understanding:revision:648092fe960496b59895c01b3f572e27d6eae483d19ae9bfddf07aa35104a17f\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:aaa7e3a7c59ea3681ba67bcc9269a8eddb467c35f67f052e31aab1dc33902ad4\",\"modality\":\"must\",\"modality_quote\":\"must\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:b0a6593a3f433c7b3eabf36d5dc86229a9300acf6e19ef829d2b8ece421d2764\",\"origin\":\"aiSuggested\",\"quote\":\"b. Material discrepancies between the name recorded on the application, the applicant's evidence of U.S. citizenship/non-citizen U.S. nationality, or the evidence of identity must be documented by submission of one or more of the documents listed in this section (see an exception for married names in 8 FAM 403.1-4(C)). Acceptable means of documenting a material name change include (per 22 CFR 51.25):\\n\\n(1) Court orders or decrees:\\n\\n(a) Name change orders; or\\n\\n(b) Divorce decrees;\\n\\n(2) Certificates of naturalization;\\n\\n(3) Marriage certificates;\\n\\n(4) Documentation demonstrating change of name by operation of state law; or\\n\\n(5) Documentation of customary usage.\",\"references\":[\"8 FAM 403.1-4(C)\",\"22 CFR 51.25\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:bcdd9a0920919b2b75e8b3810371914788c9e666e397962797b1013c0dc3aa04\",\"scope_quotes\":[\"b. Material discrepancies between the name recorded on the application, the applicant's evidence of U.S. citizenship/non-citizen U.S. nationality, or the evidence of identity must be documented by submission of one or more of the documents listed in this section (see an exception for married names in 8 FAM 403.1-4(C)). Acceptable means of documenting a material name change include (per 22 CFR 51.25):\"],\"scope_text\":\"When there are material discrepancies between the name recorded on the application, the applicant's evidence of U.S. citizenship/non-citizen U.S. nationality, or the evidence of identity, except for married names as provided in 8 FAM 403.1-4(C).\",\"section_id\":\"fam-names-section-4\",\"start\":410,\"summary\":\"Material discrepancies between the name recorded on the application, the applicant's evidence of U.S. citizenship/non-citizen U.S. nationality, or the evidence of identity must be documented by submission of one or more acceptable documents (subject to an exception for married names in 8 FAM 403.1-4(C)), which include court orders or decrees (name change orders or divorce decrees), certificates of naturalization, marriage certificates, documentation demonstrating change of name by operation of state law, or documentation of customary usage.\",\"target_ids\":[],\"typed_values\":[]}",

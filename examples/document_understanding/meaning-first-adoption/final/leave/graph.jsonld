      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:4b85437612da020b29c4158bd0d224e1b314e39426cd7a209f4b76d0ce82b72e",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:98901babf7987bf1c0120e91d1feb98ca73ffc3fb43e1ed9d7433facfe34e1f4",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:c000186262d7e095cdbd9045cd2c4a0d4d1176ab09635ce1acaa923b7e21a1d2",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:choice_text",
      "rkaf:assertsValue": {
        "@value": "All three criteria are required: (1) employed by the employer for at least 12 months, AND (2) employed for at least 1,250 hours of service during the 12-month period immediately preceding the commencement of the leave (subject to special hours of service requirements for airline flight crew employees under § 825.801), AND (3) employed at a worksite where 50 or more employees are employed by the employer within 75 miles of that worksite (referencing § 825.105(b) for employees working outside the U.S.).",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

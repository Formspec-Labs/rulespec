      "@id": "urn:rulespec:document-understanding:assertion:1c576f98c2853758ac5562c19fc1af1514b9e313749207bd3905db25f0793652",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:4b85437612da020b29c4158bd0d224e1b314e39426cd7a209f4b76d0ce82b72e",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:98901babf7987bf1c0120e91d1feb98ca73ffc3fb43e1ed9d7433facfe34e1f4",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:7b5b2e6975baf61e641be359ef857d012b45679b04dc6a1c7ec19e3ad3453e33",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:logic_text",
      "rkaf:assertsValue": {
        "@value": "(2) Employment periods preceding a break in service of more than seven years must be counted in determining whether the employee has been employed by the employer for at least 12 months where:\n\n(i) The employee's break in service is occasioned by the fulfillment of his or her Uniformed Services Employment and Reemployment Rights Act (USERRA), 38 U.S.C. 4301, et seq., covered service obligation. The period of absence from work due to or necessitated by USERRA-covered service must be also counted in determining whether the employee has been employed for at least 12 months by the employer. However, this section does not provide any greater entitlement to the employee than would be available under the USERRA; or\n\n(ii) A written agreement, including a collective bargaining agreement, exists concerning the employer's intention to rehire the employee after the break in service (e.g., for purposes of the employee furthering his or her education or for childrearing purposes).",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

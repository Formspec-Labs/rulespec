      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:states-requirement",
      "rkaf:assertsValue": {
        "@value": "Employment periods preceding a break in service of more than seven years must be counted in determining whether the employee has been employed by the employer for at least 12 months where: (i) the break in service is occasioned by the fulfillment of the employee's USERRA-covered service obligation, in which case the period of absence due to or necessitated by USERRA-covered service must also be counted (without providing any greater entitlement than available under USERRA); or (ii) a written agreement, including a collective bargaining agreement, exists concerning the employer's intention to rehire the employee after the break in service (such as for education or childrearing purposes).",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

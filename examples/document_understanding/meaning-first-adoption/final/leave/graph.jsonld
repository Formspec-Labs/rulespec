      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[\"(1) Has been employed by the employer for at least 12 months, and\",\"(2) Has been employed for at least 1,250 hours of service during the 12-month period immediately preceding the commencement of the leave ( see § 825.801 for special hours of service requirements for airline flight crew employees), and\",\"(3) Is employed at a worksite where 50 or more employees are employed by the employer within 75 miles of that worksite. See § 825.105(b) regarding employees who work outside the U.S.\"],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:398bf2e60fdc61ed5cb8ad615756a3473cfb6795be2ae30977bb2734074d7489\",\"urn:rulespec:document-understanding:assertion:08fdf67be6667f1934c8c1e6823bbc2429feb2fdb935e0999af7a6402bd292ec\",\"urn:rulespec:document-understanding:assertion:ce8a41c1623707d125caeba1660ad44a63bdd88134a45512a68c2ac259a9134b\",\"urn:rulespec:document-understanding:assertion:5d108cd3e246556e11164d81f1e79c49df97865ca88997ed8ca1c0e6ce1c998b\",\"urn:rulespec:document-understanding:assertion:7bf799ee5b0831f681de8828dd5cc3aa152fcf5e7300e78c269d650d89b5f6e1\",\"urn:rulespec:document-understanding:assertion:c2a9042514b25ebe3c2aebbe335ba27542c78b8cfdbbe97bfd931aa8529be6f5\",\"urn:rulespec:document-understanding:assertion:741e734ef28b2f73a9baed8aaf9061d706129ae51663b2f9358709c592e730d4\",\"urn:rulespec:document-understanding:assertion:559a1e1e5688370e3a15e0a655bffba8be79d487732a070d8860daf04316287b\",\"urn:rulespec:document-understanding:assertion:ef80c71c3de322e76cfbfa700d0bb4fb87cddbb17b51c2bd64bb3596711faa50\"],\"choice_quote\":\"(a) An eligible employee is an employee of a covered employer who:\\n\\n(1) Has been employed by the employer for at least 12 months, and\\n\\n(2) Has been employed for at least 1,250 hours of service during the 12-month period immediately preceding the commencement of the leave ( see § 825.801 for special hours of service requirements for airline flight crew employees), and\\n\\n(3) Is employed at a worksite where 50 or more employees are employed by the employer within 75 miles of that worksite. See § 825.105(b) regarding employees who work outside the U.S.\",\"choice_text\":\"All three criteria are required: (1) employed by the employer for at least 12 months, AND (2) employed for at least 1,250 hours of service during the 12-month period immediately preceding the commencement of the leave (subject to special hours of service requirements for airline flight crew employees under § 825.801), AND (3) employed at a worksite where 50 or more employees are employed by the employer within 75 miles of that worksite (referencing § 825.105(b) for employees working outside the U.S.).\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[\"29 CFR 825.110 — Eligible employee.\"],\"effective_periods\":[],\"end\":590,\"evidence\":[{\"end\":590,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A17e50019a4e77ab1a9c73c9fab8bd1b6da871d60b60c77790e8803a1d9920f62:37:590:sha256-e43d03081e43a5cd56466e06b1489af91ab5a4d901b3a2068f64e68e4fa8e5dd\",\"quote\":\"(a) An eligible employee is an employee of a covered employer who:\\n\\n(1) Has been employed by the employer for at least 12 months, and\\n\\n(2) Has been employed for at least 1,250 hours of service during the 12-month period immediately preceding the commencement of the leave ( see § 825.801 for special hours of service requirements for airline flight crew employees), and\\n\\n(3) Is employed at a worksite where 50 or more employees are employed by the employer within 75 miles of that worksite. See § 825.105(b) regarding employees who work outside the U.S.\",\"start\":37},{\"end\":590,\"field\":\"logic_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A17e50019a4e77ab1a9c73c9fab8bd1b6da871d60b60c77790e8803a1d9920f62:37:590:sha256-e43d03081e43a5cd56466e06b1489af91ab5a4d901b3a2068f64e68e4fa8e5dd\",\"quote\":\"(a) An eligible employee is an employee of a covered employer who:\\n\\n(1) Has been employed by the employer for at least 12 months, and\\n\\n(2) Has been employed for at least 1,250 hours of service during the 12-month period immediately preceding the commencement of the leave ( see § 825.801 for special hours of service requirements for airline flight crew employees), and\\n\\n(3) Is employed at a worksite where 50 or more employees are employed by the employer within 75 miles of that worksite. See § 825.105(b) regarding employees who work outside the U.S.\",\"start\":37},{\"end\":590,\"field\":\"choice_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A17e50019a4e77ab1a9c73c9fab8bd1b6da871d60b60c77790e8803a1d9920f62:37:590:sha256-e43d03081e43a5cd56466e06b1489af91ab5a4d901b3a2068f64e68e4fa8e5dd\",\"quote\":\"(a) An eligible employee is an employee of a covered employer who:\\n\\n(1) Has been employed by the employer for at least 12 months, and\\n\\n(2) Has been employed for at least 1,250 hours of service during the 12-month period immediately preceding the commencement of the leave ( see § 825.801 for special hours of service requirements for airline flight crew employees), and\\n\\n(3) Is employed at a worksite where 50 or more employees are employed by the employer within 75 miles of that worksite. See § 825.105(b) regarding employees who work outside the U.S.\",\"start\":37},{\"end\":103,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A17e50019a4e77ab1a9c73c9fab8bd1b6da871d60b60c77790e8803a1d9920f62:37:103:sha256-f65766fc8c1d9018ff7f6a685d59a802898d9b888c3de0a8c3c4756b5c8959a4\",\"quote\":\"(a) An eligible employee is an employee of a covered employer who:\",\"start\":37},{\"end\":35,\"field\":\"context:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A17e50019a4e77ab1a9c73c9fab8bd1b6da871d60b60c77790e8803a1d9920f62:0:35:sha256-cdba565171941ded4034f74b1980d94e626fe3b38491ebf5285ac9ba0f59d68b\",\"quote\":\"29 CFR 825.110 — Eligible employee.\",\"start\":0},{\"end\":170,\"field\":\"alternative:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A17e50019a4e77ab1a9c73c9fab8bd1b6da871d60b60c77790e8803a1d9920f62:105:170:sha256-65892c2f4a4b04b4af78de1dd2934ed6701e42ce507cd493e35ac4d9a1ba80b0\",\"quote\":\"(1) Has been employed by the employer for at least 12 months, and\",\"start\":105},{\"end\":406,\"field\":\"alternative:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A17e50019a4e77ab1a9c73c9fab8bd1b6da871d60b60c77790e8803a1d9920f62:172:406:sha256-f8c620c940dc57284f54426aad3bc219080834d541b71563d59c69ce9eeffe60\",\"quote\":\"(2) Has been employed for at least 1,250 hours of service during the 12-month period immediately preceding the commencement of the leave ( see § 825.801 for special hours of service requirements for airline flight crew employees), and\",\"start\":172},{\"end\":590,\"field\":\"alternative:2\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A17e50019a4e77ab1a9c73c9fab8bd1b6da871d60b60c77790e8803a1d9920f62:408:590:sha256-eb912ba3e3b8c4d1913a4740159f38d60c23793adb2467a188d1d44e8220b6ca\",\"quote\":\"(3) Is employed at a worksite where 50 or more employees are employed by the employer within 75 miles of that worksite. See § 825.105(b) regarding employees who work outside the U.S.\",\"start\":408}],\"id\":\"urn:rulespec:document-understanding:revision:1499e153f6c4205a2bdba4fe49700e614b3809324713fbb93f807b726ccdf106\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"definition\",\"logic_text\":\"(a) An eligible employee is an employee of a covered employer who:\\n\\n(1) Has been employed by the employer for at least 12 months, and\\n\\n(2) Has been employed for at least 1,250 hours of service during the 12-month period immediately preceding the commencement of the leave ( see § 825.801 for special hours of service requirements for airline flight crew employees), and\\n\\n(3) Is employed at a worksite where 50 or more employees are employed by the employer within 75 miles of that worksite. See § 825.105(b) regarding employees who work outside the U.S.\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:ef80c71c3de322e76cfbfa700d0bb4fb87cddbb17b51c2bd64bb3596711faa50\",\"modality\":\"not_stated\",\"modality_quote\":\"\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:9b65f6304ccbabe8cbb6bfcc51052eaf5e4ab0983155811bd5425fd0b0bb1d94\",\"origin\":\"aiSuggested\",\"quote\":\"(a) An eligible employee is an employee of a covered employer who:\\n\\n(1) Has been employed by the employer for at least 12 months, and\\n\\n(2) Has been employed for at least 1,250 hours of service during the 12-month period immediately preceding the commencement of the leave ( see § 825.801 for special hours of service requirements for airline flight crew employees), and\\n\\n(3) Is employed at a worksite where 50 or more employees are employed by the employer within 75 miles of that worksite. See § 825.105(b) regarding employees who work outside the U.S.\",\"references\":[\"§ 825.801\",\"§ 825.105(b)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:c000186262d7e095cdbd9045cd2c4a0d4d1176ab09635ce1acaa923b7e21a1d2\",\"scope_quotes\":[\"(a) An eligible employee is an employee of a covered employer who:\"],\"scope_text\":\"Applies to an employee of a covered employer for purposes of determining whether the employee is an eligible employee under 29 CFR 825.110.\",\"section_id\":\"section-1\",\"start\":37,\"summary\":\"An eligible employee is an employee of a covered employer who meets all three conditions: has been employed by the employer for at least 12 months; has been employed for at least 1,250 hours of service during the 12-month period immediately preceding the commencement of the leave (noting § 825.801 for airline flight crew employees); and is employed at a worksite where 50 or more employees are employed by the employer within 75 miles of that worksite (noting § 825.105(b) regarding employees working outside the U.S.).\",\"target_ids\":[],\"typed_values\":[]}",

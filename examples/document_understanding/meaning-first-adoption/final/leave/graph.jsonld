    {
      "@id": "urn:rulespec:document-understanding:revision:9eb335db4563c53a30c4a003737b5c9bc231194d7796995d926e59f1e496eaca",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:9eb335db4563c53a30c4a003737b5c9bc231194d7796995d926e59f1e496eaca",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:cd285890d4ad7e0b8f0b429c2f7e06705794a984ba1e200ad55bdaba8d691909",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:f7f7f0c81cf2e6917a7dcd577497f2cf6966d2f3807b61ade61ff85c75edfceb\",\"urn:rulespec:document-understanding:assertion:f948a7649e47133965303594e34f5e781f55813e7af240d39cf07c2c60a26cfa\",\"urn:rulespec:document-understanding:assertion:a27a8599f953eaa4eb19c01db4f498684b89444d05b798fef041ebd11a6f2a98\",\"urn:rulespec:document-understanding:assertion:32245474d47e59fbcc0a0c9406832399715837637977592ed852adf40daf240f\",\"urn:rulespec:document-understanding:assertion:756ae96f077125495093df415621f6ee380c84062239b7517663061416b6a295\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[\"(2) Employment periods preceding a break in service of more than seven years must be counted in determining whether the employee has been employed by the employer for at least 12 months where:\\n\\n(i) The employee's break in service is occasioned by the fulfillment of his or her Uniformed Services Employment and Reemployment Rights Act (USERRA), 38 U.S.C. 4301, et seq., covered service obligation. The period of absence from work due to or necessitated by USERRA-covered service must be also counted in determining whether the employee has been employed for at least 12 months by the employer. However, this section does not provide any greater entitlement to the employee than would be available under the USERRA; or\\n\\n(ii) A written agreement, including a collective bargaining agreement, exists concerning the employer's intention to rehire the employee after the break in service (e.g., for purposes of the employee furthering his or her education or for childrearing purposes).\"],\"effective_periods\":[],\"end\":963,\"evidence\":[{\"end\":963,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A17e50019a4e77ab1a9c73c9fab8bd1b6da871d60b60c77790e8803a1d9920f62:704:963:sha256-438c5644572a847c74d79f58c54f20e47ea923230c819e21bf4f8083396eaabc\",\"quote\":\"(1) Subject to the exceptions provided in paragraph (b)(2) of this section, employment periods prior to a break in service of seven years or more need not be counted in determining whether the employee has been employed by the employer for at least 12 months.\",\"start\":704},{\"end\":963,\"field\":\"logic_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A17e50019a4e77ab1a9c73c9fab8bd1b6da871d60b60c77790e8803a1d9920f62:704:963:sha256-438c5644572a847c74d79f58c54f20e47ea923230c819e21bf4f8083396eaabc\",\"quote\":\"(1) Subject to the exceptions provided in paragraph (b)(2) of this section, employment periods prior to a break in service of seven years or more need not be counted in determining whether the employee has been employed by the employer for at least 12 months.\",\"start\":704},{\"end\":861,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A17e50019a4e77ab1a9c73c9fab8bd1b6da871d60b60c77790e8803a1d9920f62:850:861:sha256-cb4bb7c381fd4736333e385ca9b908d9a0058aedb01871d9657a3447db3ba312\",\"quote\":\"need not be\",\"start\":850},{\"end\":702,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A17e50019a4e77ab1a9c73c9fab8bd1b6da871d60b60c77790e8803a1d9920f62:592:702:sha256-130832d94200d58087ab6a46024a3a10483b1b99086401c1b273635c4e31aaf3\",\"quote\":\"(b) The 12 months an employee must have been employed by the employer need not be consecutive months, provided\",\"start\":592},{\"end\":963,\"field\":\"scope_text:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A17e50019a4e77ab1a9c73c9fab8bd1b6da871d60b60c77790e8803a1d9920f62:704:963:sha256-438c5644572a847c74d79f58c54f20e47ea923230c819e21bf4f8083396eaabc\",\"quote\":\"(1) Subject to the exceptions provided in paragraph (b)(2) of this section, employment periods prior to a break in service of seven years or more need not be counted in determining whether the employee has been employed by the employer for at least 12 months.\",\"start\":704},{\"end\":1946,\"field\":\"context:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A17e50019a4e77ab1a9c73c9fab8bd1b6da871d60b60c77790e8803a1d9920f62:965:1946:sha256-44393cd9a380898a3a1acc3ba34a55b09730edf38e8b44fe99ff1f8768321518\",\"quote\":\"(2) Employment periods preceding a break in service of more than seven years must be counted in determining whether the employee has been employed by the employer for at least 12 months where:\\n\\n(i) The employee's break in service is occasioned by the fulfillment of his or her Uniformed Services Employment and Reemployment Rights Act (USERRA), 38 U.S.C. 4301, et seq., covered service obligation. The period of absence from work due to or necessitated by USERRA-covered service must be also counted in determining whether the employee has been employed for at least 12 months by the employer. However, this section does not provide any greater entitlement to the employee than would be available under the USERRA; or\\n\\n(ii) A written agreement, including a collective bargaining agreement, exists concerning the employer's intention to rehire the employee after the break in service (e.g., for purposes of the employee furthering his or her education or for childrearing purposes).\",\"start\":965}],\"id\":\"urn:rulespec:document-understanding:revision:9eb335db4563c53a30c4a003737b5c9bc231194d7796995d926e59f1e496eaca\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"exemption\",\"logic_text\":\"(1) Subject to the exceptions provided in paragraph (b)(2) of this section, employment periods prior to a break in service of seven years or more need not be counted in determining whether the employee has been employed by the employer for at least 12 months.\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:756ae96f077125495093df415621f6ee380c84062239b7517663061416b6a295\",\"modality\":\"not_required\",\"modality_quote\":\"need not be\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:a0363633d7e0cb29d3c54967ed6f76761fec9dbf02cd4c41c3d4e4b1fefdbb06\",\"origin\":\"aiSuggested\",\"quote\":\"(1) Subject to the exceptions provided in paragraph (b)(2) of this section, employment periods prior to a break in service of seven years or more need not be counted in determining whether the employee has been employed by the employer for at least 12 months.\",\"references\":[\"paragraph (b)(2)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:0321eeb7436bde8d11255cc3280fad120ca1e6d855f2b58382bdc2f70c3f4aaf\",\"scope_quotes\":[\"(b) The 12 months an employee must have been employed by the employer need not be consecutive months, provided\",\"(1) Subject to the exceptions provided in paragraph (b)(2) of this section, employment periods prior to a break in service of seven years or more need not be counted in determining whether the employee has been employed by the employer for at least 12 months.\"],\"scope_text\":\"In determining whether the employee has been employed by the employer for at least 12 months, subject to the exceptions provided in paragraph (b)(2).\",\"section_id\":\"section-1\",\"start\":704,\"summary\":\"Subject to the exceptions provided in paragraph (b)(2) of this section, employment periods prior to a break in service of seven years or more need not be counted in determining whether the employee has been employed by the employer for at least 12 months.\",\"target_ids\":[],\"typed_values\":[]}",

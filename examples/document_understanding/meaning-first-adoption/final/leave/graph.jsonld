    {
      "@id": "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A17e50019a4e77ab1a9c73c9fab8bd1b6da871d60b60c77790e8803a1d9920f62:662:673:sha256-cb4bb7c381fd4736333e385ca9b908d9a0058aedb01871d9657a3447db3ba312",

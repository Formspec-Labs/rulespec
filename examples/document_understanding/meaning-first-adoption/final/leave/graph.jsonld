      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:76f5df98d0228bad8369a0100dc5d4a0bae8385ba494c1877fe5ad493f57ea75\",\"urn:rulespec:document-understanding:assertion:12f6d712cc9635145032d94eb311e678a23a441f2045d2b522360afdae326942\",\"urn:rulespec:document-understanding:assertion:875ecc3df980dde07ae7449e8201effdfba2c34868714bcf785aceddf69364bb\",\"urn:rulespec:document-understanding:assertion:baf438046a9d4b38755c0546c822e4f5eea25109af040756156da92f59552d1a\",\"urn:rulespec:document-understanding:assertion:5e354252320315248e109c9f93fbbc2ff299160eb3043cc6ab7ae75d29fdfec6\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[\"(1) Subject to the exceptions provided in paragraph (b)(2) of this section, employment periods prior to a break in service of seven years or more need not be counted in determining whether the employee has been employed by the employer for at least 12 months.\"],\"effective_periods\":[],\"end\":2804,\"evidence\":[{\"end\":2804,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A17e50019a4e77ab1a9c73c9fab8bd1b6da871d60b60c77790e8803a1d9920f62:2419:2804:sha256-668999c51c74d480383126ed520172cea18a50cba1239cdc7337af5ed0e7a425\",\"quote\":\"(4) Nothing in this section prevents employers from considering employment prior to a continuous break in service of more than seven years when determining whether an employee has met the 12-month employment requirement. However, if an employer chooses to recognize such prior employment, the employer must do so uniformly, with respect to all employees with similar breaks in service.\",\"start\":2419},{\"end\":2804,\"field\":\"logic_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A17e50019a4e77ab1a9c73c9fab8bd1b6da871d60b60c77790e8803a1d9920f62:2419:2804:sha256-668999c51c74d480383126ed520172cea18a50cba1239cdc7337af5ed0e7a425\",\"quote\":\"(4) Nothing in this section prevents employers from considering employment prior to a continuous break in service of more than seven years when determining whether an employee has met the 12-month employment requirement. However, if an employer chooses to recognize such prior employment, the employer must do so uniformly, with respect to all employees with similar breaks in service.\",\"start\":2419},{\"end\":2455,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A17e50019a4e77ab1a9c73c9fab8bd1b6da871d60b60c77790e8803a1d9920f62:2423:2455:sha256-3a9c2af8fdcb26e636d6793af0ce395348b087e952d55ab41fdda4b0dcea513f\",\"quote\":\"Nothing in this section prevents\",\"start\":2423},{\"end\":702,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A17e50019a4e77ab1a9c73c9fab8bd1b6da871d60b60c77790e8803a1d9920f62:592:702:sha256-130832d94200d58087ab6a46024a3a10483b1b99086401c1b273635c4e31aaf3\",\"quote\":\"(b) The 12 months an employee must have been employed by the employer need not be consecutive months, provided\",\"start\":592},{\"end\":2804,\"field\":\"scope_text:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A17e50019a4e77ab1a9c73c9fab8bd1b6da871d60b60c77790e8803a1d9920f62:2419:2804:sha256-668999c51c74d480383126ed520172cea18a50cba1239cdc7337af5ed0e7a425\",\"quote\":\"(4) Nothing in this section prevents employers from considering employment prior to a continuous break in service of more than seven years when determining whether an employee has met the 12-month employment requirement. However, if an employer chooses to recognize such prior employment, the employer must do so uniformly, with respect to all employees with similar breaks in service.\",\"start\":2419},{\"end\":963,\"field\":\"context:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A17e50019a4e77ab1a9c73c9fab8bd1b6da871d60b60c77790e8803a1d9920f62:704:963:sha256-438c5644572a847c74d79f58c54f20e47ea923230c819e21bf4f8083396eaabc\",\"quote\":\"(1) Subject to the exceptions provided in paragraph (b)(2) of this section, employment periods prior to a break in service of seven years or more need not be counted in determining whether the employee has been employed by the employer for at least 12 months.\",\"start\":704}],\"id\":\"urn:rulespec:document-understanding:revision:b32e494e5df8d27a189eccf49301c7405afb57d87a488ec99883cf4d49d4febf\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"permission\",\"logic_text\":\"(4) Nothing in this section prevents employers from considering employment prior to a continuous break in service of more than seven years when determining whether an employee has met the 12-month employment requirement. However, if an employer chooses to recognize such prior employment, the employer must do so uniformly, with respect to all employees with similar breaks in service.\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:5e354252320315248e109c9f93fbbc2ff299160eb3043cc6ab7ae75d29fdfec6\",\"modality\":\"may\",\"modality_quote\":\"Nothing in this section prevents\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:05645f1d7237c80db518092d3f348ba17ee2baedce6c517bdf1bcd988697e1ff\",\"origin\":\"aiSuggested\",\"quote\":\"(4) Nothing in this section prevents employers from considering employment prior to a continuous break in service of more than seven years when determining whether an employee has met the 12-month employment requirement. However, if an employer chooses to recognize such prior employment, the employer must do so uniformly, with respect to all employees with similar breaks in service.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:f40cf400ab6a97a90e4a74b87231fc95b5497755128eed69b6ae9cb06a22c9d5\",\"scope_quotes\":[\"(b) The 12 months an employee must have been employed by the employer need not be consecutive months, provided\",\"(4) Nothing in this section prevents employers from considering employment prior to a continuous break in service of more than seven years when determining whether an employee has met the 12-month employment requirement. However, if an employer chooses to recognize such prior employment, the employer must do so uniformly, with respect to all employees with similar breaks in service.\"],\"scope_text\":\"When determining whether an employee has met the 12-month employment requirement following a continuous break in service of more than seven years.\",\"section_id\":\"section-1\",\"start\":2419,\"summary\":\"Nothing in this section prevents employers from considering employment prior to a continuous break in service of more than seven years when determining whether an employee has met the 12-month employment requirement.\",\"target_ids\":[],\"typed_values\":[]}",

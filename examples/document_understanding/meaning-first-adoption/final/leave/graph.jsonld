      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "(a) An eligible employee is an employee of a covered employer who:\n\n(1) Has been employed by the employer for at least 12 months, and"
        },
        {
          "@type": "oa:TextPositionSelector",
          "oa:start": 37,
          "oa:end": 170,
          "rkaf:coordinateSystem": "rkaf:unicode-codepoint"

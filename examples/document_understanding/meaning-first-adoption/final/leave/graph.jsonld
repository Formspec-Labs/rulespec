    {
      "@id": "urn:rulespec:document-understanding:scope:00794cf569abeeb2a635e2779202df96aeccf502a3b6a1388ae0ae9d067c90f3",
      "@type": "rkaf:ApplicabilityScope",
      "rkaf:appliesInJurisdiction": [],
      "rkaf:applicabilityCondition": "Applies to an employee of a covered employer for purposes of determining whether the employee is an eligible employee under 29 CFR 825.110."
    },
    {
      "@id": "urn:rulespec:document-understanding:assertion:398bf2e60fdc61ed5cb8ad615756a3473cfb6795be2ae30977bb2734074d7489",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:4b85437612da020b29c4158bd0d224e1b314e39426cd7a209f4b76d0ce82b72e",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:98901babf7987bf1c0120e91d1feb98ca73ffc3fb43e1ed9d7433facfe34e1f4",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:c000186262d7e095cdbd9045cd2c4a0d4d1176ab09635ce1acaa923b7e21a1d2",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:states-definition",
      "rkaf:assertsValue": {
        "@value": "An eligible employee is an employee of a covered employer who meets all three conditions: has been employed by the employer for at least 12 months; has been employed for at least 1,250 hours of service during the 12-month period immediately preceding the commencement of the leave (noting § 825.801 for airline flight crew employees); and is employed at a worksite where 50 or more employees are employed by the employer within 75 miles of that worksite (noting § 825.105(b) regarding employees working outside the U.S.).",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:98901babf7987bf1c0120e91d1feb98ca73ffc3fb43e1ed9d7433facfe34e1f4",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:c000186262d7e095cdbd9045cd2c4a0d4d1176ab09635ce1acaa923b7e21a1d2",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:alternative:2",
      "rkaf:assertsValue": {
        "@value": "(3) Is employed at a worksite where 50 or more employees are employed by the employer within 75 miles of that worksite. See § 825.105(b) regarding employees who work outside the U.S.",

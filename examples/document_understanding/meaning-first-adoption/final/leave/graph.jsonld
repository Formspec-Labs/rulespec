    {
      "@id": "urn:rulespec:document-understanding:revision:228342d740946147313dced718246af379930b43dd9f504823133497d70441ad",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:228342d740946147313dced718246af379930b43dd9f504823133497d70441ad",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:0bd5d8e8404d220ce7536e49874aa5f8f48ee3ac8c06a2a86e302fc88eb2de1c",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:e1ddba0205c2b89f30b727333513a7b46492b1ab7e3804fad57dbf9e736d5f24\",\"urn:rulespec:document-understanding:assertion:cfe309b7682e0d320533c517fc303b033df1c403affca5d490b4e1c5c191f726\",\"urn:rulespec:document-understanding:assertion:86de9edd67e91afa745195872b0a89f14fd9e59ca2b666de9e3177af017bb674\",\"urn:rulespec:document-understanding:assertion:aea95355f45663c6bd9fd1090b539438a685461024e023cd91b32e09a2fb9053\",\"urn:rulespec:document-understanding:assertion:b012102a22c6eec7bae70ae55280b00273421c62c5e72f528839fabdbc0ad9e8\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[\"(1) Subject to the exceptions provided in paragraph (b)(2) of this section, employment periods prior to a break in service of seven years or more need not be counted in determining whether the employee has been employed by the employer for at least 12 months.\\n\\n(2) Employment periods preceding a break in service of more than seven years must be counted in determining whether the employee has been employed by the employer for at least 12 months where:\\n\\n(i) The employee's break in service is occasioned by the fulfillment of his or her Uniformed Services Employment and Reemployment Rights Act (USERRA), 38 U.S.C. 4301, et seq., covered service obligation. The period of absence from work due to or necessitated by USERRA-covered service must be also counted in determining whether the employee has been employed for at least 12 months by the employer. However, this section does not provide any greater entitlement to the employee than would be available under the USERRA; or\\n\\n(ii) A written agreement, including a collective bargaining agreement, exists concerning the employer's intention to rehire the employee after the break in service (e.g., for purposes of the employee furthering his or her education or for childrearing purposes).\"],\"effective_periods\":[],\"end\":702,\"evidence\":[{\"end\":702,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A17e50019a4e77ab1a9c73c9fab8bd1b6da871d60b60c77790e8803a1d9920f62:592:702:sha256-130832d94200d58087ab6a46024a3a10483b1b99086401c1b273635c4e31aaf3\",\"quote\":\"(b) The 12 months an employee must have been employed by the employer need not be consecutive months, provided\",\"start\":592},{\"end\":702,\"field\":\"logic_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A17e50019a4e77ab1a9c73c9fab8bd1b6da871d60b60c77790e8803a1d9920f62:592:702:sha256-130832d94200d58087ab6a46024a3a10483b1b99086401c1b273635c4e31aaf3\",\"quote\":\"(b) The 12 months an employee must have been employed by the employer need not be consecutive months, provided\",\"start\":592},{\"end\":673,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A17e50019a4e77ab1a9c73c9fab8bd1b6da871d60b60c77790e8803a1d9920f62:662:673:sha256-cb4bb7c381fd4736333e385ca9b908d9a0058aedb01871d9657a3447db3ba312\",\"quote\":\"need not be\",\"start\":662},{\"end\":103,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A17e50019a4e77ab1a9c73c9fab8bd1b6da871d60b60c77790e8803a1d9920f62:37:103:sha256-f65766fc8c1d9018ff7f6a685d59a802898d9b888c3de0a8c3c4756b5c8959a4\",\"quote\":\"(a) An eligible employee is an employee of a covered employer who:\",\"start\":37},{\"end\":170,\"field\":\"scope_text:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A17e50019a4e77ab1a9c73c9fab8bd1b6da871d60b60c77790e8803a1d9920f62:105:170:sha256-65892c2f4a4b04b4af78de1dd2934ed6701e42ce507cd493e35ac4d9a1ba80b0\",\"quote\":\"(1) Has been employed by the employer for at least 12 months, and\",\"start\":105},{\"end\":702,\"field\":\"scope_text:2\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A17e50019a4e77ab1a9c73c9fab8bd1b6da871d60b60c77790e8803a1d9920f62:592:702:sha256-130832d94200d58087ab6a46024a3a10483b1b99086401c1b273635c4e31aaf3\",\"quote\":\"(b) The 12 months an employee must have been employed by the employer need not be consecutive months, provided\",\"start\":592},{\"end\":1946,\"field\":\"context:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A17e50019a4e77ab1a9c73c9fab8bd1b6da871d60b60c77790e8803a1d9920f62:704:1946:sha256-b1d9796e677a08e4482d718189c5f4da5471bdb60c5eeb17662168cd3efebbd2\",\"quote\":\"(1) Subject to the exceptions provided in paragraph (b)(2) of this section, employment periods prior to a break in service of seven years or more need not be counted in determining whether the employee has been employed by the employer for at least 12 months.\\n\\n(2) Employment periods preceding a break in service of more than seven years must be counted in determining whether the employee has been employed by the employer for at least 12 months where:\\n\\n(i) The employee's break in service is occasioned by the fulfillment of his or her Uniformed Services Employment and Reemployment Rights Act (USERRA), 38 U.S.C. 4301, et seq., covered service obligation. The period of absence from work due to or necessitated by USERRA-covered service must be also counted in determining whether the employee has been employed for at least 12 months by the employer. However, this section does not provide any greater entitlement to the employee than would be available under the USERRA; or\\n\\n(ii) A written agreement, including a collective bargaining agreement, exists concerning the employer's intention to rehire the employee after the break in service (e.g., for purposes of the employee furthering his or her education or for childrearing purposes).\",\"start\":704}],\"id\":\"urn:rulespec:document-understanding:revision:228342d740946147313dced718246af379930b43dd9f504823133497d70441ad\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"exemption\",\"logic_text\":\"(b) The 12 months an employee must have been employed by the employer need not be consecutive months, provided\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:b012102a22c6eec7bae70ae55280b00273421c62c5e72f528839fabdbc0ad9e8\",\"modality\":\"not_required\",\"modality_quote\":\"need not be\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:d7c4aab6b247718f7b9b9d437d9c02ccc1306e1a9b075917db621b87d4f9dcaa\",\"origin\":\"aiSuggested\",\"quote\":\"(b) The 12 months an employee must have been employed by the employer need not be consecutive months, provided\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:cd9bdce79fd6a12686183438a48e510f129fa962ea28ca45c8407e8360a3b416\",\"scope_quotes\":[\"(a) An eligible employee is an employee of a covered employer who:\",\"(1) Has been employed by the employer for at least 12 months, and\",\"(b) The 12 months an employee must have been employed by the employer need not be consecutive months, provided\"],\"scope_text\":\"Applies when determining whether an employee has met the requirement to have been employed by the employer for at least 12 months.\",\"section_id\":\"section-1\",\"start\":592,\"summary\":\"The 12 months an employee must have been employed by the employer need not be consecutive months, provided that the governing rules in 29 CFR 825.110(b) are met.\",\"target_ids\":[],\"typed_values\":[]}",
      "dcterms:references": [

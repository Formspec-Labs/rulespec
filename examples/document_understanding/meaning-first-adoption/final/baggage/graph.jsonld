    {
      "@id": "urn:rulespec:document-understanding:revision:155868b595fa578c85f23e442ecb52d2e350e2720ae55bfc9c63955a5473c3e0",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:155868b595fa578c85f23e442ecb52d2e350e2720ae55bfc9c63955a5473c3e0",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",

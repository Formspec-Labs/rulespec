      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[\"(d) Ammunition. This section does not prohibit the carriage of ammunition in checked baggage or in the same container as a firearm. Title 49 CFR part 175 provides additional requirements governing carriage of ammunition on aircraft.\"],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:6f68ee684c0ddcea178949a9f30ce3b95fb8999dcd49b0a246a8cc674eb9e0ea\",\"urn:rulespec:document-understanding:assertion:ee6613f9d1a2187a14474d514fe3cf3814f78923b31455c13ce82fa92a4089f1\",\"urn:rulespec:document-understanding:assertion:64c136db41f2278a09ab9899d09e4df83606efb3446ab49259abcf613d359212\",\"urn:rulespec:document-understanding:assertion:ed3e5200150369611a3d5783b0c9699a6ceceefb05519f3b987508257230d328\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[\"(d) Ammunition. This section does not prohibit the carriage of ammunition in checked baggage or in the same container as a firearm. Title 49 CFR part 175 provides additional requirements governing carriage of ammunition on aircraft.\"],\"effective_periods\":[],\"end\":2291,\"evidence\":[{\"end\":2291,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aab45ff8a7d213a548ba64b9bd9efdd9202dcd2f94cc0c1045a1b5fb69fe86460:2059:2291:sha256-a31581aba563017ba66278b6c67ef76bae96945bec1063ae465670c6bcc41d4a\",\"quote\":\"(d) Ammunition. This section does not prohibit the carriage of ammunition in checked baggage or in the same container as a firearm. Title 49 CFR part 175 provides additional requirements governing carriage of ammunition on aircraft.\",\"start\":2059},{\"end\":2105,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aab45ff8a7d213a548ba64b9bd9efdd9202dcd2f94cc0c1045a1b5fb69fe86460:2088:2105:sha256-d37f1b3411738f35d2f9e0d1ec9dfcc353c624367c0e413d025135b13dae3a2c\",\"quote\":\"does not prohibit\",\"start\":2088},{\"end\":2291,\"field\":\"context:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aab45ff8a7d213a548ba64b9bd9efdd9202dcd2f94cc0c1045a1b5fb69fe86460:2059:2291:sha256-a31581aba563017ba66278b6c67ef76bae96945bec1063ae465670c6bcc41d4a\",\"quote\":\"(d) Ammunition. This section does not prohibit the carriage of ammunition in checked baggage or in the same container as a firearm. Title 49 CFR part 175 provides additional requirements governing carriage of ammunition on aircraft.\",\"start\":2059},{\"end\":2291,\"field\":\"alternative:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aab45ff8a7d213a548ba64b9bd9efdd9202dcd2f94cc0c1045a1b5fb69fe86460:2059:2291:sha256-a31581aba563017ba66278b6c67ef76bae96945bec1063ae465670c6bcc41d4a\",\"quote\":\"(d) Ammunition. This section does not prohibit the carriage of ammunition in checked baggage or in the same container as a firearm. Title 49 CFR part 175 provides additional requirements governing carriage of ammunition on aircraft.\",\"start\":2059}],\"id\":\"urn:rulespec:document-understanding:revision:fb6b254fbe4a888a38c3b82242ce41b51bb519f50cba186d34553245c432d2ad\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"exemption\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:ed3e5200150369611a3d5783b0c9699a6ceceefb05519f3b987508257230d328\",\"modality\":\"not_required\",\"modality_quote\":\"does not prohibit\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:778ed3185f90de24a14dacc610abd3cef023bfea610dba36713dcb4d54d87f76\",\"origin\":\"aiSuggested\",\"quote\":\"(d) Ammunition. This section does not prohibit the carriage of ammunition in checked baggage or in the same container as a firearm. Title 49 CFR part 175 provides additional requirements governing carriage of ammunition on aircraft.\",\"references\":[\"Title 49 CFR part 175\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:6e403e32ced10dd17c8be0fc7f3fb470416cf5f0e4431e012fba1e741572833c\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":2059,\"summary\":\"This section does not prohibit the carriage of ammunition in checked baggage or in the same container as a firearm, while Title 49 CFR part 175 provides additional requirements governing carriage of ammunition on aircraft.\",\"target_ids\":[],\"typed_values\":[]}",

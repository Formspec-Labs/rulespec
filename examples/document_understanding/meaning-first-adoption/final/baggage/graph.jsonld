      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:alternative:2",
      "rkaf:assertsValue": {
        "@value": "(3) When the individual is attempting to board or onboard an aircraft for which screening is conducted under §§ 1544.201, 1546.201, or 1562.23 of this chapter.",

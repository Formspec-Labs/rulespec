    {
      "@id": "urn:rulespec:document-understanding:scope:22216a3a93859185a9b04d312a9b634ab96b2be2e787d5f40526fcba06f26c37",
      "@type": "rkaf:ApplicabilityScope",
      "rkaf:appliesInJurisdiction": [],
      "rkaf:applicabilityCondition": "In checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter, unless all four conditions are met: (i) passenger declares to the aircraft operator orally or in writing before checking baggage that the bag contains an unloaded firearm; (ii) the firearm is unloaded; (iii) the firearm is carried in a hard-sided container; and (iv) the container is locked and only the passenger retains the key or combination."
    },
    {
      "@id": "urn:rulespec:document-understanding:assertion:41b40dc0d4bff820986ef5ccc9216bc9564fa0290a5ae06fed58a1c564b6fc15",

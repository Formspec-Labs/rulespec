      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:126cb18edb445af7bd1681f6b4f8763cedf389caa8eba0a007b9bebf242c694a",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:e3193f198401ab2507a5e1b4f2e52bba1d492db1fe47aaf64ec59d3a813ac53f",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:6de0047d4e3329c466681eebaf67b58a9d033c6f455ce29f24be56ccf89886d3",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:choice_text",
      "rkaf:assertsValue": {
        "@value": "All of the following must be met: (i) The passenger declares to the aircraft operator, either orally or in writing, before checking the baggage, that the passenger has a firearm in his or her bag and that it is unloaded; AND (ii) The firearm is unloaded; AND (iii) The firearm is carried in a hard-sided container; AND (iv) The container in which it is carried is locked, and only the passenger retains the key or combination.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:126cb18edb445af7bd1681f6b4f8763cedf389caa8eba0a007b9bebf242c694a",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:e3193f198401ab2507a5e1b4f2e52bba1d492db1fe47aaf64ec59d3a813ac53f",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:6de0047d4e3329c466681eebaf67b58a9d033c6f455ce29f24be56ccf89886d3",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:scope_text",
      "rkaf:assertsValue": {
        "@value": "In checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter, unless all four conditions are met: (i) passenger declares to the aircraft operator orally or in writing before checking baggage that the bag contains an unloaded firearm; (ii) the firearm is unloaded; (iii) the firearm is carried in a hard-sided container; and (iv) the container is locked and only the passenger retains the key or combination.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },
    {
      "@id": "urn:rulespec:document-understanding:binding:35e98430c86a2d23c7f5279bc688181f58f40e3d4b92d70844ce938fd4f0c2fc",
      "@type": "rkaf:EvidenceBinding",
      "rkaf:bindsAssertion": "urn:rulespec:document-understanding:assertion:b71be6c591060b2c8f36c0cc743ecd9d0d5b9c22eba986c1a9c4ba7822dd93e3",
      "rkaf:evidenceRole": "rkaf:textualEvidence",
      "rkaf:evidentiaryFunction": "rkaf:supports",
      "rkaf:bindsSourceFragment": [
        "urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aab45ff8a7d213a548ba64b9bd9efdd9202dcd2f94cc0c1045a1b5fb69fe86460:1376:1556:sha256-9dd5c9d0feb251838bff5c1a16b3c099ef083ecc7b0fca10625f4c8d5699fdf1",

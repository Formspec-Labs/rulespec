    {
      "@id": "urn:rulespec:document-understanding:assertion:f233aaa0e2b1ad958973d18a0bf7b6f8722c5fc2d4687d18f568f4ec7253fb37",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:126cb18edb445af7bd1681f6b4f8763cedf389caa8eba0a007b9bebf242c694a",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:e3193f198401ab2507a5e1b4f2e52bba1d492db1fe47aaf64ec59d3a813ac53f",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:6de0047d4e3329c466681eebaf67b58a9d033c6f455ce29f24be56ccf89886d3",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[\"(i) The passenger declares to the aircraft operator, either orally or in writing, before checking the baggage, that the passenger has a firearm in his or her bag and that it is unloaded;\",\"(ii) The firearm is unloaded;\",\"(iii) The firearm is carried in a hard-sided container; and\",\"(iv) The container in which it is carried is locked, and only the passenger retains the key or combination.\"],\"choice_text\":\"All of the following must be met: (i) The passenger declares to the aircraft operator, either orally or in writing, before checking the baggage, that the passenger has a firearm in his or her bag and that it is unloaded; AND (ii) The firearm is unloaded; AND (iii) The firearm is carried in a hard-sided container; AND (iv) The container in which it is carried is locked, and only the passenger retains the key or combination.\",\"claimants\":[],\"concepts\":[],\"effective_periods\":[],\"jurisdiction\":\"\",\"kind\":\"prohibition\",\"logic_text\":\"(2) Any unloaded firearm(s) unless—\",\"modality\":\"must_not\",\"object\":\"\",\"scope_text\":\"In checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter, unless all four conditions are met: (i) passenger declares to the aircraft operator orally or in writing before checking baggage that the bag contains an unloaded firearm; (ii) the firearm is unloaded; (iii) the firearm is carried in a hard-sided container; and (iv) the container is locked and only the passenger retains the key or combination.\",\"summary\":\"A passenger may not transport or offer for transport in checked baggage or in baggage carried in an inaccessible cargo hold under § 1562.23 of this chapter any unloaded firearm(s) unless the passenger declares it orally or in writing before checking baggage, the firearm is unloaded, it is carried in a hard-sided container, and the container is locked with only the passenger retaining the key or combination.\",\"typed_values\":[]}",
        "@type": "xsd:string"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed",
      "rkaf:hasApplicability": "urn:rulespec:document-understanding:scope:22216a3a93859185a9b04d312a9b634ab96b2be2e787d5f40526fcba06f26c37"
    },

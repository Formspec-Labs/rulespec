      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:d128f99886a6cee1329784dea0aa3a9deddbabffa0d52edbd7f99c36897db9da\",\"urn:rulespec:document-understanding:assertion:4d0e7acbc75b5c4c91d78e6ba001bffa973ef27582535fa84f6219712a824016\",\"urn:rulespec:document-understanding:assertion:9bdc1ba714bc41ec0960812442340ebd5d7556c2c11a989b40089d01dc49c10d\",\"urn:rulespec:document-understanding:assertion:76e22522ed2cc37adbe469b6f9ff2219b87fee703a0c3691ad05462368e4a8ce\",\"urn:rulespec:document-understanding:assertion:9774a0b589b6c7bb3484b24a5def58653635093f9e78edb53e05ec802c7e6ce3\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[\"(1) The photograph must be in color;\\n\\n(2) The photograph should be taken within six months of submitting the application, be a good likeness of and satisfactorily identify the applicant at the time of the application (see 22 CFR 51.26). A photograph showing a change in hairstyle or facial hair from the identification document submitted is acceptable if it still is a good likeness of the applicant;\"],\"effective_periods\":[],\"end\":539,\"evidence\":[{\"end\":539,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A1a47a76c521a93dcac7e7e6d3fb8e2bcef821725a1aa174ee419d39827b0ff4a:436:539:sha256-7f0fa99d97951a139f33ec44a19b323846e2dfb0edb6a59ea10b8060a5799c86\",\"quote\":\"You must request a new photograph if the photograph submitted does not meet the following requirements:\",\"start\":436},{\"end\":539,\"field\":\"logic_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A1a47a76c521a93dcac7e7e6d3fb8e2bcef821725a1aa174ee419d39827b0ff4a:436:539:sha256-7f0fa99d97951a139f33ec44a19b323846e2dfb0edb6a59ea10b8060a5799c86\",\"quote\":\"You must request a new photograph if the photograph submitted does not meet the following requirements:\",\"start\":436},{\"end\":444,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A1a47a76c521a93dcac7e7e6d3fb8e2bcef821725a1aa174ee419d39827b0ff4a:440:444:sha256-4137b01e139589b7a1d3b3fc4da031d8ce5bb415808734e970c3a58ea0e98f0f\",\"quote\":\"must\",\"start\":440},{\"end\":539,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A1a47a76c521a93dcac7e7e6d3fb8e2bcef821725a1aa174ee419d39827b0ff4a:436:539:sha256-7f0fa99d97951a139f33ec44a19b323846e2dfb0edb6a59ea10b8060a5799c86\",\"quote\":\"You must request a new photograph if the photograph submitted does not meet the following requirements:\",\"start\":436},{\"end\":941,\"field\":\"context:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A1a47a76c521a93dcac7e7e6d3fb8e2bcef821725a1aa174ee419d39827b0ff4a:541:941:sha256-c1c4ed6a736c15eee6437947c8c3ba70feb1eb979f51fb8a13762f00c4a643aa\",\"quote\":\"(1) The photograph must be in color;\\n\\n(2) The photograph should be taken within six months of submitting the application, be a good likeness of and satisfactorily identify the applicant at the time of the application (see 22 CFR 51.26). A photograph showing a change in hairstyle or facial hair from the identification document submitted is acceptable if it still is a good likeness of the applicant;\",\"start\":541}],\"id\":\"urn:rulespec:document-understanding:revision:5f4a8094a636c2a78e62d474c18cc0fa7f0647373f3611c292da45df22b9a48a\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"You must request a new photograph if the photograph submitted does not meet the following requirements:\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:9774a0b589b6c7bb3484b24a5def58653635093f9e78edb53e05ec802c7e6ce3\",\"modality\":\"must\",\"modality_quote\":\"must\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:f91277337400e9be423e72529dacfaa8e0a27cfb9428869ed2d4388fe2e32987\",\"origin\":\"aiSuggested\",\"quote\":\"You must request a new photograph if the photograph submitted does not meet the following requirements:\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:2efa0a503409d3c54c62368b591833c54a69327045ce0b4aa360806f31783549\",\"scope_quotes\":[\"You must request a new photograph if the photograph submitted does not meet the following requirements:\"],\"scope_text\":\"If the photograph submitted does not meet the specified requirements:\",\"section_id\":\"section-1\",\"start\":436,\"summary\":\"You must request a new photograph if the submitted photograph does not meet the requirements.\",\"target_ids\":[],\"typed_values\":[]}",

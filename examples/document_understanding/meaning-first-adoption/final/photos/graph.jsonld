    {
      "@id": "urn:rulespec:document-understanding:revision:5f4a8094a636c2a78e62d474c18cc0fa7f0647373f3611c292da45df22b9a48a",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:5f4a8094a636c2a78e62d474c18cc0fa7f0647373f3611c292da45df22b9a48a",

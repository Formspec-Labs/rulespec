      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:7527194aed150d1613548e45fd492c06b5b6fc1666315a8374d5fabc6be70dec",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:3e8da8d07e7b7a44c6ca2deae517159457ec4464b1852d906754d25eaeeb7d5d",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:77d5d31ea7d4c0bd13d6e1f7386f6a840586063f793fef99b5658a6741ad9b03",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[\"(a) Name change orders; or\",\"(b) Divorce decrees;\",\"(2) Certificates of naturalization;\",\"(3) Marriage certificates;\",\"(4) Documentation demonstrating change of name by operation of state law; or\",\"(5) Documentation of customary usage.\"],\"choice_text\":\"One or more of the following: (1) Court orders or decrees: (a) Name change orders, or (b) Divorce decrees; (2) Certificates of naturalization; (3) Marriage certificates; (4) Documentation demonstrating change of name by operation of state law; or (5) Documentation of customary usage.\",\"claimants\":[],\"concepts\":[],\"effective_periods\":[],\"jurisdiction\":\"\",\"kind\":\"requirement\",\"logic_text\":\"b. Material discrepancies between the name recorded on the application, the applicant's evidence of U.S. citizenship/non-citizen U.S. nationality, or the evidence of identity must be documented by submission of one or more of the documents listed in this section (see an exception for married names in 8 FAM 403.1-4(C)). Acceptable means of documenting a material name change include (per 22 CFR 51.25):\",\"modality\":\"must\",\"object\":\"\",\"scope_text\":\"When there are material discrepancies between the name recorded on the application, the applicant's evidence of U.S. citizenship/non-citizen U.S. nationality, or the evidence of identity, except for married names as provided in 8 FAM 403.1-4(C).\",\"summary\":\"Material discrepancies between the name recorded on the application, the applicant's evidence of U.S. citizenship/non-citizen U.S. nationality, or the evidence of identity must be documented by submission of one or more acceptable documents (court orders or decrees such as name change orders or divorce decrees; certificates of naturalization; marriage certificates; documentation demonstrating change of name by operation of state law; or documentation of customary usage), except for married names under 8 FAM 403.1-4(C).\",\"typed_values\":[]}",
        "@type": "xsd:string"
      },

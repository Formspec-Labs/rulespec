      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:f5019eafd5a5ab8ede92489f94bee884b3136da953e4bfe5ebd71f7ac0ec7460\",\"urn:rulespec:document-understanding:assertion:8abad9887f4615cdb4cc0eb6c920843836a50dbf8482a4c9806dfb0be6d610fa\",\"urn:rulespec:document-understanding:assertion:421a658e88dc48aa11b9e4598ec009d1336e88dbe7d2bb3038c64acb9898619c\",\"urn:rulespec:document-understanding:assertion:c5a3979ff77a11f8c5e316bdbafd2eac99de0293d7d4b66b932e4d2f1808aa15\",\"urn:rulespec:document-understanding:assertion:daca1ea4cc606f58d7bd05ff4281f76ae1f424c827bd60dbd79dd00ab1f1c9a8\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"effective_periods\":[],\"end\":2103,\"evidence\":[{\"end\":2103,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:1672:2103:sha256-a80eb4e1eddec9403c4f40ecea1e696a4799a061f2feeb00af71ab33871dd26a\",\"quote\":\"(1) If the applicant has had a material name change more than one year prior to applying on form DS-11 but has not updated her/his ID to reflect the material name change, you must suspend the application to request an acceptable ID in the new name. If there is insufficient time to request that the applicant submit acceptable ID prior to urgent or emergency travel, a limited-validity passport may be issued in the requested name;\",\"start\":1672},{\"end\":2103,\"field\":\"logic_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:1672:2103:sha256-a80eb4e1eddec9403c4f40ecea1e696a4799a061f2feeb00af71ab33871dd26a\",\"quote\":\"(1) If the applicant has had a material name change more than one year prior to applying on form DS-11 but has not updated her/his ID to reflect the material name change, you must suspend the application to request an acceptable ID in the new name. If there is insufficient time to request that the applicant submit acceptable ID prior to urgent or emergency travel, a limited-validity passport may be issued in the requested name;\",\"start\":1672},{\"end\":2070,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:2067:2070:sha256-ee4d988c65de860fabbfbcd27f73d50bbebe3fba37fe419284f4811389c30bdc\",\"quote\":\"may\",\"start\":2067},{\"end\":2103,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:1672:2103:sha256-a80eb4e1eddec9403c4f40ecea1e696a4799a061f2feeb00af71ab33871dd26a\",\"quote\":\"(1) If the applicant has had a material name change more than one year prior to applying on form DS-11 but has not updated her/his ID to reflect the material name change, you must suspend the application to request an acceptable ID in the new name. If there is insufficient time to request that the applicant submit acceptable ID prior to urgent or emergency travel, a limited-validity passport may be issued in the requested name;\",\"start\":1672}],\"id\":\"urn:rulespec:document-understanding:revision:116ad986318c8b5606300c5295927052b242d6524b9b1a5d1908da3b30cb699d\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"permission\",\"logic_text\":\"(1) If the applicant has had a material name change more than one year prior to applying on form DS-11 but has not updated her/his ID to reflect the material name change, you must suspend the application to request an acceptable ID in the new name. If there is insufficient time to request that the applicant submit acceptable ID prior to urgent or emergency travel, a limited-validity passport may be issued in the requested name;\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:daca1ea4cc606f58d7bd05ff4281f76ae1f424c827bd60dbd79dd00ab1f1c9a8\",\"modality\":\"may\",\"modality_quote\":\"may\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:16ef1eebf46581b0a7400603f6543a901654af7e0856e8c1e463fce95b4d7648\",\"origin\":\"aiSuggested\",\"quote\":\"(1) If the applicant has had a material name change more than one year prior to applying on form DS-11 but has not updated her/his ID to reflect the material name change, you must suspend the application to request an acceptable ID in the new name. If there is insufficient time to request that the applicant submit acceptable ID prior to urgent or emergency travel, a limited-validity passport may be issued in the requested name;\",\"references\":[\"DS-11\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:707068cb3a988614f4f2c2d3e8de6078bfbdc9d75a8112440968bb1822c39fbd\",\"scope_quotes\":[\"(1) If the applicant has had a material name change more than one year prior to applying on form DS-11 but has not updated her/his ID to reflect the material name change, you must suspend the application to request an acceptable ID in the new name. If there is insufficient time to request that the applicant submit acceptable ID prior to urgent or emergency travel, a limited-validity passport may be issued in the requested name;\"],\"scope_text\":\"If the applicant has had a material name change more than one year prior to applying on form DS-11 but has not updated her/his ID to reflect the material name change, and there is insufficient time to request that the applicant submit acceptable ID prior to urgent or emergency travel.\",\"section_id\":\"fam-names-section-4\",\"start\":1672,\"summary\":\"If the applicant has had a material name change more than one year prior to applying on form DS-11 but has not updated her/his ID to reflect the material name change, and there is insufficient time to request that the applicant submit acceptable ID prior to urgent or emergency travel, a limited-validity passport may be issued in the requested name.\",\"target_ids\":[],\"typed_values\":[]}",

    {
      "@id": "urn:rulespec:document-understanding:assertion:13cfedd57c0653d2f90a7bd3a6478d320ca0c585cc35d5dcaa4bb13fc951f5eb",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",

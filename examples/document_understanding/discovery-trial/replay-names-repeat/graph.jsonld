      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"action\":\"suspend the application to request an acceptable ID in the new name\",\"actor\":\"you\",\"alternative_quotes\":[],\"choice_text\":\"\",\"claimants\":[{\"attribution\":\"rkaf:claimantIsDocumentIssuer\",\"quote\":\"8 FAM 403.1-4\",\"text\":\"Department of State\"}],\"concepts\":[{\"definition\":\"Requirement to suspend a DS-11 application and request acceptable ID in the new name when a material name change occurred more than one year prior and ID is not updated.\",\"label\":\"Application Suspension for Outdated ID\",\"quote\":\"If the applicant has had a material name change more than one year prior to applying on form DS-11 but has not updated her/his ID to reflect the material name change, you must suspend the application to request an acceptable ID in the new name.\",\"role\":\"rkaf:assignmentPrimary\"}],\"effective_periods\":[],\"jurisdiction\":\"\",\"kind\":\"requirement\",\"logic_text\":\"If the applicant has had a material name change more than one year prior to applying on form DS-11 but has not updated her/his ID to reflect the material name change\",\"modality\":\"must\",\"object\":\"the application\",\"scope_text\":\"If the applicant has had a material name change more than one year prior to applying on Form DS-11 but has not updated ID to reflect the material name change.\",\"summary\":\"If the applicant had a material name change more than one year prior to applying on Form DS-11 but has not updated ID to reflect the change, you must suspend the application to request an acceptable ID in the new name.\",\"typed_values\":[{\"anchor\":\"applying on form DS-11\",\"comparator\":\"more than\",\"datatype\":\"xsd:duration\",\"name\":\"name_change_elapsed_time\",\"quote\":\"more than one year prior to applying on form DS-11\",\"unit\":\"year\",\"value\":\"P1Y\"}]}",
        "@type": "xsd:string"
      },

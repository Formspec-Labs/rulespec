      "dcterms:description": "{\"action\":\"fully notate\",\"actor\":\"You\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:ea07c902d29a7a9bb56980375320eae10cc475148fa1d2608bbe78aa8aa4318d\",\"urn:rulespec:document-understanding:assertion:442278fcac271587daf0ddc95d024a4b2d6c2030c47596f2da6a438e322d62be\",\"urn:rulespec:document-understanding:assertion:a0e4518564db3eb24274d3c2102634a16daa13473eebe9274312199275cc5deb\",\"urn:rulespec:document-understanding:assertion:1e998f0bedfcf9c4f508d053e109837b116b7704f31968019ec854b7f4c90416\",\"urn:rulespec:document-understanding:assertion:ab4074158c4f4719edbbfd917d43a42b88064f68bb5084acea21119235f5259d\",\"urn:rulespec:document-understanding:assertion:12265f44c626fd965dc87fb8d54306b0b3659aa53f4c76988a00016dceed07db\",\"urn:rulespec:document-understanding:assertion:82acf3efad2c45a3e4757883814c1495af35c0bc874a5ca0238b85bea88759e9\",\"urn:rulespec:document-understanding:assertion:00793e505c3045f0a4706aa77b0dbe069b26c5d2787d2ff5bacf55207235f175\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[{\"attribution\":\"rkaf:claimantIsDocumentIssuer\",\"quote\":\"8 FAM 403.1-4\",\"text\":\"Department of State\"}],\"concepts\":[{\"definition\":\"Requirement to fully notate name change documentation as 'seen and returned' before returning it with an IRL.\",\"label\":\"Notation of Name Change Documentation\",\"quote\":\"You must fully notate the name change documentation prior to returning the documentation, including that the documentation was \\\"seen and returned,\\\" to the applicant with the information request letter (IRL);\",\"role\":\"rkaf:assignmentPrimary\"}],\"context_quotes\":[\"The applicant generally will need the name change documentation to change the name on her/his ID.\"],\"effective_periods\":[],\"end\":2414,\"evidence\":[{\"end\":2414,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23c
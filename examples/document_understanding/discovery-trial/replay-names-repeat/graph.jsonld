      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"action\":\"submit\",\"actor\":\"Applicants who have had a material name change within one year of applying on a form DS-11\",\"alternative_quotes\":[],\"choice_text\":\"\",\"claimants\":[{\"attribution\":\"rkaf:claimantIsDocumentIssuer\",\"quote\":\"8 FAM 403.1-4\",\"text\":\"Department of State\"}],\"concepts\":[{\"definition\":\"Exemption for applicants with a recent material name change from submitting identification in the new name.\",\"label\":\"Exemption from Submitting ID in New Name\",\"quote\":\"Applicants who have had a material name change within one year of applying on a form DS-11 do not need to submit ID in the new name.\",\"role\":\"rkaf:assignmentPrimary\"}],\"effective_periods\":[],\"jurisdiction\":\"\",\"kind\":\"exemption\",\"logic_text\":\"\",\"modality\":\"not_required\",\"object\":\"ID in the new name\",\"scope_text\":\"For applicants who have had a material name change within one year of applying on a Form DS-11.\",\"summary\":\"Applicants who had a material name change within one year of applying on a Form DS-11 do not need to submit ID in the new name.\",\"typed_values\":[{\"anchor\":\"applying on a form DS-11\",\"comparator\":\"within\",\"datatype\":\"xsd:duration\",\"name\":\"name_change_recency_threshold\",\"quote\":\"within one year of applying on a form DS-11\",\"unit\":\"year\",\"value\":\"P1Y\"}]}",
        "@type": "xsd:string"

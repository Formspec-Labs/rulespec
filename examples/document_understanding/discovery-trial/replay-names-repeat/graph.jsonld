      "dcterms:description": "{\"action\":\"suspend the application to request an acceptable ID in the new name\",\"actor\":\"you\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:628b0089d2db683467fb82ac33d43d3b7ced54162e340ab2672a6a812a486674\",\"urn:rulespec:document-understanding:assertion:c4cd1a54e6bbbf7ee3b7c265b6dd005da90e8c28e9529c02607a344e05731aac\",\"urn:rulespec:document-understanding:assertion:8658f4bedc5aa1970ba63f7da1a2d09b393ad4779ba0268998699c1b756e4b13\",\"urn:rulespec:document-understanding:assertion:eb0545189c8ec79c3a475a013de974b1370c706a7cab094ff3871c79cda5b902\",\"urn:rulespec:document-understanding:assertion:a3cff0308df1b8e50fe352cfa46ac81a8e6af45ca335771f571d6c02eb6f7e5a\",\"urn:rulespec:document-understanding:assertion:aeb210eb4f7b8f4fbf4566d7a93745ffc20790b3e6ed65ba663164625976ff6c\",\"urn:rulespec:document-understanding:assertion:cb25762e838d57c6a0a78fa27f9dfc1f6391bbddc269d76d5e76958d3157c049\",\"urn:rulespec:document-understanding:assertion:8218027fa33d96a190bef662cac9dff0bc75c55f9fc3d6f93d7c8287c95384c0\",\"urn:rulespec:document-understanding:assertion:02dcf26836284219d511de5b718a24834622a6fc3e3c15c3da73bd77fd045ce2\",\"urn:rulespec:document-understanding:assertion:0ff4bcf2d9ff8c8d21b2ca40e5ac0b3bd0d9141237bf033ec8dc2c6f38505e06\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[{\"attribution\":\"rkaf:claimantIsDocumentIssuer\",\"quote\":\"8 FAM 403.1-4\",\"text\":\"Department of State\"}],\"concepts\":[{\"definition\":\"Requirement to suspend a DS-11 application and request acceptable ID in the new name when a material name change occurred more than one year prior and ID is not updated.\",\"label\":\"Application Suspension for Outdated ID\",\"quote\":\"If the applicant has had a material name change more than one year prior to applying on form DS-11 but has not updated her/his ID to reflect the material name change, you must suspend the application to request an acceptable ID in the new name.\",\"role\":\"rkaf:assignmentPrimary\"}],\"context_quotes\":[],\"effective_periods\":[],\"end\":1920,\"evidence\":[{\"end\":1920,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:1676:1920:sha256-2565638f681c03203d7355f09b257b887e0cb9925bad1611c09720d91cf3dd00\",\"quote\":\"If the applicant has had a material name change more than one year prior to applying on form DS-11 but has not updated her/his ID to reflect the material name change, you must suspend the application to request an acceptable ID in the new name.\",\"start\":1676},{\"end\":1846,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:1843:1846:sha256-bb0347a468d97e98a9c00e37cebec1ab930f6f1221cae0f1fbb92b07e1900ba2\",\"quote\":\"you\",\"start\":1843},{\"end\":1919,\"field\":\"action\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:1852:1919:sha256-ea99bf39ccaa8fae843da272796bf5c6af6afe0a8217cb7187bca4b22db9c98e\",\"quote\":\"suspend the application to request an acceptable ID in the new name\",\"start\":1852},{\"end\":1875,\"field\":\"object\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:1860:1875:sha256-59b33147eed775afbd220ad5c1d10dfd17c401cb664c3c05a2e877c208d45bfb\",\"quote\":\"the application\",\"start\":1860},{\"end\":1841,\"field\":\"logic_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:1676:1841:sha256-8d6e9a2e653ca62614166aac8953994fa3ed5eaadb3fe7d2c0dd5978ab49c209\",\"quote\":\"If the applicant has had a material name change more than one year prior to applying on form DS-11 but has not updated her/his ID to reflect the material name change\",\"start\":1676},{\"end\":1851,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:1847:1851:sha256-4137b01e139589b7a1d3b3fc4da031d8ce5bb415808734e970c3a58ea0e98f0f\",\"quote\":\"must\",\"start\":1847},{\"end\":1841,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:1676:1841:sha256-8d6e9a2e653ca62614166aac8953994fa3ed5eaadb3fe7d2c0dd5978ab49c209\",\"quote\":\"If the applicant has had a material name change more than one year prior to applying on form DS-11 but has not updated her/his ID to reflect the material name change\",\"start\":1676},{\"end\":1920,\"field\":\"concepts:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:1676:1920:sha256-2565638f681c03203d7355f09b257b887e0cb9925bad1611c09720d91cf3dd00\",\"quote\":\"If the applicant has had a material name change more than one year prior to applying on form DS-11 but has not updated her/his ID to reflect the material name change, you must suspend the application to request an acceptable ID in the new name.\",\"start\":1676},{\"end\":1774,\"field\":\"typed_values:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:1724:1774:sha256-43e59de37518acf791cdec24febe5d82bfc02883339b2858f4a7b7b6f9f78b1f\",\"quote\":\"more than one year prior to applying on form DS-11\",\"start\":1724}],\"id\":\"urn:rulespec:document-understanding:revision:e62f955b286345ed9d576bffcd3ad577d8d5c91db16c4e57dda001efc9333d72\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"If the applicant has had a material name change more than one year prior to applying on form DS-11 but has not updated her/his ID to reflect the material name change\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:8218027fa33d96a190bef662cac9dff0bc75c55f9fc3d6f93d7c8287c95384c0\",\"modality\":\"must\",\"modality_quote\":\"must\",\"object\":\"the application\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:f3a7decebaec0278fcd6d4efd5371d3e2b6da42b1bb2c821c5c094b9e5ae080c\",\"origin\":\"aiSuggested\",\"quote\":\"If the applicant has had a material name change more than one year prior to applying on form DS-11 but has not updated her/his ID to reflect the material name change, you must suspend the application to request an acceptable ID in the new name.\",\"references\":[\"form DS-11\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:71028faefa5a22d89fb5ac2e2e71bda689f89380fcc257d4a96e6f798dbe87b8\",\"scope_quotes\":[\"If the applicant has had a material name change more than one year prior to applying on form DS-11 but has not updated her/his ID to reflect the material name change\"],\"scope_text\":\"If the applicant has had a material name change more than one year prior to applying on Form DS-11 but has not updated ID to reflect the material name change.\",\"section_id\":\"fam-names-section-4\",\"start\":1676,\"summary\":\"If the applicant had a material name change more than one year prior to applying on Form DS-11 but has not updated ID to reflect the change, you must suspend the application to request an acceptable ID in the new name.\",\"target_ids\":[],\"typed_values\":[{\"anchor\":\"applying on form DS-11\",\"comparator\":\"more than\",\"datatype\":\"xsd:duration\",\"name\":\"name_change_elapsed_time\",\"quote\":\"more than one year prior to applying on form DS-11\",\"unit\":\"year\",\"value\":\"P1Y\"}]}",

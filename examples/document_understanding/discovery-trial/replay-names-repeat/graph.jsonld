    {
      "@id": "urn:rulespec:document-understanding:assertion:5524c160516adcb29da29e1075d80d9d4adba99a1c4fddbae4de3d3f50977128",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:5423e357c1a4f860451642602a41c0586c11b1356050d71b6cd09a3957959ff2",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:598f0103fec160afa24b2f4d86e52d26c641e1214b9afc7883160af6a4ba4090",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:02a90cb682c4e90922cdec2b6cfcc48594010af3853171579022cbc795380b8a",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"action\":\"document material discrepancies by submission of one or more of the listed documents\",\"actor\":\"\",\"alternative_quotes\":[\"(1) Court orders or decrees:\\n\\n(a) Name change orders; or\\n\\n(b) Divorce decrees;\",\"(2) Certificates of naturalization;\",\"(3) Marriage certificates;\",\"(4) Documentation demonstrating change of name by operation of state law; or\",\"(5) Documentation of customary usage.\"],\"choice_text\":\"One or more of: (1) Court orders or decrees: (a) Name change orders, or (b) Divorce decrees; (2) Certificates of naturalization; (3) Marriage certificates; (4) Documentation demonstrating change of name by operation of state law; or (5) Documentation of customary usage.\",\"claimants\":[{\"attribution\":\"rkaf:claimantIsDocumentIssuer\",\"quote\":\"8 FAM 403.1-4\",\"text\":\"Department of State\"}],\"concepts\":[{\"definition\":\"Requirement to document material name discrepancies by submitting one or more acceptable documents.\",\"label\":\"Documenting Material Name Changes\",\"quote\":\"Material discrepancies between the name recorded on the application, the applicant's evidence of U.S. citizenship/non-citizen U.S. nationality, or the evidence of identity must be documented by submission of one or more of the documents listed in this section (see an exception for married names in 8 FAM 403.1-4(C)).\",\"role\":\"rkaf:assignmentPrimary\"}],\"effective_periods\":[],\"jurisdiction\":\"\",\"kind\":\"requirement\",\"logic_text\":\"one or more of the documents listed in this section ... (1) Court orders or decrees: (a) Name change orders; or (b) Divorce decrees; (2) Certificates of naturalization; (3) Marriage certificates; (4) Documentation demonstrating change of name by operation of state law; or (5) Documentation of customary usage.\",\"modality\":\"must\",\"object\":\"Material discrepancies between the name recorded on the application, the applicant's evidence of U.S. citizenship/non-citizen U.S. nationality, or the evidence of identity\",\"scope_text\":\"Except for married names as provided in 8 FAM 403.1-4(C).\",\"summary\":\"Material discrepancies between the name recorded on the application, the evidence of U.S. citizenship/non-citizen U.S. nationality, or the evidence of identity must be documented by submitting one or more of the listed acceptable documents (court orders/decrees including name change orders or divorce decrees, certificates of naturalization, marriage certificates, documentation demonstrating change of name by operation of state law, or documentation of customary usage), subject to an exception for married names in 8 FAM 403.1-4(C).\",\"typed_values\":[]}",
        "@type": "xsd:string"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed",
      "rkaf:hasApplicability": "urn:rulespec:document-understanding:scope:7ddcca628e3878962cf1cc5d1751df6617d63bead6143b83e70fd41c48bc9b28"
    },

      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:states-requirement",
      "rkaf:assertsValue": {
        "@value": "Material discrepancies between the name recorded on the application, the evidence of U.S. citizenship/non-citizen U.S. nationality, or the evidence of identity must be documented by submitting one or more of the listed acceptable documents (court orders/decrees including name change orders or divorce decrees, certificates of naturalization, marriage certificates, documentation demonstrating change of name by operation of state law, or documentation of customary usage), subject to an exception for married names in 8 FAM 403.1-4(C).",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:meaning",
      "rkaf:assertsValue": {
        "@value": "{\"action\":\"submit\",\"actor\":\"Applicants who have had a material name change within one year of applying on a form DS-11\",\"alternative_quotes\":[],\"choice_text\":\"\",\"claimants\":[{\"attribution\":\"rkaf:claimantIsDocumentIssuer\",\"quote\":\"8 FAM 403.1-4\",\"text\":\"Department of State\"}],\"concepts\":[{\"definition\":\"Requirement to submit name change documentation if ID has not yet been changed following a material name change within one year of application.\",\"label\":\"Submission of Name Change Documentation\",\"quote\":\"However, if the ID has not yet been changed, they must submit their name change documentation.\",\"role\":\"rkaf:assignmentPrimary\"}],\"effective_periods\":[],\"jurisdiction\":\"\",\"kind\":\"requirement\",\"logic_text\":\"if the ID has not yet been changed\",\"modality\":\"must\",\"object\":\"their name change documentation\",\"scope_text\":\"For applicants who have had a material name change within one year of applying on Form DS-11, if the ID has not yet been changed.\",\"summary\":\"If an applicant who has had a material name change within one year of applying on Form DS-11 has not yet changed their ID, they must submit their name change documentation.\",\"typed_values\":[{\"anchor\":\"applying on a form DS-11\",\"comparator\":\"within\",\"datatype\":\"xsd:duration\",\"name\":\"name_change_recency_threshold\",\"quote\":\"within one year of applying on a form DS-11\",\"unit\":\"year\",\"value\":\"P1Y\"}]}",
        "@type": "xsd:string"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed",
      "rkaf:hasApplicability": "urn:rulespec:document-understanding:scope:c00a74e2fce15fc0fe73314efa9cb552b471a048967c0befb2d1b4f1b461fc24"

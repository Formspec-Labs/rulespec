      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"issue in the requested name\",\"actor\":\"\",\"alternative_quotes\":[\"urgent\",\"emergency travel\"],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:1fc3c2aac167d45e89c46f0c9353ceb12ffee63cae126206c198f81651a9be65\",\"urn:rulespec:document-understanding:assertion:176f2cd62c7b15d1a935fa19f1d8cc93d8734e6bda3122fbeb29914b694355af\",\"urn:rulespec:document-understanding:assertion:b23efdc92d2c4a33ca135ebc192e66ee98197c05d91310a5ac20b30aa8545c93\",\"urn:rulespec:document-understanding:assertion:61c4faf6d7cf36f8081869d476758f3c3393e084bd666101227cb85fb22fa8c7\",\"urn:rulespec:document-understanding:assertion:bcdd940681ae64ab91f2795cd2d80841e26f007852a5d3a7c21b7f52fdea3a52\",\"urn:rulespec:document-understanding:assertion:264b0adb039a114d1da055348194196bbfe920ede9b63a4916f0a1e5f019eefc\",\"urn:rulespec:document-understanding:assertion:877159a1745ebae5d24293ea3fefc32a13e016bb4f6d05cfa5d96205d209558e\",\"urn:rulespec:document-understanding:assertion:ae35584e2f6fbbd2afc845a9f353a0a0df973675155c66926e543ea14a27abd5\",\"urn:rulespec:document-understanding:assertion:725be8df8d25c784e686419d3ef113683f23e3447b640a47e37a2d3382322be3\",\"urn:rulespec:document-understanding:assertion:b99e9676004dc47022bfa19f73f6ad258c296a0ff9bd7db5b07ef4eeab2a017c\",\"urn:rulespec:document-understanding:assertion:a55c1e3594fc3fbeaa19e7da2a84ab46d2f9525a087a379d317d8350f92bf49a\"],\"choice_quote\":\"urgent or emergency travel\",\"choice_text\":\"urgent travel OR emergency travel\",\"claimants\":[{\"attribution\":\"rkaf:claimantIsDocumentIssuer\",\"quote\":\"8 FAM 403.1-4\",\"text\":\"Department of State\"}],\"concepts\":[{\"definition\":\"Permission to issue a limited-validity passport in the requested name when urgent/emergency travel does not allow sufficient time to obtain updated ID.\",\"label\":\"Limited-Validity Passport Issuance\",\"quote\":\"If there is insufficient time to request that the applicant submit acceptable ID prior to urgent or emergency travel, a limited-validity passport may be issued in the requested name;\",\"role\":\"rkaf:assignmentPrimary\"}],\"context_quotes\":[],\"effective_periods\":[],\"end\":2103,\"evidence\":[{\"end\":2103,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:1921:2103:sha256-0fdbf8386267c11baca8f4259546dc39828a560aa3cc96c2b0d436c3602b72a9\",\"quote\":\"If there is insufficient time to request that the applicant submit acceptable ID prior to urgent or emergency travel, a limited-validity passport may be issued in the requested name;\",\"start\":1921},{\"end\":2102,\"field\":\"action\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:2067:2102:sha256-6365defe0ba2447b32cf006a5c0f51dc3f98e10a9d50f60a5c20eec5ecf6b448\",\"quote\":\"may be issued in the requested name\",\"start\":2067},{\"end\":2066,\"field\":\"object\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:2039:2066:sha256-7c5242f452273d58b648473e49efef79268657cee618c30d4574f93e3a075b57\",\"quote\":\"a limited-validity passport\",\"start\":2039},{\"end\":2037,\"field\":\"logic_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:2002:2037:sha256-1f2d259d043c42c6d5afcb26ed13b6252df2be879d84986f14fbe0da2d9d585d\",\"quote\":\"prior to urgent or emergency travel\",\"start\":2002},{\"end\":2070,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:2067:2070:sha256-ee4d988c65de860fabbfbcd27f73d50bbebe3fba37fe419284f4811389c30bdc\",\"quote\":\"may\",\"start\":2067},{\"end\":2037,\"field\":\"choice_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:2011:2037:sha256-17a15e24371291ea8cb4c9eeb09acdcdacf8c87f8b9dc2ff5bfc2bbb9a48da1f\",\"quote\":\"urgent or emergency travel\",\"start\":2011},{\"end\":1841,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:1676:1841:sha256-8d6e9a2e653ca62614166aac8953994fa3ed5eaadb3fe7d2c0dd5978ab49c209\",\"quote\":\"If the applicant has had a material name change more than one year prior to applying on form DS-11 but has not updated her/his ID to reflect the material name change\",\"start\":1676},{\"end\":2037,\"field\":\"scope_text:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:1921:2037:sha256-69672abdd23b79c9ab53977f6c04fc575dfcf5ce9f86af983bd20b44baa19026\",\"quote\":\"If there is insufficient time to request that the applicant submit acceptable ID prior to urgent or emergency travel\",\"start\":1921},{\"end\":2017,\"field\":\"alternative:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:2011:2017:sha256-f9d37c23fcc0f03c15a86aba71dce01dd0baa7a1568180e60c2347a5863151bc\",\"quote\":\"urgent\",\"start\":2011},{\"end\":2037,\"field\":\"alternative:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:2021:2037:sha256-af528863afa0e1c0e6ac6eda7a5baf82b1e47f36cb78b71310cd1345d1966e71\",\"quote\":\"emergency travel\",\"start\":2021},{\"end\":2103,\"field\":\"concepts:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:1921:2103:sha256-0fdbf8386267c11baca8f4259546dc39828a560aa3cc96c2b0d436c3602b72a9\",\"quote\":\"If there is insufficient time to request that the applicant submit acceptable ID prior to urgent or emergency travel, a limited-validity passport may be issued in the requested name;\",\"start\":1921}],\"id\":\"urn:rulespec:document-understanding:revision:f515fc058b69dba16a99912df36607ef24d17b38f1492bf4adcbc4078648b4d9\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"permission\",\"logic_text\":\"prior to urgent or emergency travel\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:b99e9676004dc47022bfa19f73f6ad258c296a0ff9bd7db5b07ef4eeab2a017c\",\"modality\":\"may\",\"modality_quote\":\"may\",\"object\":\"a limited-validity passport\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:ca7f7e266fa33aed4d542cba4ce14b95d4c9c6306cd87fd9ddbe716fdf974e2f\",\"origin\":\"aiSuggested\",\"quote\":\"If there is insufficient time to request that the applicant submit acceptable ID prior to urgent or emergency travel, a limited-validity passport may be issued in the requested name;\",\"references\":[\"form DS-11\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:3c03beb7247d971d3731f979be6fa3a9c2d225a6055ac8e16c2a7f33c21c89f8\",\"scope_quotes\":[\"If the applicant has had a material name change more than one year prior to applying on form DS-11 but has not updated her/his ID to reflect the material name change\",\"If there is insufficient time to request that the applicant submit acceptable ID prior to urgent or emergency travel\"],\"scope_text\":\"If the applicant had a material name change more than one year prior to applying on Form DS-11 without updating ID, and there is insufficient time to request submission of acceptable ID prior to urgent or emergency travel.\",\"section_id\":\"fam-names-section-4\",\"start\":1921,\"summary\":\"When an applicant with a material name change over one year prior on Form DS-11 lacks updated ID, a limited-validity passport may be issued in the requested name if there is insufficient time to request acceptable ID prior to urgent or emergency travel.\",\"target_ids\":[],\"typed_values\":[]}",

        "@value": "{\"action\":\"issue in the requested name\",\"actor\":\"\",\"alternative_quotes\":[\"urgent\",\"emergency travel\"],\"choice_text\":\"urgent travel OR emergency travel\",\"claimants\":[{\"attribution\":\"rkaf:claimantIsDocumentIssuer\",\"quote\":\"8 FAM 403.1-4\",\"text\":\"Department of State\"}],\"concepts\":[{\"definition\":\"Permission to issue a limited-validity passport in the requested name when urgent/emergency travel does not allow sufficient time to obtain updated ID.\",\"label\":\"Limited-Validity Passport Issuance\",\"quote\":\"If there is insufficient time to request that the applicant submit acceptable ID prior to urgent or emergency travel, a limited-validity passport may be issued in the requested name;\",\"role\":\"rkaf:assignmentPrimary\"}],\"effective_periods\":[],\"jurisdiction\":\"\",\"kind\":\"permission\",\"logic_text\":\"prior to urgent or emergency travel\",\"modality\":\"may\",\"object\":\"a limited-validity passport\",\"scope_text\":\"If the applicant had a material name change more than one year prior to applying on Form DS-11 without updating ID, and there is insufficient time to request submission of acceptable ID prior to urgent or emergency travel.\",\"summary\":\"When an applicant with a material name change over one year prior on Form DS-11 lacks updated ID, a limited-validity passport may be issued in the requested name if there is insufficient time to request acceptable ID prior to urgent or emergency travel.\",\"typed_values\":[]}",
        "@type": "xsd:string"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed",
      "rkaf:hasApplicability": "urn:rulespec:document-understanding:scope:11685f2a70bcd10b07b98b4239b999e1b441742be13208bb45b5ee70351ca63b"
    },

      "rkaf:assertsValue": {
        "@value": "{\"action\":\"continue to use\",\"actor\":\"The applicant\",\"alternative_quotes\":[],\"choice_text\":\"\",\"claimants\":[{\"attribution\":\"rkaf:claimantIsDocumentIssuer\",\"quote\":\"8 FAM 403.1-4\",\"text\":\"Department of State\"}],\"concepts\":[{\"definition\":\"Prohibition on continuing to use a previous name after a material name change, unless explicitly authorized by the documentation.\",\"label\":\"Use of Previous Name\",\"quote\":\"The applicant may not continue to use a previous name after a material name change unless the name change documentation specifically permits the applicant to continue using that name (see 8 FAM 403.1-6 regarding “known as” names).\",\"role\":\"rkaf:assignmentPrimary\"}],\"effective_periods\":[],\"jurisdiction\":\"\",\"kind\":\"prohibition\",\"logic_text\":\"unless the name change documentation specifically permits the applicant to continue using that name\",\"modality\":\"must_not\",\"object\":\"a previous name\",\"scope_text\":\"After a material name change, unless the name change documentation specifically permits the applicant to continue using that name.\",\"summary\":\"An applicant may not continue to use a previous name after a material name change unless the name change documentation specifically permits continuing to use that name.\",\"typed_values\":[]}",
        "@type": "xsd:string"
      },

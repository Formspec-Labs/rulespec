      "dcterms:description": "{\"action\":\"require evidence of identity\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:84335a4aeb769fa6032040c5f28e7670f634a0b289d8b9a9e55cfb2be7425b15\",\"urn:rulespec:document-understanding:assertion:44e03d430ed3a41ecf91513194e25f4653afa28167f8c807fafd4adfcf870f1d\",\"urn:rulespec:document-understanding:assertion:bb865089013908876b5a7f7cb78f126c74f337c92735235f496cdc1334097ff0\",\"urn:rulespec:document-understanding:assertion:50f3dfc35aadac6e179a28dd71b2f3028cbbd3d74fe5375a8a01bdb205cd7e37\",\"urn:rulespec:document-understanding:assertion:dd2d1bd60bb284d0ebdb68a0d66e000414f16f6e363e34e5a7955461a7759bd5\",\"urn:rulespec:document-understanding:assertion:e2de370bd71eca544bc10c5ab1b980e7e71aed53b505e1bc71eb7c2f29c5f370\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[{\"attribution\":\"rkaf:claimantIsDocumentIssuer\",\"quote\":\"8 FAM 403.1-4\",\"text\":\"Department of State\"}],\"concepts\":[{\"definition\":\"Descriptive possibility that evidence of identity might be required to establish the name that best identifies the applicant.\",\"label\":\"Evidence of Identity Requirement Possibility\",\"quote\":\"Consequently, under 22 CFR 51.23(c), evidence of identity might be required in accordance with Department guidance to establish the name that best identifies the applicant\",\"role\":\"rkaf:assignmentPrimary\"}],\"context_quotes\":[\"The applicant's name is an integral part of her/his identity.\"],\"effective_periods\":[],\"end\":1669,\"evidence\":[{\"end\":1669,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:1436:1669:sha256-f258db51bfd331595b656097e2509e27dc07836355b0ac6dd941a2138bfbcaaf\",\"quote\":\"The applicant's name is an integral part of her/his identity. Consequently, under 22 CFR 51.23(c), evidence of identity might be required in accordance with Department guidance to establish the name that best identifies the applicant\",\"start\":1436},{\"end\":1669,\"field\":\"action\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:1556:1669:sha256-76117a47d773b39e9f874cc3125851b2e59256ead7a77626dd58cbe10edaf54d\",\"quote\":\"might be required in accordance with Department guidance to establish the name that best identifies the applicant\",\"start\":1556},{\"end\":1555,\"field\":\"object\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:1535:1555:sha256-f30948c1391413dbd020413d43f1b7b59b62e70ac5ce9b7e9645b2071eca38f1\",\"quote\":\"evidence of identity\",\"start\":1535},{\"end\":1561,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:1556:1561:sha256-f23be8eed45492f4b5315117a6ed033788fa26715014cd26c4a059c02ea16cad\",\"quote\":\"might\",\"start\":1556},{\"end\":1497,\"field\":\"context:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:1436:1497:sha256-86c5c10f194b8fae4059abff950eaa687734f5a0dfa1d33421733da1e697f00e\",\"quote\":\"The applicant's name is an integral part of her/his identity.\",\"start\":1436},{\"end\":1669,\"field\":\"concepts:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:1498:1669:sha256-0ff6d0d07557bbc46e5812efeab294fba6db850127486a6be86a0e26fd8a97c9\",\"quote\":\"Consequently, under 22 CFR 51.23(c), evidence of identity might be required in accordance with Department guidance to establish the name that best identifies the applicant\",\"start\":1498}],\"id\":\"urn:rulespec:document-understanding:revision:6791c71f16abeb800a5979323407b605393c6427ccde7b90725539b165772c2e\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"statement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:dd2d1bd60bb284d0ebdb68a0d66e000414f16f6e363e34e5a7955461a7759bd5\",\"modality\":\"possible\",\"modality_quote\":\"might\",\"object\":\"evidence of identity\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:432acbf46f34501661fce70a5170c0b62eb9e79d213257f1f4cd67ac4060dea9\",\"origin\":\"aiSuggested\",\"quote\":\"The applicant's name is an integral part of her/his identity. Consequently, under 22 CFR 51.23(c), evidence of identity might be required in accordance with Department guidance to establish the name that best identifies the applicant\",\"references\":[\"22 CFR 51.23(c)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:ed9511e81562cc282ff23fb9cf6e869c9ba4a9260b5b3c7373144fb8ad02a872\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"fam-names-section-4\",\"start\":1436,\"summary\":\"Because an applicant's name is an integral part of identity, under 22 CFR 51.23(c), evidence of identity might be required in accordance with Department guidance to establish the name that best identifies the applicant.\",\"target_ids\":[],\"typed_values\":[]}",

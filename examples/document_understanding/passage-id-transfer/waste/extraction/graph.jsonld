      "rkaf:hasContentDigest": "sha256:969fc88d342bb11596a21de7edf3564e8bc71119db98f9429fda14cf1db6d807",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:800fd078b7fe8df25e97f0681cead49a6f8e3bfd3289ea7278a92949c8856ce2\",\"urn:rulespec:document-understanding:assertion:4377c91a3ce95f39dc939fe3afb9ee761af695c5261527a0e18b2e61d59a97c1\",\"urn:rulespec:document-understanding:assertion:9cb17acdd3a944d7b21f9fde546c7de094ecc6b85f5dba3dd9c247c4180f440e\",\"urn:rulespec:document-understanding:assertion:d4f75cf7a28baae906d6d53a0367d859a109a1375a98706d918c81fbd1e9ec71\",\"urn:rulespec:document-understanding:assertion:ce4c01b01fd8717278bf9b4aa0b1b720f6fc319147cbf303b1b1e98d2f46fd63\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"effective_periods\":[],\"end\":2005,\"evidence\":[{\"end\":2005,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A43f75aaf4a19870db19d481dd6883f99ef4c606c7cb4914012a118a12fbce149:1759:2005:sha256-bc4ba67df50c986911bbf2bdbbd1a3cf8981e8933e3f55fe9f40108c359ced7b\",\"quote\":\"(2) The generator shall use a container made of or lined with materials that will not react with, and are otherwise compatible with, the hazardous waste to be accumulated, so that the ability of the container to contain the waste is not impaired.\",\"start\":1759},{\"end\":2005,\"field\":\"logic_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A43f75aaf4a19870db19d481dd6883f99ef4c606c7cb4914012a118a12fbce149:1759:2005:sha256-bc4ba67df50c986911bbf2bdbbd1a3cf8981e8933e3f55fe9f40108c359ced7b\",\"quote\":\"(2) The generator shall use a container made of or lined with materials that will not react with, and are otherwise compatible with, the hazardous waste to be accumulated, so that the ability of the container to contain the waste is not impaired.\",\"start\":1759},{\"end\":1782,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A43f75aaf4a19870db19d481dd6883f99ef4c606c7cb4914012a118a12fbce149:1777:1782:sha256-56ee5b508706bf2de91712d85d6d1e11ddbff01949142ed6e8c22e3b1bed1c71\",\"quote\":\"shall\",\"start\":1777},{\"end\":1309,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A43f75aaf4a19870db19d481dd6883f99ef4c606c7cb4914012a118a12fbce149:121:1309:sha256-b1f414f71874caa7cb1888a99a7de9b50bfee7c357001f3a76143b7503ec786d\",\"quote\":\"(A) A generator may accumulate as much as fifty-five gallons of non-acute hazardous waste and either one quart of liquid acute hazardous waste listed in rule 3745-51-31 or paragraph (E) of rule 3745-51-33 of the Administrative Code or one kilogram (kg) (2.2 pounds) of solid acute hazardous waste listed in rule 3745-51-31 or paragraph (E) of rule 3745-51-33 of the Administrative Code in containers at or near any point of generation where wastes initially accumulate which is under the control of the operator of the process generating the waste, without a permit or permit by rule and without complying with the requirements of Chapters 3745-50, 3745-54 to 3745-57 and 3745-205, 3745-65 to 3745-69 and 3745-256, 3745-266, and 3745-267 of the Administrative Code, provided that all of the conditions for exemption in this rule are met. A generator may comply with the conditions for exemption in this rule instead of complying with the conditions for exemption in paragraph (B) of rule 3745-52-16 or paragraph (A) of rule 3745-52-17 of the Administrative Code, except as required in paragraphs (A)(7) and (A)(8) of this rule. The conditions for exemption for satellite accumulation are:\",\"start\":121}],\"id\":\"urn:rulespec:document-understanding:revision:5ce0c3329b5bae4719cc436e8a6057ab855505935b614ef98d22906311a9a204\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"(2) The generator shall use a container made of or lined with materials that will not react with, and are otherwise compatible with, the hazardous waste to be accumulated, so that the ability of the container to contain the waste is not impaired.\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:ce4c01b01fd8717278bf9b4aa0b1b720f6fc319147cbf303b1b1e98d2f46fd63\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:97e4c6f9fe0f68147191068e1a8ae46c9a08935f19db23b74e38bd9402d3a919\",\"origin\":\"aiSuggested\",\"quote\":\"(2) The generator shall use a container made of or lined with materials that will not react with, and are otherwise compatible with, the hazardous waste to be accumulated, so that the ability of the container to contain the waste is not impaired.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:a39384eab661718df57307c815eef8f28f2281b25c4920fa78f6ceb2d2672d0d\",\"scope_quotes\":[\"(A) A generator may accumulate as much as fifty-five gallons of non-acute hazardous waste and either one quart of liquid acute hazardous waste listed in rule 3745-51-31 or paragraph (E) of rule 3745-51-33 of the Administrative Code or one kilogram (kg) (2.2 pounds) of solid acute hazardous waste listed in rule 3745-51-31 or paragraph (E) of rule 3745-51-33 of the Administrative Code in containers at or near any point of generation where wastes initially accumulate which is under the control of the operator of the process generating the waste, without a permit or permit by rule and without complying with the requirements of Chapters 3745-50, 3745-54 to 3745-57 and 3745-205, 3745-65 to 3745-69 and 3745-256, 3745-266, and 3745-267 of the Administrative Code, provided that all of the conditions for exemption in this rule are met. A generator may comply with the conditions for exemption in this rule instead of complying with the conditions for exemption in paragraph (B) of rule 3745-52-16 or paragraph (A) of rule 3745-52-17 of the Administrative Code, except as required in paragraphs (A)(7) and (A)(8) of this rule. The conditions for exemption for satellite accumulation are:\"],\"scope_text\":\"For satellite accumulation under the conditions for exemption in this rule.\",\"section_id\":\"section-1\",\"start\":1759,\"summary\":\"The generator shall use a container made of or lined with materials that will not react with, and are otherwise compatible with, the hazardous waste to be accumulated, so that the ability of the container to contain the waste is not impaired.\",\"target_ids\":[],\"typed_values\":[]}",

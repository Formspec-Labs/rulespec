    {
      "@id": "urn:rulespec:document-understanding:assertion:3b4a526d8ab691d1e6583898b39e90e134e53f3521dd9d601994368387844bc9",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:6a81e6cd04a704c924f1496d2c489ac50bae4ed9f9677e4e95e89f7db8e5ba12",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:f1449533e247f73bcc23f3616dd32110f41821e02ee9d0d47cdd5dfb527ae0d6",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:5994ed69991b50d93dac432dc4256e48d30ed62de7bd37af0065899ade4cd42a",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:logic_text",
      "rkaf:assertsValue": {
        "@value": "(6) A generator who accumulates either acute hazardous waste listed in rule 3745-51-31 or paragraph (E) of rule 3745-51-33 of the Administrative Code or non-acute hazardous waste in excess of the amounts listed in paragraph (A) of this rule at or near any point of generation shall do the following:\n\n(a) Within three consecutive calendar days, comply with the applicable central accumulation area requirements in paragraph (B) of rule 3745-52-16 or paragraph (A) of rule 3745-52-17 of the Administrative Code; or\n\n(b) Remove the excess from the satellite accumulation area within three consecutive calendar days to either:\n\n(i) A central accumulation area operated in accordance with the applicable requirements in paragraph (B) of rule 3745-52-16 or paragraph (A) of rule 3745-52-17 of the Administrative Code;\n\n(ii) An on-site permit by rule or permitted treatment, storage, or disposal facility; or\n\n(iii) An off-site designated facility.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

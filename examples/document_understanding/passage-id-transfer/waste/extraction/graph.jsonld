      "oa:hasSelector": [
        {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "(4) A container holding hazardous waste shall be closed at all times during accumulation, except:\n\n(a) When adding, removing, or consolidating waste; or\n\n(b) When temporary venting of a container is necessary:\n\n(i) For the proper operation of equipment; or\n\n(ii) To prevent dangerous situations, such as build-up of extreme pressure."
        },
        {
          "@type": "oa:TextPositionSelector",
          "oa:start": 2860,
          "oa:end": 3193,

      "rkaf:hasContentDigest": "sha256:ed918297a8c021a7cfa10d7f85af74a1037cc1ef96461d7b3c7967f6dd723365",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:21c30a0fcb5a836211cd9752611aec903d722bb59b51376ebaec858989e69968\",\"urn:rulespec:document-understanding:assertion:19959b2f324a3cf7500b06ecf79f6af523bc35ecda8376c5c249b5e9d2b88764\",\"urn:rulespec:document-understanding:assertion:20843fd5efbab3c6cccf7374220fadc432aa642f078db910106b24a53468a5f9\",\"urn:rulespec:document-understanding:assertion:94ac66aced7033b7908aff0345118243ed4934e495504f22f8251244f71da99b\",\"urn:rulespec:document-understanding:assertion:899d75c065217361134b2f071ba68ad6cc7f8816c7eff3265d0e77592f60dcb4\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"effective_periods\":[],\"end\":5630,\"evidence\":[{\"end\":5630,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A43f75aaf4a19870db19d481dd6883f99ef4c606c7cb4914012a118a12fbce149:5425:5630:sha256-40e6acd0c404e67ee5e4ed94e51601521a6aed81add43f56e38f66c53807d877\",\"quote\":\"(8) All satellite accumulation areas operated by a large quantity generator shall meet the preparedness, prevention, and emergency procedures in rules 3745-52-250 to 3745-52-265 of the Administrative Code.\",\"start\":5425},{\"end\":5630,\"field\":\"logic_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A43f75aaf4a19870db19d481dd6883f99ef4c606c7cb4914012a118a12fbce149:5425:5630:sha256-40e6acd0c404e67ee5e4ed94e51601521a6aed81add43f56e38f66c53807d877\",\"quote\":\"(8) All satellite accumulation areas operated by a large quantity generator shall meet the preparedness, prevention, and emergency procedures in rules 3745-52-250 to 3745-52-265 of the Administrative Code.\",\"start\":5425},{\"end\":5506,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A43f75aaf4a19870db19d481dd6883f99ef4c606c7cb4914012a118a12fbce149:5501:5506:sha256-56ee5b508706bf2de91712d85d6d1e11ddbff01949142ed6e8c22e3b1bed1c71\",\"quote\":\"shall\",\"start\":5501},{\"end\":1309,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A43f75aaf4a19870db19d481dd6883f99ef4c606c7cb4914012a118a12fbce149:121:1309:sha256-b1f414f71874caa7cb1888a99a7de9b50bfee7c357001f3a76143b7503ec786d\",\"quote\":\"(A) A generator may accumulate as much as fifty-five gallons of non-acute hazardous waste and either one quart of liquid acute hazardous waste listed in rule 3745-51-31 or paragraph (E) of rule 3745-51-33 of the Administrative Code or one kilogram (kg) (2.2 pounds) of solid acute hazardous waste listed in rule 3745-51-31 or paragraph (E) of rule 3745-51-33 of the Administrative Code in containers at or near any point of generation where wastes initially accumulate which is under the control of the operator of the process generating the waste, without a permit or permit by rule and without complying with the requirements of Chapters 3745-50, 3745-54 to 3745-57 and 3745-205, 3745-65 to 3745-69 and 3745-256, 3745-266, and 3745-267 of the Administrative Code, provided that all of the conditions for exemption in this rule are met. A generator may comply with the conditions for exemption in this rule instead of complying with the conditions for exemption in paragraph (B) of rule 3745-52-16 or paragraph (A) of rule 3745-52-17 of the Administrative Code, except as required in paragraphs (A)(7) and (A)(8) of this rule. The conditions for exemption for satellite accumulation are:\",\"start\":121},{\"end\":5630,\"field\":\"scope_text:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A43f75aaf4a19870db19d481dd6883f99ef4c606c7cb4914012a118a12fbce149:5425:5630:sha256-40e6acd0c404e67ee5e4ed94e51601521a6aed81add43f56e38f66c53807d877\",\"quote\":\"(8) All satellite accumulation areas operated by a large quantity generator shall meet the preparedness, prevention, and emergency procedures in rules 3745-52-250 to 3745-52-265 of the Administrative Code.\",\"start\":5425}],\"id\":\"urn:rulespec:document-understanding:revision:504b09782000ef4771ec7458cb8a7f1e83f3c46e08f73ab6ee30180c35198254\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"(8) All satellite accumulation areas operated by a large quantity generator shall meet the preparedness, prevention, and emergency procedures in rules 3745-52-250 to 3745-52-265 of the Administrative Code.\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:899d75c065217361134b2f071ba68ad6cc7f8816c7eff3265d0e77592f60dcb4\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:c58106bf668c925a14039d265fe0a7b7cb606eaa18d523c2295ef859945a4813\",\"origin\":\"aiSuggested\",\"quote\":\"(8) All satellite accumulation areas operated by a large quantity generator shall meet the preparedness, prevention, and emergency procedures in rules 3745-52-250 to 3745-52-265 of the Administrative Code.\",\"references\":[\"rules 3745-52-250 to 3745-52-265\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:88dbdc317857792926a8ec908ee92c3fa985214b8aea3b24806aeebc560dfc8a\",\"scope_quotes\":[\"(A) A generator may accumulate as much as fifty-five gallons of non-acute hazardous waste and either one quart of liquid acute hazardous waste listed in rule 3745-51-31 or paragraph (E) of rule 3745-51-33 of the Administrative Code or one kilogram (kg) (2.2 pounds) of solid acute hazardous waste listed in rule 3745-51-31 or paragraph (E) of rule 3745-51-33 of the Administrative Code in containers at or near any point of generation where wastes initially accumulate which is under the control of the operator of the process generating the waste, without a permit or permit by rule and without complying with the requirements of Chapters 3745-50, 3745-54 to 3745-57 and 3745-205, 3745-65 to 3745-69 and 3745-256, 3745-266, and 3745-267 of the Administrative Code, provided that all of the conditions for exemption in this rule are met. A generator may comply with the conditions for exemption in this rule instead of complying with the conditions for exemption in paragraph (B) of rule 3745-52-16 or paragraph (A) of rule 3745-52-17 of the Administrative Code, except as required in paragraphs (A)(7) and (A)(8) of this rule. The conditions for exemption for satellite accumulation are:\",\"(8) All satellite accumulation areas operated by a large quantity generator shall meet the preparedness, prevention, and emergency procedures in rules 3745-52-250 to 3745-52-265 of the Administrative Code.\"],\"scope_text\":\"For all satellite accumulation areas operated by a large quantity generator.\",\"section_id\":\"section-1\",\"start\":5425,\"summary\":\"All satellite accumulation areas operated by a large quantity generator shall meet the preparedness, prevention, and emergency procedures in rules 3745-52-250 to 3745-52-265 of the Administrative Code.\",\"target_ids\":[],\"typed_values\":[]}",

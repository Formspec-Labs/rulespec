      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:6a81e6cd04a704c924f1496d2c489ac50bae4ed9f9677e4e95e89f7db8e5ba12",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:f1449533e247f73bcc23f3616dd32110f41821e02ee9d0d47cdd5dfb527ae0d6",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:f2af2006acb64bb0de933165a76f67e3d7adc0d483a35a262f494d2938305088",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:states-requirement",
      "rkaf:assertsValue": {
        "@value": "A generator shall mark or label the generator's container with both the words \"Hazardous Waste\" and an indication of the hazards of the contents [examples include, but are not limited to, the applicable hazardous waste characteristics (i.e., ignitable, corrosive, reactive, toxic); hazard communication consistent with the department of transportation requirements at 49 CFR Part 172 subpart E (labeling) or subpart F (placarding); a hazard statement or pictogram consistent with the occupational safety and health administration hazard communication standard at 29 CFR 1910.1200; or a chemical hazard label consistent with the national fire protection association code 704].",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

    {
      "@id": "urn:rulespec:document-understanding:revision:317585d3f6fbc84885479f07556520c1ca15e10f5f90a5547c87db21e7341994",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:317585d3f6fbc84885479f07556520c1ca15e10f5f90a5547c87db21e7341994",

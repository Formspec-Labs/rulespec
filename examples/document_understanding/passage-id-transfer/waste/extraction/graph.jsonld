      "rkaf:assertsValue": {
        "@value": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[\"(1) If a container holding hazardous waste is not in good condition, or if the container begins to leak, the generator shall immediately transfer the hazardous waste from this container to a container that is in good condition and does not leak, or immediately transfer and manage the waste in a central accumulation area operated in compliance with paragraph (B) of rule 3745-52-16 or paragraph (A) of rule 3745-52-17 of the Administrative Code.\"],\"choice_text\":\"immediately transfer the hazardous waste from this container to a container that is in good condition and does not leak, or immediately transfer and manage the waste in a central accumulation area operated in compliance with paragraph (B) of rule 3745-52-16 or paragraph (A) of rule 3745-52-17 of the Administrative Code\",\"claimants\":[],\"concepts\":[],\"effective_periods\":[],\"jurisdiction\":\"\",\"kind\":\"requirement\",\"logic_text\":\"(1) If a container holding hazardous waste is not in good condition, or if the container begins to leak, the generator shall immediately transfer the hazardous waste from this container to a container that is in good condition and does not leak, or immediately transfer and manage the waste in a central accumulation area operated in compliance with paragraph (B) of rule 3745-52-16 or paragraph (A) of rule 3745-52-17 of the Administrative Code.\",\"modality\":\"must\",\"object\":\"\",\"scope_text\":\"For satellite accumulation under the conditions for exemption in this rule, if a container holding hazardous waste is not in good condition, or if the container begins to leak.\",\"summary\":\"If a container holding hazardous waste in satellite accumulation is not in good condition, or if the container begins to leak, the generator shall immediately transfer the hazardous waste from this container to a container that is in good condition and does not leak, or immediately transfer and manage the waste in a central accumulation area operated in compliance with paragraph (B) of rule 3745-52-16 or paragraph (A) of rule 3745-52-17 of the Administrative Code.\",\"typed_values\":[]}",

    {
      "@id": "urn:rulespec:document-understanding:scope:00a07b2a5dbfd6c0d42caa4e67f87f7a2d1074f55594d979352cb3661083ae89",
      "@type": "rkaf:ApplicabilityScope",
      "rkaf:appliesInJurisdiction": [],
      "rkaf:applicabilityCondition": "When a generator accumulates either acute hazardous waste listed in rule 3745-51-31 or paragraph (E) of rule 3745-51-33 of the Administrative Code or non-acute hazardous waste in excess of the amounts listed in paragraph (A) of rule 3745-52-15 at or near any point of generation."
    },
    {
      "@id": "urn:rulespec:document-understanding:assertion:1170b1447579ba1f0ab047327b696eaf22b01d5077466105a6f4cd9ff420cea4",
      "@type": "rkaf:ValueAssertion",
      "rkaf:assertionOrigin": "rkaf:aiSuggested",
      "rkaf:epistemicBasis": "rkaf:statisticalInference",
      "rkaf:usageEligibility": "rkaf:reviewQueueOnly",
      "rkaf:consumerLifecycleState": "rkaf:draft",
      "rkaf:hasAILineage": "urn:rulespec:document-understanding:lineage:6a81e6cd04a704c924f1496d2c489ac50bae4ed9f9677e4e95e89f7db8e5ba12",
      "rkaf:hasExtractionProvenance": "urn:rulespec:document-understanding:activity:f1449533e247f73bcc23f3616dd32110f41821e02ee9d0d47cdd5dfb527ae0d6",
      "rkaf:assertsSubject": "urn:rulespec:document-understanding:rule:5994ed69991b50d93dac432dc4256e48d30ed62de7bd37af0065899ade4cd42a",
      "rkaf:assertsPredicate": "urn:rulespec:document-understanding:states-requirement",
      "rkaf:assertsValue": {
        "@value": "A generator who accumulates either acute hazardous waste listed in rule 3745-51-31 or paragraph (E) of rule 3745-51-33 of the Administrative Code or non-acute hazardous waste in excess of the amounts listed in paragraph (A) of rule 3745-52-15 at or near any point of generation shall, within three consecutive calendar days, comply with the applicable central accumulation area requirements in paragraph (B) of rule 3745-52-16 or paragraph (A) of rule 3745-52-17 of the Administrative Code, or remove the excess from the satellite accumulation area within three consecutive calendar days to either a central accumulation area operated in accordance with the applicable requirements in paragraph (B) of rule 3745-52-16 or paragraph (A) of rule 3745-52-17 of the Administrative Code, an on-site permit by rule or permitted treatment, storage, or disposal facility, or an off-site designated facility.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"

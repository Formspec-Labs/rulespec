      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:9e40cacd83ae58f8883613e91351ef4f515e73222cc8d35d7f447255af36a744\",\"urn:rulespec:document-understanding:assertion:9bd94201871270cf7694094ef323598464f5927fd0a25f016819b8eba635730a\",\"urn:rulespec:document-understanding:assertion:e36a1129c83eb4b9ea8f8f9e632ecb3a9e61922f108e1bfedf90fea68f5da874\",\"urn:rulespec:document-understanding:assertion:342328bf5bdd58ab4bd6cf6c61e343dc8d4935fd320264733eee9c06265073e7\",\"urn:rulespec:document-understanding:assertion:7c30498ffaca2e625c2600e1bc08c5d49b656992005ac838a6747b235c3c8a2d\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"effective_periods\":[],\"end\":5423,\"evidence\":[{\"end\":5423,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A43f75aaf4a19870db19d481dd6883f99ef4c606c7cb4914012a118a12fbce149:5134:5423:sha256-21a48e3489b6fbaf084f72e9f018ce9e15e530f878dabc222e4852420e629c5a\",\"quote\":\"(7) All satellite accumulation areas operated by a small quantity generator shall meet the preparedness and prevention requirements of paragraph (B)(8) of rule 3745-52-16 of the Administrative Code and emergency procedures of paragraph (B)(9) of rule 3745-52-16 of the Administrative Code.\",\"start\":5134},{\"end\":5423,\"field\":\"logic_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A43f75aaf4a19870db19d481dd6883f99ef4c606c7cb4914012a118a12fbce149:5134:5423:sha256-21a48e3489b6fbaf084f72e9f018ce9e15e530f878dabc222e4852420e629c5a\",\"quote\":\"(7) All satellite accumulation areas operated by a small quantity generator shall meet the preparedness and prevention requirements of paragraph (B)(8) of rule 3745-52-16 of the Administrative Code and emergency procedures of paragraph (B)(9) of rule 3745-52-16 of the Administrative Code.\",\"start\":5134},{\"end\":5215,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A43f75aaf4a19870db19d481dd6883f99ef4c606c7cb4914012a118a12fbce149:5210:5215:sha256-56ee5b508706bf2de91712d85d6d1e11ddbff01949142ed6e8c22e3b1bed1c71\",\"quote\":\"shall\",\"start\":5210},{\"end\":1309,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A43f75aaf4a19870db19d481dd6883f99ef4c606c7cb4914012a118a12fbce149:121:1309:sha256-b1f414f71874caa7cb1888a99a7de9b50bfee7c357001f3a76143b7503ec786d\",\"quote\":\"(A) A generator may accumulate as much as fifty-five gallons of non-acute hazardous waste and either one quart of liquid acute hazardous waste listed in rule 3745-51-31 or paragraph (E) of rule 3745-51-33 of the Administrative Code or one kilogram (kg) (2.2 pounds) of solid acute hazardous waste listed in rule 3745-51-31 or paragraph (E) of rule 3745-51-33 of the Administrative Code in containers at or near any point of generation where wastes initially accumulate which is under the control of the operator of the process generating the waste, without a permit or permit by rule and without complying with the requirements of Chapters 3745-50, 3745-54 to 3745-57 and 3745-205, 3745-65 to 3745-69 and 3745-256, 3745-266, and 3745-267 of the Administrative Code, provided that all of the conditions for exemption in this rule are met. A generator may comply with the conditions for exemption in this rule instead of complying with the conditions for exemption in paragraph (B) of rule 3745-52-16 or paragraph (A) of rule 3745-52-17 of the Administrative Code, except as required in paragraphs (A)(7) and (A)(8) of this rule. The conditions for exemption for satellite accumulation are:\",\"start\":121},{\"end\":5423,\"field\":\"scope_text:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A43f75aaf4a19870db19d481dd6883f99ef4c606c7cb4914012a118a12fbce149:5134:5423:sha256-21a48e3489b6fbaf084f72e9f018ce9e15e530f878dabc222e4852420e629c5a\",\"quote\":\"(7) All satellite accumulation areas operated by a small quantity generator shall meet the preparedness and prevention requirements of paragraph (B)(8) of rule 3745-52-16 of the Administrative Code and emergency procedures of paragraph (B)(9) of rule 3745-52-16 of the Administrative Code.\",\"start\":5134}],\"id\":\"urn:rulespec:document-understanding:revision:317585d3f6fbc84885479f07556520c1ca15e10f5f90a5547c87db21e7341994\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"(7) All satellite accumulation areas operated by a small quantity generator shall meet the preparedness and prevention requirements of paragraph (B)(8) of rule 3745-52-16 of the Administrative Code and emergency procedures of paragraph (B)(9) of rule 3745-52-16 of the Administrative Code.\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:7c30498ffaca2e625c2600e1bc08c5d49b656992005ac838a6747b235c3c8a2d\",\"modality\":\"must\",\"modality_quote\":\"shall\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:58920f4e874e4c8d816f84bbf38186b940c589de6efd75b286aa9c8a3f9c169c\",\"origin\":\"aiSuggested\",\"quote\":\"(7) All satellite accumulation areas operated by a small quantity generator shall meet the preparedness and prevention requirements of paragraph (B)(8) of rule 3745-52-16 of the Administrative Code and emergency procedures of paragraph (B)(9) of rule 3745-52-16 of the Administrative Code.\",\"references\":[\"paragraph (B)(8) of rule 3745-52-16\",\"paragraph (B)(9) of rule 3745-52-16\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:d7968cb6799b347c6569309d682b27d9723ba747a9a0003024289e3745a737ea\",\"scope_quotes\":[\"(A) A generator may accumulate as much as fifty-five gallons of non-acute hazardous waste and either one quart of liquid acute hazardous waste listed in rule 3745-51-31 or paragraph (E) of rule 3745-51-33 of the Administrative Code or one kilogram (kg) (2.2 pounds) of solid acute hazardous waste listed in rule 3745-51-31 or paragraph (E) of rule 3745-51-33 of the Administrative Code in containers at or near any point of generation where wastes initially accumulate which is under the control of the operator of the process generating the waste, without a permit or permit by rule and without complying with the requirements of Chapters 3745-50, 3745-54 to 3745-57 and 3745-205, 3745-65 to 3745-69 and 3745-256, 3745-266, and 3745-267 of the Administrative Code, provided that all of the conditions for exemption in this rule are met. A generator may comply with the conditions for exemption in this rule instead of complying with the conditions for exemption in paragraph (B) of rule 3745-52-16 or paragraph (A) of rule 3745-52-17 of the Administrative Code, except as required in paragraphs (A)(7) and (A)(8) of this rule. The conditions for exemption for satellite accumulation are:\",\"(7) All satellite accumulation areas operated by a small quantity generator shall meet the preparedness and prevention requirements of paragraph (B)(8) of rule 3745-52-16 of the Administrative Code and emergency procedures of paragraph (B)(9) of rule 3745-52-16 of the Administrative Code.\"],\"scope_text\":\"For all satellite accumulation areas operated by a small quantity generator.\",\"section_id\":\"section-1\",\"start\":5134,\"summary\":\"All satellite accumulation areas operated by a small quantity generator shall meet the preparedness and prevention requirements of paragraph (B)(8) of rule 3745-52-16 of the Administrative Code and emergency procedures of paragraph (B)(9) of rule 3745-52-16 of the Administrative Code.\",\"target_ids\":[],\"typed_values\":[]}",

      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:b500d66130177665a737d14c41b7501ba758fb3e074ee927d863762e97e4e428\",\"urn:rulespec:document-understanding:assertion:abdbe2c04d172bac827eded1ee911414c0f8594cf19ad3da41a13417ce614179\",\"urn:rulespec:document-understanding:assertion:55e5a08db615830fda3384c18da16a2cacb7a630afd3f90b23dd7c119e4aac2c\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"effective_periods\":[],\"end\":2386,\"evidence\":[{\"end\":2386,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa150f4ee3b06251ce1b4533a18231db38769787697dbaee26861e227c43e353a:1578:2386:sha256-83916a909e28b50c3312da2eb87b8cec508edf844f37aae0b6ab9c59915e8b04\",\"quote\":\"c. INs are standardized notices that provide passport bearers with information about their passports. For example, an IN may be included to explain why the passport was limited in validity, and/or what documentation is needed to obtain a fully valid passport. The INs have been carefully crafted to communicate this information clearly and accurately. Consequently, no changes or alterations to the INs may be made unilaterally at passport agencies/centers without the approval of CA/PPT/S/A except in extenuating circumstances on a case-by-case basis with the approval of passport agency/center management, e.g., when using an endorsement 46 to limit a passport for a special problem. INs do not require a response from the applicant and do not need to be personalized with the applicant's name and address.\",\"start\":1578}],\"id\":\"urn:rulespec:document-understanding:revision:8f627d4736a643d1e852624b79adee8594f6d09133f5761a46ce1fb50e7a981b\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"statement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-un
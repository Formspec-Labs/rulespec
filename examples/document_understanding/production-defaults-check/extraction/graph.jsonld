      "dcterms:description": "{\"action\":\"\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:b97b76326ad2e41c0a29536e2e6daf9c2ac1f5b99dd1d8ffdcd105d44c8b5625\",\"urn:rulespec:document-understanding:assertion:925f6ccec9e20f48694b6e232e2eb2d6b83a3c4ed8e7edd3e39470d7cabaf96b\",\"urn:rulespec:document-understanding:assertion:3ba426ea87a1efa810483e06203e9156f56c6a4bd57ad14e8ed5cc82d11f325c\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"claimants\":[],\"concepts\":[],\"context_quotes\":[],\"effective_periods\":[],\"end\":2386,\"evidence\":[{\"end\":2386,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa150f4ee3b06251ce1b4533a18231db38769787697dbaee26861e227c43e353a:1578:2386:sha256-83916a909e28b50c3312da2eb87b8cec508edf844f37aae0b6ab9c59915e8b04\",\"quote\":\"c. INs are standardized notices that provide passport bearers with information about their passports. For example, an IN may be included to explain why the passport was limited in validity, and/or what documentation is needed to obtain a fully valid passport. The INs have been carefully crafted to communicate this information clearly and accurately. Consequently, no changes or alterations to the INs may be made unilaterally at passport agencies/centers without the approval of CA/PPT/S/A except in extenuating circumstances on a case-by-case basis with the approval of passport agency/center management, e.g., when using an endorsement 46 to limit a passport for a special problem. INs do not require a response from the applicant and do not need to be personalized with the applicant's name and address.\",\"start\":1578}],\"id\":\"urn:rulespec:document-understanding:revision:831b0a74578a31021167e6c494ed29bfcc820656c9e01235f6f31c6ff77a96ad\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"definition\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:3ba426ea87a1efa810483e06203e9156f56c6a4bd57ad14e8ed5cc82d11f325c\",\"modality\":\"not_stated\",\"modality_quote\":\"\",\"object\":\"\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:20d61139f21c5eee18b6e54caa8c84647db83a2152a52e5565d3a0db2bb6434c\",\"origin\":\"aiSuggested\",\"quote\":\"c. INs are standardized notices that provide passport bearers with information about their passports. For example, an IN may be included to explain why the passport was limited in validity, and/or what documentation is needed to obtain a fully valid passport. The INs have been carefully crafted to communicate this information clearly and accurately. Consequently, no changes or alterations to the INs may be made unilaterally at passport agencies/centers without the approval of CA/PPT/S/A except in extenuating circumstances on a case-by-case basis with the approval of passport agency/center management, e.g., when using an endorsement 46 to limit a passport for a special problem. INs do not require a response from the applicant and do not need to be personalized with the applicant's name and address.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:9ed904d7c3856350f85b8d6ae6c3126d28a38d5073a3b0dabdf5b6b2b6b5ccc1\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"section-1\",\"start\":1578,\"summary\":\"INs are standardized notices that provide passport bearers with information about their passports.\",\"target_ids\":[],\"typed_values\":[]}",

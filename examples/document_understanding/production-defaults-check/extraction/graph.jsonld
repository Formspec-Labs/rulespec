      "rkaf:assertsValue": {
        "@value": "An IN may be included to explain why the passport was limited in validity, and/or what documentation is needed to obtain a fully valid passport.",
        "@language": "en"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },
    {
      "@id": "urn:rulespec:document-understanding:binding:c1f62f643b82c63b74a50e9558e9b7bc46750dd0c0b7f87b44011aacbef7da19",

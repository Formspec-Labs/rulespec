3ebcac303ffe310d:2498:2570:sha256-28c314c219458effcb2557e357e016f140d9ec3a34b8275717d73c2796a2c77f\",\"quote\":\"A medical statement signed by a medical professional/health practitioner\",\"start\":2498},{\"end\":2575,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa7f2fa63b4fd8d84f7248084399270fb141ec6211efd20993ebcac303ffe310d:2571:2575:sha256-4137b01e139589b7a1d3b3fc4da031d8ce5bb415808734e970c3a58ea0e98f0f\",\"quote\":\"must\",\"start\":2571},{\"end\":2616,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa7f2fa63b4fd8d84f7248084399270fb141ec6211efd20993ebcac303ffe310d:2589:2616:sha256-4861d9d72b29c6b45495380cb2e3172458921a05c47319f20f86d1e288043465\",\"quote\":\"in these rare circumstances\",\"start\":2589},{\"end\":2497,\"field\":\"scope_text:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa7f2fa63b4fd8d84f7248084399270fb141ec6211efd20993ebcac303ffe310d:2329:2497:sha256-0ff29214af9dc2c99db5767b0dafca4fb1bbdbc4e1f26831dc9884e7b966553e\",\"quote\":\"unless they cannot be removed for medical reasons, e.g., the applicant has recently had ocular surgery and the eyeglasses are necessary to protect the applicant’s eyes.\",\"start\":2329}],\"id\":\"urn:rulespec:document-understanding:revision:d5f8bb7020406cde428eed24c66e55736921304b5f3425d2f7b2076dfb220809\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:bd5ea63b0ba95ab8a932b778cbc1f4d4355a92daed4029aa0c8b79d7afb68bc2\",\"modality\":\"must\",\"modality_quote\":\"must\",\"object\":\"a medical statement signed by a medical professional or health practitioner\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:e9f671168b0cd0eab8d482355749bf7ee91a78d7cdc280552550a9150c3e9dee\",\"origin\":\"aiSuggested\",\"quote\":\"
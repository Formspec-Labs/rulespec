      "dcterms:description": "{\"action\":\"accept a photograph without a natural or unexaggerated expression\",\"actor\":\"passport adjudicator / specialist\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:151901657afb3e3574d94b2930edb1f1b44f7aa22d2a803e028e77a084180fc4\",\"urn:rulespec:document-understanding:assertion:41f5d048bf71d3a015ec7350c1ecf993f310d6237ab839897aad13cfd0e5932d\",\"urn:rulespec:document-understanding:assertion:cd68a3d17cc218a1adbaafc2c086da57a612e624a412f6ff00ea6ae2fa9bfdd3\",\"urn:rulespec:document-understanding:assertion:a8aae244005030b4849aa97576e81cdf4b14163a3d4300591e417a57bc327a5d\",\"urn:rulespec:document-understanding:assertion:f0029d119fff4581daf890cd6b1a56863816e6ee6ac6d41806e5def56886a122\",\"urn:rulespec:document-understanding:assertion:677bd8853414b74c98bd8966e98893605f528faf41879ad3492b5d21ba4d3b48\",\"urn:rulespec:document-understanding:assertion:8a56f1045bf5232d83c752bc5391c516c123415eb156b0ae7051fb1eeab57e7f\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"context_quotes\":[],\"end\":3729,\"evidence\":[{\"end\":3729,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa7f2fa63b4fd8d84f7248084399270fb141ec6211efd20993ebcac303ffe310d:3633:3729:sha256-c4d2419126971f584ea0cf849a9e9983c4b86fbe9d088458dcc12f587fda1c26\",\"quote\":\"You may accept a photograph without a natural or unexaggerated expression in these circumstances\",\"start\":3633},{\"end\":3636,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa7f2fa63b4fd8d84f7248084399270fb141ec6211efd20993ebcac303ffe310d:3633:3636:sha256-08b041935798fbf6fd6ff51099ffedb140a475889986d14f5559ff8e7fc571dd\",\"quote\":\"You\",\"start\":3633},{\"end\":3647,\"field\":\"action\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa7f2fa63b4fd8d84f7248084399270fb141ec6211efd20993ebcac303ffe310d:3641:3647:sha256-c125d0397b605657bc89340953f5f2897a7e00a9b7d3474fa53720c8ccbbb3e3\",\"quote\":\"accept\",\"start\":3641},{\"end\":3706,\"field\":\"object\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa7f2fa63b4fd8d84f7248084399270fb141ec6211efd20993ebcac303ffe310d:3648:3706:sha256-2cfd185d5c0105d69fad4a0d7eab585d64f819794ffc457abc1352a293694847\",\"quote\":\"a photograph without a natural or unexaggerated expression\",\"start\":3648},{\"end\":3640,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa7f2fa63b4fd8d84f7248084399270fb141ec6211efd20993ebcac303ffe310d:3637:3640:sha256-ee4d988c65de860fabbfbcd27f73d50bbebe3fba37fe419284f4811389c30bdc\",\"quote\":\"may\",\"start\":3637},{\"end\":3632,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa7f2fa63b4fd8d84f7248084399270fb141ec6211efd20993ebcac303ffe310d:3396:3632:sha256-d7cac22adf77ead249d059aa8b41a4a66cd04e496d1d76c3c322f4fa60aaee2b\",\"quote\":\"Applicants with physical or mental disabilities, including loss of muscle control (e.g., age-related degeneration or because of a medical condition such as Bell's Palsy), may not be able to produce a natural or unexaggerated expression.\",\"start\":3396},{\"end\":3729,\"field\":\"scope_text:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aa7f2fa63b4fd8d84f7248084399270fb141ec6211efd20993ebcac303ffe310d:3707:3729:sha256-a2be6136b24bec187a817a3d6e6ae7848199041507110a45e73c0682aca85b72\",\"quote\":\"in these circumstances\",\"start\":3707}],\"id\":\"urn:rulespec:document-understanding:revision:1530b5d4ce78126e7ea3308e7302fd4893bae3d1401e2736e233e76a81e5c804\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"permission\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:8a56f1045bf5232d83c752bc5391c516c123415eb156b0ae7051fb1eeab57e7f\",\"modality\":\"may\",\"modality_quote\":\"may\",\"object\":\"a photograph without a natural or unexaggerated expression\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:7b62b7f3da0c430b28c76e1fd44c040d8b52c92e843c57eb43ef55e099b49398\",\"origin\":\"aiSuggested\",\"quote\":\"You may accept a photograph without a natural or unexaggerated expression in these circumstances\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:5f8e9911422688438c0ce4219b012bcc656d4c56d49391b2d899d9b99bfcb233\",\"scope_quotes\":[\"Applicants with physical or mental disabilities, including loss of muscle control (e.g., age-related degeneration or because of a medical condition such as Bell's Palsy), may not be able to produce a natural or unexaggerated expression.\",\"in these circumstances\"],\"scope_text\":\"When applicants have physical or mental disabilities (including loss of muscle control) that prevent producing a natural or unexaggerated expression.\",\"section_id\":\"fam-photos-05\",\"start\":3633,\"summary\":\"Adjudicators may accept a photograph without a natural or unexaggerated expression if the applicant has physical or mental disabilities preventing it.\",\"target_ids\":[]}",

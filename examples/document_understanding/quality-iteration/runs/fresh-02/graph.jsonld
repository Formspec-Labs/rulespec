      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"issue\",\"actor\":\"Passport Specialist or Consular Officer\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:7d0489a487d21bda1879ab187ac1dacb4f4fc03ec1d17d3d6f5fe80df9d78d39\",\"urn:rulespec:document-understanding:assertion:aed9a3fd435e35a97825845251c981e8b1c4292be8b859fffebe30383b4ec191\",\"urn:rulespec:document-understanding:assertion:4b37883ac399c52b4b2d377131055f9b2a7ee3aa85eb2086b7a49445c6b139ba\",\"urn:rulespec:document-understanding:assertion:f654b7abc66c1b4c213726d81fbce112f7b83a845f2031bedf8f05b4db217d8e\",\"urn:rulespec:document-understanding:assertion:64fc4b28cdb7dd12a157d3e084d7524ac67b2c0f4131ec933d1c56ebccf067d0\",\"urn:rulespec:document-understanding:assertion:0006ec3cc3ee5b3663317ffe257c15c372f55c0e77e442a1149df75d3a1e2700\",\"urn:rulespec:document-understanding:assertion:02f0debdf93bb8c1114226892ecf6a5f911f402a5471cf5b3954583344575e1b\",\"urn:rulespec:document-understanding:assertion:cac46918144bfcc7c1d26b6d5ce60c8709f98f71d9e9c8c7d2a7e6d820db770d\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"context_quotes\":[],\"end\":1277,\"evidence\":[{\"end\":1277,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ac18560fe79c0a5c89b4be4844b696ec79555b0efe6f3bdedf4f3008774d6a8b1:1023:1277:sha256-3ef86cacdc3b8e68b2bc4e12fc9a421edc04deaed12059c7d25f44504b4b9ca5\",\"quote\":\"You must issue the passport application if the applicant is entitled to the passport, has met the standard of evidence for both identity and citizenship, the passport application is acceptable in its totality, and there are no other barriers to issuance.\",\"start\":1023},{\"end\":1026,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ac18560fe79c0a5c89b4be4844b696ec79555b0efe6f3bdedf4f3008774d6a8b1:1023:1026:sha256-08b041935798fbf6fd6ff51099ffedb140a475889986d14f5559ff8e7fc571dd\",\"quote\":\"You\",\"start\":1023},{\"end\":1037,\"field\":\"action\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ac18560fe79c0a5c89b4be4844b696ec79555b0efe6f3bdedf4f3008774d6a8b1:1027:1037:sha256-6b98f7534c683696c82d8d7098da88fb72533b67164f84ece50509ae04ab1e3e\",\"quote\":\"must issue\",\"start\":1027},{\"end\":1276,\"field\":\"logic_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ac18560fe79c0a5c89b4be4844b696ec79555b0efe6f3bdedf4f3008774d6a8b1:1063:1276:sha256-1cc605768d1133bab01f13411f1f8e50a001ada02dfe3ee9fbe6fed5d4c91058\",\"quote\":\"if the applicant is entitled to the passport, has met the standard of evidence for both identity and citizenship, the passport application is acceptable in its totality, and there are no other barriers to issuance\",\"start\":1063},{\"end\":1031,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ac18560fe79c0a5c89b4be4844b696ec79555b0efe6f3bdedf4f3008774d6a8b1:1027:1031:sha256-4137b01e139589b7a1d3b3fc4da031d8ce5bb415808734e970c3a58ea0e98f0f\",\"quote\":\"must\",\"start\":1027},{\"end\":1276,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ac18560fe79c0a5c89b4be4844b696ec79555b0efe6f3bdedf4f3008774d6a8b1:1063:1276:sha256-1cc605768d1133bab01f13411f1f8e50a001ada02dfe3ee9fbe6fed5d4c91058\",\"quote\":\"if the applicant is entitled to the passport, has met the standard of evidence for both identity and citizenship, the passport application is acceptable in its totality, and there are no other barriers to issuance\",\"start\":1063}],\"id\":\"urn:rulespec:document-understanding:revision:c85c575cf1f9ccb65637c758262ee13ac0bd4fc8d46ac7924447d05f59bb62ae\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"if the applicant is entitled to the passport, has met the standard of evidence for both identity and citizenship, the passport application is acceptable in its totality, and there are no other barriers to issuance\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:cac46918144bfcc7c1d26b6d5ce60c8709f98f71d9e9c8c7d2a7e6d820db770d\",\"modality\":\"must\",\"modality_quote\":\"must\",\"object\":\"the passport application\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:35e7c7860c24f146611d954ea2ed261df1bf5ac0229ee443d8a81d68ee1a78ae\",\"origin\":\"aiSuggested\",\"quote\":\"You must issue the passport application if the applicant is entitled to the passport, has met the standard of evidence for both identity and citizenship, the passport application is acceptable in its totality, and there are no other barriers to issuance.\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:ef32920a2debf899b36682e8b5f716d1c0a1ecfde80e59488faa8f6e693c044a\",\"scope_quotes\":[\"if the applicant is entitled to the passport, has met the standard of evidence for both identity and citizenship, the passport application is acceptable in its totality, and there are no other barriers to issuance\"],\"scope_text\":\"if the applicant is entitled to the passport, has met the standard of evidence for both identity and citizenship, the passport application is acceptable in its totality, and there are no other barriers to issuance\",\"section_id\":\"section-1\",\"start\":1023,\"summary\":\"The officer must issue the passport application if the applicant is entitled to it, satisfies evidentiary standards for identity and citizenship, the application is acceptable overall, and no other barriers to issuance exist.\",\"target_ids\":[]}",

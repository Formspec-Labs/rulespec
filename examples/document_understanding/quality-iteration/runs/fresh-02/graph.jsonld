      "dcterms:description": "{\"action\":\"ensure that the passport application is acceptable in its totality and resolve any outstanding issues\",\"actor\":\"Passport Specialist or Consular Officer\",\"alternative_quotes\":[\"suspending\",\"referring, as appropriate, the passport application\"],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:6d0edb8b2b5d5420c3af8e037849b727c77c3467d76e662020c897943105aebb\",\"urn:rulespec:document-understanding:assertion:80ea95e1d5642571ad6a8bb4c16e3c5582274c4cf8f89743beaecdfce5f3d56c\",\"urn:rulespec:document-understanding:assertion:9b62d395455195c7bff56e934908b094a68549ab0df44bb8bc0ec66c28f755ad\",\"urn:rulespec:document-understanding:assertion:533701b1f90198875ed60548689ae2500dfe80d4224248045f919999db7dbf9c\",\"urn:rulespec:document-understanding:assertion:9e1b8e5bff38738363755a77affe0f88ecfb2b6a0c892bdebc7719d7f624aa17\",\"urn:rulespec:document-understanding:assertion:f8e2cb4294f563b821fd355583bac2639ecb2704d6100e8989c507ffd07c1208\",\"urn:rulespec:document-understanding:assertion:ec452fb27d3fc728b0f723c76f204a5adf73d681be53cd583c7e71158ea22c0b\",\"urn:rulespec:document-understanding:assertion:e8e74ec708a02d6f5b8d00f39810e73ff68d930247187cf48c7d28ee62bdfdd5\",\"urn:rulespec:document-understanding:assertion:8ecef9858406cd40c81c41954ae81568eebb53d6031c0c7cd38e1157bd10bad3\",\"urn:rulespec:document-understanding:assertion:baa7ceba59487cc2f387b9b0f7b14a99ec9d49d83b6a75d6fbf3ee178fa4311b\"],\"choice_quote\":\"suspending or referring, as appropriate, the passport application\",\"choice_text\":\"suspending OR referring, as appropriate, the passport application\",\"context_quotes\":[],\"end\":1592,\"evidence\":[{\"end\":1592,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Ac18560fe79c0a5c89b4be4844b696ec79555b0efe6f3bdedf4f3008774d6a8b1:1282:1592:sha256-394b1485cedf0c2ba5bdb11b85e3b950a72f9cebe236958948ce9108dd8a4cd7\",\"quote\":\"You mu
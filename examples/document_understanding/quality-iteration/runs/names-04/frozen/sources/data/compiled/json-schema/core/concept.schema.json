{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rulespec.org/jsonschema/concept.json",
  "title": "concept",
  "$defs": {
    "PreferredLabelMap": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^(?:(?:[A-Za-z]{2,3}(?:-[A-Za-z]{3}){0,3}|[A-Za-z]{4}|[A-Za-z]{5,8})(?:-[A-Za-z]{4})?(?:-(?:[A-Za-z]{2}|[0-9]{3}))?(?:-(?:[A-Za-z0-9]{5,8}|[0-9][A-Za-z0-9]{3}))*(?:-[0-9A-WY-Za-wy-z](?:-[A-Za-z0-9]{2,8})+)*(?:-[xX](?:-[A-Za-z0-9]{1,8})+)?|[xX](?:-[A-Za-z0-9]{1,8})+|[eE][nN]-[gG][bB]-[oO][eE][dD]|[iI]-(?:[aA][mM][iI]|[bB][nN][nN]|[dD][eE][fF][aA][uU][lL][tT]|[eE][nN][oO][cC][hH][iI][aA][nN]|[hH][aA][kK]|[kK][lL][iI][nN][gG][oO][nN]|[lL][uU][xX]|[mM][iI][nN][gG][oO]|[nN][aA][vV][aA][jJ][oO]|[pP][wW][nN]|[tT][aA][oO]|[tT][aA][yY]|[tT][sS][uU])|[sS][gG][nN]-(?:[bB][eE]-[fF][rR]|[bB][eE]-[nN][lL]|[cC][hH]-[dD][eE])|[aA][rR][tT]-[lL][oO][jJ][bB][aA][nN]|[cC][eE][lL]-[gG][aA][uU][lL][iI][sS][hH]|[nN][oO]-(?:[bB][oO][kK]|[nN][yY][nN])|[zZ][hH]-(?:[gG][uU][oO][yY][uU]|[hH][aA][kK][kK][aA]|[mM][iI][nN]|[mM][iI][nN]-[nN][aA][nN]|[xX][iI][aA][nN][gG]))$",
        "not": {
          "pattern": "^@none$"
        }
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[\\s\\S]+$"
      },
      "minProperties": 1
    },
    "VocabularyTextMap": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^(?:(?:[A-Za-z]{2,3}(?:-[A-Za-z]{3}){0,3}|[A-Za-z]{4}|[A-Za-z]{5,8})(?:-[A-Za-z]{4})?(?:-(?:[A-Za-z]{2}|[0-9]{3}))?(?:-(?:[A-Za-z0-9]{5,8}|[0-9][A-Za-z0-9]{3}))*(?:-[0-9A-WY-Za-wy-z](?:-[A-Za-z0-9]{2,8})+)*(?:-[xX](?:-[A-Za-z0-9]{1,8})+)?|[xX](?:-[A-Za-z0-9]{1,8})+|[eE][nN]-[gG][bB]-[oO][eE][dD]|[iI]-(?:[aA][mM][iI]|[bB][nN][nN]|[dD][eE][fF][aA][uU][lL][tT]|[eE][nN][oO][cC][hH][iI][aA][nN]|[hH][aA][kK]|[kK][lL][iI][nN][gG][oO][nN]|[lL][uU][xX]|[mM][iI][nN][gG][oO]|[nN][aA][vV][aA][jJ][oO]|[pP][wW][nN]|[tT][aA][oO]|[tT][aA][yY]|[tT][sS][uU])|[sS][gG][nN]-(?:[bB][eE]-[fF][rR]|[bB][eE]-[nN][lL]|[cC][hH]-[dD][eE])|[aA][rR][tT]-[lL][oO][jJ][bB][aA][nN]|[cC][eE][lL]-[gG][aA][uU][lL][iI][sS][hH]|[nN][oO]-(?:[bB][oO][kK]|[nN][yY][nN])|[zZ][hH]-(?:[gG][uU][oO][yY][uU]|[hH][aA][kK][kK][aA]|[mM][iI][nN]|[mM][iI][nN]-[nN][aA][nN]|[xX][iI][aA][nN][gG]))$",
        "not": {
          "pattern": "^@none$"
        }
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "^[\\s\\S]+$"
          },
          {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[\\s\\S]+$"
            },
            "minItems": 1
          }
        ]
      },
      "minProperties": 1
    },
    "NotationLiteral": {
      "type": "object",
      "properties": {
        "@value": {
          "type": "string",
          "pattern": "^[\\s\\S]+$"
        },
        "@type": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
        }
      },
      "required": [
        "@value",
        "@type"
      ],
      "additionalProperties": false
    },
    "ConceptScheme": {
      "type": "object",
      "properties": {
        "rkaf:managedByRegistry": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
        },
        "rkaf:definedInScope": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
        },
        "@type": {
          "const": "rkaf:ConceptScheme"
        },
        "skos:prefLabel": {
          "$ref": "#/$defs/PreferredLabelMap"
        },
        "skos:altLabel": {
          "$ref": "#/$defs/VocabularyTextMap"
        },
        "skos:hiddenLabel": {
          "$ref": "#/$defs/VocabularyTextMap"
        },
        "skos:definition": {
          "$ref": "#/$defs/VocabularyTextMap"
        },
        "skos:example": {
          "$ref": "#/$defs/VocabularyTextMap"
        },
        "skos:note": {
          "$ref": "#/$defs/VocabularyTextMap"
        },
        "skos:scopeNote": {
          "$ref": "#/$defs/VocabularyTextMap"
        },
        "skos:changeNote": {
          "$ref": "#/$defs/VocabularyTextMap"
        },
        "skos:editorialNote": {
          "$ref": "#/$defs/VocabularyTextMap"
        },
        "skos:historyNote": {
          "$ref": "#/$defs/VocabularyTextMap"
        },
        "rkaf:schemeFacet": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
        },
        "skos:hasTopConcept": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
              }
            }
          ]
        }
      },
      "required": [
        "@type",
        "skos:prefLabel",
        "rkaf:schemeFacet"
      ],
      "allOf": [
        {
          "anyOf": [
            {
              "properties": {
                "rkaf:managedByRegistry": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
                }
              },
              "required": [
                "rkaf:managedByRegistry"
              ]
            },
            {
              "properties": {
                "rkaf:definedInScope": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
                }
              },
              "required": [
                "rkaf:definedInScope"
              ]
            }
          ]
        }
      ]
    },
    "RegisteredConcept": {
      "type": "object",
      "properties": {
        "@type": {
          "const": "rkaf:RegisteredConcept"
        },
        "skos:prefLabel": {
          "$ref": "#/$defs/PreferredLabelMap"
        },
        "skos:altLabel": {
          "$ref": "#/$defs/VocabularyTextMap"
        },
        "skos:hiddenLabel": {
          "$ref": "#/$defs/VocabularyTextMap"
        },
        "skos:definition": {
          "$ref": "#/$defs/VocabularyTextMap"
        },
        "skos:example": {
          "$ref": "#/$defs/VocabularyTextMap"
        },
        "skos:note": {
          "$ref": "#/$defs/VocabularyTextMap"
        },
        "skos:scopeNote": {
          "$ref": "#/$defs/VocabularyTextMap"
        },
        "skos:changeNote": {
          "$ref": "#/$defs/VocabularyTextMap"
        },
        "skos:editorialNote": {
          "$ref": "#/$defs/VocabularyTextMap"
        },
        "skos:historyNote": {
          "$ref": "#/$defs/VocabularyTextMap"
        },
        "skos:notation": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NotationLiteral"
          },
          "minItems": 1
        },
        "skos:inScheme": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
        },
        "rkaf:managedByRegistry": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
        },
        "rkaf:conceptScope": {
          "type": "string"
        },
        "rkaf:registeredAt": {
          "type": "string"
        },
        "skos:broader": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
              }
            }
          ]
        },
        "skos:narrower": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
              }
            }
          ]
        },
        "skos:related": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
              }
            }
          ]
        }
      },
      "required": [
        "@type",
        "skos:prefLabel",
        "skos:inScheme",
        "rkaf:managedByRegistry",
        "rkaf:conceptScope",
        "rkaf:registeredAt"
      ]
    },
    "LocalConcept": {
      "type": "object",
      "properties": {
        "@type": {
          "const": "rkaf:LocalConcept"
        },
        "skos:prefLabel": {
          "$ref": "#/$defs/PreferredLabelMap"
        },
        "skos:altLabel": {
          "$ref": "#/$defs/VocabularyTextMap"
        },
        "skos:hiddenLabel": {
          "$ref": "#/$defs/VocabularyTextMap"
        },
        "skos:definition": {
          "$ref": "#/$defs/VocabularyTextMap"
        },
        "skos:example": {
          "$ref": "#/$defs/VocabularyTextMap"
        },
        "skos:note": {
          "$ref": "#/$defs/VocabularyTextMap"
        },
        "skos:scopeNote": {
          "$ref": "#/$defs/VocabularyTextMap"
        },
        "skos:changeNote": {
          "$ref": "#/$defs/VocabularyTextMap"
        },
        "skos:editorialNote": {
          "$ref": "#/$defs/VocabularyTextMap"
        },
        "skos:historyNote": {
          "$ref": "#/$defs/VocabularyTextMap"
        },
        "skos:notation": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NotationLiteral"
          },
          "minItems": 1
        },
        "skos:inScheme": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
        },
        "rkaf:definedInScope": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
        },
        "rkaf:conceptScope": {
          "type": "string"
        },
        "skos:broader": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
              }
            }
          ]
        },
        "skos:narrower": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
              }
            }
          ]
        },
        "skos:related": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
              }
            }
          ]
        }
      },
      "required": [
        "@type",
        "skos:prefLabel",
        "skos:inScheme",
        "rkaf:definedInScope",
        "rkaf:conceptScope"
      ]
    }
  }
}
      "dcterms:description": "{\"action\":\"issue a limited-validity passport in the requested name\",\"actor\":\"\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:4ed64682dbdd319c407590c36a3231ce0664ca250afae01d21652d4a989f89ca\",\"urn:rulespec:document-understanding:assertion:3306e9daa16af3e51653bad07ed0ebed132c3eb6f961de4853ca38b8baa3492e\",\"urn:rulespec:document-understanding:assertion:3bd3bbe2bd6d9d39352f35a02a028a18b58a86d66143b141f7ce92af64052a0c\",\"urn:rulespec:document-understanding:assertion:b086c1a32d183779d7858605766214e46877c92837a6d3a13f78874e0ebb3f5a\",\"urn:rulespec:document-understanding:assertion:accd588546126ba3fcaf1de8e777fd8823acb2f2bc7cea1eaa72665024ce56fa\",\"urn:rulespec:document-understanding:assertion:88771225a0d18824cf710e0fc866ea8262a521ee55e874f3d97428a1dbdebb40\",\"urn:rulespec:document-understanding:assertion:97cfbf190b87afd1109b6a000ca7ef0a6bd7a20a5eb07068af25b1fb40b4123a\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"context_quotes\":[],\"end\":2103,\"evidence\":[{\"end\":2103,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:1921:2103:sha256-0fdbf8386267c11baca8f4259546dc39828a560aa3cc96c2b0d436c3602b72a9\",\"quote\":\"If there is insufficient time to request that the applicant submit acceptable ID prior to urgent or emergency travel, a limited-validity passport may be issued in the requested name;\",\"start\":1921},{\"end\":2080,\"field\":\"action\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:2067:2080:sha256-15c3b4b23ab68a348949d6647a14d58a9edbc35a66b03ff7a613cb2a1e40cf76\",\"quote\":\"may be issued\",\"start\":2067},{\"end\":2066,\"field\":\"object\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:2039:2066:sha256-7c5242f452273d58b648473e49efef79268657cee618c30d4574f93e3a075b57\",\"quote\":\"a limited-validity passport\",\"start\":2039},{\"end\":2037,\"field\":\"logic_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:2002:2037:sha256-1f2d259d043c42c6d5afcb26ed13b6252df2be879d84986f14fbe0da2d9d585d\",\"quote\":\"prior to urgent or emergency travel\",\"start\":2002},{\"end\":2070,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:2067:2070:sha256-ee4d988c65de860fabbfbcd27f73d50bbebe3fba37fe419284f4811389c30bdc\",\"quote\":\"may\",\"start\":2067},{\"end\":1841,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:1676:1841:sha256-8d6e9a2e653ca62614166aac8953994fa3ed5eaadb3fe7d2c0dd5978ab49c209\",\"quote\":\"If the applicant has had a material name change more than one year prior to applying on form DS-11 but has not updated her/his ID to reflect the material name change\",\"start\":1676},{\"end\":2037,\"field\":\"scope_text:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:1921:2037:sha256-69672abdd23b79c9ab53977f6c04fc575dfcf5ce9f86af983bd20b44baa19026\",\"quote\":\"If there is insufficient time to request that the applicant submit acceptable ID prior to urgent or emergency travel\",\"start\":1921}],\"id\":\"urn:rulespec:document-understanding:revision:6c19ce06e0bb148fa66554335593ef91e54d07f2a78c0bbc076ae73961d195d9\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"permission\",\"logic_text\":\"prior to urgent or emergency travel\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:97cfbf190b87afd1109b6a000ca7ef0a6bd7a20a5eb07068af25b1fb40b4123a\",\"modality\":\"may\",\"modality_quote\":\"may\",\"object\":\"a limited-validity passport in the requested name\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:82b936cc7dc216af64404a9220ec67a22a9705d1b38bd7af7d5f49fb4a8fda68\",\"origin\":\"aiSuggested\",\"quote\":\"If there is insufficient time to request that the applicant submit acceptable ID prior to urgent or emergency travel, a limited-validity passport may be issued in the requested name;\",\"references\":[],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:58bb2631ed295becef561acb29ef704e663cb38196038d0d50ca7bb793d447cc\",\"scope_quotes\":[\"If the applicant has had a material name change more than one year prior to applying on form DS-11 but has not updated her/his ID to reflect the material name change\",\"If there is insufficient time to request that the applicant submit acceptable ID prior to urgent or emergency travel\"],\"scope_text\":\"If the applicant has had a material name change more than one year prior to applying on form DS-11 but has not updated her/his ID to reflect the material name change, and there is insufficient time to request submission of acceptable ID prior to urgent or emergency travel\",\"section_id\":\"fam-names-section-4\",\"start\":1921,\"summary\":\"When an applicant with a material name change over one year prior without updated ID faces urgent or emergency travel with insufficient time to request acceptable ID, a limited-validity passport may be issued in the requested name.\",\"target_ids\":[]}",

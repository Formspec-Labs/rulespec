      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"document by submission of one or more listed documents\",\"actor\":\"\",\"alternative_quotes\":[\"(a) Name change orders;\",\"(b) Divorce decrees;\",\"(2) Certificates of naturalization;\",\"(3) Marriage certificates;\",\"(4) Documentation demonstrating change of name by operation of state law; or\",\"(5) Documentation of customary usage.\"],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:796061e2be612f7d6e03debbb687a2416c17f742e9df0832d88f01a07c83e83e\",\"urn:rulespec:document-understanding:assertion:96eaca81c9dfd108bb92d60b51a6846d14dfc05834d0de91fe6f431386724040\",\"urn:rulespec:document-understanding:assertion:bd6c3a06515a451b5346557a5652154d942351d520b98bb19302b53e5e719968\",\"urn:rulespec:document-understanding:assertion:9898bc47cf6b562b205268bbe8e2f2fa79a207967839d858cd110aa704f7a454\",\"urn:rulespec:document-understanding:assertion:11962e89a00574c772e7dd8c1a72d4d0cd8a9f1b6ba74a8b2d577681d4275245\",\"urn:rulespec:document-understanding:assertion:a56ba87398f4156390912a4e98bed1ba469813ca34747dfe7f7a46ba378a7e96\",\"urn:rulespec:document-understanding:assertion:ff9c66f001a5a3df1c3991c849722a39f057e7c657db481cfac5e97637867fb5\",\"urn:rulespec:document-understanding:assertion:7ee37c73b07764e8bb1b657a1eb92cfbebead4a21c79cdb64ff0561ffed821da\",\"urn:rulespec:document-understanding:assertion:84f13547eb13f1e71c7676e3b43f8c47d1d1fcb4e02f8941a9217e01811900f0\",\"urn:rulespec:document-understanding:assertion:61d10862ff389468de3431ff93a9f91c1c0a7191b14ad9f170e638dca1c34a84\",\"urn:rulespec:document-understanding:assertion:d3323047c79723d347ea5368e3cc90e8f5d67da37e1805059a75fb628b2e4214\",\"urn:rulespec:document-understanding:assertion:e2254c06d7c672a249ed80155572ee98eb3dd0bc8bf96a73e1c2a28a8a3ed648\",\"urn:rulespec:document-understanding:assertion:c968788966ca1698300c80ec93e8afdd9da4d96ff03835744f8265a11621524b\"],\"choice_quote\":\"one or more of the documents listed in this section\",\"choice_text\":\"one or more of: (1) Court orders or decrees ((a) Name change orders OR (b) Divorce decrees), (2) Certificates of naturalization, (3) Marriage certificates, (4) Documentation demonstrating change of name by operation of state law, OR (5) Documentation of customary usage\",\"context_quotes\":[\"(see an exception for married names in 8 FAM 403.1-4(C))\"],\"end\":1075,\"evidence\":[{\"end\":1075,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:413:1075:sha256-660d269ce0e0ee226093dd3c78c292d98b7ef7de1af61f8431adecf82778afc6\",\"quote\":\"Material discrepancies between the name recorded on the application, the applicant's evidence of U.S. citizenship/non-citizen U.S. nationality, or the evidence of identity must be documented by submission of one or more of the documents listed in this section (see an exception for married names in 8 FAM 403.1-4(C)). Acceptable means of documenting a material name change include (per 22 CFR 51.25):\\n\\n(1) Court orders or decrees:\\n\\n(a) Name change orders; or\\n\\n(b) Divorce decrees;\\n\\n(2) Certificates of naturalization;\\n\\n(3) Marriage certificates;\\n\\n(4) Documentation demonstrating change of name by operation of state law; or\\n\\n(5) Documentation of customary usage.\",\"start\":413},{\"end\":620,\"field\":\"action\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:585:620:sha256-0f05f1f6231570a31de622c0969a535a4949ec69272c1c2627cd1d6d5b1d7ed2\",\"quote\":\"must be documented by submission of\",\"start\":585},{\"end\":584,\"field\":\"object\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:413:584:sha256-cb40404d70d90218b38e38b5d38aea0168c012097c2d557a928d6edea4eed5fa\",\"quote\":\"Material discrepancies between the name recorded on the application, the applicant's evidence of U.S. citizenship/non-citizen U.S. nationality, or the evidence of identity\",\"start\":413},{\"end\":672,\"field\":\"logic_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:621:672:sha256-2c50430030c55b2d21562547c684ecb83fc27784c220f6516ba9f50097010a5f\",\"quote\":\"one or more of the documents listed in this section\",\"start\":621},{\"end\":589,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:585:589:sha256-4137b01e139589b7a1d3b3fc4da031d8ce5bb415808734e970c3a58ea0e98f0f\",\"quote\":\"must\",\"start\":585},{\"end\":672,\"field\":\"choice_text\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:621:672:sha256-2c50430030c55b2d21562547c684ecb83fc27784c220f6516ba9f50097010a5f\",\"quote\":\"one or more of the documents listed in this section\",\"start\":621},{\"end\":729,\"field\":\"context:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:673:729:sha256-3a7a124d5b8dc929b2aab1d9a0c18ace4e99057a8a55f81f159abefae7fd9a2e\",\"quote\":\"(see an exception for married names in 8 FAM 403.1-4(C))\",\"start\":673},{\"end\":868,\"field\":\"alternative:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:845:868:sha256-695a68fd7681834a51f83da9664e16f4f509bb3b9d0dbce7419e570c85b68ad1\",\"quote\":\"(a) Name change orders;\",\"start\":845},{\"end\":893,\"field\":\"alternative:1\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:873:893:sha256-e0f1c6971d7165ebe9acb5aa4305dcd03dd8c5868762d1d06e2063a311a3c0fb\",\"quote\":\"(b) Divorce decrees;\",\"start\":873},{\"end\":930,\"field\":\"alternative:2\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:895:930:sha256-4e18e0787882e8309ae3622b09e55a5651877e9c53a350497910971ae7b678c2\",\"quote\":\"(2) Certificates of naturalization;\",\"start\":895},{\"end\":958,\"field\":\"alternative:3\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:932:958:sha256-e5cd8687a08df7afb024ac63f03ef7d3f67ae346933e9b1efe14a78515b76ad3\",\"quote\":\"(3) Marriage certificates;\",\"start\":932},{\"end\":1036,\"field\":\"alternative:4\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:960:1036:sha256-ae2aa14b1493569032e9e081d8f62feacfbdd7a24ce612d931ecbbeebb32c0f2\",\"quote\":\"(4) Documentation demonstrating change of name by operation of state law; or\",\"start\":960},{\"end\":1075,\"field\":\"alternative:5\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3Aaa23cc4bc9758753066c6a970bc4e4d08f001f9fb228a7ab60b296a5ade86fdc:1038:1075:sha256-94a68417342a7382810a40ae0bcea207f5efacf3def75383c8abe1a81fc0d9bc\",\"quote\":\"(5) Documentation of customary usage.\",\"start\":1038}],\"id\":\"urn:rulespec:document-understanding:revision:703a207dfbeff2862559a7e6e0fc53e1f273e27283ac4ad7449a0ff93a17c68d\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"one or more of the documents listed in this section\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:c968788966ca1698300c80ec93e8afdd9da4d96ff03835744f8265a11621524b\",\"modality\":\"must\",\"modality_quote\":\"must\",\"object\":\"Material discrepancies between the name recorded on the application, the applicant's evidence of U.S. citizenship/non-citizen U.S. nationality, or the evidence of identity\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:8207d14f903d744fd93b40e0c14bcee42fa3e283ecdd95ce04104be93c28aa2b\",\"origin\":\"aiSuggested\",\"quote\":\"Material discrepancies between the name recorded on the application, the applicant's evidence of U.S. citizenship/non-citizen U.S. nationality, or the evidence of identity must be documented by submission of one or more of the documents listed in this section (see an exception for married names in 8 FAM 403.1-4(C)). Acceptable means of documenting a material name change include (per 22 CFR 51.25):\\n\\n(1) Court orders or decrees:\\n\\n(a) Name change orders; or\\n\\n(b) Divorce decrees;\\n\\n(2) Certificates of naturalization;\\n\\n(3) Marriage certificates;\\n\\n(4) Documentation demonstrating change of name by operation of state law; or\\n\\n(5) Documentation of customary usage.\",\"references\":[\"8 FAM 403.1-4(C)\",\"22 CFR 51.25\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:912192e9d632af7a5f1545d35fc44fc43e950a942fc46f513bd4ac3cd59c3166\",\"scope_quotes\":[],\"scope_text\":\"\",\"section_id\":\"fam-names-section-4\",\"start\":413,\"summary\":\"Material discrepancies between the name on the application and citizenship/identity evidence must be documented by submitting one or more of: court orders/decrees (name change orders or divorce decrees), certificates of naturalization, marriage certificates, documentation demonstrating change of name by operation of state law, or documentation of customary usage.\",\"target_ids\":[]}",

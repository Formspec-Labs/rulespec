      "rkaf:assertsValue": {
        "@value": "{\"action\":\"document by submission of one or more listed documents\",\"actor\":\"\",\"alternative_quotes\":[\"(a) Name change orders;\",\"(b) Divorce decrees;\",\"(2) Certificates of naturalization;\",\"(3) Marriage certificates;\",\"(4) Documentation demonstrating change of name by operation of state law; or\",\"(5) Documentation of customary usage.\"],\"choice_text\":\"one or more of: (1) Court orders or decrees ((a) Name change orders OR (b) Divorce decrees), (2) Certificates of naturalization, (3) Marriage certificates, (4) Documentation demonstrating change of name by operation of state law, OR (5) Documentation of customary usage\",\"jurisdiction\":\"\",\"kind\":\"requirement\",\"logic_text\":\"one or more of the documents listed in this section\",\"modality\":\"must\",\"object\":\"Material discrepancies between the name recorded on the application, the applicant's evidence of U.S. citizenship/non-citizen U.S. nationality, or the evidence of identity\",\"scope_text\":\"\",\"summary\":\"Material discrepancies between the name on the application and citizenship/identity evidence must be documented by submitting one or more of: court orders/decrees (name change orders or divorce decrees), certificates of naturalization, marriage certificates, documentation demonstrating change of name by operation of state law, or documentation of customary usage.\"}",
        "@type": "xsd:string"
      },
      "rkaf:assertionPolarity": "rkaf:affirmed"
    },

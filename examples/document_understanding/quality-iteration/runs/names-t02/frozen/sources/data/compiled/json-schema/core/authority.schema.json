{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rulespec.org/jsonschema/authority.json",
  "title": "authority",
  "$defs": {
    "AuthorityKind": {
      "type": "string",
      "enum": [
        "rkaf:legal",
        "rkaf:statutory",
        "rkaf:regulatory",
        "rkaf:delegated",
        "rkaf:organizational",
        "rkaf:contractual",
        "rkaf:localOperational",
        "rkaf:publication"
      ]
    },
    "Authority": {
      "type": "object",
      "properties": {
        "@type": {
          "const": "rkaf:Authority"
        },
        "rkaf:authorityKind": {
          "$ref": "#/$defs/AuthorityKind"
        },
        "rkaf:hasApplicability": {
          "type": "string"
        },
        "rkaf:hasEffectivePeriod": {
          "type": "string"
        },
        "rkaf:derivesAuthorityFrom": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        }
      },
      "required": [
        "@type",
        "rkaf:authorityKind"
      ]
    }
  }
}
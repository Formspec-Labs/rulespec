    {
      "@id": "urn:rulespec:document-understanding:revision:e8e5d2236e8021b20722f87e6bf1919b74485e9ebf52698bca3af418af80c2ed",
      "@type": "rkaf:Artifact",
      "rkaf:hasArtifactIdentifier": "urn:rulespec:document-understanding:revision:e8e5d2236e8021b20722f87e6bf1919b74485e9ebf52698bca3af418af80c2ed",
      "rkaf:artifactIdentifierScheme": "rkaf:urn-persistent",
      "rkaf:hasContentDigest": "sha256:58950bb96b47e341051ab84f36f20ec9a346bdaf58810de8d35835b826a8a868",
      "dcterms:format": "application/json",
      "dcterms:description": "{\"action\":\"determine how the name will appear\",\"actor\":\"adjudicator\",\"alternative_quotes\":[],\"applies_to\":[],\"assertion_ids\":[\"urn:rulespec:document-understanding:assertion:cc422e33e67dee0039a8c0464a6a59547958c367fc6c963e4e72f0f773620e99\",\"urn:rulespec:document-understanding:assertion:71233413baa4d8d91985b92124c769bf8c63a24dafd3d5971d5382557d4c8275\",\"urn:rulespec:document-understanding:assertion:5063479fa632cf1b4fa8050d711f4d3e1994ad545a519a4de78c6907e85db30b\",\"urn:rulespec:document-understanding:assertion:bb8afd3c2ff82a5b701af5d2ff98a57bc7f39358df6de63f8fe407b4d5eef047\",\"urn:rulespec:document-understanding:assertion:1ff7a9ece9ba3e6e1b5542884d1a20ad100ea3a9f76c2a818e7a2c9758e844f0\",\"urn:rulespec:document-understanding:assertion:13ce2a30e749a7ccec53bb767b2283b40fa8d47c5bd1fd6714bba910e56eb582\",\"urn:rulespec:document-understanding:assertion:0570f51ed5746140b1672d93a41d85a2cf6bdfc2cc12469ab4ce50e598837bb2\"],\"choice_quote\":\"\",\"choice_text\":\"\",\"context_quotes\":[\"In accordance with International Civil Aviation Organization (ICAO) recommendations, U.S. passports, form FS-240, and form DS-2060 are printed in all uppercase letters. Printing a name with multiple parts in uppercase letters causes the name to appear as one word unless the parts are separated with spaces.\"],\"end\":4389,\"evidence\":[{\"end\":4389,\"field\":\"summary\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A5a4175f45e6a1e5ed68819bc7725f1871d0cab391934e214c9f7f34023ccc1da:4282:4389:sha256-80897f1e91618d3403678e074c898472f8bdeef734205210f96cce5f36742d40\",\"quote\":\"Consequently, if the applicant has a name with multiple parts, you must determine how the name will appear:\",\"start\":4282},{\"end\":4348,\"field\":\"actor\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A5a4175f45e6a1e5ed68819bc7725f1871d0cab391934e214c9f7f34023ccc1da:4345:4348:sha256-bb0347a468d97e98a9c00e37cebec1ab930f6f1221cae0f1fbb92b07e1900ba2\",\"quote\":\"you\",\"start\":4345},{\"end\":4388,\"field\":\"action\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A5a4175f45e6a1e5ed68819bc7725f1871d0cab391934e214c9f7f34023ccc1da:4354:4388:sha256-bd7963530451aa0d9362fbbc1e8b9b8d2b794c5bd12a6ec7d9af32842fb4db2f\",\"quote\":\"determine how the name will appear\",\"start\":4354},{\"end\":4388,\"field\":\"object\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A5a4175f45e6a1e5ed68819bc7725f1871d0cab391934e214c9f7f34023ccc1da:4364:4388:sha256-4e9f4c16134ac6d58785baacdf6a72065174fef2f9d70675e2ac5ea6d3368e83\",\"quote\":\"how the name will appear\",\"start\":4364},{\"end\":4353,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A5a4175f45e6a1e5ed68819bc7725f1871d0cab391934e214c9f7f34023ccc1da:4349:4353:sha256-4137b01e139589b7a1d3b3fc4da031d8ce5bb415808734e970c3a58ea0e98f0f\",\"quote\":\"must\",\"start\":4349},{\"end\":4343,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A5a4175f45e6a1e5ed68819bc7725f1871d0cab391934e214c9f7f34023ccc1da:4296:4343:sha256-8fac19a4571ab08dedcaf74c48723c024488cd96bdfc783929a80a0ccf63e54f\",\"quote\":\"if the applicant has a name with multiple parts\",\"start\":4296},{\"end\":4281,\"field\":\"context:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A5a4175f45e6a1e5ed68819bc7725f1871d0cab391934e214c9f7f34023ccc1da:3974:4281:sha256-c5d358dcaf0c16b4e0caaace823d9e9b00ec84374a11378686c0b525ed304569\",\"quote\":\"In accordance with International Civil Aviation Organization (ICAO) recommendations, U.S. passports, form FS-240, and form DS-2060 are printed in all uppercase letters. Printing a name with multiple parts in uppercase letters causes the name to appear as one word unless the parts are separated with spaces.\",\"start\":3974}],\"id\":\"urn:rulespec:document-understanding:revision:e8e5d2236e8021b20722f87e6bf1919b74485e9ebf52698bca3af418af80c2ed\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:0570f51ed5746140b1672d93a41d85a2cf6bdfc2cc12469ab4ce50e598837bb2\",\"modality\":\"must\",\"modality_quote\":\"must\",\"object\":\"how the name will appear\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:a197bef514db9d7f939106e24f5359b1f19bc9c5982fe89bb50e3c0c7e21b76d\",\"origin\":\"aiSuggested\",\"quote\":\"Consequently, if the applicant has a name with multiple parts, you must determine how the name will appear:\",\"references\":[\"8 FAM 403.1-3(B)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:5bafe6aa746750e8728bcbd68ce4412148412260119d3015f4d868676ddf1d6d\",\"scope_quotes\":[\"if the applicant has a name with multiple parts\"],\"scope_text\":\"If the applicant has a name with multiple parts\",\"section_id\":\"fam-names-05\",\"start\":4282,\"summary\":\"If the applicant has a name with multiple parts, the adjudicator must determine how the name will appear.\",\"target_ids\":[]}",

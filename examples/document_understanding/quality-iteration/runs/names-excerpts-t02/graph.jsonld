ab930f6f1221cae0f1fbb92b07e1900ba2\",\"quote\":\"you\",\"start\":2100},{\"end\":2176,\"field\":\"action\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A5a4175f45e6a1e5ed68819bc7725f1871d0cab391934e214c9f7f34023ccc1da:2109:2176:sha256-ea99bf39ccaa8fae843da272796bf5c6af6afe0a8217cb7187bca4b22db9c98e\",\"quote\":\"suspend the application to request an acceptable ID in the new name\",\"start\":2109},{\"end\":2132,\"field\":\"object\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A5a4175f45e6a1e5ed68819bc7725f1871d0cab391934e214c9f7f34023ccc1da:2117:2132:sha256-59b33147eed775afbd220ad5c1d10dfd17c401cb664c3c05a2e877c208d45bfb\",\"quote\":\"the application\",\"start\":2117},{\"end\":2108,\"field\":\"modality\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A5a4175f45e6a1e5ed68819bc7725f1871d0cab391934e214c9f7f34023ccc1da:2104:2108:sha256-4137b01e139589b7a1d3b3fc4da031d8ce5bb415808734e970c3a58ea0e98f0f\",\"quote\":\"must\",\"start\":2104},{\"end\":2098,\"field\":\"scope_text:0\",\"fragment_id\":\"urn:rkaf:fragment:urn%3Arulespec%3Adocument-understanding%3Adocument%3A5a4175f45e6a1e5ed68819bc7725f1871d0cab391934e214c9f7f34023ccc1da:1933:2098:sha256-8d6e9a2e653ca62614166aac8953994fa3ed5eaadb3fe7d2c0dd5978ab49c209\",\"quote\":\"If the applicant has had a material name change more than one year prior to applying on form DS-11 but has not updated her/his ID to reflect the material name change\",\"start\":1933}],\"id\":\"urn:rulespec:document-understanding:revision:20135f1fdb4b8bd3c3a6719732c8d16eeb3480a05c79a60f2fb8538b80453760\",\"jurisdiction\":\"\",\"jurisdiction_quote\":\"\",\"kind\":\"requirement\",\"logic_text\":\"more than one year prior to applying on form DS-11 AND has not updated her/his ID\",\"meaning_assertion_id\":\"urn:rulespec:document-understanding:assertion:e1afa47df9b452e33ef47acadadc930b2d92475a2767dbf500608760043ca8c5\",\"modality\":\"must\",\"modality_quote\":\"must\",\"object\":\"the application\",\"occurrence_id\":\"urn:rulespec:document-understanding:occurrence:93e5569e0c78bbaa8b8c8e1d5404d724f6b4c50523c633d99c6f1e179603e363\",\"origin\":\"aiSuggested\",\"quote\":\"If the applicant has had a material name change more than one year prior to applying on form DS-11 but has not updated her/his ID to reflect the material name change, you must suspend the application to request an acceptable ID in the new name.\",\"references\":[\"8 FAM 403.1-4(d)\"],\"relation\":\"none\",\"rule_id\":\"urn:rulespec:document-understanding:rule:17e4915e351a038247108ea597cf7edcd78b36cbbab45db71f238ab9e1f100c3\",\"scope_quotes\":[\"If the applicant has had a material name change more than one year prior to applying on form DS-11 but has not updated her/his ID to reflect the material name change\"],\"scope_text\":\"If the applicant has had a material name change more than one year prior to applying on form DS-11 but has not updated ID to reflect the material name change\",\"section_id\":\"fam-names-03\",\"start\":1933,\"summary\":\"If the applicant had a material name change more than one year prior to applying on Form DS-11 without updating ID, the adjudicator must suspend the application to request acceptable ID in the new name.\",\"target_ids\":[]}",

            "text": "{\n  \"units\": [\n    {\n      \"quote\": \"The applicant may not continue to use a previous name after a material name change\",\n      \"scope_quotes\": [],\n      \"kind\": \"prohibition\",\n      \"meaning\": \"An applicant is prohibited from continuing to use a previous name once a material name change has occurred, unless an authorized exception applies.\"\n    },\n    {\n      \"quote\": \"unless the name change documentation specifically permits the applicant to continue using that name\",\n      \"scope_quotes\": [\n        \"The applicant may not continue to use a previous name after a material name change\"\n      ],\n      \"kind\": \"exception\",\n      \"meaning\": \"An applicant is permitted to continue using their previous name after a material name change if the documentation effecting the name change explicitly authorizes continued use of that previous name.\"\n    },\n    {\n      \"quote\": \"(see 8 FAM 403.1-6 regarding “known as” names)\",\n      \"scope_quotes\": [],\n      \"kind\": \"background\",\n      \"meaning\": \"This parenthetical cross-reference directs the reader to 8 FAM 403.1-6 for guidance on 'known as' names and conveys no independent substantive rule or requirement.\"\n    },\n    {\n      \"quote\": \"You must clear the applicant's pending name even though the name change is not final and even if the passport is not being issued at this time.\",\n      \"scope_quotes\": [],\n      \"kind\": \"requirement\",\n      \"meaning\": \"You are obligated to clear the applicant's pending name, and this duty applies notwithstanding that the name change is not yet finalized or that the passport is not currently being issued.\"\n    }\n  ]\n}",
